// Example 3: constructors, destructors and exceptions.
//
// Decided: RAII constructors and destructors (D6), try / catch / finally (D16),
//          struct, throw and catch syntax (D20), format(...) (D38),
//          initial value of fields (D51)
//          IoError implements Exception and its message() (D36, D115)
// Draft:   os.open / os.close / os.readLine (library still to be defined)

struct File {
    i32 fd = -1  // default: no file open

    File(string path) {  // constructor: acquires the resource
        fd = os.open(path)
        if (fd < 0) {
            throw IoError(format("cannot open {}", path))
        }
    }

    ~File() {  // destructor: releases the resource
        if (fd >= 0) {
            os.close(fd)
        }
    }

    string readLine() {
        ret os.readLine(fd)
    }
}

string firstLine(string path) {
    File f = File(path)
    ret f.readLine()
}  // f is closed here, even if readLine throws

i32 main() {
    try {
        println("{}", firstLine("data.txt"))
    } catch (IoError e) {
        println("error: {}", e.message())
        ret 1  // finally runs before leaving
    } finally {
        println("done")  // always runs
    }
    ret 0
}
