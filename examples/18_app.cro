// Example 18: an app as those of a phone, with the bar at the top, the bar of the
// pages at the bottom, the icons of Lucide, lists that scroll, dialogs, a snackbar,
// switches and a slider, and images embedded in the program.
//
// Decided: the icons of Lucide as the cases of gui.Icon (D448, D449), the bars of
//          the apps (D450), the pages of a navigation bar (D451), the window of
//          an app of Android and its back key (D456, D457), the panels that
//          scroll (D460), the lists and their item chosen (D461, D462), the
//          switches and the sliders (D466), the dialogs (D467), the snackbar
//          (D468), the round images of the lists (D469), embed (D470), the
//          keyboard on the screen (D471), the snackbar above Write (D472), the
//          look, comfortable on a phone (D479, D480), the main button (D482)
// Draft:   the names of the components and of their methods (P39, P41, P42, P45,
//          P46, P48, P49, P50)
//
// cromo build --target android 18_app.cro writes 18_app.apk (D453).
import std.gui

// The contacts whose name has the text searched.
void showContacts(gui.ListView people, string searched) {
    list<string> names = ["Ada Lovelace", "Charles Babbage", "Mary Somerville", "Michael Faraday", "John Herschel",
        "Augustus De Morgan", "Charles Wheatstone", "Isambard Brunel", "George Boole", "Florence Nightingale"]
    people.clear()
    for (i64 i = 0; i < names.len(); i++) {
        if (names[i].lower().contains(searched.lower())) {
            people.addItem(gui.Icon.User, names[i], format("{}@example.com", names[i].lower().split(" ")[0]), "")
            people.setItemImageBytes(people.count() - 1, faceOf(names[i]))
        }
    }
}

// The face of a person, embedded in the program (D470): the app needs no files
// next to it, on the phone too. The others have the icon of their item.
list<u8> faceOf(string name) {
    switch (name) {
        case "Ada Lovelace" {
            ret embed("images/ada.png")
        }
        case "Charles Babbage" {
            ret embed("images/charles.png")
        }
        default {
            list<u8> none
            ret none
        }
    }
}

[[window]]
[[android("org.cromo.examples.mail", "Mail")]]
i32 main() {
    gui.Window w = gui.Window("Example 18", 390, 760)
    gui.AppBar top = w.add(gui.AppBar("Inbox"))
    top.setNavigation(gui.Icon.Menu)
    top.addAction(gui.Icon.EllipsisVertical, []() { })

    gui.NavigationBar pages = w.navigationBar()
    // Each page fills the room between the two bars, lower on a phone, where the bars
    // are higher: the lists take its size and follow it, and the button stays at the
    // bottom while the list scrolls.
    gui.Panel inbox = pages.addPage("Inbox", gui.Icon.Inbox)
    gui.ListView messages = inbox.add(gui.ListView(0, 0, inbox.width(), inbox.height()))
    messages.setAnchor(gui.Horizontal.Stretch, gui.Vertical.Stretch)
    messages.addItem(gui.Icon.User, "Ada Lovelace", "The notes on the engine", "10:42")
    messages.addItem(gui.Icon.User, "Charles Babbage", "The plans of the machine", "09:15")
    messages.addItem(gui.Icon.Users, "The Society", "The meeting of Thursday", "Mon")
    messages.addItem(gui.Icon.Bell, "Reminder", "Send the letters", "Sun")
    for (i64 day = 2; day <= 30; day++) {
        messages.addItem(gui.Icon.Mail, "The workshop", format("The report of day {}", day), format("Oct {}", day))
    }
    messages.setItemImageBytes(0, faceOf("Ada Lovelace"))
    messages.setItemImageBytes(1, faceOf("Charles Babbage"))
    messages.onChoose([messages](i64 index) { println("open '{}'", messages.itemTitle(index)) })
    gui.Button write = inbox.add(gui.Button("Write", inbox.width() - 128, inbox.height() - 56, 112, 40))
    write.setIcon(gui.Icon.Pencil)
    write.setStyle(gui.ButtonStyle.Primary)
    write.setAnchor(gui.Horizontal.Right, gui.Vertical.Bottom)

    // The bin asks before deleting the message chosen, and the snackbar can put it
    // back where it was.
    gui.Dialog ask = gui.Dialog("Delete the message?", 320, 156)
    ask.add(gui.Label("It can be undone for a few seconds.", 0, 0, 272, 20))
    ask.addButton("Cancel", [ask]() { ask.close() })
    ask.addButton("Delete", [w, ask, messages]() {
        ask.close()
        i64 index = messages.selected()
        if (index < 0) {
            ret
        }
        gui.Icon icon = messages.itemIcon(index)
        string title = messages.itemTitle(index)
        string line = messages.itemSubtitle(index)
        string when = messages.itemDetail(index)
        messages.removeItem(index)
        w.showSnackbarAction("Message deleted", "Undo", [messages, index, icon, move title, move line, move when]() {
            messages.insertItem(index, icon, title, line, when)
            messages.setItemImageBytes(index, faceOf(title))
        })
    })
    top.addAction(gui.Icon.Trash2, [w, ask, messages]() {
        if (messages.selected() < 0) {
            w.showSnackbar("Choose a message first")
        } else {
            w.showDialog(ask)
        }
    })

    // Write opens a small form in a dialog.
    gui.Dialog compose = gui.Dialog("New message", 340, 220)
    gui.TextBox to = compose.add(gui.TextBox("", 0, 0, 292, 32))
    to.setPlaceholder("To")
    to.setAnchor(gui.Horizontal.Stretch, gui.Vertical.Top)
    gui.TextBox subject = compose.add(gui.TextBox("", 0, 44, 292, 32))
    subject.setPlaceholder("Subject")
    subject.setAnchor(gui.Horizontal.Stretch, gui.Vertical.Top)
    compose.addButton("Cancel", [compose]() { compose.close() })
    compose.addButton("Send", [w, compose, to, subject]() {
        compose.close()
        w.showSnackbar(format("Sent to {}", to.text().len() > 0 ? to.text() : "nobody"))
        to.setText("")
        subject.setText("")
    })
    write.onClick([w, compose]() { w.showDialog(compose) })

    gui.Panel contacts = pages.addPage("Contacts", gui.Icon.Users)
    gui.TextBox search = contacts.add(gui.TextBox("", 16, 16, 358, 32))
    search.setPlaceholder("Search the contacts")
    search.setAnchor(gui.Horizontal.Stretch, gui.Vertical.Top)
    gui.ListView people = contacts.add(gui.ListView(0, 64, contacts.width(), contacts.height() - 64))
    people.setAnchor(gui.Horizontal.Stretch, gui.Vertical.Stretch)
    showContacts(people, "")
    search.onChange([people](string text) { showContacts(people, text) })

    gui.Panel today = pages.addPage("Calendar", gui.Icon.Calendar)
    gui.ListView events = today.add(gui.ListView(0, 0, today.width(), today.height()))
    events.setAnchor(gui.Horizontal.Stretch, gui.Vertical.Stretch)
    events.addItem(gui.Icon.Clock, "10:00", "The meeting of the Society", "")
    events.addItem(gui.Icon.MapPin, "15:30", "The visit to the workshop", "")

    gui.Panel settings = pages.addPage("Settings", gui.Icon.Settings)
    settings.add(gui.Label("Theme", 16, 16, 200, 20))
    gui.ComboBox theme = settings.add(gui.ComboBox(["System", "Light", "Dark"], 16, 40, 358, 32))
    theme.setSelected(0)
    theme.setAnchor(gui.Horizontal.Stretch, gui.Vertical.Top)
    gui.Switch notify = settings.add(gui.Switch("Notifications", 16, 88, 358, 32))
    notify.setChecked(true)
    notify.setAnchor(gui.Horizontal.Stretch, gui.Vertical.Top)
    gui.Switch mobile = settings.add(gui.Switch("Sync on mobile data", 16, 128, 358, 32))
    mobile.setAnchor(gui.Horizontal.Stretch, gui.Vertical.Top)
    gui.Label size = settings.add(gui.Label("Text size: 100%", 16, 176, 358, 20))
    gui.Slider zoom = settings.add(gui.Slider(80, 150, 16, 200, 358, 32))
    zoom.setValue(100)
    zoom.setAnchor(gui.Horizontal.Stretch, gui.Vertical.Top)
    zoom.onChange([size](i64 value) { size.setText(format("Text size: {}%", value)) })
    gui.Button out = settings.add(gui.Button("Log out", 16, 252, 140, 36))
    out.setIcon(gui.Icon.LogOut)

    // The title follows the page, the theme the combo box. On Android the back key
    // goes back to the inbox, and from there it closes the app (D457).
    list<string> titles = ["Inbox", "Contacts", "Calendar", "Settings"]
    pages.onChange([top, move titles](i64 index) { top.setTitle(titles[index]) })
    w.onBack([w, pages, top]() {
        if (pages.selected() == 0) {
            w.close()
        } else {
            pages.setSelected(0)
            top.setTitle("Inbox")
        }
    })
    theme.onChange([w](i64 index) {
        w.setTheme(index == 1 ? gui.Theme.Light : index == 2 ? gui.Theme.Dark : gui.Theme.System)
    })
    out.onClick([w]() { w.close() })
    w.start()
    ret 0
}
