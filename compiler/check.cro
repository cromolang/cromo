// The pilot of sema in Cromo (D423): `cromo-check file.cro` loads the program and
// checks it as the compiler does before it generates the code, with the errors of
// `cromo build --check-moves` (P30, P89, P90). With `--names`, only the names of the modules, as
// `cromo build --check-names`; with `--declarations`, up to the types of the
// declarations, as `cromo build --check-declarations`; with `--list`, the same, and
// it prints what it knows of them, as `cromo build --list-declarations`; with
// `--list-types`, up to the types of the expressions, and what it wrote on the bodies
// of the functions, as `cromo build --list-types`; with `--emit-ir`, the IR of LLVM
// that `cromo build --emit-ir` prints (D572), as far as the generator goes.
import ast
import codegen
import diagnostics
import loader
import moves
import names
import sema
import std.fs

i32 main(list<string> given) {
    // `--emit-ir --release`: without the checks of overflow, as cromo build --release;
    // `--target linux`, as its --target; `--tests`, the executable of cromo test, with
    // the files name_test.cro; `--runtime`, the object of std.runtime, without a file.
    list<string> args
    bool release = false
    bool tests = false
    bool runtime = false
    string target = "windows"
    for (i64 i = 0; i < given.len(); i++) {
        if (given[i] == "--release") {
            release = true
        } else if (given[i] == "--tests") {
            tests = true
        } else if (given[i] == "--runtime") {
            runtime = true
        } else if (given[i] == "--target" && i + 1 < given.len()) {
            target = given[i + 1]
            i++
        } else {
            args.add(given[i])
        }
    }
    bool linux = target != "windows"
    bool arm64 = target == "linux-arm64" || target == "android-arm64"
    string library = libraryFolder(given[0])
    if (runtime) {  // D393: a file of the library that imports std.runtime, never written
        args.add(library + "\\runtime-object.cro")
        release = true
    }
    string option = args.len() == 3 ? args[1] : ""
    bool known = option == "--names" || option == "--declarations" || option == "--list" || option == "--list-types" ||
        option == "--emit-ir"
    if (args.len() < 2 || args.len() > 3 || (args.len() == 3 && !known)) {
        eprintln("usage: cromo-check [--names | --declarations | --list | --list-types | --emit-ir] file.cro")
        ret 2
    }
    string path = args[args.len() - 1]
    if (!runtime && !fs.isFile(path)) {
        eprintln("cromo: cannot read {}", path)
        ret 2
    }
    string core = library + "\\core.cro"
    if (library.len() == 0 || !fs.isFile(core)) {
        eprintln("cromo: cannot read {}", core)
        ret 2
    }
    Program program = load(path, runtime ? "import std.runtime\n" : readSource(path), library, linux, arm64, tests)
    if (program.diag.hasErrors()) {
        ret 1
    }
    if (option == "--names") {
        declareNames(ref program.tree, ref program.diag)
        ret program.diag.hasErrors() ? 1 : 0
    }
    if (option == "--emit-ir") {
        Checker checked = checkProgram(move program.tree, move program.diag, !tests && !runtime)
        if (!checked.diag.hasErrors()) {
            checkMoves(ref checked)
        }
        if (checked.diag.hasErrors()) {
            ret 1
        }
        Options options
        options.sourcePath = path
        options.release = release
        options.tests = tests
        options.runtime = runtime
        options.windows = !linux
        options.arm64 = arm64
        options.triple = target == "linux" ? "x86_64-unknown-linux-gnu" : target == "linux-arm64" ? "aarch64-unknown-linux-gnu" :
            target == "android-arm64" ? "aarch64-unknown-linux-android26" :
            target == "android-x86_64" ? "x86_64-unknown-linux-android26" : "x86_64-pc-windows-msvc"
        options.library = library
        Generator generator = Generator(move options)
        print("{}", generator.run(checked))
        ret 0
    }
    if (option == "" || option == "--list-types") {
        Checker checked = checkProgram(move program.tree, move program.diag, true)
        if (option == "--list-types") {
            checked.listTypes()
        } else if (!checked.diag.hasErrors()) {
            checkMoves(ref checked)
        }
        ret checked.diag.hasErrors() ? 1 : 0
    }
    Checker checker = checkDeclarations(move program.tree, move program.diag)
    if (option == "--list") {
        checker.listDeclarations()
    }
    ret checker.diag.hasErrors() ? 1 : 0
}
