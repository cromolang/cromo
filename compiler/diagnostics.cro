// The errors of the sources (D417), as src/diagnostics.cpp: file:line:column, then
// the line of the source and a mark under the position. The lexer and the parser
// report on the current file; the analysis names the file of each error.

struct Source {
    string path
    string text  // without the BOM
}

// An error or a warning kept for the editor (D175).
public struct Message {
    public i32 file
    public i32 line
    public i32 column
    public bool warning
    public string text
}

public struct Diagnostics {
    public bool silent   // the errors are counted, not printed: cromo fmt checks its result so
    public bool collect  // the errors are kept in `messages`, not printed: the language server
    public list<Message> messages
    public i32 current     // the file of the lexer and of the parser
    public bool muted      // nothing is reported or counted: the analysis checks an expression only to learn its type
    public string context  // added to every message, as the generic being instantiated
    list<Source> files
    i32 count

    public Diagnostics(string file, string source) {
        addFile(file, source)
    }

    // Another source, and its index for errorIn.
    public i32 addFile(string file, string source) {
        Source item
        item.path = file
        item.text = source
        files.add(move item)
        ret i32(files.len() - 1)
    }

    public string path(i32 file) const {
        ret files[file].path
    }

    public string text(i32 file) const {
        ret files[file].text
    }

    public i32 fileCount() const {
        ret i32(files.len())
    }

    public bool hasErrors() const {
        ret count > 0
    }

    public i32 errorCount() const {
        ret count
    }

    // An error of the whole program, as a missing main.
    public void errorOf(string message) {
        if (muted) {
            ret
        }
        count++
        if (silent) {
            ret
        }
        if (collect) {  // about the whole file: at its start
            keep(0, 1, 1, false, message + context)
            ret
        }
        eprint("{}: error: {}\n", files[0].path, message + context)
    }

    public void error(i32 line, i32 column, string message) {
        errorIn(current, line, column, message)
    }

    public void errorIn(i32 file, i32 line, i32 column, string message) {
        if (muted) {
            ret
        }
        count++
        report("error", file, line, column, message + context)
    }

    public void warningIn(i32 file, i32 line, i32 column, string message) {
        if (!muted) {
            report("warning", file, line, column, message + context)
        }
    }

    void report(string kind, i32 file, i32 line, i32 column, string message) {
        if (silent) {
            ret
        }
        if (collect) {
            keep(file, line, column, kind == "warning", message)
            ret
        }
        eprint("{}:{}:{}: {}: {}\n", files[file].path, line, column, kind, message)
        string source = lineAt(file, line)
        if (source.len() == 0) {
            ret
        }
        // The mark is aligned by counting the characters of UTF-8 and keeping the tabs.
        string mark = "    "
        i32 at = 1
        for (i64 i = 0; i < source.len() && at < column; i++) {
            u8 c = source[i]
            if ((c & 0xC0) == 0x80) {
                continue
            }
            mark += c == '\t' ? "\t" : " "
            at++
        }
        eprint("    {}\n{}^\n", source, mark)
    }

    void keep(i32 file, i32 line, i32 column, bool warning, string text) {
        Message message
        message.file = file
        message.line = line
        message.column = column
        message.warning = warning
        message.text = text
        messages.add(move message)
    }

    // The line `line`, from 1, without its end.
    string lineAt(i32 file, i32 line) const {
        i64 start = 0
        for (i32 i = 1; i < line; i++) {
            i64 newline = files[file].text.findFrom("\n", start)
            if (newline < 0) {
                ret ""
            }
            start = newline + 1
        }
        i64 end = files[file].text.findFrom("\n", start)
        if (end < 0) {
            end = files[file].text.len()
        }
        if (end > start && files[file].text[end - 1] == '\r') {
            end--
        }
        ret files[file].text.slice(start, end)
    }
}
