// The analysis (D423), as src/sema.cpp. After the names of the modules, its second
// part: the types of the declarations, which are the fields of the structs, the data
// of the cases, the signatures of the functions and the variables of the modules,
// with the instances of the generics that they name (D561). The bodies of the
// functions are left to the next part: they wait in `definitions` and `instances`.
import ast
import diagnostics
import lexer
import names
import parser
import std.fs
import types

// A place in the sources, for an error.
struct Loc {
    i32 file
    i32 line
    i32 column
}

Loc at(i32 file, i32 line, i32 column) {
    Loc loc
    loc.file = file
    loc.line = line
    loc.column = column
    ret loc
}

// A function body waiting to be checked.
public struct Pending {
    public i32 function
    public string generic   // the key of the generic it comes from, or ""
    public bool definition  // the check of the generic itself (D52)
    public string context   // added to the messages
}

// An initial value of a field that is computed (D360): its function, and where it is.
public struct DefaultField {
    public i32 function
    public i32 file
    public i32 line
    public i32 column
}

// The tables of the names that findDecl looks into.
const i32 structsTable = 0
const i32 interfacesTable = 1
const i32 functionsTable = 2
const i32 globalsTable = 3

const i32 libraryFile = 1  // the core of the library (P29)
const i32 maxNesting = 16

public struct Checker {
    public Tree tree
    public Diagnostics diag
    public Types types
    public list<Pending> definitions
    public list<Pending> instances
    public list<DefaultField> defaultFields
    public list<i32> made  // the functions made by the analysis, in their order
    public bool requireMain = true
    public bool onlyDeclarations  // the bodies are not checked (P89)
    list<Scope> scopes
    i64 recordCount  // the structs of the sources: their instances come after them
    i32 stringDecl = -1
    i32 listDecl = -1
    i32 mapDecl = -1
    i32 keyInterface = -1
    i32 orderedInterface = -1
    i32 debugInterface = -1
    i32 dataInterface = -1
    bool selfAllowed
    list<TypeBinding> bindings  // the type parameters visible while resolving types
    map<string, i32> recordInstances
    map<string, i32> functionInstances
    map<string, bool> failed  // the generics whose definition has errors
    map<i32, bool> completed
    map<i32, i32> layoutState
    map<i32, bool> implementsDone
    map<string, bool> ambiguous
    map<string, i32> exported                  // the names of C, with the line of their function
    map<i32, i32> typeSignatures               // the declaration of each function type called
    map<string, i32> generated                 // the functions written in Cromo, by what they are for
    list<list<map<string, i32>>> hiddenScopes  // the variables outside the lambdas being checked
    map<string, i32> caseSignatures            // the data of the cases, as parameters
    // The function being checked.
    i32 current = -1
    i32 curFile
    i64 nextLambda                 // for the symbols of the lambdas
    list<map<string, i32>> locals  // the variables visible, a map for each block
    list<bool> loops               // one entry per enclosing loop: true if it contains a break
    bool moveAllowed               // set by coerceValue for the expression it checks
    bool lambdaArgument            // the expression being checked is the argument of a read parameter
    bool insertTarget              // the expression being checked is the target of an assignment
    bool threadLambda              // the next lambda checked is given to a thread (D215)
    i32 groupLambda = -1           // the next lambda checked is given to this group (D273)
    i32 threadInit = -1            // the value of the declaration being checked
    list<LoopBorrow> loopBorrows   // the lists that the enclosing `for` go over (D101)
    list<ThreadBorrow> threadBorrows
    // The references of the blocks (D562): the place each one names, the references
    // that place is written through, and the statement of its block after which its
    // place is free again.
    map<i32, Path> refPaths
    map<i32, list<i32>> refChains
    map<i32, i64> refEnds
    i32 blockNow = -1  // the block being checked, and which of its statements
    i64 indexNow
    map<i32, bool> startedThreads  // the threads of a block with their start() written
    list<GroupLog> activeGroups    // the groups whose block is being checked (D273)
    list<i64> switchLoops          // for each enclosing `switch`, how many loops enclose it (D116)
    // Exceptions (D36): the `try` bodies around the code being checked, the types
    // of the enclosing `catch`, the loops around each `finally` (D120), and the
    // regions that cannot let an exception out (D113, D122).
    list<TryContext> tryContexts
    list<i32> catchTypes
    list<i64> finallyLoops
    list<Region> regions
    map<i32, ThrowInfo> throwInfo
    list<Escape> escapes
    i32 exceptionDecl = -1

    public void run() {
        declareAll()
        if (onlyDeclarations) {
            ret
        }
        checkBodies(true)
        for (i64 r = 0; r < recordCount; r++) {
            if (tree.records[r].typeParams.len() > 0) {
                continue
            }
            for (i64 m = 0; m < tree.records[r].members.len(); m++) {
                i32 member = tree.records[r].members[m]
                if (tree.functions[member].typeParams.len() == 0) {
                    checkFunction(member)
                }
            }
        }
        for (i64 i = 0; i < tree.topFunctions.len(); i++) {
            i32 function = tree.topFunctions[i]
            if (tree.functions[function].typeParams.len() == 0 && !tree.functions[function].isExtern) {
                checkFunction(function)
            }
        }
        checkBodies(false)  // it grows while the instances ask for others
        computeThrows()
        // D360: a default value is made in many places, none of which expects an exception.
        for (i64 i = 0; i < defaultFields.len(); i++) {
            i32 function = defaultFields[i].function
            if (tree.functions[function].canThrow && !tree.functions[function].isAbstract) {
                error(at(defaultFields[i].file, defaultFields[i].line, defaultFields[i].column),
                    "the initial value of a field cannot throw an exception: it is computed wherever the default value is made")
            }
        }
    }

    // The names and the types of the declarations, before any body.
    void declareAll() {
        types = makeTypes()
        scopes = declareNames(ref tree, ref diag)
        recordCount = tree.records.len()
        stringDecl = libraryStruct("string")
        listDecl = libraryStruct("list")
        mapDecl = libraryStruct("map")
        keyInterface = libraryInterface("Key")
        orderedInterface = libraryInterface("Ordered")
        debugInterface = libraryInterface("Debug")
        exceptionDecl = libraryInterface("Exception")
        for (i64 i = 0; i < tree.interfaces.len(); i++) {  // only when the program imports std.json (D251)
            if (tree.interfaces[i].name == "Data" && tree.files[tree.interfaces[i].file].name == "std.json") {
                dataInterface = i32(i)
            }
        }
        declareInterfaces()
        declareTypeParams()
        // Every generic is checked once, with its type parameters as types (D52).
        for (i64 r = 0; r < recordCount; r++) {
            if (tree.records[r].typeParams.len() > 0) {
                instantiateStruct(i32(r), recordOwnParams(i32(r)), recordLoc(i32(r)))
            }
        }
        for (i64 i = 0; i < tree.topFunctions.len(); i++) {
            i32 function = tree.topFunctions[i]
            if (tree.functions[function].typeParams.len() > 0) {
                instantiateFunction(function, functionOwnParams(function), functionLoc(function))
            }
        }
        for (i64 r = 0; r < recordCount; r++) {
            if (tree.records[r].typeParams.len() == 0) {
                completeStruct(i32(r))
            }
        }
        declareFunctions()
        declareGlobals()
        checkPublicSignatures()
        checkHiddenByIntrinsics()
        // A method with type parameters of its own is checked once, with them as types (D52, D92).
        for (i64 r = 0; r < recordCount; r++) {
            if (tree.records[r].typeParams.len() > 0) {
                continue
            }
            for (i64 m = 0; m < tree.records[r].members.len(); m++) {
                i32 member = tree.records[r].members[m]
                if (tree.functions[member].typeParams.len() > 0) {
                    instantiateMethod(member, functionOwnParams(member), functionLoc(member))
                }
            }
        }
    }

    i32 libraryStruct(string name) const {
        ret scopes[libraryFile].structs.contains(name) ? scopes[libraryFile].structs[name] : -1
    }

    i32 libraryInterface(string name) const {
        ret scopes[libraryFile].interfaces.contains(name) ? scopes[libraryFile].interfaces[name] : -1
    }

    void error(Loc loc, string message) {
        diag.errorIn(loc.file, loc.line, loc.column, message)
    }

    string name(i32 type) const {
        ret typeName(tree, types, type)
    }

    // The symbols of the generated code (D134): a declaration has its module in
    // front, `geometry.Circle`, and an instance of a generic the symbols of its
    // type arguments, `std.list<geometry.Circle>`.
    public string symbolFor(i32 file, string text) const {
        string module = tree.files[file].name
        ret module.len() == 0 ? text : module + "." + text
    }

    public string recordSymbol(i32 record) const {
        if (tree.records[record].generic < 0) {
            ret symbolFor(tree.records[record].file, tree.records[record].name)
        }
        ret instanceSymbol(recordSymbol(tree.records[record].generic), tree.records[record].typeArgs)
    }

    public string interfaceSymbol(i32 decl) const {
        ret symbolFor(tree.interfaces[decl].file, tree.interfaces[decl].name)
    }

    public string symbolOrName(i32 type) const {
        if (types.items[type].kind == TypeKind.Struct) {
            ret recordSymbol(types.items[type].decl)
        }
        ret name(type)
    }

    public string typeSymbol(i32 type) const {
        if (types.items[type].kind == TypeKind.Interface) {
            ret interfaceSymbol(types.items[type].decl)
        }
        ret symbolOrName(type)
    }

    public string instanceSymbol(string generic, list<i32> args) const {
        string result = generic + "<"
        for (i64 i = 0; i < args.len(); i++) {
            if (i > 0) {
                result += ", "
            }
            result += typeSymbol(args[i])
        }
        ret result + ">"
    }

    // The symbol of a function of a module: the one the analysis gave it, or its
    // module and its name; a function of C has its name alone.
    public string functionSymbol(i32 function) const {
        if (tree.functions[function].symbol.len() > 0) {
            ret tree.functions[function].symbol
        }
        if (tree.functions[function].isExtern) {
            ret tree.functions[function].name
        }
        ret symbolFor(tree.functions[function].file, tree.functions[function].name)
    }

    Loc recordLoc(i32 record) const {
        ret at(tree.records[record].file, tree.records[record].line, tree.records[record].column)
    }

    Loc functionLoc(i32 function) const {
        ret at(tree.functions[function].file, tree.functions[function].line, tree.functions[function].column)
    }

    Loc typeLoc(i32 node, i32 file) const {
        ret at(file, tree.types[node].line, tree.types[node].column)
    }

    Loc exprLoc(i32 expr, i32 file) const {
        ret at(file, tree.exprs[expr].line, tree.exprs[expr].column)
    }

    Loc paramLoc(i32 function, i64 param) const {
        ret at(tree.functions[function].file, tree.functions[function].params[param].line, tree.functions[function].params[param].column)
    }

    // ---- The names ----

    // D127: the module wrote `import unsafe`.
    bool isUnsafe(i32 file) const {
        ret tree.files[file].isUnsafe
    }

    // The name written in front of the names of an import: its last part (D126).
    string qualifier(i32 file, i64 item) const {
        ret tree.files[file].imports[item].path[tree.files[file].imports[item].path.len() - 1]
    }

    bool importsQualifier(i32 file, string module) const {
        for (i64 k = 0; k < tree.files[file].imports.len(); k++) {
            if (qualifier(file, k) == module) {
                ret true
            }
        }
        ret false
    }

    // The declaration of a name in the scope of a module, or -1.
    i32 inScope(i32 scope, i32 table, string name) const {
        if (table == structsTable) {
            ret scopes[scope].structs.contains(name) ? scopes[scope].structs[name] : -1
        }
        if (table == interfacesTable) {
            ret scopes[scope].interfaces.contains(name) ? scopes[scope].interfaces[name] : -1
        }
        if (table == globalsTable) {
            ret scopes[scope].globals.contains(name) ? scopes[scope].globals[name] : -1
        }
        ret scopes[scope].functions.contains(name) ? scopes[scope].functions[name] : -1
    }

    bool isPublicDecl(i32 table, i32 decl) const {
        if (table == structsTable) {
            ret tree.records[decl].isPublic
        }
        if (table == interfacesTable) {
            ret tree.interfaces[decl].isPublic
        }
        if (table == globalsTable) {
            ret tree.globals[decl].isPublic
        }
        ret tree.functions[decl].isPublic
    }

    // What a name means in a file: its own declarations first, then the public
    // ones of the modules it imports (D126), then those of the standard library,
    // so that a name added to the library never breaks a program (D131). `module`
    // is the name written in front: `geometry.Circle`.
    i32 findDecl(i32 table, string name, Loc loc, string module) {
        if (module.len() == 0) {
            i32 own = inScope(scopeOf(tree, loc.file), table, name)
            if (own >= 0) {
                ret own
            }
        }
        i32 result = -1
        string resultModule
        for (i64 k = 0; k < tree.files[loc.file].imports.len(); k++) {
            string written = qualifier(loc.file, k)
            if (module.len() > 0 && written != module) {
                continue
            }
            for (i64 f = 0; f < tree.files[loc.file].imports[k].files.len(); f++) {
                i32 found = inScope(scopeOf(tree, tree.files[loc.file].imports[k].files[f]), table, name)
                if (found < 0 || !isPublicDecl(table, found) || found == result) {
                    continue
                }
                if (result >= 0) {
                    reportAmbiguous(name, loc, resultModule, written)
                    ret result
                }
                result = found
                resultModule = written
            }
        }
        if (result >= 0 || module.len() > 0 || loc.file == libraryFile) {
            ret result
        }
        i32 library = inScope(libraryFile, table, name)
        ret library >= 0 && isPublicDecl(table, library) ? library : -1
    }

    void reportAmbiguous(string name, Loc loc, string first, string second) {
        string key = format("{}:{}:{}", loc.file, loc.line, loc.column)
        if (ambiguous.contains(key)) {
            ret
        }
        ambiguous[key] = true
        string where = first == second ? "twice in " + first : "in both " + first + " and " + second
        error(loc, "'" + name + "' is " + where + ": write " + first + "." + name + (first == second ? "" : " or " + second + "." + name) +
            "")
    }

    // The imported module that has a name, but not public: for a clearer error.
    string privateIn(string name, i32 file, string module) const {
        for (i64 k = 0; k < tree.files[file].imports.len(); k++) {
            string written = qualifier(file, k)
            if (module.len() > 0 && written != module) {
                continue
            }
            for (i64 f = 0; f < tree.files[file].imports[k].files.len(); f++) {
                i32 scope = scopeOf(tree, tree.files[file].imports[k].files[f])
                if (scopes[scope].structs.contains(name) || scopes[scope].interfaces.contains(name) ||
                    scopes[scope].functions.contains(name)) {
                    ret written
                }
            }
        }
        ret ""
    }

    // ---- The interfaces and the type parameters ----

    // The signatures of the interface methods, where `Self` is allowed (D84).
    void declareInterfaces() {
        selfAllowed = true
        for (i64 i = 0; i < tree.interfaces.len(); i++) {
            map<string, bool> seen
            for (i64 m = 0; m < tree.interfaces[i].methods.len(); m++) {
                i32 method = tree.interfaces[i].methods[m]
                string methodName = tree.functions[method].name
                if (seen.contains(methodName)) {
                    error(functionLoc(method), "method '" + methodName + "' is already defined in " + tree.interfaces[i].name)
                }
                seen[methodName] = true
                if (tree.functions[method].typeParams.len() > 0) {
                    error(at(tree.functions[method].file, tree.functions[method].typeParams[0].line,
                        tree.functions[method].typeParams[0].column),
                        "a method of an interface cannot have type parameters of its own: its table has one entry for each method")
                }
                resolveSignature(method)
                bool usesSelf = tree.functions[method].resolvedReturn == selfType()
                for (i32 type in tree.functions[method].paramTypes) {
                    usesSelf = usesSelf || type == selfType()
                }
                if (usesSelf) {
                    tree.interfaces[i].usesSelf = true
                }
            }
        }
        selfAllowed = false
    }

    // The constraints of the type parameters of a generic (D52), and their entries
    // in the types.
    void declareParams(ref list<TypeParam> params, i32 file) {
        map<string, bool> seen
        for (i64 i = 0; i < params.len(); i++) {
            string paramName = params[i].name
            Loc loc = at(file, params[i].line, params[i].column)
            if (seen.contains(paramName)) {
                error(loc, "type parameter '" + paramName + "' is already defined")
            }
            seen[paramName] = true
            if (types.findBuiltin(paramName) >= 0 || findDecl(structsTable, paramName, loc, "") >= 0 ||
                findDecl(interfacesTable, paramName, loc, "") >= 0 || paramName == "Self") {
                error(loc, "'" + paramName + "' is already the name of a type")
            }
            list<i32> interfaces
            for (i32 node in params[i].constraints) {
                string written = tree.types[node].name
                string module = tree.types[node].module
                bool hasArgs = tree.types[node].args.len() > 0
                i32 found = findDecl(interfacesTable, written, typeLoc(node, file), module)
                if (found < 0 || hasArgs) {
                    error(typeLoc(node, file), "a constraint must be an interface, found '" + written + "'")
                } else {
                    interfaces.add(found)
                }
            }
            params[i].id = types.addParam(paramName, interfaces)
        }
    }

    void declareFunctionParams(i32 function) {
        if (tree.functions[function].typeParams.len() == 0) {
            ret
        }
        list<TypeParam> params = tree.functions[function].typeParams
        declareParams(ref params, tree.functions[function].file)
        tree.functions[function].typeParams = move params
    }

    void declareTypeParams() {
        for (i64 r = 0; r < recordCount; r++) {
            i32 file = tree.records[r].file
            list<TypeParam> params = tree.records[r].typeParams
            declareParams(ref params, file)
            tree.records[r].typeParams = move params
            for (i64 m = 0; m < tree.records[r].members.len(); m++) {
                i32 member = tree.records[r].members[m]
                declareFunctionParams(member)
                for (i64 i = 0; i < tree.functions[member].typeParams.len(); i++) {
                    for (i64 k = 0; k < tree.records[r].typeParams.len(); k++) {
                        if (tree.functions[member].typeParams[i].name == tree.records[r].typeParams[k].name) {
                            error(at(file, tree.functions[member].typeParams[i].line, tree.functions[member].typeParams[i].column),
                                "'" + tree.functions[member].typeParams[i].name + "' is already a type parameter of " +
                                tree.records[r].name)
                        }
                    }
                }
            }
        }
        for (i64 i = 0; i < tree.topFunctions.len(); i++) {
            declareFunctionParams(tree.topFunctions[i])
        }
    }

    // The type parameters of a generic struct: their entries, and as types.
    list<i32> recordParamIds(i32 record) const {
        list<i32> ids
        for (TypeParam param in tree.records[record].typeParams) {
            ids.add(param.id)
        }
        ret ids
    }

    list<i32> functionParamIds(i32 function) const {
        list<i32> ids
        for (TypeParam param in tree.functions[function].typeParams) {
            ids.add(param.id)
        }
        ret ids
    }

    list<i32> ownParams(list<i32> ids) {
        list<i32> result
        for (i32 id in ids) {
            result.add(types.paramType(id))
        }
        ret result
    }

    list<i32> recordOwnParams(i32 record) {
        ret ownParams(recordParamIds(record))
    }

    list<i32> functionOwnParams(i32 function) {
        ret ownParams(functionParamIds(function))
    }

    bool isDefinitionArgs(list<i32> ids, list<i32> args) const {
        for (i64 i = 0; i < args.len(); i++) {
            if (!types.isParam(args[i]) || types.decl(args[i]) != ids[i]) {
                ret false
            }
        }
        ret true
    }

    // `Pair<i32, Point>` for the messages.
    string instanceName(string generic, list<i32> args) const {
        string result = generic + "<"
        for (i64 i = 0; i < args.len(); i++) {
            result += (i > 0 ? ", " : "") + name(args[i])
        }
        ret result + ">"
    }

    // Identifies an instance: the generic and each type argument.
    string instanceKey(string letter, i32 generic, list<i32> args) const {
        string key = format("{}{}", letter, generic)
        for (i32 arg in args) {
            key += format("|{}", arg)
        }
        ret key
    }

    // How deep the type arguments are nested: Pair<Pair<i32>> is 2.
    i32 nesting(i32 type) const {
        if (!types.isStruct(type) || tree.records[types.decl(type)].generic < 0) {
            ret 0
        }
        i32 deepest = 0
        for (i32 arg in tree.records[types.decl(type)].typeArgs) {
            i32 inner = nesting(arg)
            if (inner > deepest) {
                deepest = inner
            }
        }
        ret deepest + 1
    }

    list<TypeBinding> bind(list<i32> ids, list<i32> args) const {
        list<TypeBinding> result
        for (i64 i = 0; i < ids.len(); i++) {
            TypeBinding binding
            binding.name = types.params[ids[i]].name
            binding.type = args[i]
            result.add(move binding)
        }
        ret result
    }

    // Whether a type implements an interface, as a constraint requires (D52, D87).
    bool satisfies(i32 type, i32 iface) {
        if (iface == keyInterface && (types.isNumeric(type) || types.isBool(type))) {  // D198
            ret true
        }
        if (iface == orderedInterface && types.isNumeric(type)) {  // D421
            ret true
        }
        if (iface == dataInterface && !types.isParam(type) && jsonProblem(type) == "") {  // D251
            ret true
        }
        if (iface == debugInterface && !types.isParam(type) && debugProblem(type) == "") {  // D319
            ret true
        }
        if (types.isStruct(type)) {
            ret has(implementsOf(types.decl(type)), iface)
        }
        if (types.isParam(type)) {
            ret has(types.params[types.decl(type)].interfaces, iface)
        }
        ret false
    }

    bool checkConstraints(list<i32> ids, list<i32> args, string what, Loc loc) {
        bool ok = true
        for (i64 i = 0; i < ids.len(); i++) {
            list<i32> required = types.params[ids[i]].interfaces
            for (i32 iface in required) {
                if (satisfies(args[i], iface)) {
                    continue
                }
                ok = false
                if (iface == debugInterface) {
                    if (types.isParam(args[i])) {
                        error(loc, name(args[i]) + " can be printed with {:?} only with a constraint: write <" + name(args[i]) +
                            " : Debug>")
                    } else {
                        error(loc, "values of type " + name(args[i]) + " cannot be printed with {:?}: " + debugProblem(args[i]))
                    }
                    continue
                }
                if (iface == dataInterface) {
                    if (types.isParam(args[i])) {
                        error(loc, name(args[i]) + " can be converted to JSON only with a constraint: write <" + name(args[i]) +
                            " : json.Data>")
                    } else {
                        error(loc, "values of type " + name(args[i]) + " cannot be converted to JSON: " + jsonProblem(args[i]))
                    }
                    continue
                }
                error(loc, name(args[i]) + " does not implement " + tree.interfaces[iface].name + ", required by " +
                    types.params[ids[i]].name + " of " + what)
            }
        }
        ret ok
    }

    bool tooDeep(list<i32> args, string generic, Loc loc) {
        for (i32 arg in args) {
            if (nesting(arg) < maxNesting) {
                continue
            }
            error(loc, "the instances of " + generic + " are nested too deeply: is a generic using itself with a bigger type?")
            ret true
        }
        ret false
    }

    bool anyAbstract(list<i32> args) const {
        for (i32 arg in args) {
            if (isAbstract(tree, types, arg)) {
                ret true
            }
        }
        ret false
    }

    // ---- The instances of the generics (D561) ----

    // An instance of a generic struct, created and completed the first time it is
    // used; -1 when it cannot be made.
    i32 instantiateStruct(i32 generic, list<i32> args, Loc useLoc) {
        string key = instanceKey("r", generic, args)
        if (recordInstances.contains(key)) {
            ret recordInstances[key]
        }
        string genericKey = format("r{}", generic)
        list<i32> ids = recordParamIds(generic)
        bool definition = isDefinitionArgs(ids, args)
        if (!definition && failed.contains(genericKey)) {
            ret -1
        }
        string genericName = tree.records[generic].name
        if (!checkConstraints(ids, args, genericName, useLoc) || tooDeep(args, genericName, useLoc)) {
            ret -1
        }
        if (isThreadType(generic, "Atomic") && !types.isParam(args[0]) && !types.isInt(args[0]) && !types.isBool(args[0])) {
            error(useLoc, "thread.Atomic holds an integer or a bool, not " + name(args[0]) + "")
            ret -1
        }

        Record instance
        instance.name = instanceName(genericName, args)
        instance.file = tree.records[generic].file
        instance.line = tree.records[generic].line
        instance.column = tree.records[generic].column
        instance.isPublic = tree.records[generic].isPublic
        instance.interfaces = tree.records[generic].interfaces
        instance.isEnum = tree.records[generic].isEnum
        for (i64 c = 0; c < tree.records[generic].cases.len(); c++) {
            Case item
            item.name = tree.records[generic].cases[c].name
            item.line = tree.records[generic].cases[c].line
            item.column = tree.records[generic].cases[c].column
            item.attributes = tree.records[generic].cases[c].attributes
            item.value = cloneExpr(tree.records[generic].cases[c].value)
            for (i64 f = 0; f < tree.records[generic].cases[c].fields.len(); f++) {
                Field field = tree.records[generic].cases[c].fields[f]
                item.fields.add(cloneField(field))
            }
            instance.cases.add(move item)
        }
        for (i64 f = 0; f < tree.records[generic].fields.len(); f++) {
            Field field = tree.records[generic].fields[f]
            instance.fields.add(cloneField(field))
        }
        for (i64 m = 0; m < tree.records[generic].members.len(); m++) {
            instance.members.add(cloneFunction(tree.records[generic].members[m]))
        }
        instance.generic = generic
        instance.typeArgs = args
        instance.bindings = bind(ids, args)
        instance.isAbstract = anyAbstract(args)
        tree.records.add(move instance)
        i32 result = i32(tree.records.len() - 1)
        recordInstances[key] = result

        i32 before = diag.errorCount()
        completeStruct(result)
        if (definition && diag.errorCount() > before) {
            failed[genericKey] = true
        }
        string resultName = tree.records[result].name
        if (definition) {
            for (i64 m = 0; m < tree.records[result].members.len(); m++) {
                i32 member = tree.records[result].members[m]
                if (tree.functions[member].typeParams.len() == 0) {
                    schedule(member, genericKey, true, resultName, useLoc)
                } else {
                    instantiateMethod(member, functionOwnParams(member), functionLoc(member))
                }
            }
        } else if (!tree.records[result].isAbstract && tree.records[result].destructor >= 0) {
            // D103: the other methods are checked when they are used.
            schedule(tree.records[result].destructor, genericKey, false, resultName, useLoc)
        }
        ret result
    }

    // An instance of a generic function, created the first time it is used.
    i32 instantiateFunction(i32 generic, list<i32> args, Loc useLoc) {
        string key = instanceKey("f", generic, args)
        if (functionInstances.contains(key)) {
            ret functionInstances[key]
        }
        string genericKey = format("f{}", generic)
        list<i32> ids = functionParamIds(generic)
        bool definition = isDefinitionArgs(ids, args)
        if (!definition && failed.contains(genericKey)) {
            ret -1
        }
        string genericName = tree.functions[generic].name
        if (!checkConstraints(ids, args, "'" + genericName + "'", useLoc) || tooDeep(args, genericName, useLoc)) {
            ret -1
        }

        i32 result = cloneFunction(generic)
        list<TypeParam> none
        string resultName = instanceName(genericName, args)
        tree.functions[result].typeParams = move none
        tree.functions[result].name = resultName
        tree.functions[result].symbol = instanceSymbol(functionSymbol(generic), args)
        tree.functions[result].generic = generic
        tree.functions[result].bindings = bind(ids, args)
        tree.functions[result].isAbstract = anyAbstract(args)
        tree.functions[result].isDefinition = definition
        functionInstances[key] = result
        made.add(result)

        i32 before = diag.errorCount()
        resolveSignatureWith(result)
        if (definition && diag.errorCount() > before) {
            failed[genericKey] = true
        }
        if (definition || !tree.functions[result].isAbstract) {
            schedule(result, genericKey, definition, resultName, useLoc)
        }
        ret result
    }

    // A method with type parameters of its own (D92): an instance for each set of
    // type arguments, with the bindings of its struct and its own; with its own
    // parameters as types, the check of the generic (D52).
    i32 instantiateMethod(i32 generic, list<i32> args, Loc useLoc) {
        string key = instanceKey("f", generic, args)
        if (functionInstances.contains(key)) {
            ret functionInstances[key]
        }
        string genericKey = format("f{}", generic)
        list<i32> ids = functionParamIds(generic)
        bool definition = isDefinitionArgs(ids, args)
        if (!definition && failed.contains(genericKey)) {
            ret -1
        }
        string genericName = tree.functions[generic].name
        if (!checkConstraints(ids, args, "'" + genericName + "'", useLoc) || tooDeep(args, genericName, useLoc)) {
            ret -1
        }

        i32 owner = tree.functions[generic].owner
        i32 result = cloneFunction(generic)
        list<TypeParam> none
        list<TypeBinding> all = tree.functions[generic].bindings
        for (TypeBinding binding in bind(ids, args)) {
            all.add(binding)
        }
        tree.functions[result].typeParams = move none
        tree.functions[result].owner = owner
        tree.functions[result].symbol = recordSymbol(owner) + "." + instanceSymbol(genericName, args)
        tree.functions[result].generic = generic
        tree.functions[result].genericMethod = true
        tree.functions[result].bindings = move all
        tree.functions[result].isAbstract = tree.records[owner].isAbstract || anyAbstract(args)
        tree.functions[result].isDefinition = definition
        functionInstances[key] = result
        made.add(result)

        i32 before = diag.errorCount()
        resolveSignatureWith(result)
        if (definition && diag.errorCount() > before) {
            failed[genericKey] = true
        }
        if (definition || !tree.functions[result].isAbstract) {
            schedule(result, genericKey, definition, tree.records[owner].name + "." + genericName, useLoc)
        }
        ret result
    }

    void schedule(i32 function, string generic, bool definition, string where, Loc useLoc) {
        tree.functions[function].scheduled = true
        Pending pending
        pending.function = function
        pending.generic = generic
        pending.definition = definition
        if (definition) {
            tree.functions[function].isDefinition = true
            definitions.add(move pending)
        } else {
            pending.context = format(" (in {}, used at line {})", where, useLoc.line)
            instances.add(move pending)
        }
    }

    // ---- The copies of the nodes (D561) ----

    // The copy of a function: what the parser wrote, with a body of its own and
    // type parameters of its own.
    i32 cloneFunction(i32 function) {
        Function copy
        copy.file = tree.functions[function].file
        copy.kind = tree.functions[function].kind
        copy.returnType = tree.functions[function].returnType
        copy.name = tree.functions[function].name
        copy.line = tree.functions[function].line
        copy.column = tree.functions[function].column
        copy.isPublic = tree.functions[function].isPublic
        copy.params = tree.functions[function].params
        copy.isConst = tree.functions[function].isConst
        copy.isLambda = tree.functions[function].isLambda
        copy.isCold = tree.functions[function].isCold
        copy.isFormat = tree.functions[function].isFormat
        copy.typeParams = tree.functions[function].typeParams
        for (i64 i = 0; i < copy.typeParams.len(); i++) {
            if (copy.typeParams[i].id >= 0) {
                list<i32> interfaces = types.params[copy.typeParams[i].id].interfaces
                copy.typeParams[i].id = types.addParam(copy.typeParams[i].name, interfaces)
            }
        }
        copy.body = cloneBlock(tree.functions[function].body)
        tree.functions.add(move copy)
        ret i32(tree.functions.len() - 1)
    }

    Field cloneField(Field field) {
        Field copy
        copy.type = field.type
        copy.name = field.name
        copy.line = field.line
        copy.column = field.column
        copy.isPublic = field.isPublic
        copy.init = cloneExpr(field.init)
        copy.attributes = field.attributes
        ret copy
    }

    i32 cloneBlock(i32 block) {
        if (block < 0) {
            ret -1
        }
        Block copy = tree.blocks[block]
        for (i64 i = 0; i < copy.statements.len(); i++) {
            copy.statements[i] = cloneStmt(copy.statements[i])
        }
        tree.blocks.add(move copy)
        ret i32(tree.blocks.len() - 1)
    }

    i32 cloneStmt(i32 stmt) {
        if (stmt < 0) {
            ret -1
        }
        Stmt copy = tree.stmts[stmt]
        copy.value = cloneExpr(copy.value)
        copy.target = cloneExpr(copy.target)
        copy.body = cloneBlock(copy.body)
        copy.elseBody = cloneBlock(copy.elseBody)
        copy.init = cloneStmt(copy.init)
        copy.step = cloneStmt(copy.step)
        copy.defaultBody = cloneBlock(copy.defaultBody)
        for (i64 i = 0; i < copy.parts.len(); i++) {
            if (copy.kind == StmtKind.Switch) {
                Branch branch = tree.branches[copy.parts[i]]
                for (i64 p = 0; p < branch.patterns.len(); p++) {
                    branch.patterns[p].literal = cloneExpr(branch.patterns[p].literal)
                }
                branch.body = cloneBlock(branch.body)
                tree.branches.add(move branch)
                copy.parts[i] = i32(tree.branches.len() - 1)
            } else {
                Catch clause = tree.catches[copy.parts[i]]
                clause.body = cloneBlock(clause.body)
                tree.catches.add(move clause)
                copy.parts[i] = i32(tree.catches.len() - 1)
            }
        }
        tree.stmts.add(move copy)
        ret i32(tree.stmts.len() - 1)
    }

    i32 cloneExpr(i32 expr) {
        if (expr < 0) {
            ret -1
        }
        Expr copy = tree.exprs[expr]
        copy.left = cloneExpr(copy.left)
        copy.right = cloneExpr(copy.right)
        copy.other = cloneExpr(copy.other)
        for (i64 i = 0; i < copy.items.len(); i++) {
            copy.items[i] = cloneExpr(copy.items[i])
        }
        if (copy.function >= 0) {
            copy.function = cloneFunction(copy.function)
        }
        tree.exprs.add(move copy)
        ret i32(tree.exprs.len() - 1)
    }

    // ---- The types as written ----

    // A written type, or -1 after an error. `i32[3][4]` (D196): three arrays of
    // four i32, so that `a[i][j]` has i < 3 and j < 4.
    i32 resolveType(i32 node, i32 file) {
        i32 type = resolveArrayType(node, file)
        if (type >= 0) {
            // The language server shows what it became (D171): in a generic, the first
            // struct or interface that it names, among its definition and its instances.
            i32 had = types.baseElement(tree.types[node].resolved)
            if (!types.isStruct(had) && !types.isInterface(had)) {
                tree.types[node].resolved = type
            }
        }
        ret type
    }

    i32 resolveArrayType(i32 node, i32 file) {
        i32 type = resolveNamedType(node, file)
        if (type < 0 || tree.types[node].dimensions.len() == 0) {
            ret type
        }
        if (types.isVoid(type) || type == selfType() || types.isInterface(type)) {
            error(typeLoc(node, file), "an array cannot have elements of type " + name(type) + "")
            ret -1
        }
        for (i64 i = tree.types[node].dimensions.len() - 1; i >= 0; i--) {
            i64 count = tree.types[node].dimensions[i]
            i64 element = i64(sizeOf(tree, types, type))
            if (count < 1 || count > 2147483647 || (element > 0 && count > 2147483647 / element)) {
                error(typeLoc(node, file), count < 1 ? "an array has at least one element" :
                    "this array is too large: an array takes at most 2 GB")
                ret -1
            }
            type = types.arrayType(type, count)
        }
        ret type
    }

    // The type, or the error type after an error.
    i32 resolveOrError(i32 node, i32 file) {
        i32 type = resolveType(node, file)
        ret type < 0 ? errorType() : type
    }

    i32 resolveNamedType(i32 node, i32 file) {
        Loc loc = typeLoc(node, file)
        string written = tree.types[node].name
        string module = tree.types[node].module
        list<i32> args = tree.types[node].args
        if (tree.types[node].isFunction) {  // D185
            list<i32> params
            for (i32 arg in args) {
                i32 param = resolveType(arg, file)
                if (param < 0) {
                    ret -1
                }
                if (types.isVoid(param)) {
                    error(typeLoc(arg, file), "a parameter cannot be void")
                    ret -1
                }
                params.add(param)
            }
            i32 result = voidType()
            if (tree.types[node].result >= 0) {
                result = resolveType(tree.types[node].result, file)
                if (result < 0) {
                    ret -1
                }
            }
            ret types.functionType(params, tree.types[node].modes, result)
        }
        if (module.len() == 0) {
            for (i64 b = 0; b < bindings.len(); b++) {
                if (bindings[b].name != written) {
                    continue
                }
                if (args.len() > 0) {
                    error(loc, "'" + written + "' is a type parameter: it has no type arguments")
                    ret -1
                }
                ret bindings[b].type
            }
        }
        if (written == "addr" && module.len() == 0 && findDecl(structsTable, written, loc, "") < 0) {
            if (isUnsafe(file)) {
                ret addrType()
            }
            error(loc, "'addr' belongs to the unsafe dialect: the module must write 'import unsafe'")
            ret -1
        }
        if (module.len() > 0 && !importsQualifier(file, module)) {
            error(loc, "no imported module is called '" + module + "'")
            ret -1
        }
        if (written == "Self" && module.len() == 0) {
            if (!selfAllowed) {
                error(loc, "Self can be used only in the methods of an interface")
                ret -1
            }
            ret selfType()
        }
        i32 builtin = module.len() > 0 ? -1 : written == "void" ? voidType() : types.findBuiltin(written)
        if (builtin >= 0) {
            if (args.len() > 0) {
                error(loc, "'" + written + "' has no type arguments")
                ret -1
            }
            ret builtin
        }
        i32 record = findDecl(structsTable, written, loc, module)
        if (record >= 0) {
            string declName = tree.records[record].name
            if (tree.records[record].typeParams.len() == 0) {
                if (args.len() > 0) {
                    error(loc, "'" + declName + "' is not generic: it has no type arguments")
                    ret -1
                }
                ret types.structType(record)
            }
            list<i32> resolved
            if (!resolveTypeArgs(args, file, tree.records[record].typeParams.len(), "'" + declName + "'", loc, ref resolved)) {
                ret -1
            }
            i32 instance = instantiateStruct(record, resolved, loc)
            ret instance < 0 ? -1 : types.structType(instance)
        }
        i32 iface = findDecl(interfacesTable, written, loc, module)
        if (iface >= 0) {
            if (args.len() > 0) {
                error(loc, "an interface has no type arguments")
                ret -1
            }
            ret types.interfaceType(iface)
        }
        string where = privateIn(written, file, module)
        if (where.len() > 0) {
            reportPrivate(loc, "'" + written + "' of " + where)
        } else if (module.len() > 0) {
            error(loc, "the module " + module + " has no type '" + written + "'")
        } else {
            error(loc, "unknown type '" + written + "'")
        }
        ret -1
    }

    void reportPrivate(Loc loc, string what) {
        error(loc, what + " is private to its module: it is not marked public")
    }

    bool resolveTypeArgs(list<i32> nodes, i32 file, i64 expected, string what, Loc loc, ref list<i32> out) {
        if (nodes.len() != expected) {
            error(loc, format("{} takes {}{}{} were given", what, expected, expected == 1 ? " type argument, but " :
                " type arguments, but ", nodes.len()))
            ret false
        }
        for (i32 node in nodes) {
            i32 type = resolveType(node, file)
            if (type < 0) {
                ret false
            }
            if (types.isVoid(type) || type == selfType()) {
                error(typeLoc(node, file), "'" + name(type) + "' cannot be a type argument")
                ret false
            }
            if (!checkNotInterface(type, typeLoc(node, file), "a type argument")) {
                ret false
            }
            out.add(type)
        }
        ret true
    }

    // D357: an interface is a type as the others, but one that uses Self is only a
    // constraint (D84).
    bool checkNotInterface(i32 type, Loc loc, string what) {
        if (!types.isInterface(type) || !tree.interfaces[types.decl(type)].usesSelf) {
            ret true
        }
        error(loc, what + " cannot be of " + name(type) + ", which uses Self: it can only be a constraint, <T : " + name(type) + ">")
        ret false
    }

    // ---- The literals of the declarations ----

    // A literal, possibly negative: an initial value of a field that the constant
    // of the default value holds (D73, D360).
    bool isConstantLiteral(i32 expr) const {
        switch (tree.exprs[expr].kind) {
            case IntLiteral, FloatLiteral, BoolLiteral {
                ret true
            }
            case Unary {
                i32 operand = tree.exprs[expr].left
                ret tree.exprs[expr].unary == UnaryOp.Negate && (tree.exprs[operand].kind == ExprKind.IntLiteral ||
                    tree.exprs[operand].kind == ExprKind.FloatLiteral)
            }
            default {
                ret false
            }
        }
    }

    // Makes a literal of a declaration of the type `target`, with coerce; false with
    // its error. The file of the declaration is the current one meanwhile: a struct
    // can be completed while a body of another file is checked.
    bool coerceLiteral(i32 expr, i32 file, i32 target) {
        i32 saved = curFile
        curFile = file
        bool ok = coerce(expr, target, false)
        curFile = saved
        ret ok
    }

    bool fits(u64 magnitude, bool negative, i32 type) const {
        i32 bits = types.items[type].bits
        bool isSigned = types.items[type].isSigned
        u64 one = 1
        if (negative && magnitude != 0) {
            ret isSigned && magnitude <= (one << u64(bits - 1))
        }
        u64 max = isSigned ? (one << u64(bits - 1)) - 1 : bits == 64 ? 0xFFFFFFFFFFFFFFFF : (one << u64(bits)) - 1
        ret magnitude <= max
    }

    string rangeOf(i32 type) const {
        i32 bits = types.items[type].bits
        u64 one = 1
        if (types.items[type].isSigned) {
            u64 limit = one << u64(bits - 1)
            ret format("-{} .. {}", limit, limit - 1)
        }
        u64 max = bits == 64 ? 0xFFFFFFFFFFFFFFFF : (one << u64(bits)) - 1
        ret format("0 .. {}", max)
    }

    // ---- The structs ----

    // `[[json("user_id")]]` and `[[json(skip)]]` before a field (D256): its name in
    // JSON, empty when it is skipped.
    string readAttributes(i32 record, i64 index) {
        i32 file = tree.records[record].file
        string fieldName = tree.records[record].fields[index].name
        string jsonName = fieldName
        bool seen = false
        list<Attribute> attributes = tree.records[record].fields[index].attributes
        for (Attribute attribute in attributes) {
            Loc loc = at(file, attribute.line, attribute.column)
            if (attribute.name != "json") {
                error(loc, "unknown attribute '" + attribute.name + "': for now there is only json")
                continue
            }
            if (seen) {
                error(loc, "the field '" + fieldName + "' already has the attribute json")
                continue
            }
            seen = true
            bool skip = attribute.args.len() == 1 && !attribute.args[0].isText && attribute.args[0].text == "skip"
            bool named = attribute.args.len() == 1 && attribute.args[0].isText && attribute.args[0].text.len() > 0
            if (skip) {
                jsonName = ""
            } else if (named) {
                jsonName = attribute.args[0].text
            } else {
                error(loc, "json takes the name of the field in JSON, as json(\"user_id\"), or skip, as json(skip)")
            }
        }
        ret jsonName
    }

    // Fields, members, layout and interfaces of a struct that is not generic, or of
    // an instance of a generic one. Done once, when the struct is first needed.
    void completeStruct(i32 record) {
        if (completed.contains(record)) {
            ret
        }
        completed[record] = true
        list<TypeBinding> saved = bindings
        bindings = tree.records[record].bindings
        completeFields(record)
        bindings = move saved
    }

    void completeFields(i32 record) {
        i32 file = tree.records[record].file
        string declName = tree.records[record].name
        bool isEnum = tree.records[record].isEnum
        map<string, bool> fieldNames
        map<string, bool> jsonNames
        list<i64> computed  // initial values that are not literals (D360)
        for (i64 i = 0; i < tree.records[record].fields.len(); i++) {
            string fieldName = tree.records[record].fields[i].name
            Loc loc = at(file, tree.records[record].fields[i].line, tree.records[record].fields[i].column)
            if (fieldNames.contains(fieldName)) {
                error(loc, "field '" + fieldName + "' is already defined in " + declName)
            }
            fieldNames[fieldName] = true
            string jsonName = readAttributes(record, i)
            if (jsonName.len() > 0) {
                if (jsonNames.contains(jsonName)) {
                    error(loc, "another field of " + declName + " has the name '" + jsonName + "' in JSON")
                }
                jsonNames[jsonName] = true
            }
            i32 node = tree.records[record].fields[i].type
            i32 resolved = resolveOrError(node, file)
            if (types.isVoid(resolved)) {
                error(typeLoc(node, file), "a field cannot be void")
                resolved = errorType()
            }
            if (!checkNotInterface(resolved, typeLoc(node, file), "a field")) {
                resolved = errorType()
            }
            tree.records[record].fields[i].jsonName = jsonName
            tree.records[record].fields[i].resolved = resolved
            i32 init = tree.records[record].fields[i].init
            if (init < 0 || types.isError(resolved)) {
                continue
            }
            if (!types.isStruct(resolved) && !types.isInterface(resolved) && isConstantLiteral(init)) {
                coerceLiteral(init, file, resolved)  // in the constant of the default value
            } else {
                computed.add(i)
            }
        }
        if (computed.len() > 0) {
            makeDefaultFunction(record, computed)
        }

        // The cases of an enum, with their data (D104) and their names in JSON (D365).
        map<string, bool> caseNames
        for (i64 c = 0; c < tree.records[record].cases.len(); c++) {
            string caseName = tree.records[record].cases[c].name
            Loc loc = at(file, tree.records[record].cases[c].line, tree.records[record].cases[c].column)
            string jsonName = caseName
            list<Attribute> attributes = tree.records[record].cases[c].attributes
            for (Attribute attribute in attributes) {
                bool named = attribute.name == "json" && attribute.args.len() == 1 && attribute.args[0].isText &&
                    attribute.args[0].text.len() > 0
                if (named) {
                    jsonName = attribute.args[0].text
                } else {
                    error(at(file, attribute.line, attribute.column), "a case has only the attribute json(\"name\"), its name in JSON")
                }
            }
            tree.records[record].cases[c].jsonName = jsonName
            if (caseNames.contains(jsonName)) {
                error(loc, "another case of " + declName + " has the name '" + jsonName + "' in JSON")
            }
            caseNames[jsonName] = true
            if (fieldNames.contains(caseName)) {
                error(loc, "case '" + caseName + "' is already defined in " + declName)
            }
            fieldNames[caseName] = true
            map<string, bool> dataNames
            for (i64 f = 0; f < tree.records[record].cases[c].fields.len(); f++) {
                string dataName = tree.records[record].cases[c].fields[f].name
                if (dataNames.contains(dataName)) {
                    error(at(file, tree.records[record].cases[c].fields[f].line, tree.records[record].cases[c].fields[f].column),
                        "the case '" + caseName + "' already has data named '" + dataName + "'")
                }
                dataNames[dataName] = true
                i32 node = tree.records[record].cases[c].fields[f].type
                i32 resolved = resolveOrError(node, file)
                if (types.isVoid(resolved)) {
                    error(typeLoc(node, file), "the data of a case cannot be void")
                    resolved = errorType()
                }
                if (!checkNotInterface(resolved, typeLoc(node, file), "the data of a case")) {
                    resolved = errorType()
                }
                tree.records[record].cases[c].fields[f].resolved = resolved
            }
        }
        if (isEnum && tree.records[record].cases.len() == 0) {
            error(recordLoc(record), "an enum needs at least one case")
        }
        caseValues(record)

        list<TypeBinding> ownBindings = tree.records[record].bindings
        bool abstract = tree.records[record].isAbstract
        for (i64 m = 0; m < tree.records[record].members.len(); m++) {
            i32 member = tree.records[record].members[m]
            string memberName = tree.functions[member].name
            FunctionKind kind = tree.functions[member].kind
            tree.functions[member].owner = record
            tree.functions[member].bindings = ownBindings
            tree.functions[member].isAbstract = abstract
            if (tree.functions[member].typeParams.len() > 0 && kind != FunctionKind.Method) {
                error(at(file, tree.functions[member].typeParams[0].line, tree.functions[member].typeParams[0].column),
                    "only a method can have type parameters of its own")
                list<TypeParam> none
                tree.functions[member].typeParams = move none
            }
            if (kind == FunctionKind.Constructor) {
                if (tree.records[record].constructor >= 0) {
                    error(functionLoc(member), "a struct has only one constructor")
                } else {
                    tree.records[record].constructor = member
                }
            } else if (kind == FunctionKind.Destructor) {
                if (tree.records[record].destructor >= 0) {
                    error(functionLoc(member), "a struct has only one destructor")
                } else {
                    tree.records[record].destructor = member
                }
                if (tree.functions[member].params.len() > 0) {
                    error(paramLoc(member, 0), "a destructor has no parameters")
                }
            } else if (memberName == declName) {  // a constructor has no type (D71)
                error(functionLoc(member), "a method cannot have the name of its struct: a constructor is written without a type, as " +
                    declName + "(...)")
            } else if (fieldNames.contains(memberName)) {
                error(functionLoc(member), "'" + memberName + "' is already " + (isEnum ? "a case" : "a field") + " of " + declName)
            } else if (tree.records[record].methods.contains(memberName)) {
                error(functionLoc(member), "method '" + memberName + "' is already defined in " + declName)
            } else {
                tree.records[record].methods[memberName] = member
            }
        }

        layout(record)
        for (i64 m = 0; m < tree.records[record].members.len(); m++) {
            i32 member = tree.records[record].members[m]
            if (tree.functions[member].typeParams.len() == 0) {  // a generic method: in its instances (D92)
                resolveSignature(member)
            }
        }
        checkCopySignature(record)
        checkImplements(record)
    }

    // D360: the initial values of the fields that are not literals become the body of
    // `void Struct..default(ref Struct value)`, `value.field = init` in the order of
    // the fields. Its parameter has a name that cannot be written, and the function
    // has no object: an initial value cannot read the other fields.
    void makeDefaultFunction(i32 record, list<i64> fields) {
        i32 file = tree.records[record].file
        i32 line = tree.records[record].line
        i32 column = tree.records[record].column
        TypeNode nothing
        nothing.name = "void"
        nothing.line = line
        nothing.column = column
        tree.types.add(move nothing)
        Function function
        function.file = file
        function.name = tree.records[record].name + ".default"
        function.symbol = recordSymbol(record) + "..default"
        function.line = line
        function.column = column
        function.returnType = i32(tree.types.len() - 1)
        function.resolvedReturn = voidType()
        function.isAbstract = tree.records[record].isAbstract
        function.bindings = tree.records[record].bindings
        Param param
        param.mode = ParamMode.Ref
        param.name = "the value"
        param.line = line
        param.column = column
        function.params.add(move param)
        function.paramTypes.add(types.structType(record))
        Block body
        body.openLine = line
        body.openColumn = column
        body.closeLine = line
        body.closeColumn = column
        i32 index = i32(tree.functions.len())
        for (i64 i in fields) {
            i32 init = tree.records[record].fields[i].init
            i32 initLine = tree.exprs[init].line
            i32 initColumn = tree.exprs[init].column
            Expr object
            object.kind = ExprKind.Name
            object.line = initLine
            object.column = initColumn
            object.text = "the value"
            tree.exprs.add(move object)
            Expr target
            target.kind = ExprKind.Field
            target.line = initLine
            target.column = initColumn
            target.text = tree.records[record].fields[i].name
            target.left = i32(tree.exprs.len() - 1)
            tree.exprs.add(move target)
            Stmt assign
            assign.kind = StmtKind.Assign
            assign.line = initLine
            assign.column = initColumn
            assign.target = i32(tree.exprs.len() - 1)
            assign.value = init
            tree.stmts.add(move assign)
            body.statements.add(i32(tree.stmts.len() - 1))
            tree.records[record].fields[i].init = -1
            DefaultField computed
            computed.function = index
            computed.file = file
            computed.line = initLine
            computed.column = initColumn
            defaultFields.add(move computed)
        }
        tree.blocks.add(move body)
        function.body = i32(tree.blocks.len() - 1)
        tree.functions.add(move function)
        tree.records[record].defaultFunction = index
        made.add(index)
        Pending pending
        pending.function = index
        instances.add(move pending)
    }

    // The values of the cases (D135): their position, or `Red = 1` in an enum
    // without data, for every case.
    void caseValues(i32 record) {
        i32 file = tree.records[record].file
        bool written = false
        for (i64 c = 0; c < tree.records[record].cases.len(); c++) {
            written = written || tree.records[record].cases[c].value >= 0
        }
        map<i64, string> seen
        for (i64 c = 0; c < tree.records[record].cases.len(); c++) {
            tree.records[record].cases[c].number = c
            if (!written) {
                continue
            }
            i32 value = tree.records[record].cases[c].value
            if (value < 0) {
                error(at(file, tree.records[record].cases[c].line, tree.records[record].cases[c].column),
                    "give a value to every case of " + tree.records[record].name + ", or to none")
                continue
            }
            Loc loc = exprLoc(value, file)
            if (tree.records[record].cases[c].fields.len() > 0) {
                error(loc, "only the cases of an enum without data can have a value")
                continue
            }
            bool negative = false
            if (tree.exprs[value].kind == ExprKind.Unary && tree.exprs[value].unary == UnaryOp.Negate) {
                negative = true
                value = tree.exprs[value].left
            }
            if (tree.exprs[value].kind != ExprKind.IntLiteral || tree.exprs[value].flag) {
                error(loc, "the value of a case is an integer literal")
                continue
            }
            u64 magnitude = tree.exprs[value].value
            if (!fits(magnitude, negative, intType(32, true))) {
                error(loc, "the value of a case must fit in an i32")
                continue
            }
            i64 number = negative ? 0 - i64(magnitude) : i64(magnitude)
            tree.records[record].cases[c].number = number
            if (seen.contains(number)) {
                error(loc, format("the value {} is already the one of {}", number, seen[number]))
            } else {
                seen[number] = tree.records[record].cases[c].name
            }
        }
    }

    // Computes size, alignment and need for destruction, and rejects structs
    // that contain themselves (D11).
    void layout(i32 record) {
        if (layoutState.contains(record)) {
            ret  // done, or a cycle: reported by the struct that closes it
        }
        layoutState[record] = 1
        bool destruct = tree.records[record].destructor >= 0
        i32 align = 1
        i32 size = layoutFields(record, -1, ref destruct, ref align)
        // A mutex, a channel and an atomic are written by the threads through their
        // address, also in a const method; so is what holds one (D216, D326, D328).
        bool addressed = isThreadType(record, "Mutex") || isThreadType(record, "Channel") || isThreadType(record, "Atomic")
        for (i64 i = 0; i < tree.records[record].fields.len(); i++) {
            addressed = addressed || holdsAddressed(tree.records[record].fields[i].resolved)
        }
        for (i64 c = 0; c < tree.records[record].cases.len(); c++) {
            for (i64 f = 0; f < tree.records[record].cases[c].fields.len(); f++) {
                addressed = addressed || holdsAddressed(tree.records[record].cases[c].fields[f].resolved)
            }
        }
        i32 payloadOffset = 0
        if (tree.records[record].isEnum) {
            // A tag, then the data of the current case: the largest case decides
            // the size, the most aligned one where the data start.
            i32 largest = 0
            align = 4
            for (i64 c = 0; c < tree.records[record].cases.len(); c++) {
                i32 caseAlign = 1
                i32 caseSize = layoutFields(record, c, ref destruct, ref caseAlign)
                tree.records[record].cases[c].size = caseSize
                tree.records[record].cases[c].align = caseAlign
                largest = caseSize > largest ? caseSize : largest
                align = caseAlign > align ? caseAlign : align
            }
            payloadOffset = alignUp(4, align)
            size = alignUp(payloadOffset + largest, align)
        }
        tree.records[record].size = size
        tree.records[record].align = align
        tree.records[record].payloadOffset = payloadOffset
        tree.records[record].addressed = addressed
        tree.records[record].needsDestruction = destruct
        layoutState[record] = 2
    }

    bool holdsAddressed(i32 type) const {
        i32 base = types.baseElement(type)
        ret types.isStruct(base) && tree.records[types.decl(base)].addressed
    }

    // Size and alignment of fields laid out as in C (D74): those of the struct, or
    // the data of the case `item`.
    i32 layoutFields(i32 record, i64 item, ref bool destruct, ref i32 align) {
        i32 file = tree.records[record].file
        bool isEnum = tree.records[record].isEnum
        i64 count = item < 0 ? tree.records[record].fields.len() : tree.records[record].cases[item].fields.len()
        i32 offset = 0
        align = 1
        for (i64 i = 0; i < count; i++) {
            i32 type = item < 0 ? tree.records[record].fields[i].resolved : tree.records[record].cases[item].fields[i].resolved
            i32 base = types.baseElement(type)
            if (types.isStruct(base)) {
                i32 inner = types.decl(base)
                if (layoutState.contains(inner) && layoutState[inner] == 1) {
                    string fieldName = item < 0 ? tree.records[record].fields[i].name : tree.records[record].cases[item].fields[i].name
                    i32 line = item < 0 ? tree.records[record].fields[i].line : tree.records[record].cases[item].fields[i].line
                    i32 column = item < 0 ? tree.records[record].fields[i].column : tree.records[record].cases[item].fields[i].column
                    error(at(file, line, column), (isEnum ? "enum '" : "struct '") + tree.records[record].name +
                        "' contains itself through " + (isEnum ? "the data '" : "field '") + fieldName + "': use a list instead")
                    if (item < 0) {
                        tree.records[record].fields[i].resolved = errorType()
                    } else {
                        tree.records[record].cases[item].fields[i].resolved = errorType()
                    }
                    continue
                }
                completeStruct(inner)
                layout(inner)
            }
            // A parameter may need destruction: decided by each instance. A function
            // value owns its data (D184).
            destruct = destruct || needsDestruction(tree, types, type)
            if (types.isError(type)) {
                continue
            }
            i32 typeAlign = alignOf(tree, types, type)
            offset = alignUp(offset, typeAlign) + sizeOf(tree, types, type)
            align = typeAlign > align ? typeAlign : align
        }
        ret alignUp(offset, align)
    }

    // The interfaces a struct declares, resolved the first time they are needed.
    list<i32> implementsOf(i32 record) {
        if (implementsDone.contains(record)) {
            ret tree.records[record].implements
        }
        implementsDone[record] = true
        i32 file = tree.records[record].file
        list<i32> nodes = tree.records[record].interfaces
        for (i32 node in nodes) {
            string written = tree.types[node].name
            string module = tree.types[node].module
            bool hasArgs = tree.types[node].args.len() > 0
            i32 found = findDecl(interfacesTable, written, typeLoc(node, file), module)
            if (found < 0 || hasArgs) {
                error(typeLoc(node, file), "'" + written + "' is not an interface: a struct can only implement interfaces")
            } else if (has(tree.records[record].implements, found)) {
                error(typeLoc(node, file), tree.records[record].name + " already implements " + written)
            } else {
                tree.records[record].implements.add(found)
            }
        }
        ret tree.records[record].implements
    }

    i32 withSelf(i32 type, i32 self) const {
        ret type == selfType() ? self : type
    }

    // As written in the source, with `Self` replaced: `f64 area() const`.
    string signatureText(i32 method, i32 self) const {
        string text = name(withSelf(tree.functions[method].resolvedReturn, self)) + " " + tree.functions[method].name + "("
        for (i64 i = 0; i < tree.functions[method].params.len(); i++) {
            ParamMode mode = tree.functions[method].params[i].mode
            bool isConst = tree.functions[method].params[i].isConst
            if (i > 0) {
                text += ", "
            }
            if (mode == ParamMode.Ref) {
                text += "ref "
            }
            if (mode == ParamMode.Move) {
                text += isConst ? "move const " : "move "
            }
            if (mode == ParamMode.Read && isConst) {
                text += "const "
            }
            text += name(withSelf(tree.functions[method].paramTypes[i], self)) + " " + tree.functions[method].params[i].name
        }
        ret text + (tree.functions[method].isConst ? ") const" : ")")
    }

    bool sameSignature(i32 method, i32 required, i32 self) const {
        i64 count = tree.functions[method].params.len()
        if (tree.functions[method].isConst != tree.functions[required].isConst || count != tree.functions[required].params.len() ||
            tree.functions[method].paramTypes.len() != count) {
            ret false
        }
        if (tree.functions[method].resolvedReturn != withSelf(tree.functions[required].resolvedReturn, self)) {
            ret false
        }
        for (i64 i = 0; i < count; i++) {
            if (tree.functions[method].params[i].mode != tree.functions[required].params[i].mode ||
                tree.functions[method].params[i].isConst != tree.functions[required].params[i].isConst) {
                ret false
            }
            if (tree.functions[method].paramTypes[i] != withSelf(tree.functions[required].paramTypes[i], self)) {
                ret false
            }
        }
        ret true
    }

    // D90: a struct has every method of the interfaces it declares, with the same signature.
    void checkImplements(i32 record) {
        i32 self = types.structType(record)
        string declName = tree.records[record].name
        for (i32 iface in implementsOf(record)) {
            for (i64 m = 0; m < tree.interfaces[iface].methods.len(); m++) {
                i32 required = tree.interfaces[iface].methods[m]
                string methodName = tree.functions[required].name
                if (!tree.records[record].methods.contains(methodName)) {
                    error(recordLoc(record), declName + " does not implement '" + methodName + "' of " + tree.interfaces[iface].name +
                        ": add '" + signatureText(required, self) + "'")
                    continue
                }
                i32 method = tree.records[record].methods[methodName]
                if (!sameSignature(method, required, self)) {
                    error(functionLoc(method), "'" + methodName + "' does not match the interface " + tree.interfaces[iface].name +
                        ": it must be '" + signatureText(required, self) + "'")
                }
            }
        }
    }

    // D83: `copy()` written by hand is `T copy() const`, and only where it is not generated.
    void checkCopySignature(i32 record) {
        if (!tree.records[record].methods.contains("copy")) {
            ret
        }
        i32 copy = tree.records[record].methods["copy"]
        string declName = tree.records[record].name
        if (!tree.records[record].needsDestruction) {
            error(functionLoc(copy), declName + " is copied implicitly: its copy() is generated by the compiler")
        } else if (tree.functions[copy].params.len() > 0 || !tree.functions[copy].isConst ||
            tree.functions[copy].resolvedReturn != types.structType(record)) {
            error(functionLoc(copy), "copy() must be written '" + declName + " copy() const'")
        }
    }

    // The struct `name` of std.thread, or an instance of it.
    bool isThreadType(i32 record, string name) const {
        i32 generic = tree.records[record].generic >= 0 ? tree.records[record].generic : record
        ret tree.records[generic].name == name && tree.files[scopeOf(tree, tree.records[generic].file)].name == "std.thread"
    }

    bool isString(i32 type) const {
        ret stringDecl >= 0 && types.isStruct(type) && types.decl(type) == stringDecl
    }

    bool isList(i32 type) const {
        ret listDecl >= 0 && types.isStruct(type) && tree.records[types.decl(type)].generic == listDecl
    }

    bool isMap(i32 type) const {
        ret mapDecl >= 0 && types.isStruct(type) && tree.records[types.decl(type)].generic == mapDecl
    }

    bool isJsonValue(i32 type) const {
        ret types.isStruct(type) && tree.records[types.decl(type)].name == "Value" &&
            tree.files[tree.records[types.decl(type)].file].name == "std.json"
    }

    // ---- The functions ----

    void resolveSignature(i32 function) {
        i32 file = tree.functions[function].file
        i32 node = tree.functions[function].returnType
        i32 result = resolveOrError(node, file)
        if (!checkNotInterface(result, typeLoc(node, file), "a return value")) {
            result = errorType()
        }
        tree.functions[function].resolvedReturn = result
        list<i32> paramTypes
        for (i64 i = 0; i < tree.functions[function].params.len(); i++) {
            i32 paramNode = tree.functions[function].params[i].type
            i32 type = resolveOrError(paramNode, file)
            if (types.isVoid(type)) {
                error(typeLoc(paramNode, file), "a parameter cannot be void")
                type = errorType()
            }
            if (types.isInterface(type) && tree.interfaces[types.decl(type)].usesSelf) {
                error(typeLoc(paramNode, file), name(type) + " uses Self, so it can only be a constraint: <T : " + name(type) + ">")
                type = errorType()
            }
            paramTypes.add(type)
        }
        tree.functions[function].paramTypes = move paramTypes
    }

    // The signature of an instance, with its type parameters visible.
    void resolveSignatureWith(i32 function) {
        list<TypeBinding> saved = bindings
        bindings = tree.functions[function].bindings
        resolveSignature(function)
        bindings = move saved
    }

    // The signatures of the functions that are not generic, and main.
    void declareFunctions() {
        map<string, i32> externs
        for (i64 i = 0; i < tree.topFunctions.len(); i++) {
            i32 function = tree.topFunctions[i]
            if (tree.functions[function].typeParams.len() == 0) {
                resolveSignature(function)
            }
            if (!tree.functions[function].isExtern) {
                continue
            }
            checkExtern(function)
            string functionName = tree.functions[function].name
            if (!externs.contains(functionName)) {
                externs[functionName] = function
            } else if (!sameExtern(function, externs[functionName])) {
                error(functionLoc(function), "the C function '" + functionName + "' is already declared with another signature, in " +
                    tree.files[tree.functions[externs[functionName]].file].name)
            }
        }

        for (i64 r = 0; r < tree.records.len(); r++) {
            list<i32> members = tree.records[r].members
            for (i32 member in members) {
                readFormat(member)
                if (tree.functions[member].attributes.len() > 0) {
                    error(attributeLoc(member, 0), "unknown attribute '" + tree.functions[member].attributes[0].name +
                        "': a method has only [[format]]")
                    tree.functions[member].attributes.clear()
                }
            }
        }
        for (i64 i = 0; i < tree.topFunctions.len(); i++) {
            i32 function = tree.topFunctions[i]
            readFormat(function)
            readCold(function)
            readWindow(function)
            readAndroid(function)
            if (tree.functions[function].attributes.len() == 0) {
                continue
            }
            if (tree.functions[function].attributes[0].name == "export") {
                readExport(function)
            } else {
                readTestAttribute(function)
            }
        }

        i32 main = mainFunction()
        if (!requireMain && main < 0) {
            ret
        }
        if (main < 0 || tree.functions[main].isExtern) {
            diag.errorOf("missing function main")
            ret
        }
        if (tree.functions[main].typeParams.len() > 0) {
            error(functionLoc(main), "main cannot be generic")
            ret
        }
        i32 result = tree.functions[main].resolvedReturn
        if (!types.isError(result) && !types.isVoid(result) && result != intType(32, true)) {
            error(typeLoc(tree.functions[main].returnType, tree.functions[main].file), "main must return i32 or void")
        }
        // D154: no parameters, or the arguments of the program.
        bool arguments = tree.functions[main].params.len() == 1 && tree.functions[main].params[0].mode == ParamMode.Read &&
            !tree.functions[main].params[0].isConst && isList(tree.functions[main].paramTypes[0]) &&
            isString(tree.records[types.decl(tree.functions[main].paramTypes[0])].typeArgs[0])
        if (tree.functions[main].params.len() > 0 && !arguments) {
            error(paramLoc(main, 0), "main has no parameters, or one with the arguments of the program: list<string> args")
        }
    }

    // main of the program, or -1.
    i32 mainFunction() const {
        ret scopes[0].functions.contains("main") ? scopes[0].functions["main"] : -1
    }

    Loc attributeLoc(i32 function, i64 index) const {
        ret at(tree.functions[function].file, tree.functions[function].attributes[index].line,
            tree.functions[function].attributes[index].column)
    }

    // `[[export("cromo_alloc")]]` (D395): a function that C and the generated code
    // call with that name, with the types of C and without hidden parameters.
    void readExport(i32 function) {
        Loc loc = attributeLoc(function, 0)
        if (!isUnsafe(tree.functions[function].file)) {
            error(loc, "[[export]] is only for the modules with 'import unsafe'")
            ret
        }
        if (tree.functions[function].attributes.len() > 1) {
            error(attributeLoc(function, 1), "an exported function has no other attributes")
            ret
        }
        Attribute attribute = tree.functions[function].attributes[0]
        bool named = attribute.args.len() == 1 && attribute.args[0].isText && attribute.args[0].text.len() > 0
        string exportName = named ? attribute.args[0].text : ""
        for (i64 i = 0; i < exportName.len(); i++) {
            if (!isLetter(exportName[i]) && !isDigit(exportName[i]) && exportName[i] != '_') {
                named = false
            }
        }
        if (!named || isDigit(exportName[0])) {
            error(loc, "[[export]] takes the name of the function in C, as [[export(\"cromo_alloc\")]]")
            ret
        }
        if (tree.functions[function].typeParams.len() > 0) {
            error(functionLoc(function), "an exported function cannot be generic: C calls it as it is")
            ret
        }
        for (i64 i = 0; i < tree.functions[function].params.len(); i++) {
            if (tree.functions[function].params[i].mode != ParamMode.Read || !isCType(tree.functions[function].paramTypes[i])) {
                error(paramLoc(function, i), "the parameters of an exported function are numbers, bool or addr, passed by value")
                ret
            }
        }
        i32 result = tree.functions[function].resolvedReturn
        if (!types.isVoid(result) && !isCType(result)) {
            error(functionLoc(function), "an exported function returns a number, a bool, an addr or nothing")
            ret
        }
        // One name of C for each function: two would be the same symbol (D395).
        if (exported.contains(exportName)) {
            error(loc, format("another function is exported as '{}', at line {}: a name of C is used once", exportName,
                exported[exportName]))
            ret
        }
        exported[exportName] = loc.line
        tree.functions[function].isExported = true
        tree.functions[function].exportName = exportName
        if (named) {
            tree.functions[function].symbol = exportName
        }
    }

    // `[[cold]]` (D398): a function that runs rarely, as the slow path of the heap.
    // It goes with the other attributes, so it is taken out of the list here.
    void readCold(i32 function) {
        i64 i = 0
        for (i < tree.functions[function].attributes.len()) {
            if (tree.functions[function].attributes[i].name != "cold") {
                i++
                continue
            }
            Loc loc = attributeLoc(function, i)
            if (!isUnsafe(tree.functions[function].file)) {
                error(loc, "[[cold]] is only for the modules with 'import unsafe'")
            } else if (tree.functions[function].attributes[i].args.len() > 0) {
                error(loc, "[[cold]] takes no arguments")
            } else if (tree.functions[function].isCold) {
                error(loc, "the function '" + tree.functions[function].name + "' already has [[cold]]")
            } else {
                tree.functions[function].isCold = true
            }
            tree.functions[function].attributes.remove(i)
        }
    }

    // `[[format]]` (D577): the last parameter, a string, takes in a call a format and
    // its arguments, as println: `log.info("{} users", count)`. Like [[cold]], it goes
    // with the other attributes and is taken out of the list.
    void readFormat(i32 function) {
        i64 i = 0
        for (i < tree.functions[function].attributes.len()) {
            if (tree.functions[function].attributes[i].name != "format") {
                i++
                continue
            }
            Loc loc = attributeLoc(function, i)
            if (tree.functions[function].attributes[i].args.len() > 0) {
                error(loc, "[[format]] takes no arguments")
            } else if (tree.functions[function].isFormat) {
                error(loc, "the function '" + tree.functions[function].name + "' already has [[format]]")
            } else if (!takesFormat(function)) {
                error(loc, "[[format]] is for a function or a method whose last parameter is a string: the text that the format gives")
            } else {
                tree.functions[function].isFormat = true
            }
            tree.functions[function].attributes.remove(i)
        }
    }

    // Whether the last parameter of the function is a string that it reads.
    bool takesFormat(i32 function) const {
        FunctionKind kind = tree.functions[function].kind
        i64 count = tree.functions[function].params.len()
        if (tree.functions[function].isExtern || kind == FunctionKind.Constructor || kind == FunctionKind.Destructor || count == 0) {
            ret false
        }
        if (tree.functions[function].params[count - 1].mode != ParamMode.Read) {
            ret false
        }
        i32 type = tree.functions[function].params[count - 1].type
        ret tree.types[type].name == "string" && tree.types[type].module == "" && !tree.types[type].isFunction &&
            tree.types[type].args.len() == 0
    }

    // `[[window]] i32 main()` (D426): the executable for Windows opens no console.
    // Like [[cold]], it goes with the other attributes and is taken out of the list.
    void readWindow(i32 function) {
        i64 i = 0
        for (i < tree.functions[function].attributes.len()) {
            if (tree.functions[function].attributes[i].name != "window") {
                i++
                continue
            }
            Loc loc = attributeLoc(function, i)
            if (mainFunction() != function) {
                error(loc, "[[window]] is only for main of the program, whose executable opens no console")
            } else if (tree.functions[function].attributes[i].args.len() > 0) {
                error(loc, "[[window]] takes no arguments")
            } else if (tree.functions[function].isWindow) {
                error(loc, "main already has [[window]]")
            } else {
                tree.functions[function].isWindow = true
            }
            tree.functions[function].attributes.remove(i)
        }
    }

    // `[[android("org.example.mail", "Mail")]] i32 main()` (D455): the package and the
    // name of the app of Android. Like [[window]], it is taken out of the list.
    void readAndroid(i32 function) {
        i64 i = 0
        for (i < tree.functions[function].attributes.len()) {
            if (tree.functions[function].attributes[i].name != "android") {
                i++
                continue
            }
            Loc loc = attributeLoc(function, i)
            Attribute attribute = tree.functions[function].attributes[i]
            if (mainFunction() != function) {
                error(loc, "[[android]] is only for main of the program, whose app it names")
            } else if (attribute.args.len() != 2 || !attribute.args[0].isText || !attribute.args[1].isText ||
                attribute.args[1].text.len() == 0) {
                error(loc, "[[android]] takes the package and the name of the app, as [[android(\"org.example.mail\", \"Mail\")]]")
            } else if (!isAndroidPackage(attribute.args[0].text)) {
                error(at(loc.file, attribute.args[0].line, attribute.args[0].column), "the package of an app is names of letters, " +
                    "digits and _, each starting with a letter, joined by dots, as org.example.mail")
            } else if (tree.functions[function].androidPackage.len() > 0) {
                error(loc, "main already has [[android]]")
            } else {
                tree.functions[function].androidPackage = attribute.args[0].text
                tree.functions[function].androidName = attribute.args[1].text
            }
            tree.functions[function].attributes.remove(i)
        }
    }

    // `[[test]] void name()` (D349): what cromo test runs.
    void readTestAttribute(i32 function) {
        string functionName = tree.functions[function].name
        for (i64 i = 0; i < tree.functions[function].attributes.len(); i++) {
            if (tree.functions[function].attributes[i].name != "test" || tree.functions[function].attributes[i].args.len() > 0) {
                error(attributeLoc(function, i), "unknown attribute '" + tree.functions[function].attributes[i].name +
                    "': a function has only [[test]]" + (isUnsafe(tree.functions[function].file) ? ", [[export(\"name\")]] or [[cold]]" :
                        "") + (functionName == "main" ? ", and main [[window]] or [[android(...)]]" : ""))
                ret
            }
        }
        if (tree.functions[function].attributes.len() > 1) {
            error(attributeLoc(function, 1), "the function '" + functionName + "' already has [[test]]")
            ret
        }
        if (tree.functions[function].typeParams.len() > 0) {
            error(functionLoc(function), "a test cannot be generic: cromo test calls it as it is")
            ret
        }
        if (tree.functions[function].params.len() > 0 || !types.isVoid(tree.functions[function].resolvedReturn)) {
            error(functionLoc(function), "a test takes no parameters and returns nothing: [[test]] void " + functionName + "()")
            ret
        }
        tree.functions[function].isTest = true
    }

    // D129: the types that a C function can take and return.
    bool isCType(i32 type) const {
        ret types.isNumeric(type) || types.isBool(type) || type == addrType()
    }

    // A number, or a struct of numbers: the same layout in C (D74, D129).
    bool isCPointee(i32 type) const {
        if (types.isNumeric(type) || types.isBool(type)) {
            ret true
        }
        if (types.isArray(type)) {
            ret isCPointee(types.element(type))
        }
        if (!types.isStruct(type) || tree.records[types.decl(type)].isEnum || tree.records[types.decl(type)].needsDestruction) {
            ret false
        }
        for (Field field in tree.records[types.decl(type)].fields) {
            if (!isCPointee(field.resolved)) {
                ret false
            }
        }
        ret true
    }

    void checkExtern(i32 function) {
        i32 file = tree.functions[function].file
        i32 result = tree.functions[function].resolvedReturn
        if (!types.isError(result) && !types.isVoid(result) && !isCType(result)) {
            error(typeLoc(tree.functions[function].returnType, file), "a C function returns a number, bool or addr, not " +
                name(result) + "")
        }
        for (i64 i = 0; i < tree.functions[function].params.len(); i++) {
            i32 type = tree.functions[function].paramTypes[i]
            ParamMode mode = tree.functions[function].params[i].mode
            Loc written = typeLoc(tree.functions[function].params[i].type, file)
            if (types.isError(type)) {
                continue
            }
            if (mode == ParamMode.Move) {
                error(paramLoc(function, i), "a C function has no 'move' parameters")
            } else if (mode == ParamMode.Ref && !isCPointee(type)) {
                error(written, "'ref' to a C function is a pointer to a number or to a struct of numbers, not " + name(type) + "")
            } else if (mode == ParamMode.Read && !isCType(type)) {
                error(written, "a C function takes numbers, bool, addr and 'ref' to numbers or structs of numbers, not " + name(type) +
                    "")
            }
        }
    }

    bool sameExtern(i32 a, i32 b) const {
        if (tree.functions[a].resolvedReturn != tree.functions[b].resolvedReturn ||
            tree.functions[a].params.len() != tree.functions[b].params.len()) {
            ret false
        }
        for (i64 i = 0; i < tree.functions[a].params.len(); i++) {
            if (tree.functions[a].params[i].mode != tree.functions[b].params[i].mode ||
                tree.functions[a].paramTypes[i] != tree.functions[b].paramTypes[i]) {
                ret false
            }
        }
        ret true
    }

    // In a module with `import unsafe` a call of `free` or `offset` is the built-in of
    // the dialect (D98): a function of the module or of C with that name would never
    // be called, so it is an error where it is declared.
    void checkHiddenByIntrinsics() {
        for (i64 i = 0; i < tree.topFunctions.len(); i++) {
            i32 function = tree.topFunctions[i]
            if (!isUnsafe(tree.functions[function].file) || !isIntrinsic(tree.functions[function].name)) {
                continue
            }
            error(functionLoc(function), "'" + tree.functions[function].name + "' is a built-in function of the unsafe dialect, " +
                "which this module calls instead: give this function another name")
        }
    }

    // D132: what a public declaration shows must be public too, or the modules that
    // use it could not name it.
    void checkExposed(i32 written, Loc loc, string what) {
        i32 type = types.baseElement(written)
        // D127: the other modules use only a safe interface; the modules that only the
        // library imports, as std.winsock, are used by modules with `import unsafe` (D232).
        string module = tree.files[loc.file].name
        bool internal = module == "std.winsock" || module == "std.runtime"
        if (type == addrType() && !internal) {
            error(loc, what + " is public, but its type addr is only for the modules with 'import unsafe': offer a safe type instead")
            ret
        }
        if (types.isStruct(type)) {
            i32 decl = types.decl(type)
            list<i32> args = tree.records[decl].typeArgs
            for (i32 arg in args) {
                checkExposed(arg, loc, what)
            }
            if (tree.records[decl].generic >= 0) {
                decl = tree.records[decl].generic
            }
            if (tree.records[decl].isPublic) {
                ret
            }
        } else if (!types.isInterface(type) || tree.interfaces[types.decl(type)].isPublic) {
            ret
        }
        error(loc, what + " is public, but its type " + name(type) + " is private to the module")
    }

    void checkSignatureExposed(i32 function, string what) {
        i32 file = tree.functions[function].file
        checkExposed(tree.functions[function].resolvedReturn, typeLoc(tree.functions[function].returnType, file), what)
        for (i64 i = 0; i < tree.functions[function].params.len() && i < tree.functions[function].paramTypes.len(); i++) {
            checkExposed(tree.functions[function].paramTypes[i], typeLoc(tree.functions[function].params[i].type, file), what)
        }
    }

    void checkPublicSignatures() {
        for (i64 i = 0; i < tree.topFunctions.len(); i++) {
            i32 function = tree.topFunctions[i]
            if (tree.functions[function].isPublic && tree.functions[function].typeParams.len() == 0) {
                checkSignatureExposed(function, "function '" + tree.functions[function].name + "'")
            }
        }
        for (i64 i = 0; i < tree.interfaces.len(); i++) {
            if (!tree.interfaces[i].isPublic) {
                continue
            }
            for (i64 m = 0; m < tree.interfaces[i].methods.len(); m++) {
                i32 method = tree.interfaces[i].methods[m]
                checkSignatureExposed(method, "method '" + tree.functions[method].name + "'")
            }
        }
        for (i64 r = 0; r < recordCount; r++) {
            if (!tree.records[r].isPublic || tree.records[r].typeParams.len() > 0) {
                continue
            }
            i32 file = tree.records[r].file
            for (i64 f = 0; f < tree.records[r].fields.len(); f++) {
                if (tree.records[r].fields[f].isPublic) {
                    checkExposed(tree.records[r].fields[f].resolved, typeLoc(tree.records[r].fields[f].type, file),
                        "field '" + tree.records[r].fields[f].name + "'")
                }
            }
            for (i64 c = 0; c < tree.records[r].cases.len(); c++) {
                for (i64 f = 0; f < tree.records[r].cases[c].fields.len(); f++) {
                    checkExposed(tree.records[r].cases[c].fields[f].resolved, typeLoc(tree.records[r].cases[c].fields[f].type, file),
                        "case '" + tree.records[r].cases[c].name + "'")
                }
            }
            for (i64 m = 0; m < tree.records[r].members.len(); m++) {
                i32 member = tree.records[r].members[m]
                if (tree.functions[member].isPublic) {
                    checkSignatureExposed(member, tree.functions[member].kind == FunctionKind.Constructor ? "the constructor" :
                        "method '" + tree.functions[member].name + "'")
                }
            }
        }
    }

    // ---- The variables and the constants of the modules ----

    // D394: a module variable needs no code to be made, so it holds numbers, bool,
    // addr, or arrays and structs of them whose fields have no initial values; it
    // starts from its default value, or from a literal.
    void declareGlobals() {
        for (i64 g = 0; g < tree.globals.len(); g++) {
            i32 file = tree.globals[g].file
            string globalName = tree.globals[g].name
            i32 scope = scopeOf(tree, file)
            if (!scopes[scope].globals.contains(globalName) || i64(scopes[scope].globals[globalName]) != g) {
                continue
            }
            i32 node = tree.globals[g].type
            i32 type = resolveOrError(node, file)
            Variable variable
            variable.name = globalName
            variable.file = file
            variable.line = tree.globals[g].line
            variable.column = tree.globals[g].column
            variable.kind = VariableKind.Module
            variable.isConst = tree.globals[g].isConst
            tree.variables.add(move variable)
            i32 index = i32(tree.variables.len() - 1)
            tree.globals[g].variable = index
            if (tree.globals[g].isConst) {
                i32 constant = declareConstant(g, type)
                tree.globals[g].resolved = constant
                tree.variables[index].type = constant
                continue
            }
            if (!types.isError(type) && !isStaticType(type)) {
                error(typeLoc(node, file), "a module variable holds numbers, bool, addr, or arrays and structs of them whose fields " +
                    "have no initial values, not " + name(type) + ": no code runs to make it")
                type = errorType()
            }
            i32 init = tree.globals[g].init
            if (init >= 0 && !types.isError(type)) {
                if (!isConstantLiteral(init) || !(types.isNumeric(type) || types.isBool(type))) {
                    error(exprLoc(init, file), "the initial value of a module variable is a number, a character, true or false")
                } else if (!coerceLiteral(init, file, type)) {
                    type = errorType()
                }
            }
            tree.globals[g].resolved = type
            tree.variables[index].type = type
        }
    }

    // D414: a constant of a module is a number, bool or char, or an array of them, with
    // a literal for each value. Its type, or the error type.
    i32 declareConstant(i64 global, i32 type) {
        if (types.isError(type)) {
            ret type
        }
        i32 file = tree.globals[global].file
        i32 element = types.isArray(type) ? types.element(type) : type
        if (!types.isNumeric(element) && !types.isBool(element)) {
            error(typeLoc(tree.globals[global].type, file), "a constant of a module is a number, bool or char, or an array of them, " +
                "not " + name(type) + "")
            ret errorType()
        }
        i32 init = tree.globals[global].init
        if (init < 0) {
            error(at(file, tree.globals[global].line, tree.globals[global].column), "constant '" + tree.globals[global].name +
                "' needs its value")
            ret errorType()
        }
        if (!types.isArray(type)) {
            ret constantLiteral(init, file, element) ? type : errorType()
        }
        if (tree.exprs[init].kind != ExprKind.ListLiteral) {
            error(exprLoc(init, file), "the value of a constant array is a list of literals in square brackets")
            ret errorType()
        }
        list<i32> items = tree.exprs[init].items
        if (items.len() != types.items[type].count) {
            error(exprLoc(init, file), format("the array has {} elements, and the list {}", types.items[type].count, items.len()))
            ret errorType()
        }
        i32 result = type
        for (i32 item in items) {
            if (!constantLiteral(item, file, element)) {
                result = errorType()
            }
        }
        ret result
    }

    bool constantLiteral(i32 value, i32 file, i32 type) {
        if (!isConstantLiteral(value)) {
            error(exprLoc(value, file), "the value of a constant of a module is a number, a character, true or false")
            ret false
        }
        ret coerceLiteral(value, file, type)
    }

    bool isStaticType(i32 type) const {
        if (types.isNumeric(type) || types.isBool(type) || type == addrType() || types.isVector(type)) {
            ret true
        }
        if (types.isArray(type)) {
            ret isStaticType(types.element(type))
        }
        if (!types.isStruct(type) || tree.records[types.decl(type)].isEnum || tree.records[types.decl(type)].needsDestruction) {
            ret false
        }
        for (Field field in tree.records[types.decl(type)].fields) {
            if (field.init >= 0 || !isStaticType(field.resolved)) {
                ret false
            }
        }
        ret true
    }

    // ---- The forms of debug (D319) and of JSON (D251) ----

    // Why the values of `type` have no form of debug, or "" when they have one: all
    // the types but the functions and the interfaces, and what holds them.
    string debugProblem(i32 type) const {
        map<i32, bool> visiting
        ret debugProblemAt(type, "", ref visiting)
    }

    string problemText(i32 type, string place, string reason, string none) const {
        if (place.len() == 0) {
            ret reason.len() == 0 ? none : reason
        }
        ret place + " has type " + name(type) + (reason.len() == 0 ? "" : " (" + reason + ")")
    }

    string debugProblemAt(i32 type, string place, ref map<i32, bool> visiting) const {
        string none = "it has no form of debug"
        if (types.isBool(type) || types.isNumeric(type) || types.isError(type) || types.isVector(type)) {
            ret ""
        }
        if (types.isParam(type)) {
            if (has(types.params[types.decl(type)].interfaces, debugInterface)) {
                ret ""
            }
            ret problemText(type, place, "it is not constrained to Debug", none)
        }
        if (types.isArray(type)) {
            ret debugProblemAt(types.element(type), place.len() == 0 ? "an element" : place + "[i]", ref visiting)
        }
        if (!types.isStruct(type)) {
            ret problemText(type, place, "", none)
        }
        i32 decl = types.decl(type)
        if (decl == stringDecl) {
            ret ""
        }
        if (isList(type)) {
            ret debugProblemAt(tree.records[decl].typeArgs[0], place.len() == 0 ? "an element" : place + "[i]", ref visiting)
        }
        if (isMap(type)) {
            string problem = debugProblemAt(tree.records[decl].typeArgs[0], place.len() == 0 ? "a key" : place + " key", ref visiting)
            if (problem.len() > 0) {
                ret problem
            }
            ret debugProblemAt(tree.records[decl].typeArgs[1], place.len() == 0 ? "a value" : place + "[key]", ref visiting)
        }
        if (visiting.contains(decl)) {
            ret ""  // already being checked: it contains a list of itself
        }
        visiting[decl] = true
        // The name in the form of debug: "Box" also for Box<i64>, as Rust prints it.
        string base = place.len() > 0 ? place : tree.records[decl].generic >= 0 ? tree.records[tree.records[decl].generic].name :
            tree.records[decl].name
        for (i64 c = 0; c < tree.records[decl].cases.len(); c++) {
            for (i64 f = 0; f < tree.records[decl].cases[c].fields.len(); f++) {
                string problem = debugProblemAt(tree.records[decl].cases[c].fields[f].resolved, base + "." +
                    tree.records[decl].cases[c].name, ref visiting)
                if (problem.len() > 0) {
                    ret problem
                }
            }
        }
        for (i64 f = 0; f < tree.records[decl].fields.len(); f++) {
            string problem = debugProblemAt(tree.records[decl].fields[f].resolved, base + "." + tree.records[decl].fields[f].name,
                ref visiting)
            if (problem.len() > 0) {
                ret problem
            }
        }
        ret ""
    }

    // Why the values of `type` cannot be converted to JSON (D251), or "" when they
    // can: the numbers, bool, string, json.Value, list<T> and map<string, T> of
    // them, the enums, and the structs whose fields can be converted.
    string jsonProblem(i32 type) const {
        map<i32, bool> visiting
        ret jsonProblemAt(type, "", ref visiting)
    }

    // `place` names the values in the message, as "Config.log"; empty for the
    // value given to json.
    string jsonProblemAt(i32 type, string place, ref map<i32, bool> visiting) const {
        string none = "it has no form in JSON"
        if (types.isBool(type) || types.isNumeric(type) || types.isError(type)) {
            ret ""
        }
        if (types.isArray(type)) {
            ret jsonProblemAt(types.element(type), place.len() == 0 ? "an element" : place + "[i]", ref visiting)
        }
        if (types.isParam(type)) {
            if (has(types.params[types.decl(type)].interfaces, dataInterface)) {
                ret ""
            }
            ret problemText(type, place, "it is not constrained to json.Data", none)
        }
        if (!types.isStruct(type)) {
            ret problemText(type, place, "", none)
        }
        i32 decl = types.decl(type)
        if (decl == stringDecl || isJsonValue(type)) {
            ret ""
        }
        if (isList(type)) {
            ret jsonProblemAt(tree.records[decl].typeArgs[0], place.len() == 0 ? "an element" : place + "[i]", ref visiting)
        }
        if (isMap(type)) {
            if (!isString(tree.records[decl].typeArgs[0])) {
                ret problemText(type, place, "the keys of JSON are strings", none)
            }
            ret jsonProblemAt(tree.records[decl].typeArgs[1], place.len() == 0 ? "a value" : place + "[key]", ref visiting)
        }
        if (visiting.contains(decl)) {
            ret ""  // already being checked: it contains a list of itself
        }
        visiting[decl] = true
        string base = place.len() == 0 ? tree.records[decl].name : place
        if (tree.records[decl].isEnum) {  // D365: the data of each case
            for (i64 c = 0; c < tree.records[decl].cases.len(); c++) {
                for (i64 f = 0; f < tree.records[decl].cases[c].fields.len(); f++) {
                    string problem = jsonProblemAt(tree.records[decl].cases[c].fields[f].resolved, base + "." +
                        tree.records[decl].cases[c].name + "." + tree.records[decl].cases[c].fields[f].name, ref visiting)
                    if (problem.len() > 0) {
                        ret problem
                    }
                }
            }
            ret ""
        }
        for (i64 f = 0; f < tree.records[decl].fields.len(); f++) {
            if (tree.records[decl].fields[f].jsonName.len() == 0) {
                continue  // json(skip)
            }
            string problem = jsonProblemAt(tree.records[decl].fields[f].resolved, base + "." + tree.records[decl].fields[f].name,
                ref visiting)
            if (problem.len() > 0) {
                ret problem
            }
        }
        ret ""
    }

    // ---- The bodies of the functions ----

    void checkBodies(bool definition) {
        i64 i = 0
        for (i < (definition ? definitions.len() : instances.len())) {  // the queue can grow meanwhile
            i32 function = definition ? definitions[i].function : instances[i].function
            string generic = definition ? definitions[i].generic : instances[i].generic
            string context = definition ? "" : instances[i].context
            i++
            if (!definition && failed.contains(generic)) {
                continue  // already reported at the definition
            }
            i32 before = diag.errorCount()
            diag.context = context
            checkFunction(function)
            diag.context = ""
            if (definition && diag.errorCount() > before) {
                failed[generic] = true
            }
        }
    }

    Loc locOf(i32 expr) const {
        ret at(curFile, tree.exprs[expr].line, tree.exprs[expr].column)
    }

    Loc stmtLoc(i32 stmt) const {
        ret at(curFile, tree.stmts[stmt].line, tree.stmts[stmt].column)
    }

    Loc variableLoc(i32 variable) const {
        ret at(tree.variables[variable].file, tree.variables[variable].line, tree.variables[variable].column)
    }

    void checkFunction(i32 function) {
        current = function
        curFile = tree.functions[function].file
        bindings = tree.functions[function].bindings
        list<map<string, i32>> fresh
        map<string, i32> first
        fresh.add(move first)
        locals = move fresh
        loops.clear()
        tryContexts.clear()
        catchTypes.clear()
        finallyLoops.clear()
        regions.clear()
        // D113, D122: the functions that the compiler calls where nobody can catch.
        i32 owner = tree.functions[function].owner
        FunctionKind kind = tree.functions[function].kind
        string functionName = tree.functions[function].name
        if (kind == FunctionKind.Destructor) {
            addRegion(0, "a destructor cannot let an exception out: catch it inside")
        } else if (kind == FunctionKind.Method && owner >= 0 && !tree.functions[function].isGenerated) {
            if (functionName == "copy" && tree.records[owner].needsDestruction) {
                addRegion(0, "copy() cannot let an exception out: catch it inside")
            }
            if (functionName == "message" && implementsException(owner)) {
                addRegion(0, "message() cannot let an exception out: catch it inside")
            }
        }
        for (i64 i = 0; i < tree.functions[function].params.len(); i++) {
            ParamMode mode = tree.functions[function].params[i].mode
            i32 variable = declare(tree.functions[function].params[i].name.copy(), tree.functions[function].paramTypes[i],
                paramLoc(function, i), tree.functions[function].params[i].isConst)
            if (variable < 0) {
                continue
            }
            tree.variables[variable].kind = mode == ParamMode.Ref ? VariableKind.RefParam : mode == ParamMode.Move ?
                VariableKind.MoveParam : VariableKind.ReadParam
        }

        i32 body = tree.functions[function].body
        Flow flow = checkBlock(body)
        tree.functions[function].bodyChecked = true

        // D47, D67: a non-void function must not reach its end.
        i32 result = tree.functions[function].resolvedReturn
        if (!types.isVoid(result) && !types.isError(result) && flow != Flow.Returns) {
            error(at(curFile, tree.blocks[body].closeLine, tree.blocks[body].closeColumn), "function '" + functionName +
                "' must end with 'ret' on every path: it returns " + name(result))
        }
    }

    void addRegion(i64 base, string message) {
        Region region
        region.base = base
        region.message = message
        regions.add(move region)
    }

    // ---- Variables and fields ----

    // The variable of a name visible here, or -1.
    i32 lookup(string name) const {
        for (i64 i = locals.len() - 1; i >= 0; i--) {
            if (locals[i].contains(name)) {
                ret locals[i][name]
            }
        }
        ret -1
    }

    // The module variable of this name, in the module of a file (D394).
    i32 findGlobal(string name, i32 file) const {
        i32 scope = scopeOf(tree, file)
        if (!scopes[scope].globals.contains(name)) {
            ret -1
        }
        ret tree.globals[scopes[scope].globals[name]].variable
    }

    // The same, or a public constant of an imported module (D564); `module` is the
    // name written in front, as in `geometry.limit`.
    i32 findConstant(string name, Loc loc, string module) {
        i32 found = findDecl(globalsTable, name, loc, module)
        ret found < 0 ? -1 : tree.globals[found].variable
    }

    // Field of the struct whose method is being checked (D70).
    i32 ownFieldIndex(string name) const {
        if (current < 0 || tree.functions[current].owner < 0) {
            ret -1
        }
        i32 owner = tree.functions[current].owner
        for (i64 i = 0; i < tree.records[owner].fields.len(); i++) {
            if (tree.records[owner].fields[i].name == name) {
                ret i32(i)
            }
        }
        ret -1
    }

    // A new variable of the function, or -1 with its error.
    i32 declare(string name, i32 type, Loc loc, bool isConst) {
        if (types.findBuiltin(name) >= 0 || findDecl(structsTable, name, loc, "") >= 0) {
            error(loc, "'" + name + "' is a type name")
            ret -1
        }
        if (ownFieldIndex(name) >= 0) {
            error(loc, "'" + name + "' is a field of " + tree.records[tree.functions[current].owner].name + ": choose another name")
            ret -1
        }
        i32 existing = lookup(name)  // D66: no shadowing, also of the variables of the module
        if (existing < 0) {
            existing = findGlobal(name, loc.file)
        }
        if (existing >= 0) {
            error(loc, format("a variable named '{}' is already visible here (declared at line {})", name,
                tree.variables[existing].line))
            ret -1
        }
        Variable variable
        variable.name = name
        variable.type = type
        variable.file = loc.file
        variable.line = loc.line
        variable.column = loc.column
        variable.isConst = isConst
        variable.id = i32(tree.functions[current].variables.len())
        tree.variables.add(move variable)
        i32 index = i32(tree.variables.len() - 1)
        tree.functions[current].variables.add(index)
        locals[locals.len() - 1][name] = index
        ret index
    }

    // A new object that nobody owns yet: it is moved without writing `move` (D23).
    bool isTemporary(i32 expr) const {
        switch (tree.exprs[expr].kind) {
            case Construct, Call, MethodCall, StringLiteral, EnumCase, Lambda, CallValue, Print, ListLiteral, Conditional {
                ret true
            }
            case Conversion {
                ret types.isInterface(tree.exprs[expr].resolved)  // a new value of an interface (D357)
            }
            default {
                ret false
            }
        }
    }

    // A variable, or a field or an element (D35) of a variable or of the object of a method.
    bool isPlace(i32 expr) const {
        ExprKind kind = tree.exprs[expr].kind
        if (kind == ExprKind.Name) {
            ret true
        }
        if (kind != ExprKind.Field && kind != ExprKind.Index) {
            ret false
        }
        i32 object = tree.exprs[expr].left
        ret tree.exprs[object].kind == ExprKind.Self || isPlace(object)
    }

    // The place as written in the source, for the messages: `s.log`, `v[i]`.
    string placeText(i32 expr) const {
        ExprKind kind = tree.exprs[expr].kind
        if (kind == ExprKind.Name) {
            ret tree.exprs[expr].text
        }
        if (kind == ExprKind.Field) {
            i32 object = tree.exprs[expr].left
            if (tree.exprs[object].kind == ExprKind.Self) {
                ret tree.exprs[expr].text
            }
            ret placeText(object) + "." + tree.exprs[expr].text
        }
        if (kind == ExprKind.Index) {
            i32 index = tree.exprs[expr].right
            string text = "..."
            if (tree.exprs[index].kind == ExprKind.Name) {
                text = tree.exprs[index].text
            }
            if (tree.exprs[index].kind == ExprKind.IntLiteral) {
                text = format("{}", tree.exprs[index].value)
            }
            ret placeText(tree.exprs[expr].left) + "[" + text + "]"
        }
        ret "the object"
    }

    Path writtenPath(i32 expr) const {
        Path path
        switch (tree.exprs[expr].kind) {
            case Name {
                path.valid = true
                path.variable = tree.exprs[expr].variable
            }
            case Self {
                path.valid = true
            }
            case Field {
                path = writtenPath(tree.exprs[expr].left)
                if (path.valid) {
                    Step step
                    step.field = tree.exprs[expr].index
                    path.steps.add(move step)
                }
            }
            case Index {
                path = writtenPath(tree.exprs[expr].left)
                if (path.valid) {
                    Step step
                    step.index = tree.exprs[expr].right
                    path.steps.add(move step)
                }
            }
            default {
            }
        }
        ret path
    }

    Path variablePath(i32 variable) const {
        Path path
        path.valid = true
        path.variable = variable
        ret path
    }

    // The value of an index known at compile time.
    bool isConstantIndex(i32 index) const {
        ret tree.exprs[index].kind == ExprKind.IntLiteral
    }

    i64 constantIndex(i32 index) const {
        i64 value = i64(tree.exprs[index].value)
        ret tree.exprs[index].negative ? 0 - value : value
    }

    // Two places overlap when one contains the other: `a` and `a.x`, but not `a.x`
    // and `a.y`. Elements whose indices are not constants may overlap: that is
    // known only at runtime (D35).
    i32 overlaps(Path a, Path b) const {
        if (a.variable != b.variable) {
            ret overlapNo
        }
        bool maybe = false
        i64 common = a.steps.len() < b.steps.len() ? a.steps.len() : b.steps.len()
        for (i64 i = 0; i < common; i++) {
            i32 x = a.steps[i].index
            i32 y = b.steps[i].index
            if (x < 0 && y < 0) {
                if (a.steps[i].field != b.steps[i].field) {
                    ret overlapNo
                }
                continue
            }
            if (x < 0 || y < 0) {
                ret overlapNo
            }
            if (isConstantIndex(x) && isConstantIndex(y)) {
                if (constantIndex(x) != constantIndex(y)) {
                    ret overlapNo
                }
                continue
            }
            maybe = true
        }
        ret maybe ? overlapMaybe : overlapYes
    }

    // Why a place cannot be modified, or an empty string if it can (D22, D24, D26).
    string readOnlyReason(i32 expr) const {
        switch (tree.exprs[expr].kind) {
            case Name {
                i32 variable = tree.exprs[expr].variable
                if (variable < 0) {
                    ret ""
                }
                string variableName = tree.variables[variable].name
                VariableKind kind = tree.variables[variable].kind
                bool isConst = tree.variables[variable].isConst
                if (kind == VariableKind.ReadParam) {
                    ret "parameter '" + variableName + "' cannot be modified: parameters are read-only"
                }
                if (kind == VariableKind.Captured && isConst) {
                    ret "'" + variableName + "' is captured to be read: capture it with 'ref " + variableName + "' to modify it"
                }
                if (tree.variables[variable].reference && isConst) {  // D562
                    ret "'" + variableName + "' is a 'const ref', which only reads: write 'ref " + name(tree.variables[variable].type) +
                        " " + variableName + " = ...' to modify it"
                }
                if (kind == VariableKind.Element && isConst) {
                    ret "'" + variableName + "' is an element of a read-only 'for': write 'for (ref " +
                        name(tree.variables[variable].type) + " " + variableName + " in ...)' to modify it"
                }
                if (kind == VariableKind.Binding && isConst) {
                    ret "'" + variableName + "' is data of the case, read-only: write 'ref " + name(tree.variables[variable].type) +
                        " " + variableName + "' in the case to modify it"
                }
                if (kind == VariableKind.Caught) {
                    ret "'" + variableName + "' is the exception of a 'catch', which is read-only"
                }
                if (isConst) {
                    ret "'" + variableName + "' is const and cannot be modified"
                }
                ret ""
            }
            case Field {
                ret readOnlyReason(tree.exprs[expr].left)  // const is deep (D24)
            }
            case Index {
                i32 object = tree.exprs[expr].left
                if (isString(tree.exprs[object].resolved)) {
                    ret "the bytes of a string are read-only: build a new string"
                }
                ret readOnlyReason(object)
            }
            case Self {
                if (tree.functions[current].isConst) {
                    ret "method '" + tree.functions[current].name + "' is const and cannot modify the fields"
                }
                ret ""
            }
            default {
                ret ""
            }
        }
    }

    // Checks the target of an assignment, `++` or `--`. Returns its type, or an error.
    i32 checkTarget(i32 target) {
        insertTarget = true  // `m[k] = v` adds the key (D197)
        i32 type = checkExpr(target, -1)
        if (types.isError(type)) {
            ret type
        }
        if (tree.exprs[target].kind == ExprKind.Name && !checkNotBlockThread(tree.exprs[target].variable, locOf(target))) {
            ret errorType()
        }
        if (!isPlace(target)) {
            error(locOf(target), "only a variable, a field or an element can be assigned")
            ret errorType()
        }
        string reason = readOnlyReason(target)
        if (reason.len() > 0) {
            error(locOf(target), reason)
            ret errorType()
        }
        if (!checkNotBorrowed(target, locOf(target))) {
            ret errorType()
        }
        ret type
    }

    // ---- Threads and tasks of a block (D215, D269), groups of tasks (D273) ----

    bool isThreadStruct(i32 record) const {
        ret (tree.records[record].name == "Thread" || tree.records[record].name == "Task") &&
            tree.files[scopeOf(tree, tree.records[record].file)].name == "std.thread"
    }

    bool isGroupStruct(i32 record) const {
        ret tree.records[record].name == "Group" && tree.files[scopeOf(tree, tree.records[record].file)].name == "std.thread"
    }

    bool isChannel(i32 type) const {
        ret types.isStruct(type) && isThreadType(types.decl(type), "Channel")
    }

    // "thread" or "task", for the messages.
    string threadWord(i32 variable) const {
        i32 type = tree.variables[variable].type
        ret types.isStruct(type) && tree.records[types.decl(type)].name == "Task" ? "task" : "thread"
    }

    // Who has a variable while it runs: a thread, a task, or the tasks of a group.
    string holderText(i32 holder) const {
        string holderName = tree.variables[holder].name
        if (tree.variables[holder].group) {
            ret "the tasks of the group '" + holderName + "' until the end of its block"
        }
        ret "the " + threadWord(holder) + " '" + holderName + "' until " + holderName + ".join()"
    }

    // A thread of a block stays where it is declared, as its lambda (D184); so does
    // a group, whose tasks read the variables of its block (D273).
    bool checkNotBlockThread(i32 variable, Loc loc) {
        if (variable < 0) {
            ret true
        }
        if (tree.variables[variable].group) {
            error(loc, "'" + tree.variables[variable].name + "' is a group of tasks, which read the variables of its block: it " +
                "cannot be moved, assigned, returned, passed with 'ref' or captured")
            ret false
        }
        if (tree.variables[variable].blockThread < 0) {
            ret true
        }
        error(loc, "'" + tree.variables[variable].name + "' is a " + threadWord(variable) + " of its block, which captures by " +
            "address: it cannot be moved, assigned, returned, passed with 'ref' or captured")
        ret false
    }

    // While a thread runs, the block does not touch what it has with `ref` (D215).
    void checkNotUsedByThread(i32 variable, Loc loc) {
        for (i64 i = 0; i < threadBorrows.len(); i++) {
            if (threadBorrows[i].exclusive && threadBorrows[i].captured == variable) {
                error(loc, "'" + tree.variables[variable].name + "' is used by " + holderText(threadBorrows[i].thread))
                ret
            }
        }
    }

    // `t.start()` and `t.join()` of a thread of a block: from start() on, what the
    // thread captures by address is lent to it, as the elements of a `for` (D101). It
    // cannot be detached, as it uses the variables of its block (D521).
    void threadControl(i32 call) {
        i32 object = tree.exprs[call].left
        string method = tree.exprs[call].text
        if (tree.exprs[object].kind != ExprKind.Name || (method != "start" && method != "join" && method != "detach")) {
            ret
        }
        i32 thread = tree.exprs[object].variable
        if (thread < 0 || tree.variables[thread].blockThread < 0) {
            ret
        }
        string word = threadWord(thread)
        string threadName = tree.variables[thread].name
        Loc loc = locOf(call)
        if (method == "detach") {
            error(loc, "the " + word + " '" + threadName + "' captures by address, and cannot be detached: it uses the variables " +
                "of its block")
            ret
        }
        if (!locals[locals.len() - 1].contains(threadName) || locals[locals.len() - 1][threadName] != thread) {
            error(loc, method + "() of a " + word + " of a block is written directly in the block that declares '" + threadName + "'")
            ret
        }
        if (method == "join") {
            endThread(thread)
            ret
        }
        if (startedThreads.contains(thread)) {  // also after join() (D219)
            error(loc, "the " + word + " '" + threadName + "' is already started")
            ret
        }
        startedThreads[thread] = true
        i32 lambda = tree.variables[thread].blockThread
        for (i64 c = 0; c < tree.exprs[lambda].captures.len(); c++) {
            i32 outer = tree.exprs[lambda].captures[c].outer
            if (outer < 0 || !tree.exprs[lambda].captures[c].byAddress) {
                continue
            }
            bool exclusive = tree.exprs[lambda].captures[c].mode == ParamMode.Ref
            for (i64 i = 0; i < threadBorrows.len(); i++) {
                if (threadBorrows[i].captured != outer || (!exclusive && !threadBorrows[i].exclusive)) {
                    continue
                }
                error(loc, "the " + word + " '" + threadName + "' cannot start: '" + tree.exprs[lambda].captures[c].name +
                    "' is used by " + holderText(threadBorrows[i].thread))
                ret
            }
            lend(thread, outer, exclusive, "while the " + word + " '" + threadName + "' runs")
        }
    }

    // What a thread or a group has until it ends.
    void lend(i32 thread, i32 captured, bool exclusive, string reason) {
        ThreadBorrow borrow
        borrow.thread = thread
        borrow.captured = captured
        borrow.exclusive = exclusive
        threadBorrows.add(move borrow)
        LoopBorrow loop
        loop.path = variablePath(captured)
        loop.reason = reason
        loop.thread = thread
        loopBorrows.add(move loop)
    }

    // The tasks of a group read what they capture by address until the end of the
    // block of the group (D273): the variables declared before the group, not
    // modified after its declaration.
    void groupReads(i32 lambda) {
        i32 group = tree.exprs[lambda].group
        string groupName = tree.variables[group].name
        for (i64 c = 0; c < tree.exprs[lambda].captures.len(); c++) {
            i32 outer = tree.exprs[lambda].captures[c].outer
            if (outer < 0 || !tree.exprs[lambda].captures[c].byAddress) {
                continue
            }
            string captureName = tree.exprs[lambda].captures[c].name
            if (tree.variables[outer].file == tree.variables[group].file && (tree.variables[outer].line > tree.variables[group].line ||
                (tree.variables[outer].line == tree.variables[group].line && tree.variables[outer].column >
                    tree.variables[group].column))) {
                error(at(curFile, tree.exprs[lambda].captures[c].line, tree.exprs[lambda].captures[c].column), "the tasks of the group '" +
                    groupName + "' read '" + captureName + "', declared after the group: declare it before, or take it with 'move'")
                continue
            }
            Path path = variablePath(outer)
            for (i64 g = 0; g < activeGroups.len(); g++) {
                if (activeGroups[g].group != group) {
                    continue
                }
                for (i64 m = 0; m < activeGroups[g].modified.len(); m++) {
                    if (overlaps(activeGroups[g].modified[m].path, path) == overlapNo) {
                        continue
                    }
                    Loc where = activeGroups[g].modified[m].where
                    error(where, "'" + captureName + "' cannot be modified after the group '" + groupName + "', whose tasks read it")
                    break
                }
            }
            bool lent = false
            for (i64 i = 0; i < threadBorrows.len(); i++) {
                lent = lent || (threadBorrows[i].thread == group && threadBorrows[i].captured == outer)
            }
            if (lent) {
                continue
            }
            lend(group, outer, false, "while the tasks of the group '" + groupName + "' read it")
        }
    }

    void endThread(i32 thread) {
        list<ThreadBorrow> borrows
        for (i64 i = 0; i < threadBorrows.len(); i++) {
            if (threadBorrows[i].thread != thread) {
                borrows.add(threadBorrows[i])
            }
        }
        threadBorrows = move borrows
        list<LoopBorrow> loans
        for (i64 i = 0; i < loopBorrows.len(); i++) {
            if (loopBorrows[i].thread != thread) {
                loans.add(loopBorrows[i])
            }
        }
        loopBorrows = move loans
        list<GroupLog> groups
        for (i64 i = 0; i < activeGroups.len(); i++) {
            if (activeGroups[i].group != thread) {
                groups.add(activeGroups[i])
            }
        }
        activeGroups = move groups
    }

    // D101: while a `for` goes over the elements of a list, the list cannot be
    // modified, except its elements through the variable of the loop.
    bool checkNotBorrowed(i32 place, Loc loc) {
        Path path = pathOf(place)
        if (!path.valid) {
            ret true
        }
        for (i64 g = 0; g < activeGroups.len(); g++) {  // D273
            Modified modified
            modified.path = path
            modified.where = loc
            activeGroups[g].modified.add(move modified)
        }
        for (i64 i = 0; i < loopBorrows.len(); i++) {
            if (through(place, loopBorrows[i].thread)) {
                continue  // D562
            }
            if (overlaps(path, loopBorrows[i].path) == overlapNo) {
                continue
            }
            error(loc, "'" + placeText(place) + "' cannot be modified " + loopBorrows[i].reason)
            ret false
        }
        ret true
    }

    // Whether `move` can take the value of this place (D23, D26, D78).
    bool canMove(i32 place) const {
        if (tree.exprs[place].kind == ExprKind.Name) {
            i32 variable = tree.exprs[place].variable
            if (variable < 0) {
                ret false
            }
            VariableKind kind = tree.variables[variable].kind
            ret kind != VariableKind.ReadParam && !((kind == VariableKind.Element || kind == VariableKind.Binding) &&
                tree.variables[variable].isConst) && kind != VariableKind.Caught && kind != VariableKind.Captured
        }
        ret readOnlyReason(place).len() == 0
    }

    // A struct can be copied if it has copy(), or if the compiler can generate it (D35).
    bool canCopy(i32 type) const {
        if (types.isFunction(type)) {
            ret false  // it owns its captured data (D184)
        }
        if (types.isInterface(type)) {
            ret false  // its type is not known (D358)
        }
        if (types.isArray(type)) {
            ret !needsDestruction(tree, types, type)  // only arrays of simple values
        }
        if (!types.isStruct(type)) {
            ret true
        }
        i32 decl = types.decl(type)
        if (tree.records[decl].methods.contains("copy")) {
            ret true
        }
        if (tree.records[decl].destructor >= 0) {
            ret false
        }
        for (i64 f = 0; f < tree.records[decl].fields.len(); f++) {
            if (!canCopy(tree.records[decl].fields[f].resolved)) {
                ret false
            }
        }
        for (i64 c = 0; c < tree.records[decl].cases.len(); c++) {
            for (i64 f = 0; f < tree.records[decl].cases[c].fields.len(); f++) {
                if (!canCopy(tree.records[decl].cases[c].fields[f].resolved)) {
                    ret false
                }
            }
        }
        ret true
    }

    // The copy() of a struct: written by hand, or generated the first time it is
    // used (D35); -1 when it cannot be copied.
    i32 copyFunction(i32 decl, Loc loc) {
        if (tree.records[decl].methods.contains("copy")) {
            i32 found = tree.records[decl].methods["copy"]
            use(found, loc)
            ret found
        }
        if (!canCopy(types.structType(decl))) {
            ret -1
        }
        for (i64 f = 0; f < tree.records[decl].fields.len(); f++) {
            i32 type = tree.records[decl].fields[f].resolved
            if (needsDestruction(tree, types, type)) {
                copyFunction(types.decl(type), loc)
            }
        }
        for (i64 c = 0; c < tree.records[decl].cases.len(); c++) {
            for (i64 f = 0; f < tree.records[decl].cases[c].fields.len(); f++) {
                i32 type = tree.records[decl].cases[c].fields[f].resolved
                if (needsDestruction(tree, types, type)) {
                    copyFunction(types.decl(type), loc)
                }
            }
        }
        Function copy
        copy.kind = FunctionKind.Method
        copy.name = "copy"
        copy.file = tree.records[decl].file
        copy.line = tree.records[decl].line
        copy.column = tree.records[decl].column
        copy.isConst = true
        copy.isGenerated = true
        copy.owner = decl
        copy.resolvedReturn = types.structType(decl)
        tree.functions.add(move copy)
        i32 index = i32(tree.functions.len() - 1)
        tree.records[decl].methods["copy"] = index
        tree.records[decl].generatedCopy = index
        ret index
    }

    // D103: a method of an instance of a generic struct with real types is checked,
    // and emitted, the first time it is used.
    void use(i32 member, Loc loc) {
        if (member < 0 || tree.functions[member].scheduled || tree.functions[member].isGenerated || tree.functions[member].owner < 0 ||
            tree.functions[member].typeParams.len() > 0) {
            ret
        }
        i32 owner = tree.functions[member].owner
        if (tree.records[owner].generic < 0 || tree.records[owner].isAbstract) {
            ret
        }
        schedule(member, format("r{}", tree.records[owner].generic), false, tree.records[owner].name.copy(), loc)
    }

    // Moves the node of an expression to a new place, and gives its index: its old
    // place is then for the node that takes it, which the others still name (D418).
    i32 relocate(i32 expr) {
        Expr node = tree.exprs[expr]
        tree.exprs.add(move node)
        ret i32(tree.exprs.len() - 1)
    }

    // A new node of a kind, at the position of another one.
    Expr nodeAt(ExprKind kind, i32 line, i32 column) const {
        Expr node
        node.kind = kind
        node.line = line
        node.column = column
        ret node
    }

    // Puts `expr` inside a new node of `kind`, as its operand: the new node takes
    // its place.
    void wrap(i32 expr, ExprKind kind, i32 type) {
        Expr node = nodeAt(kind, tree.exprs[expr].line, tree.exprs[expr].column)
        node.left = relocate(expr)
        node.resolved = type
        tree.exprs[expr] = move node
    }

    // D424: a value that owns resources is copied where it is given without `move`,
    // with its copy(), generated (D35) or written by hand (D83). Returns false after
    // reporting the error, for a type that cannot be copied.
    bool copyIfNeeded(i32 value, i32 type) {
        if (types.isParam(type)) {
            ret true  // D85: checked in each instance
        }
        if (!needsDestruction(tree, types, type) || isTemporary(value) || tree.exprs[value].kind == ExprKind.Move) {
            ret true
        }
        if (types.isStruct(type) && canCopy(type)) {
            i32 method = copyFunction(types.decl(type), locOf(value))
            if (method >= 0) {
                wrap(value, ExprKind.MethodCall, type)
                tree.exprs[value].text = "copy"
                tree.exprs[value].target = method
                noteCall(method, locOf(value))
                ret true
            }
        }
        string advice = isPlace(value) && canMove(value) ? "write 'move " + placeText(value) + "'" :
            "it can be neither moved nor copied here"
        error(locOf(value), "values of type " + name(type) + " cannot be copied: " + advice)
        ret false
    }

    // `move x` (D23, D78, D80). The operand must be a variable or a field.
    i32 checkMove(i32 node) {
        i32 operand = tree.exprs[node].left
        Loc loc = locOf(node)
        if (isTemporary(operand)) {
            checkExpr(operand, -1)
            error(loc, "'move' is not needed before a new object: it is moved anyway")
            ret errorType()
        }
        i32 type = checkExpr(operand, -1)
        if (types.isError(type)) {
            ret type
        }
        if (!isPlace(operand)) {
            error(loc, "'move' is written before a variable or a field")
            ret errorType()
        }
        if (!needsDestruction(tree, types, type)) {
            tree.exprs[node].moveKind = MoveKind.Copy  // D80
            ret type
        }
        if (tree.exprs[operand].kind == ExprKind.Name) {
            i32 variable = tree.exprs[operand].variable
            if (!checkNotBlockThread(variable, loc)) {
                ret errorType()
            }
            string variableName = tree.variables[variable].name
            switch (tree.variables[variable].kind) {
                case Local, MoveParam {
                    if (!checkNotBorrowed(operand, loc)) {
                        ret errorType()
                    }
                    tree.exprs[node].moveKind = MoveKind.Variable
                    tree.variables[variable].needsDropFlag = true
                    ret type
                }
                case RefParam {
                    tree.exprs[node].moveKind = MoveKind.Take  // D78
                    ret type
                }
                case ReadParam {
                    error(loc, "parameter '" + variableName + "' is read-only: it belongs to the caller and cannot be moved")
                    ret errorType()
                }
                case Caught {
                    error(loc, "cannot move '" + variableName + "': it is the exception of a 'catch'")
                    ret errorType()
                }
                case Captured {
                    error(loc, "cannot move '" + variableName + "': it is captured, and the lambda can run again")
                    ret errorType()
                }
                case Binding, Element {
                    if (tree.variables[variable].isConst) {
                        error(loc, "cannot move '" + variableName + "': " + (tree.variables[variable].reference ?
                            "it is a 'const ref', which only reads" : tree.variables[variable].kind == VariableKind.Element ?
                            "it is an element of a read-only 'for'" : "it is read-only data of the case"))
                        ret errorType()
                    }
                    tree.exprs[node].moveKind = MoveKind.Take  // D78
                    ret type
                }
                default {
                }
            }
        }
        string reason = readOnlyReason(operand)
        if (reason.len() > 0) {
            error(loc, "cannot move '" + placeText(operand) + "': " + reason)
            ret errorType()
        }
        if (!checkNotBorrowed(operand, loc)) {
            ret errorType()
        }
        tree.exprs[node].moveKind = MoveKind.Take  // D78
        ret type
    }

    // A value that can be written with `move`: an initialization, an assignment,
    // the argument of a `move` parameter, or after `ret` (D82).
    bool coerceValue(i32 expr, i32 target) {
        moveAllowed = tree.exprs[expr].kind == ExprKind.Move
        ret coerce(expr, target, false)
    }

    // ---- Statements ----

    Flow checkBlock(i32 block) {
        map<string, i32> scope
        locals.add(move scope)
        Flow flow = Flow.Continues
        bool warned = false
        i32 outerBlock = blockNow
        i64 outerIndex = indexNow
        for (i64 i = 0; i < tree.blocks[block].statements.len(); i++) {
            i32 statement = tree.blocks[block].statements[i]
            if (flow != Flow.Continues && !warned) {
                diag.warningIn(curFile, tree.stmts[statement].line, tree.stmts[statement].column, "unreachable code")
                warned = true
            }
            blockNow = block
            indexNow = i
            Flow next = checkStatement(statement)
            if (flow == Flow.Continues) {
                flow = next
            }
            // D562: a reference lends its place until the statement of its last use.
            list<i32> over
            for (string key, i32 variable in locals[locals.len() - 1]) {
                if (tree.variables[variable].reference && refEnds.contains(variable) && refEnds[variable] == i) {
                    over.add(variable)
                }
            }
            for (i32 variable in over) {
                endThread(variable)
            }
        }
        blockNow = outerBlock
        indexNow = outerIndex
        // The threads and the groups of this block end with it (D215, D273).
        list<i32> ended
        for (string key, i32 variable in locals[locals.len() - 1]) {
            if (tree.variables[variable].blockThread >= 0 || tree.variables[variable].group || tree.variables[variable].reference) {
                ended.add(variable)
            }
        }
        for (i32 variable in ended) {
            endThread(variable)
        }
        locals.remove(locals.len() - 1)
        ret flow
    }

    Flow checkStatement(i32 statement) {
        switch (tree.stmts[statement].kind) {
            case VarDecl {
                checkVarDecl(statement)
                ret Flow.Continues
            }
            case Assign {
                checkAssign(statement)
                ret Flow.Continues
            }
            case IncDec {
                i32 type = checkTarget(tree.stmts[statement].target)
                if (!types.isError(type) && !types.isInt(type)) {
                    error(stmtLoc(statement), "'++' and '--' only work on integers, found " + name(type))
                }
                ret Flow.Continues
            }
            case Expression {
                ret checkExprStmt(statement)
            }
            case If {
                ret checkIf(statement)
            }
            case For {
                ret checkFor(statement)
            }
            case Switch {
                ret checkSwitch(statement)
            }
            case Throw {
                ret checkThrow(statement)
            }
            case Try {
                ret checkTry(statement)
            }
            case Break, Continue {
                string word = tree.stmts[statement].kind == StmtKind.Break ? "'break'" : "'continue'"
                if (switchLoops.len() > 0 && switchLoops[switchLoops.len() - 1] == loops.len()) {
                    error(stmtLoc(statement), word + " cannot be used in a 'switch': a branch ends by itself")
                } else if (finallyLoops.len() > 0 && loops.len() <= finallyLoops[finallyLoops.len() - 1]) {
                    error(stmtLoc(statement), word + " cannot leave a 'finally' block")
                } else if (loops.len() == 0) {
                    error(stmtLoc(statement), word + " can only be used inside a 'for'")
                } else if (tree.stmts[statement].kind == StmtKind.Break) {
                    loops[loops.len() - 1] = true
                }
                ret Flow.Jumps
            }
            case Return {
                checkReturn(statement)
                ret Flow.Returns
            }
        }
    }

    void checkVarDecl(i32 decl) {
        if (tree.stmts[decl].isRef) {
            checkReference(decl)
            ret
        }
        i32 node = tree.stmts[decl].type
        i32 type = resolveOrError(node, curFile)
        if (types.isVoid(type)) {
            error(typeLoc(node, curFile), "a variable cannot be void")
            type = errorType()
        }
        if (!checkNotInterface(type, typeLoc(node, curFile), "a variable")) {
            type = errorType()
        }
        Loc nameLoc = at(curFile, tree.stmts[decl].nameLine, tree.stmts[decl].nameColumn)
        i32 init = tree.stmts[decl].value
        bool isConst = tree.stmts[decl].isConst
        if (isConst && init < 0) {
            error(nameLoc, "a const variable must have a value")
        }
        if (init >= 0 && !types.isError(type)) {
            threadInit = init
            if (coerceValue(init, type)) {
                copyIfNeeded(init, type)
            }
            threadInit = -1
        }
        i32 variable = declare(tree.stmts[decl].name.copy(), type, nameLoc, isConst)
        tree.stmts[decl].variable = variable
        if (variable >= 0 && init >= 0 && tree.exprs[init].kind == ExprKind.Construct) {
            tree.variables[variable].blockThread = tree.exprs[init].blockThread
        }
        if (variable >= 0 && types.isStruct(type) && isGroupStruct(types.decl(type))) {  // D273
            tree.variables[variable].group = true
            GroupLog log
            log.group = variable
            activeGroups.add(move log)
        }
    }

    void checkAssign(i32 assign) {
        i32 target = tree.stmts[assign].target
        i32 value = tree.stmts[assign].value
        AssignOp op = tree.stmts[assign].op
        i32 type = checkTarget(target)
        if (types.isError(type)) {
            moveAllowed = tree.exprs[value].kind == ExprKind.Move
            checkExpr(value, -1)
            ret
        }
        if (op == AssignOp.Add && isString(type)) {
            checkAppend(assign)
            ret
        }
        if (op != AssignOp.Assign) {
            if (!types.isNumeric(type)) {
                error(stmtLoc(assign), "this compound assignment needs a number, found " + name(type))
                ret
            }
            if (op == AssignOp.Rem && !types.isInt(type)) {
                error(stmtLoc(assign), "'%' only works on integers")
                ret
            }
            bool bits = op == AssignOp.BitAnd || op == AssignOp.BitOr || op == AssignOp.BitXor || op == AssignOp.Shl ||
                op == AssignOp.Shr
            if (bits && !types.isInt(type)) {
                error(stmtLoc(assign), "the bitwise operators only work on integers")
                ret
            }
            if (op == AssignOp.Shl || op == AssignOp.Shr) {  // the count is any integer (D195)
                i32 count = checkExpr(value, type)
                if (types.isUntyped(count) && !coerce(value, type, false)) {
                    ret
                }
                if (!types.isError(count) && !types.isInt(count) && !types.isUntyped(count)) {
                    error(stmtLoc(assign), "the count of a shift is an integer, found " + name(count) + "")
                }
                ret
            }
        }
        if (coerceValue(value, type)) {
            copyIfNeeded(value, type)
        }
    }

    // D95: `s += t` appends `t` to `s`, with the method of the library.
    void checkAppend(i32 assign) {
        i32 target = tree.stmts[assign].target
        i32 value = tree.stmts[assign].value
        if (!coerce(value, tree.exprs[target].resolved, false)) {
            ret
        }
        i32 append = tree.records[stringDecl].methods["append"]
        Expr call = nodeAt(ExprKind.MethodCall, tree.stmts[assign].line, tree.stmts[assign].column)
        call.left = target
        call.text = "append"
        call.items.add(value)
        call.target = append
        call.resolved = voidType()
        tree.exprs.add(move call)
        i32 index = i32(tree.exprs.len() - 1)
        checkExclusivity(tree.exprs[index].items.copy(), append, target, index)
        tree.stmts[assign].call = index
    }

    Flow checkExprStmt(i32 statement) {
        i32 expr = tree.stmts[statement].value
        ExprKind kind = tree.exprs[expr].kind
        if (kind != ExprKind.Call && kind != ExprKind.MethodCall && kind != ExprKind.CallValue) {
            error(locOf(expr), "this expression does nothing: only function calls can be statements")
            ret Flow.Continues
        }
        checkExpr(expr, -1)
        if (tree.exprs[expr].kind == ExprKind.MethodCall) {
            threadControl(expr)
        }
        // D102: a panic ends the path, like `ret` (D67).
        bool panics = tree.exprs[expr].kind == ExprKind.Call && tree.exprs[expr].intrinsic == Intrinsic.Panic
        ret panics ? Flow.Returns : Flow.Continues
    }

    // `embed("logo.png")` (D470): the bytes of a file, read by the compiler from the
    // folder of the source file that names it. It becomes a string literal with
    // those bytes and its bytes(): the list is a copy of the bytes in the program.
    i32 checkEmbed(i32 expr) {
        Loc loc = locOf(expr)
        list<i32> args = tree.exprs[expr].items
        if (args.len() != 1 || tree.exprs[args[0]].kind != ExprKind.StringLiteral) {
            error(loc, "embed takes the name of a file as a string literal: embed(\"logo.png\")")
            checkIgnored(args)
            ret errorType()
        }
        string fileName = tree.exprs[args[0]].text
        string problem = embedProblem(diag.path(curFile), fileName)
        if (problem.len() > 0) {
            error(locOf(args[0]), "cannot embed " + fileName + ": " + problem + "")
            ret errorType()
        }
        // The bytes are read again when the code is generated: here the literal is empty.
        Expr literal = nodeAt(ExprKind.StringLiteral, loc.line, loc.column)
        literal.flag = true  // its bytes are those of the file in `module`
        literal.module = embedFile(diag.path(curFile), fileName)
        tree.exprs.add(move literal)
        Expr call = nodeAt(ExprKind.MethodCall, loc.line, loc.column)
        call.left = i32(tree.exprs.len() - 1)
        call.text = "bytes"
        tree.exprs[expr] = move call
        ret checkMethodCall(expr)
    }

    // `assert(condition)` (D351): a panic when it is false, with the condition as
    // written and, for a comparison of numbers or bools, the sides that are not
    // literals, whose values the generated code shows.
    i32 checkAssert(i32 call) {
        tree.exprs[call].intrinsic = Intrinsic.Assert
        tree.exprs[call].typeArg = types.structType(stringDecl)  // of the message
        list<i32> args = tree.exprs[call].items
        if (args.len() != 1 || tree.exprs[call].typeArgs.len() > 0) {
            error(locOf(call), "assert takes one condition: assert(total == 7)")
            checkIgnored(args)
            ret errorType()
        }
        i32 condition = args[0]
        checkCondition(condition)
        i64 textBegin = tree.exprs[call].textBegin
        i64 textEnd = tree.exprs[call].textEnd
        string written = sourceText(diag.text(curFile), textBegin, textEnd)
        tree.exprs[call].assertText = written.len() == 0 ? "the condition" : written
        if (tree.exprs[condition].kind != ExprKind.Binary) {
            ret voidType()
        }
        i32 type = tree.exprs[condition].operandType
        i64 opBegin = tree.exprs[condition].opBegin
        i64 opEnd = tree.exprs[condition].opEnd
        bool compared = isComparison(tree.exprs[condition].binary) && opEnd > 0
        if (!compared || !(types.isNumeric(type) || types.isBool(type))) {
            ret voidType()
        }
        if (!isLiteral(tree.exprs[condition].left)) {
            tree.exprs[call].leftText = sourceText(diag.text(curFile), textBegin, opBegin)
        }
        if (!isLiteral(tree.exprs[condition].right)) {
            tree.exprs[call].rightText = sourceText(diag.text(curFile), opEnd, textEnd)
        }
        ret voidType()
    }

    bool isLiteral(i32 expr) const {
        switch (tree.exprs[expr].kind) {
            case IntLiteral, FloatLiteral, BoolLiteral, StringLiteral {
                ret true
            }
            case Unary, Conversion {
                ret isLiteral(tree.exprs[expr].left)  // -1
            }
            default {
                ret false
            }
        }
    }

    void checkCondition(i32 condition) {
        i32 type = checkExpr(condition, boolType())
        if (!types.isBool(type) && !types.isError(type)) {
            error(locOf(condition), "the condition must be a bool, found " + name(type) + ": compare it explicitly, for example x != 0")
        }
    }

    Flow checkIf(i32 statement) {
        checkCondition(tree.stmts[statement].value)
        Flow thenFlow = checkBlock(tree.stmts[statement].body)
        if (tree.stmts[statement].elseBody < 0) {
            ret Flow.Continues
        }
        Flow elseFlow = checkBlock(tree.stmts[statement].elseBody)
        if (thenFlow == Flow.Continues || elseFlow == Flow.Continues) {
            ret Flow.Continues
        }
        ret thenFlow == Flow.Returns && elseFlow == Flow.Returns ? Flow.Returns : Flow.Jumps
    }

    // What the flows of the branches of a statement give together.
    Flow joinFlows(list<Flow> flows) const {
        bool returns = true
        for (Flow flow in flows) {
            if (flow == Flow.Continues) {
                ret Flow.Continues
            }
            returns = returns && flow == Flow.Returns
        }
        ret returns ? Flow.Returns : Flow.Jumps
    }

    // `switch` on an enum, an integer or a string (D34, D106-D109, D116, D117).
    Flow checkSwitch(i32 statement) {
        if (tree.stmts[statement].value < 0) {
            i32 owner = tree.functions[current].owner
            if (owner < 0 || !tree.records[owner].isEnum) {
                error(stmtLoc(statement), "'switch' needs a value, switch (x) { ... }: only in the methods of an enum it looks at " +
                    "the value of the method")
                ret Flow.Continues
            }
            Expr object = nodeAt(ExprKind.Self, tree.stmts[statement].line, tree.stmts[statement].column)
            tree.exprs.add(move object)
            tree.stmts[statement].value = i32(tree.exprs.len() - 1)
        }
        i32 value = tree.stmts[statement].value
        i32 type = checkExpr(value, -1)
        bool isEnum = types.isStruct(type) && tree.records[types.decl(type)].isEnum
        bool ok = !types.isError(type)
        if (ok && !isEnum && !types.isInt(type) && !isString(type)) {
            error(locOf(value), "'switch' works on enums, integers and strings, found " + name(type) + "")
            ok = false
        }
        bool modifiable = (isPlace(value) || tree.exprs[value].kind == ExprKind.Self) && readOnlyReason(value).len() == 0
        Path path = pathOf(value)
        list<bool> covered
        if (isEnum) {
            for (i64 i = 0; i < tree.records[types.decl(type)].cases.len(); i++) {
                covered.add(false)
            }
        }
        list<string> seen
        list<Flow> flows
        switchLoops.add(loops.len())
        for (i64 b = 0; b < tree.stmts[statement].parts.len(); b++) {
            i32 branch = tree.stmts[statement].parts[b]
            map<string, i32> scope
            locals.add(move scope)
            bool named = false
            i64 patterns = tree.branches[branch].patterns.len()
            for (i64 p = 0; p < patterns && ok; p++) {
                if (isEnum) {
                    named = checkCasePattern(branch, p, type, ref covered, patterns, modifiable, value) || named
                } else {
                    checkLiteralPattern(branch, p, type, ref seen)
                }
            }
            if (named && path.valid) {
                LoopBorrow borrow
                borrow.path = path
                borrow.reason = "while a 'switch' uses the data of its case"
                loopBorrows.add(move borrow)
            }
            flows.add(checkBlock(tree.branches[branch].body))
            if (named && path.valid) {
                loopBorrows.remove(loopBorrows.len() - 1)
            }
            locals.remove(locals.len() - 1)
        }
        bool hasDefault = tree.stmts[statement].defaultBody >= 0
        if (hasDefault) {
            flows.add(checkBlock(tree.stmts[statement].defaultBody))
        }
        switchLoops.remove(switchLoops.len() - 1)

        bool all = isEnum
        for (bool done in covered) {
            all = all && done
        }
        bool exhaustive = hasDefault || all
        tree.stmts[statement].exhaustive = exhaustive
        if (ok && isEnum && !exhaustive) {
            string missing
            for (i64 i = 0; i < covered.len(); i++) {
                if (!covered[i]) {
                    missing += (missing.len() == 0 ? "" : ", ") + tree.records[types.decl(type)].cases[i].name
                }
            }
            error(stmtLoc(statement), "'switch' does not cover " + missing + " of " + name(type) + ": add the cases, or 'default'")
        }
        if (!exhaustive) {
            ret Flow.Continues
        }
        ret joinFlows(flows)
    }

    // A case of an enum in a `switch`. Returns true if it names the data (D107).
    bool checkCasePattern(i32 branch, i64 p, i32 type, ref list<bool> covered, i64 patterns, bool modifiable, i32 value) {
        i32 decl = types.decl(type)
        string declName = tree.records[decl].name
        string written = tree.branches[branch].patterns[p].name
        Loc loc = at(curFile, tree.branches[branch].patterns[p].line, tree.branches[branch].patterns[p].column)
        if (tree.branches[branch].patterns[p].literal >= 0) {
            error(loc, "the cases of " + declName + " are written by their name")
            ret false
        }
        i32 index = -1
        for (i64 i = 0; i < tree.records[decl].cases.len(); i++) {
            if (tree.records[decl].cases[i].name == written) {
                index = i32(i)
            }
        }
        if (index < 0) {
            error(loc, declName + " has no case '" + written + "'")
            ret false
        }
        tree.branches[branch].patterns[p].caseIndex = index
        if (covered[index]) {
            error(loc, "case '" + written + "' is already in this 'switch'")
        }
        covered[index] = true
        if (!tree.branches[branch].patterns[p].hasBindings) {
            ret false
        }
        if (patterns > 1) {
            error(loc, "a branch with several cases cannot name their data")
            ret false
        }
        i64 given = tree.branches[branch].patterns[p].bindings.len()
        i64 count = tree.records[decl].cases[index].fields.len()
        if (given != count) {
            error(loc, format("case '{}' has {} data, but {}{}", written, count, given, given == 1 ? " name was given" :
                " names were given"))
            ret false
        }
        for (i64 i = 0; i < given; i++) {
            i32 node = tree.branches[branch].patterns[p].bindings[i].type
            bool isRef = tree.branches[branch].patterns[p].bindings[i].isRef
            string bindingName = tree.branches[branch].patterns[p].bindings[i].name
            Loc bindingLoc = at(curFile, tree.branches[branch].patterns[p].bindings[i].line,
                tree.branches[branch].patterns[p].bindings[i].column)
            i32 expected = tree.records[decl].cases[index].fields[i].resolved
            i32 resolved = resolveOrError(node, curFile)
            if (!types.isError(resolved) && resolved != expected) {
                error(typeLoc(node, curFile), "the data '" + tree.records[decl].cases[index].fields[i].name + "' of " + written + " is " +
                    name(expected) + ": write " + name(expected) + " " + bindingName + "")
                resolved = errorType()
            }
            if (isRef && !modifiable) {
                string reason = isPlace(value) || tree.exprs[value].kind == ExprKind.Self ? readOnlyReason(value) :
                    "the value of the 'switch' is not a variable or a field"
                error(bindingLoc, "cannot modify the data with 'ref': " + reason)
            }
            i32 variable = declare(bindingName, resolved, bindingLoc, !isRef)
            if (variable >= 0) {
                tree.variables[variable].kind = VariableKind.Binding
            }
            tree.branches[branch].patterns[p].bindings[i].variable = variable
        }
        ret true
    }

    // A literal in a `switch` on an integer or a string (D109).
    void checkLiteralPattern(i32 branch, i64 p, i32 type, ref list<string> seen) {
        Loc loc = at(curFile, tree.branches[branch].patterns[p].line, tree.branches[branch].patterns[p].column)
        i32 literal = tree.branches[branch].patterns[p].literal
        if (literal < 0) {
            error(loc, "the cases of a switch on a " + name(type) + " are literals")
            ret
        }
        bool text = tree.exprs[literal].kind == ExprKind.StringLiteral
        if (text != isString(type)) {
            error(loc, "this case is not a " + name(type))
            ret
        }
        if (!coerce(literal, type, false)) {
            ret
        }
        string key = text ? tree.exprs[literal].text : constantText(literal)
        for (string other in seen) {
            if (other == key) {
                error(loc, "this value is already in this 'switch'")
                ret
            }
        }
        seen.add(key)
    }

    // The value of an integer literal, as text, after coerce.
    string constantText(i32 expr) const {
        if (tree.exprs[expr].kind == ExprKind.Conversion) {
            ret constantText(tree.exprs[expr].left)
        }
        if (tree.exprs[expr].kind != ExprKind.IntLiteral) {
            ret "?"
        }
        ret format("{}{}", tree.exprs[expr].negative && tree.exprs[expr].value != 0 ? "-" : "", tree.exprs[expr].value)
    }

    bool implementsException(i32 record) {
        ret exceptionDecl >= 0 && has(implementsOf(record), exceptionDecl)
    }

    // The methods that a struct gives to an interface: used through its method table (D103).
    void useMethodsFor(i32 type, i32 iface, Loc loc) {
        if (!types.isStruct(type)) {
            ret
        }
        i32 decl = types.decl(type)
        for (i64 m = 0; m < tree.interfaces[iface].methods.len(); m++) {
            string methodName = tree.functions[tree.interfaces[iface].methods[m]].name
            if (tree.records[decl].methods.contains(methodName)) {
                use(tree.records[decl].methods[methodName], loc)
            }
        }
    }

    // `throw x`, or `throw` alone in a `catch` (D36, D114, D119).
    Flow checkThrow(i32 statement) {
        i32 value = tree.stmts[statement].value
        Loc loc = stmtLoc(statement)
        if (value < 0) {
            if (catchTypes.len() == 0) {
                error(loc, "'throw' alone rethrows the exception of a 'catch': it can be used only inside one")
            } else {
                i32 caught = catchTypes[catchTypes.len() - 1]
                noteThrow(types.isStruct(caught) ? types.decl(caught) : -1, loc)
            }
            ret Flow.Returns
        }
        moveAllowed = tree.exprs[value].kind == ExprKind.Move
        i32 type = checkExpr(value, -1)
        if (types.isError(type)) {
            ret Flow.Returns
        }
        if (!types.isStruct(type) || !implementsException(types.decl(type))) {
            error(locOf(value), "only a struct or an enum that implements Exception can be thrown, found " + name(type) + "")
            ret Flow.Returns
        }
        copyIfNeeded(value, type)
        useMethodsFor(type, exceptionDecl, loc)
        noteThrow(types.decl(type), loc)
        ret Flow.Returns
    }

    // `try`, `catch` and `finally` (D16, D113, D114, D118, D120).
    Flow checkTry(i32 statement) {
        TryContext context
        for (i64 c = 0; c < tree.stmts[statement].parts.len(); c++) {
            i32 clause = tree.stmts[statement].parts[c]
            i32 node = tree.catches[clause].type
            i32 type = resolveOrError(node, curFile)
            tree.catches[clause].resolved = type
            if (types.isError(type)) {
                continue
            }
            bool all = types.isInterface(type) && types.decl(type) == exceptionDecl
            if (!all && !(types.isStruct(type) && implementsException(types.decl(type)))) {
                error(typeLoc(node, curFile), "a 'catch' takes a struct that implements Exception, or Exception itself, found " +
                    name(type) + "")
                tree.catches[clause].resolved = errorType()
                continue
            }
            bool repeated = !all && has(context.caught, types.decl(type))
            if (context.catchAll || repeated) {
                error(typeLoc(node, curFile), "this 'catch' is never reached: a previous one already catches " + (context.catchAll ?
                    "every exception" : name(type)) + "")
            }
            if (all) {
                context.catchAll = true
            } else {
                context.caught.add(types.decl(type))
                useMethodsFor(type, exceptionDecl, typeLoc(node, curFile))
            }
        }

        tryContexts.add(move context)
        list<Flow> flows
        flows.add(checkBlock(tree.stmts[statement].body))
        tryContexts.remove(tryContexts.len() - 1)
        for (i64 c = 0; c < tree.stmts[statement].parts.len(); c++) {
            i32 clause = tree.stmts[statement].parts[c]
            map<string, i32> scope
            locals.add(move scope)
            i32 resolved = tree.catches[clause].resolved
            i32 variable = declare(tree.catches[clause].name.copy(), resolved, at(curFile, tree.catches[clause].nameLine,
                tree.catches[clause].nameColumn), true)
            if (variable >= 0) {
                tree.variables[variable].kind = VariableKind.Caught
            }
            tree.catches[clause].variable = variable
            catchTypes.add(resolved)
            flows.add(checkBlock(tree.catches[clause].body))
            catchTypes.remove(catchTypes.len() - 1)
            locals.remove(locals.len() - 1)
        }
        if (tree.stmts[statement].elseBody >= 0) {
            addRegion(tryContexts.len(), "a 'finally' block cannot let an exception out: catch it inside")
            finallyLoops.add(loops.len())
            checkBlock(tree.stmts[statement].elseBody)
            finallyLoops.remove(finallyLoops.len() - 1)
            regions.remove(regions.len() - 1)
        }
        ret joinFlows(flows)
    }

    // D36: where an exception can come from. A call is protected by an enclosing
    // `try` that catches everything; the regions of D113 are checked at the end,
    // when it is known which functions can throw.
    void noteCall(i32 callee, Loc loc) {
        if (callee < 0 || tree.functions[current].isAbstract) {
            ret
        }
        if (!protectedFrom(-1, 0)) {
            if (!throwInfo.contains(current)) {
                ThrowInfo info
                throwInfo[current] = move info
            }
            throwInfo[current].calls.add(callee)
        }
        for (i64 r = 0; r < regions.len(); r++) {
            if (!protectedFrom(-1, regions[r].base)) {
                Escape escape
                escape.loc = loc
                escape.callee = callee
                escape.message = regions[r].message
                escapes.add(move escape)
            }
        }
    }

    void noteThrow(i32 thrown, Loc loc) {
        if (tree.functions[current].isAbstract) {
            ret
        }
        if (!protectedFrom(thrown, 0)) {
            if (!throwInfo.contains(current)) {
                ThrowInfo info
                throwInfo[current] = move info
            }
            throwInfo[current].throws = true
        }
        for (i64 r = 0; r < regions.len(); r++) {
            if (!protectedFrom(thrown, regions[r].base)) {
                Escape escape
                escape.loc = loc
                escape.message = regions[r].message
                escapes.add(move escape)
            }
        }
    }

    // Whether an enclosing `try` body, from `base` on, catches the exception
    // (any exception, when it is not known).
    bool protectedFrom(i32 thrown, i64 base) const {
        for (i64 i = base; i < tryContexts.len(); i++) {
            if (tryContexts[i].catchAll) {
                ret true
            }
            if (thrown >= 0 && has(tryContexts[i].caught, thrown)) {
                ret true
            }
        }
        ret false
    }

    // D36: which functions can let an exception out, from the calls that are not
    // caught. An interface method can throw if one of its implementations can,
    // and then all of them take the hidden parameter of the exception.
    void computeThrows() {
        list<i32> throwing
        for (i32 function, ThrowInfo info in throwInfo) {
            throwing.add(function)
        }
        for (i32 function in throwing) {
            tree.functions[function].canThrow = throwInfo[function].throws
        }
        list<i32> required  // the methods of the interfaces, and next to each the method of a struct
        list<i32> given
        for (i64 r = 0; r < tree.records.len(); r++) {
            if (tree.records[r].isAbstract || tree.records[r].typeParams.len() > 0) {
                continue
            }
            for (i32 iface in implementsOf(i32(r))) {
                for (i64 m = 0; m < tree.interfaces[iface].methods.len(); m++) {
                    i32 method = tree.interfaces[iface].methods[m]
                    string methodName = tree.functions[method].name
                    if (tree.records[r].methods.contains(methodName)) {
                        required.add(method)
                        given.add(tree.records[r].methods[methodName])
                    }
                }
            }
        }

        bool changed = true
        for (changed) {
            changed = false
            for (i32 function in throwing) {
                if (tree.functions[function].canThrow) {
                    continue
                }
                for (i64 c = 0; c < throwInfo[function].calls.len(); c++) {
                    if (tree.functions[throwInfo[function].calls[c]].canThrow) {
                        tree.functions[function].canThrow = true
                        changed = true
                        break
                    }
                }
            }
            for (i64 i = 0; i < required.len(); i++) {
                if (tree.functions[given[i]].canThrow != tree.functions[required[i]].canThrow) {
                    tree.functions[given[i]].canThrow = true
                    tree.functions[required[i]].canThrow = true
                    changed = true
                }
            }
        }
        for (i64 i = 0; i < escapes.len(); i++) {
            if (escapes[i].callee < 0 || tree.functions[escapes[i].callee].canThrow) {
                Loc loc = escapes[i].loc
                string message = escapes[i].message
                error(loc, message)
            }
        }
        // A function value is called as if it could throw: every lambda takes the slot (D186).
        for (i64 i = 0; i < tree.lambdas.len(); i++) {
            tree.functions[tree.exprs[tree.lambdas[i]].function].canThrow = true
        }
        for (i64 i = 0; i < tree.topFunctions.len(); i++) {
            i32 function = tree.topFunctions[i]
            if (tree.functions[function].isExported && tree.functions[function].canThrow) {
                error(functionLoc(function), "the exported function '" + tree.functions[function].name +
                    "' can throw, and C has no exceptions: catch them inside it")
            }
        }
    }

    // The body of a loop, with the list it goes over lent to it (D101).
    void checkLoopBody(i32 statement, i32 lent) {
        Path path
        if (lent >= 0) {
            path = pathOf(lent)
        }
        if (path.valid) {
            LoopBorrow borrow
            borrow.path = path
            borrow.reason = "while a 'for' goes over the elements of '" + placeText(lent) + "'"
            loopBorrows.add(move borrow)
        }
        loops.add(false)
        checkBlock(tree.stmts[statement].body)
        loops.remove(loops.len() - 1)
        if (path.valid) {
            loopBorrows.remove(loopBorrows.len() - 1)
        }
        locals.remove(locals.len() - 1)
    }

    // `for ([ref] T x in v)` (D25, D101).
    Flow checkForEach(i32 statement) {
        map<string, i32> scope
        locals.add(move scope)
        i32 items = tree.stmts[statement].value
        i32 node = tree.stmts[statement].type
        bool isRef = tree.stmts[statement].isRef
        string elementName = tree.stmts[statement].name
        Loc elementLoc = at(curFile, tree.stmts[statement].nameLine, tree.stmts[statement].nameColumn)
        Loc valueLoc = at(curFile, tree.stmts[statement].valueLine, tree.stmts[statement].valueColumn)
        i32 type = checkExpr(items, -1)
        i32 element = resolveOrError(node, curFile)
        bool ok = !types.isError(type) && !types.isError(element)
        if (ok && isMap(type)) {
            ret checkForMap(statement, type, element)
        }
        if (ok && isChannel(type)) {
            locals.remove(locals.len() - 1)
            ret checkForChannel(statement, type, element)
        }
        if (ok && tree.stmts[statement].hasValue) {
            error(valueLoc, "only a 'for' over a map has a key and a value")
            ok = false
        }
        if (ok && !isList(type) && !types.isArray(type)) {
            error(locOf(items), "'for' goes over the elements of a list or of an array, found " + name(type) + "")
            ok = false
        } else if (ok && element != elementOf(type)) {
            error(typeLoc(node, curFile), "the elements of this " + (types.isArray(type) ? "array" : "list") + " are " +
                name(elementOf(type)) + ": write for (" + (isRef ? "ref " : "") + name(elementOf(type)) + " " + elementName + " in ...)")
            ok = false
        }
        if (ok && isRef) {
            string reason = isPlace(items) ? readOnlyReason(items) : "only the elements of a variable or of a field can be modified"
            if (reason.len() > 0) {
                error(locOf(items), "cannot modify the elements: " + reason)
                ok = false
            } else if (!checkNotBorrowed(items, locOf(items))) {
                ok = false
            }
        }
        i32 variable = declare(elementName, ok ? element : errorType(), elementLoc, !isRef)
        if (variable >= 0) {
            tree.variables[variable].kind = VariableKind.Element
        }
        tree.stmts[statement].variable = variable
        checkLoopBody(statement, items)
        ret Flow.Continues
    }

    // The type of the elements of a list or of an array.
    i32 elementOf(i32 type) const {
        ret types.isArray(type) ? types.element(type) : tree.records[types.decl(type)].typeArgs[0]
    }

    // `for (K k, [ref] V v in m)` (D197): the keys are read-only, the map cannot
    // change while the loop goes over it (D101).
    Flow checkForMap(i32 statement, i32 mapType, i32 key) {
        i32 keyType = tree.records[types.decl(mapType)].typeArgs[0]
        i32 valueType = tree.records[types.decl(mapType)].typeArgs[1]
        i32 items = tree.stmts[statement].value
        string elementName = tree.stmts[statement].name
        string valueName = tree.stmts[statement].valueName
        bool hasValue = tree.stmts[statement].hasValue
        bool valueIsRef = tree.stmts[statement].valueIsRef
        Loc elementLoc = at(curFile, tree.stmts[statement].nameLine, tree.stmts[statement].nameColumn)
        bool ok = true
        i32 value = errorType()
        if (!hasValue) {
            error(elementLoc, "a 'for' over a map names the key and the value: for (" + name(keyType) + " " + elementName + ", " +
                name(valueType) + " v in ...)")
            ok = false
        } else {
            value = resolveOrError(tree.stmts[statement].valueType, curFile)
            ok = !types.isError(value)
        }
        if (ok && tree.stmts[statement].isRef) {
            error(elementLoc, "the keys of a map are read-only: only the value can be 'ref'")
            ok = false
        }
        if (ok && (key != keyType || value != valueType)) {
            error(typeLoc(tree.stmts[statement].type, curFile), "the keys of this map are " + name(keyType) + " and the values " +
                name(valueType) + ": write for (" + name(keyType) + " " + elementName + ", " + (valueIsRef ? "ref " : "") +
                name(valueType) + " " + valueName + " in ...)")
            ok = false
        }
        if (ok && valueIsRef) {
            string reason = isPlace(items) ? readOnlyReason(items) : "only the values of a variable or of a field can be modified"
            if (reason.len() > 0) {
                error(locOf(items), "cannot modify the values: " + reason)
                ok = false
            } else if (!checkNotBorrowed(items, locOf(items))) {
                ok = false
            }
        }
        i32 variable = declare(elementName, ok ? keyType : errorType(), elementLoc, true)
        if (variable >= 0) {
            tree.variables[variable].kind = VariableKind.Element
        }
        tree.stmts[statement].variable = variable
        if (hasValue) {
            i32 second = declare(valueName, ok ? valueType : errorType(), at(curFile, tree.stmts[statement].valueLine,
                tree.stmts[statement].valueColumn), !valueIsRef)
            if (second >= 0) {
                tree.variables[second].kind = VariableKind.Element
            }
            tree.stmts[statement].valueVariable = second
        }
        checkLoopBody(statement, items)
        ret Flow.Continues
    }

    // `for (T v in channel)` (D327): the values received until the channel is
    // closed and empty, each owned by the body. It becomes
    //     for { T v; if (!channel.next(ref v)) { break } ... }
    // with the channel read again at each turn: it is a variable or a field.
    Flow checkForChannel(i32 statement, i32 channel, i32 element) {
        i32 valueType = tree.records[types.decl(channel)].typeArgs[0]
        i32 items = tree.stmts[statement].value
        i32 node = tree.stmts[statement].type
        string elementName = tree.stmts[statement].name
        i32 line = tree.stmts[statement].line
        i32 column = tree.stmts[statement].column
        i32 nameLine = tree.stmts[statement].nameLine
        i32 nameColumn = tree.stmts[statement].nameColumn
        Loc elementLoc = at(curFile, nameLine, nameColumn)
        bool ok = false
        if (tree.stmts[statement].hasValue) {
            error(at(curFile, tree.stmts[statement].valueLine, tree.stmts[statement].valueColumn),
                "only a 'for' over a map has a key and a value")
        } else if (tree.stmts[statement].isRef) {
            error(elementLoc, "the values of a channel belong to the loop that receives them: write for (" + name(valueType) + " " +
                elementName + " in ...)")
        } else if (element != valueType) {
            error(typeLoc(node, curFile), "the values of this channel are " + name(valueType) + ": write for (" + name(valueType) +
                " " + elementName + " in ...)")
        } else if (!isPlace(items)) {
            error(locOf(items), "a 'for' receives from a channel in a variable or in a field")
        } else {
            ok = true
        }
        if (!ok) {  // the body is checked all the same
            map<string, i32> scope
            locals.add(move scope)
            tree.stmts[statement].variable = declare(elementName, errorType(), elementLoc, false)
            checkLoopBody(statement, -1)
            ret Flow.Continues
        }

        Stmt value
        value.kind = StmtKind.VarDecl
        value.line = nameLine
        value.column = nameColumn
        value.type = node
        value.name = elementName
        value.nameLine = nameLine
        value.nameColumn = nameColumn
        tree.stmts.add(move value)
        i32 valueStmt = i32(tree.stmts.len() - 1)
        Expr written = nodeAt(ExprKind.Name, nameLine, nameColumn)
        written.text = elementName
        tree.exprs.add(move written)
        Expr reference = nodeAt(ExprKind.Ref, nameLine, nameColumn)
        reference.left = i32(tree.exprs.len() - 1)
        tree.exprs.add(move reference)
        Expr next = nodeAt(ExprKind.MethodCall, tree.exprs[items].line, tree.exprs[items].column)
        next.left = items
        next.text = "next"
        next.items.add(i32(tree.exprs.len() - 1))
        tree.exprs.add(move next)
        Expr condition = nodeAt(ExprKind.Unary, line, column)
        condition.unary = UnaryOp.Not
        condition.left = i32(tree.exprs.len() - 1)
        tree.exprs.add(move condition)
        Stmt leave
        leave.kind = StmtKind.Break
        leave.line = line
        leave.column = column
        tree.stmts.add(move leave)
        Block then
        then.openLine = line
        then.openColumn = column
        then.closeLine = line
        then.closeColumn = column
        then.statements.add(i32(tree.stmts.len() - 1))
        tree.blocks.add(move then)
        Stmt stop
        stop.kind = StmtKind.If
        stop.line = line
        stop.column = column
        stop.value = i32(tree.exprs.len() - 1)
        stop.body = i32(tree.blocks.len() - 1)
        tree.stmts.add(move stop)
        list<i32> statements
        statements.add(valueStmt)
        statements.add(i32(tree.stmts.len() - 1))
        i32 body = tree.stmts[statement].body
        for (i32 inner in tree.blocks[body].statements) {
            statements.add(inner)
        }
        tree.blocks[body].statements = move statements
        tree.stmts[statement].form = ForForm.Infinite
        tree.stmts[statement].value = -1
        ret checkFor(statement)
    }

    Flow checkFor(i32 statement) {
        ForForm form = tree.stmts[statement].form
        if (form == ForForm.Each) {
            ret checkForEach(statement)
        }
        map<string, i32> scope
        locals.add(move scope)  // the variable of the classic form lives only in the loop
        i32 init = tree.stmts[statement].init
        if (init >= 0 && tree.stmts[init].kind == StmtKind.VarDecl && tree.stmts[init].isRef) {
            error(stmtLoc(init), "a reference is declared in a block, not in the head of a 'for'")
            tree.stmts[init].isRef = false
            tree.stmts[init].isConst = false
            tree.stmts[init].value = -1
        }
        if (init >= 0) {
            checkStatement(init)
        }
        bool hasCondition = tree.stmts[statement].value >= 0
        if (hasCondition) {
            checkCondition(tree.stmts[statement].value)
        }
        if (tree.stmts[statement].step >= 0) {
            checkStatement(tree.stmts[statement].step)
        }
        loops.add(false)
        checkBlock(tree.stmts[statement].body)
        bool hasBreak = loops[loops.len() - 1]
        loops.remove(loops.len() - 1)
        locals.remove(locals.len() - 1)

        // An endless loop without break never falls through (D67).
        bool endless = form == ForForm.Infinite || (form == ForForm.Classic && !hasCondition)
        ret endless && !hasBreak ? Flow.Returns : Flow.Continues
    }

    void checkReturn(i32 statement) {
        if (finallyLoops.len() > 0) {
            error(stmtLoc(statement), "'ret' cannot leave a 'finally' block")
        }
        i32 type = tree.functions[current].resolvedReturn
        i32 value = tree.stmts[statement].value
        if (types.isError(type)) {
            ret
        }
        if (types.isVoid(type)) {
            if (value >= 0) {
                error(locOf(value), "function '" + tree.functions[current].name + "' is void and does not return a value")
            }
            ret
        }
        if (value < 0) {
            error(stmtLoc(statement), "missing value after 'ret': function '" + tree.functions[current].name + "' returns " + name(type))
            ret
        }
        if (!coerceValue(value, type)) {
            ret
        }

        // D23: `ret` of a local variable moves it without writing `move`.
        i32 variable = tree.exprs[value].kind == ExprKind.Name ? tree.exprs[value].variable : -1
        if (variable >= 0 && !checkNotBlockThread(variable, locOf(value))) {
            ret
        }
        if (variable >= 0 && (tree.variables[variable].kind == VariableKind.Local || tree.variables[variable].kind ==
            VariableKind.MoveParam)) {
            ret
        }
        copyIfNeeded(value, type)
    }

    // ---- Expressions ----

    // Checks `expr` and makes it of type `target`, adding a lossless conversion if needed (D33).
    // `borrow`: for a read parameter, a struct becomes an interface where it is.
    bool coerce(i32 expr, i32 target, bool borrow) {
        i32 type = checkExpr(expr, target)
        if (types.isError(type) || types.isError(target)) {
            ret false
        }
        if (type == target) {
            ret true
        }
        if (types.isInterface(target)) {
            i32 iface = types.decl(target)
            if (satisfies(type, iface)) {
                useMethodsFor(type, iface, locOf(expr))
                if (borrow) {
                    ret true  // passed with its method table (D49)
                }
                // D357: a new value of the interface, with the struct on the heap, copied
                // or moved as into a variable of its own type.
                if (!copyIfNeeded(expr, type)) {
                    ret false
                }
                wrap(expr, ExprKind.Conversion, target)
                ret true
            }
            error(locOf(expr), name(type) + " does not implement " + name(target) + "")
            ret false
        }
        if (types.isVoid(type)) {
            error(locOf(expr), "this call does not return a value")
            ret false
        }
        if (types.isUntyped(type)) {
            error(locOf(expr), "this " + name(type) + " cannot be used as " + name(target))
            ret false
        }
        if (types.convertsLosslessly(type, target)) {
            wrap(expr, ExprKind.Conversion, target)
            ret true
        }
        if (types.isStruct(type) || types.isStruct(target)) {
            error(locOf(expr), "a value of type " + name(type) + " cannot be used as " + name(target))
        } else if (types.isBool(target) && types.isNumeric(type)) {  // a number is not converted to bool (D61)
            error(locOf(expr), "a value of type " + name(type) + " cannot be used as bool: compare it, as x != 0")
        } else if (types.isBool(type) && types.isNumeric(target)) {
            error(locOf(expr), "a bool cannot be used as " + name(target) + ": choose the number, as b ? 1 : 0")
        } else {
            error(locOf(expr), "a value of type " + name(type) + " cannot be used as " + name(target) +
                " without an explicit conversion, for example " + name(target) + "(x)")
        }
        ret false
    }

    // The type of an expression, written on it; `expected` is the type around it, or -1.
    i32 checkExpr(i32 expr, i32 expected) {
        i32 type = computeType(expr, expected)
        tree.exprs[expr].resolved = type
        ret type
    }

    i32 computeType(i32 expr, i32 expected) {
        // Only the expression that coerceValue is checking may be a `move`.
        bool allowed = moveAllowed
        bool argument = lambdaArgument
        bool inserts = insertTarget
        bool forThread = threadLambda
        i32 group = groupLambda
        moveAllowed = false
        lambdaArgument = false
        insertTarget = false
        threadLambda = false
        groupLambda = -1
        switch (tree.exprs[expr].kind) {
            case Lambda {
                tree.exprs[expr].forThread = forThread || group >= 0
                tree.exprs[expr].group = group
                ret checkLambda(expr, argument || forThread || group >= 0)
            }
            case CallValue {
                ret checkCallValue(expr)
            }
            case ListLiteral {
                ret checkListLiteral(expr, expected)
            }
            case IntLiteral {
                ret checkIntLiteral(expr, expected)
            }
            case FloatLiteral {
                ret expected >= 0 && types.isFloat(expected) ? expected : untypedFloat()
            }
            case BoolLiteral {
                ret boolType()
            }
            case StringLiteral {
                if (stringDecl >= 0) {
                    ret types.structType(stringDecl)  // D100
                }
                error(locOf(expr), "the standard library has no string")
                ret errorType()
            }
            case Index {
                ret checkIndex(expr, inserts)
            }
            case Name {
                ret checkName(expr)
            }
            case Unary {
                ret checkUnary(expr, expected)
            }
            case Binary {
                ret checkBinary(expr, expected)
            }
            case Conditional {
                ret checkConditional(expr, expected)
            }
            case Call {
                ret checkCall(expr, expected)
            }
            case Field {
                ret checkField(expr)
            }
            case MethodCall {
                ret checkMethodCall(expr)
            }
            case Self {
                ret types.structType(tree.functions[current].owner)
            }
            case Move {
                if (!allowed) {
                    error(locOf(expr), "'move' is written only in an initialization, an assignment, the argument of a 'move' " +
                        "parameter or after 'ret'")
                    ret errorType()
                }
                ret checkMove(expr)
            }
            case Ref {
                error(locOf(expr), "'ref' is written only in the argument of a 'ref' parameter")
                ret errorType()
            }
            case Conversion, Print, Construct, EnumCase, Copy {
                ret tree.exprs[expr].resolved
            }
            case TypeRef {
                error(locOf(expr), "a type is not a value")
                ret errorType()
            }
        }
    }

    i32 checkIntLiteral(i32 literal, i32 expected) {
        if (tree.exprs[literal].flag) {
            ret intType(8, false)  // D46
        }
        if (expected >= 0 && types.isInt(expected)) {
            u64 magnitude = tree.exprs[literal].value
            bool negative = tree.exprs[literal].negative
            if (!fits(magnitude, negative, expected)) {
                error(locOf(literal), format("value {}{} is out of range for {} ({})", negative && magnitude != 0 ? "-" : "", magnitude,
                    name(expected), rangeOf(expected)))
                ret errorType()
            }
            ret expected
        }
        if (expected >= 0 && types.isFloat(expected)) {
            ret expected  // D55: an integer literal fits a float type too
        }
        ret untypedInt()
    }

    // A local variable or parameter; inside a method also a field (D70).
    i32 checkName(i32 expr) {
        string written = tree.exprs[expr].text
        Loc loc = locOf(expr)
        i32 variable = lookup(written)
        if (variable >= 0) {
            tree.exprs[expr].variable = variable
            checkNotUsedByThread(variable, loc)
            ret tree.variables[variable].type
        }
        if (ownFieldIndex(written) >= 0) {
            Expr object = nodeAt(ExprKind.Self, loc.line, loc.column)
            tree.exprs.add(move object)
            Expr field = nodeAt(ExprKind.Field, loc.line, loc.column)
            field.left = i32(tree.exprs.len() - 1)
            field.text = written
            tree.exprs[expr] = move field
            ret checkField(expr)
        }
        i32 global = findConstant(written, loc, "")
        if (global >= 0) {  // D394, D564
            tree.exprs[expr].variable = global
            ret tree.variables[global].type
        }
        i32 owner = tree.functions[current].owner
        if (findDecl(functionsTable, written, loc, "") >= 0 || isPrintFunction(written) || (owner >= 0 &&
            tree.records[owner].methods.contains(written))) {
            error(loc, "'" + written + "' is a function: call it with '()'")
        } else if (importsQualifier(loc.file, written)) {
            error(loc, "'" + written + "' is a module: write " + written + ".name")
        } else if (hiddenByLambda(written)) {
            error(loc, "'" + written + "' is not captured: write it between the [] of the lambda")
        } else if (readsOtherField(written)) {
            error(loc, "the initial value of a field cannot read the field '" + written + "'")
        } else {
            error(loc, "unknown name '" + written + "'")
        }
        ret errorType()
    }

    // In the default function of a struct (D360): a name that is one of its fields.
    bool readsOtherField(string name) const {
        for (i64 i = 0; i < defaultFields.len(); i++) {
            if (defaultFields[i].function != current) {
                continue
            }
            i32 decl = types.decl(tree.functions[current].paramTypes[0])
            for (i64 f = 0; f < tree.records[decl].fields.len(); f++) {
                if (tree.records[decl].fields[f].name == name) {
                    ret true
                }
            }
        }
        ret false
    }

    // A variable of the functions around a lambda, which its body sees only if captured.
    bool hiddenByLambda(string name) const {
        for (i64 i = 0; i < hiddenScopes.len(); i++) {
            for (i64 k = 0; k < hiddenScopes[i].len(); k++) {
                if (hiddenScopes[i][k].contains(name)) {
                    ret true
                }
            }
        }
        ret false
    }

    // `Shape` in `Shape.Circle(1.0)`: an enum named as a type, not a variable (D105).
    // -1 if the expression is not that; the error type after an error.
    i32 enumNamed(i32 object) {
        Loc loc = locOf(object)
        ExprKind kind = tree.exprs[object].kind
        if (kind == ExprKind.TypeRef) {
            i32 type = resolveType(tree.exprs[object].type, curFile)
            if (type < 0) {
                ret errorType()
            }
            if (!types.isStruct(type) || !tree.records[types.decl(type)].isEnum) {
                error(loc, name(type) + " is not an enum: only the values of an enum are created with '.'")
                ret errorType()
            }
            ret type
        }
        string written
        string module
        if (kind == ExprKind.Field) {  // `geometry.Shape` (D126)
            i32 inner = tree.exprs[object].left
            if (tree.exprs[inner].kind != ExprKind.Name) {
                ret -1
            }
            module = tree.exprs[inner].text
            if (lookup(module) >= 0 || ownFieldIndex(module) >= 0 || !importsQualifier(curFile, module)) {
                ret -1
            }
            written = tree.exprs[object].text
        } else if (kind == ExprKind.Name) {
            written = tree.exprs[object].text
            if (lookup(written) >= 0 || ownFieldIndex(written) >= 0) {
                ret -1
            }
            // `T.Red` in the reading of an enum generated for JSON (D251)
            for (i64 b = 0; b < bindings.len(); b++) {
                if (bindings[b].name == written && types.isStruct(bindings[b].type) &&
                    tree.records[types.decl(bindings[b].type)].isEnum) {
                    ret bindings[b].type
                }
            }
        } else {
            ret -1
        }
        i32 found = findDecl(structsTable, written, loc, module)
        if (found < 0 || !tree.records[found].isEnum) {
            ret -1
        }
        if (tree.records[found].typeParams.len() > 0) {
            error(loc, written + " is generic: write its type arguments, " + written + "<...>.Case")
            ret errorType()
        }
        ret types.structType(found)
    }

    // The data of a case as the parameters of a function, all `move` (D124).
    i32 caseSignature(i32 decl, i32 index) {
        string key = format("{}:{}", decl, index)
        if (caseSignatures.contains(key)) {
            ret caseSignatures[key]
        }
        Function signature
        signature.file = tree.records[decl].file
        signature.name = tree.records[decl].cases[index].name
        for (i64 f = 0; f < tree.records[decl].cases[index].fields.len(); f++) {
            Param param
            param.mode = ParamMode.Move
            param.name = tree.records[decl].cases[index].fields[f].name
            param.line = tree.records[decl].cases[index].fields[f].line
            param.column = tree.records[decl].cases[index].fields[f].column
            signature.params.add(move param)
            signature.paramTypes.add(tree.records[decl].cases[index].fields[f].resolved)
        }
        tree.functions.add(move signature)
        i32 result = i32(tree.functions.len() - 1)
        caseSignatures[key] = result
        ret result
    }

    // `Shape.Circle(1.0)` and `Color.Red` (D105), which take the place of `expr`.
    // The data are given like `move` parameters (D124).
    i32 checkEnumCase(i32 expr, i32 type, string caseName, bool hasArgs, list<i32> args) {
        Loc loc = locOf(expr)
        if (types.isError(type)) {
            if (hasArgs) {
                checkIgnored(args)
            }
            ret errorType()
        }
        i32 decl = types.decl(type)
        string declName = tree.records[decl].name
        i32 index = -1
        for (i64 i = 0; i < tree.records[decl].cases.len(); i++) {
            if (tree.records[decl].cases[i].name == caseName) {
                index = i32(i)
            }
        }
        if (index < 0) {
            error(loc, declName + " has no case '" + caseName + "'")
            if (hasArgs) {
                checkIgnored(args)
            }
            ret errorType()
        }
        string what = "'" + declName + "." + caseName + "'"
        if (!hasArgs && tree.records[decl].cases[index].fields.len() > 0) {
            error(loc, what + " has data: write " + declName + "." + caseName + "(...)")
            ret errorType()
        }
        Expr node = nodeAt(ExprKind.EnumCase, loc.line, loc.column)
        node.decl = decl
        node.index = index
        node.items = args
        tree.exprs[expr] = move node
        if (!checkArgs(args, caseSignature(decl, index), what, loc, expr, -1, errorType())) {
            ret errorType()
        }
        ret type
    }

    // D50, D132: a member is visible in its own module, or everywhere when it is public.
    bool visible(bool isPublic, i32 owner, i32 file) const {
        ret isPublic || scopeOf(tree, tree.records[owner].file) == scopeOf(tree, file)
    }

    i32 checkField(i32 expr) {
        i32 inner = tree.exprs[expr].left
        string fieldName = tree.exprs[expr].text
        Loc loc = locOf(expr)
        i32 named = enumNamed(inner)
        if (named >= 0) {
            list<i32> none
            ret checkEnumCase(expr, named, fieldName, false, none)
        }
        if (tree.exprs[inner].kind == ExprKind.Name) {  // `geometry.limit`: a public constant of a module (D564)
            string module = tree.exprs[inner].text
            if (lookup(module) < 0 && ownFieldIndex(module) < 0 && importsQualifier(curFile, module)) {
                i32 constant = findConstant(fieldName, loc, module)
                if (constant < 0) {
                    error(loc, "the module " + module + " has no public constant '" + fieldName + "'")
                    ret errorType()
                }
                Expr written = nodeAt(ExprKind.Name, loc.line, loc.column)
                written.text = fieldName
                written.variable = constant
                tree.exprs[expr] = move written
                ret tree.variables[constant].type
            }
        }
        i32 object = checkExpr(inner, -1)
        if (types.isError(object)) {
            ret object
        }
        if (!types.isStruct(object)) {
            error(loc, withArticle(name(object)) + " has no fields")
            ret errorType()
        }
        i32 decl = types.decl(object)
        for (i64 i = 0; i < tree.records[decl].fields.len(); i++) {
            if (tree.records[decl].fields[i].name == fieldName) {
                if (!visible(tree.records[decl].fields[i].isPublic, decl, curFile) && !tree.functions[current].convertsJson) {
                    reportPrivate(loc, "field '" + fieldName + "' of " + name(object))
                    ret errorType()
                }
                tree.exprs[expr].index = i32(i)
                ret tree.records[decl].fields[i].resolved
            }
        }
        error(loc, name(object) + " has no field named '" + fieldName + "'")
        ret errorType()
    }

    // callC<R>(address, arguments...) (D552): a C function called through its address.
    // The result is a type of C or void; an argument is a value of a type of C, or
    // `ref` and a variable, whose address the function takes, as the `ref` parameters
    // of the extern functions (D128).
    i32 checkCallC(i32 call) {
        Loc loc = locOf(call)
        list<i32> typeArgs = tree.exprs[call].typeArgs
        list<i32> args = tree.exprs[call].items
        i32 result = errorType()
        if (typeArgs.len() != 1) {
            error(loc, "'callC' takes 1 type argument, the type of its result: callC<i32>(address, ...)")
        } else {
            i32 type = resolveType(typeArgs[0], curFile)
            if (type >= 0) {
                if (types.isVoid(type) || isCType(type)) {
                    result = type
                } else {
                    error(typeLoc(typeArgs[0], curFile), "the result of a C function is a number, a bool, an addr or void, found " +
                        name(type))
                }
            }
        }
        bool ok = !types.isError(result)
        if (args.len() == 0) {
            error(loc, "'callC' takes the address of the function, then its arguments")
            ret errorType()
        }
        for (i64 i = 0; i < args.len(); i++) {
            i32 arg = args[i]
            if (tree.exprs[arg].kind == ExprKind.Ref && i > 0) {
                i32 operand = tree.exprs[arg].left
                i32 found = checkExpr(operand, -1)
                string reason = types.isError(found) || !isPlace(operand) ? "" : readOnlyReason(operand)
                if (types.isError(found)) {
                    ok = false
                } else if (!isPlace(operand)) {
                    error(locOf(arg), "only a variable or a field can be passed with 'ref'")
                    ok = false
                } else if (reason.len() > 0) {
                    error(locOf(arg), "cannot pass '" + placeText(operand) + "' with 'ref': " + reason)
                    ok = false
                } else if (!isCPointee(found)) {
                    error(locOf(arg), "'ref' to a C function is a pointer to a number or to a struct of numbers, not " + name(found))
                    ok = false
                } else {
                    tree.exprs[arg].resolved = found
                }
                continue
            }
            i32 type = checkExpr(arg, -1)
            if (types.isError(type)) {
                ok = false
            } else if (i == 0 && type != addrType()) {
                error(locOf(arg), "the first argument of 'callC' is the address of the function, an addr, found " + name(type))
                ok = false
            } else if (!isCType(type)) {
                error(locOf(arg), "an argument of a C function is a number, a bool, an addr, or 'ref' and a variable, found " +
                    name(type))
                ok = false
            }
        }
        tree.exprs[call].typeArg = result
        ret ok ? result : errorType()
    }

    // Checks one argument against the mode of its parameter (D22).
    bool checkArg(i32 arg, ParamMode mode, string paramName, i32 type) {
        string what = "parameter '" + paramName + "'"
        ExprKind kind = tree.exprs[arg].kind
        if (mode == ParamMode.Read) {
            if (kind == ExprKind.Ref || kind == ExprKind.Move) {
                error(locOf(arg), what + " is read-only: remove '" + (kind == ExprKind.Ref ? "ref" : "move") + "'")
                ret false
            }
            lambdaArgument = kind == ExprKind.Lambda  // it may capture by address (D184)
            ret coerce(arg, type, true)
        }
        if (mode == ParamMode.Ref) {
            if (kind != ExprKind.Ref) {
                error(locOf(arg), what + " is 'ref': write 'ref' before the argument")
                ret false
            }
            i32 operand = tree.exprs[arg].left
            i32 found = checkExpr(operand, -1)
            if (types.isError(found)) {
                ret false
            }
            if (tree.exprs[operand].kind == ExprKind.Name && !checkNotBlockThread(tree.exprs[operand].variable, locOf(arg))) {
                ret false
            }
            if (!isPlace(operand)) {
                error(locOf(arg), "only a variable or a field can be passed with 'ref'")
                ret false
            }
            string reason = readOnlyReason(operand)
            if (reason.len() > 0) {
                error(locOf(arg), "cannot pass '" + placeText(operand) + "' with 'ref': " + reason)
                ret false
            }
            if (found != type && !(types.isInterface(type) && satisfies(found, types.decl(type)))) {
                error(locOf(arg), what + " is 'ref " + name(type) + "': the argument must have exactly that type, found " + name(found) +
                    "")
                ret false
            }
            tree.exprs[arg].resolved = found
            ret true
        }
        if (kind == ExprKind.Ref) {
            error(locOf(arg), what + " is 'move', not 'ref'")
            ret false
        }
        if (!coerceValue(arg, type)) {
            ret false
        }
        // A variable or a field without `move` gives a copy (D424); a value of an
        // interface was already copied when it was made (D357).
        if (tree.exprs[arg].kind == ExprKind.Conversion) {
            ret true
        }
        ret copyIfNeeded(arg, type)
    }

    // Checks the arguments of a call against the parameters of `function`, then
    // exclusivity (D22, D79). `object` is the object of a method call, or -1;
    // `holder` the node that keeps the pairs to compare when the program runs.
    bool checkArgs(list<i32> given, i32 function, string what, Loc loc, i32 holder, i32 object, i32 self) {
        i64 expected = tree.functions[function].params.len()
        list<i32> args = given
        // D577: after the other arguments, a literal is a format, with its arguments:
        // they become one argument, `format("...", a, b)`.
        if (tree.functions[function].isFormat && args.len() >= expected) {
            i32 text = args[expected - 1]
            if (tree.exprs[text].kind == ExprKind.StringLiteral) {
                Expr call = nodeAt(ExprKind.Call, tree.exprs[text].line, tree.exprs[text].column)
                call.text = "format"
                for (i64 i = expected - 1; i < args.len(); i++) {
                    call.items.add(args[i])
                }
                tree.exprs.add(move call)
                for (args.len() >= expected) {
                    args.remove(args.len() - 1)
                }
                args.add(i32(tree.exprs.len() - 1))
                tree.exprs[holder].items = args
            } else if (args.len() > expected) {
                error(locOf(text), "the text of " + what + " must be a string literal with the format, when arguments follow it")
                ret false
            }
        }
        if (args.len() != expected) {
            error(loc, format("{} takes {}{}{} were given", what, expected, expected == 1 ? " argument, but " : " arguments, but ",
                args.len()))
            ret false
        }
        bool ok = true
        for (i64 i = 0; i < args.len(); i++) {
            i32 type = tree.functions[function].paramTypes[i]
            if (types.isError(type)) {
                continue
            }
            ParamMode mode = tree.functions[function].params[i].mode
            bool isConst = tree.functions[function].params[i].isConst
            string paramName = tree.functions[function].params[i].name
            ok = checkArg(args[i], mode, paramName, withSelf(type, self)) && ok
            if (mode == ParamMode.Read && isConst) {
                checkConstFunction(args[i])
            }
        }
        ret ok && checkExclusivity(args, function, object, holder)
    }

    // D22, D79: what a call modifies cannot overlap anything else the call uses.
    // A read argument of a simple type is passed as a copy instead.
    bool checkExclusivity(list<i32> args, i32 function, i32 object, i32 holder) {
        bool isConst = tree.functions[function].isConst
        list<Access> accesses
        if (object >= 0) {
            Path path = pathOf(object)
            if (path.valid) {
                accesses.add(access(path, object, !isConst, -1))
            }
            if (!isConst && !checkNotBorrowed(object, locOf(object))) {
                ret false
            }
        }
        for (i64 i = 0; i < args.len(); i++) {
            i32 arg = args[i]
            bool modifies = false
            if (tree.exprs[arg].kind == ExprKind.Lambda) {
                // What a lambda captures by address, the call uses as an argument (D184).
                for (i64 c = 0; c < tree.exprs[arg].capturePlaces.len(); c++) {
                    i32 place = tree.exprs[arg].capturePlaces[c]
                    Path path = pathOf(place)
                    if (path.valid) {
                        accesses.add(access(path, place, capturedWithRef(arg, place), -2))
                    }
                }
                continue
            }
            if (tree.exprs[arg].kind == ExprKind.Ref) {
                arg = tree.exprs[arg].left
                modifies = true
                if (!checkNotBorrowed(arg, locOf(arg))) {
                    ret false
                }
            } else if (tree.exprs[arg].kind == ExprKind.Move) {
                // Only a whole variable is handed over in place; the other moves make a new value.
                if (tree.exprs[arg].moveKind != MoveKind.Variable) {
                    continue
                }
                arg = tree.exprs[arg].left
                modifies = true
            }
            Path path = pathOf(arg)
            if (path.valid) {
                accesses.add(access(path, arg, modifies, i32(i)))
            }
        }

        bool ok = true
        list<bool> copied
        for (i64 i = 0; i < args.len(); i++) {
            copied.add(false)
        }
        for (i64 a = 0; a < accesses.len(); a++) {
            for (i64 b = a + 1; b < accesses.len(); b++) {
                bool firstModifies = accesses[a].modifies
                if (!(firstModifies || accesses[b].modifies)) {
                    continue
                }
                i32 overlap = overlaps(accesses[a].path, accesses[b].path)
                if (overlap == overlapNo) {
                    continue
                }
                i64 read = firstModifies ? b : a
                i32 readExpr = accesses[read].expr
                i32 readType = tree.exprs[readExpr].resolved
                // D79, D563: a read argument is passed as a copy, with its copy() when it owns resources.
                if (!accesses[read].modifies && accesses[read].arg >= 0 && (!needsDestruction(tree, types, readType) ||
                    canCopy(readType))) {
                    copied[accesses[read].arg] = true
                    continue
                }
                if (overlap == overlapMaybe && holder >= 0) {
                    OverlapCheck check
                    check.first = accesses[a].arg
                    check.second = accesses[b].arg
                    tree.exprs[holder].overlaps.add(move check)  // compared at runtime (D35)
                    continue
                }
                string message = "'" + placeText(accesses[b].expr) + "' overlaps '" + placeText(accesses[a].expr) + "' in the same call, "
                if (accesses[a].arg == -2 || accesses[b].arg == -2) {
                    message += "which a lambda of the call captures"
                } else if (accesses[read].modifies) {
                    message += "and the call can modify both"
                } else if (accesses[read].arg < 0) {
                    message += "which is the object of the method"
                } else {
                    message += "which the call can modify, and values of type " + name(readType) + " cannot be copied"
                }
                error(locOf(accesses[b].expr), message)
                ok = false
            }
        }
        for (i64 i = 0; i < args.len(); i++) {
            if (!copied[i]) {
                continue
            }
            i32 type = tree.exprs[args[i]].resolved
            if (needsDestruction(tree, types, type)) {  // D563
                ok = copyIfNeeded(args[i], type) && ok
            } else {
                wrap(args[i], ExprKind.Copy, type)
            }
        }
        ret ok
    }

    Access access(Path path, i32 expr, bool modifies, i32 arg) const {
        Access result
        result.path = path
        result.expr = expr
        result.modifies = modifies
        result.arg = arg
        ret result
    }

    // The call of a function made by the compiler, which takes the place of `expr`.
    void makeCall(i32 expr, string callee, Intrinsic intrinsic, list<i32> args) {
        Expr node = nodeAt(ExprKind.Call, tree.exprs[expr].line, tree.exprs[expr].column)
        node.text = callee
        node.intrinsic = intrinsic
        node.items = args
        tree.exprs[expr] = move node
    }

    // An integer literal of a type, which takes the place of `expr`.
    void makeInt(i32 expr, u64 value, i32 type) {
        Expr node = nodeAt(ExprKind.IntLiteral, tree.exprs[expr].line, tree.exprs[expr].column)
        node.value = value
        node.resolved = type
        tree.exprs[expr] = move node
    }

    i32 fieldIndex(i32 decl, string name) const {
        for (i64 i = 0; i < tree.records[decl].fields.len(); i++) {
            if (tree.records[decl].fields[i].name == name) {
                ret i32(i)
            }
        }
        ret -1
    }

    // D50, D132: the methods that implement an interface can be called through it
    // anyway, so they need no `public`.
    bool memberVisible(i32 member, i32 owner, i32 file) {
        if (visible(tree.functions[member].isPublic, owner, file) || tree.functions[member].isGenerated) {
            ret true
        }
        if (tree.functions[member].kind != FunctionKind.Method) {
            ret false
        }
        string memberName = tree.functions[member].name
        for (i32 iface in implementsOf(owner)) {
            for (i64 m = 0; m < tree.interfaces[iface].methods.len(); m++) {
                if (tree.functions[tree.interfaces[iface].methods[m]].name == memberName) {
                    ret true
                }
            }
        }
        ret false
    }

    i32 checkMethodCall(i32 expr) {
        i32 inner = tree.exprs[expr].left
        string method = tree.exprs[expr].text
        Loc loc = locOf(expr)
        list<i32> args = tree.exprs[expr].items
        list<i32> typeArgs = tree.exprs[expr].typeArgs
        bool named = tree.exprs[inner].kind == ExprKind.Name
        string innerName = named ? tree.exprs[inner].text : ""
        // `geometry.area(c)`: a function or a struct of an imported module (D126).
        if (named && lookup(innerName) < 0 && ownFieldIndex(innerName) < 0 && importsQualifier(curFile, innerName)) {
            Expr qualified = nodeAt(ExprKind.Call, loc.line, loc.column)
            qualified.text = method
            qualified.module = innerName
            qualified.items = args
            tree.exprs[expr] = move qualified
            ret checkCall(expr, -1)
        }
        i32 ofEnum = enumNamed(inner)
        if (ofEnum >= 0) {
            ret checkEnumCase(expr, ofEnum, method, true, args)
        }
        if (named && method == "load" && lookup(innerName) < 0) {
            i32 vector = types.findBuiltin(innerName)
            if (vector >= 0 && types.isVector(vector)) {
                ret checkVectorLoad(expr, vector)  // `i16x16.load(values, at)` (D505)
            }
        }
        if (named && method == "fromBits") {  // `f64.fromBits(b)` (D397)
            i32 number = types.findBuiltin(innerName)
            if (number >= 0 && types.isFloat(number)) {
                ret checkFromBits(expr, number)
            }
        }
        i32 object = checkExpr(inner, -1)
        if (types.isError(object)) {
            ret object
        }
        if (types.isFloat(object) && method == "bits") {
            ret checkBits(expr, object)
        }
        // `x.copy()` of a number or a bool is the value itself, so that generics can copy any T (D89).
        if (method == "copy" && (types.isNumeric(object) || types.isBool(object))) {
            if (args.len() > 0) {
                error(loc, "copy() takes no arguments")
                ret errorType()
            }
            Expr copy = nodeAt(ExprKind.Copy, loc.line, loc.column)
            copy.left = inner
            tree.exprs[expr] = move copy
            ret object
        }
        if (types.isParam(object) || types.isInterface(object)) {
            ret checkInterfaceCall(expr, object)
        }
        if (types.isArray(object)) {
            ret checkArrayMethod(expr, object)
        }
        if (types.isVector(object)) {
            ret checkVectorMethod(expr, object)
        }
        if ((types.isNumeric(object) || types.isBool(object)) && (method == "hash" || method == "equals")) {
            ret checkKeyMethod(expr, object)
        }
        if (types.isNumeric(object) && method == "compare") {
            ret checkKeyMethod(expr, object)  // D421
        }
        if (isString(object) && method == "cstring") {
            ret checkCString(expr)
        }
        if (!types.isStruct(object)) {
            string known = types.isNumeric(object) ? ": it has hash(), equals() and compare()" : types.isBool(object) ?
                ": it has hash() and equals()" : ""
            error(loc, withArticle(name(object)) + " has no method " + method + "()" + known)
            ret errorType()
        }
        i32 decl = types.decl(object)
        bool found = tree.records[decl].methods.contains(method)
        i32 field = found ? -1 : fieldIndex(decl, method)
        if (field >= 0 && types.isFunction(tree.records[decl].fields[field].resolved)) {
            // `handler.run(x)`: the call of a field that holds a function (D186).
            Expr callee = nodeAt(ExprKind.Field, loc.line, loc.column)
            callee.left = inner
            callee.text = method
            tree.exprs.add(move callee)
            Expr value = nodeAt(ExprKind.CallValue, loc.line, loc.column)
            value.left = i32(tree.exprs.len() - 1)
            value.items = args
            tree.exprs[expr] = move value
            ret checkCallValue(expr)
        }
        i32 target = -1
        if (found) {
            target = tree.records[decl].methods[method]
        } else if (method == "copy") {
            target = copyFunction(decl, loc)
            if (target < 0) {
                error(loc, name(object) + " cannot be copied: it has a destructor, or a field that cannot be copied, and it does " +
                    "not define copy()")
                ret errorType()
            }
        } else {
            error(loc, name(object) + " has no method named '" + method + "'")
            ret errorType()
        }
        if (!memberVisible(target, decl, curFile)) {
            reportPrivate(loc, "method '" + method + "' of " + name(object))
            ret errorType()
        }
        if ((method == "add" || method == "addRelaxed") && isThreadType(decl, "Atomic")) {  // D328, D503
            i32 held = tree.records[decl].typeArgs[0]
            if (!types.isInt(held) && !types.isParam(held)) {
                error(loc, method + "() is for an atomic integer, not for " + name(object))
                ret errorType()
            }
        }
        if (tree.functions[target].typeParams.len() > 0) {  // its instance, with the type arguments written or deduced (D92)
            list<i32> resolved
            bool ok = typeArgs.len() == 0 ? !failed.contains(format("f{}", target)) && deduceTypeArgs(target, args, loc, ref resolved) :
                resolveTypeArgs(typeArgs, curFile, tree.functions[target].typeParams.len(), "'" + method + "'", loc, ref resolved)
            i32 instance = ok ? instantiateMethod(target, resolved, loc) : -1
            if (instance < 0) {
                checkIgnored(args)
                ret errorType()
            }
            target = instance
        } else if (typeArgs.len() > 0) {
            error(loc, "'" + method + "' has no type parameters")
            ret errorType()
        }
        if (!tree.functions[target].isConst) {
            string reason = readOnlyReason(inner)
            if (reason.len() > 0) {
                error(loc, "cannot call '" + method + "', which is not const: " + reason)
                ret errorType()
            }
        }
        tree.exprs[expr].target = target
        use(target, loc)
        noteCall(target, loc)
        // `g.start([...]() { ... })` of a group: its tasks may read the block (D273).
        if (method == "start" && named && args.len() == 1 && tree.exprs[args[0]].kind == ExprKind.Lambda && isGroupStruct(decl)) {
            i32 group = tree.exprs[inner].variable
            if (group >= 0 && tree.variables[group].group) {
                groupLambda = group
            }
        }
        bool ok = checkArgs(args, target, "'" + method + "'", loc, expr, inner, errorType())
        groupLambda = -1
        ret ok ? tree.functions[target].resolvedReturn : errorType()
    }

    // `[a, b, c]` (D308): a new list, with the type of the elements expected or else
    // the one of the first; each element is given to it as to add(move T).
    i32 checkListLiteral(i32 expr, i32 expected) {
        Loc loc = locOf(expr)
        list<i32> elements = tree.exprs[expr].items
        if (listDecl < 0) {
            error(loc, "the standard library has no list")
            ret errorType()
        }
        i32 element = errorType()
        bool checkedFirst = false
        if (expected >= 0 && isList(expected)) {
            element = tree.records[types.decl(expected)].typeArgs[0]
        } else if (elements.len() > 0) {
            moveAllowed = tree.exprs[elements[0]].kind == ExprKind.Move
            element = checkExpr(elements[0], -1)
            if (types.isError(element)) {
                ret errorType()
            }
            if (types.isUntyped(element) || types.isVoid(element)) {
                error(locOf(elements[0]), "the type of the elements cannot be deduced: write the type of the list, as list<i64> " +
                    "values = [1, 2], or of the first element, as [i64(1), 2]")
                ret errorType()
            }
            checkedFirst = true
        } else {
            error(loc, "the type of an empty list cannot be deduced: write it, as list<i64> values = []")
            ret errorType()
        }
        list<i32> typeArgs
        typeArgs.add(element)
        i32 decl = instantiateStruct(listDecl, typeArgs, loc)
        if (decl < 0) {
            ret errorType()
        }
        i32 add = tree.records[decl].methods["add"]
        i32 reserve = tree.records[decl].methods["reserve"]
        use(add, loc)
        noteCall(add, loc)
        use(reserve, loc)
        noteCall(reserve, loc)
        bool ok = true
        for (i64 i = 0; i < elements.len(); i++) {
            i32 value = elements[i]
            if (tree.exprs[value].kind == ExprKind.Ref) {
                error(locOf(value), "an element of a list is given to it, not passed with 'ref'")
                ok = false
                continue
            }
            if (!(i == 0 && checkedFirst) && !coerceValue(value, element)) {
                ok = false
                continue
            }
            // As the argument of add(move T): a variable without `move` gives a copy (D424).
            if (tree.exprs[value].kind != ExprKind.Conversion && !copyIfNeeded(value, element)) {
                ok = false
            }
        }
        Expr count = nodeAt(ExprKind.IntLiteral, loc.line, loc.column)
        count.value = u64(elements.len())
        count.resolved = intType(64, true)
        tree.exprs.add(move count)
        tree.exprs[expr].add = add
        tree.exprs[expr].reserve = reserve
        tree.exprs[expr].count = i32(tree.exprs.len() - 1)
        ret ok ? types.structType(decl) : errorType()
    }

    // `s.cstring()` (D204): the address of a copy that ends with a zero, a
    // temporary of the library destroyed at the end of the statement.
    i32 checkCString(i32 expr) {
        Loc loc = locOf(expr)
        list<i32> args = tree.exprs[expr].items
        if (!isUnsafe(curFile)) {
            error(loc, "cstring() is for the C functions: the module must write 'import unsafe'")
            ret errorType()
        }
        if (args.len() > 0) {
            error(loc, "cstring() takes no arguments")
            checkIgnored(args)
            ret errorType()
        }
        i32 copy = tree.records[stringDecl].methods["zeroEnded"]
        use(copy, loc)
        noteCall(copy, loc)
        Expr ended = nodeAt(ExprKind.MethodCall, loc.line, loc.column)
        ended.left = tree.exprs[expr].left
        ended.text = "zeroEnded"
        ended.target = copy
        ended.resolved = tree.functions[copy].resolvedReturn
        tree.exprs.add(move ended)
        Expr data = nodeAt(ExprKind.Field, loc.line, loc.column)
        data.left = i32(tree.exprs.len() - 1)
        data.text = "data"
        data.index = 0
        tree.exprs[expr] = move data
        ret addrType()
    }

    // The numbers and bool are keys by themselves (D198): `x.hash()` is computed by
    // the compiler, `x.equals(y)` is `x == y`.
    i32 checkKeyMethod(i32 expr, i32 object) {
        Loc loc = locOf(expr)
        string method = tree.exprs[expr].text
        i32 inner = tree.exprs[expr].left
        list<i32> args = tree.exprs[expr].items
        i64 expected = method == "hash" ? 0 : 1
        if (args.len() != expected) {
            error(loc, method + "() takes " + (expected > 0 ? "one argument" : "no arguments"))
            checkIgnored(args)
            ret errorType()
        }
        list<i32> operands
        operands.add(inner)
        if (method == "hash") {
            makeCall(expr, "hash", Intrinsic.HashNumber, operands)
            ret intType(64, false)
        }
        if (!coerce(args[0], object, false)) {
            ret errorType()
        }
        if (method == "compare") {  // D421: -1, 0 or 1, made by the compiler
            operands.add(args[0])
            makeCall(expr, "compare", Intrinsic.CompareNumbers, operands)
            ret intType(32, true)
        }
        Expr equal = nodeAt(ExprKind.Binary, loc.line, loc.column)
        equal.binary = BinaryOp.Eq
        equal.left = inner
        equal.right = args[0]
        equal.operandType = object
        tree.exprs[expr] = move equal
        ret boolType()
    }

    // `variableAddress(x)` (D394): the addr of a module variable, or of a field or an
    // element of one, which stays the same for the whole program; a local variable
    // has none, as it ends with its block.
    i32 checkVariableAddress(i32 call) {
        tree.exprs[call].intrinsic = Intrinsic.VariableAddress
        list<i32> args = tree.exprs[call].items
        if (args.len() != 1 || tree.exprs[call].typeArgs.len() > 0) {
            error(locOf(call), "variableAddress() takes a module variable")
            checkIgnored(args)
            ret errorType()
        }
        i32 type = checkExpr(args[0], -1)
        if (types.isError(type)) {
            ret type
        }
        i32 place = args[0]
        for (tree.exprs[place].kind == ExprKind.Field || tree.exprs[place].kind == ExprKind.Index) {
            place = tree.exprs[place].left
        }
        i32 variable = tree.exprs[place].kind == ExprKind.Name ? tree.exprs[place].variable : -1
        if (variable < 0 || tree.variables[variable].kind != VariableKind.Module) {
            error(locOf(args[0]), "variableAddress() takes a module variable, or a field or an element of one")
            ret errorType()
        }
        ret addrType()
    }

    // `x.bits()` (D397): the bits of an f64 as a u64, of an f32 as a u32.
    i32 checkBits(i32 expr, i32 object) {
        list<i32> args = tree.exprs[expr].items
        if (args.len() > 0) {
            error(locOf(expr), "bits() takes no arguments")
            checkIgnored(args)
            ret errorType()
        }
        list<i32> operands
        operands.add(tree.exprs[expr].left)
        makeCall(expr, "bits", Intrinsic.FloatBits, operands)
        ret intType(types.items[object].bits, false)
    }

    // `f64.fromBits(b)` (D397): the number of those bits, a u64 for an f64, a u32 for an f32.
    i32 checkFromBits(i32 expr, i32 type) {
        list<i32> args = tree.exprs[expr].items
        i32 bits = intType(types.items[type].bits, false)
        if (args.len() != 1) {
            error(locOf(expr), "fromBits() takes the bits of the number, a " + name(bits) + "")
            checkIgnored(args)
            ret errorType()
        }
        if (!coerce(args[0], bits, false)) {
            ret errorType()
        }
        makeCall(expr, "fromBits", Intrinsic.FloatFromBits, args)
        tree.exprs[expr].typeArg = type
        ret type
    }

    // `i16x16.load(values, at)` (D505): the numbers from `at` of a list or an array of the
    // numbers of the vector, checked when the program runs.
    i32 checkVectorLoad(i32 expr, i32 vector) {
        list<i32> args = tree.exprs[expr].items
        i32 number = types.element(vector)
        if (args.len() != 2) {
            error(locOf(expr), "load() takes a list or an array of " + name(number) + " and the index of the first")
            checkIgnored(args)
            ret errorType()
        }
        i32 source = checkExpr(args[0], -1)
        bool atOk = coerce(args[1], intType(64, true), false)
        if (types.isError(source) || !atOk) {
            ret errorType()
        }
        if (!holdsNumbers(source, number)) {
            error(locOf(args[0]), "load() reads a list<" + name(number) + "> or an array of " + name(number) + ", not " + name(source) +
                "")
            ret errorType()
        }
        makeCall(expr, "load", Intrinsic.VectorLoad, args)
        tree.exprs[expr].typeArg = vector
        ret vector
    }

    bool holdsNumbers(i32 source, i32 number) const {
        if (types.isArray(source)) {
            ret types.element(source) == number
        }
        ret isList(source) && elementOf(source) == number
    }

    // The number of arguments of a method made by the compiler.
    bool takes(list<i32> args, i64 count, Loc loc, string method, string usage) {
        if (args.len() == count) {
            ret true
        }
        error(loc, method + "() takes " + usage + "")
        checkIgnored(args)
        ret false
    }

    // The methods of a vector (D505): sum, smallest, largest, abs, the numbers two by two
    // with min and max, store into a list or an array, the halves, the length; and of a
    // mask, all, any and select.
    i32 checkVectorMethod(i32 expr, i32 vector) {
        Loc loc = locOf(expr)
        string method = tree.exprs[expr].text
        i32 inner = tree.exprs[expr].left
        list<i32> args = tree.exprs[expr].items
        i32 number = types.element(vector)
        i64 lanes = types.items[vector].count
        bool mask = types.isInt(number) && types.items[number].isSigned
        list<i32> operands
        operands.add(inner)
        if (method == "len") {
            if (!takes(args, 0, loc, method, "no arguments")) {
                ret errorType()
            }
            makeInt(expr, u64(lanes), errorType())
            ret computeType(expr, intType(64, true))
        }
        if (method == "sum" || method == "smallest" || method == "largest" || method == "abs") {
            if (!takes(args, 0, loc, method, "no arguments")) {
                ret errorType()
            }
            if (method == "abs" && types.isInt(number) && !types.items[number].isSigned) {
                error(loc, "abs() of an unsigned vector is the vector itself")
                ret errorType()
            }
            Intrinsic kind = method == "sum" ? Intrinsic.VectorSum : method == "smallest" ? Intrinsic.VectorSmallest : method ==
                "largest" ? Intrinsic.VectorLargest : Intrinsic.VectorAbs
            makeCall(expr, method, kind, operands)
            tree.exprs[expr].typeArg = vector
            ret method == "abs" ? vector : number
        }
        if (method == "min" || method == "max") {
            if (!takes(args, 1, loc, method, "a vector of the same type")) {
                ret errorType()
            }
            if (!coerce(args[0], vector, false)) {
                ret errorType()
            }
            operands.add(args[0])
            makeCall(expr, method, method == "min" ? Intrinsic.VectorMin : Intrinsic.VectorMax, operands)
            tree.exprs[expr].typeArg = vector
            ret vector
        }
        if (method == "low" || method == "high") {
            if (!takes(args, 0, loc, method, "no arguments")) {
                ret errorType()
            }
            if (sizeOf(tree, types, vector) != 32) {
                error(loc, method + "() gives half of a vector of 256 bits, and " + name(vector) + " has 128")
                ret errorType()
            }
            i32 half = types.vectorType(number, lanes / 2)
            makeCall(expr, method, method == "low" ? Intrinsic.VectorLow : Intrinsic.VectorHigh, operands)
            tree.exprs[expr].typeArg = half
            ret half
        }
        if (method == "store") {
            if (!takes(args, 2, loc, method, "'ref' a list or an array of its numbers, and the index of the first")) {
                ret errorType()
            }
            i32 target = args[0]
            if (tree.exprs[target].kind != ExprKind.Ref) {
                error(locOf(target), "store() changes the list or the array: pass it with 'ref'")
                ret errorType()
            }
            i32 written = tree.exprs[target].left
            i32 place = checkExpr(written, -1)
            bool atOk = coerce(args[1], intType(64, true), false)
            if (types.isError(place) || !atOk) {
                ret errorType()
            }
            if (!holdsNumbers(place, number)) {
                error(locOf(target), "store() writes into a list<" + name(number) + "> or an array of " + name(number) + ", not " +
                    name(place) + "")
                ret errorType()
            }
            if (!isPlace(written)) {
                error(locOf(written), "store() writes into a variable, a field or an element")
                ret errorType()
            }
            string reason = readOnlyReason(written)
            if (reason.len() > 0) {
                error(locOf(written), reason)
                ret errorType()
            }
            operands.add(written)
            operands.add(args[1])
            makeCall(expr, method, Intrinsic.VectorStore, operands)
            tree.exprs[expr].typeArg = vector
            ret voidType()
        }
        if (mask && (method == "all" || method == "any")) {
            if (!takes(args, 0, loc, method, "no arguments")) {
                ret errorType()
            }
            makeCall(expr, method, method == "all" ? Intrinsic.VectorAll : Intrinsic.VectorAny, operands)
            tree.exprs[expr].typeArg = vector
            ret boolType()
        }
        if (mask && method == "select") {
            if (!takes(args, 2, loc, method, "two vectors of the same type, as many numbers as the mask")) {
                ret errorType()
            }
            i32 first = checkExpr(args[0], -1)
            if (types.isError(first)) {
                ret first
            }
            if (!types.isVector(first) || types.items[first].count != lanes || types.items[types.element(first)].bits !=
                types.items[number].bits) {
                error(locOf(args[0]), "select() takes two vectors with as many numbers as the mask, of its size")
                ret errorType()
            }
            if (!coerce(args[1], first, false)) {
                ret errorType()
            }
            operands.add(args[0])
            operands.add(args[1])
            makeCall(expr, method, Intrinsic.VectorSelect, operands)
            tree.exprs[expr].typeArg = vector
            ret first
        }
        error(loc, withArticle(name(vector)) + " has no method " + method + "()")
        ret errorType()
    }

    // `a.len()` is the size written in the type, `a.copy()` a copy of an array of
    // simple values (D196).
    i32 checkArrayMethod(i32 expr, i32 object) {
        Loc loc = locOf(expr)
        string method = tree.exprs[expr].text
        list<i32> args = tree.exprs[expr].items
        if (method != "len" && method != "copy") {
            error(loc, "an array has only len() and copy(), not '" + method + "'")
            ret errorType()
        }
        if (args.len() > 0) {
            error(loc, method + "() takes no arguments")
            checkIgnored(args)
            ret errorType()
        }
        if (method == "len") {  // an i64, as the length of a list, not a literal without a type
            i32 whole = intType(64, true)
            makeInt(expr, u64(types.items[object].count), whole)
            wrap(expr, ExprKind.Conversion, whole)
            ret whole
        }
        if (!canCopy(object)) {
            error(loc, name(object) + " cannot be copied: its elements are not simple values, move it instead")
            ret errorType()
        }
        Expr copy = nodeAt(ExprKind.Copy, loc.line, loc.column)
        copy.left = tree.exprs[expr].left
        tree.exprs[expr] = move copy
        ret object
    }

    // A method of an interface: through a constraint of T (D52), or on a parameter
    // of interface type, with a dynamic call (D49).
    i32 checkInterfaceCall(i32 call, i32 object) {
        Loc loc = locOf(call)
        string method = tree.exprs[call].text
        i32 inner = tree.exprs[call].left
        list<i32> args = tree.exprs[call].items
        list<i32> candidates
        if (types.isParam(object)) {
            candidates = types.params[types.decl(object)].interfaces
        } else {
            candidates.add(types.decl(object))
        }
        i32 target = -1
        for (i32 iface in candidates) {
            for (i64 m = 0; m < tree.interfaces[iface].methods.len(); m++) {
                i32 candidate = tree.interfaces[iface].methods[m]
                if (tree.functions[candidate].name == method && target < 0) {
                    target = candidate
                }
            }
        }
        if (target < 0) {
            // D85: whether T can be copied is checked in each instance.
            if (types.isParam(object) && method == "copy" && args.len() == 0) {
                ret object
            }
            string hint = types.isParam(object) ? ": only the methods of its constraints can be called" : ""
            error(loc, name(object) + " has no method named '" + method + "'" + hint)
            ret errorType()
        }
        if (!tree.functions[target].isConst) {
            string reason = readOnlyReason(inner)
            if (reason.len() > 0) {
                error(loc, "cannot call '" + method + "', which is not const: " + reason)
                ret errorType()
            }
        }
        tree.exprs[call].target = target
        noteCall(target, loc)
        if (!checkArgs(args, target, "'" + method + "'", loc, call, inner, object)) {
            ret errorType()
        }
        ret withSelf(tree.functions[target].resolvedReturn, object)
    }

    i32 checkUnary(i32 expr, i32 expected) {
        Loc loc = locOf(expr)
        i32 operand = tree.exprs[expr].left
        if (tree.exprs[expr].unary == UnaryOp.Not) {
            // D194: on an integer, `!` inverts its bits.
            i32 hint = expected >= 0 && types.isInt(expected) ? expected : boolType()
            i32 type = checkExpr(operand, hint)
            if (types.isUntyped(type) && !types.isError(type)) {
                error(loc, "the type of this expression cannot be deduced: write the type of the value, for example !u8(0)")
                ret errorType()
            }
            if (types.isVector(type) && types.isInt(types.element(type))) {
                ret type  // its bits (D505)
            }
            if (!types.isBool(type) && !types.isInt(type)) {
                if (!types.isError(type)) {
                    error(loc, "'!' needs a bool or an integer, found " + name(type) + "")
                }
                ret errorType()
            }
            ret type
        }

        // A minus in front of a literal becomes part of the literal, so that
        // -128 fits in an i8.
        ExprKind kind = tree.exprs[operand].kind
        if ((kind == ExprKind.IntLiteral && !tree.exprs[operand].flag) || kind == ExprKind.FloatLiteral) {
            Expr literal = tree.exprs[operand]
            literal.negative = !literal.negative
            literal.line = loc.line
            literal.column = loc.column
            tree.exprs[expr] = move literal
            ret computeType(expr, expected)
        }

        i32 type = checkExpr(operand, expected >= 0 && types.isNumeric(expected) ? expected : -1)
        if (types.isError(type)) {
            ret type
        }
        if (types.isVector(type)) {  // D505
            i32 number = types.element(type)
            if (types.isInt(number) && !types.items[number].isSigned) {
                error(loc, "cannot negate an unsigned vector (" + name(type) + ")")
                ret errorType()
            }
            ret type
        }
        if (types.isInt(type) && !types.items[type].isSigned) {
            error(loc, "cannot negate an unsigned value (" + name(type) + ")")
            ret errorType()
        }
        if (!types.isNumeric(type)) {
            error(loc, "'-' needs a number, found " + name(type))
            ret errorType()
        }
        ret type
    }

    // `wrapMul(a, b)` (D396): the binary operation on two integers of the same type,
    // which keeps the low bits instead of checking the overflow.
    i32 checkWrap(i32 expr) {
        Loc loc = locOf(expr)
        string callee = tree.exprs[expr].text
        list<i32> args = tree.exprs[expr].items
        if (args.len() != 2) {
            error(loc, callee + "() takes two integers of the same type")
            checkIgnored(args)
            ret errorType()
        }
        Expr binary = nodeAt(ExprKind.Binary, loc.line, loc.column)
        binary.binary = callee == "wrapAdd" ? BinaryOp.Add : callee == "wrapSub" ? BinaryOp.Sub : BinaryOp.Mul
        binary.left = args[0]
        binary.right = args[1]
        binary.wrap = true
        tree.exprs[expr] = move binary
        i32 operand = unify(expr, -1)
        if (types.isError(operand)) {
            ret operand
        }
        if (!types.isInt(operand)) {
            error(loc, callee + "() works on integers, not on " + name(operand) + "")
            ret errorType()
        }
        tree.exprs[expr].operandType = operand
        ret operand
    }

    // `countOnes(x)`, `trailingZeros(x)`, `leadingZeros(x)` (D502): an i32 from an integer
    // of any type; `rotateLeft(x, n)` and `rotateRight(x, n)`: the integer turned by n
    // bits, n an integer of any type.
    i32 checkBitFunction(i32 call, Intrinsic kind, i32 expected) {
        string callee = tree.exprs[call].text
        list<i32> args = tree.exprs[call].items
        bool rotate = kind == Intrinsic.RotateLeft || kind == Intrinsic.RotateRight
        if (args.len() != (rotate ? 2 : 1)) {
            error(locOf(call), callee + (rotate ? "() takes an integer and the bits to turn it by" : "() takes one integer"))
            checkIgnored(args)
            ret errorType()
        }
        tree.exprs[call].intrinsic = kind
        bool typed = rotate && expected >= 0 && types.isInt(expected)  // `u64 r = rotateLeft(1, 8)`, as a shift (D195)
        i32 value = checkExpr(args[0], typed ? expected : -1)
        if (value == untypedInt()) {  // its size changes the result: written, as for a shift (D55)
            if (typed && coerce(args[0], expected, false)) {
                value = expected
            } else {
                if (!typed) {
                    error(locOf(args[0]), "the type of this literal cannot be deduced: write it, for example " + callee + "(u64(5)" +
                        (rotate ? ", 1" : "") + ")")
                }
                value = errorType()
            }
        }
        if (!types.isError(value) && !types.isInt(value)) {
            error(locOf(args[0]), callee + "() works on integers, not on " + name(value) + "")
            value = errorType()
        }
        if (types.isError(value)) {
            for (i64 i = 1; i < args.len(); i++) {
                checkExpr(args[i], -1)
            }
            ret value
        }
        if (!rotate) {
            ret intType(32, true)
        }
        i32 amount = checkExpr(args[1], -1)
        if (types.isUntyped(amount)) {
            if (!coerce(args[1], value, false)) {
                ret errorType()
            }
            amount = value
        }
        if (types.isError(amount)) {
            ret amount
        }
        if (!types.isInt(amount)) {
            error(locOf(args[1]), "the bits to turn by are an integer, not " + name(amount) + "")
            ret errorType()
        }
        ret value
    }

    // `fma(a, b, c)` (D555): a * b + c rounded once, three f32 or three f64, or three
    // vectors of them, number by number. A literal takes the type of the others, or
    // the type expected, or f64.
    i32 checkFma(i32 call, i32 expected) {
        list<i32> args = tree.exprs[call].items
        if (args.len() != 3) {
            error(locOf(call), "fma() takes three numbers: fma(a, b, c) is a * b + c")
            checkIgnored(args)
            ret errorType()
        }
        tree.exprs[call].intrinsic = Intrinsic.Fma
        list<i32> found
        i32 type = errorType()
        bool wrong = false
        for (i64 i = 0; i < 3; i++) {
            i32 one = checkExpr(args[i], -1)
            found.add(one)
            if (types.isError(one)) {
                wrong = true
            }
            if (types.isError(type) && !types.isError(one) && !types.isUntyped(one)) {
                type = one
            }
        }
        if (wrong) {
            ret errorType()
        }
        if (types.isError(type)) {
            type = expected >= 0 && types.isFloat(expected) ? expected : floatType(64)
        }
        if (!types.isFloat(type) && !(types.isVector(type) && types.isFloat(types.element(type)))) {  // P85: the vectors of them too
            error(locOf(call), "fma() works on f32 or f64, not on " + name(type) + "")
            ret errorType()
        }
        for (i64 i = 0; i < 3; i++) {
            if (types.isUntyped(found[i])) {
                bool ok = types.isVector(type) ? splatInto(args[i], type) : coerce(args[i], type, false)
                if (!ok) {
                    ret errorType()
                }
            } else if (found[i] != type) {
                error(locOf(args[i]), "the numbers of fma() have the same type: this is " + name(found[i]) + ", not " + name(type) + "")
                ret errorType()
            }
        }
        ret type
    }

    i32 checkBinary(i32 expr, i32 expected) {
        Loc loc = locOf(expr)
        BinaryOp op = tree.exprs[expr].binary
        string quoted = "'" + spelling(op) + "'"
        if (op == BinaryOp.And || op == BinaryOp.Or) {
            for (i64 side = 0; side < 2; side++) {
                i32 operand = side == 0 ? tree.exprs[expr].left : tree.exprs[expr].right
                i32 type = checkExpr(operand, boolType())
                if (!types.isBool(type)) {
                    if (!types.isError(type)) {
                        error(locOf(operand), quoted + " needs bool values, found " + name(type))
                    }
                    ret errorType()
                }
            }
            tree.exprs[expr].operandType = boolType()
            ret boolType()
        }

        if (op == BinaryOp.Shl || op == BinaryOp.Shr) {
            ret checkShift(expr, expected)
        }
        bool arithmetic = isArithmetic(op)
        i32 operand = unify(expr, arithmetic && expected >= 0 && types.isNumeric(expected) ? expected : -1)
        if (types.isError(operand)) {
            ret operand
        }
        tree.exprs[expr].operandType = operand
        if (isString(operand)) {
            ret stringOperator(expr)
        }

        if (types.isParam(operand) && (op == BinaryOp.Eq || op == BinaryOp.Ne) && isUnsafe(curFile)) {
            // D596: in the library, as in list.contains: checked in each instance, where
            // the type is known, as the other functions of the unsafe dialect (D85).
            ret boolType()
        }
        if (types.isParam(operand) || types.isInterface(operand)) {
            error(loc, quoted + " does not work on values of type " + name(operand) + ": no interface provides it yet")
            ret errorType()
        }
        bool equality = op == BinaryOp.Eq || op == BinaryOp.Ne
        if (types.isStruct(operand) && tree.records[types.decl(operand)].isEnum && equality && withoutData(types.decl(operand)) &&
            !tree.records[types.decl(operand)].methods.contains("equals")) {
            ret boolType()  // their cases, as numbers (D112)
        }
        if (equality && (types.isStruct(operand) || types.isArray(operand))) {
            ret checkEquality(expr, operand)  // D565
        }
        if (types.isStruct(operand)) {
            error(loc, quoted + " does not work on structs yet")
            ret errorType()
        }
        if (types.isVector(operand)) {
            ret checkVectorOperator(expr, operand)  // D505
        }
        if (types.isArray(operand) || types.isFunction(operand)) {
            error(loc, quoted + " does not work on values of type " + name(operand))
            ret errorType()
        }
        if (arithmetic) {
            if (!types.isNumeric(operand)) {
                error(loc, quoted + " needs numbers, found " + name(operand))
                ret errorType()
            }
            if (op == BinaryOp.Rem && !types.isInt(operand)) {
                error(loc, "'%' only works on integers")
                ret errorType()
            }
            if (isBitwise(op) && !types.isInt(operand)) {
                error(loc, quoted + " only works on integers")
                ret errorType()
            }
            ret operand
        }
        if (!types.isNumeric(operand) && !(equality && (types.isBool(operand) || operand == addrType()))) {
            error(loc, quoted + " cannot compare " + name(operand) + " values")
            ret errorType()
        }
        ret boolType()
    }

    // An enum whose cases have no data: it can be compared and converted to numbers (D112).
    bool withoutData(i32 decl) const {
        for (i64 c = 0; c < tree.records[decl].cases.len(); c++) {
            if (tree.records[decl].cases[c].fields.len() > 0) {
                ret false
            }
        }
        ret true
    }

    // The vector of the comparisons of a vector: signed integers of the size of its
    // numbers, -1 where true and 0 where false.
    i32 maskOf(i32 vector) {
        ret types.vectorType(intType(types.items[types.element(vector)].bits, true), types.items[vector].count)
    }

    // An operator on vectors (D505): + - * on each number, / of floats, & | ^ of integers;
    // a comparison gives the mask, -1 where true and 0 where false.
    i32 checkVectorOperator(i32 binary, i32 vector) {
        Loc loc = locOf(binary)
        BinaryOp op = tree.exprs[binary].binary
        i32 number = types.element(vector)
        string quoted = "'" + spelling(op) + "'"
        if (op == BinaryOp.Rem) {
            error(loc, "'%' does not work on vectors: the processors have no remainder of vectors")
            ret errorType()
        }
        if (op == BinaryOp.Div && !types.isFloat(number)) {
            error(loc, quoted + " works on vectors of floats only: the processors have no division of integer vectors")
            ret errorType()
        }
        if (isBitwise(op) && !types.isInt(number)) {
            error(loc, quoted + " works on vectors of integers")
            ret errorType()
        }
        if (isArithmetic(op)) {
            ret vector
        }
        ret maskOf(vector)
    }

    // A number with a vector, in an operator: the vector with that number in each of its
    // numbers (D505).
    bool splatInto(i32 number, i32 vector) {
        if (!coerce(number, types.element(vector), false)) {
            ret false
        }
        wrap(number, ExprKind.Conversion, vector)
        ret true
    }

    // `x << n`, `x >> n` (D195): the type is the one of x; n is any integer.
    i32 checkShift(i32 binary, i32 expected) {
        Loc loc = locOf(binary)
        i32 left = tree.exprs[binary].left
        i32 right = tree.exprs[binary].right
        bool whole = expected >= 0 && types.isInt(expected)
        i32 type = checkExpr(left, whole ? expected : -1)
        if (types.isUntyped(type)) {
            if (!whole) {
                error(loc, "the type of this expression cannot be deduced: write the type of the value, for example u32(1) << n")
                ret errorType()
            }
            if (!coerce(left, expected, false)) {
                ret errorType()
            }
            type = expected
        }
        i32 count = checkExpr(right, -1)
        if (types.isUntyped(count) && !types.isError(type) && (types.isInt(type) || types.isVector(type))) {
            i32 target = types.isVector(type) ? intType(64, true) : type
            if (!coerce(right, target, false)) {
                ret errorType()
            }
            count = target
        }
        if (types.isError(type) || types.isError(count)) {
            ret errorType()
        }
        if (types.isVector(type) && types.isInt(types.element(type)) && types.isInt(count)) {  // D505: each number, by the same count
            tree.exprs[binary].operandType = type
            ret type
        }
        if (!types.isInt(type)) {
            error(loc, "'" + spelling(tree.exprs[binary].binary) + "' works on integers, found " + name(type) + "")
            ret errorType()
        }
        if (!types.isInt(count)) {
            error(loc, "the count of a shift is an integer, found " + name(count) + "")
            ret errorType()
        }
        tree.exprs[binary].operandType = type
        ret type
    }

    // The call of a method of string on the two sides of an operator.
    Expr stringCall(i32 binary, string method, i32 result) const {
        Expr node = nodeAt(ExprKind.MethodCall, tree.exprs[binary].line, tree.exprs[binary].column)
        node.left = tree.exprs[binary].left
        node.text = method
        node.items.add(tree.exprs[binary].right)
        node.target = tree.records[stringDecl].methods[method]
        node.resolved = result
        ret node
    }

    // D95: the operators on strings are calls to the methods of the library.
    i32 stringOperator(i32 expr) {
        Loc loc = locOf(expr)
        BinaryOp op = tree.exprs[expr].binary
        i32 text = types.structType(stringDecl)
        switch (op) {
            case Add {
                Expr call = stringCall(expr, "concat", text)
                tree.exprs[expr] = move call
                ret text
            }
            case Eq {
                Expr call = stringCall(expr, "equals", boolType())
                tree.exprs[expr] = move call
                ret boolType()
            }
            case Ne {
                Expr call = stringCall(expr, "equals", boolType())
                tree.exprs.add(move call)
                Expr negation = nodeAt(ExprKind.Unary, loc.line, loc.column)
                negation.unary = UnaryOp.Not
                negation.left = i32(tree.exprs.len() - 1)
                tree.exprs[expr] = move negation
                ret boolType()
            }
            case Lt, Le, Gt, Ge {
                i32 whole = intType(32, true)
                Expr call = stringCall(expr, "compare", whole)
                tree.exprs.add(move call)
                i32 compared = i32(tree.exprs.len() - 1)
                Expr zero = nodeAt(ExprKind.IntLiteral, loc.line, loc.column)
                zero.resolved = whole
                tree.exprs.add(move zero)
                Expr comparison = nodeAt(ExprKind.Binary, loc.line, loc.column)
                comparison.binary = op
                comparison.left = compared
                comparison.right = i32(tree.exprs.len() - 1)
                comparison.operandType = whole
                tree.exprs[expr] = move comparison
                ret boolType()
            }
            default {
                error(loc, "'" + spelling(op) + "' does not work on strings")
                ret errorType()
            }
        }
    }

    // `v[i]`: an element of a list, with an i64 index (D12, D35).
    i32 checkIndex(i32 node, bool inserts) {
        i32 inner = tree.exprs[node].left
        i32 index = tree.exprs[node].right
        Loc loc = locOf(node)
        i32 object = checkExpr(inner, -1)
        if (isMap(object)) {  // D197: through valueOf, or place for the target of an assignment
            i32 decl = types.decl(object)
            if (!coerce(index, tree.records[decl].typeArgs[0], false)) {
                ret errorType()
            }
            i32 access = tree.records[decl].methods[inserts ? "place" : "valueOf"]
            tree.exprs[node].target = access
            use(access, loc)
            noteCall(access, loc)
            ret tree.records[decl].typeArgs[1]
        }
        bool indexOk = coerce(index, intType(64, true), false)
        if (types.isError(object) || !indexOk) {
            ret errorType()
        }
        if (types.isArray(object) || types.isVector(object)) {  // D196, D505: a constant index here, the others when the program runs
            if (isConstantIndex(index)) {
                i64 constant = constantIndex(index)
                if (constant < 0 || constant >= types.items[object].count) {
                    error(locOf(index), format("the index {} is outside the {}, which has {} elements", constant,
                        types.isVector(object) ? "vector" : "array", types.items[object].count))
                    ret errorType()
                }
            }
            ret types.element(object)
        }
        if (isString(object)) {
            ret intType(8, false)  // a byte, as the length is in bytes (D200)
        }
        if (!isList(object)) {
            error(loc, "only a list, an array and a string have elements, found " + name(object) + "")
            ret errorType()
        }
        ret elementOf(object)
    }

    // ---- The functions written by the compiler in Cromo (D251, D319) ----

    // The function of a text of Cromo with one function, parsed as a part of the
    // file `file`, whose names it sees; -1 when the text is not one function.
    i32 parseGenerated(string text, i32 file) {
        i64 before = tree.topFunctions.len()
        i32 saved = diag.current
        diag.current = file
        list<Token> tokens = tokenize(text, ref diag, false)
        map<i64, bool> angles
        parseInto(ref tokens, ref diag, ref angles, ref tree, file)
        diag.current = saved
        i32 function = tree.topFunctions.len() == before + 1 ? tree.topFunctions[before] : -1
        for (tree.topFunctions.len() > before) {
            tree.topFunctions.remove(tree.topFunctions.len() - 1)
        }
        ret function
    }

    // A generated function becomes an instance: with its bindings, it reads the
    // private fields too, and its body waits to be checked.
    void addGenerated(i32 function, list<TypeBinding> generatedBindings, string where, Loc loc) {
        tree.functions[function].bindings = generatedBindings
        tree.functions[function].convertsJson = true
        made.add(function)
        resolveSignatureWith(function)
        schedule(function, "", false, where, loc)
    }

    TypeBinding binding(string name, i32 type) const {
        TypeBinding result
        result.name = name
        result.type = type
        ret result
    }

    // The function of the core with a name, or -1 with an error.
    i32 coreFunction(string name, Loc loc) {
        if (!scopes[libraryFile].functions.contains(name)) {
            error(loc, "the standard library has no function '" + name + "'")
            ret -1
        }
        ret scopes[libraryFile].functions[name]
    }

    // `debugWrite<T>(ref out, value)` of the core: for a real T, the call of
    // debugString, of an instance of debugList or debugMap, or of a function
    // generated for the numbers, the arrays, the structs and the enums (D319).
    i32 checkDebug(i32 call) {
        Loc loc = locOf(call)
        string what = "'" + tree.exprs[call].text + "'"
        list<i32> args = tree.exprs[call].items
        list<i32> resolved
        if (!resolveTypeArgs(tree.exprs[call].typeArgs.copy(), curFile, 1, what, loc, ref resolved)) {
            checkIgnored(args)
            ret errorType()
        }
        i32 type = resolved[0]
        tree.exprs[call].typeArg = type
        if (isAbstract(tree, types, type)) {  // the check of a generic of the core (D52)
            if (args.len() != 2) {
                error(loc, what + " takes 2 arguments")
                checkIgnored(args)
                ret errorType()
            }
            bool ok = checkArg(args[0], ParamMode.Ref, "out", types.structType(stringDecl))
            ok = checkArg(args[1], ParamMode.Read, "", type) && ok
            ret ok ? voidType() : errorType()
        }
        i32 function = debugFunction(type, loc)
        if (function < 0) {
            checkIgnored(args)
            ret errorType()
        }
        tree.exprs[call].intrinsic = Intrinsic.None
        tree.exprs[call].target = function
        noteCall(function, loc)
        if (!checkArgs(args, function, what, loc, call, -1, errorType())) {
            ret errorType()
        }
        ret voidType()
    }

    i32 debugFunction(i32 type, Loc loc) {
        string problem = debugProblem(type)
        if (problem.len() > 0) {
            error(loc, "values of type " + name(type) + " cannot be printed with {:?}: " + problem)
            ret -1
        }
        if (types.isStruct(type)) {
            i32 decl = types.decl(type)
            if (decl == stringDecl) {
                ret coreFunction("debugString", loc)
            }
            if (isList(type) || isMap(type)) {
                i32 generic = coreFunction(isList(type) ? "debugList" : "debugMap", loc)
                if (generic < 0) {
                    ret -1
                }
                list<i32> typeArgs = tree.records[decl].typeArgs
                ret instantiateFunction(generic, typeArgs, loc)
            }
        }
        ret generatedDebug(type, loc)
    }

    // The writer of the form of debug of a number, an array, a struct or an enum,
    // written in Cromo and checked as an instance with the types of its parts, in
    // the scope of the core; it reads the private fields too, as copy().
    i32 generatedDebug(i32 type, Loc loc) {
        string key = format("debug {}", type)
        if (generated.contains(key)) {
            ret generated[key]
        }
        list<TypeBinding> generatedBindings
        generatedBindings.add(binding("T", type))
        string text = debugWriter(type, ref generatedBindings)
        i32 function = parseGenerated(text, libraryFile)
        if (function >= 0) {
            tree.functions[function].symbol = symbolFor(loc.file, "debug." + symbolOrName(type))
        }
        if (function < 0) {
            error(loc, "internal error: the form of debug of " + name(type) + " does not parse")
            ret -1
        }
        generated[key] = function
        addGenerated(function, generatedBindings, name(type), loc)
        ret function
    }

    // The name in the form of debug: "Box" also for Box<i64>, as Rust prints it.
    string debugName(i32 decl) const {
        ret tree.records[decl].generic >= 0 ? tree.records[tree.records[decl].generic].name : tree.records[decl].name
    }

    // `Point { x: 1, y: 2 }`, `Circle(2.5)`, `[1, 2]`, or the number as {} prints it.
    string debugWriter(i32 type, ref list<TypeBinding> generatedBindings) const {
        string text = "void write(ref string out, T value) {\n"
        if (types.isFloat(type)) {  // 1.0, not 1: a float looks different from an integer, as in JSON (D264)
            ret text + "string number = format(\"{}\", value)\nout += number\n" +
                "if (!number.contains(\".\") && !number.contains(\"e\") && !number.contains(\"n\")) {\nout += \".0\"\n}\n}\n"
        }
        if (types.isNumeric(type) || types.isBool(type)) {
            ret text + "out += format(\"{}\", value)\n}\n"
        }
        if (types.isArray(type) || types.isVector(type)) {
            generatedBindings.add(binding("E", types.element(type)))
            ret text + "out += \"[\"\nfor (i64 i = 0; i < value.len(); i++) {\nif (i > 0) {\nout += \", \"\n}\n" +
                "debugWrite<E>(ref out, value[i])\n}\nout += \"]\"\n}\n"
        }
        i32 decl = types.decl(type)
        if (tree.records[decl].isEnum) {
            text += "switch (value) {\n"
            for (i64 c = 0; c < tree.records[decl].cases.len(); c++) {
                string caseName = tree.records[decl].cases[c].name
                i64 count = tree.records[decl].cases[c].fields.len()
                string bound
                string body = "out += " + quoted(caseName + (count == 0 ? "" : "(")) + "\n"
                for (i64 i = 0; i < count; i++) {
                    string param = format("C{}_{}", c, i)
                    generatedBindings.add(binding(param, tree.records[decl].cases[c].fields[i].resolved))
                    bound += format("{}{} b{}", i > 0 ? ", " : "", param, i)
                    if (i > 0) {
                        body += "out += \", \"\n"
                    }
                    body += format("debugWrite<{}>(ref out, b{})\n", param, i)
                }
                if (count > 0) {
                    body += "out += \")\"\n"
                }
                text += "case " + caseName + (count == 0 ? "" : "(" + bound + ")") + " {\n" + body + "}\n"
            }
            ret text + "}\n}\n"
        }
        if (tree.records[decl].fields.len() == 0) {
            ret text + "out += " + quoted(debugName(decl)) + "\n}\n"
        }
        text += "out += " + quoted(debugName(decl) + " { ") + "\n"
        for (i64 i = 0; i < tree.records[decl].fields.len(); i++) {
            string fieldName = tree.records[decl].fields[i].name
            string param = format("F{}", i)
            generatedBindings.add(binding(param, tree.records[decl].fields[i].resolved))
            text += "out += " + quoted((i > 0 ? ", " : "") + fieldName + ": ") + "\n"
            text += "debugWrite<" + param + ">(ref out, value." + fieldName + ")\n"
        }
        ret text + "out += \" }\"\n}\n"
    }

    // A type written by the compiler, as `Value` of std.json, at the place of a call.
    i32 namedType(string name, Loc loc) {
        TypeNode node
        node.name = name
        node.line = loc.line
        node.column = loc.column
        tree.types.add(move node)
        ret resolveType(i32(tree.types.len() - 1), loc.file)
    }

    // `jsonWrite<T>(ref writer, value)` and `jsonRead<T>(value)` of std.json (D251).
    // For a real T the call becomes that of the function of std.json for T, of an
    // instance of writeList or readList, or of a function generated for a struct
    // or an enum.
    i32 checkJson(i32 call, bool write) {
        Loc loc = locOf(call)
        string what = "'" + tree.exprs[call].text + "'"
        list<i32> args = tree.exprs[call].items
        list<i32> resolved
        if (!resolveTypeArgs(tree.exprs[call].typeArgs.copy(), curFile, 1, what, loc, ref resolved)) {
            checkIgnored(args)
            ret errorType()
        }
        i32 type = resolved[0]
        tree.exprs[call].typeArg = type
        if (isAbstract(tree, types, type)) {  // the check of a generic of std.json (D52)
            i32 value = namedType("Value", loc)
            i32 writer = namedType("Writer", loc)
            i64 expected = write ? 2 : 1
            if (value < 0 || writer < 0 || args.len() != expected) {
                if (value >= 0 && writer >= 0) {
                    error(loc, format("{} takes {} arguments", what, expected))
                }
                checkIgnored(args)
                ret errorType()
            }
            bool ok = checkArg(args[0], write ? ParamMode.Ref : ParamMode.Read, write ? "writer" : "value", write ? writer : value)
            if (write) {
                ok = checkArg(args[1], ParamMode.Read, "", type) && ok
            }
            if (!ok) {
                ret errorType()
            }
            ret write ? voidType() : type
        }
        i32 function = jsonFunction(write, type, loc)
        if (function < 0) {
            checkIgnored(args)
            ret errorType()
        }
        tree.exprs[call].intrinsic = Intrinsic.None
        tree.exprs[call].target = function
        noteCall(function, loc)
        if (!checkArgs(args, function, what, loc, call, -1, errorType())) {
            ret errorType()
        }
        ret tree.functions[function].resolvedReturn
    }

    // The function of std.json with a name, seen from the place of a call.
    i32 jsonLibrary(string name, Loc loc) {
        i32 found = findDecl(functionsTable, name, loc, "")
        if (found < 0) {
            error(loc, "std.json has no function '" + name + "'")
        }
        ret found
    }

    i32 jsonGeneric(string name, i32 arg, Loc loc) {
        i32 found = jsonLibrary(name, loc)
        if (found < 0) {
            ret -1
        }
        list<i32> typeArgs
        typeArgs.add(arg)
        ret instantiateFunction(found, typeArgs, loc)
    }

    // The function that writes or reads the values of a real type: writeI32,
    // readString, an instance of writeList, a function generated for a struct...
    i32 jsonFunction(bool write, i32 type, Loc loc) {
        string prefix = write ? "write" : "read"
        if (types.isBool(type) || types.isNumeric(type)) {
            string written = name(type)
            ret jsonLibrary(prefix + written.slice(0, 1).upper() + written.slice(1, written.len()), loc)
        }
        if (types.isArray(type)) {
            ret generatedArrayJson(write, type, loc)
        }
        if (types.isStruct(type)) {
            i32 decl = types.decl(type)
            if (decl == stringDecl) {
                ret jsonLibrary(prefix + "String", loc)
            }
            if (isJsonValue(type)) {
                ret jsonLibrary(prefix + "Value", loc)
            }
            if (isList(type)) {
                ret jsonGeneric(prefix + "List", elementOf(type), loc)
            }
            if (isMap(type) && isString(tree.records[decl].typeArgs[0])) {
                ret jsonGeneric(prefix + "Map", tree.records[decl].typeArgs[1], loc)
            }
            if (!isMap(type)) {
                ret generatedJson(write, decl, loc)
            }
        }
        error(loc, "values of type " + name(type) + " cannot be converted to JSON: " + jsonProblem(type))
        ret -1
    }

    // The conversion of a struct or of an enum, written in Cromo and checked as an
    // instance with the types of its fields (D251). It is in the scope of std.json,
    // and it reads and writes also the private fields, as copy().
    i32 generatedJson(bool write, i32 decl, Loc loc) {
        string key = format("{} struct {}", write ? "write" : "read", decl)
        if (generated.contains(key)) {
            ret generated[key]
        }
        list<TypeBinding> generatedBindings
        generatedBindings.add(binding("T", types.structType(decl)))
        string text = write ? jsonWriter(decl, ref generatedBindings) : jsonReader(decl, ref generatedBindings)
        i32 function = parseGenerated(text, loc.file)
        if (function >= 0) {
            tree.functions[function].symbol = symbolFor(loc.file, (write ? "write." : "read.") + recordSymbol(decl))
        }
        if (function < 0) {
            error(loc, "internal error: the conversion to JSON of " + tree.records[decl].name + " does not parse")
            ret -1
        }
        generated[key] = function
        addGenerated(function, generatedBindings, tree.records[decl].name.copy(), loc)
        ret function
    }

    // An array of JSON, with the elements of a fixed array (D196): generated for each
    // type of array, as for a struct.
    i32 generatedArrayJson(bool write, i32 type, Loc loc) {
        string key = format("{} {}", write ? "write" : "read", type)
        if (generated.contains(key)) {
            ret generated[key]
        }
        list<TypeBinding> generatedBindings
        generatedBindings.add(binding("T", type))
        generatedBindings.add(binding("E", types.element(type)))
        string count = format("{}", types.items[type].count)
        string text
        if (write) {
            text = "void write(ref Writer w, T value) {\nw.beginArray()\nfor (E item in value) {\njsonWrite<E>(ref w, item)\n}\n" +
                "w.endArray()\n}\n"
        } else {
            text = "T read(Value v) {\nT result\nswitch (v) {\ncase Array(list<Value> items) {\nif (items.len() != " + count +
                ") {\nthrow wrongLength(" + count + ", items.len())\n}\nfor (i64 i = 0; i < " + count +
                "; i++) {\ntry {\nresult[i] = jsonRead<E>(items[i])\n} catch (Mismatch e) {\nthrow e.at(i)\n}\n}\n}\n" +
                "case Null {\n}\ndefault {\nthrow mismatch(\"an array\", v)\n}\n}\nret result\n}\n"
        }
        i32 function = parseGenerated(text, loc.file)
        if (function >= 0) {
            tree.functions[function].symbol = symbolFor(loc.file, (write ? "write." : "read.") + name(type))
        }
        if (function < 0) {
            error(loc, "internal error: the conversion to JSON of " + name(type) + " does not parse")
            ret -1
        }
        generated[key] = function
        addGenerated(function, generatedBindings, name(type), loc)
        ret function
    }

    // An object with a member for each field; for an enum the name of a case
    // without data, or an object whose member is the case with its data (D365).
    string jsonWriter(i32 decl, ref list<TypeBinding> generatedBindings) const {
        string text = "void write(ref Writer w, T value) {\n"
        if (tree.records[decl].isEnum) {
            text += "switch (value) {\n"
            for (i64 c = 0; c < tree.records[decl].cases.len(); c++) {
                string caseName = tree.records[decl].cases[c].name
                string jsonName = tree.records[decl].cases[c].jsonName
                i64 count = tree.records[decl].cases[c].fields.len()
                if (count == 0) {
                    text += "case " + caseName + " {\nw.writeText(" + quoted(jsonName) + ")\n}\n"
                    continue
                }
                string pattern
                string body = "w.beginObject()\nw.key(" + quoted(jsonName) + ")\nw.beginObject()\n"
                for (i64 i = 0; i < count; i++) {
                    string param = format("D{}_{}", c, i)
                    string dataName = format("d{}", i)
                    generatedBindings.add(binding(param, tree.records[decl].cases[c].fields[i].resolved))
                    pattern += (i > 0 ? ", " : "") + param + " " + dataName
                    body += "w.key(" + quoted(tree.records[decl].cases[c].fields[i].name) + ")\njsonWrite<" + param + ">(ref w, " +
                        dataName + ")\n"
                }
                text += "case " + caseName + "(" + pattern + ") {\n" + body + "w.endObject()\nw.endObject()\n}\n"
            }
            text += "}\n"
        } else {
            text += "w.beginObject()\n"
            for (i64 i = 0; i < tree.records[decl].fields.len(); i++) {
                string jsonName = tree.records[decl].fields[i].jsonName
                if (jsonName.len() == 0) {
                    continue
                }
                string param = format("F{}", i)
                generatedBindings.add(binding(param, tree.records[decl].fields[i].resolved))
                text += "w.key(" + quoted(jsonName) + ")\n"
                text += "jsonWrite<" + param + ">(ref w, value." + tree.records[decl].fields[i].name + ")\n"
            }
            text += "w.endObject()\n"
        }
        ret text + "}\n"
    }

    // The fields named by the members of an object, which keep the default value
    // when their member is missing; the members without a field are ignored. A
    // null gives the default value (D257).
    string jsonReader(i32 decl, ref list<TypeBinding> generatedBindings) const {
        string text = "T read(Value v) {\n"
        if (tree.records[decl].isEnum && withoutData(decl)) {
            string known
            text += "if (v.isNull()) {\nT first\nret first\n}\n"  // D257
            text += "string name = readString(v)\nswitch (name) {\n"
            for (i64 c = 0; c < tree.records[decl].cases.len(); c++) {
                string jsonName = tree.records[decl].cases[c].jsonName
                text += "case " + quoted(jsonName) + " {\nret T." + tree.records[decl].cases[c].name + "\n}\n"
                known += (known.len() == 0 ? "" : ", ") + jsonName
            }
            ret text + "}\nthrow unknownCase(name, " + quoted(known) + ")\n}\n"
        }
        if (tree.records[decl].isEnum) {  // D365: a text for a case without data, an object of one member for the others
            string known
            string bare
            string objects
            for (i64 c = 0; c < tree.records[decl].cases.len(); c++) {
                string caseName = tree.records[decl].cases[c].name
                string jsonName = tree.records[decl].cases[c].jsonName
                i64 count = tree.records[decl].cases[c].fields.len()
                known += (known.len() == 0 ? "" : ", ") + jsonName
                if (count == 0) {
                    bare += "case " + quoted(jsonName) + " {\nret T." + caseName + "\n}\n"
                    continue
                }
                string declarations
                string members
                string given
                for (i64 i = 0; i < count; i++) {
                    string param = format("D{}_{}", c, i)
                    string dataName = format("d{}", i)
                    string fieldName = tree.records[decl].cases[c].fields[i].name
                    generatedBindings.add(binding(param, tree.records[decl].cases[c].fields[i].resolved))
                    declarations += param + " " + dataName + "\n"
                    members += "case " + quoted(fieldName) + " {\ntry {\n" + dataName + " = jsonRead<" + param +
                        ">(item.value)\n} catch (Mismatch e) {\nthrow e.inside(" + quoted(fieldName) + ").inside(" + quoted(jsonName) +
                        ")\n}\n}\n"
                    given += (i > 0 ? ", move " : "move ") + dataName
                }
                objects += "case " + quoted(jsonName) + " {\n" + declarations + "switch (members[0].value) {\n" +
                    "case Object(list<Member> data) {\nfor (Member item in data) {\nswitch (item.name) {\n" + members +
                    "}\n}\n}\ncase Null {\n}\ndefault {\nthrow mismatch(\"an object\", members[0].value).inside(" + quoted(jsonName) +
                    ")\n}\n}\nret T." + caseName + "(" + given + ")\n}\n"
            }
            text += "if (v.isNull()) {\nT first\nret first\n}\n"  // D257
            text += "switch (v) {\ncase Text(string name) {\nswitch (name) {\n" + bare + "}\nthrow unknownCase(name, " + quoted(known) +
                ")\n}\ncase Object(list<Member> members) {\nif (members.len() != 1) {\n" +
                "throw mismatch(\"an object with one member, the case\", v)\n}\nswitch (members[0].name) {\n" + objects +
                "}\nthrow unknownCase(members[0].name, " + quoted(known) + ")\n}\ndefault {\n" +
                "throw mismatch(\"a text or an object, a case\", v)\n}\n}\n}\n"
            ret text
        }
        string cases
        for (i64 i = 0; i < tree.records[decl].fields.len(); i++) {
            string jsonName = tree.records[decl].fields[i].jsonName
            if (jsonName.len() == 0) {
                continue
            }
            string param = format("F{}", i)
            generatedBindings.add(binding(param, tree.records[decl].fields[i].resolved))
            // A null leaves the field as a member that is missing, with its initial value (D257).
            cases += "case " + quoted(jsonName) + " {\nif (!member.value.isNull()) {\ntry {\nresult." +
                tree.records[decl].fields[i].name + " = jsonRead<" + param + ">(member.value)\n} catch (Mismatch e) {\nthrow e.inside(" +
                quoted(jsonName) + ")\n}\n}\n}\n"
        }
        text += "T result\n"
        if (cases.len() == 0) {
            text += "if (!isObject(v) && !v.isNull()) {\nthrow mismatch(\"an object\", v)\n}\n"
        } else {
            text += "switch (v) {\ncase Object(list<Member> members) {\nfor (Member member in members) {\nswitch (member.name) {\n" +
                cases + "}\n}\n}\ncase Null {\n}\ndefault {\nthrow mismatch(\"an object\", v)\n}\n}\n"
        }
        ret text + "ret result\n}\n"
    }

    void addParam(ref Function signature, ParamMode mode, string name, i32 type) const {
        Param param
        param.mode = mode
        param.name = name
        signature.params.add(move param)
        signature.paramTypes.add(type)
    }

    // The built-in functions: `panic` (D102), and the `unsafe` dialect of the
    // standard library (D98).
    i32 checkIntrinsic(i32 call, Intrinsic kind) {
        tree.exprs[call].intrinsic = kind
        if (kind == Intrinsic.JsonWrite || kind == Intrinsic.JsonRead) {
            ret checkJson(call, kind == Intrinsic.JsonWrite)
        }
        if (kind == Intrinsic.DebugWrite) {
            ret checkDebug(call)
        }
        if (kind == Intrinsic.CallC) {
            ret checkCallC(call)
        }
        Loc loc = locOf(call)
        string callee = tree.exprs[call].text
        list<i32> args = tree.exprs[call].items
        list<i32> typeArgs = tree.exprs[call].typeArgs
        bool atomic = kind == Intrinsic.AtomicLoad || kind == Intrinsic.AtomicStore || kind == Intrinsic.AtomicAdd ||
            kind == Intrinsic.AtomicExchange || kind == Intrinsic.AtomicCompareExchange || kind == Intrinsic.AtomicLoadRelaxed ||
            kind == Intrinsic.AtomicStoreRelaxed || kind == Intrinsic.AtomicAddRelaxed
        bool generic = kind == Intrinsic.SizeOf || kind == Intrinsic.Take || kind == Intrinsic.Put || kind == Intrinsic.Destroy ||
            kind == Intrinsic.CopyAt || kind == Intrinsic.EqualAt || atomic
        string what = "'" + callee + "'"
        if (generic) {
            list<i32> resolved
            if (!resolveTypeArgs(typeArgs, curFile, 1, what, loc, ref resolved)) {
                checkIgnored(args)
                ret errorType()
            }
            tree.exprs[call].typeArg = resolved[0]
        } else if (typeArgs.len() > 0) {
            error(loc, what + " has no type arguments")
            checkIgnored(args)
            ret errorType()
        }

        i32 whole = intType(64, true)
        i32 address = addrType()
        i32 element = tree.exprs[call].typeArg
        i32 result = voidType()
        Function signature
        signature.file = curFile
        signature.name = callee
        signature.line = loc.line
        signature.column = loc.column
        switch (kind) {
            case Panic {
                addParam(ref signature, ParamMode.Read, "reason", types.structType(stringDecl))
            }
            case Alloc {
                addParam(ref signature, ParamMode.Read, "bytes", whole)
                result = address
            }
            case Resize, Offset {
                addParam(ref signature, ParamMode.Read, "p", address)
                addParam(ref signature, ParamMode.Read, "bytes", whole)
                result = address
            }
            case Free, Destroy {
                addParam(ref signature, ParamMode.Read, "p", address)
            }
            case SizeOf, ArgumentCount {
                result = whole
            }
            case Take, CopyAt {
                addParam(ref signature, ParamMode.Read, "p", address)
                result = element
            }
            case Put {
                addParam(ref signature, ParamMode.Read, "p", address)
                addParam(ref signature, ParamMode.Move, "value", element)
            }
            case CopyMemory {
                addParam(ref signature, ParamMode.Read, "dest", address)
                addParam(ref signature, ParamMode.Read, "source", address)
                addParam(ref signature, ParamMode.Read, "bytes", whole)
            }
            case CompareMemory {
                addParam(ref signature, ParamMode.Read, "a", address)
                addParam(ref signature, ParamMode.Read, "b", address)
                addParam(ref signature, ParamMode.Read, "bytes", whole)
                result = intType(32, true)
            }
            case CheckIndex {
                addParam(ref signature, ParamMode.Read, "index", whole)
                addParam(ref signature, ParamMode.Read, "length", whole)
            }
            case ArgumentLength {
                addParam(ref signature, ParamMode.Read, "index", whole)
                result = whole
            }
            case ArgumentData, Environment {
                addParam(ref signature, ParamMode.Read, "index", whole)
                result = address
            }
            case DecimalToFloat {
                addParam(ref signature, ParamMode.Read, "data", address)
                addParam(ref signature, ParamMode.Read, "length", whole)
                addParam(ref signature, ParamMode.Read, "bits", whole)
                result = floatType(64)
            }
            case SquareRoot {  // for std.math (D556)
                addParam(ref signature, ParamMode.Read, "x", floatType(64))
                result = floatType(64)
            }
            case HashBytes {
                addParam(ref signature, ParamMode.Read, "data", address)
                addParam(ref signature, ParamMode.Read, "length", whole)
                result = intType(64, false)
            }
            case SystemCall {  // Linux only (D202): the number, then six arguments
                for (string paramName in ["number", "a", "b", "c", "d", "e", "f"]) {
                    addParam(ref signature, ParamMode.Read, paramName, whole)
                }
                result = whole
            }
            case ThreadStart, TaskStart {  // D214, D269
                list<i32> none
                list<ParamMode> modes
                addParam(ref signature, ParamMode.Read, "body", types.functionType(none, modes, voidType()))
                result = address
            }
            case GroupStart {  // D273: the group owns the lambda from here on
                list<i32> none
                list<ParamMode> modes
                addParam(ref signature, ParamMode.Read, "group", address)
                addParam(ref signature, ParamMode.Move, "body", types.functionType(none, modes, voidType()))
            }
            case ThreadWait {
                addParam(ref signature, ParamMode.Read, "thread", address)
                result = boolType()
            }
            case ThreadRethrow {  // D217: whatever the thread threw
                addParam(ref signature, ParamMode.Read, "thread", address)
                noteThrow(-1, loc)
            }
            case ThreadUncaught, ThreadFree, MutexLock, MutexUnlock {
                addParam(ref signature, ParamMode.Read, "address", address)
            }
            case EqualAt {  // the key in a slot of a map, compared where it is (D198)
                addParam(ref signature, ParamMode.Read, "place", address)
                addParam(ref signature, ParamMode.Read, "value", element)
                result = boolType()
            }
            case SelfAddress {  // D216: the object of the method, written by other threads too
                if (tree.functions[current].owner < 0) {
                    error(loc, "selfAddress() is used in a method")
                    ret errorType()
                }
                result = address
            }
            case ExitProcess {
                addParam(ref signature, ParamMode.Read, "code", intType(32, true))
            }
            case AtomicLoad, AtomicLoadRelaxed {  // D328, D503
                addParam(ref signature, ParamMode.Read, "place", address)
                result = element
            }
            case AtomicStore, AtomicStoreRelaxed {
                addParam(ref signature, ParamMode.Read, "place", address)
                addParam(ref signature, ParamMode.Read, "value", element)
            }
            case AtomicAdd, AtomicAddRelaxed, AtomicExchange {  // they return the value before
                addParam(ref signature, ParamMode.Read, "place", address)
                addParam(ref signature, ParamMode.Read, "value", element)
                result = element
            }
            case AtomicCompareExchange {
                addParam(ref signature, ParamMode.Read, "place", address)
                addParam(ref signature, ParamMode.Read, "expected", element)
                addParam(ref signature, ParamMode.Read, "desired", element)
                result = boolType()
            }
            default {
            }
        }
        if (atomic && !types.isParam(element) && !types.isInt(element) && !types.isBool(element)) {
            error(loc, what + " takes an integer or a bool, not " + name(element) + "")
            checkIgnored(args)
            ret errorType()
        }

        if (kind == Intrinsic.CopyAt && !types.isParam(element)) {  // D85: checked for each type
            if (!canCopy(element)) {
                error(loc, "values of type " + name(element) + " cannot be copied: it has a destructor, or a field that cannot be " +
                    "copied, and no copy()")
                checkIgnored(args)
                ret errorType()
            }
            if (types.isStruct(element)) {
                copyFunction(types.decl(element), loc)
            }
        }
        if (kind == Intrinsic.EqualAt && types.isStruct(element)) {  // the equals() of Key (D198)
            i32 decl = types.decl(element)
            if (!tree.records[decl].methods.contains("equals")) {
                error(loc, name(element) + " has no method equals()")
                checkIgnored(args)
                ret errorType()
            }
            i32 equals = tree.records[decl].methods["equals"]
            use(equals, loc)
            noteCall(equals, loc)
        }

        if (kind == Intrinsic.SystemCall) {  // an argument is an integer or an address (D202)
            bool ok = args.len() == signature.params.len()
            if (!ok) {
                error(loc, "'systemCall' takes 7 arguments: the number of the call and 6 values")
            }
            for (i32 arg in args) {
                i32 type = checkExpr(arg, whole)
                if (types.isError(type) || type == addrType()) {
                    continue
                }
                ok = coerce(arg, whole, false) && ok
            }
            ret ok ? result : errorType()
        }
        signature.resolvedReturn = result
        tree.functions.add(move signature)
        if (!checkArgs(args, i32(tree.functions.len() - 1), what, loc, call, -1, errorType())) {
            ret errorType()
        }
        ret result
    }

    // True for an expression made only of literals without a type yet (D55),
    // for example `5`, `-1.5` or `2 * 3`. A character literal already is a u8.
    bool isUntypedLiteral(i32 expr) const {
        switch (tree.exprs[expr].kind) {
            case IntLiteral {
                ret !tree.exprs[expr].flag
            }
            case FloatLiteral {
                ret true
            }
            case Unary {
                i32 operand = tree.exprs[expr].left
                if (tree.exprs[expr].unary == UnaryOp.Not) {
                    ret tree.exprs[operand].kind != ExprKind.FloatLiteral && isUntypedLiteral(operand)
                }
                ret isUntypedLiteral(operand)
            }
            case Binary {  // a shift takes the type of what it shifts (D195)
                BinaryOp op = tree.exprs[expr].binary
                if (op == BinaryOp.Shl || op == BinaryOp.Shr) {
                    ret isUntypedLiteral(tree.exprs[expr].left)
                }
                ret isArithmetic(op) && isUntypedLiteral(tree.exprs[expr].left) && isUntypedLiteral(tree.exprs[expr].right)
            }
            case Conditional {  // `c ? 1 : 0` takes the type around it, as a literal (D422)
                ret isUntypedLiteral(tree.exprs[expr].right) && isUntypedLiteral(tree.exprs[expr].other)
            }
            default {
                ret false
            }
        }
    }

    // `c ? a : b` (D422): a bool, and two branches of the same type, the one of the
    // context or of the branch that is not a literal. A branch that owns resources
    // gives a new value, without `move` (P28).
    i32 checkConditional(i32 node, i32 expected) {
        Loc loc = locOf(node)
        i32 whenTrue = tree.exprs[node].right
        i32 whenFalse = tree.exprs[node].other
        checkCondition(tree.exprs[node].left)
        for (i32 branch in [whenTrue, whenFalse]) {
            if (tree.exprs[branch].kind == ExprKind.Move) {
                error(locOf(branch), "'move' is not written in a branch of '?' for now: the moves are followed along the statements")
                ret errorType()
            }
        }
        i32 type = errorType()
        bool trueLiteral = isUntypedLiteral(whenTrue)
        bool falseLiteral = isUntypedLiteral(whenFalse)
        if (expected >= 0 && !types.isError(expected)) {
            bool ok = coerce(whenTrue, expected, false)
            ok = coerce(whenFalse, expected, false) && ok
            if (!ok) {
                ret errorType()
            }
            type = expected
        } else if (trueLiteral && falseLiteral) {
            error(loc, "the type of this expression cannot be deduced: write the type of one of the values, for example i32(5)")
            ret errorType()
        } else if (trueLiteral || falseLiteral) {
            i32 typed = trueLiteral ? whenFalse : whenTrue
            i32 literal = trueLiteral ? whenTrue : whenFalse
            type = checkExpr(typed, -1)
            if (types.isError(type) || !coerce(literal, type, false)) {
                ret errorType()
            }
        } else {
            i32 first = checkExpr(whenTrue, -1)
            i32 second = checkExpr(whenFalse, -1)
            if (types.isError(first) || types.isError(second)) {
                ret errorType()
            }
            if (first == second) {
                type = first
            } else if (types.convertsLosslessly(first, second)) {
                coerce(whenTrue, second, false)
                type = second
            } else if (types.convertsLosslessly(second, first)) {
                coerce(whenFalse, first, false)
                type = first
            } else {
                error(loc, "the two values of '?' have different types, " + name(first) + " and " + name(second) + "")
                ret errorType()
            }
        }
        if (types.isInterface(type) || types.isFunction(type)) {
            error(loc, "a '?' with values of " + name(type) + " is not possible yet: write an if")
            ret errorType()
        }
        if (!copyIfNeeded(whenTrue, type) || !copyIfNeeded(whenFalse, type)) {
            ret errorType()
        }
        ret type
    }

    // Finds the common type of the two operands, giving literals the type of the
    // other side (D55) and widening without loss (D33, D56).
    i32 unify(i32 binary, i32 hint) {
        Loc loc = locOf(binary)
        i32 lhs = tree.exprs[binary].left
        i32 rhs = tree.exprs[binary].right
        bool leftLiteral = isUntypedLiteral(lhs)
        bool rightLiteral = isUntypedLiteral(rhs)
        if (leftLiteral && rightLiteral) {
            if (hint < 0) {
                error(loc, "the type of this expression cannot be deduced: write the type of one of the values, for example i32(5)")
                ret errorType()
            }
            bool ok = coerce(lhs, hint, false)
            ok = coerce(rhs, hint, false) && ok
            ret ok ? hint : errorType()
        }
        if (leftLiteral || rightLiteral) {
            i32 typed = leftLiteral ? rhs : lhs
            i32 literal = leftLiteral ? lhs : rhs
            i32 type = checkExpr(typed, hint)
            if (types.isError(type)) {
                ret type
            }
            if (types.isVector(type)) {
                ret splatInto(literal, type) ? type : errorType()  // `v * 2` (D505)
            }
            if (!types.isNumeric(type)) {
                error(locOf(literal), "a number cannot be combined with a value of type " + name(type))
                ret errorType()
            }
            ret coerce(literal, type, false) ? type : errorType()
        }

        i32 left = checkExpr(lhs, hint)
        i32 right = checkExpr(rhs, hint)
        if (types.isError(left) || types.isError(right)) {
            ret errorType()
        }
        if (left == right) {
            ret left
        }
        if (types.isVector(left) && types.isNumeric(right)) {
            ret splatInto(rhs, left) ? left : errorType()  // D505
        }
        if (types.isVector(right) && types.isNumeric(left)) {
            ret splatInto(lhs, right) ? right : errorType()
        }
        if (types.convertsLosslessly(left, right)) {
            coerce(lhs, right, false)
            ret right
        }
        if (types.convertsLosslessly(right, left)) {
            coerce(rhs, left, false)
            ret left
        }
        if (types.isInt(left) && types.isInt(right) && types.items[left].isSigned != types.items[right].isSigned) {
            error(loc, "cannot mix " + name(left) + " and " + name(right) + ": convert one of them explicitly, for example i64(x)")
        } else {
            error(loc, "mismatched types " + name(left) + " and " + name(right) + ": convert one of them explicitly")
        }
        ret errorType()
    }

    bool capturedWithRef(i32 lambda, i32 place) const {
        i32 variable = tree.exprs[place].variable
        for (i64 c = 0; c < tree.exprs[lambda].captures.len(); c++) {
            if (tree.exprs[lambda].captures[c].outer == variable) {
                ret tree.exprs[lambda].captures[c].mode == ParamMode.Ref
            }
        }
        ret false
    }

    // The declaration that describes the parameters of a function type, for the
    // checks of the arguments and for the code (D186). Its calls can always throw.
    i32 signatureOf(i32 type) {
        if (typeSignatures.contains(type)) {
            ret typeSignatures[type]
        }
        Function decl
        decl.name = name(type)
        decl.isLambda = true
        decl.canThrow = true
        decl.resolvedReturn = types.items[type].result
        for (i64 i = 0; i < types.items[type].params.len(); i++) {
            addParam(ref decl, types.items[type].modes[i], format("{}", i + 1), types.items[type].params[i])
        }
        tree.functions.add(move decl)
        i32 index = i32(tree.functions.len() - 1)
        tree.signatures.add(index)
        typeSignatures[type] = index
        ret index
    }

    // `less(a, b)`: the call of a function value (D186).
    i32 checkCallValue(i32 expr) {
        Loc loc = locOf(expr)
        list<i32> args = tree.exprs[expr].items
        i32 type = checkExpr(tree.exprs[expr].left, -1)
        if (types.isError(type)) {
            checkIgnored(args)
            ret errorType()
        }
        if (!types.isFunction(type)) {
            error(loc, withArticle(name(type)) + " is not a function")
            checkIgnored(args)
            ret errorType()
        }
        i32 signature = signatureOf(type)
        tree.exprs[expr].target = signature
        noteThrow(-1, loc)  // the function is not known: it may throw (D36)
        if (!checkArgs(args, signature, "this function", loc, expr, -1, errorType())) {
            ret errorType()
        }
        ret types.items[type].result
    }

    // A function received as a read parameter can be a lambda that modifies what it
    // captures, unless it is `const func`; a function value never does (D184, D253).
    bool mayModifyCaptures(i32 variable) const {
        i32 root = variable
        for (tree.variables[root].kind == VariableKind.Captured && tree.variables[root].captured >= 0) {
            root = tree.variables[root].captured
        }
        ret types.isFunction(tree.variables[root].type) && tree.variables[root].kind == VariableKind.ReadParam &&
            !tree.variables[root].isConst
    }

    // The argument of a `const func` parameter, which several threads can call at
    // once: it does not modify what it captures (D253).
    void checkConstFunction(i32 arg) {
        if (tree.exprs[arg].kind == ExprKind.Lambda) {
            for (i64 c = 0; c < tree.exprs[arg].captures.len(); c++) {
                string captureName = tree.exprs[arg].captures[c].name
                Loc loc = at(curFile, tree.exprs[arg].captures[c].line, tree.exprs[arg].captures[c].column)
                i32 outer = tree.exprs[arg].captures[c].outer
                if (tree.exprs[arg].captures[c].mode == ParamMode.Ref) {
                    error(loc, "a const func does not modify what it captures: it cannot capture '" + captureName + "' with 'ref'")
                } else if (outer >= 0 && mayModifyCaptures(outer)) {
                    error(loc, "'" + captureName + "' is a parameter func that is not const: a const func cannot call it")
                }
            }
        } else if (tree.exprs[arg].kind == ExprKind.Name) {
            i32 variable = tree.exprs[arg].variable
            if (variable >= 0 && mayModifyCaptures(variable)) {
                error(locOf(arg), "'" + tree.variables[variable].name + "' is a parameter func that is not const: only a 'const " +
                    "func' can be given to a 'const func'")
            }
        }
    }

    // The parameters of the function being checked, as its first variables.
    void declareArguments(i32 function) {
        for (i64 i = 0; i < tree.functions[function].params.len(); i++) {
            ParamMode mode = tree.functions[function].params[i].mode
            i32 variable = declare(tree.functions[function].params[i].name.copy(), tree.functions[function].paramTypes[i],
                paramLoc(function, i), tree.functions[function].params[i].isConst)
            if (variable < 0) {
                continue
            }
            tree.variables[variable].kind = mode == ParamMode.Ref ? VariableKind.RefParam : mode == ParamMode.Move ?
                VariableKind.MoveParam : VariableKind.ReadParam
        }
    }

    // `[limit, ref total](i32 x) bool { ... }` (D183, D184). `asArgument`: it is
    // the argument of a read parameter, the only place for one that borrows.
    i32 checkLambda(i32 lambda, bool asArgument) {
        i32 function = tree.exprs[lambda].function
        bool forThread = tree.exprs[lambda].forThread
        i32 group = tree.exprs[lambda].group
        tree.exprs[lambda].enclosing = current
        map<string, bool> seen
        for (i64 c = 0; c < tree.exprs[lambda].captures.len(); c++) {
            string captureName = tree.exprs[lambda].captures[c].name
            ParamMode mode = tree.exprs[lambda].captures[c].mode
            Loc loc = at(curFile, tree.exprs[lambda].captures[c].line, tree.exprs[lambda].captures[c].column)
            if (seen.contains(captureName)) {
                error(loc, "'" + captureName + "' is already captured")
                continue
            }
            seen[captureName] = true
            i32 outer = lookup(captureName)
            if (outer < 0) {
                if (ownFieldIndex(captureName) >= 0) {
                    error(loc, "'" + captureName + "' is a field: copy it into a variable to capture it")
                } else {
                    error(loc, "unknown name '" + captureName + "'")
                }
                continue
            }
            tree.exprs[lambda].captures[c].outer = outer
            if (forThread && mayModifyCaptures(outer)) {
                error(loc, "'" + captureName + "' is a parameter func that is not const: a thread or a task cannot call it, as it " +
                    "may modify what it captures; declare it 'const func'")
            }
            if (group >= 0 && mode == ParamMode.Ref) {
                error(loc, "the tasks of a group run at the same time: they cannot capture '" + captureName +
                    "' with 'ref'; read it, or take it with 'move'")
            }
            checkNotBlockThread(outer, loc)
            checkNotUsedByThread(outer, loc)
            i32 outerType = tree.variables[outer].type
            Expr shown = nodeAt(ExprKind.Name, loc.line, loc.column)
            shown.text = captureName
            shown.variable = outer
            shown.resolved = outerType
            tree.exprs.add(move shown)
            i32 place = i32(tree.exprs.len() - 1)
            bool byAddress = false
            if (mode == ParamMode.Ref) {
                string reason = readOnlyReason(place)
                if (reason.len() > 0) {
                    error(loc, "cannot capture '" + captureName + "' with 'ref': " + reason)
                }
                byAddress = true
            } else if (mode == ParamMode.Move) {
                bool owned = tree.variables[outer].kind == VariableKind.Local || tree.variables[outer].kind == VariableKind.MoveParam
                if (needsDestruction(tree, types, outerType) && !owned) {
                    error(loc, "cannot capture '" + captureName + "' with 'move': only a local variable or a 'move' parameter can " +
                        "give its value")
                }
                if (needsDestruction(tree, types, outerType) && owned) {
                    tree.variables[outer].needsDropFlag = true
                }
            } else {
                byAddress = needsDestruction(tree, types, outerType)  // read without a copy
            }
            tree.exprs[lambda].captures[c].byAddress = byAddress
            if (byAddress) {
                tree.exprs[lambda].borrows = true
                tree.exprs[lambda].capturePlaces.add(place)
            }
        }

        // The body is a function of its own: its parameters, then the captures.
        i32 outerFunction = current
        list<bool> outerLoops = move loops
        list<TryContext> outerTries = move tryContexts
        list<i32> outerCatches = move catchTypes
        list<i64> outerFinallyLoops = move finallyLoops
        list<Region> outerRegions = move regions
        hiddenScopes.add(move locals)

        // A counter of its own: a lambda inside another is checked before the outer one is listed.
        tree.functions[function].symbol = symbolFor(tree.functions[function].file, format("lambda.{}", nextLambda))
        nextLambda++
        tree.functions[function].isAbstract = tree.functions[outerFunction].isAbstract
        resolveSignature(function)
        current = function
        list<map<string, i32>> fresh
        map<string, i32> first
        fresh.add(move first)
        locals = move fresh
        list<bool> noLoops
        loops = move noLoops
        list<TryContext> noTries
        tryContexts = move noTries
        list<i32> noCatches
        catchTypes = move noCatches
        list<i64> noFinally
        finallyLoops = move noFinally
        list<Region> noRegions
        regions = move noRegions
        declareArguments(function)
        for (i64 c = 0; c < tree.exprs[lambda].captures.len(); c++) {
            i32 outer = tree.exprs[lambda].captures[c].outer
            if (outer < 0) {
                continue
            }
            ParamMode mode = tree.exprs[lambda].captures[c].mode
            // The lambda of a thread runs once: what it takes with `move` is its own to modify.
            bool writable = mode == ParamMode.Ref || (mode == ParamMode.Move && forThread)
            i32 inner = declare(tree.exprs[lambda].captures[c].name.copy(), tree.variables[outer].type, at(curFile,
                tree.exprs[lambda].captures[c].line, tree.exprs[lambda].captures[c].column), !writable)
            if (inner < 0) {
                continue
            }
            tree.variables[inner].kind = VariableKind.Captured
            tree.variables[inner].captureByAddress = tree.exprs[lambda].captures[c].byAddress
            tree.variables[inner].captured = outer
            tree.exprs[lambda].captures[c].inner = inner
        }
        i32 body = tree.functions[function].body
        Flow flow = checkBlock(body)
        tree.functions[function].bodyChecked = true
        i32 result = tree.functions[function].resolvedReturn
        if (!types.isVoid(result) && !types.isError(result) && flow != Flow.Returns) {
            error(at(curFile, tree.blocks[body].closeLine, tree.blocks[body].closeColumn),
                "the lambda must end with 'ret' on every path: it returns " + name(result))
        }

        locals = hiddenScopes.remove(hiddenScopes.len() - 1)
        current = outerFunction
        loops = move outerLoops
        tryContexts = move outerTries
        catchTypes = move outerCatches
        finallyLoops = move outerFinallyLoops
        regions = move outerRegions

        tree.lambdas.add(lambda)
        // Given to a thread, only the data of a lambda that captures by address stay
        // in the frame; the others go with the thread, on the heap (D215). Each task
        // of a group has its own, on the heap, with the addresses of what it reads (D273).
        bool borrows = tree.exprs[lambda].borrows
        tree.exprs[lambda].onStack = group >= 0 ? false : forThread ? borrows : asArgument
        if (group >= 0) {
            groupReads(lambda)
        }
        if (borrows && !asArgument) {
            error(locOf(lambda), "this lambda captures by address (with 'ref', or reading a value that is not simple): it can only " +
                "be passed as an argument; capture with 'move' to keep it")
            ret errorType()
        }
        list<ParamMode> modes
        for (i64 i = 0; i < tree.functions[function].params.len(); i++) {
            modes.add(tree.functions[function].params[i].mode)
        }
        list<i32> paramTypes = tree.functions[function].paramTypes
        ret types.functionType(paramTypes, modes, result)
    }

    // The object of a method written without it: a variable, or a field of the
    // object of the method being checked. A new node, and its index.
    i32 objectNamed(string name, Loc loc) {
        if (lookup(name) >= 0) {
            Expr object = nodeAt(ExprKind.Name, loc.line, loc.column)
            object.text = name
            tree.exprs.add(move object)
            ret i32(tree.exprs.len() - 1)
        }
        Expr own = nodeAt(ExprKind.Self, loc.line, loc.column)
        tree.exprs.add(move own)
        Expr field = nodeAt(ExprKind.Field, loc.line, loc.column)
        field.left = i32(tree.exprs.len() - 1)
        field.text = name
        tree.exprs.add(move field)
        ret i32(tree.exprs.len() - 1)
    }

    i32 checkCall(i32 expr, i32 expected) {
        Loc loc = locOf(expr)
        string callee = tree.exprs[expr].text
        string module = tree.exprs[expr].module
        list<i32> args = tree.exprs[expr].items
        list<i32> typeArgs = tree.exprs[expr].typeArgs
        bool typed = typeArgs.len() > 0
        bool qualified = module.len() > 0  // `geometry.area(c)` (D126)
        if (qualified && typed && (lookup(module) >= 0 || ownFieldIndex(module) >= 0)) {
            // `values.map<string>(f)`: a generic method of a variable or of a field (D92).
            Expr method = nodeAt(ExprKind.MethodCall, loc.line, loc.column)
            method.left = objectNamed(module, loc)
            method.text = callee
            method.typeArgs = typeArgs
            method.items = args
            tree.exprs[expr] = move method
            ret checkMethodCall(expr)
        }

        if (!typed && !qualified) {
            i32 target = types.findBuiltin(callee)
            if (target >= 0) {
                ret checkConversion(expr, target)
            }
            if (callee == "addr" && findDecl(structsTable, callee, loc, "") < 0) {  // P13
                if (isUnsafe(curFile)) {
                    ret checkConversion(expr, addrType())
                }
                error(loc, "'addr' belongs to the unsafe dialect: the module must write 'import unsafe'")
                ret errorType()
            }
            if (isPrintFunction(callee)) {
                ret checkPrint(expr)
            }
            if (callee == "panic") {
                ret checkIntrinsic(expr, Intrinsic.Panic)
            }
            if (callee == "assert") {
                ret checkAssert(expr)
            }
            if (callee == "wrapAdd" || callee == "wrapSub" || callee == "wrapMul") {
                ret checkWrap(expr)
            }
            Intrinsic bits = bitFunction(callee)
            if (bits != Intrinsic.None) {
                ret checkBitFunction(expr, bits, expected)
            }
            if (callee == "fma") {
                ret checkFma(expr, expected)
            }
            if (callee == "embed") {
                ret checkEmbed(expr)
            }
        }
        if (!qualified && isUnsafe(curFile)) {
            Intrinsic intrinsic = intrinsicOf(callee)
            if (intrinsic == Intrinsic.VariableAddress) {
                ret checkVariableAddress(expr)
            }
            if (intrinsic != Intrinsic.None) {
                ret checkIntrinsic(expr, intrinsic)
            }
        }

        if (!typed && !qualified) {
            i32 variable = lookup(callee)
            i32 field = ownFieldIndex(callee)
            bool fieldValue = variable < 0 && field >= 0 &&
                types.isFunction(tree.records[tree.functions[current].owner].fields[field].resolved)
            if ((variable >= 0 && types.isFunction(tree.variables[variable].type)) || fieldValue) {
                Expr value = nodeAt(ExprKind.CallValue, loc.line, loc.column)
                value.left = objectNamed(callee, loc)
                value.items = args
                tree.exprs[expr] = move value
                ret checkCallValue(expr)
            }
        }

        i32 decl = findDecl(structsTable, callee, loc, module)
        if (decl >= 0) {
            string declName = tree.records[decl].name
            if (tree.records[decl].typeParams.len() > 0 && !typed) {
                error(loc, declName + " is generic: write its type arguments, " + declName + "<...>(...)")
                checkIgnored(args)
                ret errorType()
            }
            if (typed) {
                TypeNode node
                node.name = callee
                node.module = module
                node.line = loc.line
                node.column = loc.column
                node.args = typeArgs
                tree.types.add(move node)
                i32 type = resolveType(i32(tree.types.len() - 1), curFile)
                if (type < 0) {
                    checkIgnored(args)
                    ret errorType()
                }
                decl = types.decl(type)
            }
            if (tree.records[decl].isEnum && args.len() == 1) {
                ret checkEnumConversion(expr, decl)
            }
            if (decl == stringDecl && args.len() == 1) {
                ret checkLibraryCall(expr, "stringFromBytes")  // D200
            }
            if (decl == stringDecl && args.len() == 2 && isUnsafe(curFile)) {  // the bytes of C (D204)
                ret checkLibraryCall(expr, "stringFromMemory")
            }
            ret checkConstruct(expr, decl)
        }

        // D72: inside a method, a call refers first to a method of the same struct.
        i32 owner = tree.functions[current].owner
        if (owner >= 0 && !typed && !qualified && tree.records[owner].methods.contains(callee)) {
            Expr own = nodeAt(ExprKind.Self, loc.line, loc.column)
            tree.exprs.add(move own)
            Expr methodCall = nodeAt(ExprKind.MethodCall, loc.line, loc.column)
            methodCall.left = i32(tree.exprs.len() - 1)
            methodCall.text = callee
            methodCall.items = args
            tree.exprs[expr] = move methodCall
            ret checkMethodCall(expr)
        }

        i32 function = findDecl(functionsTable, callee, loc, module)
        if (function < 0) {
            string where = privateIn(callee, curFile, module)
            if (!qualified && (lookup(callee) >= 0 || ownFieldIndex(callee) >= 0)) {
                error(loc, "'" + callee + "' is a variable, not a function")
            } else if (typed && !qualified && (types.findBuiltin(callee) >= 0 || isPrintFunction(callee))) {
                error(loc, "'" + callee + "' has no type arguments")
            } else if (where.len() > 0) {
                reportPrivate(loc, "'" + callee + "' of " + where)
            } else if (!qualified && intrinsicOf(callee) != Intrinsic.None) {
                error(loc, "'" + callee + "' belongs to the unsafe dialect: the module must write 'import unsafe'")
            } else if (qualified) {
                error(loc, "the module " + module + " has no function '" + callee + "'")
            } else {
                error(loc, "unknown function '" + callee + "'")
            }
            checkIgnored(args)
            ret errorType()
        }

        if (tree.functions[function].typeParams.len() > 0) {
            function = instanceFor(function, typeArgs, args, loc)
        } else if (typed) {
            error(loc, "'" + callee + "' is not generic: it has no type arguments")
            function = -1
        }
        if (function < 0) {
            checkIgnored(args)
            ret errorType()
        }
        tree.exprs[expr].target = function
        noteCall(function, loc)
        if (!checkArgs(args, function, "'" + callee + "'", loc, expr, -1, errorType())) {
            ret errorType()
        }
        ret tree.functions[function].resolvedReturn
    }

    // A function of the standard library that the programs do not see: the
    // compiler calls it for them, as `string(bytes)` (D200).
    i32 libraryFunction(string name) {
        ret findDecl(functionsTable, name, at(libraryFile, 0, 0), "")
    }

    i32 checkLibraryCall(i32 expr, string name) {
        Loc loc = locOf(expr)
        i32 function = libraryFunction(name)
        tree.exprs[expr].target = function
        noteCall(function, loc)
        if (!checkArgs(tree.exprs[expr].items.copy(), function, "'" + tree.exprs[expr].text + "'", loc, expr, -1, errorType())) {
            ret errorType()
        }
        ret tree.functions[function].resolvedReturn
    }

    // `i32("42")` (D199): a function of the library reads the text, with the range
    // of the type, and throws when it is not a number of the type. The call takes
    // the place of `expr`.
    i32 numberFromText(i32 expr, i32 text, i32 target) {
        Loc loc = locOf(expr)
        i32 bits = types.items[target].bits
        bool isSigned = types.items[target].isSigned
        bool isFloat = types.isFloat(target)
        u64 one = 1
        string callee = isFloat ? "parseFloat" : isSigned ? "parseSigned" : "parseUnsigned"
        Expr limit = nodeAt(ExprKind.IntLiteral, loc.line, loc.column)
        limit.value = isFloat ? u64(bits) : isSigned ? (one << u64(bits - 1)) - 1 : bits == 64 ? 0xFFFFFFFFFFFFFFFF :
            (one << u64(bits)) - 1
        limit.resolved = isFloat || isSigned ? intType(64, true) : intType(64, false)
        tree.exprs.add(move limit)
        i32 limitIndex = i32(tree.exprs.len() - 1)
        Expr written = nodeAt(ExprKind.StringLiteral, loc.line, loc.column)
        written.text = name(target)
        written.resolved = types.structType(stringDecl)
        tree.exprs.add(move written)
        i32 function = libraryFunction(callee)
        Expr call = nodeAt(ExprKind.Call, loc.line, loc.column)
        call.text = callee
        call.items.add(text)
        call.items.add(limitIndex)
        call.items.add(i32(tree.exprs.len() - 1))
        call.target = function
        call.resolved = tree.functions[function].resolvedReturn
        bool same = call.resolved == target
        tree.exprs[expr] = move call
        noteCall(function, loc)
        if (!same) {  // always in the range: the library has checked it
            wrap(expr, ExprKind.Conversion, target)
            tree.exprs[expr].isExplicit = true
        }
        ret target
    }

    // The arguments of a call that cannot be checked against a function: only
    // their own errors are reported.
    void checkIgnored(list<i32> args) {
        for (i32 arg in args) {
            ExprKind kind = tree.exprs[arg].kind
            checkExpr(kind == ExprKind.Ref || kind == ExprKind.Move ? tree.exprs[arg].left : arg, -1)
        }
    }

    // The instance of a generic function for a call, with the type arguments
    // written or deduced from the arguments (D86).
    i32 instanceFor(i32 generic, list<i32> typeArgs, list<i32> args, Loc loc) {
        list<i32> resolved
        if (typeArgs.len() > 0) {
            if (!resolveTypeArgs(typeArgs, curFile, tree.functions[generic].typeParams.len(), "'" + tree.functions[generic].name + "'",
                loc, ref resolved)) {
                ret -1
            }
            ret instantiateFunction(generic, resolved, loc)
        }
        if (failed.contains(format("f{}", generic)) || !deduceTypeArgs(generic, args, loc, ref resolved)) {
            ret -1
        }
        ret instantiateFunction(generic, resolved, loc)
    }

    // The type arguments of a call of a generic, from its arguments (D86).
    bool deduceTypeArgs(i32 generic, list<i32> callArgs, Loc loc, ref list<i32> out) {
        string genericName = tree.functions[generic].name
        string what = "'" + genericName + "'"
        i64 expected = tree.functions[generic].params.len()
        if (callArgs.len() != expected) {
            error(loc, format("{} takes {}{}{} were given", what, expected, expected == 1 ? " argument, but " : " arguments, but ",
                callArgs.len()))
            ret false
        }
        list<i32> deduced
        for (i64 i = 0; i < tree.functions[generic].typeParams.len(); i++) {
            deduced.add(-1)
        }
        for (i64 i = 0; i < callArgs.len(); i++) {
            i32 type = argumentType(callArgs[i])
            if (type >= 0 && !deduce(tree.functions[generic].params[i].type, 0, type, generic, ref deduced, locOf(callArgs[i]))) {
                ret false
            }
        }
        for (i64 i = 0; i < deduced.len(); i++) {
            if (deduced[i] < 0) {
                error(loc, "cannot deduce " + tree.functions[generic].typeParams[i].name + " in this call of " + what +
                    ": write the type arguments, " + genericName + "<...>(...)")
                ret false
            }
            out.add(deduced[i])
        }
        ret true
    }

    // The type of an argument, checked on a copy without reporting errors: it
    // serves only to deduce the type arguments (D86), and -1 says that it does not
    // help. A lambda is not checked; the lambdas inside the copy are taken back, with
    // what their bodies noted and the escapes the check of the argument will note again.
    i32 argumentType(i32 arg) {
        ExprKind kind = tree.exprs[arg].kind
        i32 value = kind == ExprKind.Ref || kind == ExprKind.Move ? tree.exprs[arg].left : arg
        if (tree.exprs[value].kind == ExprKind.Lambda) {
            ret -1
        }
        i32 copy = cloneExpr(value)
        i64 lambdas = tree.lambdas.len()
        i64 noted = escapes.len()
        bool muted = diag.muted
        diag.muted = true
        i32 type = checkExpr(copy, -1)
        diag.muted = muted
        for (tree.lambdas.len() > lambdas) {
            i32 function = tree.exprs[tree.lambdas[tree.lambdas.len() - 1]].function
            if (throwInfo.contains(function)) {
                throwInfo.remove(function)
            }
            tree.lambdas.remove(tree.lambdas.len() - 1)
        }
        for (escapes.len() > noted) {
            escapes.remove(escapes.len() - 1)
        }
        if (types.isError(type) || types.isUntyped(type) || types.isVoid(type)) {
            ret -1
        }
        ret type
    }

    // Matches the type of a parameter, as written, with the type of its argument;
    // `dimension` is how many of its dimensions are already matched.
    bool deduce(i32 pattern, i64 dimension, i32 actual, i32 generic, ref list<i32> deduced, Loc loc) {
        i32 found = actual
        if (dimension < tree.types[pattern].dimensions.len()) {  // `T[3]` takes the elements of an i32[3] (D196)
            for (i64 d = dimension; d < tree.types[pattern].dimensions.len(); d++) {
                if (!types.isArray(found) || types.items[found].count != tree.types[pattern].dimensions[d]) {
                    ret true  // reported by the check of the argument
                }
                found = types.element(found)
            }
        }
        string written = tree.types[pattern].name
        list<i32> args = tree.types[pattern].args
        for (i64 i = 0; i < tree.functions[generic].typeParams.len(); i++) {
            string paramName = tree.functions[generic].typeParams[i].name
            if (paramName != written || args.len() > 0) {
                continue
            }
            if (deduced[i] < 0) {
                deduced[i] = found
                ret true
            }
            if (deduced[i] == found) {
                ret true
            }
            error(loc, paramName + " is " + name(deduced[i]) + " for a previous argument, but " + name(found) +
                " here: write the type arguments, " + tree.functions[generic].name + "<...>(...)")
            ret false
        }
        if (args.len() > 0 && types.isStruct(found) && tree.records[types.decl(found)].generic >= 0 &&
            tree.records[tree.records[types.decl(found)].generic].name == written) {
            list<i32> typeArgs = tree.records[types.decl(found)].typeArgs
            for (i64 i = 0; i < args.len() && i < typeArgs.len(); i++) {
                if (!deduce(args[i], 0, typeArgs[i], generic, ref deduced, loc)) {
                    ret false
                }
            }
        }
        ret true
    }

    // `Student("Anna")`: calls the constructor; without one, `Point()` is the default value (D71).
    i32 checkConstruct(i32 expr, i32 decl) {
        Loc loc = locOf(expr)
        list<i32> args = tree.exprs[expr].items
        string declName = tree.records[decl].name
        bool declared = threadInit == expr
        threadInit = -1
        bool thread = isThreadStruct(decl) && args.len() == 1 && tree.exprs[args[0]].kind == ExprKind.Lambda
        if (declName == "Camera" && tree.files[tree.records[decl].file].name == "std.gui") {
            tree.camera = true  // the permission CAMERA of the app (D537)
        }
        Expr node = nodeAt(ExprKind.Construct, loc.line, loc.column)
        node.decl = decl
        node.items = args
        tree.exprs[expr] = move node
        i32 constructor = tree.records[decl].constructor
        if (constructor >= 0) {
            if (!visible(tree.functions[constructor].isPublic, decl, curFile)) {
                reportPrivate(loc, "the constructor of " + declName)
                checkIgnored(args)
                ret errorType()
            }
            use(constructor, loc)
            noteCall(constructor, loc)
            threadLambda = thread  // D215: the lambda of a thread may capture by address
            bool ok = checkArgs(args, constructor, "the constructor of " + declName, loc, expr, -1, errorType())
            threadLambda = false
            if (!ok) {
                ret errorType()
            }
            if (thread && tree.exprs[args[0]].kind == ExprKind.Lambda && tree.exprs[args[0]].borrows) {
                if (!declared) {
                    error(loc, withArticle(declName == "Task" ? "task" : "thread") + " whose lambda captures by address belongs " +
                        "to its block: declare it, as thread." + declName + " t = thread." + declName + "(...)")
                    ret errorType()
                }
                tree.exprs[expr].blockThread = args[0]
            }
        } else if (args.len() > 0) {
            error(loc, declName + " has no constructor: " + declName + "() gives its default value")
            ret errorType()
        }
        ret types.structType(decl)
    }

    // The arguments of a call are taken out of it, for the node that takes its place.
    void dropArguments(i32 call) {
        list<i32> none
        tree.exprs[call].items = move none
    }

    // The node `operand` takes the place of `expr`.
    void replaceBy(i32 expr, i32 operand) {
        Expr node = tree.exprs[operand]
        tree.exprs[expr] = move node
    }

    // A conversion written in the program, in the place of `expr`.
    void makeConversion(i32 expr, i32 operand, i32 target) {
        Expr node = nodeAt(ExprKind.Conversion, tree.exprs[expr].line, tree.exprs[expr].column)
        node.left = operand
        node.resolved = target
        node.isExplicit = true
        tree.exprs[expr] = move node
    }

    // `f64(x)`: explicit conversion (D20, D61).
    i32 checkConversion(i32 expr, i32 target) {
        Loc loc = locOf(expr)
        list<i32> args = tree.exprs[expr].items
        if (args.len() != 1) {
            error(loc, "a conversion to " + name(target) + " takes exactly one value")
            ret errorType()
        }
        if (types.isVector(target)) {
            ret checkVectorConversion(expr, target)
        }
        i32 operand = args[0]
        dropArguments(expr)
        i32 type = errorType()
        bool toAddress = target == addrType()
        if (isUntypedLiteral(operand)) {
            // A literal takes the target type directly (D55); a decimal literal
            // converted to an integer first becomes an f64, and one converted to
            // an address an i64.
            type = checkExpr(operand, toAddress ? intType(64, true) : target)
            if (type == untypedFloat()) {
                type = checkExpr(operand, floatType(64))
            }
        } else {
            type = checkExpr(operand, -1)
        }
        if (types.isError(type)) {
            ret type
        }
        if (toAddress || type == addrType()) {  // P13: an address and an integer of 64 bits
            i32 number = toAddress ? type : target
            if (number != addrType() && !(types.isInt(number) && types.items[number].bits == 64)) {
                error(loc, "cannot convert " + name(type) + " to " + name(target) + ": an addr converts to i64 or u64, and back")
                ret errorType()
            }
        }
        if (types.isStruct(type) && tree.records[types.decl(type)].isEnum && withoutData(types.decl(type)) && types.isInt(target)) {
            makeConversion(expr, operand, target)  // the value of the case (D135)
            ret target
        }
        if (isString(type) && !types.isBool(target)) {
            ret numberFromText(expr, operand, target)
        }
        if (types.isUntyped(type) || types.isVoid(type) || type == literalString() || types.isStruct(type) || types.isParam(type) ||
            types.isInterface(type) || types.isArray(type) || types.isFunction(type)) {
            error(locOf(operand), "cannot convert this value to " + name(target))
            ret errorType()
        }
        if (types.isBool(type) != types.isBool(target)) {
            error(loc, "cannot convert " + name(type) + " to " + name(target) + "")
            ret errorType()
        }
        if (type == target) {
            replaceBy(expr, operand)
        } else {
            makeConversion(expr, operand, target)
        }
        ret target
    }

    // `i16x16(5)`: the number in each number of the vector; `i32x8(v)`: the numbers of a
    // vector with as many, converted one by one (D505).
    i32 checkVectorConversion(i32 expr, i32 target) {
        Loc loc = locOf(expr)
        i32 operand = tree.exprs[expr].items[0]
        dropArguments(expr)
        i32 number = types.element(target)
        i32 type = checkExpr(operand, isUntypedLiteral(operand) ? number : -1)
        if (types.isError(type)) {
            ret type
        }
        if (types.isVector(type)) {
            if (types.items[type].count != types.items[target].count) {
                error(loc, "cannot convert " + name(type) + " to " + name(target) + ": a vector converts to one with as many numbers")
                ret errorType()
            }
            if (type == target) {
                replaceBy(expr, operand)
            } else {
                makeConversion(expr, operand, target)
            }
            ret target
        }
        if (!types.isNumeric(type)) {
            error(loc, "cannot convert " + name(type) + " to " + name(target) + ": a vector takes a number")
            ret errorType()
        }
        if (type != number) {  // the number first converted as a number, explicitly
            Expr inner = nodeAt(ExprKind.Conversion, loc.line, loc.column)
            inner.left = operand
            inner.resolved = number
            inner.isExplicit = true
            tree.exprs.add(move inner)
            operand = i32(tree.exprs.len() - 1)
        }
        makeConversion(expr, operand, target)
        ret target
    }

    // `Color(n)`: the case whose value is n, or a panic if there is none (D135).
    i32 checkEnumConversion(i32 expr, i32 decl) {
        list<i32> args = tree.exprs[expr].items
        string declName = tree.records[decl].name
        if (!withoutData(decl)) {
            error(locOf(expr), declName + " has data: its values are created with " + declName + ".Case(...)")
            checkIgnored(args)
            ret errorType()
        }
        i32 operand = args[0]
        dropArguments(expr)
        i32 type = checkExpr(operand, isUntypedLiteral(operand) ? intType(32, true) : -1)
        if (types.isError(type)) {
            ret type
        }
        if (!types.isInt(type)) {
            error(locOf(operand), withArticle(declName) + " is made from an integer, not from " + name(type) + "")
            ret errorType()
        }
        i32 result = types.structType(decl)
        makeConversion(expr, operand, result)
        ret result
    }

    // ---- print / println (D21, D38) ----

    i32 checkPrint(i32 expr) {
        Loc loc = locOf(expr)
        string callee = tree.exprs[expr].text
        list<i32> args = tree.exprs[expr].items
        bool format = callee == "format"  // into a string (D200)
        if (args.len() == 0 || tree.exprs[args[0]].kind != ExprKind.StringLiteral) {
            error(loc, "the first argument of " + callee + " must be a string literal with the format")
            ret errorType()
        }
        string text = tree.exprs[args[0]].text
        Loc formatLoc = locOf(args[0])
        Expr print = nodeAt(ExprKind.Print, loc.line, loc.column)
        print.stream = format ? 3 : callee[0] == 'e' ? 2 : 1
        print.newline = callee.endsWith("ln")

        bool ok = true
        for (i64 i = 1; i < args.len(); i++) {
            i32 arg = args[i]
            if (tree.exprs[arg].kind == ExprKind.StringLiteral) {
                tree.exprs[arg].resolved = literalString()
            } else {
                i32 type = checkExpr(arg, -1)
                if (types.isUntyped(type)) {
                    // D578: a number without a type is printed as i64, or f64 with a point.
                    ok = coerce(arg, type == untypedInt() ? intType(64, true) : floatType(64), false) && ok
                } else if (types.isVoid(type)) {
                    error(locOf(arg), "this call does not return a value")
                    ok = false
                } else if (types.isError(type)) {
                    ok = false
                }
            }
            print.items.add(arg)
        }
        tree.exprs[expr] = move print

        if (ok) {
            ok = parseFormat(text, formatLoc, expr) && printable(expr, formatLoc)
        }
        if (format) {
            ret ok ? types.structType(stringDecl) : errorType()
        }
        ret voidType()
    }

    // After the format: an argument of {:?} becomes debugText(x) (D319), a struct of
    // {} becomes x.text() (D318); then the specifications are checked against the
    // types to print.
    bool printable(i32 print, Loc loc) {
        list<i32> args = tree.exprs[print].items
        list<bool> debug
        list<bool> plain
        for (i64 i = 0; i < args.len(); i++) {
            debug.add(false)
            plain.add(false)
        }
        for (i64 p = 0; p < tree.exprs[print].pieces.len(); p++) {
            i32 arg = tree.exprs[print].pieces[p].arg
            if (arg < 0) {
                continue
            }
            if (tree.exprs[print].pieces[p].spec.type == '?') {
                debug[arg] = true
                tree.exprs[print].pieces[p].spec.type = 0
            } else {
                plain[arg] = true
            }
        }
        bool ok = true
        for (i64 i = 0; i < args.len(); i++) {
            i32 type = tree.exprs[args[i]].resolved
            if (debug[i] && plain[i]) {  // as two values, also for the numbers and the strings (D320)
                error(locOf(args[i]), "this argument is printed both with {} and with {:?}: pass it twice")
                ok = false
            } else if (debug[i]) {
                ok = toDebugText(args[i]) && ok
            } else if (!basicPrintable(type)) {
                ok = toText(args[i]) && ok
            }
        }
        if (!ok) {
            ret false
        }
        for (i64 p = 0; p < tree.exprs[print].pieces.len(); p++) {
            i32 arg = tree.exprs[print].pieces[p].arg
            if (arg >= 0 && tree.exprs[print].pieces[p].hasSpec) {
                FormatSpec spec = tree.exprs[print].pieces[p].spec
                if (!validateSpec(spec, tree.exprs[args[arg]].resolved, loc)) {
                    ret false
                }
            }
        }
        ret true
    }

    // What {} prints by itself: the numbers, bool and string (D38).
    bool basicPrintable(i32 type) const {
        ret types.isNumeric(type) || types.isBool(type) || isString(type) || type == literalString()  // and string literals
    }

    // `x` printed with {:?}: debugText<T>(x) of the core (D319).
    bool toDebugText(i32 arg) {
        Loc loc = locOf(arg)
        i32 type = tree.exprs[arg].resolved
        if (tree.exprs[arg].kind == ExprKind.StringLiteral) {  // its form is known here, as debugString writes it
            tree.exprs[arg].text = debugForm(tree.exprs[arg].text)
            ret true
        }
        if (types.isParam(type)) {
            if (!has(types.params[types.decl(type)].interfaces, debugInterface)) {
                error(loc, name(type) + " can be printed with {:?} only with a constraint: write <" + name(type) + " : Debug>")
                ret false
            }
        } else {
            string problem = debugProblem(type)
            if (problem.len() > 0) {
                error(loc, "values of type " + name(type) + " cannot be printed with {:?}: " + problem)
                ret false
            }
        }
        if (!scopes[libraryFile].functions.contains("debugText")) {
            error(loc, "the standard library has no debugText")
            ret false
        }
        list<i32> typeArgs
        typeArgs.add(type)
        i32 function = instantiateFunction(scopes[libraryFile].functions["debugText"], typeArgs, loc)
        if (function < 0) {
            ret false
        }
        use(function, loc)
        noteCall(function, loc)
        i32 inner = relocate(arg)
        Expr call = nodeAt(ExprKind.Call, loc.line, loc.column)
        call.text = "debugText"
        call.target = function
        call.items.add(inner)
        call.resolved = types.structType(stringDecl)
        tree.exprs[arg] = move call
        ret true
    }

    // A struct or an enum printed with {}: its method text() (D318).
    bool toText(i32 arg) {
        Loc loc = locOf(arg)
        i32 type = tree.exprs[arg].resolved
        if (!types.isStruct(type)) {                                  // an array, a function, an interface or a T: no methods of its own
            bool debug = types.isArray(type) || types.isVector(type)  // those with a form of debug (D321)
            string hint = debug ? ": print its form of debug with {:?}" : types.isParam(type) ?
                ": print its form of debug with {:?}, with the constraint Debug" : ": it has no text to print"
            error(loc, withArticle(name(type)) + " cannot be printed with {}" + hint)
            ret false
        }
        i32 decl = types.decl(type)
        i32 method = tree.records[decl].methods.contains("text") ? tree.records[decl].methods["text"] : -1
        if (method < 0 || tree.functions[method].params.len() > 0 || !tree.functions[method].isConst ||
            !isString(tree.functions[method].resolvedReturn)) {
            error(loc, withArticle(name(type)) + " cannot be printed with {}: give it a method string text() const, or print its " +
                "form of debug with {:?}")
            ret false
        }
        if (!memberVisible(method, decl, curFile)) {
            reportPrivate(loc, "method 'text' of " + name(type))
            ret false
        }
        use(method, loc)
        noteCall(method, loc)
        wrap(arg, ExprKind.MethodCall, types.structType(stringDecl))
        tree.exprs[arg].text = "text"
        tree.exprs[arg].target = method
        ret true
    }

    FormatPiece textPiece(string text) const {
        FormatPiece piece
        piece.text = text
        ret piece
    }

    bool parseFormat(string format, Loc loc, i32 print) {
        list<i32> args = tree.exprs[print].items
        list<FormatPiece> pieces
        bool ok = parseFormatPieces(format, loc, args, ref pieces)
        tree.exprs[print].pieces = move pieces
        ret ok
    }

    bool parseFormatPieces(string format, Loc loc, list<i32> args, ref list<FormatPiece> pieces) {
        string text
        i32 nextAuto = 0
        bool usedAuto = false
        bool usedManual = false
        list<bool> used
        for (i64 i = 0; i < args.len(); i++) {
            used.add(false)
        }

        i64 i = 0
        for (i < format.len()) {
            u8 c = format[i]
            if (c == '}') {
                if (i + 1 < format.len() && format[i + 1] == '}') {
                    text += "}"
                    i += 2
                    continue
                }
                error(loc, "single '}' in the format string: write '}}' for a brace")
                ret false
            }
            if (c != '{') {  // up to the next brace: a character of more bytes stays whole
                i64 end = i + 1
                for (end < format.len() && format[end] != '{' && format[end] != '}') {
                    end++
                }
                text += format.slice(i, end)
                i = end
                continue
            }
            if (i + 1 < format.len() && format[i + 1] == '{') {
                text += "{"
                i += 2
                continue
            }
            i64 close = format.findFrom("}", i)
            if (close < 0) {
                error(loc, "'{' without a matching '}' in the format string: write '{{' for a brace")
                ret false
            }
            string inside = format.slice(i + 1, close)
            i = close + 1

            if (text.len() > 0) {
                pieces.add(textPiece(text))
                text = ""
            }

            FormatPiece piece
            i64 colon = inside.find(":")
            string id = colon < 0 ? inside : inside.slice(0, colon)
            if (id.len() == 0) {
                usedAuto = true
                piece.arg = nextAuto
                nextAuto++
            } else {
                for (i64 d = 0; d < id.len(); d++) {
                    if (!isDigit(id[d])) {
                        error(loc, "invalid placeholder '{" + inside + "}'")
                        ret false
                    }
                }
                usedManual = true
                piece.arg = id.len() > 6 ? 1000000 : i32(i64(id))
            }
            if (usedAuto && usedManual) {
                error(loc, "cannot mix automatic '{}' and numbered '{0}' placeholders")
                ret false
            }
            if (i64(piece.arg) >= args.len()) {
                error(loc, format("the format string needs at least {} arguments, but {} were given", piece.arg + 1, args.len()))
                ret false
            }
            if (colon >= 0) {
                piece.hasSpec = true
                string written = inside.slice(colon + 1, inside.len())
                FormatSpec spec
                if (!parseSpec(written, ref spec)) {
                    error(loc, "invalid format specification '" + written + "'")
                    ret false
                }
                piece.spec = spec
            }
            used[piece.arg] = true
            pieces.add(move piece)
        }
        if (text.len() > 0) {
            pieces.add(textPiece(text))
        }

        bool ok = true
        for (i64 k = 0; k < used.len(); k++) {
            if (!used[k]) {
                error(locOf(args[k]), "this argument is not used by the format string")
                ok = false
            }
        }
        ret ok
    }

    bool validateSpec(FormatSpec spec, i32 type, Loc loc) {
        bool numberFlags = spec.sign != 0 || spec.alternate || spec.zeroPad
        string letters = "dxXbocefgs?"
        string letter = "?"
        for (i64 i = 0; i < letters.len(); i++) {
            if (letters[i] == spec.type) {
                letter = letters.slice(i, i + 1)
            }
        }
        if (types.isInt(type)) {
            if (spec.type != 0 && !"dxXboc".contains(letter)) {
                error(loc, "'" + letter + "' is not a format for integers")
                ret false
            }
            if (spec.precision >= 0) {
                error(loc, "a precision is not allowed for integers")
                ret false
            }
            if (spec.type == 'c') {
                if (type != intType(8, false)) {
                    error(loc, "'c' prints a character: the value must be a char (u8)")
                    ret false
                }
                if (numberFlags) {
                    error(loc, "'c' only allows fill, alignment and width")
                    ret false
                }
            }
            ret true
        }
        if (types.isFloat(type)) {
            if (spec.type != 0 && !"efg".contains(letter)) {
                error(loc, "'" + letter + "' is not a format for floating-point numbers")
                ret false
            }
            ret true
        }
        // bool and string literals
        if (spec.type != 0 && spec.type != 's') {
            error(loc, "'" + letter + "' is not a format for a " + name(type))
            ret false
        }
        if (numberFlags) {
            error(loc, withArticle(name(type)) + " only allows fill, alignment, width" + (types.isBool(type) ? "" : " and precision"))
            ret false
        }
        if (types.isBool(type) && spec.precision >= 0) {
            error(loc, "a precision is not allowed for a bool")
            ret false
        }
        ret true
    }

    // ---- What the analysis writes on the bodies (P90) ----

    string kindName(ExprKind kind) const {
        switch (kind) {
            case IntLiteral {
                ret "int"
            }
            case FloatLiteral {
                ret "float"
            }
            case BoolLiteral {
                ret "bool"
            }
            case StringLiteral {
                ret "text"
            }
            case Name {
                ret "name"
            }
            case Unary {
                ret "unary"
            }
            case Binary {
                ret "binary"
            }
            case Call {
                ret "call"
            }
            case Conversion {
                ret "conversion"
            }
            case Print {
                ret "print"
            }
            case Field {
                ret "field"
            }
            case MethodCall {
                ret "method"
            }
            case Construct {
                ret "construct"
            }
            case Self {
                ret "self"
            }
            case Move {
                ret "move"
            }
            case Ref {
                ret "ref"
            }
            case Copy {
                ret "copy"
            }
            case Index {
                ret "index"
            }
            case EnumCase {
                ret "case"
            }
            case TypeRef {
                ret "type"
            }
            case Lambda {
                ret "lambda"
            }
            case CallValue {
                ret "value"
            }
            case ListLiteral {
                ret "list"
            }
            case Conditional {
                ret "conditional"
            }
        }
    }

    string calledName(i32 expr) const {
        ret tree.exprs[expr].target >= 0 ? " -> " + tree.functions[tree.exprs[expr].target].name : ""
    }

    void listExpr(i32 expr, ref string out) const {
        if (expr < 0) {
            ret
        }
        ExprKind kind = tree.exprs[expr].kind
        string extra
        switch (kind) {
            case IntLiteral {
                extra = format(" {}{}", tree.exprs[expr].negative && tree.exprs[expr].value != 0 ? "-" : "", tree.exprs[expr].value)
            }
            case Name {
                extra = tree.exprs[expr].variable >= 0 ? " " + tree.variables[tree.exprs[expr].variable].name : ""
            }
            case Binary {
                extra = " " + name(tree.exprs[expr].operandType) + (tree.exprs[expr].wrap ? " wrap" : "")
            }
            case Call {
                extra = format(" {}{} {} {}", tree.exprs[expr].text, calledName(expr), i32(tree.exprs[expr].intrinsic),
                    tree.exprs[expr].overlaps.len())
            }
            case Conversion {
                extra = tree.exprs[expr].isExplicit ? " explicit" : ""
            }
            case Print {
                extra = format(" {}{}{}", tree.exprs[expr].stream, tree.exprs[expr].newline ? " newline " : " ",
                    tree.exprs[expr].pieces.len())
            }
            case Field {
                extra = format(" {} {}", tree.exprs[expr].text, tree.exprs[expr].index)
            }
            case MethodCall {
                extra = format(" {}{} {}", tree.exprs[expr].text, calledName(expr), tree.exprs[expr].overlaps.len())
            }
            case Construct {
                extra = " " + tree.records[tree.exprs[expr].decl].name + (tree.exprs[expr].blockThread >= 0 ? " thread" : "")
            }
            case Move {
                extra = format(" {}", i32(tree.exprs[expr].moveKind))
            }
            case Index, CallValue {
                extra = calledName(expr)
            }
            case EnumCase {
                extra = format(" {} {}", tree.records[tree.exprs[expr].decl].name, tree.exprs[expr].index)
            }
            case Lambda {
                extra = (tree.exprs[expr].borrows ? " borrows" : "") + (tree.exprs[expr].onStack ? " stack" : "") +
                    (tree.exprs[expr].forThread ? " thread" : "") + (tree.exprs[expr].group >= 0 ? " group" : "")
                for (Capture capture in tree.exprs[expr].captures) {
                    extra += " " + capture.name + (capture.byAddress ? "&" : "") + (capture.outer >= 0 ? "" : "?")
                }
            }
            default {
            }
        }
        out += format("  {} {}:{} {}{}\n", kindName(kind), tree.exprs[expr].line, tree.exprs[expr].column,
            name(tree.exprs[expr].resolved), extra)
        if (kind == ExprKind.Lambda) {
            listFunction(tree.exprs[expr].function, "lambda", ref out)
            ret
        }
        if (kind == ExprKind.TypeRef) {
            ret
        }
        listExpr(tree.exprs[expr].left, ref out)
        listExpr(tree.exprs[expr].right, ref out)
        listExpr(tree.exprs[expr].other, ref out)
        for (i32 item in tree.exprs[expr].items) {
            listExpr(item, ref out)
        }
    }

    void listBlock(i32 block, ref string out) const {
        if (block < 0) {
            ret
        }
        for (i32 statement in tree.blocks[block].statements) {
            listStmt(statement, ref out)
        }
    }

    void listStmt(i32 statement, ref string out) const {
        if (statement < 0) {
            ret
        }
        switch (tree.stmts[statement].kind) {
            case Assign {
                if (tree.stmts[statement].call >= 0) {
                    listExpr(tree.stmts[statement].call, ref out)
                } else {
                    listExpr(tree.stmts[statement].target, ref out)
                    listExpr(tree.stmts[statement].value, ref out)
                }
            }
            case IncDec {
                listExpr(tree.stmts[statement].target, ref out)
            }
            case If {
                listExpr(tree.stmts[statement].value, ref out)
                listBlock(tree.stmts[statement].body, ref out)
                listBlock(tree.stmts[statement].elseBody, ref out)
            }
            case For {
                listStmt(tree.stmts[statement].init, ref out)
                listExpr(tree.stmts[statement].value, ref out)
                listStmt(tree.stmts[statement].step, ref out)
                listBlock(tree.stmts[statement].body, ref out)
            }
            case Switch {
                listExpr(tree.stmts[statement].value, ref out)
                out += tree.stmts[statement].exhaustive ? "  switch exhaustive\n" : "  switch\n"
                for (i32 branch in tree.stmts[statement].parts) {
                    for (Pattern pattern in tree.branches[branch].patterns) {
                        out += format("  pattern {}\n", pattern.caseIndex)
                        listExpr(pattern.literal, ref out)
                    }
                    listBlock(tree.branches[branch].body, ref out)
                }
                listBlock(tree.stmts[statement].defaultBody, ref out)
            }
            case Try {
                listBlock(tree.stmts[statement].body, ref out)
                for (i32 clause in tree.stmts[statement].parts) {
                    out += "  catch " + name(tree.catches[clause].resolved) + "\n"
                    listBlock(tree.catches[clause].body, ref out)
                }
                listBlock(tree.stmts[statement].elseBody, ref out)
            }
            case Break, Continue {
            }
            default {  // a declaration, a call, ret and throw: their value
                listExpr(tree.stmts[statement].value, ref out)
            }
        }
    }

    void listFunction(i32 function, string what, ref string out) const {
        if (!tree.functions[function].bodyChecked) {
            ret
        }
        out += what + " " + tree.functions[function].name + (tree.functions[function].canThrow ? " throws" : "") +
            (tree.functions[function].isAbstract ? " abstract" : "") + "\n"
        for (i32 variable in tree.functions[function].variables) {
            out += format("  var {} {} {}{}{}{}{}\n", tree.variables[variable].name, i32(tree.variables[variable].kind),
                name(tree.variables[variable].type), tree.variables[variable].isConst ? " const" : "",
                tree.variables[variable].needsDropFlag ? " flag" : "", tree.variables[variable].blockThread >= 0 ? " thread" : "",
                tree.variables[variable].group ? " group" : "")
        }
        listBlock(tree.functions[function].body, ref out)
    }

    // Every function checked with its variables, and every expression in the order
    // of the source with its kind, its position and its type, as `cromo build
    // --list-types` prints them.
    public void listTypes() const {
        string out
        for (i64 r = 0; r < tree.records.len(); r++) {
            if (r < recordCount && tree.records[r].typeParams.len() > 0) {
                continue
            }
            for (i32 member in tree.records[r].members) {
                listFunction(member, "member " + tree.records[r].name, ref out)
            }
        }
        for (i32 function in tree.topFunctions) {
            listFunction(function, "function", ref out)
        }
        for (i32 function in made) {
            listFunction(function, "instance", ref out)
        }
        print("{}", out)
    }

    // ---- `==` on structs, enums and arrays (D565) ----

    // Why the values of `type` cannot be compared with `==`, or "" when they can:
    // all the types but the functions, the interfaces and the vectors, and what
    // holds them without an equals() of its own.
    string equalProblem(i32 type) const {
        map<i32, bool> visiting
        ret equalProblemAt(type, "", ref visiting)
    }

    string equalProblemAt(i32 type, string place, ref map<i32, bool> visiting) const {
        if (types.isBool(type) || types.isNumeric(type) || types.isError(type) || type == addrType() || types.isParam(type)) {
            ret ""
        }
        if (types.isArray(type)) {
            ret equalProblemAt(types.element(type), place.len() == 0 ? "an element" : place + "[i]", ref visiting)
        }
        if (!types.isStruct(type)) {
            ret place.len() == 0 ? "it has no equals()" : place + " has type " + name(type)
        }
        i32 decl = types.decl(type)
        if (decl == stringDecl || tree.records[decl].methods.contains("equals")) {
            ret ""
        }
        if (isList(type)) {
            ret equalProblemAt(tree.records[decl].typeArgs[0], place.len() == 0 ? "an element" : place + "[i]", ref visiting)
        }
        if (isMap(type)) {
            ret equalProblemAt(tree.records[decl].typeArgs[1], place.len() == 0 ? "a value" : place + "[key]", ref visiting)
        }
        if (visiting.contains(decl)) {
            ret ""  // already being checked: it contains a list of itself
        }
        visiting[decl] = true
        string base = place.len() == 0 ? tree.records[decl].name : place
        for (i64 c = 0; c < tree.records[decl].cases.len(); c++) {
            for (i64 f = 0; f < tree.records[decl].cases[c].fields.len(); f++) {
                string problem = equalProblemAt(tree.records[decl].cases[c].fields[f].resolved, base + "." +
                    tree.records[decl].cases[c].name, ref visiting)
                if (problem.len() > 0) {
                    ret problem
                }
            }
        }
        for (i64 f = 0; f < tree.records[decl].fields.len(); f++) {
            string problem = equalProblemAt(tree.records[decl].fields[f].resolved, base + "." + tree.records[decl].fields[f].name,
                ref visiting)
            if (problem.len() > 0) {
                ret problem
            }
        }
        ret ""
    }

    // `a == b` and `a != b` on two values of a struct, an enum or an array: the call
    // of its equals(), written or generated, as copy() (D35, D83).
    i32 checkEquality(i32 expr, i32 type) {
        Loc loc = locOf(expr)
        BinaryOp op = tree.exprs[expr].binary
        i32 lhs = tree.exprs[expr].left
        i32 rhs = tree.exprs[expr].right
        if (isAbstract(tree, types, type)) {
            ret boolType()  // D85: checked in each instance
        }
        i32 method = -1
        if (types.isStruct(type) && tree.records[types.decl(type)].methods.contains("equals")) {
            i32 written = tree.records[types.decl(type)].methods["equals"]
            bool fits = tree.functions[written].params.len() == 1 && tree.functions[written].paramTypes.len() == 1 &&
                tree.functions[written].params[0].mode == ParamMode.Read && tree.functions[written].paramTypes[0] == type &&
                types.isBool(tree.functions[written].resolvedReturn) && tree.functions[written].isConst
            if (!fits) {
                error(loc, "'" + spelling(op) + "' needs the equals() of " + name(type) + " written 'bool equals(" + name(type) +
                    " other) const'")
                ret errorType()
            }
            method = written
            use(method, loc)
        }
        Expr node = nodeAt(method >= 0 ? ExprKind.MethodCall : ExprKind.Call, loc.line, loc.column)
        node.text = "equals"
        if (method >= 0) {
            node.left = lhs
            node.items.add(rhs)
        } else {
            string problem = equalProblem(type)
            if (problem.len() > 0) {
                error(loc, "values of type " + name(type) + " cannot be compared with '" + spelling(op) + "': " + problem)
                ret errorType()
            }
            method = generatedEqual(type, loc)
            if (method < 0) {
                ret errorType()
            }
            node.items.add(lhs)
            node.items.add(rhs)
        }
        node.target = method
        node.resolved = boolType()
        noteCall(method, loc)
        if (op == BinaryOp.Ne) {
            tree.exprs.add(move node)
            Expr negation = nodeAt(ExprKind.Unary, loc.line, loc.column)
            negation.unary = UnaryOp.Not
            negation.left = i32(tree.exprs.len() - 1)
            tree.exprs[expr] = move negation
        } else {
            tree.exprs[expr] = move node
        }
        ret boolType()
    }

    // The equals of a type without one, written in Cromo and checked as an instance
    // with the types of its parts, in the scope of the core; it reads the private
    // fields too, as copy().
    i32 generatedEqual(i32 type, Loc loc) {
        string key = format("equals {}", type)
        if (generated.contains(key)) {
            ret generated[key]
        }
        list<TypeBinding> generatedBindings
        generatedBindings.add(binding("T", type))
        string text = equalText(type, ref generatedBindings)
        i32 function = parseGenerated(text, libraryFile)
        if (function >= 0) {
            tree.functions[function].symbol = symbolFor(loc.file, "equals." + symbolOrName(type))
        }
        if (function < 0) {
            error(loc, "internal error: the equals of " + name(type) + " does not parse")
            ret -1
        }
        generated[key] = function
        addGenerated(function, generatedBindings, name(type), loc)
        ret function
    }

    // The fields one by one; the elements of a list or of an array, and their number;
    // the keys and the values of a map; the case of an enum and its data.
    string equalText(i32 type, ref list<TypeBinding> generatedBindings) const {
        string text = "bool equals(T a, T b) {\n"
        if (types.isArray(type) || isList(type)) {
            ret text + "if (a.len() != b.len()) {\nret false\n}\nfor (i64 i = 0; i < a.len(); i++) {\n" +
                "if (a[i] != b[i]) {\nret false\n}\n}\nret true\n}\n"
        }
        i32 decl = types.decl(type)
        if (isMap(type)) {
            generatedBindings.add(binding("K", tree.records[decl].typeArgs[0]))
            generatedBindings.add(binding("V", tree.records[decl].typeArgs[1]))
            ret text + "if (a.len() != b.len()) {\nret false\n}\nfor (K key, V value in a) {\n" +
                "if (!b.contains(key) || b[key] != value) {\nret false\n}\n}\nret true\n}\n"
        }
        if (tree.records[decl].isEnum) {
            text += "switch (a) {\n"
            for (i64 c = 0; c < tree.records[decl].cases.len(); c++) {
                string caseName = tree.records[decl].cases[c].name
                i64 count = tree.records[decl].cases[c].fields.len()
                string left
                string right
                string same
                for (i64 i = 0; i < count; i++) {
                    string param = format("E{}_{}", c, i)
                    generatedBindings.add(binding(param, tree.records[decl].cases[c].fields[i].resolved))
                    left += format("{}{} x{}", i > 0 ? ", " : "", param, i)
                    right += format("{}{} y{}", i > 0 ? ", " : "", param, i)
                    same += format("{}{} == y{}", i > 0 ? " && x" : "x", i, i)
                }
                text += "case " + caseName + (count > 0 ? "(" + left + ")" : "") + " {\nswitch (b) {\ncase " + caseName + (count > 0 ?
                    "(" + right + ")" : "") + " {\nret " + (count > 0 ? same : "true") + "\n}\ndefault {\nret false\n}\n}\n}\n"
            }
            ret text + "}\n}\n"
        }
        string same
        for (i64 f = 0; f < tree.records[decl].fields.len(); f++) {
            string fieldName = tree.records[decl].fields[f].name
            same += (same.len() == 0 ? "a." : " && a.") + fieldName + " == b." + fieldName
        }
        ret text + "ret " + (same.len() == 0 ? "true" : same) + "\n}\n"
    }

    // ---- The references of a block (D562) ----

    // Whether a part of the program that is not checked yet uses a name, as a
    // variable: a reference lends its place until its last use. A name is never
    // hidden by another (D66), so the name alone tells.
    bool exprMentions(i32 expr, string name) const {
        if (expr < 0) {
            ret false
        }
        switch (tree.exprs[expr].kind) {
            case IntLiteral, FloatLiteral, BoolLiteral, StringLiteral, TypeRef {
                ret false
            }
            case Name {
                ret tree.exprs[expr].text == name
            }
            case Lambda {
                for (Capture capture in tree.exprs[expr].captures) {
                    if (capture.name == name) {
                        ret true
                    }
                }
                ret blockMentions(tree.functions[tree.exprs[expr].function].body, name)
            }
            case Conversion, Print, Construct, Self, Copy, EnumCase {
                ret true  // made by the analysis: not in what is still to check
            }
            default {
            }
        }
        if (tree.exprs[expr].kind == ExprKind.Call && (tree.exprs[expr].text == name || tree.exprs[expr].module == name)) {
            ret true
        }
        if (exprMentions(tree.exprs[expr].left, name) || exprMentions(tree.exprs[expr].right, name) ||
            exprMentions(tree.exprs[expr].other, name)) {
            ret true
        }
        for (i32 item in tree.exprs[expr].items) {
            if (exprMentions(item, name)) {
                ret true
            }
        }
        ret false
    }

    bool stmtMentions(i32 statement, string name) const {
        if (statement < 0) {
            ret false
        }
        if (exprMentions(tree.stmts[statement].value, name) || exprMentions(tree.stmts[statement].target, name) ||
            stmtMentions(tree.stmts[statement].init, name) || stmtMentions(tree.stmts[statement].step, name) ||
            blockMentions(tree.stmts[statement].body, name) || blockMentions(tree.stmts[statement].elseBody, name) ||
            blockMentions(tree.stmts[statement].defaultBody, name)) {
            ret true
        }
        bool isSwitch = tree.stmts[statement].kind == StmtKind.Switch
        for (i32 part in tree.stmts[statement].parts) {
            if (!isSwitch) {
                if (blockMentions(tree.catches[part].body, name)) {
                    ret true
                }
                continue
            }
            for (Pattern pattern in tree.branches[part].patterns) {
                if (exprMentions(pattern.literal, name)) {
                    ret true
                }
            }
            if (blockMentions(tree.branches[part].body, name)) {
                ret true
            }
        }
        ret false
    }

    bool blockMentions(i32 block, string name) const {
        if (block < 0) {
            ret false
        }
        for (i32 statement in tree.blocks[block].statements) {
            if (stmtMentions(statement, name)) {
                ret true
            }
        }
        ret false
    }

    // The object reached by a place. A reference is the place it names, so what is
    // done through it is done to that place.
    Path pathOf(i32 expr) const {
        Path path = writtenPath(expr)
        if (!path.valid || path.variable < 0 || !refPaths.contains(path.variable)) {
            ret path
        }
        Path full = refPaths[path.variable]
        for (Step step in path.steps) {
            full.steps.add(step)
        }
        ret full
    }

    // The variable a place starts from, when it is written with one; or -1.
    i32 rootOf(i32 place) const {
        i32 at = place
        for (tree.exprs[at].kind == ExprKind.Field || tree.exprs[at].kind == ExprKind.Index) {
            at = tree.exprs[at].left
        }
        ret tree.exprs[at].kind == ExprKind.Name ? tree.exprs[at].variable : -1
    }

    // Whether a place is written through a reference, itself or one that goes
    // through it: what that reference lends is modified through it.
    bool through(i32 place, i32 reference) const {
        i32 root = rootOf(place)
        if (root < 0 || reference < 0) {
            ret false
        }
        ret root == reference || (refChains.contains(root) && has(refChains[root], reference))
    }

    // `ref T x = place` and `const ref T x = place` (D562): a name for a variable, a
    // field or an element, until the end of its block. The variable it starts from is
    // lent until its last use, as the list of a `for` (D101): it is modified through
    // the reference.
    void checkReference(i32 decl) {
        i32 node = tree.stmts[decl].type
        i32 type = resolveOrError(node, curFile)
        if (types.isVoid(type)) {
            error(typeLoc(node, curFile), "a variable cannot be void")
            type = errorType()
        }
        if (!checkNotInterface(type, typeLoc(node, curFile), "a variable")) {
            type = errorType()
        }
        Loc nameLoc = at(curFile, tree.stmts[decl].nameLine, tree.stmts[decl].nameColumn)
        string declName = tree.stmts[decl].name
        bool isConst = tree.stmts[decl].isConst
        i32 place = tree.stmts[decl].value
        bool ok = false
        if (place < 0) {
            error(nameLoc, "a reference names a place: write a variable, a field or an element after '='")
        } else {
            i32 found = checkExpr(place, -1)
            Loc loc = locOf(place)
            i32 object = tree.exprs[place].kind == ExprKind.Index ? tree.exprs[tree.exprs[place].left].resolved : -1
            string reason = !types.isError(found) && isPlace(place) && !isConst ? readOnlyReason(place) : ""
            if (types.isError(found)) {
                ok = false
            } else if (!isPlace(place)) {
                error(loc, "a reference names a variable, a field or an element")
            } else if (object >= 0 && (isString(object) || types.isVector(object))) {
                error(loc, "an element of a " + (types.isVector(object) ? "vector" : "string") +
                    " has no place of its own: copy it into a variable")
            } else if (tree.exprs[place].kind == ExprKind.Name && !checkNotBlockThread(tree.exprs[place].variable, loc)) {
                ok = false
            } else if (reason.len() > 0) {
                error(loc, "cannot name '" + placeText(place) + "' with 'ref': " + reason + "; 'const ref' reads it")
            } else if (!types.isError(type) && found != type) {
                error(typeLoc(node, curFile), "'" + placeText(place) + "' is " + withArticle(name(found)) + ": write " + (isConst ?
                    "const ref" : "ref") + " " + name(found) + " " + declName)
            } else if (!isConst && !checkNotBorrowed(place, loc)) {
                ok = false
            } else {
                ok = !types.isError(type)
            }
        }
        i32 variable = declare(declName, ok ? type : errorType(), nameLoc, isConst)
        tree.stmts[decl].variable = variable
        if (variable < 0) {
            ret
        }
        tree.variables[variable].kind = VariableKind.Element
        tree.variables[variable].reference = true
        if (!ok) {
            ret
        }
        Path path = pathOf(place)
        list<i32> chain
        i32 root = rootOf(place)
        if (root >= 0 && tree.variables[root].reference) {
            if (refChains.contains(root)) {
                chain = refChains[root]
            }
            chain.add(root)
        }
        refPaths[variable] = path
        refChains[variable] = move chain
        i64 last = indexNow  // the statement of its last use, in its block
        if (blockNow >= 0) {
            for (i64 i = indexNow + 1; i < tree.blocks[blockNow].statements.len(); i++) {
                if (stmtMentions(tree.blocks[blockNow].statements[i], declName)) {
                    last = i
                }
            }
        }
        refEnds[variable] = last
        LoopBorrow borrow
        borrow.path = path
        borrow.reason = "while the reference '" + declName + "' names it"
        borrow.thread = variable
        loopBorrows.add(move borrow)
    }

    // ---- What the analysis knows (P89) ----

    string listedSignature(i32 function) const {
        string text = tree.functions[function].name + "("
        for (i64 i = 0; i < tree.functions[function].paramTypes.len(); i++) {
            if (i > 0) {
                text += ", "
            }
            if (tree.functions[function].params[i].mode == ParamMode.Ref) {
                text += "ref "
            }
            if (tree.functions[function].params[i].mode == ParamMode.Move) {
                text += "move "
            }
            text += name(tree.functions[function].paramTypes[i])
        }
        ret text + ") " + name(tree.functions[function].resolvedReturn) + (tree.functions[function].isAbstract ? " abstract" : "")
    }

    string listedFields(list<Field> fields) const {
        string text
        for (Field field in fields) {
            text += " " + field.name + ":" + name(field.resolved)
        }
        ret text
    }

    string listedStruct(i32 record) const {
        string text = format("{}{} size={} align={}", tree.records[record].isEnum ? "enum " : "struct ", tree.records[record].name,
            tree.records[record].size, tree.records[record].align)
        text += (tree.records[record].needsDestruction ? " destruct" : "") + (tree.records[record].addressed ? " addressed" : "") +
            (tree.records[record].isAbstract ? " abstract" : "") + listedFields(tree.records[record].fields) + "\n"
        for (Case item in tree.records[record].cases) {
            text += format("  case {}={}{}\n", item.name, item.number, listedFields(item.fields))
        }
        for (i32 member in tree.records[record].members) {
            if (tree.functions[member].typeParams.len() == 0) {
                text += "  method " + listedSignature(member) + "\n"
            }
        }
        ret text
    }

    // The structs, their instances and the signatures, in the order they were made,
    // as `cromo build --list-declarations` prints them.
    public void listDeclarations() const {
        for (i64 r = 0; r < tree.records.len(); r++) {
            if (r >= recordCount || tree.records[r].typeParams.len() == 0) {
                print("{}", listedStruct(i32(r)))
            }
        }
        for (i32 function in tree.topFunctions) {
            if (tree.functions[function].typeParams.len() == 0) {
                print("function {}\n", listedSignature(function))
            }
        }
        for (i32 function in made) {
            print("instance {}\n", listedSignature(function))
        }
    }
}

// The names and the types of the declarations of a program, with their errors.
public Checker checkDeclarations(move Tree tree, move Diagnostics diag) {
    Checker checker
    checker.tree = move tree
    checker.diag = move diag
    checker.onlyDeclarations = true
    checker.run()
    ret checker
}

// The whole analysis of a program, with its errors: the declarations, then the
// bodies of the functions.
public Checker checkProgram(move Tree tree, move Diagnostics diag, bool requireMain) {
    Checker checker
    checker.tree = move tree
    checker.diag = move diag
    checker.requireMain = requireMain
    checker.run()
    ret checker
}

bool has(list<i32> items, i32 value) {
    for (i32 item in items) {
        if (item == value) {
            ret true
        }
    }
    ret false
}

i32 alignUp(i32 value, i32 align) {
    ret (value + align - 1) / align * align
}

bool isLetter(u8 c) {
    ret (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
}

bool isDigit(u8 c) {
    ret c >= '0' && c <= '9'
}

// At least two names, as Android wants: org.example.mail.
bool isAndroidPackage(string text) {
    list<string> parts = text.split(".")
    for (string part in parts) {
        if (part.len() == 0 || !isLetter(part[0])) {
            ret false
        }
        for (i64 i = 0; i < part.len(); i++) {
            if (!isLetter(part[i]) && !isDigit(part[i]) && part[i] != '_') {
                ret false
            }
        }
    }
    ret parts.len() >= 2
}

// The built-in functions of the `unsafe` dialect, only in the standard library (D98).
bool isIntrinsic(string name) {
    switch (name) {
        case "alloc", "resize", "free", "sizeOf", "offset", "take", "put", "destroy", "copyAt", "copyMemory", "compareMemory",
            "checkIndex", "argumentCount", "argumentLength", "argumentData", "decimalToFloat", "squareRoot", "hashBytes", "callC",
            "systemCall", "environment", "exitProcess", "threadStart", "threadWait", "threadRethrow", "threadUncaught", "threadFree",
            "mutexLock", "mutexUnlock", "selfAddress", "equalAt", "jsonWrite", "jsonRead", "debugWrite", "taskStart", "groupStart",
            "atomicLoad", "atomicStore", "atomicAdd", "atomicExchange", "atomicCompareExchange", "atomicLoadRelaxed",
            "atomicStoreRelaxed", "atomicAddRelaxed", "variableAddress" {
            ret true
        }
        default {
            ret false
        }
    }
}

// How a block or a statement ends.
enum Flow {
    Continues
    Returns
    Jumps  // with break or continue
}

// One step from a variable towards a place: a field, or an element.
struct Step {
    i32 field = -1
    i32 index = -1  // the expression of the index, for an element
}

// The object reached by a place: a variable, -1 for the object of the method, and
// the steps from it.
struct Path {
    bool valid
    i32 variable = -1
    list<Step> steps
}

struct LoopBorrow {
    Path path
    string reason
    i32 thread = -1  // lent to a thread of a block (D215)
}

struct ThreadBorrow {
    i32 thread
    i32 captured
    bool exclusive  // with `ref`: the block cannot even read it
}

struct Modified {
    Path path
    Loc where
}

// A group whose block is being checked, with what was modified after it (D273).
struct GroupLog {
    i32 group
    list<Modified> modified
}

struct TryContext {
    bool catchAll
    list<i32> caught  // the structs
}

struct Region {
    i64 base  // the `try` bodies inside the region start here
    string message
}

struct ThrowInfo {
    bool throws      // a `throw` that is not caught
    list<i32> calls  // calls that are not caught
}

struct Escape {
    Loc loc
    i32 callee = -1  // -1 for a `throw`
    string message
}

const i32 overlapNo = 0
const i32 overlapYes = 1
const i32 overlapMaybe = 2

// The name with its article, as English says it: "a Point", "an Error", "an i32" and
// "an f64", read letter by letter, "a u8".
string withArticle(string name) {
    if (name.len() == 0) {
        ret "a"
    }
    u8 first = name[0]
    if (first >= 'A' && first <= 'Z') {
        first += 32
    }
    bool letters = name.len() > 1 && isDigit(name[1])
    string vowels = letters ? "aefhilmnorsx" : "aeiou"
    bool an = false
    for (i64 i = 0; i < vowels.len(); i++) {
        an = an || vowels[i] == first
    }
    ret (an ? "an " : "a ") + name
}

bool isBitwise(BinaryOp op) {
    ret op == BinaryOp.BitAnd || op == BinaryOp.BitOr || op == BinaryOp.BitXor
}

bool isArithmetic(BinaryOp op) {
    ret op == BinaryOp.Add || op == BinaryOp.Sub || op == BinaryOp.Mul || op == BinaryOp.Div || op == BinaryOp.Rem || isBitwise(op)
}

bool isComparison(BinaryOp op) {
    ret op == BinaryOp.Eq || op == BinaryOp.Ne || op == BinaryOp.Lt || op == BinaryOp.Le || op == BinaryOp.Gt || op == BinaryOp.Ge
}

string spelling(BinaryOp op) {
    switch (op) {
        case Add {
            ret "+"
        }
        case Sub {
            ret "-"
        }
        case Mul {
            ret "*"
        }
        case Div {
            ret "/"
        }
        case Rem {
            ret "%"
        }
        case Eq {
            ret "=="
        }
        case Ne {
            ret "!="
        }
        case Lt {
            ret "<"
        }
        case Le {
            ret "<="
        }
        case Gt {
            ret ">"
        }
        case Ge {
            ret ">="
        }
        case And {
            ret "&&"
        }
        case Or {
            ret "||"
        }
        case BitAnd {
            ret "&"
        }
        case BitOr {
            ret "|"
        }
        case BitXor {
            ret "^"
        }
        case Shl {
            ret "<<"
        }
        case Shr {
            ret ">>"
        }
    }
}

// The text between two bytes of a source, without the spaces around it.
string sourceText(string source, i64 begin, i64 end) {
    if (end > source.len() || begin >= end) {
        ret ""
    }
    ret source.slice(begin, end).trim()
}

// What a call uses: a place, and whether the call can modify it.
struct Access {
    Path path
    i32 expr
    bool modifies
    i32 arg  // -1 for the object of the method, -2 for what a lambda captures
}

// A text as a string literal of Cromo.
string quoted(string text) {
    string digits = "0123456789abcdef"
    string result = "\""
    for (i64 i = 0; i < text.len(); i++) {
        u8 c = text[i]
        if (c == '"' || c == '\\') {
            result += "\\"
        }
        if (c == '\n') {
            result += "\\n"
        } else if (c == '\r') {
            result += "\\r"
        } else if (c == '\t') {
            result += "\\t"
        } else if (c < 32) {
            result += "\\x" + digits.slice(i64(c >> 4), i64(c >> 4) + 1) + digits.slice(i64(c & 15), i64(c & 15) + 1)
        } else {
            i64 end = i + 1  // the whole character, of one byte or more
            for (end < text.len() && text[end] & 0xC0 == 0x80) {
                end++
            }
            result += text.slice(i, end)
            i = end - 1
        }
    }
    ret result + "\""
}

const i32 maxWidth = 1000
const i32 maxPrecision = 500

bool isAlign(u8 c) {
    ret c == '<' || c == '>' || c == '^'
}

// [[fill]align][sign]['#']['0'][width]['.' precision][type]
bool parseSpec(string text, ref FormatSpec spec) {
    i64 p = 0
    if (text.len() >= 2 && isAlign(text[1])) {
        if (text[0] >= 128 || text[0] == '{' || text[0] == '}') {
            ret false
        }
        spec.fill = text[0]
        spec.align = text[1]
        p = 2
    } else if (text.len() > 0 && isAlign(text[0])) {
        spec.align = text[0]
        p = 1
    }
    if (p < text.len() && (text[p] == '+' || text[p] == '-' || text[p] == ' ')) {
        spec.sign = text[p]
        p++
    }
    if (p < text.len() && text[p] == '#') {
        spec.alternate = true
        p++
    }
    if (p < text.len() && text[p] == '0') {
        spec.zeroPad = true
        p++
    }
    if (p < text.len() && isDigit(text[p])) {
        i32 width = 0
        for (p < text.len() && isDigit(text[p]) && width <= maxWidth) {
            width = width * 10 + i32(text[p] - '0')
            p++
        }
        if (width > maxWidth) {
            ret false
        }
        spec.width = width
    }
    if (p < text.len() && text[p] == '.') {
        p++
        if (p >= text.len() || !isDigit(text[p])) {
            ret false
        }
        i32 precision = 0
        for (p < text.len() && isDigit(text[p]) && precision <= maxPrecision) {
            precision = precision * 10 + i32(text[p] - '0')
            p++
        }
        if (precision > maxPrecision) {
            ret false
        }
        spec.precision = precision
    }
    if (p < text.len()) {
        string letters = "dxXbocefgs?"
        for (i64 i = 0; i < letters.len(); i++) {
            if (letters[i] == text[p]) {
                spec.type = text[p]
                p++
                break
            }
        }
    }
    ret p == text.len()
}

// A string literal as {:?} prints it, as debugString of the core writes the others.
// The bytes that need no escape are copied in runs, which end at a byte of ASCII: a
// character of more bytes stays whole.
string debugForm(string value) {
    string digits = "0123456789abcdef"
    string text = "\""
    i64 run = 0
    for (i64 i = 0; i < value.len(); i++) {
        u8 c = value[i]
        string escape
        if (c == '"') {
            escape = "\\\""
        } else if (c == '\\') {
            escape = "\\\\"
        } else if (c == '\n') {
            escape = "\\n"
        } else if (c == '\r') {
            escape = "\\r"
        } else if (c == '\t') {
            escape = "\\t"
        } else if (c < 32 || c == 127) {
            escape = "\\x" + digits.slice(i64(c >> 4), i64(c >> 4) + 1) + digits.slice(i64(c & 15), i64(c & 15) + 1)
        } else {
            continue
        }
        text += value.slice(run, i) + escape
        run = i + 1
    }
    ret text + value.slice(run, value.len()) + "\""
}

bool isPrintFunction(string name) {
    ret name == "print" || name == "println" || name == "eprint" || name == "eprintln" || name == "format"
}

// The functions of the bits (D502), or None.
Intrinsic bitFunction(string name) {
    switch (name) {
        case "countOnes" {
            ret Intrinsic.CountOnes
        }
        case "trailingZeros" {
            ret Intrinsic.TrailingZeros
        }
        case "leadingZeros" {
            ret Intrinsic.LeadingZeros
        }
        case "rotateLeft" {
            ret Intrinsic.RotateLeft
        }
        case "rotateRight" {
            ret Intrinsic.RotateRight
        }
        default {
            ret Intrinsic.None
        }
    }
}

// The built-in functions of the `unsafe` dialect, only in the standard library
// (D98), or None.
Intrinsic intrinsicOf(string name) {
    switch (name) {
        case "alloc" {
            ret Intrinsic.Alloc
        }
        case "resize" {
            ret Intrinsic.Resize
        }
        case "free" {
            ret Intrinsic.Free
        }
        case "sizeOf" {
            ret Intrinsic.SizeOf
        }
        case "offset" {
            ret Intrinsic.Offset
        }
        case "take" {
            ret Intrinsic.Take
        }
        case "put" {
            ret Intrinsic.Put
        }
        case "destroy" {
            ret Intrinsic.Destroy
        }
        case "copyAt" {
            ret Intrinsic.CopyAt
        }
        case "copyMemory" {
            ret Intrinsic.CopyMemory
        }
        case "compareMemory" {
            ret Intrinsic.CompareMemory
        }
        case "checkIndex" {
            ret Intrinsic.CheckIndex
        }
        case "argumentCount" {
            ret Intrinsic.ArgumentCount
        }
        case "argumentLength" {
            ret Intrinsic.ArgumentLength
        }
        case "argumentData" {
            ret Intrinsic.ArgumentData
        }
        case "decimalToFloat" {
            ret Intrinsic.DecimalToFloat
        }
        case "squareRoot" {
            ret Intrinsic.SquareRoot
        }
        case "hashBytes" {
            ret Intrinsic.HashBytes
        }
        case "callC" {
            ret Intrinsic.CallC
        }
        case "systemCall" {
            ret Intrinsic.SystemCall
        }
        case "environment" {
            ret Intrinsic.Environment
        }
        case "exitProcess" {
            ret Intrinsic.ExitProcess
        }
        case "threadStart" {
            ret Intrinsic.ThreadStart
        }
        case "threadWait" {
            ret Intrinsic.ThreadWait
        }
        case "threadRethrow" {
            ret Intrinsic.ThreadRethrow
        }
        case "threadUncaught" {
            ret Intrinsic.ThreadUncaught
        }
        case "threadFree" {
            ret Intrinsic.ThreadFree
        }
        case "mutexLock" {
            ret Intrinsic.MutexLock
        }
        case "mutexUnlock" {
            ret Intrinsic.MutexUnlock
        }
        case "selfAddress" {
            ret Intrinsic.SelfAddress
        }
        case "equalAt" {
            ret Intrinsic.EqualAt
        }
        case "jsonWrite" {
            ret Intrinsic.JsonWrite
        }
        case "jsonRead" {
            ret Intrinsic.JsonRead
        }
        case "debugWrite" {
            ret Intrinsic.DebugWrite
        }
        case "taskStart" {
            ret Intrinsic.TaskStart
        }
        case "groupStart" {
            ret Intrinsic.GroupStart
        }
        case "atomicLoad" {
            ret Intrinsic.AtomicLoad
        }
        case "atomicStore" {
            ret Intrinsic.AtomicStore
        }
        case "atomicAdd" {
            ret Intrinsic.AtomicAdd
        }
        case "atomicExchange" {
            ret Intrinsic.AtomicExchange
        }
        case "atomicCompareExchange" {
            ret Intrinsic.AtomicCompareExchange
        }
        case "atomicLoadRelaxed" {
            ret Intrinsic.AtomicLoadRelaxed
        }
        case "atomicStoreRelaxed" {
            ret Intrinsic.AtomicStoreRelaxed
        }
        case "atomicAddRelaxed" {
            ret Intrinsic.AtomicAddRelaxed
        }
        case "variableAddress" {
            ret Intrinsic.VariableAddress
        }
        default {
            ret Intrinsic.None
        }
    }
}

// The file that a source file embeds (D470): from its folder.
string embedFile(string source, string name) {
    // On Windows a path has both separators, and the file is named with its own.
    string separator = fs.separator()
    string from = separator == "/" ? source : source.replace("/", "\\")
    i64 slash = from.findLast(separator)
    string folder = slash < 0 ? "" : source.slice(0, slash)
    string joined = folder.len() == 0 ? name : folder + separator + name
    list<string> parts
    for (string part in (separator == "/" ? joined : joined.replace("/", "\\")).split(separator)) {
        if (part == ".") {
            continue
        }
        if (part == ".." && parts.len() > 0 && parts[parts.len() - 1] != "..") {
            parts.remove(parts.len() - 1)
            continue
        }
        parts.add(part)
    }
    ret join(parts, separator)
}

// Why a file cannot be embedded (D470), or "": it is read from the folder of the
// source file that names it.
string embedProblem(string source, string name) {
    string file = embedFile(source, name)
    if (fs.isFolder(file)) {
        ret file + " is a folder"
    }
    if (!fs.isFile(file)) {
        ret "there is no file " + file
    }
    try {
        fs.readBytes(file)
    } catch (Exception e) {
        ret "cannot read " + file
    }
    ret ""
}
