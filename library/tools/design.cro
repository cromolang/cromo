list<string> acrossNames() {
    ret ["Left", "Right", "Stretch", "Center"]
}

list<string> downNames() {
    ret ["Top", "Bottom", "Stretch", "Center"]
}

// What the text of an item is for its kind: 1 its text, 2 its choices, 0 nothing.
i32 textOf(string kind) {
    if (kind == "Label" || kind == "Button" || kind == "TextBox" || kind == "TextArea" || kind == "CheckBox" || kind == "Switch" ||
        kind == "GroupBox") {
        ret 1
    }
    ret kind == "RadioGroup" || kind == "Segmented" || kind == "ComboBox" ? 2 : 0
}

// A group and a panel hold other components.
bool holds(string kind) {
    ret kind == "GroupBox" || kind == "Panel"
}

bool has(ref list<string> names, string name) {
    for (string other in names) {
        if (other == name) {
            ret true
        }
    }
    ret false
}

i64 placeOf(ref list<string> names, string name) {
    for (i64 i = 0; i < names.len(); i++) {
        if (names[i] == name) {
            ret i
        }
    }
    ret 0
}

// The choices written with commas.
list<string> choices(string text) {
    list<string> out
    for (string piece in text.split(",")) {
        if (piece.trim().len() > 0) {
            out.add(piece.trim())
        }
    }
    ret out
}

// ---- The tree of a form ----

// The height of the title bar of the window of a form, or 0 without it.
i32 barOf(Form form) {
    ret form.titleBar ? form.titleBarHeight : 0
}

// The item with a name, or -1.
i64 find(Form form, string name) {
    for (i64 i = 0; i < form.items.len(); i++) {
        if (form.items[i].name == name) {
            ret i
        }
    }
    ret -1
}

// The item that holds another, or -1 for the window.
i64 parentOf(Form form, i64 i) {
    ret form.items[i].parent.len() == 0 ? -1 : find(form, form.items[i].parent)
}

// The left and the top of an item from the content of the window.
i32 leftOf(Form form, i64 i) {
    i64 p = parentOf(form, i)
    ret form.items[i].x + (p >= 0 ? form.items[p].x : 0)
}

i32 topOf(Form form, i64 i) {
    i64 p = parentOf(form, i)
    ret form.items[i].y + (p >= 0 ? form.items[p].y : 0)
}

// The items in the order they are drawn: each one of the window, then what it holds.
list<i64> drawn(Form form) {
    list<i64> order
    for (i64 i = 0; i < form.items.len(); i++) {
        if (parentOf(form, i) < 0) {
            order.add(i)
            for (i64 k = 0; k < form.items.len(); k++) {
                if (parentOf(form, k) == i) {
                    order.add(k)
                }
            }
        }
    }
    ret order
}

// Moves an item with its anchors, for a parent that grew by dw and dh, as std.gui does.
void follow(ref Item item, i32 dw, i32 dh) {
    if (item.horizontal == "Right") {
        item.x += dw
    } else if (item.horizontal == "Stretch") {
        item.width = item.width + dw > 2 * grid ? item.width + dw : 2 * grid
    } else if (item.horizontal == "Center") {
        item.x += dw / 2
    }
    if (item.vertical == "Bottom") {
        item.y += dh
    } else if (item.vertical == "Stretch") {
        item.height = item.height + dh > 2 * grid ? item.height + dh : 2 * grid
    } else if (item.vertical == "Center") {
        item.y += dh / 2
    }
}

// Gives an item of a form its new place and size, from the form before; what it
// holds follows with its anchors.
void reshape(ref Form form, Form from, i64 i, Item changed) {
    i32 dw = changed.width - from.items[i].width
    i32 dh = changed.height - from.items[i].height
    form.items[i] = changed
    for (i64 k = 0; k < from.items.len(); k++) {
        if (parentOf(from, k) == i) {
            Item inner = from.items[k]
            follow(ref inner, dw, dh)
            form.items[k] = inner
        }
    }
}

// A form with another size of its window: its items follow with their anchors.
Form resized(Form from, i32 width, i32 height) {
    Form form = from
    form.width = width
    form.height = height
    for (i64 i = 0; i < from.items.len(); i++) {
        if (parentOf(from, i) < 0) {
            Item item = from.items[i]
            follow(ref item, width - from.width, height - from.height)
            reshape(ref form, from, i, item)
        }
    }
    ret form
}

// ---- The code made from a form ----

bool isLetter(u8 c) {
    ret c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c == '_'
}

// Whether a name can be a field of the struct of the module.
bool isName(string name) {
    if (name.len() == 0 || !isLetter(name[0])) {
        ret false
    }
    for (i64 i = 1; i < name.len(); i++) {
        if (!isLetter(name[i]) && !(name[i] >= '0' && name[i] <= '9')) {
            ret false
        }
    }
    list<string> taken = ["window", "move", "ref", "ret", "for", "if", "else", "switch", "case", "struct", "enum", "import",
        "public", "const", "list", "map", "string", "bool", "true", "false", "try", "catch", "throw", "func", "break", "continue"]
    ret !has(ref taken, name)
}

// What does not let a form become a module, or an empty string.
string problem(Form form) {
    list<string> names
    list<string> known = kinds()
    list<string> across = acrossNames()
    list<string> down = downNames()
    for (Item item in form.items) {
        if (!has(ref known, item.kind)) {
            ret format("'{}' is not a component of the designer", item.kind)
        }
        if (!isName(item.name)) {
            ret format("'{}' cannot be the name of a component: a name has letters, digits and _, and is not a word of Cromo", item.name)
        }
        if (has(ref names, item.name)) {
            ret format("two components are named '{}'", item.name)
        }
        if (!has(ref across, item.horizontal) || !has(ref down, item.vertical)) {
            ret format("'{}' has anchors that std.gui does not have", item.name)
        }
        names.add(item.name)
    }
    if (form.titleBarHeight < 24 || form.titleBarHeight > 96) {
        ret format("the height of the title bar is from 24 to 96, found {}", form.titleBarHeight)
    }
    list<string> icons = iconNames()
    if (form.icon.len() > 0 && !has(ref icons, form.icon)) {
        ret format("'{}' is not an icon of std.gui", form.icon)
    }
    if (form.corner < 0 || form.corner > 64) {
        ret format("the radius of the corners is from 0 to 64, found {}", form.corner)
    }
    for (i64 i = 0; i < form.items.len(); i++) {
        if (form.items[i].parent.len() > 0) {
            i64 p = parentOf(form, i)
            if (p < 0 || !holds(form.items[p].kind) || form.items[p].parent.len() > 0) {
                ret format("'{}' is in '{}', which is not a group or a panel of the window", form.items[i].name, form.items[i].parent)
            }
        }
    }
    ret ""
}

// A text as a literal of Cromo.
string quoted(string text) {
    string out = "\""
    for (i64 i = 0; i < text.len(); i++) {
        u8 c = text[i]
        if (c == '"' || c == '\\') {
            out = out + "\\"
        }
        if (c == 10) {
            out = out + "\\n"
        } else {
            out = out + text.slice(i, i + 1)
        }
    }
    ret out + "\""
}

// The expression that makes the component of an item.
string maker(Item item) {
    string place = format("{}, {}, {}, {}", item.x, item.y, item.width, item.height)
    if (textOf(item.kind) == 1) {
        ret format("gui.{}({}, {})", item.kind, quoted(item.text), place)
    }
    if (textOf(item.kind) == 2) {
        list<string> parts
        for (string choice in choices(item.text)) {
            parts.add(quoted(choice))
        }
        ret format("gui.{}([{}], {})", item.kind, join(parts, ", "), place)
    }
    if (item.kind == "Slider") {
        ret format("gui.Slider(0, 100, {})", place)
    }
    ret format("gui.{}({})", item.kind, place)
}

// The statements that make the components of a form, after its window: with their
// types as variables, or without them as the fields of the module.
void statements(Form form, ref list<string> lines, string indent, bool typed) {
    for (i64 i in drawn(form)) {
        Item item = form.items[i]
        string owner = item.parent.len() > 0 ? item.parent : "window"
        string type = typed ? format("gui.{} ", item.kind) : ""
        lines.add(format("{}{}{} = {}.add({})", indent, type, item.name, owner, maker(item)))
        if (item.horizontal != "Left" || item.vertical != "Top") {
            lines.add(format("{}{}.setAnchor(gui.Horizontal.{}, gui.Vertical.{})", indent, item.name, item.horizontal, item.vertical))
        }
    }
}

// The statements for the title bar and the corners of the window of a form, where they
// are not those of every window.
void frame(Form form, ref list<string> lines, string indent) {
    if (!form.resizable) {
        lines.add(format("{}window.setResizable(false)", indent))
    }
    if (!form.titleBar) {
        lines.add(format("{}window.setTitleBarVisible(false)", indent))
    } else {
        if (form.titleBarHeight != barHeight) {
            lines.add(format("{}window.setTitleBarHeight({})", indent, form.titleBarHeight))
        }
        if (!form.minimize || !form.maximize || !form.close) {
            lines.add(format("{}window.setButtons({}, {}, {})", indent, form.minimize, form.maximize, form.close))
        }
        if (form.iconFile.len() > 0) {
            lines.add(format("{}window.setIconImage(gui.Image(embed({})))", indent, quoted(form.iconFile)))
        } else if (form.icon.len() > 0) {
            lines.add(format("{}window.setIcon(gui.Icon.{})", indent, form.icon))
        }
    }
    if (form.corner > 0) {
        lines.add(format("{}window.setCornerRadius({})", indent, form.corner))
    }
}

// The module of a form: a struct with the window and its components, made by its
// constructor.
string moduleOf(Form form, string source) {
    list<string> lines
    lines.add(format("// Made by cromo design from {}: change the form with cromo design, not this file.", source))
    lines.add("import std.gui")
    lines.add("")
    lines.add(format("// The window of {} and its components.", source))
    lines.add("public struct Form {")
    lines.add("    public gui.Window window")
    for (i64 i in drawn(form)) {
        lines.add(format("    public gui.{} {}", form.items[i].kind, form.items[i].name))
    }
    lines.add("")
    lines.add("    public Form() {")
    lines.add(format("        window = gui.Window({}, {}, {})", quoted(form.title), form.width, form.height))
    frame(form, ref lines, "        ")
    statements(form, ref lines, "        ", false)
    lines.add("    }")
    lines.add("}")
    lines.add("")
    ret join(lines, "\n")
}

// The same window as statements, to paste in a function.
string codeOf(Form form) {
    list<string> lines
    lines.add(format("gui.Window window = gui.Window({}, {}, {})", quoted(form.title), form.width, form.height))
    frame(form, ref lines, "")
    statements(form, ref lines, "", true)
    ret join(lines, "\n")
}

// The file of the module of a form: notes.form gives notes_form.cro, next to it.
string modulePath(string path) {
    if (!path.endsWith(".form")) {
        throw Error(format("{} is not a form: the name of a form ends with .form", path))
    }
    string file = fs.fileName(path)
    string stem = file.slice(0, file.len() - 5)
    if (!isName(stem + "_form")) {
        throw Error(format("{}_form cannot be the name of a module: name the form with letters, digits and _", stem))
    }
    ret path.slice(0, path.len() - 5) + "_form.cro"
}

Form readForm(string path) {
    Form form = json.decode<Form>(fs.readText(path))
    if (form.version != 1) {
        throw Error(format("{} is a form of version {}: this cromo design reads version 1", path, form.version))
    }
    ret form
}

// Writes the form and its module.
void writeForm(Form form, string path) {
    string wrong = problem(form)
    if (wrong.len() > 0) {
        throw Error(wrong)
    }
    string target = modulePath(path)
    fs.writeText(path, json.pretty(form) + "\n")
    fs.writeText(target, moduleOf(form, fs.fileName(path)))
}

// ---- The components on the window of the designer ----

Widget widgetOf(Item item) {
    string k = item.kind
    if (k == "Button") {
        ret Widget.Button(gui.Button(item.text, item.x, item.y, item.width, item.height))
    }
    if (k == "TextBox") {
        ret Widget.TextBox(gui.TextBox(item.text, item.x, item.y, item.width, item.height))
    }
    if (k == "TextArea") {
        ret Widget.TextArea(gui.TextArea(item.text, item.x, item.y, item.width, item.height))
    }
    if (k == "CheckBox") {
        ret Widget.CheckBox(gui.CheckBox(item.text, item.x, item.y, item.width, item.height))
    }
    if (k == "Switch") {
        ret Widget.Switch(gui.Switch(item.text, item.x, item.y, item.width, item.height))
    }
    if (k == "RadioGroup") {
        ret Widget.RadioGroup(gui.RadioGroup(choices(item.text), item.x, item.y, item.width, item.height))
    }
    if (k == "Segmented") {
        ret Widget.Segmented(gui.Segmented(choices(item.text), item.x, item.y, item.width, item.height))
    }
    if (k == "ComboBox") {
        ret Widget.ComboBox(gui.ComboBox(choices(item.text), item.x, item.y, item.width, item.height))
    }
    if (k == "Slider") {
        ret Widget.Slider(gui.Slider(0, 100, item.x, item.y, item.width, item.height))
    }
    if (k == "ProgressBar") {
        gui.ProgressBar bar = gui.ProgressBar(item.x, item.y, item.width, item.height)
        bar.setValue(0.4)
        ret Widget.ProgressBar(bar)
    }
    if (k == "ListView") {
        ret Widget.ListView(gui.ListView(item.x, item.y, item.width, item.height))
    }
    if (k == "Table") {
        ret Widget.Table(gui.Table(item.x, item.y, item.width, item.height))
    }
    if (k == "Canvas") {
        ret Widget.Canvas(gui.Canvas(item.x, item.y, item.width, item.height))
    }
    if (k == "GroupBox") {
        ret Widget.GroupBox(gui.GroupBox(item.text, item.x, item.y, item.width, item.height))
    }
    if (k == "Panel") {
        ret Widget.Panel(gui.Panel(item.x, item.y, item.width, item.height))
    }
    ret Widget.Label(gui.Label(item.text, item.x, item.y, item.width, item.height))
}

void putIn<T : gui.Component>(Holder holder, T made) {
    switch (holder) {
        case Pane(gui.Panel pane) {
            pane.add(made)
        }
        case Group(gui.GroupBox group) {
            group.add(made)
        }
    }
}

// Puts a component just made in its holder.
void attach(Holder holder, Widget widget) {
    switch (widget) {
        case Label(gui.Label made) {
            putIn(holder, made)
        }
        case Button(gui.Button made) {
            putIn(holder, made)
        }
        case TextBox(gui.TextBox made) {
            putIn(holder, made)
        }
