            if (hasInk) {
                made.setTextColor(ink)
            }
            if (hasEdge) {
                made.setBorderColor(edge)
            }
            if (item.corner >= 0) {
                made.setCornerRadius(f32(item.corner))
            }
            if (item.textSize >= 6) {
                made.setTextSize(f32(item.textSize))
            }
        }
        case ProgressBar(gui.ProgressBar made) {
            made.resetLook()
            if (hasFill) {
                made.setBackground(fill)
            }
            if (hasInk) {
                made.setTextColor(ink)
            }
            if (hasEdge) {
                made.setBorderColor(edge)
            }
            if (item.corner >= 0) {
                made.setCornerRadius(f32(item.corner))
            }
            if (item.textSize >= 6) {
                made.setTextSize(f32(item.textSize))
            }
        }
        case ListView(gui.ListView made) {
            made.resetLook()
            if (hasFill) {
                made.setBackground(fill)
            }
            if (hasInk) {
                made.setTextColor(ink)
            }
            if (hasEdge) {
                made.setBorderColor(edge)
            }
            if (item.corner >= 0) {
                made.setCornerRadius(f32(item.corner))
            }
            if (item.textSize >= 6) {
                made.setTextSize(f32(item.textSize))
            }
        }
        case Table(gui.Table made) {
            made.resetLook()
            if (hasFill) {
                made.setBackground(fill)
            }
            if (hasInk) {
                made.setTextColor(ink)
            }
            if (hasEdge) {
                made.setBorderColor(edge)
            }
            if (item.corner >= 0) {
                made.setCornerRadius(f32(item.corner))
            }
            if (item.textSize >= 6) {
                made.setTextSize(f32(item.textSize))
            }
        }
        case Canvas(gui.Canvas made) {
            made.resetLook()
            if (hasFill) {
                made.setBackground(fill)
            }
            if (hasInk) {
                made.setTextColor(ink)
            }
            if (hasEdge) {
                made.setBorderColor(edge)
            }
            if (item.corner >= 0) {
                made.setCornerRadius(f32(item.corner))
            }
            if (item.textSize >= 6) {
                made.setTextSize(f32(item.textSize))
            }
        }
        case GroupBox(gui.GroupBox made) {
            made.resetLook()
            if (hasFill) {
                made.setBackground(fill)
            }
            if (hasInk) {
                made.setTextColor(ink)
            }
            if (hasEdge) {
                made.setBorderColor(edge)
            }
            if (item.corner >= 0) {
                made.setCornerRadius(f32(item.corner))
            }
            if (item.textSize >= 6) {
                made.setTextSize(f32(item.textSize))
            }
        }
        case Panel(gui.Panel made) {
            made.resetLook()
            if (hasFill) {
                made.setBackground(fill)
            }
            if (hasInk) {
                made.setTextColor(ink)
            }
            if (hasEdge) {
                made.setBorderColor(edge)
            }
            if (item.corner >= 0) {
                made.setCornerRadius(f32(item.corner))
            }
            if (item.textSize >= 6) {
                made.setTextSize(f32(item.textSize))
            }
        }
        case IconBox(gui.IconBox made) {
            made.resetLook()
            if (hasFill) {
                made.setBackground(fill)
            }
            if (hasInk) {
                made.setTextColor(ink)
            }
            if (hasEdge) {
                made.setBorderColor(edge)
            }
            if (item.corner >= 0) {
                made.setCornerRadius(f32(item.corner))
            }
            if (item.textSize >= 6) {
                made.setTextSize(f32(item.textSize))
            }
        }
        case ImageBox(gui.ImageBox made) {
            made.resetLook()
            if (hasFill) {
                made.setBackground(fill)
            }
            if (hasInk) {
                made.setTextColor(ink)
            }
            if (hasEdge) {
                made.setBorderColor(edge)
            }
            if (item.corner >= 0) {
                made.setCornerRadius(f32(item.corner))
            }
            if (item.textSize >= 6) {
                made.setTextSize(f32(item.textSize))
            }
        }
        case TextView(gui.TextView made) {
            made.resetLook()
            if (hasFill) {
                made.setBackground(fill)
            }
            if (hasInk) {
                made.setTextColor(ink)
            }
            if (hasEdge) {
                made.setBorderColor(edge)
            }
            if (item.corner >= 0) {
                made.setCornerRadius(f32(item.corner))
            }
        }
        case TabView(gui.TabView made) {
            made.resetLook()
            if (hasFill) {
                made.setBackground(fill)
            }
            if (hasInk) {
