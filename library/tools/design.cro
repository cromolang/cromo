// cromo design and cromo design <file.form> (D523, D524): cromo compiles this program
// with the library of the version in use, and runs it. It is the designer of the
// windows: the components are put on a window with the mouse, moved and resized, alone
// or several together, put in groups and panels, and their properties and their anchors
// written in a panel. Saving writes the form, a file of JSON that the designer opens
// again, and next to it a module of Cromo with the window and its components, made
// again at each save: notes.form gives notes_form.cro. The code of the program, with
// the handlers, is in other files, and is never touched.
//
// The components on the window are the real ones of std.gui, in a panel; a canvas
// over them takes the mouse and draws the selection, and one under them draws the
// window. cromo design --generate <file.form> only writes the module again, without
// a window.
import std.fs
import std.gui
import std.json
import std.os
import std.process
import std.thread
import unsafe

extern "SDL3" {
    bool SDL_SetClipboardText(addr text)
    addr SDL_CreateSystemCursor(u32 kind)
    bool SDL_SetCursor(addr cursor)
}

// A component of a form: its kind is the name of its type in std.gui. Its position is
// from the top left corner of its parent, a group or a panel of the form by its name,
// or the content of the window.
struct Item {
    string kind
    string name
    string text  // or the choices of a combo box, a radio group or a segmented control, with commas
    i32 x
    i32 y
    i32 width
    i32 height
    string horizontal = "Left"  // the anchors: a case of gui.Horizontal and one of gui.Vertical
    string vertical = "Top"
    string parent
}

// A form, as it is in its file: a window, with its size with the title bar, and
// its components in the order they are made.
struct Form {
    i32 version = 1
    string title = "Window"
    i32 width = 480
    i32 height = 360
    bool resizable = true  // the user can resize the window
    bool titleBar = true   // the window has its title bar, with this height and these buttons
    i32 titleBarHeight = 35
    bool minimize = true
    bool maximize = true
    bool close = true
    i32 corner       // the radius of its corners
    string icon      // of Lucide, at the left of the title bar, by its name
    string iconFile  // or an image there: its file, from the folder of the form
    list<Item> items
}

// The component of std.gui that shows an item on the window of the designer.
enum Widget {
    Label(gui.Label made)
    Button(gui.Button made)
    TextBox(gui.TextBox made)
    TextArea(gui.TextArea made)
    CheckBox(gui.CheckBox made)
    Switch(gui.Switch made)
    RadioGroup(gui.RadioGroup made)
    Segmented(gui.Segmented made)
    ComboBox(gui.ComboBox made)
    Slider(gui.Slider made)
    ProgressBar(gui.ProgressBar made)
    ListView(gui.ListView made)
    Table(gui.Table made)
    Canvas(gui.Canvas made)
    GroupBox(gui.GroupBox made)
    Panel(gui.Panel made)
}

// Where a component goes: a panel, as the content of the window, or a group.
enum Holder {
    Pane(gui.Panel pane)
    Group(gui.GroupBox group)
}

// What the handlers of the designer share.
struct Design {
    Form form
    Form view             // what the components show: the form, or the form on a phone
    list<Widget> widgets  // of the items of the view, in their order
    string built          // the kinds and the parents of the items that the widgets were made for
    list<bool> picked     // the items selected
    string path           // of the form, empty until it is saved
    bool dirty            // changed since it was saved
    bool phone            // the preview on a phone: nothing is changed there
    list<Form> undo
    list<Form> redo
    string editing  // the property being written, which is one step to undo
    string code     // shown under the window
    i32 mode        // of the mouse held: 0 nothing, 1 moves the selection, 2-9 resize an item, 20-22 the window, 30 selects in a rectangle
    bool moved      // the mouse held changed the form
    f32 downX
    f32 downY
    f32 nowX
    f32 nowY
    Form before         // the form when the mouse was pressed
    i32 pending         // what waits for the answer on the changes not saved: 1 a new form, 2 opening one
    bool grid = true    // the dots of the grid are shown
    string dotted       // the size of the window that the dots were drawn for, or nothing without them
    list<addr> cursors  // of the system, made by the thread of the windows at the first use
    bool running        // the window made by Run is open
    string pictured     // the file of the image of the icon that was read, as it was asked
    gui.Image picture   // that image
    bool hasPicture
}

// The handles of the window of the designer.
struct Ui {
    gui.Window w
    gui.Canvas back
    gui.Canvas dots
    gui.IconBox badge
    gui.Panel content
    gui.Canvas over
    gui.Label kind
    gui.TextBox name
    gui.TextBox text
    gui.TextBox x
    gui.TextBox y
    gui.TextBox width
    gui.TextBox height
    gui.ComboBox horizontal
    gui.ComboBox vertical
    gui.CheckBox bar
    gui.CheckBox minimize
    gui.CheckBox maximize
    gui.CheckBox close
    gui.CheckBox resizable
    gui.TextBox barSize
    gui.TextBox corner
    gui.ComboBox icon
    gui.TextBox iconFile
    gui.TextArea code
    gui.Label status
    gui.Dialog ask
}

const i32 barHeight = 35    // of the title bar of a window of std.gui
const i32 margin = 28       // around the window, on the canvas
const i32 grid = 4          // the positions and the sizes are multiples of it
const f32 grip = 7          // the side of a handle
const i32 phoneWidth = 360  // the content of the window on a phone, in the preview
const i32 phoneHeight = 740
const i32 areaLeft = 220  // the area of the window, in the designer
const i32 areaTop = 61

list<string> kinds() {
    ret ["Label", "Button", "TextBox", "TextArea", "CheckBox", "Switch", "RadioGroup", "Segmented", "ComboBox", "Slider",
        "ProgressBar", "ListView", "Table", "Canvas", "GroupBox", "Panel"]
}

