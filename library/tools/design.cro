// cromo design and cromo design <file.form> (D523, D524): cromo compiles this program
// with the library of the version in use, and runs it. It is the designer of the
// windows: the components are put on a window with the mouse, moved and resized, alone
// or several together, put in groups and panels, and their properties and their anchors
// written in a panel. Saving writes the form, a file of JSON that the designer opens
// again, and next to it a module of Cromo with the window and its components, made
// again at each save: notes.form gives notes_form.cro. The code of the program, with
// the handlers, is in other files, and is never touched.
//
// The components on the window are the real ones of std.gui, in a panel; a canvas
// over them takes the mouse and draws the selection, and one under them draws the
// window. cromo design --generate <file.form> only writes the module again, without
// a window.
import std.fs
import std.gui
import std.json
import std.os
import std.process
import std.thread
import unsafe

extern "SDL3" {
    bool SDL_SetClipboardText(addr text)
    addr SDL_CreateSystemCursor(u32 kind)
    bool SDL_SetCursor(addr cursor)
}

// A component of a form: its kind is the name of its type in std.gui. Its position is
// from the top left corner of its parent, a group or a panel of the form by its name,
// or the content of the window.
struct Item {
    string kind
    string name
    string text  // or the choices of a combo box, a radio group or a segmented control, with commas
    i32 x
    i32 y
    i32 width
    i32 height
    string horizontal = "Left"  // the anchors: a case of gui.Horizontal and one of gui.Vertical
    string vertical = "Top"
    string parent
    string background  // its look (D540): a color as #RRGGBB or a role of the theme as Accent, or
    string textColor   // nothing for the one of the theme
    string borderColor
    i32 corner = -1             // the radius of its corners, or -1 for the one of its kind
    i32 textSize                // the size of its text, or 0 for the one of the window
    string page                 // the page of the navigation bar that it is on, by its name, in a form with pages
    i32 tab                     // in a tab view or a split: the page or the panel of it that holds the item, from 0
    [[json(skip)]] i32 showing  // of a tab view: the page that the designer shows
}

// A page of the navigation bar of a form: an item of the bar, with its text and its
// icon, and the panel that it shows, a field of the module with this name.
struct Page {
    string name
    string text
    string icon  // of Lucide, by its name
}

// The six colors that a palette is made from (D539), each as #RRGGBB, or nothing for
// the one of the library.
struct Tones {
    string background
    string surface
    string text
    string accent
    string selection
    string danger
}

// A form, as it is in its file: a window, with its size with the title bar, and
// its components in the order they are made.
struct Form {
    i32 version = 1
    string title = "Window"
    i32 width = 480
    i32 height = 360
    bool resizable = true  // the user can resize the window
    bool titleBar = true   // the window has its title bar, with this height and these buttons
    i32 titleBarHeight = 35
    bool minimize = true
    bool maximize = true
    bool close = true
    i32 corner       // the radius of its corners
    string icon      // of Lucide, at the left of the title bar, by its name
    string iconFile  // or an image there: its file, from the folder of the form
    Tones light      // the colors of the window in the light theme and in the dark one,
    Tones dark       // where they are not those of the library
    bool appBar      // the bar at the top of an app, with this title and this icon to open a menu or go back
    string appTitle
    string appIcon
    list<Page> pages  // of its navigation bar: without pages, it has none
    list<Item> items
    [[json(skip)]] i64 shown  // the page that the designer shows
}

// The component of std.gui that shows an item on the window of the designer.
enum Widget {
    Label(gui.Label made)
    Button(gui.Button made)
    TextBox(gui.TextBox made)
    TextArea(gui.TextArea made)
    CheckBox(gui.CheckBox made)
    Switch(gui.Switch made)
    RadioGroup(gui.RadioGroup made)
    Segmented(gui.Segmented made)
    ComboBox(gui.ComboBox made)
    Slider(gui.Slider made)
    ProgressBar(gui.ProgressBar made)
    ListView(gui.ListView made)
    Table(gui.Table made)
    Canvas(gui.Canvas made)
    GroupBox(gui.GroupBox made)
    Panel(gui.Panel made)
    IconBox(gui.IconBox made)
    ImageBox(gui.ImageBox made)
    TextView(gui.TextView made)
    TabView(gui.TabView made)
    Split(gui.Split made)
}

// Where a component goes: a panel, as the content of the window, or a group.
enum Holder {
    Pane(gui.Panel pane)
    Group(gui.GroupBox group)
}

// What the handlers of the designer share.
struct Design {
    Form form
    Form view                    // what the components show: the form, or the form on a phone
    list<Widget> widgets         // of the items of the view, in their order
    list<list<gui.Panel>> panes  // of each of them: the pages of a tab view, the two panels of a split, or none
    string built                 // the kinds and the parents of the items that the widgets were made for
    list<bool> picked            // the items selected
    string path                  // of the form, empty until it is saved
    bool dirty                   // changed since it was saved
    bool phone                   // the preview on a phone: nothing is changed there
    list<Form> undo
    list<Form> redo
    string editing   // the property being written, which is one step to undo
    string code      // shown under the window
    string listed    // the pages that the list of the pages shows
    string outlined  // what the outline shows
    list<i64> rows   // of the outline: the item of each row, or -1 less the page for the row of a page
    i32 mode         // of the mouse held: 0 nothing, 1 moves the selection, 2-9 resize an item, 20-22 the window, 30 selects in a rectangle
    bool moved       // the mouse held changed the form
    f32 downX
    f32 downY
    f32 nowX
    f32 nowY
    Form before         // the form when the mouse was pressed
    i32 pending         // what waits for the answer on the changes not saved: 1 a new form, 2 opening one
    bool grid = true    // the dots of the grid are shown
    string dotted       // the size of the window that the dots were drawn for, or nothing without them
    list<addr> cursors  // of the system, made by the thread of the windows at the first use
    bool running        // the window made by Run is open
    string pictured     // the file of the image of the icon that was read, as it was asked
    gui.Image picture   // that image
    bool hasPicture
    bool dark         // the window is shown in its dark theme
    list<Item> clip   // the components copied
    list<f32> guideX  // the lines that the selection moved is aligned with, across and down
    list<f32> guideY
    i32 pickFor = -1  // the color that the picker chooses: 0 to 2 of the look of a component, 100 to 111 of the window
    f32 pickHue       // from 0 to 360,
    f32 pickSat       // from 0 to 1,
    f32 pickVal       // from 0 to 1
    string pickRole   // or a role of the theme, in place of the three above
    string pickOld    // the color before
    i32 pickDrag      // the mouse held in the picker: 1 on the square, 2 on the strip of the hues
}

// The handles of the window of the designer.
struct Ui {
    gui.Window w
    gui.Panel stage  // the area of the window drawn: what is taller than it scrolls
    gui.Canvas back
    gui.Canvas dots
    gui.IconBox badge
    gui.Panel content
    gui.Canvas over
    gui.Label kind
    gui.TextBox name
    gui.TextBox text
    gui.TextBox x
    gui.TextBox y
    gui.TextBox width
    gui.TextBox height
    gui.ComboBox horizontal
    gui.ComboBox vertical
    gui.CheckBox bar
    gui.CheckBox minimize
    gui.CheckBox maximize
    gui.CheckBox close
    gui.CheckBox resizable
    gui.TextBox barSize
    gui.TextBox corner
    gui.ComboBox icon
    gui.TextBox iconFile
    gui.Segmented pages  // of the properties: the layout, the look, or the pages of the navigation bar
    gui.Panel layout
    gui.Panel look
    gui.Panel paging
    gui.ListView pageList
    gui.TextBox pageName
    gui.TextBox pageText
    gui.ComboBox pageIcon
    gui.IconBox appIcon  // the icon of the app bar drawn on the window
    gui.CheckBox appBar
    gui.TextBox appTitle
    gui.ComboBox appMenu
    gui.ListView outline  // the components of the window, by their pages and their groups
    gui.IconBox nav0      // the icons of the navigation bar drawn on the window
    gui.IconBox nav1
    gui.IconBox nav2
    gui.IconBox nav3
    gui.IconBox nav4
    gui.TextBox background
    gui.TextBox textColor
    gui.TextBox borderColor
    gui.TextBox radius
    gui.TextBox textSize
    gui.Switch darkSwitch        // shows the window in its dark theme
    gui.Canvas backgroundSwatch  // next to the boxes of the colors: they show the color and open the picker
    gui.Canvas textSwatch
    gui.Canvas borderSwatch
    gui.Dialog picker
    gui.Canvas square      // the picker: the saturation across and the value down, of a hue,
    gui.Canvas squareMark  // the ring on it, over it,
    gui.Canvas hues        // the strip of the hues,
    gui.Canvas huesMark
    gui.Canvas sample  // the color chosen, next to the one before,
    gui.TextBox hex
    gui.TextBox red
    gui.TextBox green
    gui.TextBox blue
    gui.ComboBox roles   // a role of the theme, for the look of a component
    gui.Canvas themeRow  // the colors of the theme, to take one
    gui.Canvas lightBackground
    gui.Canvas lightSurface
    gui.Canvas lightText
    gui.Canvas lightAccent
    gui.Canvas lightSelection
    gui.Canvas lightDanger
    gui.Canvas darkBackground
    gui.Canvas darkSurface
    gui.Canvas darkText
    gui.Canvas darkAccent
    gui.Canvas darkSelection
    gui.Canvas darkDanger
    gui.TextArea code
    gui.Label status
    gui.Dialog ask
}

const i32 barHeight = 35    // of the title bar of a window of std.gui
const i32 margin = 28       // around the window, on the canvas
const i32 grid = 4          // the positions and the sizes are multiples of it
const f32 grip = 7          // the side of a handle
const i32 phoneWidth = 360  // the content of the window on a phone, in the preview
const i32 phoneHeight = 740
const i32 areaLeft = 220  // the area of the window, in the designer
const i32 areaTop = 61

list<string> kinds() {
    ret ["Label", "Button", "TextBox", "TextArea", "CheckBox", "Switch", "RadioGroup", "Segmented", "ComboBox", "Slider",
        "ProgressBar", "ListView", "Table", "Canvas", "IconBox", "ImageBox", "TextView", "CameraView", "GroupBox", "Panel",
        "TabView", "Split"]
}

