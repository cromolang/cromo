    ui.pageText.setTooltip("The text of the item of the page on the bar")
    ui.paging.add(gui.Label("Icon", 14, 438, 72, 20))
    ui.pageIcon = ui.paging.add(gui.ComboBox(iconNames(), 88, 434, 162, 28))
    ui.pageIcon.setTooltip("The icon of the item of the page on the bar, of Lucide")
    ui.paging.add(gui.Label("A click on the bar of the window", 14, 480, 236, 20))
    ui.paging.add(gui.Label("shows a page: the components", 14, 500, 236, 20))
    ui.paging.add(gui.Label("added go on the page shown.", 14, 520, 236, 20))

    // The picker of the colors, a dialog.
    ui.picker = gui.Dialog("Color", 480, 388)
    ui.square = ui.picker.add(gui.Canvas(0, 0, 256, 180))
    ui.squareMark = ui.picker.add(gui.Canvas(0, 0, 256, 180))
    ui.hues = ui.picker.add(gui.Canvas(0, 190, 256, 16))
    ui.huesMark = ui.picker.add(gui.Canvas(0, 190, 256, 16))
    ui.sample = ui.picker.add(gui.Canvas(272, 0, 168, 44))
    ui.picker.add(gui.Label("Hex", 272, 60, 44, 20))
    ui.hex = ui.picker.add(gui.TextBox("", 320, 56, 120, 28))
    ui.picker.add(gui.Label("Red", 272, 96, 44, 20))
    ui.red = ui.picker.add(gui.TextBox("", 320, 92, 120, 28))
    ui.picker.add(gui.Label("Green", 272, 132, 44, 20))
    ui.green = ui.picker.add(gui.TextBox("", 320, 128, 120, 28))
    ui.picker.add(gui.Label("Blue", 272, 168, 44, 20))
    ui.blue = ui.picker.add(gui.TextBox("", 320, 164, 120, 28))
    list<string> roleChoices = ["A color"]
    for (string name in roleNames()) {
        roleChoices.add(name)
    }
    ui.picker.add(gui.Label("Role", 272, 204, 44, 20))
    ui.roles = ui.picker.add(gui.ComboBox(roleChoices, 320, 200, 120, 28))
    ui.roles.setTooltip("A color of the theme, which follows the theme of the window and its colors, in place of one that stays")
    ui.picker.add(gui.Label("Theme", 0, 232, 60, 20))
    ui.themeRow = ui.picker.add(gui.Canvas(0, 256, 416, 22))
    ui.themeRow.setTooltip("The colors of the theme of the form: a click takes one")
    drawHues(ui)

    gui.GroupBox source = ui.w.add(gui.GroupBox("Code", 220, 557, 772, 196))
    source.setAnchor(gui.Horizontal.Stretch, gui.Vertical.Bottom)
    ui.code = source.add(gui.TextArea("", 12, 40, 748, 144))
    ui.code.setAnchor(gui.Horizontal.Stretch, gui.Vertical.Stretch)
    gui.Button copy = source.add(gui.Button("Copy all", 664, 4, 96, 26))
    copy.setIcon(gui.Icon.Copy)
    copy.setAnchor(gui.Horizontal.Right, gui.Vertical.Top)
    copy.setTooltip("Copies all the code; to copy a part, select it and press Ctrl+C")
    ui.status = ui.w.add(gui.Label("Choose a component on the left, then move it with the mouse", 14, 761, 1252, 18))
    ui.status.setAnchor(gui.Horizontal.Stretch, gui.Vertical.Bottom)

    ui.ask = gui.Dialog("Changes not saved", 380, 150)
    ui.ask.add(gui.Label("The form has changes that are not saved.", 0, 4, 340, 20))

    // The handlers capture the handles by copy: all of them are made by now.
    i32 at = 0
    for (string kind in kinds()) {
        gui.Button add = tools.add(gui.Button(kind, 12 + at % 2 * 88, 42 + at / 2 * 34, 84, 28))
        add.setTooltip(format("Adds a gui.{} to the window", kind))
        string made = kind
        add.onClick([ui, state, move made]() { state.lock([ui, made](ref Design d) { addItem(ui, ref d, made) }) })
        at++
    }
    list<gui.TextBox> boxes = [ui.name, ui.text, ui.x, ui.y, ui.width, ui.height]
    for (i32 which = 0; which < 6; which++) {
        boxes[which].onChange([ui, state, which](string value) {
            state.lock([ui, which, value](ref Design d) { edited(ui, ref d, which, value) })
        })
    }
    ui.horizontal.onChange([ui, state](i64 index) { state.lock([ui, index](ref Design d) { anchored(ui, ref d, true, index) }) })
    ui.vertical.onChange([ui, state](i64 index) { state.lock([ui, index](ref Design d) { anchored(ui, ref d, false, index) }) })

    ui.bar.onChange([ui, state](bool on) { state.lock([ui, on](ref Design d) { framed(ui, ref d, 0, on, 0) }) })
    ui.minimize.onChange([ui, state](bool on) { state.lock([ui, on](ref Design d) { framed(ui, ref d, 1, on, 0) }) })
    ui.maximize.onChange([ui, state](bool on) { state.lock([ui, on](ref Design d) { framed(ui, ref d, 2, on, 0) }) })
    ui.close.onChange([ui, state](bool on) { state.lock([ui, on](ref Design d) { framed(ui, ref d, 3, on, 0) }) })
    ui.resizable.onChange([ui, state](bool on) { state.lock([ui, on](ref Design d) { framed(ui, ref d, 5, on, 0) }) })
    ui.barSize.onChange([ui, state](string value) {
        state.lock([ui, value](ref Design d) { framed(ui, ref d, 6, false, numberOf(value)) })
    })
    ui.icon.onChange([ui, state](i64 index) { state.lock([ui, index](ref Design d) { framed(ui, ref d, 7, false, i32(index)) }) })
    ui.iconFile.onChange([ui, state](string value) { state.lock([ui, value](ref Design d) { pictured(ui, ref d, value) }) })
    ui.corner.onChange([ui, state](string value) {
        state.lock([ui, value](ref Design d) { framed(ui, ref d, 4, false, numberOf(value)) })
    })
    ui.darkSwitch.onChange([ui, state](bool on) {
        state.lock([ui, on](ref Design d) {
            d.dark = on
            sync(ui, ref d)
        })
    })
    ui.pages.onChange([ui](i64 index) {
        ui.layout.setVisible(index == 0)
        ui.look.setVisible(index == 1)
        ui.paging.setVisible(index == 2)
    })
    ui.appBar.onChange([ui, state](bool on) { state.lock([ui, on](ref Design d) { barred(ui, ref d, 0, on, "") }) })
    ui.appTitle.onChange([ui, state](string value) { state.lock([ui, value](ref Design d) { barred(ui, ref d, 1, false, value) }) })
    ui.appMenu.onChange([ui, state](i64 index) {
        state.lock([ui, index](ref Design d) { barred(ui, ref d, 2, false, iconNames()[index]) })
    })
    ui.outline.onChoose([ui, state](i64 index) {
        state.lock([ui, index](ref Design d) {
            if (d.phone || index < 0 || index >= d.rows.len()) {
                ret
            }
            i64 row = d.rows[index]
            pickNone(ref d)
            string page = row >= 0 ? d.form.items[row].page : d.form.pages[-row - 1].name
            for (i64 k = 0; k < d.form.pages.len(); k++) {
                if (d.form.pages[k].name == page) {
                    d.form.shown = k
                }
            }
            if (row >= 0) {
                d.picked[row] = true
            }
            sync(ui, ref d)
            showProperties(ui, ref d)
        })
    })
    pageAdd.onClick([ui, state]() { state.lock([ui](ref Design d) { paged(ui, ref d, 0) }) })
    pageRemove.onClick([ui, state]() { state.lock([ui](ref Design d) { paged(ui, ref d, 1) }) })
    pageUp.onClick([ui, state]() { state.lock([ui](ref Design d) { paged(ui, ref d, 2) }) })
    pageDown.onClick([ui, state]() { state.lock([ui](ref Design d) { paged(ui, ref d, 3) }) })
    ui.pageList.onChoose([ui, state](i64 index) {
        state.lock([ui, index](ref Design d) {
            if (index >= 0 && index < d.form.pages.len() && !d.phone) {
                d.form.shown = index
                pickNone(ref d)
                sync(ui, ref d)
                showProperties(ui, ref d)
            }
        })
    })
    ui.pageName.onChange([ui, state](string value) { state.lock([ui, value](ref Design d) { pageEdited(ui, ref d, 0, value) }) })
    ui.pageText.onChange([ui, state](string value) { state.lock([ui, value](ref Design d) { pageEdited(ui, ref d, 1, value) }) })
    ui.pageIcon.onChange([ui, state](i64 index) {
        state.lock([ui, index](ref Design d) { pageEdited(ui, ref d, 2, iconNames()[index]) })
    })
    list<gui.TextBox> looks = [ui.background, ui.textColor, ui.borderColor, ui.radius, ui.textSize]
    for (i32 which = 0; which < 5; which++) {
        looks[i64(which)].onChange([ui, state, which](string value) {
            state.lock([ui, which, value](ref Design d) { looked(ui, ref d, which, value) })
        })
    }
    list<gui.Canvas> toneBoxes = tonesOf(ui)
    for (i32 which = 0; which < 12; which++) {
        toneBoxes[i64(which)].onMouseDown([ui, state, which](gui.Mouse m) {
            state.lock([ui, which](ref Design d) { openPicker(ui, ref d, 100 + which) })
        })
    }
    list<gui.Canvas> swatches = [ui.backgroundSwatch, ui.textSwatch, ui.borderSwatch]
    for (i32 which = 0; which < 3; which++) {
        swatches[i64(which)].onMouseDown([ui, state, which](gui.Mouse m) {
            state.lock([ui, which](ref Design d) { openPicker(ui, ref d, which) })
        })
    }
    ui.squareMark.onMouseDown([ui, state](gui.Mouse m) {
        state.lock([ui, m](ref Design d) {
            d.pickDrag = 1
            pickAt(ui, ref d, 1, m.x, m.y)
        })
    })
    ui.squareMark.onMouseMove([ui, state](gui.Mouse m) {
        state.lock([ui, m](ref Design d) {
            if (d.pickDrag == 1) {
                pickAt(ui, ref d, 1, m.x, m.y)
            }
        })
    })
    ui.squareMark.onMouseUp([state](gui.Mouse m) { state.lock([](ref Design d) { d.pickDrag = 0 }) })
    ui.huesMark.onMouseDown([ui, state](gui.Mouse m) {
        state.lock([ui, m](ref Design d) {
            d.pickDrag = 2
            pickAt(ui, ref d, 2, m.x, m.y)
        })
    })
    ui.huesMark.onMouseMove([ui, state](gui.Mouse m) {
        state.lock([ui, m](ref Design d) {
            if (d.pickDrag == 2) {
                pickAt(ui, ref d, 2, m.x, m.y)
            }
        })
    })
    ui.huesMark.onMouseUp([state](gui.Mouse m) { state.lock([](ref Design d) { d.pickDrag = 0 }) })
    ui.themeRow.onMouseDown([ui, state](gui.Mouse m) {
        state.lock([ui, m](ref Design d) {
            i64 index = i64(m.x / 26)
            list<string> names = roleNames()
            if (index < 0 || index >= names.len() || d.pickFor < 0) {
                ret
            }
            if (d.pickFor < 100) {  // the role itself, which follows the theme
                d.pickRole = names[index]
                ui.roles.setSelected(index + 1)
            }
            pickColor(ui, ref d, roleColor(paletteOf(d.form.light, false), names[index]), true)
        })
    })
    ui.roles.onChange([ui, state](i64 index) {
        state.lock([ui, index](ref Design d) {
            d.pickRole = index > 0 ? roleNames()[index - 1] : ""
            if (index > 0) {
                pickColor(ui, ref d, roleColor(paletteOf(d.form.light, false), d.pickRole), true)
            } else {
                showPick(ui, ref d, true)
            }
        })
    })
    ui.hex.onChange([ui, state](string value) {
        state.lock([ui, value](ref Design d) {
            i64 color = hexOf(value)
            if (color >= 0 && d.pickFor >= 0 && color != pickedColor(ref d)) {
                d.pickRole = ""
                ui.roles.setSelected(0)
                pickColor(ui, ref d, color, false)
                ui.red.setText(format("{}", color >> 16 & 0xFF))
                ui.green.setText(format("{}", color >> 8 & 0xFF))
                ui.blue.setText(format("{}", color & 0xFF))
            }
        })
    })
    list<gui.TextBox> parts = [ui.red, ui.green, ui.blue]
    for (i32 which = 0; which < 3; which++) {
        parts[i64(which)].onChange([ui, state, which](string value) {
            state.lock([ui, which, value](ref Design d) {
                i32 number = numberOf(value)
                if (number < 0 || number > 255 || d.pickFor < 0) {
                    ret
                }
                i64 color = pickedColor(ref d)
                i64 shift = which == 0 ? 16 : which == 1 ? 8 : 0
                i64 changed = color - (color >> shift & 0xFF) * (1 << shift) + i64(number) * (1 << shift)
                if (changed != color) {
                    d.pickRole = ""
                    ui.roles.setSelected(0)
                    pickColor(ui, ref d, changed, false)
                    ui.hex.setText(hexText(changed))
                }
            })
        })
    }
    ui.picker.addButton("As the theme", [ui, state]() {
        ui.picker.close()
        state.lock([ui](ref Design d) { pickDone(ui, ref d, false) })
    })
    ui.picker.addButton("Cancel", [ui, state]() {
        ui.picker.close()
        state.lock([](ref Design d) { d.pickFor = -1 })
    })
    ui.picker.addButton("OK", [ui, state]() {
        ui.picker.close()
        state.lock([ui](ref Design d) { pickDone(ui, ref d, true) })
    })

    ui.over.onMouseDown([ui, state](gui.Mouse m) {
        bool menu = false
        state.lock([ui, m, ref menu](ref Design d) {
            if (m.button == 3 && !d.phone) {  // the right button: the component there, and its menu
                i64 hit = itemAt(d.form, m.x - f32(margin), m.y - f32(margin + barOf(d.form) + headOf(d.form)))
                if (hit >= 0 && !d.picked[hit]) {
                    pickNone(ref d)
                    d.picked[hit] = true
                    showProperties(ui, ref d)
                    refresh(ui, ref d)
                }
                menu = true
            } else {
                pressed(ui, ref d, m)
            }
        })
        if (menu) {
            gui.Menu all = editMenu(ui, state)
            all.addSeparator()
            all.addSubmenu("Arrange", arrangeMenu(ui, state))
            ui.w.showMenu(move all)
        }
    })
    ui.over.onMouseMove([ui, state](gui.Mouse m) { state.lock([ui, m](ref Design d) { dragged(ui, ref d, m) }) })
    ui.over.onMouseUp([ui, state](gui.Mouse m) { state.lock([ui](ref Design d) { released(ui, ref d) }) })
    ui.w.onKeyDown([ui, state](gui.Key key) {
        if (key.control && key.code == 115) {  // Ctrl+S
            saveNow(ui, state)
            ret
        }
        if (key.control && (key.code == 110 || key.code == 111)) {  // Ctrl+N, Ctrl+O
            leaving(ui, state, key.code == 110 ? 1 : 2)
            ret
        }
        state.lock([ui, key](ref Design d) {
            if (key.code == 127 || key.code == 8) {
                removePicked(ui, ref d)
            } else if (key.code == 0x40000050) {
                nudge(ui, ref d, -grid, 0)
            } else if (key.code == 0x4000004F) {
                nudge(ui, ref d, grid, 0)
            } else if (key.code == 0x40000052) {
                nudge(ui, ref d, 0, -grid)
            } else if (key.code == 0x40000051) {
                nudge(ui, ref d, 0, grid)
            } else if (key.control && key.code == 122) {  // Ctrl+Z
                undo(ui, ref d, false)
            } else if (key.control && key.code == 121) {  // Ctrl+Y
                undo(ui, ref d, true)
            } else if (key.control && key.code == 97) {  // Ctrl+A
                pickAll(ui, ref d)
            } else if (key.control && key.code == 99) {  // Ctrl+C
                copyPicked(ui, ref d)
            } else if (key.control && key.code == 120) {  // Ctrl+X
                copyPicked(ui, ref d)
                removePicked(ui, ref d)
            } else if (key.control && key.code == 118) {  // Ctrl+V
                paste(ui, ref d)
            } else if (key.control && key.code == 100) {  // Ctrl+D: a copy, and what was copied stays
                list<Item> kept = d.clip
                copyPicked(ui, ref d)
                paste(ui, ref d)
                d.clip = kept
            } else if (key.code == 27) {  // Esc
                pickNone(ref d)
                showProperties(ui, ref d)
                refresh(ui, ref d)
            }
        })
    })
    erase.onClick([ui, state]() { state.lock([ui](ref Design d) { removePicked(ui, ref d) }) })
    back.onClick([ui, state]() { state.lock([ui](ref Design d) { undo(ui, ref d, false) }) })
    again.onClick([ui, state]() { state.lock([ui](ref Design d) { undo(ui, ref d, true) }) })
    edit.onClick([ui, state, edit]() { ui.w.showMenuUnder(editMenu(ui, state), edit) })
    order.onClick([ui, state, order]() { ui.w.showMenuUnder(arrangeMenu(ui, state), order) })
    phone.onChange([ui, state](bool on) {
        state.lock([ui, on](ref Design d) {
            d.phone = on
            d.mode = 0
            pickNone(ref d)
            sync(ui, ref d)
            showProperties(ui, ref d)
            ui.status.setText(on ? format("The window on a phone, {} by {}: the anchors move and stretch its components", d.view.width,
                d.view.height - barOf(d.view)) : "The window as it is designed")
        })
    })
    dotsOn.onChange([ui, state](bool on) {
        state.lock([ui, on](ref Design d) {
            d.grid = on
            refresh(ui, ref d)
        })
    })
    run.onClick([ui, state]() { preview(ui, state) })
    copy.onClick([ui, state]() {
        string code = ""
        state.lock([ref code](ref Design d) { code = d.code })
        SDL_SetClipboardText(code.cstring())
        ui.status.setText("The code is copied: paste it in a function of the program")
    })

    fresh.onClick([ui, state]() { leaving(ui, state, 1) })
    load.onClick([ui, state]() { leaving(ui, state, 2) })
    ui.ask.addButton("Go back", [ui]() { ui.ask.close() })
    ui.ask.addButton("Discard them", [ui, state]() {
        ui.ask.close()
        i32 what = 0
        state.lock([ref what](ref Design d) { what = d.pending })
        leave(ui, state, what)
    })
    storeAs.onClick([ui, state]() { saveAs(ui, state) })
    store.onClick([ui, state]() { saveNow(ui, state) })

    state.lock([ui, path](ref Design d) {
        show(ui, ref d, Form(), "")
        if (path.len() > 0) {
            open(ui, ref d, path)
        }
    })
    ui.w.start()
}

i32 main(list<string> args) {
    if (args.len() == 3 && args[1] == "--generate") {
        try {
            Form form = readForm(args[2])
            writeForm(form, args[2])
            println("{}", modulePath(args[2]))
        } catch (Exception e) {
            eprintln("cromo design: {}", e.message())
            ret 1
        }
        ret 0
    }
    if (args.len() > 2 || args.len() == 2 && args[1].startsWith("-")) {
        eprintln("cromo design: cromo design takes at most a form, as cromo design notes.form, or --generate and a form")
        ret 2
    }
    design(args.len() == 2 ? args[1] : "")
    ret 0
}
