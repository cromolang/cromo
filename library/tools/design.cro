}

// Gives to a component the text, the position and the size of its item.
void place(Widget widget, Item item) {
    dress(widget, item)
    switch (widget) {
        case Label(gui.Label made) {
            made.setText(item.text)
            made.setPosition(item.x, item.y)
            made.setSize(item.width, item.height)
        }
        case Button(gui.Button made) {
            made.setText(item.text)
            made.setPosition(item.x, item.y)
            made.setSize(item.width, item.height)
        }
        case TextBox(gui.TextBox made) {
