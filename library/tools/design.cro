// Gives a component of the designer the look of its item (D540).
void dress(Widget widget, Item item) {
    gui.Color fill
    gui.Color ink
    gui.Color edge
    bool hasFill = colorOf(item.background, ref fill)
    bool hasInk = colorOf(item.textColor, ref ink)
    bool hasEdge = colorOf(item.borderColor, ref edge)
    switch (widget) {
        case Label(gui.Label made) {
            made.resetLook()
            if (hasFill) {
                made.setBackground(fill)
            }
            if (hasInk) {
                made.setTextColor(ink)
            }
            if (hasEdge) {
                made.setBorderColor(edge)
            }
            if (item.corner >= 0) {
                made.setCornerRadius(f32(item.corner))
            }
            if (item.textSize >= 6) {
                made.setTextSize(f32(item.textSize))
            }
        }
        case Button(gui.Button made) {
            made.resetLook()
            if (hasFill) {
                made.setBackground(fill)
            }
            if (hasInk) {
