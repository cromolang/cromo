list<string> acrossNames() {
    ret ["Left", "Right", "Stretch", "Center"]
}

list<string> downNames() {
    ret ["Top", "Bottom", "Stretch", "Center"]
}

// What the text of an item is for its kind: 1 its text, 2 its choices, 0 nothing.
i32 textOf(string kind) {
    if (kind == "Label" || kind == "Button" || kind == "TextBox" || kind == "TextArea" || kind == "CheckBox" || kind == "Switch" ||
        kind == "GroupBox" || kind == "IconBox" || kind == "ImageBox" || kind == "Split") {  // an icon, a file, Across or Down
        ret 1
    }
    if (kind == "TabView") {  // the titles of its pages
        ret 2
    }
    ret kind == "RadioGroup" || kind == "Segmented" || kind == "ComboBox" ? 2 : 0
}

// A group and a panel hold other components.
bool holds(string kind) {
    ret kind == "GroupBox" || kind == "Panel" || kind == "TabView" || kind == "Split"
}

bool has(ref list<string> names, string name) {
    for (string other in names) {
        if (other == name) {
            ret true
        }
    }
    ret false
}

i64 placeOf(ref list<string> names, string name) {
    for (i64 i = 0; i < names.len(); i++) {
        if (names[i] == name) {
            ret i
        }
    }
    ret 0
}

// The choices written with commas.
list<string> choices(string text) {
    list<string> out
    for (string piece in text.split(",")) {
        if (piece.trim().len() > 0) {
            out.add(piece.trim())
        }
    }
    ret out
}

// ---- The tree of a form ----

// The height of the title bar of the window of a form, or 0 without it.
i32 barOf(Form form) {
    ret form.titleBar ? form.titleBarHeight : 0
}

// The item with a name, or -1.
const i32 navHeight = 56  // of a navigation bar of std.gui, on a computer
const i32 appHeight = 44  // of an app bar

// The room that the navigation bar of a form takes at the bottom of its content.
i32 navOf(Form form) {
    ret form.pages.len() > 0 ? navHeight : 0
}

// The page that the designer shows, by its name: nothing in a form without pages.
string pageNow(Form form) {
    if (form.pages.len() == 0) {
        ret ""
    }
    ret form.pages[form.shown < form.pages.len() ? form.shown : 0].name
}

// Whether an item is on the page shown, of the navigation bar and of the tab views
// that hold it.
bool onPage(Form form, i64 i) {
    if (form.pages.len() > 0 && form.items[i].page != pageNow(form)) {
        ret false
    }
    i64 child = i
    i64 p = parentOf(form, i)
    for (i64 depth = 0; p >= 0 && depth < 32; depth++) {  // on the page shown of each tab view around it
        if (form.items[p].kind == "TabView" && form.items[child].tab != form.items[p].showing) {
            ret false
        }
        child = p
        p = parentOf(form, p)
    }
    ret true
}

bool hasKind(Form form, string kind) {
    for (Item item in form.items) {
        if (item.kind == kind) {
            ret true
        }
    }
    ret false
}

// The room that the app bar of a form takes over its pages: the components of the
// window itself are from the top of the content, under the bar.
i32 headOf(Form form) {
    ret form.appBar && form.pages.len() > 0 ? appHeight : 0
}

i64 find(Form form, string name) {
    for (i64 i = 0; i < form.items.len(); i++) {
        if (form.items[i].name == name) {
            ret i
        }
    }
    ret -1
}

// The item that holds another, or -1 for the window.
i64 parentOf(Form form, i64 i) {
    ret form.items[i].parent.len() == 0 ? -1 : find(form, form.items[i].parent)
}

// The left and the top of an item from the content of the window.
// Where the panel 'tab' of a tab view or of a split is, from its top left corner:
// the pages of a tab view are under its band, and the second panel of a split after
// the first and the gap between them. Nothing for a group or a panel.
i32 paneLeft(Item holder, i32 tab) {
    if (holder.kind == "TabView") {
        ret 1
    }
    if (holder.kind == "Split" && holder.text != "Down" && tab > 0) {
        ret (holder.width - 8) / 2 + 8
    }
    ret 0
}

i32 paneTop(Item holder, i32 tab) {
    if (holder.kind == "TabView") {
        ret 32
    }
    if (holder.kind == "Split" && holder.text == "Down" && tab > 0) {
        ret (holder.height - 8) / 2 + 8
    }
    ret 0
}

i32 leftOf(Form form, i64 i) {
    i32 left = form.items[i].x
    i64 child = i
    i64 p = parentOf(form, i)
    for (i64 depth = 0; p >= 0 && depth < 32; depth++) {  // a group can be in a group
        left += form.items[p].x + paneLeft(form.items[p], form.items[child].tab)
        child = p
        p = parentOf(form, p)
    }
    ret left
}

i32 topOf(Form form, i64 i) {
    i32 top = form.items[i].y
    i64 child = i
    i64 p = parentOf(form, i)
    for (i64 depth = 0; p >= 0 && depth < 32; depth++) {
        top += form.items[p].y + paneTop(form.items[p], form.items[child].tab)
        child = p
        p = parentOf(form, p)
    }
    ret top
}

// How many groups and panels an item is inside.
i64 depthOf(Form form, i64 i) {
    i64 depth = 0
    i64 p = parentOf(form, i)
    for (p >= 0 && depth < 32) {
        depth++
        p = parentOf(form, p)
    }
    ret depth
}

// Whether a group or a panel that holds an item, at any depth, is among those marked.
bool heldBy(Form form, i64 i, list<bool> marked) {
    i64 p = parentOf(form, i)
    for (i64 depth = 0; p >= 0 && depth < 32; depth++) {
        if (marked[p]) {
            ret true
        }
        p = parentOf(form, p)
    }
    ret false
}

// The items in the order they are made: each group before what it holds.
void under(Form form, i64 parent, ref list<i64> order, i64 depth) {
    for (i64 i = 0; i < form.items.len(); i++) {
        if (parentOf(form, i) == parent) {
            order.add(i)
            if (depth < 32) {
                under(form, i, ref order, depth + 1)
            }
        }
    }
}

// The items in the order they are drawn: each one of the window, then what it holds.
list<i64> drawn(Form form) {
    list<i64> order
    under(form, -1, ref order, 0)
    ret order
}

// Moves an item with its anchors, for a parent that grew by dw and dh, as std.gui does.
void follow(ref Item item, i32 dw, i32 dh) {
    if (item.horizontal == "Right") {
        item.x += dw
    } else if (item.horizontal == "Stretch") {
        item.width = item.width + dw > 2 * grid ? item.width + dw : 2 * grid
    } else if (item.horizontal == "Center") {
        item.x += dw / 2
    }
    if (item.vertical == "Bottom") {
        item.y += dh
    } else if (item.vertical == "Stretch") {
        item.height = item.height + dh > 2 * grid ? item.height + dh : 2 * grid
    } else if (item.vertical == "Center") {
        item.y += dh / 2
    }
}

// Gives an item of a form its new place and size, from the form before; what it
// holds follows with its anchors.
void reshape(ref Form form, Form from, i64 i, Item changed) {
    i32 dw = changed.width - from.items[i].width
    i32 dh = changed.height - from.items[i].height
    form.items[i] = changed
    for (i64 k = 0; k < from.items.len(); k++) {
        if (parentOf(from, k) == i) {
            Item inner = from.items[k]
            follow(ref inner, dw, dh)
            form.items[k] = inner
        }
    }
}

// A form with another size of its window: its items follow with their anchors.
Form resized(Form from, i32 width, i32 height) {
    Form form = from
    form.width = width
    form.height = height
    for (i64 i = 0; i < from.items.len(); i++) {
        if (parentOf(from, i) < 0) {
            Item item = from.items[i]
            follow(ref item, width - from.width, height - from.height)
            reshape(ref form, from, i, item)
        }
    }
    ret form
}

// ---- The code made from a form ----

bool isLetter(u8 c) {
    ret c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c == '_'
}

// Whether a name can be a field of the struct of the module.
bool isName(string name) {
    if (name.len() == 0 || !isLetter(name[0])) {
        ret false
    }
    for (i64 i = 1; i < name.len(); i++) {
        if (!isLetter(name[i]) && !(name[i] >= '0' && name[i] <= '9')) {
            ret false
        }
    }
    list<string> taken = ["window", "move", "ref", "ret", "for", "if", "else", "switch", "case", "struct", "enum", "import",
        "public", "const", "list", "map", "string", "bool", "true", "false", "try", "catch", "throw", "func", "break", "continue"]
    ret !has(ref taken, name)
}

// What does not let a form become a module, or an empty string.
string problem(Form form) {
    list<string> names
    list<string> known = kinds()
    list<string> across = acrossNames()
    list<string> down = downNames()
    list<string> iconsKnown = iconNames()
    for (Item item in form.items) {
        if (!has(ref known, item.kind)) {
            ret format("'{}' is not a component of the designer", item.kind)
        }
        if (!isName(item.name)) {
            ret format("'{}' cannot be the name of a component: a name has letters, digits and _, and is not a word of Cromo", item.name)
        }
        if (has(ref names, item.name)) {
            ret format("two components are named '{}'", item.name)
        }
        if (!has(ref across, item.horizontal) || !has(ref down, item.vertical)) {
            ret format("'{}' has anchors that std.gui does not have", item.name)
        }
        if (item.kind == "IconBox" && item.text.len() > 0 && !has(ref iconsKnown, item.text)) {
            ret format("'{}' is not an icon of std.gui", item.text)
        }
        if (form.appBar && item.name == "appBar" || item.kind != "CameraView" && item.name == "camera" && hasKind(form, "CameraView")) {
            ret format("'{}' is the name of the app bar, or of the camera, of the form", item.name)
        }
        if (item.kind == "Split" && item.text != "Across" && item.text != "Down") {
            ret format("the split '{}' is Across or Down, found '{}'", item.name, item.text)
        }
        if (item.kind == "TabView" && choices(item.text).len() == 0) {
            ret format("the tab view '{}' has no pages: its text has their titles, with commas", item.name)
        }
        names.add(item.name)
    }
    if (form.appIcon.len() > 0 && !has(ref iconsKnown, form.appIcon)) {
        ret format("'{}' is not an icon of std.gui", form.appIcon)
    }
    list<string> icons = iconNames()
    list<string> pages
    for (Page page in form.pages) {
        if (!isName(page.name) || page.name == "bar" || page.name == "window") {
            ret format("'{}' cannot be the name of a page: a name has letters, digits and _, and is not a word of Cromo, bar or window", page.name)
        }
        if (has(ref names, page.name) || has(ref pages, page.name)) {
            ret format("two components or pages are named '{}'", page.name)
        }
        if (page.icon.len() > 0 && !has(ref icons, page.icon)) {
            ret format("'{}' is not an icon of std.gui", page.icon)
        }
        pages.add(page.name)
    }
    for (Item item in form.items) {
        if (form.pages.len() > 0 && (item.name == "bar" || !has(ref pages, item.page))) {
            ret format("'{}' is not on a page of the navigation bar, or is named bar as the bar", item.name)
        }
    }
    if (form.titleBarHeight < 24 || form.titleBarHeight > 96) {
        ret format("the height of the title bar is from 24 to 96, found {}", form.titleBarHeight)
    }
    if (form.icon.len() > 0 && !has(ref icons, form.icon)) {
        ret format("'{}' is not an icon of std.gui", form.icon)
    }
    if (form.corner < 0 || form.corner > 64) {
        ret format("the radius of the corners is from 0 to 64, found {}", form.corner)
    }
    for (i64 i = 0; i < form.items.len(); i++) {
        if (form.items[i].parent.len() > 0) {
            i64 p = parentOf(form, i)
            if (p < 0 || !holds(form.items[p].kind)) {
                ret format("'{}' is in '{}', which is not a group or a panel of the window", form.items[i].name, form.items[i].parent)
            }
            i64 panes = form.items[p].kind == "TabView" ? choices(form.items[p].text).len() : form.items[p].kind == "Split" ? 2 : 1
            if (form.items[i].tab < 0 || i64(form.items[i].tab) >= panes) {
                ret format("'{}' is in the page or the panel {} of '{}', which has {}", form.items[i].name, form.items[i].tab,
                    form.items[i].parent, panes)
            }
            i64 up = p
            for (i64 depth = 0; up >= 0; depth++) {  // a group is not inside itself
                if (up == i || depth > 32) {
                    ret format("'{}' is inside itself, through '{}'", form.items[i].name, form.items[i].parent)
                }
                up = parentOf(form, up)
            }
        }
    }
    ret ""
}

// A text as a literal of Cromo.
string quoted(string text) {
    string out = "\""
    for (i64 i = 0; i < text.len(); i++) {
        u8 c = text[i]
        if (c == '"' || c == '\\') {
            out = out + "\\"
        }
        if (c == 10) {
            out = out + "\\n"
        } else {
            out = out + text.slice(i, i + 1)
        }
    }
    ret out + "\""
}

// The expression that makes the component of an item.
list<string> roleNames() {
    ret ["Background", "Surface", "SurfaceHover", "SurfacePressed", "Text", "TextSecondary", "TextFaint", "Line",
        "Border", "Accent", "AccentStrong", "AccentSoft", "Selection", "SelectionSoft", "OnAccent", "Danger"]
}

// The number of a color written as #RRGGBB, or RRGGBB: -1 for another text.
i64 hexOf(string text) {
    string digits = text.trim()
    if (digits.startsWith("#")) {
        digits = digits.slice(1, digits.len())
    }
    if (digits.len() != 6) {
        ret -1
    }
    i64 value = 0
    for (i64 i = 0; i < 6; i++) {
        u8 c = digits[i]
        u8 lower = c | 0x20
        if (c >= '0' && c <= '9') {
            value = value * 16 + i64(c - '0')
        } else if (lower >= 'a' && lower <= 'f') {
            value = value * 16 + i64(lower - 'a') + 10
        } else {
            ret -1
        }
    }
    ret value
}

// A color of a property of the look, #RRGGBB or a role of the theme as Accent, as the
// code that makes it: nothing for a text that is not a color.
string colorCode(string text) {
    string wanted = text.trim().lower()
    for (string name in roleNames()) {
        if (name.lower() == wanted) {
            ret format("gui.role(gui.Role.{})", name)
        }
    }
    i64 value = hexOf(text)
    if (value < 0) {
        ret ""
    }
    ret format("gui.rgb(0x{})", format("{:06x}", value).upper())
}

// The palette that a form makes for a theme, as its window would have it.
gui.Palette paletteOf(Tones tones, bool dark) {
    list<string> written = [tones.background, tones.surface, tones.text, tones.accent, tones.selection, tones.danger]
    list<i64> normal = [0xEDF1F4, 0xFFFFFF, 0x18212A, 0xB4761C, 0x2F6E8F, 0xB0453C]
    if (dark) {
        normal = [0x0F1418, 0x171D22, 0xE3E9ED, 0xE0A64A, 0x6FB2D2, 0xE0786D]
    }
    list<u32> colors
    bool own = false
    for (i64 i = 0; i < 6; i++) {
        i64 value = hexOf(written[i])
        own = own || value >= 0
        colors.add(u32(value >= 0 ? value : normal[i]))
    }
    if (!own) {
        ret dark ? gui.darkPalette() : gui.lightPalette()
    }
    ret gui.palette(colors[0], colors[1], colors[2], colors[3], colors[4], colors[5])
}

// The color of a role in a palette, by its name in any case: -1 for another name.
i64 roleColor(gui.Palette from, string name) {
    switch (name.trim().lower()) {
        case "background" {
            ret from.background
        }
        case "surface" {
            ret from.surface
        }
        case "surfacehover" {
            ret from.surfaceHover
        }
        case "surfacepressed" {
            ret from.surfacePressed
        }
        case "text" {
            ret from.text
        }
        case "textsecondary" {
            ret from.textSecondary
        }
        case "textfaint" {
            ret from.textFaint
        }
        case "line" {
            ret from.line
        }
        case "border" {
            ret from.border
        }
        case "accent" {
            ret from.accent
        }
        case "accentstrong" {
            ret from.accentStrong
        }
        case "accentsoft" {
            ret from.accentSoft
        }
        case "selection" {
            ret from.selection
        }
        case "selectionsoft" {
            ret from.selectionSoft
        }
        case "onaccent" {
            ret from.onAccent
        }
        case "danger" {
            ret from.danger
        }
    }
    ret -1
}

// A color written in a property, as its number in the light theme of the form: -1
// for a text that is not a color.
i64 shownColor(Form form, string text) {
    i64 value = roleColor(paletteOf(form.light, false), text)
    if (value >= 0) {
        ret value
    }
    ret hexOf(text)
}

string hexText(i64 value) {
    ret "#" + format("{:06x}", value).upper()
}

// A color from its hue, from 0 to 360, its saturation and its value, from 0 to 1.
i64 fromHsv(f32 hue, f32 sat, f32 val) {
    f32 h = hue / 60
    i64 sector = i64(h) % 6
    f32 part = h - f32(i64(h))
    f32 low = val * (1 - sat)
    f32 down = val * (1 - sat * part)
    f32 up = val * (1 - sat * (1 - part))
    f32 r = val
    f32 g = up
    f32 b = low
    if (sector == 1) {
        r = down
        g = val
        b = low
    } else if (sector == 2) {
        r = low
        g = val
        b = up
    } else if (sector == 3) {
        r = low
        g = down
        b = val
    } else if (sector == 4) {
        r = up
        g = low
        b = val
    } else if (sector == 5) {
        r = val
        g = low
        b = down
    }
    ret i64(r * 255 + 0.5) << 16 | i64(g * 255 + 0.5) << 8 | i64(b * 255 + 0.5)
}

// The hue, the saturation and the value of a color; a gray keeps the hue given.
void toHsv(i64 color, ref f32 hue, ref f32 sat, ref f32 val) {
    f32 r = f32(color >> 16 & 0xFF) / 255
    f32 g = f32(color >> 8 & 0xFF) / 255
    f32 b = f32(color & 0xFF) / 255
    f32 most = r > g ? (r > b ? r : b) : (g > b ? g : b)
    f32 least = r < g ? (r < b ? r : b) : (g < b ? g : b)
    f32 span = most - least
    val = most
    sat = most > 0 ? span / most : 0
    if (span <= 0) {
        ret
    }
    if (most == r) {
        hue = 60 * ((g - b) / span)
    } else if (most == g) {
        hue = 60 * ((b - r) / span + 2)
    } else {
        hue = 60 * ((r - g) / span + 4)
    }
    if (hue < 0) {
        hue += 360
    }
}

// Dark or white, whichever is read better on a color.
gui.Color inkOn(i64 color) {
    f32 light = 0.299 * f32(color >> 16 & 0xFF) + 0.587 * f32(color >> 8 & 0xFF) + 0.114 * f32(color & 0xFF)
    ret light > 150 ? gui.rgb(0x18212A) : gui.rgb(0xFFFFFF)
}

// A swatch: the color of a property with its name on it, or the word for the one of
// the theme, in a box that the mouse opens the picker from.
void paint(gui.Canvas swatch, f32 width, i64 color, string label) {
    gui.Drawing d
    d.roundRect(0, 0, width, 28, 4, gui.rgb(0xC2CDD5))
    if (color >= 0) {
        d.roundRect(1, 1, width - 2, 26, 3, gui.rgb(u32(color)))
        if (label.len() > 0) {
            d.text(label, width / 2, 14, 11, inkOn(color), gui.Horizontal.Center)
        }
    } else {
        d.roundRect(1, 1, width - 2, 26, 3, gui.rgb(0xFFFFFF))
        d.line(4, 24, width - 4, 4, 1, gui.rgb(0xC2CDD5))  // no color of its own
        if (label.len() > 0) {
            d.text(label, width / 2, 14, 11, gui.rgb(0x7A8B99), gui.Horizontal.Center)
        }
    }
    swatch.setDrawing(move d)
}

// ---- The picker of the colors ----

const f32 squareWidth = 256
const f32 squareHeight = 180

// The square of the picker for a hue: the saturation grows to the right, the value
// to the top, in cells of 4 pixels.
void drawSquare(Ui ui, f32 hue) {
    gui.Drawing d
    for (i64 row = 0; row < 45; row++) {
        for (i64 column = 0; column < 64; column++) {
            i64 color = fromHsv(hue, (f32(column) + 0.5) / 64, 1 - (f32(row) + 0.5) / 45)
            d.rect(f32(column) * 4, f32(row) * 4, 4, 4, gui.rgb(u32(color)))
        }
    }
    ui.square.setDrawing(move d)
}

void drawHues(Ui ui) {
    gui.Drawing d
    for (i64 x = 0; x < 128; x++) {
        d.rect(f32(x) * 2, 0, 2, 16, gui.rgb(u32(fromHsv(f32(x) * 360 / 128, 1, 1))))
    }
    ui.hues.setDrawing(move d)
}

// The color that the picker has now, as its number.
i64 pickedColor(ref Design d) {
    if (d.pickRole.len() > 0) {
        i64 value = roleColor(paletteOf(d.form.light, false), d.pickRole)
        if (value >= 0) {
            ret value
        }
    }
    ret fromHsv(d.pickHue, d.pickSat, d.pickVal)
}

// Shows the choice of the picker: the marks on the square and on the strip, the
// sample next to the color of before, and, with 'boxes', the numbers in the boxes.
void showPick(Ui ui, ref Design d, bool boxes) {
    i64 color = pickedColor(ref d)
    gui.Drawing ring
    f32 x = d.pickSat * squareWidth
    f32 y = (1 - d.pickVal) * squareHeight
    ring.ring(x, y, 7, 2, gui.rgb(0xFFFFFF))
    ring.ring(x, y, 8, 1, gui.rgb(0x18212A))
    ui.squareMark.setDrawing(move ring)
    gui.Drawing mark
    f32 at = d.pickHue / 360 * squareWidth
    mark.frame(at - 3, 0, 6, 16, 2, gui.rgb(0xFFFFFF))
    mark.frame(at - 4, 0, 8, 16, 1, gui.rgb(0x18212A))
    ui.huesMark.setDrawing(move mark)
    gui.Drawing both
    both.roundRect(0, 0, 168, 44, 5, gui.rgb(0xC2CDD5))
    both.roundRect(1, 1, 166, 42, 4, gui.rgb(u32(color)))
    both.text(d.pickRole.len() > 0 ? d.pickRole : hexText(color), 60, 22, 12, inkOn(color), gui.Horizontal.Center)
    i64 before = shownColor(d.form, d.pickOld)
    if (before >= 0) {
        both.rect(120, 1, 47, 42, gui.rgb(u32(before)))
        both.text("before", 143, 22, 10, inkOn(before), gui.Horizontal.Center)
    }
    ui.sample.setDrawing(move both)
    if (boxes) {
        ui.hex.setText(hexText(color))
        ui.red.setText(format("{}", color >> 16 & 0xFF))
        ui.green.setText(format("{}", color >> 8 & 0xFF))
        ui.blue.setText(format("{}", color & 0xFF))
    }
}

// Gives the picker a color, as its number.
void pickColor(Ui ui, ref Design d, i64 color, bool boxes) {
    f32 hue = d.pickHue
    toHsv(color, ref d.pickHue, ref d.pickSat, ref d.pickVal)
    if (d.pickHue != hue) {
        drawSquare(ui, d.pickHue)
    }
    showPick(ui, ref d, boxes)
}

// The mouse on the square, 1, or on the strip of the hues, 2, of the picker.
void pickAt(Ui ui, ref Design d, i32 where, f32 x, f32 y) {
    f32 across = x < 0 ? 0 : x > squareWidth ? squareWidth : x
    if (where == 1) {
        f32 down = y < 0 ? 0 : y > squareHeight ? squareHeight : y
        d.pickSat = across / squareWidth
        d.pickVal = 1 - down / squareHeight
    } else {
        d.pickHue = across >= squareWidth ? 359.9 : across / squareWidth * 360
        drawSquare(ui, d.pickHue)
    }
    d.pickRole = ""
    ui.roles.setSelected(0)
    showPick(ui, ref d, true)
}

// Opens the picker for a color: 0 the background of the component selected, 1 the
// color of its text, 2 the one of its border; 100 to 111 a color of the window.
void openPicker(Ui ui, ref Design d, i32 target) {
    i64 one = single(d)
    if (d.phone || target < 100 && one < 0 || target >= 100 && pickedCount(d) > 0) {
        ret
    }
    string now = ""
    if (target == 0) {
        now = d.form.items[one].background
    } else if (target == 1) {
        now = d.form.items[one].textColor
    } else if (target == 2) {
        now = d.form.items[one].borderColor
    } else {
        list<string> tones = tonesText(d.form)
        now = tones[i64(target) - 100]
    }
    d.pickFor = target
    d.pickOld = now
    d.pickDrag = 0
    d.pickRole = ""
    list<string> names = roleNames()
    i64 role = 0
    for (i64 i = 0; i < names.len(); i++) {
        if (names[i].lower() == now.trim().lower()) {
            d.pickRole = names[i]
            role = i + 1
        }
    }
    ui.roles.setEnabled(target < 100)
    ui.roles.setSelected(role)
    i64 color = shownColor(d.form, now)
    if (color < 0 && target >= 100) {  // the one of the library
        gui.Palette normal = paletteOf(Tones(), target >= 106)
        list<u32> six = [normal.background, normal.surface, normal.text, normal.accent, normal.selection, normal.danger]
        color = i64(six[i64(target - 100) % 6])
    }
    if (color < 0) {
        color = 0x2F6E8F
    }
    d.pickHue = 200
    toHsv(color, ref d.pickHue, ref d.pickSat, ref d.pickVal)
    drawSquare(ui, d.pickHue)
    gui.Drawing row  // the colors of the theme of the form, to take one
    gui.Palette theme = paletteOf(d.form.light, false)
    for (i64 i = 0; i < names.len(); i++) {
        row.roundRect(f32(i) * 26, 0, 22, 22, 4, gui.rgb(0xC2CDD5))
        row.roundRect(f32(i) * 26 + 1, 1, 20, 20, 3, gui.rgb(u32(roleColor(theme, names[i]))))
    }
    ui.themeRow.setDrawing(move row)
    ui.picker.setTitle(target == 0 ? "Background" : target == 1 ? "Color of the text" : target == 2 ? "Color of the border" :
        target < 106 ? "Color of the light theme" : "Color of the dark theme")
    showPick(ui, ref d, true)
    ui.w.showDialog(ui.picker)
}

// The six colors of each theme of a form, as they are written.
list<string> tonesText(Form form) {
    ret [form.light.background, form.light.surface, form.light.text, form.light.accent, form.light.selection,
        form.light.danger, form.dark.background, form.dark.surface, form.dark.text, form.dark.accent,
        form.dark.selection, form.dark.danger]
}

// The picker is done: with 'keep' its color goes to the property, as a role or as
// #RRGGBB; without, the property is the one of the theme again.
void pickDone(Ui ui, ref Design d, bool keep) {
    i32 target = d.pickFor
    d.pickFor = -1
    if (target < 0) {
        ret
    }
    string value = ""
    if (keep) {
        value = d.pickRole.len() > 0 && target < 100 ? d.pickRole : hexText(pickedColor(ref d))
    }
    if (target < 100) {
        looked(ui, ref d, target, value)
    } else {
        toned(ui, ref d, target - 100, value)
    }
    showProperties(ui, ref d)
}

// The same color for a component of the designer: false for a text that is not a color.
bool colorOf(string text, ref gui.Color color) {
    switch (text.trim().lower()) {
        case "background" {
            color = gui.role(gui.Role.Background)
            ret true
        }
        case "surface" {
            color = gui.role(gui.Role.Surface)
            ret true
        }
        case "surfacehover" {
            color = gui.role(gui.Role.SurfaceHover)
            ret true
        }
        case "surfacepressed" {
            color = gui.role(gui.Role.SurfacePressed)
            ret true
        }
        case "text" {
            color = gui.role(gui.Role.Text)
            ret true
        }
        case "textsecondary" {
            color = gui.role(gui.Role.TextSecondary)
            ret true
        }
        case "textfaint" {
            color = gui.role(gui.Role.TextFaint)
            ret true
        }
        case "line" {
            color = gui.role(gui.Role.Line)
            ret true
        }
        case "border" {
            color = gui.role(gui.Role.Border)
            ret true
        }
        case "accent" {
            color = gui.role(gui.Role.Accent)
            ret true
        }
        case "accentstrong" {
            color = gui.role(gui.Role.AccentStrong)
            ret true
        }
        case "accentsoft" {
            color = gui.role(gui.Role.AccentSoft)
            ret true
        }
        case "selection" {
            color = gui.role(gui.Role.Selection)
            ret true
        }
        case "selectionsoft" {
            color = gui.role(gui.Role.SelectionSoft)
            ret true
        }
        case "onaccent" {
            color = gui.role(gui.Role.OnAccent)
            ret true
        }
        case "danger" {
            color = gui.role(gui.Role.Danger)
            ret true
        }
    }
    i64 value = hexOf(text)
    if (value < 0) {
        ret false
    }
    color = gui.rgb(u32(value))
    ret true
}

// The palette of the six colors of a form, as the code that makes it: those that are
// not written are the ones of the library.
string paletteCode(Tones tones, bool dark) {
    list<string> written = [tones.background, tones.surface, tones.text, tones.accent, tones.selection, tones.danger]
    list<i64> normal = [0xEDF1F4, 0xFFFFFF, 0x18212A, 0xB4761C, 0x2F6E8F, 0xB0453C]
    if (dark) {
        normal = [0x0F1418, 0x171D22, 0xE3E9ED, 0xE0A64A, 0x6FB2D2, 0xE0786D]
    }
    list<string> colors
    bool own = false
    for (i64 i = 0; i < 6; i++) {
        i64 value = hexOf(written[i])
        own = own || value >= 0
        colors.add(format("0x{}", format("{:06x}", value >= 0 ? value : normal[i]).upper()))
    }
    if (!own) {
        ret dark ? "gui.darkPalette()" : "gui.lightPalette()"
    }
    ret format("gui.palette({})", join(colors, ", "))
}

string maker(Item item) {
    string place = format("{}, {}, {}, {}", item.x, item.y, item.width, item.height)
    if (item.kind == "TabView") {
        ret format("gui.TabView({})", place)
    }
    if (item.kind == "Split") {
        ret format("gui.Split(gui.Direction.{}, {})", item.text == "Down" ? "Down" : "Across", place)
    }
    if (item.kind == "IconBox") {
        ret format("gui.IconBox(gui.Icon.{}, {})", item.text.len() > 0 ? item.text : "None", place)
    }
    if (item.kind == "ImageBox") {
        ret format("gui.ImageBox(\"\", {})", place)
    }
    if (item.kind == "CameraView") {
        ret format("gui.CameraView(camera, {})", place)
    }
    if (textOf(item.kind) == 1) {
        ret format("gui.{}({}, {})", item.kind, quoted(item.text), place)
    }
    if (textOf(item.kind) == 2) {
        list<string> parts
        for (string choice in choices(item.text)) {
            parts.add(quoted(choice))
        }
        ret format("gui.{}([{}], {})", item.kind, join(parts, ", "), place)
    }
    if (item.kind == "Slider") {
        ret format("gui.Slider(0, 100, {})", place)
    }
    ret format("gui.{}({})", item.kind, place)
}

// The statements that make the components of a form, after its window: with their
// types as variables, or without them as the fields of the module.
void statements(Form form, ref list<string> lines, string indent, bool typed) {
    if (form.appBar) {  // the bar at the top of an app
        lines.add(format("{}{}appBar = window.add(gui.AppBar({}))", indent, typed ? "gui.AppBar " : "", quoted(form.appTitle)))
        if (form.appIcon.len() > 0 && form.appIcon != "None") {
            lines.add(format("{}appBar.setNavigation(gui.Icon.{})", indent, form.appIcon))
        }
    }
    if (hasKind(form, "CameraView")) {  // the camera that the views of the form show
        lines.add(format("{}{}camera = gui.Camera(gui.CameraSide.Back)", indent, typed ? "gui.Camera " : ""))
    }
    if (form.pages.len() > 0) {  // the navigation bar and its pages, which are panels
        lines.add(format("{}{}bar = window.navigationBar()", indent, typed ? "gui.NavigationBar " : ""))
        for (Page page in form.pages) {
            lines.add(format("{}{}{} = bar.addPage({}, gui.Icon.{})", indent, typed ? "gui.Panel " : "", page.name, quoted(page.text),
                page.icon.len() > 0 ? page.icon : "None"))
        }
    }
    for (i64 i in drawn(form)) {
        Item item = form.items[i]
        string owner = item.parent.len() > 0 ? item.parent : item.page.len() > 0 && form.pages.len() > 0 ? item.page : "window"
        i64 holder = parentOf(form, i)
        if (holder >= 0 && form.items[holder].kind == "TabView") {  // in one of its pages
            owner = format("{}Page{}", item.parent, item.tab + 1)
        } else if (holder >= 0 && form.items[holder].kind == "Split") {
            owner = format("{}.{}()", item.parent, item.tab > 0 ? "second" : "first")
        }
        string type = typed ? format("gui.{} ", item.kind) : ""
        lines.add(format("{}{}{} = {}.add({})", indent, type, item.name, owner, maker(item)))
        if (item.horizontal != "Left" || item.vertical != "Top") {
            lines.add(format("{}{}.setAnchor(gui.Horizontal.{}, gui.Vertical.{})", indent, item.name, item.horizontal, item.vertical))
        }
        if (item.kind == "TabView") {  // its pages, which are panels
            list<string> titles = choices(item.text)
            for (i64 k = 0; k < titles.len(); k++) {
                lines.add(format("{}{}{}Page{} = {}.addPage({})", indent, typed ? "gui.Panel " : "", item.name, k + 1, item.name,
                    quoted(titles[k])))
            }
        }
        if (item.kind == "ImageBox" && item.text.len() > 0) {  // its image goes in the program
            lines.add(format("{}{}.setBytes(embed({}))", indent, item.name, quoted(item.text)))
        }
        if (colorCode(item.background).len() > 0) {  // its look (D540)
            lines.add(format("{}{}.setBackground({})", indent, item.name, colorCode(item.background)))
        }
        if (colorCode(item.textColor).len() > 0) {
            lines.add(format("{}{}.setTextColor({})", indent, item.name, colorCode(item.textColor)))
        }
        if (colorCode(item.borderColor).len() > 0) {
            lines.add(format("{}{}.setBorderColor({})", indent, item.name, colorCode(item.borderColor)))
        }
        if (item.corner >= 0) {
            lines.add(format("{}{}.setCornerRadius({})", indent, item.name, item.corner))
        }
        if (item.textSize >= 6) {
            lines.add(format("{}{}.setTextSize({})", indent, item.name, item.textSize))
        }
    }
}

// The statements for the title bar and the corners of the window of a form, where they
// are not those of every window.
void frame(Form form, ref list<string> lines, string indent) {
    if (!form.resizable) {
        lines.add(format("{}window.setResizable(false)", indent))
    }
    if (!form.titleBar) {
        lines.add(format("{}window.setTitleBarVisible(false)", indent))
    } else {
        if (form.titleBarHeight != barHeight) {
            lines.add(format("{}window.setTitleBarHeight({})", indent, form.titleBarHeight))
        }
        if (!form.minimize || !form.maximize || !form.close) {
            lines.add(format("{}window.setButtons({}, {}, {})", indent, form.minimize, form.maximize, form.close))
        }
        if (form.iconFile.len() > 0) {
            lines.add(format("{}window.setIconImage(gui.Image(embed({})))", indent, quoted(form.iconFile)))
        } else if (form.icon.len() > 0) {
            lines.add(format("{}window.setIcon(gui.Icon.{})", indent, form.icon))
        }
    }
    if (form.corner > 0) {
        lines.add(format("{}window.setCornerRadius({})", indent, form.corner))
    }
    string light = paletteCode(form.light, false)
    string dark = paletteCode(form.dark, true)
    if (light != "gui.lightPalette()" || dark != "gui.darkPalette()") {  // its own colors (D539)
        lines.add(format("{}window.setPalette({}, {})", indent, light, dark))
    }
}

// The module of a form: a struct with the window and its components, made by its
// constructor.
string moduleOf(Form form, string source) {
    list<string> lines
    lines.add(format("// Made by cromo design from {}: change the form with cromo design, not this file.", source))
    lines.add("import std.gui")
    lines.add("")
    lines.add(format("// The window of {} and its components.", source))
    lines.add("public struct Form {")
    lines.add("    public gui.Window window")
    if (form.appBar) {
        lines.add("    public gui.AppBar appBar")
    }
    if (hasKind(form, "CameraView")) {
        lines.add("    public gui.Camera camera")
    }
    if (form.pages.len() > 0) {
        lines.add("    public gui.NavigationBar bar")
        for (Page page in form.pages) {
            lines.add(format("    public gui.Panel {}", page.name))
        }
    }
    for (i64 i in drawn(form)) {
        lines.add(format("    public gui.{} {}", form.items[i].kind, form.items[i].name))
        if (form.items[i].kind == "TabView") {
            for (i64 k = 0; k < choices(form.items[i].text).len(); k++) {
                lines.add(format("    public gui.Panel {}Page{}", form.items[i].name, k + 1))
            }
        }
    }
    lines.add("")
    lines.add("    public Form() {")
    lines.add(format("        window = gui.Window({}, {}, {})", quoted(form.title), form.width, form.height))
    frame(form, ref lines, "        ")
    statements(form, ref lines, "        ", false)
    lines.add("    }")
    lines.add("}")
    lines.add("")
    ret join(lines, "\n")
}

// The same window as statements, to paste in a function.
string codeOf(Form form) {
    list<string> lines
    lines.add(format("gui.Window window = gui.Window({}, {}, {})", quoted(form.title), form.width, form.height))
    frame(form, ref lines, "")
    statements(form, ref lines, "", true)
    ret join(lines, "\n")
}

// The file of the module of a form: notes.form gives notes_form.cro, next to it.
string modulePath(string path) {
    if (!path.endsWith(".form")) {
        throw Error(format("{} is not a form: the name of a form ends with .form", path))
    }
    string file = fs.fileName(path)
    string stem = file.slice(0, file.len() - 5)
    if (!isName(stem + "_form")) {
        throw Error(format("{}_form cannot be the name of a module: name the form with letters, digits and _", stem))
    }
    ret path.slice(0, path.len() - 5) + "_form.cro"
}

Form readForm(string path) {
    Form form = json.decode<Form>(fs.readText(path))
    if (form.version != 1) {
        throw Error(format("{} is a form of version {}: this cromo design reads version 1", path, form.version))
    }
    ret form
}

// Writes the form and its module.
void writeForm(Form form, string path) {
    string wrong = problem(form)
    if (wrong.len() > 0) {
        throw Error(wrong)
    }
    string target = modulePath(path)
    fs.writeText(path, json.pretty(form) + "\n")
    fs.writeText(target, moduleOf(form, fs.fileName(path)))
}

// ---- The components on the window of the designer ----

Widget widgetOf(Item item) {
    string k = item.kind
    if (k == "Button") {
        ret Widget.Button(gui.Button(item.text, item.x, item.y, item.width, item.height))
    }
    if (k == "TextBox") {
        ret Widget.TextBox(gui.TextBox(item.text, item.x, item.y, item.width, item.height))
    }
    if (k == "TextArea") {
        ret Widget.TextArea(gui.TextArea(item.text, item.x, item.y, item.width, item.height))
    }
    if (k == "CheckBox") {
        ret Widget.CheckBox(gui.CheckBox(item.text, item.x, item.y, item.width, item.height))
    }
    if (k == "Switch") {
        ret Widget.Switch(gui.Switch(item.text, item.x, item.y, item.width, item.height))
    }
    if (k == "RadioGroup") {
        ret Widget.RadioGroup(gui.RadioGroup(choices(item.text), item.x, item.y, item.width, item.height))
    }
    if (k == "Segmented") {
        ret Widget.Segmented(gui.Segmented(choices(item.text), item.x, item.y, item.width, item.height))
    }
    if (k == "ComboBox") {
        ret Widget.ComboBox(gui.ComboBox(choices(item.text), item.x, item.y, item.width, item.height))
    }
    if (k == "Slider") {
        ret Widget.Slider(gui.Slider(0, 100, item.x, item.y, item.width, item.height))
    }
    if (k == "ProgressBar") {
        gui.ProgressBar bar = gui.ProgressBar(item.x, item.y, item.width, item.height)
        bar.setValue(0.4)
        ret Widget.ProgressBar(bar)
    }
    if (k == "ListView") {
        ret Widget.ListView(gui.ListView(item.x, item.y, item.width, item.height))
    }
    if (k == "Table") {
        ret Widget.Table(gui.Table(item.x, item.y, item.width, item.height))
    }
    if (k == "Canvas") {
        ret Widget.Canvas(gui.Canvas(item.x, item.y, item.width, item.height))
    }
    if (k == "GroupBox") {
        ret Widget.GroupBox(gui.GroupBox(item.text, item.x, item.y, item.width, item.height))
    }
    if (k == "IconBox") {
        list<string> names = iconNames()
        ret Widget.IconBox(gui.IconBox(iconValues()[placeOf(ref names, item.text)], item.x, item.y, item.width, item.height))
    }
    if (k == "ImageBox") {  // its image is not read: its place is drawn
        ret Widget.ImageBox(gui.ImageBox("", item.x, item.y, item.width, item.height))
    }
    if (k == "TextView") {
        ret Widget.TextView(gui.TextView(item.x, item.y, item.width, item.height))
    }
    if (k == "CameraView") {  // no camera is opened by the designer: its place is drawn
        ret Widget.Canvas(gui.Canvas(item.x, item.y, item.width, item.height))
    }
    if (k == "TabView") {
        ret Widget.TabView(gui.TabView(item.x, item.y, item.width, item.height))
    }
    if (k == "Split") {
        ret Widget.Split(gui.Split(item.text == "Down" ? gui.Direction.Down : gui.Direction.Across, item.x, item.y, item.width,
            item.height))
    }
    if (k == "Panel") {
        ret Widget.Panel(gui.Panel(item.x, item.y, item.width, item.height))
    }
    ret Widget.Label(gui.Label(item.text, item.x, item.y, item.width, item.height))
}

void putIn<T : gui.Component>(Holder holder, T made) {
    switch (holder) {
        case Pane(gui.Panel pane) {
            pane.add(made)
        }
        case Group(gui.GroupBox group) {
            group.add(made)
        }
    }
}

// Puts a component just made in its holder.
void attach(Holder holder, Widget widget) {
    switch (widget) {
        case Label(gui.Label made) {
