            }
            if (item.corner >= 0) {
                made.setCornerRadius(f32(item.corner))
            }
        }
        case Split(gui.Split made) {
            made.resetLook()
        }
    }
}

// A component that is no longer of the form is hidden: std.gui keeps its components
// until the program ends.
void hide(Widget widget) {
    switch (widget) {
        case Label(gui.Label made) {
            made.setVisible(false)
        }
        case Button(gui.Button made) {
            made.setVisible(false)
        }
        case TextBox(gui.TextBox made) {
            made.setVisible(false)
        }
        case TextArea(gui.TextArea made) {
            made.setVisible(false)
        }
        case CheckBox(gui.CheckBox made) {
            made.setVisible(false)
        }
        case Switch(gui.Switch made) {
            made.setVisible(false)
        }
        case RadioGroup(gui.RadioGroup made) {
            made.setVisible(false)
        }
        case Segmented(gui.Segmented made) {
            made.setVisible(false)
        }
        case ComboBox(gui.ComboBox made) {
            made.setVisible(false)
        }
        case Slider(gui.Slider made) {
            made.setVisible(false)
        }
        case ProgressBar(gui.ProgressBar made) {
            made.setVisible(false)
        }
        case ListView(gui.ListView made) {
            made.setVisible(false)
        }
        case Table(gui.Table made) {
            made.setVisible(false)
        }
        case Canvas(gui.Canvas made) {
            made.setVisible(false)
        }
        case GroupBox(gui.GroupBox made) {
            made.setVisible(false)
        }
        case Panel(gui.Panel made) {
            made.setVisible(false)
        }
        case IconBox(gui.IconBox made) {
            made.setVisible(false)
        }
        case ImageBox(gui.ImageBox made) {
            made.setVisible(false)
        }
        case TextView(gui.TextView made) {
            made.setVisible(false)
        }
        case TabView(gui.TabView made) {
            made.setVisible(false)
        }
        case Split(gui.Split made) {
            made.setVisible(false)
        }
    }
}

// The holder that a widget is, for what it holds.
// The panels of a component that has them, made once: the pages of a tab view, by
// its titles, and the two panels of a split.
list<gui.Panel> panesOf(Widget widget, Item item) {
    list<gui.Panel> panes
    switch (widget) {
        case TabView(gui.TabView made) {
            for (string title in choices(item.text)) {
                panes.add(made.addPage(title))
            }
            if (i64(item.showing) < panes.len()) {
                made.setSelected(i64(item.showing))
            }
        }
        case Split(gui.Split made) {
            panes.add(made.first())
            panes.add(made.second())
        }
        default {
        }
    }
    ret panes
}

Holder holderOf(Widget widget, gui.Panel content) {
    switch (widget) {
        case GroupBox(gui.GroupBox made) {
            ret Holder.Group(made)
        }
        case Panel(gui.Panel made) {
            ret Holder.Pane(made)
        }
        default {
            ret Holder.Pane(content)
        }
    }
}

// The kinds and the parents of the items: while they stay, the widgets stay too.
string shapeOf(Form form) {
    string out = ""
    for (i64 i = 0; i < form.items.len(); i++) {
        Item item = form.items[i]
        string panes = item.kind == "TabView" || item.kind == "Split" ? item.text : ""  // its pages, or its direction
        out = out + format("{}<{}.{}{};", item.kind, parentOf(form, i), item.tab, panes)
    }
    ret out
}

// Shows the form as it is now: the widgets, the drawings, the properties and the code.
void sync(Ui ui, ref Design d) {
    // A phone of its height: no title bar there.
    i32 tall = phoneHeight  // the stage scrolls
    d.view = d.phone ? resized(d.form, phoneWidth, tall + barOf(d.form)) : d.form
    string shape = shapeOf(d.view)
    if (shape != d.built) {
        for (Widget widget in d.widgets) {
            hide(widget)
        }
        d.widgets.clear()
        d.panes.clear()
        for (ref Item item in d.view.items) {
            d.widgets.add(widgetOf(item))
        }
        for (i64 i = 0; i < d.view.items.len(); i++) {
            d.panes.add(panesOf(d.widgets[i], d.view.items[i]))
        }
        for (i64 i = 0; i < d.view.items.len(); i++) {
            i64 p = parentOf(d.view, i)
            Holder holder = Holder.Pane(ui.content)
            if (p >= 0 && d.panes[p].len() > 0) {  // in a page of a tab view, or in a panel of a split
                i64 pane = i64(d.view.items[i].tab)
                holder = Holder.Pane(d.panes[p][pane < d.panes[p].len() ? pane : 0])
            } else if (p >= 0) {
                holder = holderOf(d.widgets[p], ui.content)
            }
            attach(holder, d.widgets[i])
            dress(d.widgets[i], d.view.items[i])
        }
        d.built = shape
    } else {
        for (i64 i = 0; i < d.view.items.len(); i++) {
            place(d.widgets[i], d.view.items[i])
        }
    }
    for (i64 i = 0; i < d.view.items.len(); i++) {
        reveal(d.widgets[i], onPage(d.view, i))
    }
    for (d.picked.len() < d.form.items.len()) {
        d.picked.add(false)
    }
    for (d.picked.len() > d.form.items.len()) {
        d.picked.remove(d.picked.len() - 1)
    }
    string code = codeOf(d.form)
    if (code != d.code) {
        d.code = code
        ui.code.setText(code)
    }
    showPath(ui, ref d)
    refresh(ui, ref d)
}

// ---- The selection ----

i64 pickedCount(Design d) {
    i64 n = 0
    for (bool one in d.picked) {
        if (one) {
            n++
        }
    }
    ret n
}

// The only item selected, or -1.
i64 single(Design d) {
    if (pickedCount(d) != 1) {
        ret -1
    }
    for (i64 i = 0; i < d.picked.len(); i++) {
        if (d.picked[i]) {
            ret i
        }
    }
    ret -1
}

void pickNone(ref Design d) {
    for (i64 i = 0; i < d.picked.len(); i++) {
        d.picked[i] = false
    }
}

// Whether an item moves by itself: it is selected, and what holds it is not.
// How far the selection, moved by 'by' across or down, is pulled to be aligned with
// an edge or the middle of a component that stays, or of the window: at most 5
// pixels, and the line it is aligned with goes in 'lines'.
i32 guide(Design d, bool across, i32 by, i32 room, ref list<f32> lines) {
    i32 low = 100000
    i32 top = -100000
    for (i64 i = 0; i < d.before.items.len(); i++) {
        if (leads(d, d.before, i)) {
            i32 start = across ? leftOf(d.before, i) : topOf(d.before, i)
            i32 size = across ? d.before.items[i].width : d.before.items[i].height
            low = start < low ? start : low
            top = start + size > top ? start + size : top
        }
    }
    if (top < low) {
        ret 0
    }
    list<i32> mine = [low + by, (low + top) / 2 + by, top + by]
    list<i32> theirs = [0, room / 2, room]
    for (i64 i = 0; i < d.before.items.len(); i++) {
        if (d.picked[i] || heldBy(d.before, i, d.picked) || !onPage(d.before, i)) {
            continue
        }
        i32 start = across ? leftOf(d.before, i) : topOf(d.before, i)
        i32 size = across ? d.before.items[i].width : d.before.items[i].height
        theirs.add(start)
        theirs.add(start + size / 2)
        theirs.add(start + size)
    }
    i32 best = 6
    i32 pulled = 0
    i32 line = 0
    for (i32 edge in mine) {
        for (i32 other in theirs) {
            i32 far = other > edge ? other - edge : edge - other
            if (far < best) {
                best = far
                pulled = other - edge
                line = other
            }
        }
    }
    if (best <= 5) {
        lines.add(f32(line))
        ret pulled
    }
    ret 0
}

bool leads(Design d, Form form, i64 i) {
    ret d.picked[i] && !heldBy(form, i, d.picked)
}

// ---- The drawing ----

// The centers of the eight handles of a rectangle, from the top left corner clockwise.
list<f32> handles(f32 l, f32 t, f32 w, f32 h) {
    f32 r = l + w
    f32 b = t + h
    ret [l, t, (l + r) / 2, t, r, t, r, (t + b) / 2, r, b, (l + r) / 2, b, l, b, l, (t + b) / 2]
}

void square(ref gui.Drawing marks, f32 x, f32 y, gui.Color color) {
    marks.rect(x - grip / 2, y - grip / 2, grip, grip, gui.rgb(0xFFFFFF))
    marks.frame(x - grip / 2, y - grip / 2, grip, grip, 1, color)
}

// The file of the image of the icon, from the folder of the form when it is not whole.
string pictureFile(Design d) {
    string file = d.form.iconFile
    bool whole = file.startsWith("/") || file.len() > 1 && file[1] == ':'
    string folder = d.path.len() > 0 ? fs.parent(d.path) : ""
    ret whole || folder.len() == 0 || file.len() == 0 ? file : folder + "/" + file
}

// Reads the image of the icon when its file is another one: an image that cannot be
// read is said, and not shown.
void readPicture(Ui ui, ref Design d) {
    string file = d.form.titleBar ? pictureFile(d) : ""
    if (file == d.pictured) {
        ret
    }
    d.pictured = file
    d.hasPicture = false
    if (file.len() > 0) {
        try {
            d.picture = gui.Image(fs.readBytes(file))
            d.hasPicture = true
        } catch (Exception e) {
            ui.status.setText(format("The image of the icon: {}", e.message()))
        }
    }
}

// The window under the components, and the selection over them.
void refresh(Ui ui, ref Design d) {
    i32 wide = d.view.width
    i32 high = d.view.height - barOf(d.view)
    i32 gap = d.phone ? 0 : barOf(d.view)
    i32 head = headOf(d.view)
    readPicture(ui, ref d)
    list<string> icons = iconNames()
    bool badge = !d.phone && d.view.titleBar && !d.hasPicture && d.view.icon.len() > 0
    ui.badge.setVisible(badge)
    if (badge) {
        ui.badge.setIcon(iconValues()[placeOf(ref icons, d.view.icon)])
        ui.badge.setPosition(margin + 10, margin + d.view.titleBarHeight / 2 - 8)
    }
    i32 nav = navOf(d.view)
    // The window drawn has the colors of the form, of the theme shown, as it will have.
    gui.Palette shown = paletteOf(d.dark ? d.view.dark : d.view.light, d.dark)
    ui.content.setPalette(shown, shown)
    ui.badge.setTextColor(gui.rgb(shown.textSecondary))
    // The canvases are as large as the window drawn with its margins, and at least as
    // the stage: what goes below the stage scrolls with it.
    i32 across = ui.stage.width() > wide + 2 * margin ? ui.stage.width() : wide + 2 * margin
    i32 tall = ui.stage.height() > d.view.height + 2 * margin ? ui.stage.height() : d.view.height + 2 * margin
    ui.back.setSize(across, tall)
    ui.dots.setSize(across, tall)
    ui.over.setSize(across, tall)
    ui.content.setPosition(margin, margin + gap + head)
    ui.content.setSize(wide, high - nav - head)
    gui.Drawing window
    f32 left = f32(margin)
    f32 top = f32(margin)
    window.rect(0, 0, 4000, 4000, gui.rgb(0xDCE2E7))
    if (d.phone) {
        window.roundRect(left - 10, top - 10, f32(wide) + 20, f32(high) + 20, 26, gui.rgb(0x1B2229))
        window.rect(left, top, f32(wide), f32(high), gui.rgb(shown.background))
    } else {
        f32 round = f32(d.view.corner)
        f32 all = f32(d.view.height)
        for (i32 k = 0; k < 6; k++) {  // a soft shadow
            window.roundRect(left - f32(k), top - f32(k) + 3, f32(wide) + 2 * f32(k), all + 2 * f32(k), round + 6, gui.rgba(0x1B2229, 8))
        }
        window.roundRect(left - 1, top - 1, f32(wide) + 2, all + 2, round + 1, gui.rgb(0xAEB9C2))
        window.roundRect(left, top, f32(wide), all, round, gui.rgb(shown.background))
        if (d.view.titleBar) {
            gui.Color ink = gui.rgb(shown.textSecondary)
            f32 bar = f32(d.view.titleBarHeight)
            window.roundRect(left, top, f32(wide), bar, round, gui.rgb(shown.surface))
            if (round < bar) {  // square where it meets the content
                window.rect(left, top + round, f32(wide), bar - round, gui.rgb(shown.surface))
            }
            window.rect(left, top + bar - 1, f32(wide), 1, gui.rgb(shown.line))
            window.text(d.view.title, left + f32(wide) / 2, top + bar / 2, 12, ink, gui.Horizontal.Center)
            if (d.hasPicture) {
                window.image(d.picture, left + 10, top + bar / 2 - 8, 16, 16)
            }
            f32 x = left + f32(wide) - 23  // the buttons, from the right: each is 46 wide
            f32 y = top + bar / 2
            if (d.view.close) {
                window.line(x - 5, y - 5, x + 5, y + 5, 1, ink)
                window.line(x - 5, y + 5, x + 5, y - 5, 1, ink)
                x = x - 46
            }
            if (d.view.maximize) {
                window.frame(x - 5, y - 5, 10, 10, 1, ink)
                x = x - 46
            }
            if (d.view.minimize) {
                window.line(x - 5, y, x + 5, y, 1, ink)
            }
        }
    }
    bool menu = d.view.appBar && d.view.appIcon.len() > 0 && d.view.appIcon != "None"
    ui.appIcon.setVisible(menu)
    if (d.view.appBar) {  // the app bar, at the top of the content
        f32 barTop = top + f32(gap)
        window.rect(left, barTop, f32(wide), f32(appHeight), gui.rgb(shown.surface))
        window.rect(left, barTop + f32(appHeight) - 1, f32(wide), 1, gui.rgb(shown.line))
        window.text(d.view.appTitle, left + (menu ? 52 : 16), barTop + f32(appHeight) / 2, 15, gui.rgb(shown.text), gui.Horizontal.Left)
        if (menu) {
            ui.appIcon.setIcon(iconValues()[placeOf(ref icons, d.view.appIcon)])
            ui.appIcon.setPosition(margin + 14, margin + gap + appHeight / 2 - 10)
            ui.appIcon.setTextColor(gui.rgb(shown.textSecondary))
        }
    }
    list<gui.IconBox> navIcons = [ui.nav0, ui.nav1, ui.nav2, ui.nav3, ui.nav4]
    i64 count = d.view.pages.len()
    if (count > 0) {  // the navigation bar, at the bottom of the content: its items choose the page shown
        f32 barTop = top + f32(gap + high - nav)
        window.rect(left, barTop, f32(wide), f32(nav), gui.rgb(shown.surface))
        window.rect(left, barTop, f32(wide), 1, gui.rgb(shown.line))
        f32 each = f32(wide) / f32(count)
        i64 now = d.view.shown < count ? d.view.shown : 0
        for (i64 k = 0; k < count; k++) {
            f32 middle = left + each * (f32(k) + 0.5)
            bool chosen = k == now
            if (chosen) {
                window.roundRect(middle - 28, barTop + 6, 56, 26, 13, gui.rgb(shown.accentSoft))
            }
            window.text(d.view.pages[k].text, middle, barTop + 42, 11,
                chosen ? gui.rgb(shown.accentStrong) : gui.rgb(shown.textSecondary), gui.Horizontal.Center)
        }
    }
    for (i64 k = 0; k < 5; k++) {
        bool there = k < count && d.view.pages[k].icon.len() > 0 && d.view.pages[k].icon != "None"
        navIcons[k].setVisible(there)
        if (there) {
            f32 each = f32(wide) / f32(count)
            navIcons[k].setIcon(iconValues()[placeOf(ref icons, d.view.pages[k].icon)])
            navIcons[k].setPosition(margin + i32(each * (f32(k) + 0.5)) - 10, margin + gap + high - nav + 9)
            i64 now = d.view.shown < count ? d.view.shown : 0
            navIcons[k].setTextColor(gui.rgb(k == now ? shown.accentStrong : shown.textSecondary))
        }
    }
    ui.back.setDrawing(move window)
    string dotted = d.grid && !d.phone ? format("{}x{}x{}x{}x{}", wide, high, nav, head, shown.border) : ""
    if (dotted != d.dotted) {  // a dot every two steps of the grid, as in the designers of forms
        d.dotted = dotted
        gui.Drawing points
        if (dotted.len() > 0) {
            gui.Color dot = gui.rgb(shown.border)
            for (i32 y = 2 * grid; y < high - nav - head; y += 2 * grid) {
                for (i32 x = 2 * grid; x < wide; x += 2 * grid) {
                    points.rect(left + f32(x), top + f32(gap + head + y), 1, 1, dot)
                }
            }
        }
        ui.dots.setDrawing(move points)
    }

    gui.Drawing marks
    gui.Color accent = gui.rgb(0x2F6E8F)
    gui.Color faint = gui.rgb(0x9AA7B1)
    f32 ox = f32(margin)
    f32 oy = f32(margin + gap + head)
    for (i64 i = 0; i < d.view.items.len(); i++) {  // what has nothing to show by itself
        string k = d.view.items[i].kind
        if (onPage(d.view, i) && k == "Split") {  // its two panels
            Item split = d.view.items[i]
            f32 x = ox + f32(leftOf(d.view, i))
            f32 y = oy + f32(topOf(d.view, i))
            bool down = split.text == "Down"
            f32 half = f32(down ? (split.height - 8) / 2 : (split.width - 8) / 2)
            marks.frame(x, y, down ? f32(split.width) : half, down ? half : f32(split.height), 1, faint)
            marks.frame(down ? x : x + half + 8, down ? y + half + 8 : y, down ? f32(split.width) : half,
                down ? half : f32(split.height), 1, faint)
            marks.text(format("Split {}", split.name), x + 6, y + 12, 11, faint, gui.Horizontal.Left)
        }
        if (onPage(d.view, i) && (k == "Canvas" || k == "Panel" || k == "ListView" || k == "Table" || k == "ImageBox" ||
            k == "TextView" || k == "CameraView")) {
            f32 x = ox + f32(leftOf(d.view, i))
            f32 y = oy + f32(topOf(d.view, i))
            marks.frame(x, y, f32(d.view.items[i].width), f32(d.view.items[i].height), 1, faint)
            marks.text(format("{} {}", k, d.view.items[i].name), x + 6, y + 12, 11, faint, gui.Horizontal.Left)
        }
    }
    if (!d.phone) {
        i64 one = single(d)
        for (i64 i = 0; i < d.form.items.len(); i++) {
            if (d.picked[i]) {
                f32 x = ox + f32(leftOf(d.form, i))
                f32 y = oy + f32(topOf(d.form, i))
                f32 w = f32(d.form.items[i].width)
                f32 h = f32(d.form.items[i].height)
                marks.frame(x - 1, y - 1, w + 2, h + 2, 1, accent)
                if (i == one) {
                    list<f32> at = handles(x, y, w, h)
                    for (i64 k = 0; k < 8; k++) {
                        square(ref marks, at[2 * k], at[2 * k + 1], accent)
                    }
                }
            }
        }
        // The handles of the window: its right edge, its bottom edge and their corner.
        square(ref marks, ox + f32(wide), oy + f32(high - head) / 2, faint)
        square(ref marks, ox + f32(wide) / 2, oy + f32(high - head), faint)
        square(ref marks, ox + f32(wide), oy + f32(high - head), faint)
        gui.Color pull = gui.rgb(0xD9388A)  // the guides
        for (f32 line in d.guideX) {
            marks.rect(ox + line, oy, 1, f32(high - head - nav), pull)
        }
        for (f32 line in d.guideY) {
            marks.rect(ox, oy + line, f32(wide), 1, pull)
        }
        if (d.mode == 30) {
            f32 x = d.downX < d.nowX ? d.downX : d.nowX
            f32 y = d.downY < d.nowY ? d.downY : d.nowY
            f32 w = d.downX < d.nowX ? d.nowX - d.downX : d.downX - d.nowX
            f32 h = d.downY < d.nowY ? d.nowY - d.downY : d.downY - d.nowY
            marks.rect(x, y, w, h, gui.rgba(0x2F6E8F, 28))
            marks.frame(x, y, w, h, 1, accent)
        }
    }
    ui.over.setDrawing(move marks)
}

// The properties of the item selected, of the window without one, or of none with several.
void showProperties(Ui ui, ref Design d) {
    i64 one = single(d)
    i64 many = pickedCount(d)
    bool free = !d.phone
    ui.name.setEnabled(free && one >= 0)
    ui.x.setEnabled(free && one >= 0)
    ui.y.setEnabled(free && one >= 0)
    ui.horizontal.setEnabled(free && one >= 0)
    ui.vertical.setEnabled(free && one >= 0)
    ui.text.setEnabled(free && (many == 0 || one >= 0 && textOf(d.form.items[one].kind) != 0))
    ui.width.setEnabled(free && many <= 1)
    ui.height.setEnabled(free && many <= 1)
    bool whole = free && many == 0  // the window
    ui.bar.setEnabled(whole)
    ui.minimize.setEnabled(whole && d.form.titleBar)
    ui.maximize.setEnabled(whole && d.form.titleBar)
    ui.close.setEnabled(whole && d.form.titleBar)
    ui.corner.setEnabled(whole)
    ui.icon.setEnabled(whole && d.form.titleBar)
    ui.iconFile.setEnabled(whole && d.form.titleBar)
    list<string> icons = iconNames()
    ui.icon.setSelected(placeOf(ref icons, d.form.icon))
    ui.iconFile.setText(d.form.iconFile)
    ui.resizable.setEnabled(whole)
    ui.barSize.setEnabled(whole && d.form.titleBar)
    ui.resizable.setChecked(d.form.resizable)
    ui.barSize.setText(format("{}", d.form.titleBarHeight))
    ui.bar.setChecked(d.form.titleBar)
    ui.minimize.setChecked(d.form.minimize)
    ui.maximize.setChecked(d.form.maximize)
    ui.close.setChecked(d.form.close)
    ui.corner.setText(format("{}", d.form.corner))
    ui.background.setEnabled(free && one >= 0)
    ui.textColor.setEnabled(free && one >= 0)
    ui.borderColor.setEnabled(free && one >= 0)
    ui.radius.setEnabled(free && one >= 0)
    ui.textSize.setEnabled(free && one >= 0)
    list<string> tones = [d.form.light.background, d.form.light.surface, d.form.light.text, d.form.light.accent,
        d.form.light.selection, d.form.light.danger, d.form.dark.background, d.form.dark.surface, d.form.dark.text,
        d.form.dark.accent, d.form.dark.selection, d.form.dark.danger]
    list<gui.Canvas> toneBoxes = tonesOf(ui)
    gui.Palette lightNormal = paletteOf(Tones(), false)
    gui.Palette darkNormal = paletteOf(Tones(), true)
    list<u32> normal = [lightNormal.background, lightNormal.surface, lightNormal.text, lightNormal.accent,
        lightNormal.selection, lightNormal.danger, darkNormal.background, darkNormal.surface, darkNormal.text,
        darkNormal.accent, darkNormal.selection, darkNormal.danger]
    for (i64 i = 0; i < 12; i++) {
        toneBoxes[i].setEnabled(whole)
        i64 own = hexOf(tones[i])
        paint(toneBoxes[i], 78, own >= 0 ? own : i64(normal[i]), own >= 0 ? hexText(own) : "library")
    }
    string fill = one >= 0 ? d.form.items[one].background : ""
    string ink = one >= 0 ? d.form.items[one].textColor : ""
    string edge = one >= 0 ? d.form.items[one].borderColor : ""
    paint(ui.backgroundSwatch, 28, shownColor(d.form, fill), "")
    paint(ui.textSwatch, 28, shownColor(d.form, ink), "")
    paint(ui.borderSwatch, 28, shownColor(d.form, edge), "")
    ui.backgroundSwatch.setEnabled(free && one >= 0)
    ui.textSwatch.setEnabled(free && one >= 0)
    ui.borderSwatch.setEnabled(free && one >= 0)
    if (one >= 0) {
        ui.background.setText(d.form.items[one].background)
        ui.textColor.setText(d.form.items[one].textColor)
        ui.borderColor.setText(d.form.items[one].borderColor)
        ui.radius.setText(d.form.items[one].corner >= 0 ? format("{}", d.form.items[one].corner) : "")
        ui.textSize.setText(d.form.items[one].textSize > 0 ? format("{}", d.form.items[one].textSize) : "")
    } else {
        ui.background.setText("")
        ui.textColor.setText("")
        ui.borderColor.setText("")
        ui.radius.setText("")
        ui.textSize.setText("")
    }
    ui.appBar.setEnabled(free)
    ui.appBar.setChecked(d.form.appBar)
    ui.appTitle.setEnabled(free && d.form.appBar)
    ui.appMenu.setEnabled(free && d.form.appBar)
    ui.appTitle.setText(d.form.appTitle)
    ui.appMenu.setSelected(placeOf(ref icons, d.form.appIcon))
    // The outline: the pages, and under each its components, those of a group under it.
    string outlined = ""
    list<i64> rows
    list<string> titles
    list<string> notes
    for (i64 k = -1; k < d.form.pages.len(); k++) {
        if (k < 0 && d.form.pages.len() > 0) {
            continue  // a form with pages has all its components on them
        }
        string page = k >= 0 ? d.form.pages[k].name : ""
        if (k >= 0) {
            rows.add(-1 - k)
            titles.add(d.form.pages[k].text)
            notes.add(format("page {}", page))
        }
        for (i64 i in drawn(d.form)) {
            if (d.form.items[i].page == page || k < 0) {
                rows.add(i)
                i64 depth = (k >= 0 ? 1 : 0) + depthOf(d.form, i)
                titles.add("    ".repeat(depth) + d.form.items[i].name)
                notes.add("    ".repeat(depth) + d.form.items[i].kind)
            }
        }
    }
    for (i64 r = 0; r < rows.len(); r++) {
        outlined = outlined + format("{}|{}|{};", rows[r], titles[r], notes[r])
    }
    if (outlined != d.outlined) {
        d.outlined = outlined
        d.rows = rows
        ui.outline.clear()
        for (i64 r = 0; r < rows.len(); r++) {
            ui.outline.addItem(gui.Icon.None, titles[r], notes[r], "")
        }
    }
    i64 chosen = -1
    for (i64 r = 0; r < d.rows.len(); r++) {
        if (d.rows[r] == one && one >= 0) {
            chosen = r
        }
    }
    ui.outline.setSelected(chosen)
    string listed = ""
    for (Page page in d.form.pages) {
        listed = listed + format("{}|{}|{};", page.name, page.text, page.icon)
    }
    i64 pageCount = d.form.pages.len()
    i64 pageShown = d.form.shown < pageCount ? d.form.shown : 0
    if (listed != d.listed) {
        d.listed = listed
        ui.pageList.clear()
        for (Page page in d.form.pages) {
            ui.pageList.addItem(iconValues()[placeOf(ref icons, page.icon)], page.text, page.name, "")
        }
    }
    ui.pageList.setSelected(pageCount > 0 ? pageShown : -1)
    ui.pageName.setEnabled(free && pageCount > 0)
    ui.pageText.setEnabled(free && pageCount > 0)
    ui.pageIcon.setEnabled(free && pageCount > 0)
    ui.pageName.setText(pageCount > 0 ? d.form.pages[pageShown].name : "")
    ui.pageText.setText(pageCount > 0 ? d.form.pages[pageShown].text : "")
    ui.pageIcon.setSelected(pageCount > 0 ? placeOf(ref icons, d.form.pages[pageShown].icon) : 0)
    list<string> across = acrossNames()
    list<string> down = downNames()
    if (one >= 0) {
        Item item = d.form.items[one]
        ui.kind.setText(item.parent.len() > 0 ? format("{} in {}", item.kind, item.parent) : item.kind)
        ui.name.setText(item.name)
        ui.text.setText(item.text)
        ui.x.setText(format("{}", item.x))
        ui.y.setText(format("{}", item.y))
        ui.width.setText(format("{}", item.width))
        ui.height.setText(format("{}", item.height))
        ui.horizontal.setSelected(placeOf(ref across, item.horizontal))
        ui.vertical.setSelected(placeOf(ref down, item.vertical))
    } else {
        ui.kind.setText(many > 1 ? format("{} components", many) : "Window")
        ui.name.setText("")
        ui.text.setText(many > 1 ? "" : d.form.title)
        ui.x.setText("")
        ui.y.setText("")
        ui.width.setText(many > 1 ? "" : format("{}", d.form.width))
        ui.height.setText(many > 1 ? "" : format("{}", d.form.height))
        ui.horizontal.setSelected(0)
        ui.vertical.setSelected(0)
    }
}

void showPath(Ui ui, ref Design d) {
    string name = d.path.len() > 0 ? fs.fileName(d.path) : "new form"
    ui.w.setTitle(format("{}{} - Cromo Design", name, d.dirty ? " *" : ""))
}

// ---- Undo ----

// Keeps a form as it was before a change, to undo it.
void keep(ref Design d, move Form form) {
    d.undo.add(move form)
    if (d.undo.len() > 200) {
        d.undo.remove(0)
    }
    d.redo.clear()
    d.dirty = true
}

// Before a change of the form: the changes with the same key, as the letters written
// in one box, are one step to undo.
void change(ref Design d, string key) {
    if (key.len() == 0 || key != d.editing) {
        Form now = d.form
        keep(ref d, move now)
    }
    d.editing = key
}

void undo(Ui ui, ref Design d, bool again) {
    if (d.phone || (again ? d.redo.len() : d.undo.len()) == 0) {
        ret
    }
    Form now = d.form
    if (again) {
        d.undo.add(move now)
        d.form = d.redo.remove(d.redo.len() - 1)
    } else {
        d.redo.add(move now)
        d.form = d.undo.remove(d.undo.len() - 1)
    }
    d.dirty = true
    d.editing = ""
    d.mode = 0
    d.picked.clear()
    sync(ui, ref d)
    showProperties(ui, ref d)
    ui.status.setText(again ? "Done again" : "Undone")
}

// ---- The mouse ----

i32 snap(f32 value) {
    i32 whole = i32(value + (value < 0 ? -0.5 : 0.5))
    ret whole / grid * grid
}

i32 within(i32 value, i32 low, i32 high) {
    ret value < low ? low : value > high ? high : value
}

// The item at a point of the content of the window, the last drawn first, or -1.
i64 itemAt(Form form, f32 x, f32 y) {
    list<i64> order = drawn(form)
    for (i64 k = order.len() - 1; k >= 0; k--) {
        i64 i = order[k]
        if (!onPage(form, i)) {
            continue
        }
        f32 l = f32(leftOf(form, i))
        f32 t = f32(topOf(form, i))
        if (x >= l && x < l + f32(form.items[i].width) && y >= t && y < t + f32(form.items[i].height)) {
            ret i
        }
    }
    ret -1
}

// The handle at a point among those of a list of centers, from 0, or -1.
i64 handleAt(list<f32> at, f32 x, f32 y) {
    for (i64 k = 0; k < at.len() / 2; k++) {
        if (x >= at[2 * k] - grip && x <= at[2 * k] + grip && y >= at[2 * k + 1] - grip && y <= at[2 * k + 1] + grip) {
            ret k
        }
    }
    ret -1
}

// The cursor of the system for a handle of the eight of a rectangle: the arrows of the
// direction it resizes in.
i32 cursorOf(i64 handle) {
    list<i32> ids = [5, 8, 6, 7, 5, 8, 6, 7]  // SDL_SYSTEM_CURSOR_NWSE_RESIZE, NS, NESW, EW
    ret ids[handle]
}

// Shows what the mouse would do at a point of the canvas: the arrows over a handle of
// the item selected or of the window, the four arrows over an item, which moves.
void hover(ref Design d, gui.Mouse m) {
    f32 x = m.x - f32(margin)
    f32 y = m.y - f32(margin + barOf(d.form) + headOf(d.form))
    f32 wide = f32(d.form.width)
    f32 high = f32(d.form.height - barOf(d.form) - headOf(d.form))
    i32 id = 0  // SDL_SYSTEM_CURSOR_DEFAULT
    if (!d.phone) {
        i64 one = single(d)
        i64 handle = -1
        if (one >= 0) {
            handle = handleAt(handles(f32(leftOf(d.form, one)), f32(topOf(d.form, one)), f32(d.form.items[one].width),
                f32(d.form.items[one].height)), x, y)
        }
        i64 edge = handleAt([wide, high / 2, wide / 2, high, wide, high], x, y)
        if (handle >= 0) {
            id = cursorOf(handle)
        } else if (edge >= 0) {
            id = edge == 0 ? 7 : edge == 1 ? 8 : 5
        } else if (itemAt(d.form, x, y) >= 0) {
            id = 9  // SDL_SYSTEM_CURSOR_MOVE
        }
    }
    if (d.cursors.len() == 0) {
        for (u32 k = 0; k < 12; k++) {
            d.cursors.add(SDL_CreateSystemCursor(k))
        }
    }
    SDL_SetCursor(d.cursors[id])
}

void pressed(Ui ui, ref Design d, gui.Mouse m) {
    if (m.button != 1) {
        ret
    }
    if (d.phone) {
        ui.status.setText("This is the preview on a phone: turn Phone off to change the form")
        ret
    }
    f32 x = m.x - f32(margin)
    f32 y = m.y - f32(margin + barOf(d.form) + headOf(d.form))
    f32 wide = f32(d.form.width)
    f32 high = f32(d.form.height - barOf(d.form) - headOf(d.form))
    d.mode = 0
    d.moved = false
    d.editing = ""
    i64 one = single(d)
    i64 handle = -1
    if (one >= 0) {
        handle = handleAt(handles(f32(leftOf(d.form, one)), f32(topOf(d.form, one)), f32(d.form.items[one].width),
            f32(d.form.items[one].height)), x, y)
    }
    i64 edge = handleAt([wide, high / 2, wide / 2, high, wide, high], x, y)
    if (handle >= 0) {
        d.mode = 2 + i32(handle)
    } else if (edge >= 0) {
        d.mode = 20 + i32(edge)
        pickNone(ref d)
    } else if (d.form.pages.len() > 0 && x >= 0 && x < wide && y >= high - f32(navHeight) && y < high) {
        // An item of the navigation bar: its page is shown.
        d.form.shown = i64(x / (wide / f32(d.form.pages.len())))
        pickNone(ref d)
        sync(ui, ref d)
        showProperties(ui, ref d)
        ui.status.setText(format("The page {}: the components added go on it", pageNow(d.form)))
    } else {
        i64 hit = itemAt(d.form, x, y)
        if (hit >= 0 && d.picked[hit] && d.form.items[hit].kind == "TabView" && y < f32(topOf(d.form, hit) + 32)) {
            // The band of a tab view that is selected: its next page is shown.
            i64 count = choices(d.form.items[hit].text).len()
            d.form.items[hit].showing = count > 0 ? i32((i64(d.form.items[hit].showing) + 1) % count) : 0
            sync(ui, ref d)
            showProperties(ui, ref d)
            ui.status.setText(format("The page {} of {}: the components moved on it go there", d.form.items[hit].showing + 1,
                d.form.items[hit].name))
            ret
        }
        if (hit >= 0 && (m.shift || m.control)) {
            d.picked[hit] = !d.picked[hit]
        } else if (hit >= 0) {
            if (!d.picked[hit]) {
                pickNone(ref d)
                d.picked[hit] = true
            }
            d.mode = 1
        } else {
            if (!m.shift && !m.control) {
                pickNone(ref d)
            }
            d.mode = 30
        }
    }
    d.downX = m.x
    d.downY = m.y
    d.nowX = m.x
    d.nowY = m.y
    d.before = d.form
    showProperties(ui, ref d)
    refresh(ui, ref d)
}

void dragged(Ui ui, ref Design d, gui.Mouse m) {
    if (d.mode == 0) {
        hover(ref d, m)
        ret
    }
    d.nowX = m.x
    d.nowY = m.y
    i32 dx = snap(m.x - d.downX)
    i32 dy = snap(m.y - d.downY)
    i32 wide = d.before.width
    i32 high = d.before.height - barOf(d.before) - navOf(d.before) - headOf(d.before)
    if (d.mode == 30) {  // the items that the rectangle touches
        f32 l = (d.downX < d.nowX ? d.downX : d.nowX) - f32(margin)
        f32 t = (d.downY < d.nowY ? d.downY : d.nowY) - f32(margin + barOf(d.form) + headOf(d.form))
        f32 r = (d.downX < d.nowX ? d.nowX : d.downX) - f32(margin)
        f32 b = (d.downY < d.nowY ? d.nowY : d.downY) - f32(margin + barOf(d.form) + headOf(d.form))
        for (i64 i = 0; i < d.form.items.len(); i++) {
            f32 x = f32(leftOf(d.form, i))
            f32 y = f32(topOf(d.form, i))
            d.picked[i] = onPage(d.form, i) && x < r && x + f32(d.form.items[i].width) > l && y < b &&
                y + f32(d.form.items[i].height) > t
        }
        showProperties(ui, ref d)
        refresh(ui, ref d)
        ret
    }
    if (dx == 0 && dy == 0 && !d.moved) {
        ret
    }
    if (!d.moved) {
        Form was = d.before
        keep(ref d, move was)
        d.moved = true
    }
    if (d.mode == 1) {  // the selection moves together, inside the window
        i32 least = -100000
        i32 most = 100000
        i32 up = -100000
        i32 down = 100000
        for (i64 i = 0; i < d.before.items.len(); i++) {
            if (leads(d, d.before, i)) {
                i32 l = leftOf(d.before, i)
                i32 t = topOf(d.before, i)
                least = -l > least ? -l : least
                most = wide - d.before.items[i].width - l < most ? wide - d.before.items[i].width - l : most
                up = -t > up ? -t : up
                down = high - d.before.items[i].height - t < down ? high - d.before.items[i].height - t : down
            }
        }
        dx = most < least ? 0 : within(dx, least, most)
        dy = down < up ? 0 : within(dy, up, down)
        d.guideX.clear()
        d.guideY.clear()
        if (!m.alt) {  // the edges and the middles of the others, and of the window, pull: Alt lets go
            list<f32> linesX
            list<f32> linesY
            i32 pullX = guide(d, true, dx, wide, ref linesX)
            i32 pullY = guide(d, false, dy, high, ref linesY)
            d.guideX = linesX
            d.guideY = linesY
            if (most >= least && dx + pullX >= least && dx + pullX <= most) {
                dx += pullX
            } else {
                d.guideX.clear()
            }
            if (down >= up && dy + pullY >= up && dy + pullY <= down) {
                dy += pullY
            } else {
                d.guideY.clear()
            }
        }
        for (i64 i = 0; i < d.before.items.len(); i++) {
            if (leads(d, d.before, i)) {
                d.form.items[i].x = d.before.items[i].x + dx
                d.form.items[i].y = d.before.items[i].y + dy
            }
        }
    } else if (d.mode >= 20) {  // the window
        i32 width = d.mode == 21 ? d.before.width : within(d.before.width + dx, 120, 4000)
        i32 height = d.mode == 20 ? d.before.height : within(d.before.height + dy, 80, 4000)
        d.form = resized(d.before, width, height)
    } else {  // an item, by one of its handles
        i64 one = single(d)
        i64 p = parentOf(d.before, one)
        i32 roomWide = p >= 0 ? d.before.items[p].width : wide
        i32 roomHigh = p >= 0 ? d.before.items[p].height : high
        Item item = d.before.items[one]
        i32 handle = d.mode - 2
        i32 left = item.x
        i32 top = item.y
        i32 right = item.x + item.width
        i32 bottom = item.y + item.height
        if (handle == 0 || handle == 6 || handle == 7) {
            left = within(left + dx, 0, right - 2 * grid)
        }
        if (handle == 2 || handle == 3 || handle == 4) {
            right = within(right + dx, left + 2 * grid, roomWide > left + 2 * grid ? roomWide : left + 2 * grid)
        }
        if (handle == 0 || handle == 1 || handle == 2) {
            top = within(top + dy, 0, bottom - 2 * grid)
        }
        if (handle == 4 || handle == 5 || handle == 6) {
            bottom = within(bottom + dy, top + 2 * grid, roomHigh > top + 2 * grid ? roomHigh : top + 2 * grid)
        }
        item.x = left
        item.y = top
        item.width = right - left
        item.height = bottom - top
        reshape(ref d.form, d.before, one, item)
    }
    sync(ui, ref d)
    showProperties(ui, ref d)
}

// The group or the panel of the window under a point, but one item, or -1.
i64 holderAt(Form form, i32 x, i32 y, i64 but) {
    list<bool> moving
    for (i64 i = 0; i < form.items.len(); i++) {
        moving.add(i == but)
    }
    list<i64> order = drawn(form)
    for (i64 k = order.len() - 1; k >= 0; k--) {  // the innermost group there, not the item itself nor what it holds
        i64 i = order[k]
        Item item = form.items[i]
        i32 left = leftOf(form, i)
        i32 top = topOf(form, i)
        if (i != but && onPage(form, i) && holds(item.kind) && !heldBy(form, i, moving) && x >= left && x < left + item.width &&
            y >= top && y < top + item.height) {
            ret i
        }
    }
    ret -1
}

// What was moved goes in the group or the panel under its center, or out of the one
// it was in.
void drop(ref Design d) {
    for (i64 i = 0; i < d.form.items.len(); i++) {
        if (!leads(d, d.form, i)) {
            continue
        }
        i32 l = leftOf(d.form, i)
        i32 t = topOf(d.form, i)
        i64 into = holderAt(d.form, l + d.form.items[i].width / 2, t + d.form.items[i].height / 2, i)
        i32 tab = 0
        if (into >= 0 && d.form.items[into].kind == "TabView") {
            tab = d.form.items[into].showing
        } else if (into >= 0 && d.form.items[into].kind == "Split") {  // the panel that its middle is over
            Item split = d.form.items[into]
            bool second = split.text == "Down" ? t + d.form.items[i].height / 2 >= topOf(d.form, into) + paneTop(split, 1) :
                l + d.form.items[i].width / 2 >= leftOf(d.form, into) + paneLeft(split, 1)
            tab = second ? 1 : 0
        }
        if (into != parentOf(d.form, i) || into >= 0 && tab != d.form.items[i].tab) {
            d.form.items[i].x = l - (into >= 0 ? leftOf(d.form, into) + paneLeft(d.form.items[into], tab) : 0)
            d.form.items[i].y = t - (into >= 0 ? topOf(d.form, into) + paneTop(d.form.items[into], tab) : 0)
            if (d.form.items[i].x < 0) {
                d.form.items[i].x = 0
            }
            if (d.form.items[i].y < 0) {
                d.form.items[i].y = 0
            }
            d.form.items[i].parent = into >= 0 ? d.form.items[into].name : ""
            d.form.items[i].tab = tab
        }
    }
}

void released(Ui ui, ref Design d) {
    if (d.mode == 1 && d.moved) {
        drop(ref d)
    }
    d.guideX.clear()
    d.guideY.clear()
    d.mode = 0
    sync(ui, ref d)
    showProperties(ui, ref d)
}

// ---- The changes ----

// A new component of a kind, with a name that no other has, selected.
void addItem(Ui ui, ref Design d, string kind) {
    if (d.phone) {
        ui.status.setText("This is the preview on a phone: turn Phone off to change the form")
        ret
    }
    change(ref d, "")
    Item item
    item.kind = kind
    string base = kind.slice(0, 1).lower() + kind.slice(1, kind.len())
    for (i64 n = 1; item.name.len() == 0; n++) {
        string name = format("{}{}", base, n)
        if (find(d.form, name) < 0) {
            item.name = name
        }
    }
    item.text = textOf(kind) == 2 ? "One, Two, Three" : textOf(kind) == 1 && kind != "TextBox" && kind != "TextArea" ? kind : ""
    item.page = pageNow(d.form)
    item.x = 16
    item.y = 16
    item.width = 96
    item.height = 28
    if (kind == "Label") {
        item.height = 20
    } else if (kind == "TextBox" || kind == "ComboBox" || kind == "Slider") {
        item.width = 160
    } else if (kind == "CheckBox" || kind == "Switch") {
        item.width = 140
        item.height = 24
    } else if (kind == "Segmented") {
        item.width = 220
    } else if (kind == "RadioGroup") {
        item.width = 160
        item.height = 84
    } else if (kind == "ProgressBar") {
        item.width = 200
        item.height = 8
    } else if (kind == "TabView") {
        item.width = 280
        item.height = 180
        item.text = "One, Two"
    } else if (kind == "Split") {
        item.width = 280
        item.height = 160
        item.text = "Across"
    } else if (kind == "IconBox") {
        item.width = 24
        item.height = 24
        item.text = "Star"
    } else if (kind == "ImageBox") {
        item.width = 120
        item.height = 120
        item.text = ""
    } else if (kind != "Button") {  // the large ones
        item.width = 240
        item.height = 140
    }
    for (i64 i = 0; i < d.form.items.len(); i++) {  // not over another one just added
        if (onPage(d.form, i) && d.form.items[i].parent.len() == 0 && d.form.items[i].x == item.x && d.form.items[i].y == item.y) {
            item.x += 16
            item.y += 16
            i = -1
        }
    }
    pickNone(ref d)
    if (holds(kind)) {  // under the components there are, which can then go in it
        d.form.items.insert(0, move item)
        d.picked.insert(0, true)
    } else {
        d.form.items.add(move item)
        d.picked.add(true)
    }
    sync(ui, ref d)
    showProperties(ui, ref d)
    ui.status.setText(format("Added a gui.{}", kind))
}

// Removes the items selected, and what they hold.
void removePicked(Ui ui, ref Design d) {
    if (d.phone || pickedCount(d) == 0) {
        ret
    }
    change(ref d, "")
    list<Item> kept
    for (i64 i = 0; i < d.form.items.len(); i++) {
        if (!d.picked[i] && !heldBy(d.form, i, d.picked)) {
            kept.add(d.form.items[i])
        }
    }
    d.form.items = move kept
    d.picked.clear()
    d.mode = 0
    sync(ui, ref d)
    showProperties(ui, ref d)
}

// Moves the selection, with the arrows by a step of the grid.
void nudge(Ui ui, ref Design d, i32 dx, i32 dy) {
    if (d.phone || pickedCount(d) == 0) {
        ret
    }
    change(ref d, "nudge")
    for (i64 i = 0; i < d.form.items.len(); i++) {
        if (leads(d, d.form, i)) {
            d.form.items[i].x = d.form.items[i].x + dx > 0 ? d.form.items[i].x + dx : 0
            d.form.items[i].y = d.form.items[i].y + dy > 0 ? d.form.items[i].y + dy : 0
        }
    }
    sync(ui, ref d)
    showProperties(ui, ref d)
}

// Puts the selection, as one block, in the middle of the window: across it, or down it.
// A name that the form does not have, from a base: label, label2, label3.
string freeName(Form form, string base, list<string> before) {
    list<string> taken = before.copy()
    string stem = base
    for (stem.len() > 1 && stem[stem.len() - 1] >= '0' && stem[stem.len() - 1] <= '9') {
        stem = stem.slice(0, stem.len() - 1)
    }
    for (i64 n = 1; n < 100000; n++) {
        string name = n == 1 ? stem : format("{}{}", stem, n)
        bool used = find(form, name) >= 0 || has(ref taken, name) || name == "bar" || name == "window"
        for (Page page in form.pages) {
            used = used || page.name == name
        }
        if (!used && isName(name)) {
            ret name
        }
    }
    ret stem
}

// Copies the components selected, with what the groups and the panels among them hold.
void copyPicked(Ui ui, ref Design d) {
    if (pickedCount(d) == 0) {
        ret
    }
    d.clip.clear()
    for (i64 i = 0; i < d.form.items.len(); i++) {
        if (d.picked[i] || heldBy(d.form, i, d.picked)) {
            Item copy = d.form.items[i]
            if (!heldBy(d.form, i, d.picked)) {  // from the window, or alone from its group: where it is now
                copy.x = leftOf(d.form, i)
                copy.y = topOf(d.form, i)
                copy.parent = ""
            }
            d.clip.add(move copy)
        }
    }
    ui.status.setText(format("Copied {} components: Ctrl+V pastes them", d.clip.len()))
}

// Adds the components copied, on the page shown, a little down and to the right, with
// names of their own, and selects them.
void paste(Ui ui, ref Design d) {
    if (d.phone || d.clip.len() == 0) {
        ret
    }
    change(ref d, "")
    pickNone(ref d)
    list<string> old
    list<string> fresh
    for (Item from in d.clip) {
        old.add(from.name)
        fresh.add(freeName(d.form, from.name, fresh))
    }
    for (i64 k = 0; k < d.clip.len(); k++) {
        Item item = d.clip[k]
        item.name = fresh[k]
        item.page = pageNow(d.form)
        if (item.parent.len() > 0) {
            item.parent = fresh[placeOf(ref old, item.parent)]
        } else {
            item.x = within(item.x + 16, 0, d.form.width > item.width ? d.form.width - item.width : 0)
            item.y = item.y + 16
        }
        d.clip[k].x += d.clip[k].parent.len() > 0 ? 0 : 16  // the next paste goes further
        d.clip[k].y += d.clip[k].parent.len() > 0 ? 0 : 16
        bool inside = item.parent.len() > 0
        d.form.items.add(move item)
        d.picked.add(!inside)
    }
    sync(ui, ref d)
    showProperties(ui, ref d)
    ui.status.setText(format("Pasted {} components", fresh.len()))
}

// The box of the components selected: false without any.
bool pickedBox(Design d, ref i32 left, ref i32 top, ref i32 right, ref i32 bottom) {
    left = 100000
    top = 100000
    right = -100000
    bottom = -100000
    for (i64 i = 0; i < d.form.items.len(); i++) {
        if (leads(d, d.form, i)) {
            i32 l = leftOf(d.form, i)
            i32 t = topOf(d.form, i)
            left = l < left ? l : left
            top = t < top ? t : top
            right = l + d.form.items[i].width > right ? l + d.form.items[i].width : right
            bottom = t + d.form.items[i].height > bottom ? t + d.form.items[i].height : bottom
        }
    }
    ret right >= left
}

// Arranges the components selected: 0 to 2 their left edges, their middles and their
// right edges in a line; 3 to 5 their tops, their middles and their bottoms; 6 and 7
// with the same room between them, across and down; 8 and 9 as wide and as tall as
// the first of them; 10 and 11 over the others and under them.
void arrange(Ui ui, ref Design d, i32 what) {
    list<i64> chosen
    for (i64 i = 0; i < d.form.items.len(); i++) {
        if (leads(d, d.form, i)) {
            chosen.add(i)
        }
    }
    i64 needed = what == 6 || what == 7 ? 3 : what >= 10 ? 1 : 2
    if (d.phone || chosen.len() < needed) {
        ui.status.setText(needed == 1 ? "Select a component first" : format("Select {} components or more: Shift and a click adds one", needed))
        ret
    }
    change(ref d, "")
    i32 left = 0
    i32 top = 0
    i32 right = 0
    i32 bottom = 0
    pickedBox(d, ref left, ref top, ref right, ref bottom)
    if (what <= 5) {
        for (i64 i in chosen) {
            i32 l = leftOf(d.form, i)
            i32 t = topOf(d.form, i)
            i32 w = d.form.items[i].width
            i32 h = d.form.items[i].height
            if (what == 0) {
                d.form.items[i].x += left - l
            } else if (what == 1) {
                d.form.items[i].x += (left + right) / 2 - w / 2 - l
            } else if (what == 2) {
                d.form.items[i].x += right - w - l
            } else if (what == 3) {
                d.form.items[i].y += top - t
            } else if (what == 4) {
                d.form.items[i].y += (top + bottom) / 2 - h / 2 - t
            } else {
                d.form.items[i].y += bottom - h - t
            }
        }
    } else if (what <= 7) {
        bool across = what == 6
        for (i64 a = 1; a < chosen.len(); a++) {  // in the order of their places
            i64 moving = chosen[a]
            i64 b = a
            for (b > 0 && (across ? leftOf(d.form, chosen[b - 1]) > leftOf(d.form, moving) :
                topOf(d.form, chosen[b - 1]) > topOf(d.form, moving))) {
                chosen[b] = chosen[b - 1]
                b--
            }
            chosen[b] = moving
        }
        i32 sizes = 0
        for (i64 i in chosen) {
            sizes += across ? d.form.items[i].width : d.form.items[i].height
        }
        i32 span = across ? right - left : bottom - top
        f32 gap = f32(span - sizes) / f32(chosen.len() - 1)
        f32 at = f32(across ? left : top)
        for (i64 i in chosen) {
            i32 now = across ? leftOf(d.form, i) : topOf(d.form, i)
            i32 to = i32(at + 0.5)
            if (across) {
                d.form.items[i].x += to - now
            } else {
                d.form.items[i].y += to - now
            }
            at += f32(across ? d.form.items[i].width : d.form.items[i].height) + gap
        }
    } else if (what <= 9) {
        for (i64 i in chosen) {
            Item item = d.form.items[i]
            if (what == 8) {
                item.width = d.form.items[chosen[0]].width
            } else {
                item.height = d.form.items[chosen[0]].height
            }
            Form from = d.form
            reshape(ref d.form, from, i, item)
        }
    } else {
        list<Item> moved
        list<Item> others
        for (i64 i = 0; i < d.form.items.len(); i++) {
            if (d.picked[i] || heldBy(d.form, i, d.picked)) {
                moved.add(d.form.items[i])
            } else {
                others.add(d.form.items[i])
            }
        }
        i64 count = moved.len()
        i64 rest = others.len()
        list<Item> all
        list<bool> marks
        if (what == 11) {  // under the others
            for (Item item in moved) {
                all.add(item)
                marks.add(true)
            }
        }
        for (Item item in others) {
            all.add(item)
            marks.add(false)
        }
        if (what == 10) {
            for (Item item in moved) {
                all.add(item)
                marks.add(true)
            }
        }
        d.form.items = move all
        for (i64 i = 0; i < count + rest; i++) {  // the same components stay selected: not what a group among them holds
            d.picked[i] = marks[i] && !heldBy(d.form, i, marks)
        }
    }
    sync(ui, ref d)
    showProperties(ui, ref d)
    list<string> said = ["Aligned to the left", "Aligned to the middle, across", "Aligned to the right", "Aligned to the top",
        "Aligned to the middle, down", "Aligned to the bottom", "The same room between them, across",
        "The same room between them, down", "As wide as the first", "As tall as the first", "Over the others",
        "Under the others"]
    ui.status.setText(said[i64(what)])
}

void center(Ui ui, ref Design d, bool across) {
    if (d.phone || pickedCount(d) == 0) {
        ui.status.setText("Select the components to center: a click, Shift and a click for more, or a rectangle with the mouse")
        ret
    }
    change(ref d, "")
    i32 low = 100000
    i32 high = -100000
    for (i64 i = 0; i < d.form.items.len(); i++) {
        if (leads(d, d.form, i)) {
            i32 start = across ? leftOf(d.form, i) : topOf(d.form, i)
            i32 size = across ? d.form.items[i].width : d.form.items[i].height
            low = start < low ? start : low
            high = start + size > high ? start + size : high
        }
    }
    i32 room = across ? d.form.width : d.form.height - barOf(d.form) - navOf(d.form) - headOf(d.form)
    i32 by = (room - (high - low)) / 2 - low
    for (i64 i = 0; i < d.form.items.len(); i++) {
        if (leads(d, d.form, i)) {
            if (across) {
                d.form.items[i].x += by
            } else {
                d.form.items[i].y += by
            }
        }
    }
    sync(ui, ref d)
    showProperties(ui, ref d)
    ui.status.setText(across ? "Centered across the window" : "Centered down the window")
}

void pickAll(Ui ui, ref Design d) {
    for (i64 i = 0; i < d.picked.len(); i++) {
        d.picked[i] = !d.phone && onPage(d.form, i)
    }
    showProperties(ui, ref d)
    refresh(ui, ref d)
}

// A number written in a box of the properties, or -1 when it is not one.
i32 numberOf(string text) {
    string digits = text.trim()
    if (digits.len() == 0 || digits.len() > 5) {
        ret -1
    }
    for (i64 i = 0; i < digits.len(); i++) {
        if (digits[i] < '0' || digits[i] > '9') {
            ret -1
        }
    }
    ret i32(digits)
}

// A property written in its box: 0 the name, 1 the text, 2 x, 3 y, 4 the width, 5 the
// height. What is not a number changes nothing.
void edited(Ui ui, ref Design d, i32 which, string value) {
    i64 one = single(d)
    if (d.phone || one < 0 && pickedCount(d) > 0) {
        ret
    }
    i32 number = numberOf(value)
    change(ref d, format("{}:{}", one, which))
    if (one < 0) {
        if (which == 1) {
            d.form.title = value
        } else if (which == 4 && number >= 120) {
            d.form = resized(d.form, number, d.form.height)
        } else if (which == 5 && number >= 80) {
            d.form = resized(d.form, d.form.width, number)
        }
        sync(ui, ref d)
        ret
    }
    Item item = d.form.items[one]
    if (which == 0) {
        string name = value.trim()
        if (name.len() > 0) {
            for (i64 i = 0; i < d.form.items.len(); i++) {  // what it holds follows its name
                if (d.form.items[i].parent == item.name) {
                    d.form.items[i].parent = name
                }
            }
            item.name = name
        }
    } else if (which == 1) {
        item.text = value
    } else if (which == 2 && number >= 0) {
        item.x = number
    } else if (which == 3 && number >= 0) {
        item.y = number
    } else if (which == 4 && number >= 2 * grid) {
        item.width = number
    } else if (which == 5 && number >= 2 * grid) {
        item.height = number
    }
    Form from = d.form
    reshape(ref d.form, from, one, item)
    sync(ui, ref d)
}

// The app bar of the window: 0 whether it has one, 1 its title, 2 its icon by its name.
void barred(Ui ui, ref Design d, i32 which, bool on, string value) {
    if (d.phone) {
        ret
    }
    change(ref d, format("appbar{}", which))
    if (which == 0) {
        d.form.appBar = on
        if (on && d.form.appTitle.len() == 0) {
            d.form.appTitle = d.form.title
        }
    } else if (which == 1) {
        d.form.appTitle = value
    } else {
        d.form.appIcon = value == "None" ? "" : value
    }
    sync(ui, ref d)
    showProperties(ui, ref d)
}

// The pages of the navigation bar: 0 adds one, 1 removes the one shown, 2 moves it
// before the one before it, 3 after the one after it.
void paged(Ui ui, ref Design d, i32 what) {
    if (d.phone) {
        ret
    }
    i64 count = d.form.pages.len()
    i64 now = d.form.shown < count ? d.form.shown : 0
    if (what != 0 && count == 0 || what == 2 && now == 0 || what == 3 && now == count - 1) {
        ret
    }
    change(ref d, "")
    pickNone(ref d)
    if (what == 0) {
        Page page
        for (i64 n = count + 1; page.name.len() == 0; n++) {
            string name = format("page{}", n)
            bool taken = find(d.form, name) >= 0
            for (Page other in d.form.pages) {
                taken = taken || other.name == name
            }
            if (!taken) {
                page.name = name
                page.text = format("Page {}", n)
            }
        }
        page.icon = count == 0 ? "House" : "Star"
        if (count == 0) {  // what the window has goes on the first page
            for (i64 i = 0; i < d.form.items.len(); i++) {
                d.form.items[i].page = page.name
            }
        }
        d.form.pages.add(move page)
        d.form.shown = count
    } else if (what == 1) {
        string gone = d.form.pages[now].name
        for (i64 i = d.form.items.len() - 1; i >= 0; i--) {
            if (d.form.items[i].page != gone) {
                continue
            }
            if (count == 1) {  // the last page: its components stay, in the window
                d.form.items[i].page = ""
            } else {
                d.form.items.remove(i)
            }
        }
        d.form.pages.remove(now)
        d.form.shown = now > 0 ? now - 1 : 0
        d.picked.clear()
    } else {
        i64 other = what == 2 ? now - 1 : now + 1
        Page moved = d.form.pages[now]
        d.form.pages[now] = d.form.pages[other]
        d.form.pages[other] = moved
        d.form.shown = other
    }
    sync(ui, ref d)
    showProperties(ui, ref d)
}

// A property of the page shown: 0 its name, 1 its text, 2 its icon by its name.
void pageEdited(Ui ui, ref Design d, i32 which, string value) {
    i64 count = d.form.pages.len()
    if (d.phone || count == 0) {
        ret
    }
    i64 now = d.form.shown < count ? d.form.shown : 0
    change(ref d, format("page{}:{}", now, which))
    if (which == 0) {
        string name = value.trim()
        string old = d.form.pages[now].name
        if (name.len() > 0 && name != old) {
            for (i64 i = 0; i < d.form.items.len(); i++) {  // its components follow its name
                if (d.form.items[i].page == old) {
                    d.form.items[i].page = name
                }
            }
            d.form.pages[now].name = name
        }
    } else if (which == 1) {
        d.form.pages[now].text = value
    } else {
        d.form.pages[now].icon = value
    }
    sync(ui, ref d)
    showProperties(ui, ref d)
}

// A property of the look of a component, written in its box (D540): 0 its background,
// 1 the color of its text, 2 the one of its border, 3 the radius of its corners, 4 the
// size of its text. An empty box is the look of the theme.
void looked(Ui ui, ref Design d, i32 which, string value) {
    i64 one = single(d)
    if (d.phone || one < 0) {
        ret
    }
    change(ref d, format("{}:look{}", one, which))
    i32 number = numberOf(value)
    if (which == 0) {
        d.form.items[one].background = value.trim()
    } else if (which == 1) {
        d.form.items[one].textColor = value.trim()
    } else if (which == 2) {
        d.form.items[one].borderColor = value.trim()
    } else if (which == 3) {
        d.form.items[one].corner = number >= 0 && number <= 64 ? number : -1
    } else {
        d.form.items[one].textSize = number >= 6 && number <= 96 ? number : 0
    }
    sync(ui, ref d)
}

// A color of the window, written in its box (D539): 0 to 5 of the light theme, 6 to 11
// of the dark one, in the order of the fields of 'Tones'.
void toned(Ui ui, ref Design d, i32 which, string value) {
    if (d.phone || pickedCount(d) > 0) {
        ret
    }
    change(ref d, format("tone{}", which))
    Tones tones = which < 6 ? d.form.light : d.form.dark
    i32 at = which % 6
    string color = value.trim()
    if (at == 0) {
        tones.background = color
    } else if (at == 1) {
        tones.surface = color
    } else if (at == 2) {
        tones.text = color
    } else if (at == 3) {
        tones.accent = color
    } else if (at == 4) {
        tones.selection = color
    } else {
        tones.danger = color
    }
    if (which < 6) {
        d.form.light = tones
    } else {
        d.form.dark = tones
    }
    sync(ui, ref d)
}

// A property of the window: 0 its title bar, 1 to 3 its buttons to minimize, to maximize
// and to close, 4 the radius of its corners, 5 whether it is resized, 6 the height of its
// title bar, 7 its icon of Lucide by its number. The content keeps its height when the
// bar changes.
void framed(Ui ui, ref Design d, i32 which, bool on, i32 radius) {
    if (d.phone || pickedCount(d) > 0) {
        ret
    }
    change(ref d, which == 4 ? "corner" : which == 6 ? "bar" : "")
    i32 content = d.form.height - barOf(d.form)
    if (which == 7) {
        d.form.icon = radius > 0 ? iconNames()[radius] : ""
        if (radius > 0) {
            d.form.iconFile = ""  // one or the other
        }
    } else if (which == 5) {
        d.form.resizable = on
    } else if (which == 6) {
        if (radius >= 24 && radius <= 96) {
            d.form.titleBarHeight = radius
        }
    } else if (which == 0) {
        d.form.titleBar = on
    } else if (which == 1) {
        d.form.minimize = on
    } else if (which == 2) {
        d.form.maximize = on
    } else if (which == 3) {
        d.form.close = on
    } else if (radius >= 0 && radius <= 64) {
        d.form.corner = radius
    }
    d.form.height = content + barOf(d.form)
    sync(ui, ref d)
    if (which != 4 && which != 6) {
        showProperties(ui, ref d)
    }
}

// The file of the image of the icon of the window, written in its box.
void pictured(Ui ui, ref Design d, string file) {
    if (d.phone || pickedCount(d) > 0) {
        ret
    }
    change(ref d, "icon")
    d.form.iconFile = file.trim()
    if (d.form.iconFile.len() > 0) {
        d.form.icon = ""  // one or the other
    }
    sync(ui, ref d)
}

// An anchor chosen for the item selected: across the window, or down it.
void anchored(Ui ui, ref Design d, bool across, i64 index) {
    i64 one = single(d)
    if (d.phone || one < 0 || index < 0 || index > 3) {
        ret
    }
    change(ref d, "")
    if (across) {
        d.form.items[one].horizontal = acrossNames()[index]
    } else {
        d.form.items[one].vertical = downNames()[index]
    }
    sync(ui, ref d)
}

// ---- The files ----

list<gui.FileType> forms() {
    ret [gui.FileType("Forms of Cromo", "form")]
}

// Shows a form in place of the one shown, with nothing to undo.
void show(Ui ui, ref Design d, move Form form, string path) {
    d.form = move form
    d.path = path
    d.dirty = false
    d.undo.clear()
    d.redo.clear()
    d.editing = ""
    d.mode = 0
    d.picked.clear()
    sync(ui, ref d)
    showProperties(ui, ref d)
}

void open(Ui ui, ref Design d, string path) {
    try {
        Form form = readForm(path)
        string wrong = problem(form)
        if (wrong.len() > 0) {
            throw Error(wrong)
        }
        show(ui, ref d, move form, path)
        ui.status.setText(format("Opened {}", fs.fileName(path)))
    } catch (Exception e) {
        ui.status.setText(e.message())
    }
}

void save(Ui ui, ref Design d, string path) {
    try {
        writeForm(d.form, path)
        d.path = path
        d.dirty = false
        showPath(ui, ref d)
        ui.status.setText(format("Saved {} and {}", fs.fileName(path), fs.fileName(modulePath(path))))
    } catch (Exception e) {
        ui.status.setText(e.message())
    }
}

// Asks where to save the form, and saves it there.
void saveAs(Ui ui, thread.Shared<Design> state) {
    ui.w.saveFile(forms(), "window.form", [ui, state](string chosen) {
        if (chosen.len() > 0) {
            string path = chosen.endsWith(".form") ? chosen : chosen + ".form"
            state.lock([ui, path](ref Design d) { save(ui, ref d, path) })
        }
    })
}

// A new form, or the one that the user chooses to open.
// Saves the form in its file, or asks for one the first time.
void saveNow(Ui ui, thread.Shared<Design> state) {
    string target = ""
    state.lock([ref target](ref Design d) { target = d.path })
    if (target.len() == 0) {
        saveAs(ui, state)
    } else {
        state.lock([ui, target](ref Design d) { save(ui, ref d, target) })
    }
}

void leave(Ui ui, thread.Shared<Design> state, i32 what) {
    if (what == 1) {
        state.lock([ui](ref Design d) {
            show(ui, ref d, Form(), "")
            ui.status.setText("A new window")
        })
    } else if (what == 2) {
        ui.w.openFile(forms(), [ui, state](list<string> chosen) {
            if (chosen.len() > 0) {
                state.lock([ui, chosen](ref Design d) { open(ui, ref d, chosen[0]) })
            }
        })
    }
}

// Leaves the form for another one: at once, or after the question on its changes.
void leaving(Ui ui, thread.Shared<Design> state, i32 what) {
    bool dirty = false
    state.lock([ref dirty, what](ref Design d) {
        dirty = d.dirty
        d.pending = what
    })
    if (dirty) {
        ui.w.showDialog(ui.ask)
    } else {
        leave(ui, state, what)
    }
}

// ---- Run ----

// Builds the window of the form as a program, with the module made from it and nothing
// else, and runs it with the cromo that runs the designer: the window as it will be,
// with no handlers. A thread waits for it, so that the designer goes on.
void preview(Ui ui, thread.Shared<Design> state) {
    string module = ""
    string wrong = ""
    bool busy = false
    state.lock([ref module, ref wrong, ref busy](ref Design d) {
        busy = d.running
        wrong = problem(d.form)
        if (!busy && wrong.len() == 0) {
            Form shown = d.form
            shown.iconFile = pictureFile(d)
            module = moduleOf(shown, "the designer")
            d.running = true
        }
    })
    if (busy) {
        ui.status.setText("The window is already open: close it to run it again")
        ret
    }
    if (wrong.len() > 0) {
        ui.status.setText(wrong)
        ret
    }
    string folder = (os.env("TEMP").len() > 0 ? os.env("TEMP") : "/tmp") + "/cromo-design-preview"
    string program = "import preview_form\nimport std.gui\n\n[[window]]\ni32 main() {\n    preview_form.Form f = preview_form.Form()\n" +
        "    f.window.start()\n    ret 0\n}\n"
    try {
        fs.createFolders(folder)
        fs.writeText(folder + "/preview_form.cro", module)
        fs.writeText(folder + "/main.cro", program)
    } catch (Exception e) {
        state.lock([](ref Design d) { d.running = false })
        ui.status.setText(e.message())
        ret
    }
    string tool = os.env("CROMO").len() > 0 ? os.env("CROMO") : "cromo"
    ui.status.setText("Building the window...")
    thread.Thread waiter = thread.Thread([ui, state, move folder, move tool]() {
        string said = "The window is closed"
        try {
            process.Output r = process.run(tool, ["run", folder + "/main.cro"])
            if (r.code != 0) {
                list<string> lines = r.err.trim().split("\n")
                said = lines.len() > 0 && lines[0].len() > 0 ? lines[0] : format("The window ended with {}", r.code)
            }
        } catch (Exception e) {
            said = e.message()
        }
        state.lock([](ref Design d) { d.running = false })
        ui.status.setText(said)
    })
    waiter.start()
    waiter.detach()
}

// ---- The window of the designer ----

// The boxes of the colors of the window: the six of the light theme, then those of
// the dark one.
list<gui.Canvas> tonesOf(Ui ui) {
    ret [ui.lightBackground, ui.lightSurface, ui.lightText, ui.lightAccent, ui.lightSelection, ui.lightDanger,
        ui.darkBackground, ui.darkSurface, ui.darkText, ui.darkAccent, ui.darkSelection, ui.darkDanger]
}

// A property that is a color: its box, with room at its right for its swatch.
// The commands on the selection: 0 cut, 1 copy, 2 paste, 3 duplicate, 4 delete, 5
// select all; 10 to 21 arrange, 30 and 31 center in the window.
void command(Ui ui, thread.Shared<Design> state, i32 what) {
    state.lock([ui, what](ref Design d) {
        if (what == 0) {
            copyPicked(ui, ref d)
            removePicked(ui, ref d)
        } else if (what == 1) {
            copyPicked(ui, ref d)
        } else if (what == 2) {
            paste(ui, ref d)
        } else if (what == 3) {
            list<Item> kept = d.clip
            copyPicked(ui, ref d)
            paste(ui, ref d)
            d.clip = kept
        } else if (what == 4) {
            removePicked(ui, ref d)
        } else if (what == 5) {
            pickAll(ui, ref d)
        } else if (what >= 30) {
            center(ui, ref d, what == 30)
        } else {
            arrange(ui, ref d, what - 10)
        }
    })
}

gui.Menu editMenu(Ui ui, thread.Shared<Design> state) {
    gui.Menu menu
    menu.addItem("Cut\tCtrl+X", [ui, state]() { command(ui, state, 0) })
    menu.addIconItem(gui.Icon.Copy, "Copy\tCtrl+C", [ui, state]() { command(ui, state, 1) })
    menu.addIconItem(gui.Icon.Clipboard, "Paste\tCtrl+V", [ui, state]() { command(ui, state, 2) })
    menu.addItem("Duplicate\tCtrl+D", [ui, state]() { command(ui, state, 3) })
    menu.addSeparator()
    menu.addIconItem(gui.Icon.Trash2, "Delete\tDel", [ui, state]() { command(ui, state, 4) })
    menu.addItem("Select all\tCtrl+A", [ui, state]() { command(ui, state, 5) })
    ret menu
}

gui.Menu arrangeMenu(Ui ui, thread.Shared<Design> state) {
    gui.Menu menu
    menu.addItem("Align left", [ui, state]() { command(ui, state, 10) })
    menu.addItem("Align center", [ui, state]() { command(ui, state, 11) })
    menu.addItem("Align right", [ui, state]() { command(ui, state, 12) })
    menu.addSeparator()
    menu.addItem("Align top", [ui, state]() { command(ui, state, 13) })
    menu.addItem("Align middle", [ui, state]() { command(ui, state, 14) })
    menu.addItem("Align bottom", [ui, state]() { command(ui, state, 15) })
    menu.addSeparator()
    menu.addItem("Distribute across", [ui, state]() { command(ui, state, 16) })
    menu.addItem("Distribute down", [ui, state]() { command(ui, state, 17) })
    menu.addSeparator()
    menu.addItem("Same width", [ui, state]() { command(ui, state, 18) })
    menu.addItem("Same height", [ui, state]() { command(ui, state, 19) })
    menu.addSeparator()
    menu.addItem("Center across the window", [ui, state]() { command(ui, state, 30) })
    menu.addItem("Center down the window", [ui, state]() { command(ui, state, 31) })
    menu.addSeparator()
    menu.addIconItem(gui.Icon.Layers, "Bring to the front", [ui, state]() { command(ui, state, 20) })
    menu.addItem("Send to the back", [ui, state]() { command(ui, state, 21) })
    ret menu
}

gui.TextBox colorProperty(gui.Panel card, string title, i32 y) {
    card.add(gui.Label(title, 14, y + 4, 72, 20))
    gui.TextBox box = card.add(gui.TextBox("", 88, y, 128, 28))
    ret box
}

gui.TextBox property(gui.Panel card, string title, i32 y) {
    card.add(gui.Label(title, 14, y + 4, 72, 20))
    gui.TextBox box = card.add(gui.TextBox("", 88, y, 162, 28))
    ret box
}

