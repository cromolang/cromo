// The standard library of Cromo (D97). It is compiled with every program, and
// every module sees its public names without importing it (D130). It uses the
// `unsafe` dialect (D37, D98, D127): the type `addr` and the built-in functions
// alloc, resize, free, sizeOf, offset, take, put, destroy, copyAt, copyMemory,
// compareMemory, checkIndex, argumentCount, argumentLength, argumentData,
// decimalToFloat, hashBytes and equalAt.
//
// The compiler relies on the fields `data` and `length` of list and string, for
// `v[i]`, `for` over the elements, string literals and printing; on the fields
// `slots` and `capacity` of map, the layout of its slots and its methods valueOf
// and place, for `m[k]` and `for` (D197); and on the functions that read numbers
// and bytes (D199, D200).

import unsafe

// A dynamic array with its elements contiguous on the heap (D13).
public struct list<T> {
    addr data
    i64 length
    i64 capacity

    ~list() {
        for (i64 i = 0; i < length; i++) {
            destroy<T>(addressOf(i))
        }
        free(data)
    }

    public i64 len() const {
        ret length
    }

    public void add(move T value) {
        reserve(length + 1)
        put<T>(addressOf(length), move value)
        length++
    }

    public void insert(i64 index, move T value) {
        checkIndex(index, length + 1)
        reserve(length + 1)
        copyMemory(addressOf(index + 1), addressOf(index), (length - index) * sizeOf<T>())
        put<T>(addressOf(index), move value)
        length++
    }

    public T remove(i64 index) {
        checkIndex(index, length)
        T value = take<T>(addressOf(index))
        copyMemory(addressOf(index), addressOf(index + 1), (length - index - 1) * sizeOf<T>())
        length--
        ret value
    }

    public void clear() {
        for (i64 i = 0; i < length; i++) {
            destroy<T>(addressOf(i))
        }
        length = 0
    }

    // Makes room for `count` elements in all, so that adding them does not
    // move the elements again.
    public void reserve(i64 count) {
        if (count <= capacity) {
            ret
        }
        i64 grown = capacity * 2
        if (grown < count) {
            grown = count
        }
        if (grown < 4) {
            grown = 4
        }
        data = resize(data, grown * sizeOf<T>())
        capacity = grown
    }

    // A merge sort from the bottom (D421): runs of 1, 2, 4... elements merged into a
    // buffer, which goes back into the list at the end of each pass. Until then the
    // list keeps all its elements, so an exception of `less` loses none.
    void sortWith(func(T, T) bool less) {
        if (length < 2) {
            ret
        }
        i64 size = sizeOf<T>()
        addr buffer = alloc(length * size)
        try {
            for (i64 width = 1; width < length; width *= 2) {
                for (i64 low = 0; low < length; low += 2 * width) {
                    i64 middle = low + width
                    if (middle > length) {
                        middle = length
                    }
                    i64 high = middle + width
                    if (high > length) {
                        high = length
                    }
                    i64 i = low
                    i64 j = middle
                    for (i64 k = low; k < high; k++) {
                        i64 from = i
                        if (j < high && (i >= middle || lessAt(less, j, i))) {  // the right one only when before: stable
                            from = j
                            j++
                        } else {
                            i++
                        }
                        copyMemory(offset(buffer, k * size), addressOf(from), size)
                    }
                }
                copyMemory(data, buffer, length * size)
            }
        } finally {
            free(buffer)
        }
    }

    // Whether the element at `i` comes before the one at `j`: both are lent to less,
    // and given back also if it throws.
    bool lessAt(func(T, T) bool less, i64 i, i64 j) {
        T first = take<T>(addressOf(i))
        T second = take<T>(addressOf(j))
        bool result = false
        try {
            result = less(first, second)
        } finally {
            put<T>(addressOf(i), move first)
            put<T>(addressOf(j), move second)
        }
        ret result
    }

    public list<T> copy() const {
        list<T> result
        result.reserve(length)
        for (i64 i = 0; i < length; i++) {
            result.add(copyAt<T>(addressOf(i)))
        }
        ret result
    }

    // A new list with what `f` gives for each element (D92).
    public list<U> map<U>(func(T) U f) const {
        list<U> result
        result.reserve(length)
        for (i64 i = 0; i < length; i++) {
            T value = take<T>(addressOf(i))  // lent to f, and given back also if f throws
            try {
                result.add(f(value))
            } finally {
                put<T>(addressOf(i), move value)
            }
        }
        ret result
    }

    // A copy of the elements for which `keep` is true.
    public list<T> filter(func(T) bool keep) const {
        list<T> result
        for (i64 i = 0; i < length; i++) {
            T value = take<T>(addressOf(i))
            bool kept = false
            try {
                kept = keep(value)
            } finally {
                put<T>(addressOf(i), move value)
            }
            if (kept) {
                result.add(copyAt<T>(addressOf(i)))
            }
        }
        ret result
    }

    addr addressOf(i64 index) const {
        ret offset(data, index * sizeOf<T>())
    }
}

// UTF-8 text that owns its bytes (D10). A string literal has capacity 0: its
// bytes belong to the program, and they are copied the first time the string
// changes (D100).
public struct string : Key, Ordered {
    addr data
    i64 length
    i64 capacity

    ~string() {
        if (capacity > 0) {
            free(data)
        }
    }

    // The length in bytes (D12).
    public i64 len() const {
        ret length
    }

    public void reserve(i64 count) {
        if (count <= capacity) {
            ret
        }
        i64 grown = capacity * 2
        if (grown < count) {
            grown = count
        }
        if (grown < 16) {
            grown = 16
        }
        addr bytes = alloc(grown)
        copyMemory(bytes, data, length)
        if (capacity > 0) {
            free(data)
        }
        data = bytes
        capacity = grown
    }

    public void append(string other) {
        reserve(length + other.length)
        copyMemory(offset(data, length), other.data, other.length)
        length += other.length
    }

    public string concat(string other) const {
        string result
        result.reserve(length + other.length)
        copyMemory(result.data, data, length)
        copyMemory(offset(result.data, length), other.data, other.length)
        result.length = length + other.length
        ret result
    }

    public bool equals(string other) const {
        if (length != other.length) {
            ret false
        }
        ret compareMemory(data, other.data, length) == 0
    }

    public u64 hash() const {
        ret hashBytes(data, length)
    }

    // The order of the bytes, which in UTF-8 is the order of the code points (D95).
    public i32 compare(string other) const {
        i64 common = length
        if (other.length < common) {
            common = other.length
        }
        i32 order = compareMemory(data, other.data, common)
        if (order < 0 || (order == 0 && length < other.length)) {
            ret -1
        }
        if (order > 0 || (order == 0 && length > other.length)) {
            ret 1
        }
        ret 0
    }

    // The bytes of the text (D200).
    public list<u8> bytes() const {
        list<u8> result
        result.reserve(length)
        copyMemory(result.data, data, length)
        result.length = length
        ret result
    }

    // A copy of the bytes from `from` to `to` excluded (D200). A slice that cuts a
    // character of UTF-8 in two is a panic, as an index out of the string.
    public string slice(i64 from, i64 to) const {
        checkIndex(from, length + 1)
        checkIndex(to, length + 1)
        if (from > to) {
            panic(format("the slice starts at {}, after its end {} (D200)", from, to))
        }
        if (!startsCharacter(from) || !startsCharacter(to)) {
            panic(format("the slice from {} to {} cuts a character of UTF-8 (D200)", from, to))
        }
        string result
        result.reserve(to - from)
        copyMemory(result.data, offset(data, from), to - from)
        result.length = to - from
        ret result
    }

    // The index in bytes of the first `part`, or -1 without it (D304, D305).
    public i64 find(string part) const {
        ret findFrom(part, 0)
    }

    // The first `part` at `from` or after, or -1.
    public i64 findFrom(string part, i64 from) const {
        checkIndex(from, length + 1)
        if (part.length == 0) {
            ret from
        }
        u8 first = copyAt<u8>(part.data)
        for (i64 i = from; i <= length - part.length; i++) {
            if (copyAt<u8>(offset(data, i)) == first && compareMemory(offset(data, i), part.data, part.length) == 0) {
                ret i
            }
        }
        ret -1
    }

    // The last `part`, or -1.
    public i64 findLast(string part) const {
        for (i64 i = length - part.length; i >= 0; i--) {
            if (compareMemory(offset(data, i), part.data, part.length) == 0) {
                ret i
            }
        }
        ret -1
    }

    public bool contains(string part) const {
        ret find(part) >= 0
    }

    public bool startsWith(string prefix) const {
        ret prefix.length <= length && compareMemory(data, prefix.data, prefix.length) == 0
    }

    public bool endsWith(string suffix) const {
        ret suffix.length <= length && compareMemory(offset(data, length - suffix.length), suffix.data, suffix.length) == 0
    }

    // The pieces between the separators: "a,,b" gives "a", "" and "b". An empty
    // separator is a panic.
    public list<string> split(string separator) const {
        if (separator.length == 0) {
            panic("the separator of split() is empty (D304)")
        }
        list<string> pieces
        i64 start = 0
        i64 at = findFrom(separator, 0)
        for (at >= 0) {
            pieces.add(slice(start, at))
            start = at + separator.length
            at = findFrom(separator, start)
        }
        pieces.add(slice(start, length))
        ret pieces
    }

    // Without the spaces at the two ends: space, tab, the ends of line, vertical
    // tab and form feed of ASCII.
    public string trim() const {
        i64 start = spacesBefore()
        if (start == length) {  // only spaces
            ret ""
        }
        ret slice(start, length - spacesAfter())
    }

    public string trimStart() const {
        ret slice(spacesBefore(), length)
    }

    public string trimEnd() const {
        ret slice(0, length - spacesAfter())
    }

    // Every `old` becomes `new`. An empty `old` is a panic.
    public string replace(string old, string new) const {
        if (old.length == 0) {
            panic("the text to replace is empty (D304)")
        }
        string result
        result.reserve(length)
        i64 start = 0
        i64 at = findFrom(old, 0)
        for (at >= 0) {
            result.appendBytes(offset(data, start), at - start)
            result.append(new)
            start = at + old.length
            at = findFrom(old, start)
        }
        result.appendBytes(offset(data, start), length - start)
        ret result
    }

    // The letters a-z become A-Z; the rest of UTF-8 stays as it is (D306).
    public string upper() const {
        ret mapLetters('a', 'z', -32)
    }

    // The letters A-Z become a-z (D306).
    public string lower() const {
        ret mapLetters('A', 'Z', 32)
    }

    // The text `count` times.
    public string repeat(i64 count) const {
        if (count < 0) {
            panic(format("repeat() of a negative count, {} (D304)", count))
        }
        string result
        result.reserve(length * count)
        for (i64 i = 0; i < count; i++) {
            result.appendBytes(data, length)
        }
        ret result
    }

    i64 spacesBefore() const {
        i64 n = 0
        for (n < length && isSpace(copyAt<u8>(offset(data, n)))) {
            n++
        }
        ret n
    }

    i64 spacesAfter() const {
        i64 n = 0
        for (n < length && isSpace(copyAt<u8>(offset(data, length - 1 - n)))) {
            n++
        }
        ret n
    }

    string mapLetters(u8 from, u8 to, i32 shift) const {
        string result
        result.appendBytes(data, length)
        for (i64 i = 0; i < length; i++) {
            u8 c = copyAt<u8>(offset(result.data, i))
            if (c >= from && c <= to) {
                put<u8>(offset(result.data, i), u8(i32(c) + shift))
            }
        }
        ret result
    }

    void appendBytes(addr bytes, i64 count) {
        reserve(length + count)
        copyMemory(offset(data, length), bytes, count)
        length += count
    }

    // True at the end, and where a character starts: not on a byte 10xxxxxx.
    bool startsCharacter(i64 index) const {
        ret index == length || copyAt<u8>(offset(data, index)) & 0xC0 != 0x80
    }

    // `s.cstring()` in the modules with `import unsafe` (D204): the compiler takes
    // the address of this copy, which is destroyed at the end of the statement.
    CString zeroEnded() const {
        CString result
        result.data = alloc(length + 1)
        copyMemory(result.data, data, length)
        put<u8>(offset(result.data, length), 0)
        ret result
    }

    public string copy() const {
        string result
        if (capacity == 0) {  // a literal: the bytes can be shared
            result.data = data
            result.length = length
            ret result
        }
        result.reserve(length)
        copyMemory(result.data, data, length)
        result.length = length
        ret result
    }
}

// The parts one after the other, with `separator` between them (D304).
public string join(list<string> parts, string separator) {
    string result
    for (i64 i = 0; i < parts.len(); i++) {
        if (i > 0) {
            result.append(separator)
        }
        result.append(parts[i])
    }
    ret result
}

// ---- The form of debug of the values (D319) ----
//
// Every type has it but the functions and the interfaces: `{:?}` prints the text
// of debugText. The compiler turns debugWrite<T> into the function for T: one of
// these for a string, a list and a map, and one that it generates for the
// numbers, the arrays, the structs and the enums.

// The types that have a form of debug: all of them by themselves, as json.Data.
public interface Debug { }

public string debugText<T : Debug>(T value) {
    string out
    debugWrite<T>(ref out, value)
    ret out
}

// Between quotes, with the escapes of Cromo.
void debugString(ref string out, string value) {
    out += "\""
    for (i64 i = 0; i < value.len(); i++) {
        u8 c = value[i]
        if (c == '"') {
            out += "\\\""
        } else if (c == '\\') {
            out += "\\\\"
        } else if (c == '\n') {
            out += "\\n"
        } else if (c == '\r') {
            out += "\\r"
        } else if (c == '\t') {
            out += "\\t"
        } else if (c < 0x20 || c == 0x7F) {
            out += format("\\x{:02x}", c)
        } else {
            out.appendBytes(offset(value.data, i), 1)
        }
    }
    out += "\""
}

void debugList<T : Debug>(ref string out, list<T> values) {
    out += "["
    for (i64 i = 0; i < values.len(); i++) {
        if (i > 0) {
            out += ", "
        }
        debugWrite<T>(ref out, values[i])
    }
    out += "]"
}

// In the order of the map, which is not defined.
void debugMap<K : Key + Debug, V : Debug>(ref string out, map<K, V> values) {
    out += "{"
    bool first = true
    for (K key, V value in values) {
        if (!first) {
            out += ", "
        }
        first = false
        debugWrite<K>(ref out, key)
        out += ": "
        debugWrite<V>(ref out, value)
    }
    out += "}"
}

// The spaces that trim() removes: space, tab, line feed, vertical tab, form feed
// and carriage return.
bool isSpace(u8 c) {
    ret c == ' ' || (c >= 9 && c <= 13)
}

// The arguments of the program, the name of the program first, for
// `main(list<string> args)`: the entry point calls this function (D154).
list<string> programArguments() {
    list<string> args
    i64 count = argumentCount()
    for (i64 i = 0; i < count; i++) {
        string arg
        i64 length = argumentLength(i)
        arg.reserve(length)
        copyMemory(arg.data, argumentData(i), length)
        arg.length = length
        args.add(move arg)
    }
    ret args
}

// A copy of a string that ends with a zero, for the C functions (D204).
struct CString {
    addr data

    ~CString() {
        free(data)
    }
}

// The keys of a map (D198). The numbers and bool implement it by themselves.
public interface Key {
    u64 hash() const
    bool equals(Self other) const
}

// The order of two values (D421): negative when this comes first, zero when they are
// equal, positive when it comes after. The numbers and string have it by themselves.
public interface Ordered {
    i32 compare(Self other) const
}

// Sorts a list in the order of compare() (D421): stable, a merge sort.
public void sort<T : Ordered>(ref list<T> items) {
    items.sortWith([](T a, T b) bool { ret a.compare(b) < 0 })
}

// Sorts a list with `less`, which says whether the first value comes before the
// second (D421): stable, a merge sort. When less throws, the list keeps all its
// elements.
public void sortBy<T>(ref list<T> items, func(T, T) bool less) {
    items.sortWith(less)
}

// A hash table (D197, D198) with open addressing. A slot keeps together its
// hash, the key at 8 bytes and the value after it, so that a lookup reads one
// place of memory. The hash says what the slot holds: 0 empty, 1 removed, the
// hash of the key with its highest bit set when full; a key is compared only
// where the hashes are equal. The capacity is a power of two, and at most three
// quarters of the slots are full or removed.
public struct map<K : Key, V> {
    addr slots
    i64 length
    i64 taken  // full or removed
    i64 capacity

    ~map() {
        for (i64 i = 0; i < capacity; i++) {
            if (full(i)) {
                destroy<K>(keyAt(i))
                destroy<V>(valueAt(i))
            }
        }
        free(slots)
    }

    public i64 len() const {
        ret length
    }

    public bool contains(K key) const {
        ret find(key, key.hash()) >= 0
    }

    // Removes the key with its value; false if the key was not there.
    public bool remove(K key) {
        i64 slot = find(key, key.hash())
        if (slot < 0) {
            ret false
        }
        destroy<K>(keyAt(slot))
        destroy<V>(valueAt(slot))
        setHash(slot, 1)
        length--
        ret true
    }

    public map<K, V> copy() const {
        map<K, V> result
        if (capacity == 0) {
            ret result
        }
        result.allocate(capacity)
        for (i64 i = 0; i < capacity; i++) {
            if (full(i)) {
                put<K>(result.keyAt(i), copyAt<K>(keyAt(i)))
                put<V>(result.valueAt(i), copyAt<V>(valueAt(i)))
                result.length++
            }
            result.setHash(i, hashAt(i))
        }
        result.taken = taken
        ret result
    }

    // m[k], read: the value of a key that must be there (D197).
    addr valueOf(K key) const {
        i64 slot = find(key, key.hash())
        if (slot < 0) {
            panic("the key is not in the map (D197)")
        }
        ret valueAt(slot)
    }

    // m[k] = v, m[k] += v, m[k]++: the value of the key, added with the default
    // value when it is missing.
    addr place(K key) {
        u64 hash = key.hash()
        i64 slot = find(key, hash)
        if (slot >= 0) {
            ret valueAt(slot)
        }
        if ((taken + 1) * 4 > capacity * 3) {
            rehash()
        }
        slot = freeSlot(hash)
        if (hashAt(slot) == 0) {
            taken++
        }
        put<K>(keyAt(slot), key.copy())
        V fresh
        put<V>(valueAt(slot), move fresh)
        setHash(slot, mark(hash))
        length++
        ret valueAt(slot)
    }

    i64 find(K key, u64 hash) const {
        if (capacity == 0) {
            ret -1
        }
        u64 wanted = mark(hash)
        i64 slot = i64(hash & u64(capacity - 1))
        for {
            u64 seen = hashAt(slot)
            if (seen == 0) {
                ret -1
            }
            if (seen == wanted && equalAt<K>(keyAt(slot), key)) {
                ret slot
            }
            slot = (slot + 1) & (capacity - 1)
        }
    }

    // The first slot that is not full, from the place of the hash on.
    i64 freeSlot(u64 hash) const {
        i64 slot = i64(hash & u64(capacity - 1))
        for (full(slot)) {
            slot = (slot + 1) & (capacity - 1)
        }
        ret slot
    }

    // A larger table, or one of the same size without the removed slots. The
    // hashes kept in the slots place the keys again without computing them.
    void rehash() {
        i64 old = capacity
        addr oldSlots = slots
        i64 grown = capacity
        if (grown == 0) {
            grown = 8
        } else if (length * 2 >= capacity) {
            grown = capacity * 2
        }
        allocate(grown)
        taken = length
        i64 size = slotSize()
        for (i64 i = 0; i < old; i++) {
            addr from = offset(oldSlots, i * size)
            u64 seen = copyAt<u64>(from)
            if (seen >= 0x8000000000000000) {
                i64 slot = freeSlot(seen)
                put<K>(keyAt(slot), take<K>(offset(from, 8)))
                put<V>(valueAt(slot), take<V>(offset(from, valueOffset())))
                setHash(slot, seen)
            }
        }
        free(oldSlots)
    }

    // Empty slots for `count` keys, without freeing the old ones.
    void allocate(i64 count) {
        capacity = count
        slots = alloc(count * slotSize())
        for (i64 i = 0; i < count; i++) {
            setHash(i, 0)
        }
    }

    // A full slot keeps the hash with its highest bit set, never 0 or 1.
    u64 mark(u64 hash) const {
        ret hash | 0x8000000000000000
    }

    bool full(i64 slot) const {
        ret hashAt(slot) >= 0x8000000000000000
    }

    // The value after the key, at a multiple of 8: no type needs more.
    i64 valueOffset() const {
        ret 8 + (sizeOf<K>() + 7) / 8 * 8
    }

    i64 slotSize() const {
        ret valueOffset() + (sizeOf<V>() + 7) / 8 * 8
    }

    u64 hashAt(i64 slot) const {
        ret copyAt<u64>(offset(slots, slot * slotSize()))
    }

    void setHash(i64 slot, u64 hash) {
        put<u64>(offset(slots, slot * slotSize()), hash)
    }

    addr keyAt(i64 slot) const {
        ret offset(slots, slot * slotSize() + 8)
    }

    addr valueAt(i64 slot) const {
        ret offset(slots, slot * slotSize() + valueOffset())
    }
}

// What can be thrown (D36, D115).
public interface Exception {
    string message() const
}

// A ready-made exception with its message, for the simple cases (D115).
public struct Error : Exception {
    string text

    public Error(move string description) {
        text = move description
    }

    string message() const {
        ret text.copy()
    }
}

// `string(bytes)` (D200): a copy of the bytes, after checking that they are UTF-8.
string stringFromBytes(list<u8> bytes) {
    ret stringFromMemory(bytes.data, bytes.length)
}

// `string(data, length)` in the modules with `import unsafe`, as the bytes of the C
// functions and of the system (D204): the same check.
string stringFromMemory(addr data, i64 n) {
    i64 i = 0
    for (i < n) {
        u8 first = copyAt<u8>(offset(data, i))
        i64 size = 1
        u32 point = u32(first)
        u32 least = 0
        if (first < 0x80) {
            size = 1
        } else if (first & 0xE0 == 0xC0) {
            size = 2
            point = u32(first & 0x1F)
            least = 0x80
        } else if (first & 0xF0 == 0xE0) {
            size = 3
            point = u32(first & 0x0F)
            least = 0x800
        } else if (first & 0xF8 == 0xF0) {
            size = 4
            point = u32(first & 0x07)
            least = 0x10000
        } else {
            throw notUtf8(i)
        }
        if (i + size > n) {
            throw notUtf8(i)
        }
        for (i64 k = 1; k < size; k++) {
            u8 next = copyAt<u8>(offset(data, i + k))
            if (next & 0xC0 != 0x80) {
                throw notUtf8(i)
            }
            point = point << 6 | u32(next & 0x3F)
        }
        // Not the shortest form, a surrogate of UTF-16, or beyond Unicode.
        if (point < least || (point >= 0xD800 && point <= 0xDFFF) || point > 0x10FFFF) {
            throw notUtf8(i)
        }
        i += size
    }
    string result
    result.reserve(n)
    copyMemory(result.data, data, n)
    result.length = n
    ret result
}

Error notUtf8(i64 index) {
    ret Error(format("the bytes are not valid UTF-8: the character at {} (D200)", index))
}

// `i8("42")` to `i64("42")` (D199): the compiler passes the largest value of the type.
i64 parseSigned(string text, i64 max, string type) {
    bool negative = text.len() > 0 && text[0] == '-'
    u64 limit = u64(max)
    if (negative) {
        limit += 1
    }
    u64 magnitude = integerMagnitude(text, limit, type)
    if (!negative) {
        ret i64(magnitude)
    }
    if (magnitude == u64(max) + 1) {
        ret -max - 1
    }
    ret -i64(magnitude)
}

// `u8("42")` to `u64("42")` (D199): a minus sign only before a zero.
u64 parseUnsigned(string text, u64 max, string type) {
    u64 magnitude = integerMagnitude(text, max, type)
    if (text.len() > 0 && text[0] == '-' && magnitude != 0) {
        throw Error(format("'{}' does not fit in {} (D199)", text, type))
    }
    ret magnitude
}

// The digits of an integer, after an optional sign, up to `limit`.
u64 integerMagnitude(string text, u64 limit, string type) {
    i64 n = text.len()
    i64 start = 0
    if (n > 0 && (text[0] == '+' || text[0] == '-')) {
        start = 1
    }
    if (start == n) {
        throw notNumber(text, type)
    }
    u64 value = 0
    for (i64 i = start; i < n; i++) {
        u8 c = text[i]
        if (c < '0' || c > '9') {
            throw notNumber(text, type)
        }
        u64 digit = u64(c - '0')
        if (value > (limit - digit) / 10) {
            for (i64 j = i + 1; j < n; j++) {  // a text that is not a number says so first
                if (text[j] < '0' || text[j] > '9') {
                    throw notNumber(text, type)
                }
            }
            throw Error(format("'{}' does not fit in {} (D199)", text, type))
        }
        value = value * 10 + digit
    }
    ret value
}

Error notNumber(string text, string type) {
    ret Error(format("'{}' is not a valid {} (D199)", text, type))
}

// `f64("2.5")`, `f32("1e-3")` (D199): the text is checked here, the runtime finds
// the nearest value.
f64 parseFloat(string text, i64 bits, string type) {
    i32 kind = decimalKind(text)
    if (kind == 0) {
        throw notNumber(text, type)
    }
    f64 value = decimalToFloat(text.data, text.length, bits)
    if (kind == 1 && value - value != 0.0) {  // an infinity from a number too large
        throw Error(format("'{}' does not fit in {} (D199)", text, type))
    }
    ret value
}

// 1 for [+|-] digits [. digits] [e [+|-] digits], with at least one digit before
// the exponent; 2 for inf, infinity and nan in any case; 0 for anything else.
i32 decimalKind(string text) {
    i64 n = text.len()
    i64 i = 0
    if (n > 0 && (text[0] == '+' || text[0] == '-')) {
        i = 1
    }
    if (sameWord(text, i, "inf") || sameWord(text, i, "infinity") || sameWord(text, i, "nan")) {
        ret 2
    }
    i64 digits = 0
    for (i < n && isDigit(text[i])) {
        i++
        digits++
    }
    if (i < n && text[i] == '.') {
        i++
        for (i < n && isDigit(text[i])) {
            i++
            digits++
        }
    }
    if (digits == 0) {
        ret 0
    }
    if (i < n && (text[i] == 'e' || text[i] == 'E')) {
        i++
        if (i < n && (text[i] == '+' || text[i] == '-')) {
            i++
        }
        i64 exponent = 0
        for (i < n && isDigit(text[i])) {
            i++
            exponent++
        }
        if (exponent == 0) {
            ret 0
        }
    }
    if (i != n) {
        ret 0
    }
    ret 1
}

bool isDigit(u8 c) {
    ret c >= '0' && c <= '9'
}

// The text from `from` to its end is `word`, written in small letters, in any case.
bool sameWord(string text, i64 from, string word) {
    if (text.len() - from != word.len()) {
        ret false
    }
    for (i64 i = 0; i < word.len(); i++) {
        if (text[from + i] | 0x20 != word[i]) {
            ret false
        }
    }
    ret true
}
