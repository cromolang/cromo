// std.time on Linux (D202): clock_gettime and nanosleep, whose numbers are in
// time_linux_x86_64.cro and time_linux_arm64.cro (D408, P23), and the zone of the
// system from /etc/localtime, and the zones with a name from the files of the
// system (D203, D533). time.cro reads their format.
import unsafe
import std.fs

extern "cromo" {
    i64 cromo_task_sleep(i64 nanoseconds)  // 0 outside a task (D269)
}

i64 clock(i64 id) {
    addr spec = alloc(16)
    systemCall(i64(Call.ClockGetTime), id, spec, 0, 0, 0, 0)
    i64 result = copyAt<i64>(spec) * 1000000000 + copyAt<i64>(offset(spec, 8))
    free(spec)
    ret result
}

i64 monotonic() {
    ret clock(1)  // CLOCK_MONOTONIC
}

i64 unixNanoseconds() {
    ret clock(0)  // CLOCK_REALTIME
}

// In a task, the task waits and its thread runs the others (D269).
void pause(i64 nanoseconds) {
    if (nanoseconds <= 0 || cromo_task_sleep(nanoseconds) != 0) {
        ret
    }
    addr spec = alloc(16)
    put<i64>(spec, nanoseconds / 1000000000)
    put<i64>(offset(spec, 8), nanoseconds % 1000000000)
    for (systemCall(i64(Call.NanoSleep), spec, spec, 0, 0, 0, 0) == -4) {  // after a signal, what is left
    }
    free(spec)
}

// The offset of the zone at `seconds`, in minutes; 0 without /etc/localtime.
i32 localOffset(i64 seconds) {
    list<u8> data
    try {
        data = fs.readBytes("/etc/localtime")
    } catch (Exception e) {
        ret 0
    }
    ret i32(zoneOffset(data, seconds) / 60)
}

// The rules of the zone 'name' as the system has them, in TZif: a file of
// /usr/share/zoneinfo or, on Android, a piece of the file with all the zones. Empty
// when the system does not have the zone.
list<u8> systemZone(string name) {
    list<u8> none
    try {
        ret fs.readBytes("/usr/share/zoneinfo/" + name)
    } catch (Exception e) {
    }
    list<string> bundles = ["/apex/com.android.tzdata/etc/tz/tzdata", "/system/usr/share/zoneinfo/tzdata"]
    for (string bundle in bundles) {
        list<u8> all
        try {
            all = fs.readBytes(bundle)
        } catch (Exception e) {
            continue
        }
        if (all.len() < 24) {
            continue
        }
        // "tzdata2025b" and a zero, then where the index and the data start; an entry
        // of the index is a name of 40 bytes, a place in the data and a length.
        i64 index = number(all, 12, 4)
        i64 data = number(all, 16, 4)
        for (i64 at = index; at + 52 <= data && at + 52 <= all.len(); at += 52) {
            i64 size = 0
            for (size < 40 && all[at + size] != 0) {
                size++
            }
            if (size != name.len()) {
                continue
            }
            bool same = true
            for (i64 i = 0; i < size && same; i++) {
                same = all[at + i] == name[i]
            }
            if (!same) {
                continue
            }
            i64 from = data + number(all, at + 40, 4)
            i64 length = number(all, at + 44, 4)
            if (from < 0 || length < 0 || from + length > all.len()) {
                ret none
            }
            list<u8> rules
            rules.reserve(length)
            for (i64 i = 0; i < length; i++) {
                rules.add(all[from + i])
            }
            ret rules
        }
    }
    ret none
}
