// std.fs on Windows (D202): the functions of kernel32, with the paths in UTF-16.
import unsafe

extern "kernel32" {
    i64 CreateFileW(addr name, u32 access, u32 share, addr security, u32 creation, u32 flags, addr template)
    i32 ReadFile(i64 file, addr data, u32 size, ref u32 done, addr overlapped)
    i32 WriteFile(i64 file, addr data, u32 size, ref u32 done, addr overlapped)
    i32 CloseHandle(i64 handle)
    i32 GetFileSizeEx(i64 file, ref i64 size)
    i32 SetFilePointerEx(i64 file, i64 distance, ref i64 position, u32 method)
    i32 FlushFileBuffers(i64 file)
    i64 CreateFileMappingW(i64 file, addr security, u32 protect, u32 high, u32 low, addr name)
    addr MapViewOfFile(i64 mapping, u32 access, u32 high, u32 low, i64 size)
    i32 UnmapViewOfFile(addr view)
    u32 GetLastError()
    i32 DeleteFileW(addr name)
    i32 RemoveDirectoryW(addr name)
    i32 CreateDirectoryW(addr name, addr security)
    u32 GetFileAttributesW(addr name)
    i32 GetFileAttributesExW(addr name, i32 level, addr data)
    i32 MoveFileExW(addr from, addr to, u32 flags)
    i32 CopyFileW(addr from, addr to, i32 failIfExists)
    i64 FindFirstFileW(addr pattern, addr data)
    i32 FindNextFileW(i64 find, addr data)
    i32 FindClose(i64 find)
    i32 DeviceIoControl(i64 device, u32 code, addr input, u32 inputSize, addr output, u32 outputSize, ref u32 done,
        addr overlapped)
    u32 GetFullPathNameW(addr name, u32 size, addr buffer, addr part)
    i32 MultiByteToWideChar(u32 page, u32 flags, addr text, i32 size, addr wide, i32 wideSize)
    i32 WideCharToMultiByte(u32 page, u32 flags, addr wide, i32 size, addr text, i32 textSize, addr fallback, addr used)
}

// The bytes of a file, in memory to be freed, and how many they are.
addr loadFile(string path, ref i64 size) {
    addr none
    addr name = wide(path)
    // GENERIC_READ, OPEN_EXISTING, shared with those that read and write it, as an fs.File (D504)
    i64 file = CreateFileW(name, 0x80000000, 3, none, 3, 0x80, none)
    free(name)
    if (file == -1) {
        throw failure("read", path, GetLastError())
    }
    i64 length = 0
    GetFileSizeEx(file, ref length)
    addr data = alloc(length)
    i64 total = 0
    for (total < length) {
        i64 chunk = length - total
        if (chunk > 0x40000000) {
            chunk = 0x40000000
        }
        u32 done = 0
        if (ReadFile(file, offset(data, total), u32(chunk), ref done, none) == 0) {
            u32 code = GetLastError()
            CloseHandle(file)
            free(data)
            throw failure("read", path, code)
        }
        if (done == 0) {
            break
        }
        total += i64(done)
    }
    CloseHandle(file)
    size = total
    ret data
}

void storeFile(string path, addr data, i64 size, bool append) {
    addr none
    addr name = wide(path)
    u32 access = 0x40000000  // GENERIC_WRITE
    u32 creation = 2         // CREATE_ALWAYS
    if (append) {
        access = 4    // FILE_APPEND_DATA
        creation = 4  // OPEN_ALWAYS
    }
    i64 file = CreateFileW(name, access, 3, none, creation, 0x80, none)  // shared as an fs.File (D504)
    free(name)
    if (file == -1) {
        throw failure("write", path, GetLastError())
    }
    i64 total = 0
    for (total < size) {
        i64 chunk = size - total
        if (chunk > 0x40000000) {
            chunk = 0x40000000
        }
        u32 done = 0
        if (WriteFile(file, offset(data, total), u32(chunk), ref done, none) == 0) {
            u32 code = GetLastError()
            CloseHandle(file)
            throw failure("write", path, code)
        }
        total += i64(done)
    }
    CloseHandle(file)
}

// Whether a file or a folder exists at the path. It never throws: a path that
// cannot be reached gives false.
public bool exists(string path) {
    ret attributes(path) != 0xFFFFFFFF
}

// Whether the path is a folder, or a link to one; false if nothing is there.
public bool isFolder(string path) {
    u32 bits = attributes(path)
    ret bits != 0xFFFFFFFF && bits & 0x10 != 0  // FILE_ATTRIBUTE_DIRECTORY
}

// Whether the path is a file, or a link to one; false if nothing is there.
public bool isFile(string path) {
    u32 bits = attributes(path)
    ret bits != 0xFFFFFFFF && bits & 0x10 == 0
}

// Whether the path is a link: a symbolic link, or on Windows a junction too. The
// link itself is checked, not what it points to; false if nothing is there.
public bool isLink(string path) {
    u32 bits = attributes(path)
    ret bits != 0xFFFFFFFF && bits & 0x400 != 0  // FILE_ATTRIBUTE_REPARSE_POINT
}

// The size of a file, in bytes. Throws if it does not exist.
public i64 size(string path) {
    addr data = information(path, "read the size of")
    i64 bytes = i64(copyAt<u32>(offset(data, 28))) << 32 | i64(copyAt<u32>(offset(data, 32)))
    free(data)
    ret bytes
}

// The time of the last change of a file or a folder, in seconds from 1970-01-01
// UTC, as time.unix() gives it. Throws if the path does not exist.
public i64 modified(string path) {
    // From the units of 100 ns since 1601 of Windows.
    addr data = information(path, "read the date of")
    i64 time = i64(copyAt<u32>(offset(data, 24))) << 32 | i64(copyAt<u32>(offset(data, 20)))  // ftLastWriteTime
    free(data)
    ret (time - 116444736000000000) / 10000000
}

// Renames or moves a file or a folder; 'to' is the new path, also in another
// folder, and a file already there is replaced. Throws if 'from' does not exist.
// Only a file on Windows can move to another disk: otherwise both paths must be on
// the same one.
public void rename(string from, string to) {
    addr source = wide(from)
    addr target = wide(to)
    i32 done = MoveFileExW(source, target, 3)  // MOVEFILE_REPLACE_EXISTING | MOVEFILE_COPY_ALLOWED
    free(target)
    free(source)
    if (done == 0) {
        throw failure("rename", from, GetLastError())
    }
}

// Copies the file 'from' to 'to', which is replaced if it exists. Throws if 'from'
// does not exist or is a folder. On Linux the copy does not keep the permissions of
// the original: call makeExecutable for a program.
public void copy(string from, string to) {
    addr source = wide(from)
    addr target = wide(to)
    i32 done = CopyFileW(source, target, 0)
    free(target)
    free(source)
    if (done == 0) {
        throw failure("copy", from, GetLastError())
    }
}

// Whether the byte separates the names of a path: '/', and on Windows '\\' too.
public bool isSeparator(u8 c) {
    ret c == '/' || c == '\\'
}

// The separator that joinPath puts between the names of a path: "/" on Linux,
// '"\\"' on Windows.
public string separator() {
    ret "\\"
}

// WIN32_FILE_ATTRIBUTE_DATA, to be freed.
addr information(string path, string action) {
    addr name = wide(path)
    addr data = alloc(36)
    i32 done = GetFileAttributesExW(name, 0, data)  // GetFileExInfoStandard
    free(name)
    if (done == 0) {
        u32 code = GetLastError()
        free(data)
        throw failure(action, path, code)
    }
    ret data
}

// Removes a file, a link or an empty folder; a link is removed itself, not what it
// points to. Throws if the path does not exist, or if the folder is not empty:
// removeAll removes a folder with all that it holds.
public void remove(string path) {
    bool folder = isFolder(path)
    addr name = wide(path)
    i32 done = 0
    if (folder) {
        done = RemoveDirectoryW(name)
    } else {
        done = DeleteFileW(name)
    }
    free(name)
    if (done == 0) {
        throw failure("remove", path, GetLastError())
    }
}

// Creates a folder. Throws if the path exists already, or if the folder above it is
// missing: createFolders creates those too.
public void createFolder(string path) {
    addr none
    addr name = wide(path)
    i32 done = CreateDirectoryW(name, none)
    free(name)
    if (done == 0) {
        throw failure("create", path, GetLastError())
    }
}

// The names of the files, the folders and the links in a folder, without "." and
// "..", in no order: 'joinPath(path, name)' gives the path of each. Throws if the
// folder does not exist.
public list<string> listFolder(string path) {
    addr pattern = wide(path.concat("\\*"))
    addr data = alloc(592)  // WIN32_FIND_DATAW
    i64 find = FindFirstFileW(pattern, data)
    free(pattern)
    list<string> names
    if (find == -1) {
        u32 code = GetLastError()
        free(data)
        if (code == 2) {  // an empty folder
            ret names
        }
        throw failure("list", path, code)
    }
    for {
        addr name = offset(data, 44)  // cFileName
        i32 n = 0
        for (copyAt<u16>(offset(name, i64(n) * 2)) != 0) {
            n++
        }
        string text = narrow(name, n)
        if (text != "." && text != "..") {
            names.add(move text)
        }
        if (FindNextFileW(find, data) == 0) {
            break
        }
    }
    FindClose(find)
    free(data)
    ret names
}

// Makes 'path' a link to 'target'. On Linux it is a symbolic link that holds
// 'target' as it is written: a relative target is read from the folder of the link.
// On Windows it is a junction, which needs no administrator rights but can point
// only to a folder, and holds the absolute path of 'target'. Throws if 'path'
// exists already, and on Windows if 'target' is not a folder.
public void createLink(string target, string path) {
    // A junction (D288): an empty folder with a reparse point that names the target
    // as \??\C:\path, as mklink /J writes it.
    addr none
    if (!isFolder(target)) {
        throw fileError("link to", target, "on Windows a link is a junction, to a folder")
    }
    string full = fullPath(target)
    addr substitute = wide("\\??\\" + full)
    addr print = wide(full)
    i64 substituteSize = wideLength(substitute) * 2
    i64 printSize = wideLength(print) * 2
    i64 size = 16 + substituteSize + 2 + printSize + 2  // REPARSE_DATA_BUFFER of a mount point
    addr data = alloc(size)
    put<u32>(data, 0xA0000003)  // IO_REPARSE_TAG_MOUNT_POINT
    put<u16>(offset(data, 4), u16(size - 8))
    put<u16>(offset(data, 6), 0)
    put<u16>(offset(data, 8), 0)
    put<u16>(offset(data, 10), u16(substituteSize))
    put<u16>(offset(data, 12), u16(substituteSize + 2))
    put<u16>(offset(data, 14), u16(printSize))
    for (i64 i = 0; i < substituteSize + 2; i++) {
        put<u8>(offset(data, 16 + i), copyAt<u8>(offset(substitute, i)))
    }
    for (i64 i = 0; i < printSize + 2; i++) {
        put<u8>(offset(data, 16 + substituteSize + 2 + i), copyAt<u8>(offset(print, i)))
    }
    free(print)
    free(substitute)
    try {
        createFolder(path)
    } catch (Exception e) {
        free(data)
        throw
    }
    addr name = wide(path)
    i64 folder = CreateFileW(name, 0x40000000, 0, none, 3, 0x02200000, none)  // OPEN_REPARSE_POINT | BACKUP_SEMANTICS
    free(name)
    u32 code = GetLastError()
    i32 done = 0
    if (folder != -1) {
        u32 returned = 0
        done = DeviceIoControl(folder, 0x000900A4, data, u32(size), none, 0, ref returned, none)  // FSCTL_SET_REPARSE_POINT
        code = GetLastError()
        CloseHandle(folder)
    }
    free(data)
    if (done == 0) {
        remove(path)
        throw failure("link", path, code)
    }
}

// Where the link at the path points, as the link holds it: for a junction of
// Windows, an absolute path. Throws if the path does not exist or is not a link.
public string readLink(string path) {
    // The target of a junction or of a symbolic link, without the \??\ of Windows.
    addr none
    addr name = wide(path)
    i64 file = CreateFileW(name, 0, 7, none, 3, 0x02200000, none)  // OPEN_REPARSE_POINT | BACKUP_SEMANTICS
    free(name)
    if (file == -1) {
        throw failure("read the link", path, GetLastError())
    }
    addr data = alloc(16384)  // MAXIMUM_REPARSE_DATA_BUFFER_SIZE
    u32 returned = 0
    i32 done = DeviceIoControl(file, 0x000900A8, none, 0, data, 16384, ref returned, none)  // FSCTL_GET_REPARSE_POINT
    u32 code = GetLastError()
    CloseHandle(file)
    u32 tag = copyAt<u32>(data)
    if (done == 0 || (tag != 0xA0000003 && tag != 0xA000000C)) {  // a mount point, a symbolic link
        free(data)
        if (done == 0 && code != 4390) {  // ERROR_NOT_A_REPARSE_POINT
            throw failure("read the link", path, code)
        }
        throw fileError("read the link", path, "it is not a link")
    }
    i64 names = 16
    if (tag == 0xA000000C) {
        names = 20  // after the flags of a symbolic link
    }
    i64 at = i64(copyAt<u16>(offset(data, 8)))
    i64 length = i64(copyAt<u16>(offset(data, 10)))
    string target = narrow(offset(data, names + at), i32(length / 2))
    free(data)
    if (target.startsWith("\\??\\UNC\\")) {
        ret "\\\\" + target.slice(8, target.len())
    }
    if (target.startsWith("\\??\\")) {
        ret target.slice(4, target.len())
    }
    ret target
}

// Makes a file executable: on Linux it adds the permission to run it for those who
// can read it, as chmod +x does; on Windows, which runs a file by its extension,
// nothing changes. Throws if the file does not exist.
public void makeExecutable(string path) {
    if (!isFile(path)) {
        throw failure("make executable", path, 2)
    }
}

// The absolute path, without a separator at the end unless it is the root, "C:\".
string fullPath(string path) {
    addr none
    addr name = wide(path)
    u32 size = GetFullPathNameW(name, 0, none, none)
    addr buffer = alloc(i64(size) * 2)
    u32 length = GetFullPathNameW(name, size, buffer, none)
    free(name)
    string full = narrow(buffer, i32(length))
    free(buffer)
    if (full.len() > 3 && isSeparator(full[full.len() - 1])) {
        ret full.slice(0, full.len() - 1)
    }
    ret full
}

// The characters of a text in UTF-16, before its zero.
i64 wideLength(addr text) {
    i64 n = 0
    for (copyAt<u16>(offset(text, n * 2)) != 0) {
        n++
    }
    ret n
}

u32 attributes(string path) {
    addr name = wide(path)
    u32 bits = GetFileAttributesW(name)
    free(name)
    ret bits
}

Error failure(string action, string path, u32 code) {
    string reason = format("error {}", code)
    if (code == 2 || code == 3) {
        reason = "no such file or folder"
    } else if (code == 5) {
        reason = "access denied"
    } else if (code == 32) {
        reason = "it is used by another process"
    } else if (code == 80 || code == 183) {
        reason = "it exists already"
    } else if (code == 145) {
        reason = "the folder is not empty"
    } else if (code == 267) {
        reason = "a part of the path is not a folder"
    } else if (code == 112) {
        reason = "no space left"
    }
    ret fileError(action, path, reason)
}

// The text in UTF-16 with a zero at the end, for Windows: to be freed.
addr wide(string text) {
    addr none
    i32 n = i32(text.len())
    i32 size = MultiByteToWideChar(65001, 0, text.cstring(), n, none, 0) + 1
    addr buffer = alloc(i64(size) * 2)
    i32 written = MultiByteToWideChar(65001, 0, text.cstring(), n, buffer, size)
    put<u16>(offset(buffer, i64(written) * 2), 0)
    ret buffer
}

// `count` characters of UTF-16 as a string.
string narrow(addr text, i32 count) {
    addr none
    if (count == 0) {
        ret ""
    }
    i32 size = WideCharToMultiByte(65001, 0, text, count, none, 0, none, none)
    addr buffer = alloc(i64(size))
    WideCharToMultiByte(65001, 0, text, count, buffer, size, none, none)
    string result = string(buffer, i64(size))
    free(buffer)
    ret result
}

// ---- The files open, and the files mapped in memory (D504) ----

// The handle of the file at the path, open as the mode says, shared with the others
// that read and write it.
i64 fileOpen(string path, Mode mode) {
    addr none
    u32 access = 0x80000000  // GENERIC_READ
    u32 creation = 3         // OPEN_EXISTING
    if (mode == Mode.Update) {
        access = 0xC0000000  // GENERIC_READ | GENERIC_WRITE
    } else if (mode == Mode.Create) {
        access = 0xC0000000
        creation = 2  // CREATE_ALWAYS
    } else if (mode == Mode.Append) {
        access = 4    // FILE_APPEND_DATA: each write at the end
        creation = 4  // OPEN_ALWAYS
    }
    addr name = wide(path)
    i64 file = CreateFileW(name, access, 3, none, creation, 0x80, none)  // FILE_SHARE_READ | FILE_SHARE_WRITE
    free(name)
    if (file == -1) {
        throw failure("open", path, GetLastError())
    }
    ret file
}

void fileClose(i64 file) {
    CloseHandle(file)
}

// Up to 'count' bytes into 'data', from the position, or at it with -1, which then
// stays where it was: how many.
i64 fileRead(i64 file, addr data, i64 count, i64 position, string path) {
    addr none
    i64 before = position >= 0 ? fileSeek(file, 0, 1, path) : 0
    if (position >= 0) {
        fileSeek(file, position, 0, path)
    }
    i64 total = 0
    for (total < count) {
        i64 chunk = count - total
        if (chunk > 0x40000000) {
            chunk = 0x40000000
        }
        u32 done = 0
        if (ReadFile(file, offset(data, total), u32(chunk), ref done, none) == 0) {
            u32 code = GetLastError()
            if (code == 38) {  // ERROR_HANDLE_EOF
                break
            }
            throw failure("read", path, code)
        }
        if (done == 0) {
            break
        }
        total += i64(done)
    }
    if (position >= 0) {
        fileSeek(file, before, 0, path)
    }
    ret total
}

void fileWrite(i64 file, addr data, i64 count, i64 position, string path) {
    addr none
    i64 before = position >= 0 ? fileSeek(file, 0, 1, path) : 0
    if (position >= 0) {
        fileSeek(file, position, 0, path)
    }
    i64 total = 0
    for (total < count) {
        i64 chunk = count - total
        if (chunk > 0x40000000) {
            chunk = 0x40000000
        }
        u32 done = 0
        if (WriteFile(file, offset(data, total), u32(chunk), ref done, none) == 0) {
            throw failure("write", path, GetLastError())
        }
        total += i64(done)
    }
    if (position >= 0) {
        fileSeek(file, before, 0, path)
    }
}

// SetFilePointerEx: 'from' 0 the start, 1 the position; the new position.
i64 fileSeek(i64 file, i64 position, i32 from, string path) {
    i64 now = 0
    if (SetFilePointerEx(file, position, ref now, u32(from)) == 0) {
        throw failure("seek in", path, GetLastError())
    }
    ret now
}

i64 fileLength(i64 file, string path) {
    i64 size = 0
    if (GetFileSizeEx(file, ref size) == 0) {
        throw failure("read the size of", path, GetLastError())
    }
    ret size
}

void fileSync(i64 file, string path) {
    if (FlushFileBuffers(file) == 0) {
        throw failure("sync", path, GetLastError())
    }
}

// The file mapped in memory, read only, and its size; nothing mapped for an empty file.
// The view keeps the mapping: the handles are closed at once.
addr mapFile(string path, ref i64 size) {
    addr none
    i64 file = fileOpen(path, Mode.Read)
    i64 length = 0
    if (GetFileSizeEx(file, ref length) == 0 || length == 0) {
        u32 code = GetLastError()
        CloseHandle(file)
        if (length != 0) {
            throw failure("map", path, code)
        }
        size = 0
        ret none
    }
    i64 mapping = CreateFileMappingW(file, none, 2, 0, 0, none)  // PAGE_READONLY
    if (mapping == 0) {
        u32 code = GetLastError()
        CloseHandle(file)
        throw failure("map", path, code)
    }
    addr view = MapViewOfFile(mapping, 4, 0, 0, 0)  // FILE_MAP_READ
    u32 code = GetLastError()
    CloseHandle(mapping)
    CloseHandle(file)
    if (view == none) {
        throw failure("map", path, code)
    }
    size = length
    ret view
}

void unmapFile(addr data, i64 size) {
    UnmapViewOfFile(data)
}
