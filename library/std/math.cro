// The functions of mathematics on the numbers with a point: roots, powers,
// exponentials and logarithms, the trigonometric functions and their inverses, and
// the roundings to a whole number. They work on `f64`; an `f32` is converted.
//
// '''
// import std.math
//
// f64 diagonal = math.sqrt(2.0)                  // 1.4142135623730951
// f64 angle = math.atan2(1.0, 1.0)               // pi / 4
// f64 doubled = math.pow(2.0, 10.0)              // 1024
// f64 whole = math.floor(-2.5)                   // -3
// println("{:.3f}", math.sin(math.pi() / 6.0))   // 0.500
// '''
//
// The guide: [Numbers and operators](https://cromolang.org/book/en/operators.html).

// The module std.math (D556). The results are the same on every system and
// processor, bit for bit: the functions are written here, not taken from the C
// library of each system, and only the square root is an instruction of the
// processor, which rounds it exactly everywhere.
//
// exp, log, log2, log10, pow, sin, cos, tan, asin, acos, atan, atan2 and hypot are
// ported from the msun library of FreeBSD, which is fdlibm with its later fixes:
//
// ====================================================
// Copyright (C) 1993 by Sun Microsystems, Inc. All rights reserved.
// Copyright (C) 2004 by Sun Microsystems, Inc. All rights reserved.
//
// Developed at SunPro/SunSoft, a Sun Microsystems, Inc. business.
// Permission to use, copy, modify, and distribute this
// software is freely granted, provided that this notice
// is preserved.
// ====================================================
//
// The scaling by a power of two follows scalbn of musl (MIT, Copyright 2005-2020
// Rich Felker, et al.).
import unsafe

// ---- the bits of a number ----

// The high 32 bits of a number, with its sign and its exponent, as fdlibm reads them.
i32 high(f64 x) {
    ret i32(x.bits() >> 32)
}

u32 low(f64 x) {
    ret u32(x.bits())
}

f64 words(i32 top, u32 bottom) {
    ret f64.fromBits((u64(u32(top)) << 32) | u64(bottom))
}

f64 withHigh(f64 x, i32 top) {
    ret f64.fromBits((u64(u32(top)) << 32) | (x.bits() & 0xFFFFFFFF))
}

f64 highOnly(f64 x) {
    ret f64.fromBits(x.bits() & 0xFFFFFFFF00000000)
}

// x * 2^n, rounded once also when the result is too small for a whole mantissa.
f64 scale(f64 x, i32 n) {
    f64 y = x
    i32 k = n
    if (k > 1023) {
        y *= f64.fromBits(0x7FE0000000000000)
        k -= 1023
        if (k > 1023) {
            y *= f64.fromBits(0x7FE0000000000000)
            k -= 1023
            if (k > 1023) {
                k = 1023
            }
        }
    } else if (k < -1022) {
        // 2^-969 each time: the last product is the only one that rounds.
        y *= f64.fromBits(0x0360000000000000)
        k += 969
        if (k < -1022) {
            y *= f64.fromBits(0x0360000000000000)
            k += 969
            if (k < -1022) {
                k = -1022
            }
        }
    }
    ret y * f64.fromBits(u64(0x3ff + k) << 52)
}

// ---- the constants and the special values ----

// The ratio of a circle to its diameter, 3.141592653589793.
public f64 pi() {
    ret 3.14159265358979323846
}

// The base of the natural logarithms, 2.718281828459045.
public f64 e() {
    ret 2.71828182845904523536
}

// The infinity, larger than every number: `-math.infinity()` is the smallest.
public f64 infinity() {
    ret f64.fromBits(0x7FF0000000000000)
}

// A value that is not a number, as the result of 0.0 / 0.0: it is different from
// every number and from itself, and `isNaN` recognizes it.
//
// Where a function has no result it gives this one, and not what the processor
// makes by itself, whose sign changes from one processor to another.
public f64 nan() {
    ret f64.fromBits(0x7FF8000000000000)
}

// Whether x is not a number.
public bool isNaN(f64 x) {
    ret x != x
}

// Whether x is the infinity or its opposite.
public bool isInfinite(f64 x) {
    ret (x.bits() & 0x7FFFFFFFFFFFFFFF) == 0x7FF0000000000000
}

// ---- the sign, the whole numbers and the remainders ----

// x without its sign.
public f64 abs(f64 x) {
    ret f64.fromBits(x.bits() & 0x7FFFFFFFFFFFFFFF)
}

// x without what is after the point: the whole number towards zero. `trunc(-2.7)`
// is -2.
public f64 trunc(f64 x) {
    u64 bits = x.bits()
    i32 exponent = i32((bits >> 52) & 0x7FF) - 1023
    if (exponent >= 52) {
        ret x  // a whole number already, an infinity or not a number
    }
    if (exponent < 0) {
        ret f64.fromBits(bits & 0x8000000000000000)
    }
    u64 after = (u64(1) << u64(52 - exponent)) - 1
    ret f64.fromBits(bits & !after)
}

// The largest whole number that is not greater than x. `floor(-2.5)` is -3.
public f64 floor(f64 x) {
    f64 whole = trunc(x)
    ret whole > x ? whole - 1.0 : whole
}

// The smallest whole number that is not less than x. `ceil(2.1)` is 3.
public f64 ceil(f64 x) {
    f64 whole = trunc(x)
    ret whole < x ? whole + 1.0 : whole
}

// The nearest whole number; a number halfway between two goes away from zero:
// `round(2.5)` is 3 and `round(-2.5)` is -3.
public f64 round(f64 x) {
    f64 whole = trunc(x)
    if (abs(x - whole) >= 0.5) {
        ret x < 0.0 ? whole - 1.0 : whole + 1.0
    }
    ret whole
}

// The remainder of x / y, with the sign of x, as `%` of the integers: `mod(7.5, 2.0)`
// is 1.5. It is exact. Not a number when y is 0 or x is infinite.
public f64 mod(f64 x, f64 y) {
    u64 xBits = x.bits()
    u64 yBits = y.bits() & 0x7FFFFFFFFFFFFFFF
    u64 sign = xBits & 0x8000000000000000
    xBits &= 0x7FFFFFFFFFFFFFFF
    if (yBits == 0 || xBits >= 0x7FF0000000000000 || yBits > 0x7FF0000000000000) {
        ret (x * y) / (x * y)
    }
    if (xBits < yBits) {
        ret x
    }
    if (xBits == yBits) {
        ret f64.fromBits(sign)
    }
    // The mantissas with their first bit at 52, and the exponents as they are written.
    i32 xExponent = i32(xBits >> 52)
    i32 yExponent = i32(yBits >> 52)
    u64 xMantissa = xBits & 0x000FFFFFFFFFFFFF
    u64 yMantissa = yBits & 0x000FFFFFFFFFFFFF
    if (xExponent == 0) {
        xExponent = 1
        for (xMantissa < 0x0010000000000000) {
            xMantissa <<= 1
            xExponent--
        }
    } else {
        xMantissa |= 0x0010000000000000
    }
    if (yExponent == 0) {
        yExponent = 1
        for (yMantissa < 0x0010000000000000) {
            yMantissa <<= 1
            yExponent--
        }
    } else {
        yMantissa |= 0x0010000000000000
    }
    // The division of the school, a bit at a time: only the remainder is kept.
    for (i32 i = xExponent - yExponent; i > 0; i--) {
        if (xMantissa >= yMantissa) {
            xMantissa -= yMantissa
            if (xMantissa == 0) {
                ret f64.fromBits(sign)
            }
        }
        xMantissa <<= 1
    }
    if (xMantissa >= yMantissa) {
        xMantissa -= yMantissa
    }
    if (xMantissa == 0) {
        ret f64.fromBits(sign)
    }
    i32 exponent = yExponent
    for (xMantissa < 0x0010000000000000) {
        xMantissa <<= 1
        exponent--
    }
    if (exponent >= 1) {
        ret f64.fromBits(sign | (u64(exponent) << 52) | (xMantissa & 0x000FFFFFFFFFFFFF))
    }
    ret f64.fromBits(sign | (xMantissa >> u64(1 - exponent)))  // too small for a whole mantissa: exact all the same
}

// The smaller of two numbers. Not a number if one of them is not; -0.0 is smaller
// than 0.0.
public f64 min(f64 a, f64 b) {
    if (a != a || b != b) {
        ret nan()
    }
    if (a == b) {
        ret f64.fromBits(a.bits() | b.bits())  // equal, or the two zeros: the negative one
    }
    ret a < b ? a : b
}

// The larger of two numbers. Not a number if one of them is not; 0.0 is larger than
// -0.0.
public f64 max(f64 a, f64 b) {
    if (a != a || b != b) {
        ret nan()
    }
    if (a == b) {
        ret f64.fromBits(a.bits() & b.bits())  // equal, or the two zeros: the positive one
    }
    ret a > b ? a : b
}

// ---- the roots ----

// The square root of x, rounded exactly. Not a number for a negative x.
public f64 sqrt(f64 x) {
    if (x < 0.0) {
        ret nan()  // the same one on every processor
    }
    ret squareRoot(x)
}

// The square root of x * x + y * y, the length of the diagonal of a rectangle,
// without the squares going out of the range of the numbers.
public f64 hypot(f64 x, f64 y) {
    i32 ha = high(x) & 0x7fffffff
    i32 hb = high(y) & 0x7fffffff
    f64 a = x
    f64 b = y
    if (hb > ha) {
        a = y
        b = x
        i32 swapped = ha
        ha = hb
        hb = swapped
    }
    a = abs(a)
    b = abs(b)
    if (ha - hb > 0x3c00000) {
        ret a + b  // x / y > 2^60
    }
    i32 k = 0
    if (ha > 0x5f300000) {       // a > 2^500
        if (ha >= 0x7ff00000) {  // an infinity or not a number
            f64 w = abs(x) - abs(y)
            if ((u32(ha & 0xfffff) | low(a)) == 0) {
                w = a
            }
            if ((u32(hb ^ 0x7ff00000) | low(b)) == 0) {
                w = b
            }
            ret w
        }
        // a and b by 2^-600
        ha -= 0x25800000
        hb -= 0x25800000
        k += 600
        a = withHigh(a, ha)
        b = withHigh(b, hb)
    }
    if (hb < 0x20b00000) {       // b < 2^-500
        if (hb <= 0x000fffff) {  // b is 0 or too small for a whole mantissa
            if ((u32(hb) | low(b)) == 0) {
                ret a
            }
            f64 large = words(0x7fd00000, 0)  // 2^1022
            b *= large
            a *= large
            k -= 1022
        } else {  // a and b by 2^600
            ha += 0x25800000
            hb += 0x25800000
            k -= 600
            a = withHigh(a, ha)
            b = withHigh(b, hb)
        }
    }
    // a and b of a middle size
    f64 w = a - b
    if (w > b) {
        f64 t1 = words(ha, 0)
        f64 t2 = a - t1
        w = sqrt(t1 * t1 - (b * (-b) - t2 * (a + t1)))
    } else {
        a = a + a
        f64 y1 = words(hb, 0)
        f64 y2 = b - y1
        f64 t1 = words(ha + 0x00100000, 0)
        f64 t2 = a - t1
        w = sqrt(t1 * y1 - (w * (-w) - (t1 * y2 + t2 * b)))
    }
    if (k != 0) {
        ret words((1023 + k) << 20, 0) * w
    }
    ret w
}

// ---- the exponential and the logarithms ----

const f64 ln2High = 6.93147180369123816490e-01
const f64 ln2Low = 1.90821492927058770002e-10
const f64 inverseLn2 = 1.44269504088896338700e+00
const f64 expP1 = 1.66666666666666019037e-01
const f64 expP2 = -2.77777777770155933842e-03
const f64 expP3 = 6.61375632143793436117e-05
const f64 expP4 = -1.65339022054652515390e-06
const f64 expP5 = 4.13813679705723846039e-08

// e to the power x.
public f64 exp(f64 x) {
    i32 word = high(x)
    i32 sign = i32(u32(word) >> 31)
    i32 hx = word & 0x7fffffff
    if (hx >= 0x40862E42) {  // |x| >= 709.78...
        if (hx >= 0x7ff00000) {
            if ((u32(hx & 0xfffff) | low(x)) != 0) {
                ret x + x  // not a number
            }
            ret sign == 0 ? x : 0.0
        }
        if (x > 7.09782712893383973096e+02) {
            ret infinity()
        }
        if (x < -7.45133219101941108420e+02) {
            ret 0.0
        }
    }
    // The argument reduced to r = hi - lo, with x = k * ln2 + r.
    f64 hi = 0.0
    f64 lo = 0.0
    i32 k = 0
    f64 r = x
    if (hx > 0x3fd62e42) {      // |x| > 0.5 ln2
        if (hx < 0x3FF0A2B2) {  // and |x| < 1.5 ln2
            hi = x - (sign == 0 ? ln2High : -ln2High)
            lo = sign == 0 ? ln2Low : -ln2Low
            k = 1 - sign - sign
        } else {
            k = i32(inverseLn2 * x + (sign == 0 ? 0.5 : -0.5))
            f64 t = f64(k)
            hi = x - t * ln2High  // t * ln2High is exact here
            lo = t * ln2Low
        }
        r = hi - lo
    } else if (hx < 0x3e300000) {  // |x| < 2^-28
        ret 1.0 + x
    }
    f64 t = r * r
    f64 twoToK = k >= -1021 ? words((0x3ff + k) << 20, 0) : words((0x3ff + (k + 1000)) << 20, 0)
    f64 c = r - t * (expP1 + t * (expP2 + t * (expP3 + t * (expP4 + t * expP5))))
    if (k == 0) {
        ret 1.0 - ((r * c) / (c - 2.0) - r)
    }
    f64 y = 1.0 - ((lo - (r * c) / (2.0 - c)) - hi)
    if (k >= -1021) {
        if (k == 1024) {
            ret y * 2.0 * f64.fromBits(0x7FE0000000000000)
        }
        ret y * twoToK
    }
    ret y * twoToK * f64.fromBits(0x0170000000000000)  // 2^-1000
}

const f64 two54 = 1.80143985094819840000e+16
const f64 logLg1 = 6.666666666666735130e-01
const f64 logLg2 = 3.999999999940941908e-01
const f64 logLg3 = 2.857142874366239149e-01
const f64 logLg4 = 2.222219843214978396e-01
const f64 logLg5 = 1.818357216161805012e-01
const f64 logLg6 = 1.531383769920937332e-01
const f64 logLg7 = 1.479819860511658591e-01

// The natural logarithm of x, in base e. Not a number for a negative x, the
// opposite of the infinity for 0.
public f64 log(f64 x) {
    i32 hx = high(x)
    i32 k = 0
    f64 v = x
    if (hx < 0x00100000) {  // x < 2^-1022
        if ((u32(hx & 0x7fffffff) | low(x)) == 0) {
            ret -infinity()
        }
        if (hx < 0) {
            ret nan()
        }
        k -= 54
        v = x * two54  // too small for a whole mantissa: made larger
        hx = high(v)
    }
    if (hx >= 0x7ff00000) {
        ret v + v
    }
    k += (hx >> 20) - 1023
    hx &= 0x000fffff
    i32 i = (hx + 0x95f64) & 0x100000
    v = withHigh(v, hx | (i ^ 0x3ff00000))  // v or v / 2, near 1
    k += i >> 20
    f64 f = v - 1.0
    if ((0x000fffff & (2 + hx)) < 3) {  // -2^-20 <= f < 2^-20
        if (f == 0.0) {
            if (k == 0) {
                ret 0.0
            }
            f64 dk = f64(k)
            ret dk * ln2High + dk * ln2Low
        }
        f64 R = f * f * (0.5 - 0.33333333333333333 * f)
        if (k == 0) {
            ret f - R
        }
        f64 dk = f64(k)
        ret dk * ln2High - ((R - dk * ln2Low) - f)
    }
    f64 s = f / (2.0 + f)
    f64 dk = f64(k)
    f64 z = s * s
    i = hx - 0x6147a
    f64 w = z * z
    i32 j = 0x6b851 - hx
    f64 t1 = w * (logLg2 + w * (logLg4 + w * logLg6))
    f64 t2 = z * (logLg1 + w * (logLg3 + w * (logLg5 + w * logLg7)))
    i |= j
    f64 R = t2 + t1
    if (i > 0) {
        f64 hfsq = 0.5 * f * f
        if (k == 0) {
            ret f - (hfsq - s * (hfsq + R))
        }
        ret dk * ln2High - ((hfsq - (s * (hfsq + R) + dk * ln2Low)) - f)
    }
    if (k == 0) {
        ret f - s * (f - R)
    }
    ret dk * ln2High - ((s * (f - R) - dk * ln2Low) - f)
}

// log(1 + f) - f + f * f / 2, for the logarithms in the other bases.
f64 logTail(f64 f) {
    f64 s = f / (2.0 + f)
    f64 z = s * s
    f64 w = z * z
    f64 t1 = w * (logLg2 + w * (logLg4 + w * logLg6))
    f64 t2 = z * (logLg1 + w * (logLg3 + w * (logLg5 + w * logLg7)))
    f64 R = t2 + t1
    f64 hfsq = 0.5 * f * f
    ret s * (hfsq + R)
}

const f64 inverseLn2High = 1.44269504072144627571e+00
const f64 inverseLn2Low = 1.67517131648865118353e-10

// The logarithm of x in base 2: `log2(8.0)` is 3.
public f64 log2(f64 x) {
    i32 hx = high(x)
    u32 lx = low(x)
    i32 k = 0
    f64 v = x
    if (hx < 0x00100000) {
        if ((u32(hx & 0x7fffffff) | lx) == 0) {
            ret -infinity()
        }
        if (hx < 0) {
            ret nan()
        }
        k -= 54
        v = x * two54
        hx = high(v)
    }
    if (hx >= 0x7ff00000) {
        ret v + v
    }
    if (hx == 0x3ff00000 && lx == 0) {
        ret 0.0
    }
    k += (hx >> 20) - 1023
    hx &= 0x000fffff
    i32 i = (hx + 0x95f64) & 0x100000
    v = withHigh(v, hx | (i ^ 0x3ff00000))
    k += i >> 20
    f64 y = f64(k)
    f64 f = v - 1.0
    f64 hfsq = 0.5 * f * f
    f64 r = logTail(f)
    // f - hfsq in two parts, and y added to them without losing what is small: near
    // the square root of 2 the sum cancels.
    f64 hi = highOnly(f - hfsq)
    f64 lo = (f - hi) - hfsq + r
    f64 valueHigh = hi * inverseLn2High
    f64 valueLow = (lo + hi) * inverseLn2Low + lo * inverseLn2High
    f64 w = y + valueHigh
    valueLow += (y - w) + valueHigh
    valueHigh = w
    ret valueLow + valueHigh
}

const f64 inverseLn10High = 4.34294481878168880939e-01
const f64 inverseLn10Low = 2.50829467116452752298e-11
const f64 log10Of2High = 3.01029995663611771306e-01
const f64 log10Of2Low = 3.69423907715893078616e-13

// The logarithm of x in base 10: `log10(1000.0)` is 3.
public f64 log10(f64 x) {
    i32 hx = high(x)
    u32 lx = low(x)
    i32 k = 0
    f64 v = x
    if (hx < 0x00100000) {
        if ((u32(hx & 0x7fffffff) | lx) == 0) {
            ret -infinity()
        }
        if (hx < 0) {
            ret nan()
        }
        k -= 54
        v = x * two54
        hx = high(v)
    }
    if (hx >= 0x7ff00000) {
        ret v + v
    }
    if (hx == 0x3ff00000 && lx == 0) {
        ret 0.0
    }
    k += (hx >> 20) - 1023
    hx &= 0x000fffff
    i32 i = (hx + 0x95f64) & 0x100000
    v = withHigh(v, hx | (i ^ 0x3ff00000))
    k += i >> 20
    f64 y = f64(k)
    f64 f = v - 1.0
    f64 hfsq = 0.5 * f * f
    f64 r = logTail(f)
    f64 hi = highOnly(f - hfsq)
    f64 lo = (f - hi) - hfsq + r
    f64 valueHigh = hi * inverseLn10High
    f64 y2 = y * log10Of2High
    f64 valueLow = y * log10Of2Low + (lo + hi) * inverseLn10Low + lo * inverseLn10High
    f64 w = y2 + valueHigh
    valueLow += (y2 - w) + valueHigh
    valueHigh = w
    ret valueLow + valueHigh
}

// ---- the power ----

const f64[2] powBp = [1.0, 1.5]
const f64[2] powDpHigh = [0.0, 5.84962487220764160156e-01]
const f64[2] powDpLow = [0.0, 1.35003920212974897128e-08]
const f64 powL1 = 5.99999999999994648725e-01
const f64 powL2 = 4.28571428578550184252e-01
const f64 powL3 = 3.33333329818377432918e-01
const f64 powL4 = 2.72728123808534006489e-01
const f64 powL5 = 2.30660745775561754067e-01
const f64 powL6 = 2.06975017800338417784e-01
const f64 powLg2 = 6.93147180559945286227e-01
const f64 powLg2High = 6.93147182464599609375e-01
const f64 powLg2Low = -1.90465429995776804525e-09
const f64 powOvt = 8.0085662595372944372e-0017  // -(1024 - log2(the largest number + half a step))
const f64 powCp = 9.61796693925975554329e-01    // 2 / (3 ln2)
const f64 powCpHigh = 9.61796700954437255859e-01
const f64 powCpLow = -7.02846165095275826516e-09
const f64 powIvln2 = 1.44269504088896338700e+00
const f64 powIvln2High = 1.44269502162933349609e+00
const f64 powIvln2Low = 1.92596299112661746887e-08
const f64 powHuge = 1.0e300
const f64 powTiny = 1.0e-300

// x to the power y. `pow(x, 0.0)` is 1 for every x; a negative x with a y that is
// not whole gives not a number.
public f64 pow(f64 x, f64 y) {
    i32 hx = high(x)
    u32 lx = low(x)
    i32 hy = high(y)
    u32 ly = low(y)
    i32 ix = hx & 0x7fffffff
    i32 iy = hy & 0x7fffffff

    if ((u32(iy) | ly) == 0) {
        ret 1.0  // x^0 = 1
    }
    if (hx == 0x3ff00000 && lx == 0) {
        ret 1.0  // 1^y = 1, also if y is not a number
    }
    if (ix > 0x7ff00000 || (ix == 0x7ff00000 && lx != 0) || iy > 0x7ff00000 || (iy == 0x7ff00000 && ly != 0)) {
        ret x + y  // not a number
    }

    // For a negative x: 0 if y is not whole, 1 if it is odd, 2 if it is even.
    i32 yIsWhole = 0
    if (hx < 0) {
        if (iy >= 0x43400000) {
            yIsWhole = 2
        } else if (iy >= 0x3ff00000) {
            i32 k = (iy >> 20) - 0x3ff
            if (k > 20) {
                u32 j = ly >> u32(52 - k)
                if ((j << u32(52 - k)) == ly) {
                    yIsWhole = 2 - i32(j & 1)
                }
            } else if (ly == 0) {
                i32 j = iy >> (20 - k)
                if ((j << (20 - k)) == iy) {
                    yIsWhole = 2 - (j & 1)
                }
            }
        }
    }

    // The special values of y.
    if (ly == 0) {
        if (iy == 0x7ff00000) {  // y is an infinity
            if ((u32(ix - 0x3ff00000) | lx) == 0) {
                ret 1.0  // (-1)^infinity is 1
            }
            if (ix >= 0x3ff00000) {  // (|x| > 1)^infinity
                ret hy >= 0 ? y : 0.0
            }
            ret hy < 0 ? -y : 0.0
        }
        if (iy == 0x3ff00000) {  // y is 1 or -1
            ret hy < 0 ? 1.0 / x : x
        }
        if (hy == 0x40000000) {
            ret x * x
        }
        if (hy == 0x3fe00000 && hx >= 0) {
            ret sqrt(x)
        }
    }

    f64 ax = abs(x)
    // The special values of x: 0, the infinities, 1 and -1.
    if (lx == 0 && (ix == 0x7ff00000 || ix == 0 || ix == 0x3ff00000)) {
        f64 z = ax
        if (hy < 0) {
            z = 1.0 / z
        }
        if (hx < 0) {
            if (((ix - 0x3ff00000) | yIsWhole) == 0) {
                z = (z - z) / (z - z)  // (-1)^(not whole)
            } else if (yIsWhole == 1) {
                z = -z
            }
        }
        ret z
    }

    i32 n = i32(u32(hx) >> 31) - 1
    if ((n | yIsWhole) == 0) {
        ret isNaN(x) ? x : nan()  // (x < 0)^(not whole)
    }
    f64 s = 1.0  // the sign of the result: -1 for a negative x and an odd y
    if ((n | (yIsWhole - 1)) == 0) {
        s = -1.0
    }

    // log2(|x|) as t1 + t2.
    f64 t1 = 0.0
    f64 t2 = 0.0
    if (iy > 0x41e00000) {      // |y| > 2^31
        if (iy > 0x43f00000) {  // |y| > 2^64: out of the range on one side
            if (ix <= 0x3fefffff) {
                ret hy < 0 ? powHuge * powHuge : powTiny * powTiny
            }
            if (ix >= 0x3ff00000) {
                ret hy > 0 ? powHuge * powHuge : powTiny * powTiny
            }
        }
        if (ix < 0x3fefffff) {
            ret hy < 0 ? s * powHuge * powHuge : s * powTiny * powTiny
        }
        if (ix > 0x3ff00000) {
            ret hy > 0 ? s * powHuge * powHuge : s * powTiny * powTiny
        }
        // |1 - x| <= 2^-20: log(x) by x - x^2/2 + x^3/3 - x^4/4
        f64 t = ax - 1.0
        f64 w = (t * t) * (0.5 - t * (3.3333333333333331e-01 - t * 0.25))
        f64 u = powIvln2High * t
        f64 v = t * powIvln2Low - w * powIvln2
        t1 = highOnly(u + v)
        t2 = v - (t1 - u)
    } else {
        n = 0
        if (ix < 0x00100000) {  // too small for a whole mantissa
            ax *= 9007199254740992.0
            n -= 53
            ix = high(ax)
        }
        n += (ix >> 20) - 0x3ff
        i32 j = ix & 0x000fffff
        // The interval of |x|.
        ix = j | 0x3ff00000
        i32 k = 0
        if (j <= 0x3988E) {
            k = 0  // |x| < sqrt(3/2)
        } else if (j < 0xBB67A) {
            k = 1  // |x| < sqrt(3)
        } else {
            k = 0
            n += 1
            ix -= 0x00100000
        }
        ax = withHigh(ax, ix)

        // ss = sHigh + sLow = (x - 1) / (x + 1) or (x - 1.5) / (x + 1.5)
        f64 u = ax - powBp[k]
        f64 v = 1.0 / (ax + powBp[k])
        f64 ss = u * v
        f64 sHigh = highOnly(ss)
        f64 tHigh = words(((ix >> 1) | 0x20000000) + 0x00080000 + (k << 18), 0)
        f64 tLow = ax - (tHigh - powBp[k])
        f64 sLow = v * ((u - sHigh * tHigh) - sHigh * tLow)
        // log(ax)
        f64 s2 = ss * ss
        f64 r = s2 * s2 * (powL1 + s2 * (powL2 + s2 * (powL3 + s2 * (powL4 + s2 * (powL5 + s2 * powL6)))))
        r += sLow * (sHigh + ss)
        s2 = sHigh * sHigh
        tHigh = highOnly(3.0 + s2 + r)
        tLow = r - ((tHigh - 3.0) - s2)
        u = sHigh * tHigh
        v = sLow * tHigh + tLow * ss
        // 2 / (3 log2) * (ss + ...)
        f64 pHigh = highOnly(u + v)
        f64 pLow = v - (pHigh - u)
        f64 zHigh = powCpHigh * pHigh
        f64 zLow = powCpLow * pHigh + pLow * powCp + powDpLow[k]
        // log2(ax) = (ss + ...) * 2 / (3 log2) = n + dpHigh + zHigh + zLow
        f64 t = f64(n)
        t1 = highOnly(((zHigh + zLow) + powDpHigh[k]) + t)
        t2 = zLow - (((t1 - t) - powDpHigh[k]) - zHigh)
    }

    // y in two parts, and (y1 + y2) * (t1 + t2)
    f64 y1 = highOnly(y)
    f64 pLow = (y - y1) * t1 + y * t2
    f64 pHigh = y1 * t1
    f64 z = pLow + pHigh
    i32 j = high(z)
    u32 i = low(z)
    if (j >= 0x40900000) {  // z >= 1024
        if ((u32(j - 0x40900000) | i) != 0) {
            ret s * powHuge * powHuge
        }
        if (pLow + powOvt > z - pHigh) {
            ret s * powHuge * powHuge
        }
    } else if ((j & 0x7fffffff) >= 0x4090cc00) {  // z <= -1075
        if (((u32(j) ^ 0xc090cc00) | i) != 0) {
            ret s * powTiny * powTiny
        }
        if (pLow <= z - pHigh) {
            ret s * powTiny * powTiny
        }
    }
    // 2^(pHigh + pLow)
    i32 top = j & 0x7fffffff
    i32 k = (top >> 20) - 0x3ff
    n = 0
    if (top > 0x3fe00000) {  // |z| > 0.5: n = the whole number nearest to z
        n = wrapAdd(j, 0x00100000 >> (k + 1))
        k = ((n & 0x7fffffff) >> 20) - 0x3ff
        f64 t = words(n & !(0x000fffff >> k), 0)
        n = ((n & 0x000fffff) | 0x00100000) >> (20 - k)
        if (j < 0) {
            n = -n
        }
        pHigh -= t
    }
    f64 t = highOnly(pLow + pHigh)
    f64 u = t * powLg2High
    f64 v = (pLow - (t - pHigh)) * powLg2 + t * powLg2Low
    z = u + v
    f64 w = v - (z - u)
    t = z * z
    f64 t3 = z - t * (expP1 + t * (expP2 + t * (expP3 + t * (expP4 + t * expP5))))
    f64 r = (z * t3) / (t3 - 2.0) - (w + z * w)
    z = 1.0 - (r - z)
    j = high(z)
    j = wrapAdd(j, i32(u32(n) << 20))
    if ((j >> 20) <= 0) {
        z = scale(z, n)  // a result too small for a whole mantissa
    } else {
        z = withHigh(z, j)
    }
    ret s * z
}

// ---- the trigonometric functions ----

const f64 sinS1 = -1.66666666666666324348e-01
const f64 sinS2 = 8.33333333332248946124e-03
const f64 sinS3 = -1.98412698298579493134e-04
const f64 sinS4 = 2.75573137070700676789e-06
const f64 sinS5 = -2.50507602534068634195e-08
const f64 sinS6 = 1.58969099521155010221e-10

// The sine of x + y for |x| <= pi / 4, y the small tail of x; `tail` is false when
// y is 0.
f64 kernelSin(f64 x, f64 y, bool tail) {
    f64 z = x * x
    f64 w = z * z
    f64 r = sinS2 + z * (sinS3 + z * sinS4) + z * w * (sinS5 + z * sinS6)
    f64 v = z * x
    if (!tail) {
        ret x + v * (sinS1 + z * r)
    }
    ret x - ((z * (0.5 * y - v * r) - y) - v * sinS1)
}

const f64 cosC1 = 4.16666666666666019037e-02
const f64 cosC2 = -1.38888888888741095749e-03
const f64 cosC3 = 2.48015872894767294178e-05
const f64 cosC4 = -2.75573143513906633035e-07
const f64 cosC5 = 2.08757232129817482790e-09
const f64 cosC6 = -1.13596475577881948265e-11

// The cosine of x + y for |x| <= pi / 4.
f64 kernelCos(f64 x, f64 y) {
    f64 z = x * x
    f64 w = z * z
    f64 r = z * (cosC1 + z * (cosC2 + z * cosC3)) + w * w * (cosC4 + z * (cosC5 + z * cosC6))
    f64 hz = 0.5 * z
    w = 1.0 - hz
    ret w + (((1.0 - w) - hz) + (z * r - x * y))
}

const f64[13] tanT = [
    3.33333333333334091986e-01, 1.33333333333201242699e-01, 5.39682539762260521377e-02, 2.18694882948595424599e-02,
    8.86323982359930005737e-03, 3.59207910759131235356e-03, 1.45620945432529025516e-03, 5.88041240820264096874e-04,
    2.46463134818469906812e-04, 7.81794442939557092300e-05, 7.14072491382608190305e-05, -1.85586374855275456654e-05,
    2.59073051863633712884e-05
]
const f64 piOver4 = 7.85398163397448278999e-01
const f64 piOver4Low = 3.06161699786838301793e-17

// The tangent of x + y for |x| <= pi / 4 with `direct` 1, and -1 / tan(x + y) with
// `direct` -1.
f64 kernelTan(f64 x0, f64 y0, i32 direct) {
    f64 x = x0
    f64 y = y0
    i32 hx = high(x)
    i32 ix = hx & 0x7fffffff
    if (ix >= 0x3FE59428) {  // |x| >= 0.6744
        if (hx < 0) {
            x = -x
            y = -y
        }
        f64 z = piOver4 - x
        f64 w = piOver4Low - y
        x = z + w
        y = 0.0
    }
    f64 z = x * x
    f64 w = z * z
    f64 r = tanT[1] + w * (tanT[3] + w * (tanT[5] + w * (tanT[7] + w * (tanT[9] + w * tanT[11]))))
    f64 v = z * (tanT[2] + w * (tanT[4] + w * (tanT[6] + w * (tanT[8] + w * (tanT[10] + w * tanT[12])))))
    f64 s = z * x
    r = y + z * (s * (r + v) + y)
    r += tanT[0] * s
    w = x + r
    if (ix >= 0x3FE59428) {
        v = f64(direct)
        ret f64(1 - ((hx >> 30) & 2)) * (v - 2.0 * (x - (w * w / (w + v) - r)))
    }
    if (direct == 1) {
        ret w
    }
    // -1 / (x + r), exactly
    z = highOnly(w)
    v = r - (z - x)  // z + v = r + x
    f64 a = -1.0 / w
    f64 t = highOnly(a)
    s = 1.0 + t * z
    ret t + a * (s + t * v)
}

// The bits of 2 / pi after the point, 24 at a time: enough for the largest f64.
const i32[66] twoOverPi = [
    0xA2F983, 0x6E4E44, 0x1529FC, 0x2757D1, 0xF534DD, 0xC0DB62,
    0x95993C, 0x439041, 0xFE5163, 0xABDEBB, 0xC561B7, 0x246E3A,
    0x424DD2, 0xE00649, 0x2EEA09, 0xD1921C, 0xFE1DEB, 0x1CB129,
    0xA73EE8, 0x8235F5, 0x2EBB44, 0x84E99C, 0x7026B4, 0x5F7E41,
    0x3991D6, 0x398353, 0x39F49C, 0x845F8B, 0xBDF928, 0x3B1FF8,
    0x97FFDE, 0x05980F, 0xEF2F11, 0x8B5A0A, 0x6D1F6D, 0x367ECF,
    0x27CB09, 0xB74F46, 0x3F669E, 0x5FEA2D, 0x7527BA, 0xC7EBE5,
    0xF17B3D, 0x0739F7, 0x8A5292, 0xEA6BFB, 0x5FB11F, 0x8D5D08,
    0x560330, 0x46FC7B, 0x6BABF0, 0xCFBC20, 0x9AF436, 0x1DA9E3,
    0x91615E, 0xE61B08, 0x659985, 0x5F14A0, 0x68408D, 0xFFD880,
    0x4D7327, 0x310606, 0x1556CA, 0x73A8C9, 0x60E27B, 0xC08C6B
]

// pi / 2 in pieces of 24 bits.
const f64[8] piOver2Parts = [
    1.57079625129699707031e+00, 7.54978941586159635335e-08, 5.39030252995776476554e-15, 3.28200341580791294123e-22,
    1.27065575308067607349e-29, 1.22933308981111328932e-36, 2.73370053816464559624e-44, 2.16741683877804819444e-51
]

const f64 two24 = 1.67772160000000000000e+07
const f64 twoToMinus24 = 5.96046447753906250000e-08

// The remainder of a large number by pi / 2, as y0 + y1, and the last three bits of
// the quotient. The number is x[0..count - 1], pieces of 24 bits, the first with
// the exponent e0: the product with as many bits of 2 / pi as are needed.
i32 kernelRemPio2(f64[3] x, i32 e0, i32 count, ref f64 y0, ref f64 y1) {
    i32[20] iq
    f64[20] f
    f64[20] fq
    f64[20] q
    i32 jk = 4
    i32 jp = jk
    i32 jx = count - 1
    i32 jv = (e0 - 3) / 24
    if (jv < 0) {
        jv = 0
    }
    i32 q0 = e0 - 24 * (jv + 1)

    // f[0..jx + jk], where f[jx + jk] is twoOverPi[jv + jk]
    i32 j = jv - jx
    i32 m = jx + jk
    for (i32 i = 0; i <= m; i++) {
        f[i] = j < 0 ? 0.0 : f64(twoOverPi[j])
        j++
    }
    for (i32 i = 0; i <= jk; i++) {
        f64 fw = 0.0
        for (j = 0; j <= jx; j++) {
            fw += x[j] * f[jx + i - j]
        }
        q[i] = fw
    }

    i32 jz = jk
    f64 z = 0.0
    i32 n = 0
    i32 ih = 0
    for {
        // q[] into iq[], from the last
        i32 i = 0
        z = q[jz]
        for (j = jz; j > 0; j--) {
            f64 fw = f64(i32(twoToMinus24 * z))
            iq[i] = i32(z - two24 * fw)
            z = q[j - 1] + fw
            i++
        }

        z = scale(z, q0)
        z -= 8.0 * floor(z * 0.125)  // without the whole part from 8 on
        n = i32(z)
        z -= f64(n)
        ih = 0
        if (q0 > 0) {  // iq[jz - 1] is needed for n
            i = iq[jz - 1] >> (24 - q0)
            n += i
            iq[jz - 1] -= i << (24 - q0)
            ih = iq[jz - 1] >> (23 - q0)
        } else if (q0 == 0) {
            ih = iq[jz - 1] >> 23
        } else if (z >= 0.5) {
            ih = 2
        }

        if (ih > 0) {  // q > 0.5
            n += 1
            i32 carry = 0
            for (i = 0; i < jz; i++) {  // 1 - q
                j = iq[i]
                if (carry == 0) {
                    if (j != 0) {
                        carry = 1
                        iq[i] = 0x1000000 - j
                    }
                } else {
                    iq[i] = 0xffffff - j
                }
            }
            if (q0 == 1) {
                iq[jz - 1] &= 0x7fffff
            } else if (q0 == 2) {
                iq[jz - 1] &= 0x3fffff
            }
            if (ih == 2) {
                z = 1.0 - z
                if (carry != 0) {
                    z -= scale(1.0, q0)
                }
            }
        }

        // More bits of 2 / pi are needed when everything cancelled.
        if (z == 0.0) {
            j = 0
            for (i = jz - 1; i >= jk; i--) {
                j |= iq[i]
            }
            if (j == 0) {
                i32 k = 1
                for (iq[jk - k] == 0) {
                    k++
                }
                for (i = jz + 1; i <= jz + k; i++) {
                    f[jx + i] = f64(twoOverPi[jv + i])
                    f64 fw = 0.0
                    for (j = 0; j <= jx; j++) {
                        fw += x[j] * f[jx + i - j]
                    }
                    q[i] = fw
                }
                jz += k
                continue
            }
        }
        break
    }

    // The zero terms are left out.
    if (z == 0.0) {
        jz -= 1
        q0 -= 24
        for (iq[jz] == 0) {
            jz--
            q0 -= 24
        }
    } else {  // z in pieces of 24 bits
        z = scale(z, -q0)
        if (z >= two24) {
            f64 fw = f64(i32(twoToMinus24 * z))
            iq[jz] = i32(z - two24 * fw)
            jz += 1
            q0 += 24
            iq[jz] = i32(fw)
        } else {
            iq[jz] = i32(z)
        }
    }

    // The whole pieces as numbers with a point.
    f64 fw = scale(1.0, q0)
    for (i32 i = jz; i >= 0; i--) {
        q[i] = fw * f64(iq[i])
        fw *= twoToMinus24
    }

    // piOver2Parts[0..jp] * q[jz..0]
    for (i32 i = jz; i >= 0; i--) {
        fw = 0.0
        for (i32 k = 0; k <= jp && k <= jz - i; k++) {
            fw += piOver2Parts[k] * q[i + k]
        }
        fq[jz - i] = fw
    }

    // fq[] into y0 + y1
    fw = 0.0
    for (i32 i = jz; i >= 0; i--) {
        fw += fq[i]
    }
    y0 = ih == 0 ? fw : -fw
    fw = fq[0] - fw
    for (i32 i = 1; i <= jz; i++) {
        fw += fq[i]
    }
    y1 = ih == 0 ? fw : -fw
    ret n & 7
}

const f64 inversePiOver2 = 6.36619772367581382433e-01
const f64 piOver2First = 1.57079632673412561417e+00      // the first 33 bits of pi / 2
const f64 piOver2FirstTail = 6.07710050650619224932e-11  // pi / 2 less them
const f64 piOver2Second = 6.07710050630396597660e-11     // the second 33 bits
const f64 piOver2SecondTail = 2.02226624879595063154e-21
const f64 piOver2Third = 2.02226624871116645580e-21  // the third 33 bits
const f64 piOver2ThirdTail = 8.47842766036889956997e-32

// x less the nearest multiple of pi / 2, as y0 + y1, and that multiple, of which
// the last bits count. For |x| > pi / 4.
i32 remPio2(f64 x, ref f64 y0, ref f64 y1) {
    i32 hx = high(x)
    i32 ix = hx & 0x7fffffff
    bool medium = false
    if (ix <= 0x400f6a7a) {               // |x| ~<= 5 pi / 4
        if ((ix & 0xfffff) == 0x921fb) {  // |x| ~= pi / 2 or pi: the difference cancels
            medium = true
        } else if (ix <= 0x4002d97c) {  // |x| ~<= 3 pi / 4
            if (hx > 0) {
                f64 z = x - piOver2First
                y0 = z - piOver2FirstTail
                y1 = (z - y0) - piOver2FirstTail
                ret 1
            }
            f64 z = x + piOver2First
            y0 = z + piOver2FirstTail
            y1 = (z - y0) + piOver2FirstTail
            ret -1
        } else {
            if (hx > 0) {
                f64 z = x - 2.0 * piOver2First
                y0 = z - 2.0 * piOver2FirstTail
                y1 = (z - y0) - 2.0 * piOver2FirstTail
                ret 2
            }
            f64 z = x + 2.0 * piOver2First
            y0 = z + 2.0 * piOver2FirstTail
            y1 = (z - y0) + 2.0 * piOver2FirstTail
            ret -2
        }
    } else if (ix <= 0x401c463b) {   // |x| ~<= 9 pi / 4
        if (ix <= 0x4015fdbc) {      // |x| ~<= 7 pi / 4
            if (ix == 0x4012d97c) {  // |x| ~= 3 pi / 2
                medium = true
            } else if (hx > 0) {
                f64 z = x - 3.0 * piOver2First
                y0 = z - 3.0 * piOver2FirstTail
                y1 = (z - y0) - 3.0 * piOver2FirstTail
                ret 3
            } else {
                f64 z = x + 3.0 * piOver2First
                y0 = z + 3.0 * piOver2FirstTail
                y1 = (z - y0) + 3.0 * piOver2FirstTail
                ret -3
            }
        } else {
            if (ix == 0x401921fb) {  // |x| ~= 2 pi
                medium = true
            } else if (hx > 0) {
                f64 z = x - 4.0 * piOver2First
                y0 = z - 4.0 * piOver2FirstTail
                y1 = (z - y0) - 4.0 * piOver2FirstTail
                ret 4
            } else {
                f64 z = x + 4.0 * piOver2First
                y0 = z + 4.0 * piOver2FirstTail
                y1 = (z - y0) + 4.0 * piOver2FirstTail
                ret -4
            }
        }
    }
    if (medium || ix < 0x413921fb) {  // |x| ~< 2^20 * (pi / 2)
        // The nearest whole number, by adding and taking away 1.5 * 2^52.
        f64 fn = (x * inversePiOver2 + 6755399441055744.0) - 6755399441055744.0
        i32 n = i32(fn)
        f64 r = x - fn * piOver2First
        f64 w = fn * piOver2FirstTail  // the first round, good to 85 bits
        i32 j = ix >> 20
        y0 = r - w
        i32 i = j - ((high(y0) >> 20) & 0x7ff)
        if (i > 16) {  // the second round, good to 118 bits
            f64 t = r
            w = fn * piOver2Second
            r = t - w
            w = fn * piOver2SecondTail - ((t - r) - w)
            y0 = r - w
            i = j - ((high(y0) >> 20) & 0x7ff)
            if (i > 49) {  // the third, 151 bits: it covers every case
                t = r
                w = fn * piOver2Third
                r = t - w
                w = fn * piOver2ThirdTail - ((t - r) - w)
                y0 = r - w
            }
        }
        y1 = (r - y0) - w
        ret n
    }
    if (ix >= 0x7ff00000) {  // an infinity or not a number
        y0 = isNaN(x) ? x : nan()
        y1 = y0
        ret 0
    }
    // The large numbers: |x| as three pieces of 24 bits.
    i32 e0 = (ix >> 20) - 1046
    f64 z = words(ix - (e0 << 20), low(x))
    f64[3] pieces
    for (i32 i = 0; i < 2; i++) {
        pieces[i] = f64(i32(z))
        z = (z - pieces[i]) * two24
    }
    pieces[2] = z
    i32 count = 3
    for (pieces[count - 1] == 0.0) {
        count--
    }
    f64 a = 0.0
    f64 b = 0.0
    i32 n = kernelRemPio2(pieces, e0, count, ref a, ref b)
    if (hx < 0) {
        y0 = -a
        y1 = -b
        ret -n
    }
    y0 = a
    y1 = b
    ret n
}

// The sine of x, an angle in radians.
public f64 sin(f64 x) {
    i32 ix = high(x) & 0x7fffffff
    if (ix <= 0x3fe921fb) {     // |x| ~< pi / 4
        if (ix < 0x3e500000) {  // |x| < 2^-26
            ret x
        }
        ret kernelSin(x, 0.0, false)
    }
    if (ix >= 0x7ff00000) {
        ret isNaN(x) ? x : nan()  // not a number
    }
    f64 y0 = 0.0
    f64 y1 = 0.0
    i32 n = remPio2(x, ref y0, ref y1)
    switch (n & 3) {
        case 0 {
            ret kernelSin(y0, y1, true)
        }
        case 1 {
            ret kernelCos(y0, y1)
        }
        case 2 {
            ret -kernelSin(y0, y1, true)
        }
        default {
            ret -kernelCos(y0, y1)
        }
    }
}

// The cosine of x, an angle in radians.
public f64 cos(f64 x) {
    i32 ix = high(x) & 0x7fffffff
    if (ix <= 0x3fe921fb) {
        if (ix < 0x3e46a09e) {  // |x| < 2^-27 * sqrt(2)
            ret 1.0
        }
        ret kernelCos(x, 0.0)
    }
    if (ix >= 0x7ff00000) {
        ret isNaN(x) ? x : nan()
    }
    f64 y0 = 0.0
    f64 y1 = 0.0
    i32 n = remPio2(x, ref y0, ref y1)
    switch (n & 3) {
        case 0 {
            ret kernelCos(y0, y1)
        }
        case 1 {
            ret -kernelSin(y0, y1, true)
        }
        case 2 {
            ret -kernelCos(y0, y1)
        }
        default {
            ret kernelSin(y0, y1, true)
        }
    }
}

// The tangent of x, an angle in radians.
public f64 tan(f64 x) {
    i32 ix = high(x) & 0x7fffffff
    if (ix <= 0x3fe921fb) {
        if (ix < 0x3e400000) {  // |x| < 2^-27
            ret x
        }
        ret kernelTan(x, 0.0, 1)
    }
    if (ix >= 0x7ff00000) {
        ret isNaN(x) ? x : nan()
    }
    f64 y0 = 0.0
    f64 y1 = 0.0
    i32 n = remPio2(x, ref y0, ref y1)
    ret kernelTan(y0, y1, 1 - ((n & 1) << 1))  // 1 for an even n, -1 for an odd one
}

// ---- the inverses of the trigonometric functions ----

const f64 piOver2High = 1.57079632679489655800e+00
const f64 piOver2Low = 6.12323399573676603587e-17
const f64 piOver4High = 7.85398163397448278999e-01
const f64 piHigh = 3.14159265358979311600e+00
const f64 piLow = 1.2246467991473531772e-16
const f64 asinP0 = 1.66666666666666657415e-01
const f64 asinP1 = -3.25565818622400915405e-01
const f64 asinP2 = 2.01212532134862925881e-01
const f64 asinP3 = -4.00555345006794114027e-02
const f64 asinP4 = 7.91534994289814532176e-04
const f64 asinP5 = 3.47933107596021167570e-05
const f64 asinQ1 = -2.40339491173441421878e+00
const f64 asinQ2 = 2.02094576023350569471e+00
const f64 asinQ3 = -6.88283971605453293030e-01
const f64 asinQ4 = 7.70381505559019352791e-02

// The angle whose sine is x, from -pi / 2 to pi / 2. Not a number for |x| > 1.
public f64 asin(f64 x) {
    i32 hx = high(x)
    i32 ix = hx & 0x7fffffff
    if (ix >= 0x3ff00000) {  // |x| >= 1
        if ((u32(ix - 0x3ff00000) | low(x)) == 0) {
            ret x * piOver2High + x * piOver2Low  // asin(1) = pi / 2
        }
        ret isNaN(x) ? x : nan()
    }
    if (ix < 0x3fe00000) {      // |x| < 0.5
        if (ix < 0x3e500000) {  // |x| < 2^-26
            ret x
        }
        f64 t = x * x
        f64 p = t * (asinP0 + t * (asinP1 + t * (asinP2 + t * (asinP3 + t * (asinP4 + t * asinP5)))))
        f64 q = 1.0 + t * (asinQ1 + t * (asinQ2 + t * (asinQ3 + t * asinQ4)))
        f64 w = p / q
        ret x + x * w
    }
    // 1 > |x| >= 0.5
    f64 w = 1.0 - abs(x)
    f64 t = w * 0.5
    f64 p = t * (asinP0 + t * (asinP1 + t * (asinP2 + t * (asinP3 + t * (asinP4 + t * asinP5)))))
    f64 q = 1.0 + t * (asinQ1 + t * (asinQ2 + t * (asinQ3 + t * asinQ4)))
    f64 s = sqrt(t)
    if (ix >= 0x3FEF3333) {  // |x| > 0.975
        w = p / q
        t = piOver2High - (2.0 * (s + s * w) - piOver2Low)
    } else {
        w = highOnly(s)
        f64 c = (t - w * w) / (s + w)
        f64 r = p / q
        p = 2.0 * s * r - (piOver2Low - 2.0 * c)
        q = piOver4High - 2.0 * w
        t = piOver4High - (p - q)
    }
    ret hx > 0 ? t : -t
}

// The angle whose cosine is x, from 0 to pi. Not a number for |x| > 1.
public f64 acos(f64 x) {
    i32 hx = high(x)
    i32 ix = hx & 0x7fffffff
    if (ix >= 0x3ff00000) {  // |x| >= 1
        if ((u32(ix - 0x3ff00000) | low(x)) == 0) {
            ret hx > 0 ? 0.0 : piHigh + 2.0 * piOver2Low
        }
        ret isNaN(x) ? x : nan()
    }
    if (ix < 0x3fe00000) {       // |x| < 0.5
        if (ix <= 0x3c600000) {  // |x| < 2^-57
            ret piOver2High + piOver2Low
        }
        f64 z = x * x
        f64 p = z * (asinP0 + z * (asinP1 + z * (asinP2 + z * (asinP3 + z * (asinP4 + z * asinP5)))))
        f64 q = 1.0 + z * (asinQ1 + z * (asinQ2 + z * (asinQ3 + z * asinQ4)))
        f64 r = p / q
        ret piOver2High - (x - (piOver2Low - x * r))
    }
    if (hx < 0) {  // x < -0.5
        f64 z = (1.0 + x) * 0.5
        f64 p = z * (asinP0 + z * (asinP1 + z * (asinP2 + z * (asinP3 + z * (asinP4 + z * asinP5)))))
        f64 q = 1.0 + z * (asinQ1 + z * (asinQ2 + z * (asinQ3 + z * asinQ4)))
        f64 s = sqrt(z)
        f64 r = p / q
        f64 w = r * s - piOver2Low
        ret piHigh - 2.0 * (s + w)
    }
    // x > 0.5
    f64 z = (1.0 - x) * 0.5
    f64 s = sqrt(z)
    f64 df = highOnly(s)
    f64 c = (z - df * df) / (s + df)
    f64 p = z * (asinP0 + z * (asinP1 + z * (asinP2 + z * (asinP3 + z * (asinP4 + z * asinP5)))))
    f64 q = 1.0 + z * (asinQ1 + z * (asinQ2 + z * (asinQ3 + z * asinQ4)))
    f64 r = p / q
    f64 w = r * s + c
    ret 2.0 * (df + w)
}

// atan(0.5), atan(1), atan(1.5) and atan(infinity), each in two parts.
const f64[4] atanHigh = [4.63647609000806093515e-01, 7.85398163397448278999e-01, 9.82793723247329054082e-01, 1.57079632679489655800e+00]
const f64[4] atanLow = [2.26987774529616870924e-17, 3.06161699786838301793e-17, 1.39033110312309984516e-17, 6.12323399573676603587e-17]
const f64[11] atanT = [
    3.33333333333329318027e-01, -1.99999999998764832476e-01, 1.42857142725034663711e-01, -1.11111104054623557880e-01,
    9.09088713343650656196e-02, -7.69187620504482999495e-02, 6.66107313738753120669e-02, -5.83357013379057348645e-02,
    4.97687799461593236017e-02, -3.65315727442169155270e-02, 1.62858201153657823623e-02
]

// The angle whose tangent is x, from -pi / 2 to pi / 2.
public f64 atan(f64 x) {
    i32 hx = high(x)
    i32 ix = hx & 0x7fffffff
    if (ix >= 0x44100000) {  // |x| >= 2^66
        if (ix > 0x7ff00000 || (ix == 0x7ff00000 && low(x) != 0)) {
            ret x + x  // not a number
        }
        ret hx > 0 ? atanHigh[3] + atanLow[3] : -atanHigh[3] - atanLow[3]
    }
    f64 v = x
    i32 id = -1
    if (ix < 0x3fdc0000) {      // |x| < 0.4375
        if (ix < 0x3e400000) {  // |x| < 2^-27
            ret x
        }
    } else {
        v = abs(x)
        if (ix < 0x3ff30000) {      // |x| < 1.1875
            if (ix < 0x3fe60000) {  // 7/16 <= |x| < 11/16
                id = 0
                v = (2.0 * v - 1.0) / (2.0 + v)
            } else {  // 11/16 <= |x| < 19/16
                id = 1
                v = (v - 1.0) / (v + 1.0)
            }
        } else if (ix < 0x40038000) {  // |x| < 2.4375
            id = 2
            v = (v - 1.5) / (1.0 + 1.5 * v)
        } else {  // 2.4375 <= |x| < 2^66
            id = 3
            v = -1.0 / v
        }
    }
    f64 z = v * v
    f64 w = z * z
    // The sum of atanT[i] * z^(i + 1) in its odd and its even terms.
    f64 s1 = z * (atanT[0] + w * (atanT[2] + w * (atanT[4] + w * (atanT[6] + w * (atanT[8] + w * atanT[10])))))
    f64 s2 = w * (atanT[1] + w * (atanT[3] + w * (atanT[5] + w * (atanT[7] + w * atanT[9]))))
    if (id < 0) {
        ret v - v * (s1 + s2)
    }
    z = atanHigh[id] - ((v * (s1 + s2) - atanLow[id]) - v)
    ret hx < 0 ? -z : z
}

// The angle of the point (x, y) seen from the origin, from -pi to pi: the angle
// whose tangent is y / x, in the quadrant of the point. `atan2(1.0, -1.0)` is
// 3 pi / 4.
public f64 atan2(f64 y, f64 x) {
    if (x != x || y != y) {
        ret x + y  // not a number
    }
    i32 hx = high(x)
    u32 lx = low(x)
    i32 ix = hx & 0x7fffffff
    i32 hy = high(y)
    u32 ly = low(y)
    i32 iy = hy & 0x7fffffff
    if (hx == 0x3ff00000 && lx == 0) {
        ret atan(y)  // x = 1
    }
    i32 m = ((hy >> 31) & 1) | ((hx >> 30) & 2)  // 2 * the sign of x + the sign of y

    if ((u32(iy) | ly) == 0) {  // y = 0
        if (m < 2) {
            ret y
        }
        ret m == 2 ? piHigh : -piHigh
    }
    if ((u32(ix) | lx) == 0) {  // x = 0
        ret hy < 0 ? -piOver2High : piOver2High
    }
    if (ix == 0x7ff00000) {  // x is an infinity
        if (iy == 0x7ff00000) {
            switch (m) {
                case 0 {
                    ret piOver4High
                }
                case 1 {
                    ret -piOver4High
                }
                case 2 {
                    ret 3.0 * piOver4High
                }
                default {
                    ret -3.0 * piOver4High
                }
            }
        }
        switch (m) {
            case 0 {
                ret 0.0
            }
            case 1 {
                ret -0.0
            }
            case 2 {
                ret piHigh
            }
            default {
                ret -piHigh
            }
        }
    }
    if (iy == 0x7ff00000) {  // y is an infinity
        ret hy < 0 ? -piOver2High : piOver2High
    }

    // y / x
    f64 z = 0.0
    i32 k = (iy - ix) >> 20
    if (k > 60) {  // |y / x| > 2^60
        z = piOver2High + 0.5 * piLow
        m &= 1
    } else if (hx < 0 && k < -60) {
        z = 0.0  // 0 > |y| / x > -2^-60
    } else {
        z = atan(abs(y / x))
    }
    switch (m) {
        case 0 {
            ret z
        }
        case 1 {
            ret -z
        }
        case 2 {
            ret piHigh - (z - piLow)
        }
        default {
            ret (z - piLow) - piHigh
        }
    }
}
