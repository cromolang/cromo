// HTTP/1.1, the server and the client, over the connections of std.net, with TLS for
// https.
//
// The server gives every request to one function, the handler, which reads the
// 'Request' and fills the 'Response': 'serve' runs it for each request, each connection
// on a task of its own, so the handler runs on several threads at once. A request can
// also become a WebSocket.
//
// '''
// http.serve("0.0.0.0", 8080, [](ref http.Request req, ref http.Response res) {
//     if (req.matches("GET /hello/{name}")) {
//         res.write("Hello, " + req.param("name") + "!")
//     } else {
//         res.status = 404
//     }
// })
// '''
//
// The client sends a request and gives back the whole response: 'get', 'post' and
// 'send' open a connection for each request, while a 'Client' keeps them open for the
// next requests to the same host. It follows the redirects, asks for gzip and
// decompresses. A status of error, as 404, is a response like the others; an
// exception of type 'Error' is a failure of the network, a timeout, or an answer that
// is not HTTP.
//
// '''
// http.Response res = http.get("https://example.com/")
// println("{} {}", res.status, res.headers.get("content-type"))
// '''
//
// The guide: [Networking and HTTP](https://cromolang.org/book/en/networking.html), and a
// whole service in [Final project: a web service](https://cromolang.org/book/en/web-service.html).

// For who works on std.http: the server follows D252, D253, D258 and D260-D262, with a
// task for each connection (D270); the client D254 and D263, with the connections kept
// by http.Client (D366) and gzip (D367); the WebSocket D368.
import std.gzip
import std.net
import std.thread
import std.time
import std.websocket

// ---- Headers ----

// A header of a request or of a response.
public struct Header {
    public string name   // "Content-Type", in the case it was written in
    public string value  // "text/html"; one received has no spaces around it
}

// The headers of a request or of a response, in their order. The names are compared
// without case, as HTTP wants: 'get("content-type")' finds "Content-Type". A name can
// have several headers, as Set-Cookie.
//
// '''
// res.headers.set("Cache-Control", "no-store")
// string agent = req.headers.get("user-agent")  // "" without it
// '''
public struct Headers {
    public list<Header> items  // in their order, also those with the same name

    // A copy of the value of the first header with the name, "" without one.
    public string get(string name) const {
        for (Header item in items) {
            if (sameName(item.name, name)) {
                ret item.value.copy()
            }
        }
        ret ""
    }

    // Whether there is a header with the name, also with an empty value.
    public bool has(string name) const {
        for (Header item in items) {
            if (sameName(item.name, name)) {
                ret true
            }
        }
        ret false
    }

    // Replaces the headers with the name with one, at the end, with a copy of 'text'.
    // An exception as for 'add', after the old ones are removed.
    public void set(string name, string text) {
        remove(name)
        add(name, text)
    }

    // Adds a header at the end, with a copy of the name and of 'text', also when there
    // is one with the same name. An exception for an empty name, a name with a space,
    // a control character or ':', and a value with a new line, which would start
    // another header.
    public void add(string name, string text) {
        checkHeader(name, text)
        items.add(header(name, text))
    }

    // Removes all the headers with the name; none is not an error.
    public void remove(string name) {
        list<Header> kept
        for (i64 i = 0; i < items.len(); i++) {
            if (!sameName(items[i].name, name)) {
                kept.add(move items[i])
            }
        }
        items = move kept
    }
}

Header header(string name, string text) {
    Header result
    result.name = name.copy()
    result.value = text.copy()
    ret result
}

// A new line in a header would start another header, or the body.
void checkHeader(string name, string text) {
    if (name.len() == 0) {
        throw Error("the name of a header of HTTP cannot be empty")
    }
    for (i64 i = 0; i < name.len(); i++) {
        if (name[i] <= ' ' || name[i] == ':') {
            throw Error(format("'{}' is not the name of a header of HTTP", name))
        }
    }
    for (i64 i = 0; i < text.len(); i++) {
        if (text[i] == '\r' || text[i] == '\n') {
            throw Error(format("the header {} of HTTP cannot contain a new line", name))
        }
    }
}

// ---- Requests and responses ----

// A request of HTTP: on the server, the one that the handler receives, already read
// whole; on the client, the one that 'send' sends, made with 'Request(method, url)'.
//
// The handler of a server chooses the route with 'matches', and reads the parameters
// of the route with 'param', those of the query with 'queryValue', the headers and the
// body:
//
// '''
// if (req.matches("GET /users/{id}")) {
//     i64 id = i64(req.param("id"))  // an exception, so a 500, if it is not a number
//     string page = req.queryValue("page")
// } else if (req.matches("POST /users")) {
//     User user = json.decode<User>(req.text())
// }
// '''
//
// A client writes its headers and its body before sending it:
//
// '''
// http.Request req = http.Request("PUT", "https://example.com/users/7")
// req.headers.set("Authorization", "Bearer " + token)
// req.writeJson(json.encode(user))
// http.Response res = http.send(req)
// '''
//
// It can be moved, not copied.
public struct Request {
    // The method, as "GET" or "POST", as the client wrote it.
    public string method
    // On the server, the target of the request, "/users/7?full=1"; on the client, the
    // whole URL, "https://example.com/users/7?full=1".
    public string url
    public string path         // on the server: the path of the URL, "/users/7", with its escapes
    public string query        // on the server: what follows '?', "full=1", with its escapes
    public Headers headers     // in their order
    public list<u8> body       // the bytes, whole; 'text()' reads them as text
    list<Header> params        // of the last pattern of matches()
    string version             // "HTTP/1.1"
    net.Connection connection  // the server: lent to the request while the handler runs (D368)
    bool upgraded              // the server: the connection became a WebSocket

    // On the server: answers 101, turns the request into a WebSocket, and gives it to
    // 'work', which runs on the task of the connection. When 'work' returns or throws,
    // the connection ends, without the response of the handler. For a clean end,
    // 'work' calls 'close()', or returns after 'receive()' has thrown
    // 'websocket.Closed'. A request that is not one of WebSocket gets the status 400,
    // and 'work' is not called. The WebSocket has no timeout unless 'work' sets one.
    //
    // '''
    // if (req.matches("GET /echo")) {
    //     req.webSocket([](ref websocket.Socket ws) {
    //         for {
    //             switch (ws.receive()) {  // websocket.Closed when the client closes
    //                 case Text(string text) {
    //                     ws.send("echo: " + text)
    //                 }
    //                 case Binary(list<u8> bytes) {
    //                     ws.sendBytes(bytes)
    //                 }
    //             }
    //         }
    //     })
    // }
    // '''
    public void webSocket(func(ref websocket.Socket) work) {
        string key = headers.get("sec-websocket-key")
        upgraded = true
        if (method != "GET" || !sameName(headers.get("upgrade"), "websocket") || key.len() == 0) {
            connection.write(("HTTP/1.1 400 Bad Request\r\nContent-Length: 0\r\nConnection: close\r\n\r\n").bytes())
            ret
        }
        string head = "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n" +
            format("Sec-WebSocket-Accept: {}\r\n\r\n", websocket.acceptKey(key))
        connection.write(head.bytes())
        websocket.Socket socket = websocket.accepted(move connection)
        work(ref socket)
    }

    // A request for the client, with a copy of the method, as "GET" or "DELETE", and of
    // the whole URL, "https://example.com/users/7". Its headers and its body are added
    // after.
    public Request(string verb, string address) {
        method = verb.copy()
        url = address.copy()
    }

    // A copy of the body as text: an exception if it is not UTF-8.
    public string text() const {
        ret string(body)
    }

    // Adds the text at the end of the body, and sets the Content-Type to "text/plain;
    // charset=utf-8" unless the headers have one.
    public void write(string text) {
        appendText(ref body, text)
        defaultType(ref headers, "text/plain; charset=utf-8")
    }

    // Adds a text of JSON at the end of the body, as 'req.writeJson(json.encode(user))',
    // and sets the Content-Type to "application/json" unless the headers have one.
    public void writeJson(string text) {
        appendText(ref body, text)
        defaultType(ref headers, "application/json")
    }

    // Adds the bytes at the end of the body, and sets the Content-Type to 'type', as
    // "image/png", unless the headers have one.
    public void writeBytes(list<u8> bytes, string type) {
        for (u8 b in bytes) {
            body.add(b)
        }
        defaultType(ref headers, type)
    }

    // Whether the method and the path of the request are those of the pattern, as
    // "GET /users/{id}", where a name in braces takes a segment of the path that is not
    // empty, and '{rest...}', only at the end, all the rest of the path. Without the
    // method any method goes, and GET takes HEAD too. The other segments are compared
    // exactly, also a final '/'; the query does not count. When it is true, 'param'
    // reads the parameters. A pattern with '{rest...}' before its end is an exception.
    public bool matches(string pattern) {
        string shape = pattern.copy()
        i64 space = find(pattern, " ", 0)
        if (space >= 0) {
            string wanted = pattern.slice(0, space)
            if (wanted != method && !(wanted == "GET" && method == "HEAD")) {
                ret false
            }
            shape = trim(pattern.slice(space + 1, pattern.len()))
        }
        list<string> parts = split(shape, "/")
        list<string> given = split(path, "/")
        list<Header> found
        for (i64 i = 0; i < parts.len(); i++) {
            string name = parameterName(parts[i])
            bool rest = name.len() > 3 && find(name, "...", 0) == name.len() - 3
            if (rest) {
                if (i != parts.len() - 1) {
                    throw Error(format("the pattern '{}' has {{name...}} before its end (D252)", pattern))
                }
                if (i >= given.len()) {
                    ret false
                }
                string value = given[i].copy()
                for (i64 k = i + 1; k < given.len(); k++) {
                    value += "/" + given[k]
                }
                found.add(header(name.slice(0, name.len() - 3), unescape(value, false)))
                params = move found
                ret true
            }
            if (i >= given.len()) {
                ret false
            }
            if (name.len() > 0) {
                if (given[i].len() == 0) {
                    ret false
                }
                found.add(header(name, unescape(given[i], false)))
            } else if (parts[i] != given[i]) {
                ret false
            }
        }
        if (parts.len() != given.len()) {
            ret false
        }
        params = move found
        ret true
    }

    // A parameter of the pattern of the last 'matches' that was true, without its
    // escapes: 'param("id")' for "{id}". An exception if that pattern does not have it.
    public string param(string name) const {
        for (Header item in params) {
            if (item.name == name) {
                ret item.value.copy()
            }
        }
        throw Error(format("the pattern that the request matched has no parameter {{{}}}", name))
    }

    // The value of a parameter of the query, without its escapes and with '+' as a
    // space: "2" for 'queryValue("page")' with "?page=2". The first with the name; ""
    // when it is missing or has no value.
    public string queryValue(string name) const {
        for (string pair in split(query, "&")) {
            i64 equal = find(pair, "=", 0)
            string key = pair.copy()
            string value
            if (equal >= 0) {
                key = pair.slice(0, equal)
                value = pair.slice(equal + 1, pair.len())
            }
            if (unescape(key, true) == name) {
                ret unescape(value, true)
            }
        }
        ret ""
    }
}

// `{id}` gives "id", `{rest...}` gives "rest...", the other parts "".
string parameterName(string part) {
    if (part.len() > 2 && part[0] == '{' && part[part.len() - 1] == '}') {
        ret part.slice(1, part.len() - 1)
    }
    ret ""
}

// A response of HTTP: on the server, the one that the handler fills, with the status
// 200 unless it sets another; on the client, the one received, with the whole body.
//
// The server writes it when the handler returns, in one piece with its Content-Length:
// the Content-Length, Connection and Transfer-Encoding that the handler sets are left
// out, but "Connection: close" closes the connection after the response. The statuses
// 204 and 304 send no body, and neither does the response to HEAD.
//
// '''
// res.status = 201
// res.headers.set("Location", "/users/7")
// res.writeJson(json.encode(user))
// '''
//
// On the client, a body that the server compressed with gzip arrives decompressed,
// and then the headers have its Content-Length, without Content-Encoding.
//
// '''
// http.Response res = http.get("https://example.com/users/7")
// if (res.status == 200) {
//     User user = json.decode<User>(res.text())
// }
// '''
public struct Response {
    public i32 status = 200  // as 200, 404 or 500
    public Headers headers   // in their order
    public list<u8> body     // the bytes, whole; 'text()' reads them as text
    bool closes              // the client: the connection cannot carry another request

    // A copy of the body as text: an exception if it is not UTF-8.
    public string text() const {
        ret string(body)
    }

    // Adds the text at the end of the body, and sets the Content-Type to "text/plain;
    // charset=utf-8" unless the headers have one.
    public void write(string text) {
        appendText(ref body, text)
        defaultType(ref headers, "text/plain; charset=utf-8")
    }

    // Adds a text of JSON at the end of the body, as 'res.writeJson(json.encode(user))',
    // and sets the Content-Type to "application/json" unless the headers have one.
    public void writeJson(string text) {
        appendText(ref body, text)
        defaultType(ref headers, "application/json")
    }

    // Adds the bytes at the end of the body, and sets the Content-Type to 'type', as
    // "image/png", unless the headers have one.
    public void writeBytes(list<u8> bytes, string type) {
        for (u8 b in bytes) {
            body.add(b)
        }
        defaultType(ref headers, type)
    }
}

void appendText(ref list<u8> body, string text) {
    body.reserve(body.len() + text.len())
    for (i64 i = 0; i < text.len(); i++) {
        body.add(text[i])
    }
}

void defaultType(ref Headers headers, string type) {
    if (!headers.has("content-type")) {
        headers.add("Content-Type", type)
    }
}

// ---- The server (D252) ----

// A server that listens, made by 'listen' or 'listenTls', and serves once 'serve' is
// called: until then the connections wait in the system. Its 'port()' is known before,
// also when 0 asked the system for a free one, so a program can start the server in a
// task and then call it, as a test does. It can be moved, as into a task, not copied.
//
// '''
// http.Server server = http.listen("127.0.0.1", 0)
// println("listening on port {}", server.port())
// thread.Atomic<i64> count  // shared by the requests
// server.serve([count](ref http.Request req, ref http.Response res) {
//     res.write(format("request {}", count.add(1) + 1))
// })
// '''
public struct Server {
    net.Listener listener

    // The port it listens on, also when 0 asked the system for a free one.
    public i32 port() const {
        ret listener.port()
    }

    // Gives every request to the handler, and never returns. It accepts the
    // connections on the thread or the task that calls it, and serves each one on a
    // task of its own, its requests one after the other while the client keeps it
    // open. So the handler runs on several threads at once: it is a 'const func', and
    // what the requests share is in a 'thread.Mutex' or a 'thread.Atomic', captured by
    // reading.
    //
    // - Before the handler, the request is read whole: a head larger than 64 KiB gets
    //   the status 431, a body larger than 16 MiB 413, a request that is not valid 400,
    //   and a version other than HTTP/1.1 and 1.0 505. "Expect: 100-continue" is
    //   answered.
    // - The response is written when the handler returns.
    // - An exception of the handler replaces its response with the status 500 and an
    //   empty body, and writes a line on the error output, as "http: GET /users/x:
    //   ..."; a panic still ends the program.
    // - A connection waits 5 seconds for the start of each request, then 30 seconds for
    //   each read and write; past them it ends in silence, as it does when the client
    //   goes away or the network fails.
    // - An error in accepting a connection, as too many open files, is tried again
    //   after 10 milliseconds.
    public void serve(const func(ref Request, ref Response) handler) const {
        thread.Group connections
        for {
            net.Connection connection
            try {
                connection = listener.accept()
            } catch (Exception e) {
                time.msleep(10)  // as with too many open files: a pause, then again
                continue
            }
            connections.start([move connection, handler]() {
                try {
                    serveConnection(ref connection, handler)
                } catch (Exception e) {
                    // the client went away, or did not finish in time
                }
            })
        }
    }
}

// A server that listens on the port of a name or an address, as "0.0.0.0" for all the
// addresses of IPv4, and serves once 'serve' is called; port 0 asks the system for a
// free one, which 'port()' gives. An exception if the name is not found or the port is
// taken.
public Server listen(string host, i32 port) {
    Server server
    server.listener = net.listen(host, port)
    ret server
}

// A server of https, as 'listen' gives: 'certificate' is the text in PEM of its
// certificate, followed by those of its chain, and 'key' the text in PEM of its private
// key. An exception if they cannot be read. The handshake of each connection is made
// on its task.
public Server listenTls(string host, i32 port, string certificate, string key) {
    Server server
    server.listener = net.listenTls(host, port, certificate, key)
    ret server
}

// Listens on the port of a name or an address and gives every request to the handler,
// as 'listen' and then 'Server.serve' do: it never returns. An exception if it cannot
// listen.
//
// '''
// http.serve("0.0.0.0", 8080, [](ref http.Request req, ref http.Response res) {
//     res.write("Hello!")
// })
// '''
public void serve(string host, i32 port, const func(ref Request, ref Response) handler) {
    Server server = listen(host, port)
    server.serve(handler)
}

// The requests of a connection, one after the other while it stays open.
void serveConnection(ref net.Connection connection, const func(ref Request, ref Response) handler) {
    Incoming input
    for {
        Request req
        i32 problem = readRequest(ref connection, ref input, ref req)
        if (problem < 0) {
            ret
        }
        Response res
        if (problem > 0) {
            res.status = problem
            res.write(reason(problem))
            respond(ref connection, req, res, false)
            ret
        }
        req.connection = move connection
        try {
            handler(ref req, ref res)
        } catch (Exception e) {
            if (!req.upgraded) {  // a WebSocket ends as it can
                eprintln("http: {} {}: {}", req.method, req.path, e.message())
                Response failed
                failed.status = 500
                res = move failed
            }
        }
        if (req.upgraded) {
            ret
        }
        connection = move req.connection
        bool keep = keepAlive(req) && !sameName(res.headers.get("connection"), "close")
        respond(ref connection, req, res, keep)
        if (!keep) {
            ret
        }
    }
}

bool keepAlive(Request req) {
    string connection = req.headers.get("connection")
    if (req.version == "HTTP/1.0") {
        ret sameName(connection, "keep-alive")
    }
    ret !sameName(connection, "close")
}

// The largest head of a request, and the largest body.
i64 maxHead() {
    ret 65536
}

i64 maxBody() {
    ret 16777216
}

// The next request of a connection: 0, -1 when the connection has ended between
// two requests, or the status for a request that cannot be served.
i32 readRequest(ref net.Connection connection, ref Incoming input, ref Request req) {
    connection.timeout(5000)  // the wait for the next request
    i64 end = input.find("\r\n\r\n")
    for (end < 0) {
        if (input.available() > maxHead()) {
            ret 431
        }
        if (!input.more(ref connection)) {
            ret -1
        }
        connection.timeout(30000)
        end = input.find("\r\n\r\n")
    }
    connection.timeout(30000)
    if (end > maxHead()) {
        ret 431
    }
    string head
    try {
        head = string(input.take(end + 4))
    } catch (Error e) {
        ret 400
    }
    list<string> lines = split(head.slice(0, head.len() - 4), "\r\n")
    list<string> words = split(lines[0], " ")
    if (words.len() != 3 || words[0].len() == 0 || words[1].len() == 0) {
        ret 400
    }
    if (words[2] != "HTTP/1.1" && words[2] != "HTTP/1.0") {
        ret 505
    }
    req.method = words[0].copy()
    req.url = words[1].copy()
    req.version = words[2].copy()
    i64 question = find(req.url, "?", 0)
    if (question >= 0) {
        req.path = req.url.slice(0, question)
        req.query = req.url.slice(question + 1, req.url.len())
    } else {
        req.path = req.url.copy()
    }
    for (i64 i = 1; i < lines.len(); i++) {
        i64 colon = find(lines[i], ":", 0)
        if (colon <= 0 || lines[i][0] == ' ' || lines[i][0] == '\t') {
            ret 400
        }
        try {
            req.headers.add(lines[i].slice(0, colon), trim(lines[i].slice(colon + 1, lines[i].len())))
        } catch (Error e) {
            ret 400
        }
    }
    if (sameName(req.headers.get("expect"), "100-continue")) {
        connection.writeText("HTTP/1.1 100 Continue\r\n\r\n")
    }
    try {
        req.body = readBody(ref connection, ref input, req.headers, false, maxBody())
    } catch (TooLarge e) {
        ret 413
    }
    ret 0
}

// The body of a message, by its Content-Length or in chunks, at most `limit` bytes;
// with `untilEnd`, a response without either goes on until the connection ends.
list<u8> readBody(ref net.Connection connection, ref Incoming input, Headers headers, bool untilEnd, i64 limit) {
    if (sameName(headers.get("transfer-encoding"), "chunked")) {
        ret readChunks(ref connection, ref input, limit)
    }
    if (headers.has("content-length")) {
        i64 length = -1
        try {
            length = i64(headers.get("content-length"))
        } catch (Error e) {
        }
        if (length < 0) {
            throw Error("the Content-Length of the message is not a number")
        }
        if (length > limit) {
            throw tooLarge(limit)
        }
        input.fill(ref connection, length)
        ret input.take(length)
    }
    list<u8> body
    if (untilEnd) {
        for (input.more(ref connection)) {
            if (input.available() > limit) {
                throw tooLarge(limit)
            }
        }
        body = input.take(input.available())
    }
    ret body
}

list<u8> readChunks(ref net.Connection connection, ref Incoming input, i64 limit) {
    list<u8> body
    for {
        string line = input.line(ref connection)
        i64 semicolon = find(line, ";", 0)
        if (semicolon >= 0) {
            line = line.slice(0, semicolon)
        }
        i64 size = hexNumber(trim(line))
        if (size == 0) {
            for (input.line(ref connection).len() > 0) {  // the trailers
            }
            ret body
        }
        if (body.len() + size > limit) {
            throw tooLarge(limit)
        }
        input.fill(ref connection, size + 2)
        for (u8 b in input.take(size)) {
            body.add(b)
        }
        input.take(2)  // the \r\n after the chunk
    }
}

i64 hexNumber(string text) {
    if (text.len() == 0 || text.len() > 15) {
        throw Error(format("'{}' is not the size of a chunk", text))
    }
    i64 n = 0
    for (i64 i = 0; i < text.len(); i++) {
        u8 c = text[i]
        i64 digit = -1
        if (c >= '0' && c <= '9') {
            digit = c - '0'
        } else if (c >= 'a' && c <= 'f') {
            digit = c - 'a' + 10
        } else if (c >= 'A' && c <= 'F') {
            digit = c - 'A' + 10
        }
        if (digit < 0) {
            throw Error(format("'{}' is not the size of a chunk", text))
        }
        n = n * 16 + digit
    }
    ret n
}

// A body larger than its limit.
struct TooLarge : Exception {
    i64 limit

    string message() const {
        ret format("the body is larger than {} bytes", limit)
    }
}

TooLarge tooLarge(i64 limit) {
    TooLarge e
    e.limit = limit
    ret e
}

// Writes the response in one piece, with its Content-Length.
void respond(ref net.Connection connection, Request req, Response res, bool keep) {
    string head = format("HTTP/1.1 {} {}\r\n", res.status, reason(res.status))
    for (Header item in res.headers.items) {
        if (sameName(item.name, "content-length") || sameName(item.name, "connection") ||
            sameName(item.name, "transfer-encoding")) {
            continue
        }
        head += item.name + ": " + item.value + "\r\n"
    }
    bool empty = res.status == 204 || res.status == 304 || res.status < 200
    if (!empty) {
        head += format("Content-Length: {}\r\n", res.body.len())
    }
    if (!keep) {
        head += "Connection: close\r\n"
    }
    head += "\r\n"
    list<u8> out
    appendText(ref out, head)
    if (!empty && req.method != "HEAD") {
        for (u8 b in res.body) {
            out.add(b)
        }
    }
    connection.write(out)
}

string reason(i32 status) {
    switch (status) {
        case 100 {
            ret "Continue"
        }
        case 200 {
            ret "OK"
        }
        case 201 {
            ret "Created"
        }
        case 202 {
            ret "Accepted"
        }
        case 204 {
            ret "No Content"
        }
        case 301 {
            ret "Moved Permanently"
        }
        case 302 {
            ret "Found"
        }
        case 303 {
            ret "See Other"
        }
        case 304 {
            ret "Not Modified"
        }
        case 307 {
            ret "Temporary Redirect"
        }
        case 308 {
            ret "Permanent Redirect"
        }
        case 400 {
            ret "Bad Request"
        }
        case 401 {
            ret "Unauthorized"
        }
        case 403 {
            ret "Forbidden"
        }
        case 404 {
            ret "Not Found"
        }
        case 405 {
            ret "Method Not Allowed"
        }
        case 409 {
            ret "Conflict"
        }
        case 413 {
            ret "Content Too Large"
        }
        case 415 {
            ret "Unsupported Media Type"
        }
        case 422 {
            ret "Unprocessable Content"
        }
        case 429 {
            ret "Too Many Requests"
        }
        case 431 {
            ret "Request Header Fields Too Large"
        }
        case 500 {
            ret "Internal Server Error"
        }
        case 501 {
            ret "Not Implemented"
        }
        case 502 {
            ret "Bad Gateway"
        }
        case 503 {
            ret "Service Unavailable"
        }
        case 505 {
            ret "HTTP Version Not Supported"
        }
    }
    ret ""
}

// ---- The client (D254) ----

// The response to a GET of the URL, as 'send' gives it.
public Response get(string url) {
    ret send(Request("GET", url))
}

// The response to a POST of the text 'body' to the URL, with the Content-Type 'type',
// as "application/json", as 'send' gives it.
public Response post(string url, string body, string type) {
    Request req = Request("POST", url)
    req.headers.set("Content-Type", type)
    req.write(body)
    ret send(req)
}

// Sends the request on a connection of its own, with TLS for https, and gives back the
// response, read whole. The request is not changed, and can be sent again.
//
// - The URL starts with http:// or https://, and can have a port; a name and a password
//   in it are not supported. Its path and its query are sent as written, so the
//   values in them are written with 'escape'; the fragment after '#' is not sent.
// - The client writes Host, Content-Length and Connection by itself, and adds
//   "User-Agent: cromo" and "Accept-Encoding: gzip" when the request does not have
//   them. It decompresses a body in gzip only when it asked for it.
// - Up to ten redirects are followed. After 303, and after 301 or 302 to a method other
//   than GET and HEAD, the request goes on as a GET without a body. Authorization and
//   Cookie are not sent to another host.
// - Connecting, with the handshake of TLS, has no timeout; then each read and write
//   waits at most 30 seconds.
// - A status of error, as 404, is a response, not an exception. An exception of type
//   'Error' is a URL that cannot be used, a host that is not found, a failure of the
//   network or of TLS, a timeout, more than ten redirects, an answer that is not HTTP,
//   or a body larger than 16 MiB, also once decompressed.
public Response send(Request req) {
    Client once
    once.single = true
    ret once.send(req)
}

// A connection kept open for the next request to its host.
struct Kept {
    string key  // "https://example.com"
    net.Connection connection
}

// For who works on std.http: http.Client is D366, its bodyLimit P19.

// A client of HTTP that keeps its connections open, up to 8 for each host, to use them
// again for the next requests to the same host: many requests are much faster. Its
// methods are const, so several tasks can use the same client at once, capturing it
// by reading, each request on a connection of its own. A kept connection that the
// server has closed meanwhile fails before the response: then the request is sent
// again, once, on a new connection. The destructor closes the connections. It can be
// moved, not copied.
//
// '''
// http.Client client
// client.bodyLimit = 1048576
// for (i64 id = 1; id <= 3; id++) {
//     http.Response res = client.get(format("https://example.com/users/{}", id))
//     println("{}", res.status)
// }
// '''
public struct Client {
    thread.Mutex<list<Kept>> idle
    bool single  // the functions of the module: a connection for each request (D254)
    // The largest body of a response, in bytes, also once decompressed: a larger one is
    // an exception. 16 MiB by default.
    public i64 bodyLimit = 16777216

    // The response to a GET of the URL, as 'http.get' gives it, on the connections of
    // the client.
    public Response get(string url) const {
        ret send(Request("GET", url))
    }

    // The response to a POST of the text 'body' to the URL, with the Content-Type
    // 'type', as 'http.post' gives it, on the connections of the client.
    public Response post(string url, string body, string type) const {
        Request req = Request("POST", url)
        req.headers.set("Content-Type", type)
        req.write(body)
        ret send(req)
    }

    // Sends the request as 'http.send' does, on a connection kept by the client or on
    // a new one, which it keeps after the response unless the server closes it. The
    // body of the response has at most 'bodyLimit' bytes.
    public Response send(Request req) const {
        string method = req.method.copy()
        string url = req.url.copy()
        Headers headers = req.headers.copy()
        list<u8> body = req.body.copy()
        for (i64 hops = 0;; hops++) {
            Response res = exchange(method, url, headers, body)
            bool redirect = res.status == 301 || res.status == 302 || res.status == 303 || res.status == 307 ||
                res.status == 308
            if (!redirect || !res.headers.has("location")) {
                ret res
            }
            if (hops == 10) {
                throw Error(format("cannot get {}: more than 10 redirects", req.url))
            }
            string next = resolve(url, res.headers.get("location"))
            if (res.status == 303 || ((res.status == 301 || res.status == 302) && method != "GET" && method != "HEAD")) {
                method = "GET"
                body.clear()
                headers.remove("content-type")
            }
            if (parseUrl(next).authority() != parseUrl(url).authority()) {  // the credentials stay with their host
                headers.remove("authorization")
                headers.remove("cookie")
            }
            url = move next
        }
    }

    // A request and its response, on a connection kept by the client or on a new one.
    // A kept connection that the server has closed meanwhile fails before the response
    // starts: then the request goes once more, on a new connection.
    Response exchange(string method, string url, Headers headers, list<u8> body) const {
        Url target = parseUrl(url)
        string key = target.key()
        net.Connection connection
        bool kept = !single && takeKept(key, ref connection)
        if (!kept) {
            connection = open(target)
        }
        Incoming input
        Response res
        try {
            res = talk(ref connection, ref input, single, target, method, headers, body, bodyLimit)
        } catch (Exception e) {
            if (!kept || input.data.len() > 0) {
                throw
            }
            connection = open(target)
            Incoming fresh
            res = talk(ref connection, ref fresh, single, target, method, headers, body, bodyLimit)
        }
        if (!single && !res.closes) {
            keep(key, move connection)
        }
        ret res
    }

    // The most recent connection kept for the host.
    bool takeKept(string key, ref net.Connection connection) const {
        bool found = false
        idle.lock([key, ref found, ref connection](ref list<Kept> items) {
            for (i64 i = items.len() - 1; i >= 0; i--) {
                if (items[i].key == key) {
                    Kept item = items.remove(i)
                    connection = move item.connection
                    found = true
                    ret
                }
            }
        })
        ret found
    }

    // At most 8 connections for each host: the oldest go.
    void keep(string key, move net.Connection connection) const {
        Kept kept
        kept.key = key.copy()
        kept.connection = move connection
        idle.lock([key, ref kept](ref list<Kept> items) {
            i64 count = 0
            for (Kept item in items) {
                if (item.key == key) {
                    count++
                }
            }
            for (i64 i = 0; i < items.len() && count >= 8; i++) {
                if (items[i].key == key) {
                    items.remove(i)
                    count--
                    i--
                }
            }
            addKept(ref items, ref kept)
        })
    }
}

// The lambda of the mutex can run again: it cannot move what it captures (D183).
void addKept(ref list<Kept> items, ref Kept kept) {
    items.add(move kept)
}

net.Connection open(Url target) {
    net.Connection connection
    if (target.secure) {
        connection = net.connectTls(target.host, target.port)
    } else {
        connection = net.connect(target.host, target.port)
    }
    ret connection
}

Response talk(ref net.Connection connection, ref Incoming input, bool single, Url target, string method, Headers headers,
    list<u8> body, i64 limit) {
    connection.timeout(30000)
    string head = format("{} {} HTTP/1.1\r\nHost: {}\r\n", method, target.path, target.authority())
    if (!headers.has("user-agent")) {
        head += "User-Agent: cromo\r\n"
    }
    bool compressed = !headers.has("accept-encoding")  // D367: the client decompresses by itself
    if (compressed) {
        head += "Accept-Encoding: gzip\r\n"
    }
    for (Header item in headers.items) {
        if (sameName(item.name, "host") || sameName(item.name, "content-length") || sameName(item.name, "connection")) {
            continue
        }
        head += item.name + ": " + item.value + "\r\n"
    }
    if (body.len() > 0 || method == "POST" || method == "PUT" || method == "PATCH") {
        head += format("Content-Length: {}\r\n", body.len())
    }
    if (single) {
        head += "Connection: close\r\n"
    }
    head += "\r\n"
    list<u8> out
    appendText(ref out, head)
    for (u8 b in body) {
        out.add(b)
    }
    connection.write(out)
    try {
        for {
            Response res = readResponse(ref connection, ref input, method, limit)
            if (res.status < 200) {
                continue
            }
            res.closes = res.closes || input.available() > 0
            if (compressed && sameName(res.headers.get("content-encoding"), "gzip")) {
                res.body = gzip.decompressUpTo(res.body, limit)
                res.headers.remove("content-encoding")
                res.headers.set("Content-Length", format("{}", res.body.len()))
            }
            ret res
        }
    } catch (TooLarge e) {
        throw Error(format("cannot read the response of {}: {}", target.text(), e.message()))
    }
}

Response readResponse(ref net.Connection connection, ref Incoming input, string method, i64 limit) {
    i64 end = input.find("\r\n\r\n")
    for (end < 0) {
        if (input.available() > maxHead()) {
            throw Error("the head of the response of HTTP is too large")
        }
        if (!input.more(ref connection)) {
            throw Error("the connection ended before the response of HTTP")
        }
        end = input.find("\r\n\r\n")
    }
    string head = string(input.take(end + 4))
    list<string> lines = split(head.slice(0, head.len() - 4), "\r\n")
    list<string> words = split(lines[0], " ")
    if (words.len() < 2 || find(words[0], "HTTP/1.", 0) != 0 || words[1].len() != 3) {
        throw Error(format("the response is not HTTP: '{}'", lines[0]))
    }
    Response res
    res.status = i32(words[1])
    for (i64 i = 1; i < lines.len(); i++) {
        i64 colon = find(lines[i], ":", 0)
        if (colon > 0) {
            res.headers.add(lines[i].slice(0, colon), trim(lines[i].slice(colon + 1, lines[i].len())))
        }
    }
    // The connection carries another request when the server keeps it and the end
    // of the body is known.
    string said = res.headers.get("connection")
    res.closes = sameName(said, "close") || (words[0] == "HTTP/1.0" && !sameName(said, "keep-alive"))
    if (res.status >= 200 && res.status != 204 && res.status != 304 && method != "HEAD") {
        bool known = res.headers.has("content-length") || sameName(res.headers.get("transfer-encoding"), "chunked")
        res.closes = res.closes || !known
        res.body = readBody(ref connection, ref input, res.headers, true, limit)
    }
    ret res
}

// The parts of a URL of http or https.
struct Url {
    bool secure
    string host  // without the brackets of IPv6
    i32 port
    string path  // with the query, without the fragment: "/a?b=1"

    // The connections to the same key can carry each other's requests (D366).
    string key() const {
        if (secure) {
            ret "https://" + authority()
        }
        ret "http://" + authority()
    }

    string text() const {
        ret key() + path
    }

    // As in the header Host: the port only when it is not that of the scheme.
    string authority() const {
        string name = host.copy()
        if (find(host, ":", 0) >= 0) {
            name = "[" + host + "]"
        }
        if ((secure && port == 443) || (!secure && port == 80)) {
            ret name
        }
        ret format("{}:{}", name, port)
    }
}

Url parseUrl(string url) {
    Url result
    i64 start = 0
    if (startsWithCase(url, "https://")) {
        result.secure = true
        result.port = 443
        start = 8
    } else if (startsWithCase(url, "http://")) {
        result.port = 80
        start = 7
    } else {
        throw Error(format("cannot use the URL '{}': it does not start with http:// or https://", url))
    }
    i64 end = start
    for (end < url.len() && url[end] != '/' && url[end] != '?' && url[end] != '#') {
        end++
    }
    string authority = url.slice(start, end)
    string rest = url.slice(end, url.len())
    i64 hash = find(rest, "#", 0)
    if (hash >= 0) {
        rest = rest.slice(0, hash)
    }
    if (rest.len() == 0 || rest[0] == '?') {
        rest = "/" + rest
    }
    result.path = move rest
    if (find(authority, "@", 0) >= 0) {
        throw Error(format("cannot use the URL '{}': a name and a password in the URL are not supported", url))
    }
    string portText
    if (authority.len() > 0 && authority[0] == '[') {
        i64 close = find(authority, "]", 0)
        if (close < 0) {
            throw Error(format("cannot use the URL '{}': the address of IPv6 does not end with ']'", url))
        }
        result.host = authority.slice(1, close)
        if (close + 1 < authority.len()) {
            if (authority[close + 1] != ':') {
                throw Error(format("cannot use the URL '{}': something follows the address", url))
            }
            portText = authority.slice(close + 2, authority.len())
        }
    } else {
        i64 colon = find(authority, ":", 0)
        if (colon >= 0) {
            result.host = authority.slice(0, colon)
            portText = authority.slice(colon + 1, authority.len())
        } else {
            result.host = move authority
        }
    }
    if (result.host.len() == 0) {
        throw Error(format("cannot use the URL '{}': it has no host", url))
    }
    if (portText.len() > 0) {
        try {
            result.port = i32(portText)
        } catch (Error e) {
            throw Error(format("cannot use the URL '{}': '{}' is not a port", url, portText))
        }
    }
    ret result
}

// The URL of a Location, which can be relative to the one of the request.
string resolve(string base, string location) {
    if (startsWithCase(location, "http://") || startsWithCase(location, "https://")) {
        ret location.copy()
    }
    Url url = parseUrl(base)
    string scheme = "http:"
    if (url.secure) {
        scheme = "https:"
    }
    if (find(location, "//", 0) == 0) {
        ret scheme + location
    }
    string root = scheme + "//" + url.authority()
    if (location.len() > 0 && location[0] == '/') {
        ret root + location
    }
    i64 slash = 0
    for (i64 i = 0; i < url.path.len() && url.path[i] != '?'; i++) {
        if (url.path[i] == '/') {
            slash = i
        }
    }
    ret root + url.path.slice(0, slash + 1) + location
}

// ---- Escapes of URLs ----

// The text with %XX for every byte that is not a letter, a digit, '-', '_', '.' or '~',
// for a value of the query or a segment of the path of a URL: 'http.escape("a b&c")'
// gives "a%20b%26c".
public string escape(string text) {
    string out
    for (i64 i = 0; i < text.len(); i++) {
        u8 c = text[i]
        if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '-' || c == '_' ||
            c == '.' || c == '~') {
            out += text.slice(i, i + 1)
        } else {
            out += format("%{:02X}", c)
        }
    }
    ret out
}

// The text without the %XX, and with '+' as a space in a query. An escape that is
// not valid, or bytes that are not UTF-8, leave the text as it is.
string unescape(string text, bool plus) {
    list<u8> bytes
    for (i64 i = 0; i < text.len(); i++) {
        u8 c = text[i]
        if (c == '%' && i + 2 < text.len() + 0 && hexDigit(text[i + 1]) >= 0 && hexDigit(text[i + 2]) >= 0) {
            bytes.add(u8(hexDigit(text[i + 1]) * 16 + hexDigit(text[i + 2])))
            i += 2
        } else if (c == '+' && plus) {
            bytes.add(' ')
        } else {
            bytes.add(c)
        }
    }
    try {
        ret string(bytes)
    } catch (Error e) {
        ret text.copy()
    }
}

i64 hexDigit(u8 c) {
    if (c >= '0' && c <= '9') {
        ret c - '0'
    }
    if (c >= 'a' && c <= 'f') {
        ret c - 'a' + 10
    }
    if (c >= 'A' && c <= 'F') {
        ret c - 'A' + 10
    }
    ret -1
}

// ---- Reading from a connection ----

// The bytes that arrived from a connection and are not read yet.
struct Incoming {
    list<u8> data
    i64 at  // the bytes before it are read

    i64 available() const {
        ret data.len() - at
    }

    // More bytes from the connection: false when it has ended.
    bool more(ref net.Connection connection) {
        if (at > 0) {
            list<u8> rest
            rest.reserve(data.len() - at)
            for (i64 i = at; i < data.len(); i++) {
                rest.add(data[i])
            }
            data = move rest
            at = 0
        }
        list<u8> bytes = connection.read(16384)
        for (u8 b in bytes) {
            data.add(b)
        }
        ret bytes.len() > 0
    }

    // Reads until `count` bytes are there.
    void fill(ref net.Connection connection, i64 count) {
        for (available() < count) {
            if (!more(ref connection)) {
                throw Error("the connection ended in the middle of a message of HTTP")
            }
        }
    }

    list<u8> take(i64 count) {
        list<u8> bytes
        bytes.reserve(count)
        for (i64 i = at; i < at + count; i++) {
            bytes.add(data[i])
        }
        at += count
        ret bytes
    }

    // Where the bytes of `text` start among those not read, from `at`; -1 if not there.
    i64 find(string text) const {
        for (i64 i = at; i + text.len() <= data.len(); i++) {
            bool same = true
            for (i64 k = 0; k < text.len() && same; k++) {
                same = data[i + k] == text[k]
            }
            if (same) {
                ret i - at
            }
        }
        ret -1
    }

    // A line that ends with \r\n, without it.
    string line(ref net.Connection connection) {
        i64 end = find("\r\n")
        for (end < 0) {
            if (available() > maxHead()) {
                throw Error("a line of HTTP is too long")
            }
            if (!more(ref connection)) {
                throw Error("the connection ended in the middle of a message of HTTP")
            }
            end = find("\r\n")
        }
        string text = string(take(end))
        take(2)
        ret text
    }
}

// ---- Text ----

u8 lowerByte(u8 c) {
    if (c >= 'A' && c <= 'Z') {
        ret c + 32
    }
    ret c
}

// Equal without the case of ASCII, as the names of the headers.
bool sameName(string a, string b) {
    if (a.len() != b.len()) {
        ret false
    }
    for (i64 i = 0; i < a.len(); i++) {
        if (lowerByte(a[i]) != lowerByte(b[i])) {
            ret false
        }
    }
    ret true
}

bool startsWithCase(string text, string start) {
    ret text.len() >= start.len() && sameName(text.slice(0, start.len()), start)
}

// Where `part` starts in `text` from `from`, or -1.
i64 find(string text, string part, i64 from) {
    for (i64 i = from; i + part.len() <= text.len(); i++) {
        bool same = true
        for (i64 k = 0; k < part.len() && same; k++) {
            same = text[i + k] == part[k]
        }
        if (same) {
            ret i
        }
    }
    ret -1
}

// Without the spaces and the tabs at the two ends.
string trim(string text) {
    i64 start = 0
    i64 end = text.len()
    for (start < end && (text[start] == ' ' || text[start] == '\t')) {
        start++
    }
    for (end > start && (text[end - 1] == ' ' || text[end - 1] == '\t')) {
        end--
    }
    ret text.slice(start, end)
}

list<string> split(string text, string separator) {
    list<string> parts
    i64 start = 0
    for {
        i64 next = find(text, separator, start)
        if (next < 0) {
            parts.add(text.slice(start, text.len()))
            ret parts
        }
        parts.add(text.slice(start, next))
        start = next + separator.len()
    }
}
