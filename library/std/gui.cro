// The module std.gui (D429-D447): windows with their title bar drawn by the
// library, in the style of Visual Studio Code (D431), the themes light, dark and of
// the system (D432), the components Label, Button, TextBox, CheckBox, GroupBox,
// ComboBox and ImageBox (D434, D439, D444-D446), anchored to the edges of their
// window or group (D447), and the events of the mouse, of the keyboard and of the
// components, given to lambdas (D430). A window and a component are handles (D434,
// D442): their methods can be called from any thread, and change their data under
// one lock. All the windows run on one thread of the GUI, which SDL wants (D436);
// the handlers of the events run there, one at a time (D435). SDL is in lib/
// (D429), and the parts in C, the hit test, the text, the symbols, the boxes and
// the images, are in runtime/gui (D441).
import std.fs
import std.time
import unsafe

extern "SDL3" {
    bool SDL_Init(u32 flags)
    addr SDL_GetError()
    addr SDL_CreateWindow(addr title, i32 w, i32 h, u64 flags)
    void SDL_DestroyWindow(addr window)
    u32 SDL_GetWindowID(addr window)
    addr SDL_CreateRenderer(addr window, addr name)
    void SDL_DestroyRenderer(addr renderer)
    bool SDL_PollEvent(addr event)
    bool SDL_ConvertEventToRenderCoordinates(addr renderer, addr event)
    bool SDL_SetRenderDrawColor(addr renderer, u8 r, u8 g, u8 b, u8 a)
    bool SDL_SetRenderDrawBlendMode(addr renderer, u32 mode)
    bool SDL_SetRenderScale(addr renderer, f32 x, f32 y)
    bool SDL_SetRenderClipRect(addr renderer, addr rect)
    bool SDL_RenderClear(addr renderer)
    bool SDL_RenderFillRect(addr renderer, ref Rect rect)
    bool SDL_RenderRect(addr renderer, ref Rect rect)
    bool SDL_RenderPresent(addr renderer)
    bool SDL_GetWindowSize(addr window, ref i32 w, ref i32 h)
    bool SDL_SetWindowSize(addr window, i32 w, i32 h)
    bool SDL_SetWindowTitle(addr window, addr title)
    bool SDL_SetWindowResizable(addr window, bool resizable)
    u64 SDL_GetWindowFlags(addr window)
    bool SDL_MinimizeWindow(addr window)
    bool SDL_MaximizeWindow(addr window)
    bool SDL_RestoreWindow(addr window)
    f32 SDL_GetWindowDisplayScale(addr window)
    f32 SDL_GetWindowPixelDensity(addr window)
    u32 SDL_GetPrimaryDisplay()
    f32 SDL_GetDisplayContentScale(u32 display)
    u32 SDL_GetSystemTheme()
    u64 SDL_GetTicksNS()
    void SDL_DelayPrecise(u64 nanoseconds)
    bool SDL_StartTextInput(addr window)
    bool SDL_StopTextInput(addr window)
    bool SDL_SetClipboardText(addr text)
    addr SDL_GetClipboardText()
    void SDL_free(addr memory)
    addr SDL_CreateSystemCursor(u32 kind)
    bool SDL_SetCursor(addr cursor)
    addr SDL_CreateTexture(addr renderer, u32 format, i32 access, i32 w, i32 h)
    bool SDL_UpdateTexture(addr texture, addr rect, addr pixels, i32 pitch)
    bool SDL_SetTextureBlendMode(addr texture, u32 mode)
    bool SDL_SetTextureAlphaMod(addr texture, u8 alpha)
    bool SDL_RenderTexture(addr renderer, addr texture, addr source, ref Rect target)
    void SDL_DestroyTexture(addr texture)
}

extern "cromo" {
    addr cromo_gui_chrome(addr window)
    void cromo_gui_chrome_size(addr chrome, f32 bar, f32 buttons, f32 edge, bool resizable)
    void cromo_gui_chrome_free(addr chrome)
    addr cromo_gui_font(addr renderer, i32 face, f32 size, f32 density)
    void cromo_gui_font_free(addr font)
    void cromo_gui_font_metrics(addr font, ref f32 ascent, ref f32 descent, ref f32 gap)
    f32 cromo_gui_text_width(addr font, addr text, i64 length)
    void cromo_gui_text(addr font, addr text, i64 length, f32 x, f32 y, u8 r, u8 g, u8 b, u8 alpha)
    void cromo_gui_symbol(addr renderer, i32 kind, f32 x, f32 y, f32 density, u8 r, u8 g, u8 b)
    void cromo_gui_symbols_free(addr renderer)
    void cromo_gui_box(addr renderer, f32 x, f32 y, f32 w, f32 h, f32 radius, f32 border, f32 density, u32 fill, u32 line)
    void cromo_gui_boxes_free(addr renderer)
    void cromo_gui_shadow(addr renderer, f32 x, f32 y, f32 w, f32 h, f32 radius, f32 density, u32 color, f32 blur, f32 dy)
    void cromo_gui_gradient(addr renderer, f32 x, f32 y, f32 w, f32 h, f32 radius, f32 border, f32 density, u32 top, u32 bottom,
        u32 line, u32 highlight)
    void cromo_gui_wait_at_end()
    addr cromo_gui_image_decode(addr bytes, i64 size, ref i32 width, ref i32 height, addr reason, i64 room)
    void cromo_gui_image_free(addr pixels)
}

// ---- The public types ----

// The theme of a window (D432): System follows that of the system, and changes
// with it.
public enum Theme {
    System
    Light
    Dark
}

// How a component follows the left and the right edges of its window or of its
// group, when they move (D447): Stretch follows both, changing its width, Center
// neither, keeping its center at the same distance from the center.
public enum Horizontal {
    Left
    Right
    Stretch
    Center
}

// The same for the top and the bottom edges (D447).
public enum Vertical {
    Top
    Bottom
    Stretch
    Center
}

// How an ImageBox fits its image (P39): Fit shows all of it, as large as the box
// allows; Fill covers the box, cut at the edges; Stretch takes the size of the box;
// Center keeps its size. Fit, Fill and Center keep its proportions.
public enum Scale {
    Fit
    Fill
    Stretch
    Center
}

// The mouse, in logical pixels from the top left corner of the content, under the
// title bar (D438), and its button: 1 left, 2 middle, 3 right, 0 when it moves.
public struct Mouse {
    public f32 x
    public f32 y
    public i32 button
}

// A key pressed: its code is that of SDL, the character for the letters, the
// digits and the signs, 27 for Esc, 13 for Enter.
public struct Key {
    public i64 code
    public bool shift
    public bool control
    public bool alt
}

// What the components have in common, for Window.add (D434).
public interface Component {
    i64 componentId() const
}

// ---- The components (D434, D439) ----
//
// Each is a handle, with its position and its size in logical pixels from the top
// left corner of the content (D438). Its text and its properties are methods.

// A text.
public struct Label : Component {
    i64 id

    public Label(string text, i32 x, i32 y, i32 width, i32 height) {
        id = newPart(kindLabel, text, x, y, width, height)
    }

    i64 componentId() const {
        ret id
    }

    public void setText(string value) const {
        setPartText(id, value)
    }

    public string text() const {
        ret partText(id, false)
    }

    public void setPosition(i32 x, i32 y) const {
        setPartBounds(id, x, y, -1, -1)
    }

    public void setSize(i32 width, i32 height) const {
        setPartBounds(id, -1, -1, width, height)
    }

    public i32 x() const {
        ret partBound(id, 0)
    }

    public i32 y() const {
        ret partBound(id, 1)
    }

    public i32 width() const {
        ret partBound(id, 2)
    }

    public i32 height() const {
        ret partBound(id, 3)
    }

    public void setVisible(bool value) const {
        setPartFlag(id, 0, value)
    }

    public bool visible() const {
        ret partFlag(id, 0)
    }

    public void setEnabled(bool value) const {
        setPartFlag(id, 1, value)
    }

    public bool enabled() const {
        ret partFlag(id, 1)
    }

    // How it follows the edges of its window or of its group (D447).
    public void setAnchor(Horizontal horizontal, Vertical vertical) const {
        setPartAnchor(id, horizontal, vertical)
    }

    public Horizontal horizontalAnchor() const {
        ret partHorizontal(id)
    }

    public Vertical verticalAnchor() const {
        ret partVertical(id)
    }
}

// A button: a click, Space or Enter with it in focus, calls its handlers of onClick.
public struct Button : Component {
    i64 id

    public Button(string text, i32 x, i32 y, i32 width, i32 height) {
        id = newPart(kindButton, text, x, y, width, height)
    }

    i64 componentId() const {
        ret id
    }

    public void onClick(move func() handler) const {
        addr box = alloc(sizeOf<func()>())
        put<func()>(box, move handler)
        addPartHandler(id, 0, box)
    }

    public void setText(string value) const {
        setPartText(id, value)
    }

    public string text() const {
        ret partText(id, false)
    }

    public void setPosition(i32 x, i32 y) const {
        setPartBounds(id, x, y, -1, -1)
    }

    public void setSize(i32 width, i32 height) const {
        setPartBounds(id, -1, -1, width, height)
    }

    public i32 x() const {
        ret partBound(id, 0)
    }

    public i32 y() const {
        ret partBound(id, 1)
    }

    public i32 width() const {
        ret partBound(id, 2)
    }

    public i32 height() const {
        ret partBound(id, 3)
    }

    public void setVisible(bool value) const {
        setPartFlag(id, 0, value)
    }

    public bool visible() const {
        ret partFlag(id, 0)
    }

    public void setEnabled(bool value) const {
        setPartFlag(id, 1, value)
    }

    public bool enabled() const {
        ret partFlag(id, 1)
    }

    // How it follows the edges of its window or of its group (D447).
    public void setAnchor(Horizontal horizontal, Vertical vertical) const {
        setPartAnchor(id, horizontal, vertical)
    }

    public Horizontal horizontalAnchor() const {
        ret partHorizontal(id)
    }

    public Vertical verticalAnchor() const {
        ret partVertical(id)
    }
}

// A line of text that the user writes: the arrows, Home and End move in it, with
// Shift they select, Ctrl+A, Ctrl+C, Ctrl+X and Ctrl+V as in every program. Its
// handlers of onChange receive the text at each change, those of onEnter when
// Enter is pressed.
public struct TextBox : Component {
    i64 id

    public TextBox(string text, i32 x, i32 y, i32 width, i32 height) {
        id = newPart(kindTextBox, text, x, y, width, height)
    }

    i64 componentId() const {
        ret id
    }

    public void onChange(move func(string) handler) const {
        addr box = alloc(sizeOf<func(string)>())
        put<func(string)>(box, move handler)
        addPartHandler(id, 1, box)
    }

    public void onEnter(move func(string) handler) const {
        addr box = alloc(sizeOf<func(string)>())
        put<func(string)>(box, move handler)
        addPartHandler(id, 2, box)
    }

    // The text shown while the box is empty.
    public void setPlaceholder(string value) const {
        i64 me = id
        withData([me, value](ref Shared data) { data.parts[partIndexOf(ref data, me)].placeholder = value })
    }

    public string placeholder() const {
        ret partText(id, true)
    }

    public void setText(string value) const {
        setPartText(id, value)
    }

    public string text() const {
        ret partText(id, false)
    }

    public void setPosition(i32 x, i32 y) const {
        setPartBounds(id, x, y, -1, -1)
    }

    public void setSize(i32 width, i32 height) const {
        setPartBounds(id, -1, -1, width, height)
    }

    public i32 x() const {
        ret partBound(id, 0)
    }

    public i32 y() const {
        ret partBound(id, 1)
    }

    public i32 width() const {
        ret partBound(id, 2)
    }

    public i32 height() const {
        ret partBound(id, 3)
    }

    public void setVisible(bool value) const {
        setPartFlag(id, 0, value)
    }

    public bool visible() const {
        ret partFlag(id, 0)
    }

    public void setEnabled(bool value) const {
        setPartFlag(id, 1, value)
    }

    public bool enabled() const {
        ret partFlag(id, 1)
    }

    // How it follows the edges of its window or of its group (D447).
    public void setAnchor(Horizontal horizontal, Vertical vertical) const {
        setPartAnchor(id, horizontal, vertical)
    }

    public Horizontal horizontalAnchor() const {
        ret partHorizontal(id)
    }

    public Vertical verticalAnchor() const {
        ret partVertical(id)
    }
}

