// A slider (D466): an integer between a minimum and a maximum, chosen by dragging
// its knob, by a click on its track or with the keys; its handlers of onChange
// receive the new value, also while the knob is dragged.
public struct Slider : Component {
    i64 id

    public Slider(i64 minimum, i64 maximum, i32 x, i32 y, i32 width, i32 height) {
        if (minimum > maximum) {
            panic(format("the minimum of the slider, {}, is above its maximum, {}", minimum, maximum))
        }
        id = newPart(kindSlider, "", x, y, width, height)
        i64 me = id
        withData([me, minimum, maximum](ref Shared data) {
            i64 p = partIndexOf(ref data, me)
            data.parts[p].minimum = minimum
            data.parts[p].maximum = maximum
            data.parts[p].value = minimum
        })
    }

    i64 componentId() const {
        ret id
    }

    public void onChange(move func(i64) handler) const {
        addr box = alloc(sizeOf<func(i64)>())
        put<func(i64)>(box, move handler)
        addPartHandler(id, 1, box)
    }

    // The value, kept between the minimum and the maximum.
    public void setValue(i64 value) const {
        i64 me = id
        withData([me, value](ref Shared data) {
            i64 p = partIndexOf(ref data, me)
            i64 low = data.parts[p].minimum
            i64 high = data.parts[p].maximum
            data.parts[p].value = value < low ? low : value > high ? high : value
        })
    }

    public i64 value() const {
        i64 me = id
        i64 result = 0
        withData([me, ref result](ref Shared data) { result = data.parts[partIndexOf(ref data, me)].value })
        ret result
    }

    public i64 minimum() const {
        i64 me = id
        i64 result = 0
        withData([me, ref result](ref Shared data) { result = data.parts[partIndexOf(ref data, me)].minimum })
        ret result
    }

    public i64 maximum() const {
        i64 me = id
        i64 result = 0
        withData([me, ref result](ref Shared data) { result = data.parts[partIndexOf(ref data, me)].maximum })
        ret result
    }

    public void setPosition(i32 x, i32 y) const {
        setPartBounds(id, x, y, -1, -1)
    }

    public void setSize(i32 width, i32 height) const {
        setPartBounds(id, -1, -1, width, height)
    }

    public i32 x() const {
        ret partBound(id, 0)
    }

    public i32 y() const {
        ret partBound(id, 1)
    }

    public i32 width() const {
        ret partBound(id, 2)
    }

    public i32 height() const {
        ret partBound(id, 3)
    }

    public void setVisible(bool value) const {
        setPartFlag(id, 0, value)
    }

    public bool visible() const {
        ret partFlag(id, 0)
    }

    public void setEnabled(bool value) const {
        setPartFlag(id, 1, value)
    }

    public bool enabled() const {
        ret partFlag(id, 1)
    }

    // How it follows the edges of its window or of its group (D447).
    public void setAnchor(Horizontal horizontal, Vertical vertical) const {
        setPartAnchor(id, horizontal, vertical)
    }

    public Horizontal horizontalAnchor() const {
        ret partHorizontal(id)
    }

    public Vertical verticalAnchor() const {
        ret partVertical(id)
    }
}

// A dialog (D467): a card with a title, components and buttons at the bottom, that
// showDialog of a window opens over its content, with the rest darkened and out of
// reach until it closes. Its components have their positions from the top left
// corner of its body, under the title; Esc, or the back key on Android, closes it.
public struct Dialog {
    i64 id

    public Dialog(string title, i32 width, i32 height) {
        i64 made = 0
        withData([ref made, title, width, height](ref Shared data) {
            made = makePart(ref data, kindDialog, title, 0, 0, width, height)
            i64 body = makePart(ref data, kindPanel, "", i32(dialogPadding), i32(dialogTop), width - 2 * i32(dialogPadding),
                height - i32(dialogTop + dialogBottom))
            i64 p = partIndexOf(ref data, body)
            data.parts[p].parent = made
            data.parts[p].horizontal = Horizontal.Stretch
            data.parts[p].vertical = Vertical.Stretch
            rebase(ref data, p)
            data.parts[partIndexOf(ref data, made)].inner = body
        })
        id = made
    }

    // Puts a component in the body of the dialog, and gives it back.
    public T add<T : Component>(T component) const {
        i64 me = id
        i64 body = 0
        withData([me, ref body](ref Shared data) { body = data.parts[partIndexOf(ref data, me)].inner })
        addPart(0, body, component.componentId())
        ret component
    }

    // A button at the bottom right, after those added before: the last is indigo.
    public void addButton(string text, move func() handler) const {
        addr box = alloc(sizeOf<func()>())
        put<func()>(box, move handler)
        i64 me = id
        withData([me, text, box](ref Shared data) {
            i64 card = partIndexOf(ref data, me)
            i64 window = data.parts[card].window
            i64 button = makePart(ref data, kindButton, text, 0, 0, 0, i32(dialogButton))
            i64 p = partIndexOf(ref data, button)
            data.parts[p].parent = me
            data.parts[p].window = window
            data.parts[p].action = 2
            data.parts[p].click.add(box)
        })
    }

    // Closes the dialog, if it is shown, and calls the handlers of onClose.
    public void close() const {
        i64 me = id
        withData([me](ref Shared data) {
            for (i64 i = 0; i < data.windows.len(); i++) {
                if (data.windows[i].dialog == me) {
                    data.windows[i].dialog = 0
                    data.windows[i].dialogEnded = true
                    data.pending.add(callOf(6, data.parts[partIndexOf(ref data, me)].closing))
                }
            }
        })
    }

    // Whenever the dialog closes: by close(), with Esc or with the back key.
    public void onClose(move func() handler) const {
        addr box = alloc(sizeOf<func()>())
        put<func()>(box, move handler)
        addPartHandler(id, 3, box)
    }

    public bool shown() const {
        i64 me = id
        bool result = false
        withData([me, ref result](ref Shared data) {
            for (i64 i = 0; i < data.windows.len(); i++) {
                result = result || data.windows[i].dialog == me
            }
        })
        ret result
    }

    public void setTitle(string value) const {
        setPartText(id, value)
    }

    public string title() const {
        ret partText(id, false)
    }
}

// ---- The data of the windows and of the components ----

struct Rect {
    f32 x
    f32 y
    f32 w
    f32 h

    Rect(f32 left, f32 top, f32 width, f32 height) {
        x = left
        y = top
        w = width
        h = height
    }
}

// What a window has: what the program asks, and what only the thread of the GUI
// uses. The handlers are in boxes on the heap, which never move: the thread of
// the GUI calls them without the lock.
struct WindowData {
    i64 id
    string title
    i32 width  // of the whole window, in logical pixels
    i32 height
    bool resizable = true
    i32 show  // what is asked: 0 normal, 1 minimized, 2 maximized
    Theme theme
    i32 fps = 60
    bool started
    bool closing
    bool notified  // its handlers of onClose are called
    bool closed    // after them
    bool titleChanged
    bool sizeChanged
    bool resizableChanged
    bool showChanged
    list<addr> mouseMove
    list<addr> mouseDown
    list<addr> mouseUp
    list<addr> keyDown
    list<addr> resize
    list<addr> close
    list<addr> back   // the back key of Android (D457)
    bool phone        // on Android: without a title bar, the content in the safe area (D456)
    f32 originX       // where the content starts in the window, in logical pixels
    f32 originY = 35  // under the title bar
    f32 insetRight    // what the bars of the system cover on Android
    f32 insetBottom
    i32 systemBars = -1  // the theme of the bars of the system on Android: 0 light, 1 dark

    // The thread of the GUI.
    addr window
    addr renderer
    addr chrome
    addr font     // of the title
    addr body     // of the components
    addr strong   // of the buttons, semibold
    addr heading  // of the title of an app bar, semibold
    addr caption  // of the items of a navigation bar, semibold
    u32 sdlId
    f32 density = 1
    i32 hovered = -1  // the button of the title bar under the mouse
    i32 pressed = -1
    bool focused = true
    bool maximized
    bool minimized
    i64 focus          // the component with the keyboard, or 0
    i64 hot            // the component under the mouse
    i64 held           // the component pressed with the mouse
    i64 dragging       // the text box whose text the mouse selects
    i64 popup          // the combo box whose list is open
    i64 appBar         // its bar at the top, or 0
    i64 navigation     // its bar at the bottom, or 0
    i64 hotItem = -1   // the item of a bar or the row of a list under the mouse
    i64 heldItem = -1  // the item of a bar or the row of a list pressed
    i64 scrolling      // the panel or the list that a finger or the mouse on its bar scrolls
    bool scrollBar     // the mouse drags its bar
    bool dragMoved     // the finger moved more than 8 pixels
    f32 dragStart
    f32 dragY
    u64 dragTime
    u64 lastFrame
    f32 pointerX = -1  // the mouse, -1 when it is out of the window
    f32 pointerY = -1
    u64 caretStart
    i64 dialog        // the dialog shown (D467), or 0
    i64 dialogStart   // where it starts in order
    i64 dialogFocus   // the component in focus before it, which has it back after
    bool dialogFresh  // the focus goes to the dialog at the next layout
    bool dialogEnded  // and comes back
    bool keyboard     // the last input was a key, not the mouse or a finger: the ring of the focus shows
    string snackText  // the snackbar (D468), shown from snackShown for 4 seconds
    string snackAction
    list<addr> snackHandler
    u64 snackShown
    bool snackFresh
    bool snackHot
    bool snackHeld
    list<addr> dropped  // func(), handlers of snackbars replaced, freed by the thread of the GUI
    list<i64> order     // the indices of its components, in the order they are drawn
}

const i32 kindLabel = 1
const i32 kindButton = 2
const i32 kindTextBox = 3
const i32 kindCheckBox = 4
const i32 kindGroup = 5
const i32 kindComboBox = 6
const i32 kindImageBox = 7
const i32 kindIconBox = 8
const i32 kindPanel = 9
const i32 kindAppBar = 10
const i32 kindNavigation = 11
const i32 kindListView = 12
const i32 kindSwitch = 13
const i32 kindSlider = 14
const i32 kindDialog = 15

// A component: its kind, its window and its group once added, its properties, for
// a text box where its cursor and the other end of its selection are, as indices
// of bytes, and how much its text is scrolled, the items of a combo box and the
// image of an image box.
struct PartData {
    i64 id
    i64 window
    i64 parent  // its group, or 0
    i32 kind
    string text  // the file of an image box
    string placeholder
    i32 x  // now, from the top left corner of its parent (P40)
    i32 y
    i32 width
    i32 height
    Horizontal horizontal
    Vertical vertical
    i32 baseX  // as set last, when its parent had the size below (P40)
    i32 baseY
    i32 baseWidth
    i32 baseHeight
    i32 parentWidth
    i32 parentHeight
    bool visible = true
    bool enabled = true
    bool checked
    i64 caret
    i64 anchor
    f32 scroll
    list<string> items
    i64 selected = -1
    i64 first      // the first item shown in the list
    i64 highlight  // the item that the mouse or the keys point at in the list
    addr pixels    // of an image, until the thread of the GUI makes its texture
    i32 imageWidth
    i32 imageHeight
    bool imageChanged
    Scale scale
    addr texture
    Icon icon               // of an icon box, of a button, or on the left of an app bar
    list<Icon> icons        // of the actions of an app bar, of the items of a navigation bar
    list<addr> actions      // func(), of the actions of an app bar
    list<i64> pages         // of the items of a navigation bar
    i64 page = -1           // of a page, its item in its navigation bar
    list<string> subtitles  // of the items of a list
    list<string> details
    f32 offsetY          // how far a panel or a list is scrolled (D460)
    f32 content          // the height of what it has
    f32 velocity         // in logical pixels each second, after a finger leaves it
    u64 scrollShown      // when it scrolled last, for its bar
    list<addr> images    // of the items of a list: round pixels of avatarPixels, or none
    list<addr> textures  // their textures, made by the thread of the GUI
    list<addr> dropped   // textures to destroy on the thread of the GUI
    i64 value            // of a slider, between its minimum and its maximum
    i64 minimum
    i64 maximum
    u64 flipped         // when the user changed a switch, for its knob
    i32 action          // a button of a dialog: 1 the last, indigo, 2 the others
    i64 inner           // of a dialog, the panel of its components
    list<addr> closing  // func(), of a dialog
    i64 bar             // of a page, its navigation bar
    list<addr> click    // func()
    list<addr> change   // func(string) of a text box, func(bool) of a check box, func(i64) of a combo box or a list
    list<addr> enter    // func(string)

    // Laid out by the thread of the GUI: its place in the content of the window,
    // whether it and its groups are visible and enabled, and the rectangle of
    // its groups that clips it.
    f32 left
    f32 top
    bool shown
    bool active
    f32 clipLeft
    f32 clipTop
    f32 clipRight
    f32 clipBottom
}

struct Shared {
    list<WindowData> windows
    list<PartData> parts
    i64 next
    bool running        // the thread of the GUI
    list<Call> pending  // handlers to call on the thread of the GUI, as onClose of a dialog
}

u64 lock          // of the data of all the windows
addr shared       // Shared, from the first window
addr guiThread    // the thread of the GUI, in the runtime
addr guardThread  // the thread that waits for it (D437)
addr arrow        // the cursors of the mouse, made by the thread of the GUI
addr beam
i32[4] clip  // the SDL_Rect of SDL_SetRenderClipRect

// The data under the lock, as a Mutex (D216).
void withData(func(ref Shared) body) {
    mutexLock(variableAddress(lock))
    addr none
    if (shared == none) {
        shared = alloc(sizeOf<Shared>())
        Shared fresh
        put<Shared>(shared, move fresh)
    }
    Shared data = take<Shared>(shared)
    try {
        body(ref data)
    } finally {
        put<Shared>(shared, move data)
        mutexUnlock(variableAddress(lock))
    }
}

i64 indexOf(ref Shared data, i64 id) {
    for (i64 i = 0; i < data.windows.len(); i++) {
        if (data.windows[i].id == id) {
            ret i
        }
    }
    panic("the window does not exist")
}

i64 partIndexOf(ref Shared data, i64 id) {
    for (i64 i = 0; i < data.parts.len(); i++) {
        if (data.parts[i].id == id) {
            ret i
        }
    }
    panic("the component does not exist")
}

i64 newPart(i32 kind, string text, i32 x, i32 y, i32 w, i32 h) {
    i64 made = 0
    withData([ref made, kind, text, x, y, w, h](ref Shared data) { made = makePart(ref data, kind, text, x, y, w, h) })
    ret made
}

// A new component, under the lock.
i64 makePart(ref Shared data, i32 kind, string text, i32 x, i32 y, i32 w, i32 h) {
    data.next++
    PartData part
    part.id = data.next
    part.kind = kind
    part.text = text
    part.x = x
    part.y = y
    part.width = w
    part.height = h
    part.baseX = x
    part.baseY = y
    part.baseWidth = w
    part.baseHeight = h
    part.caret = text.len()
    part.anchor = part.caret
    data.parts.add(move part)
    ret data.next
}

void setPartText(i64 id, string value) {
    withData([id, value](ref Shared data) {
        i64 p = partIndexOf(ref data, id)
        data.parts[p].text = value
        data.parts[p].caret = value.len()
        data.parts[p].anchor = value.len()
    })
}

string partText(i64 id, bool placeholder) {
    string result
    withData([id, placeholder, ref result](ref Shared data) {
        i64 p = partIndexOf(ref data, id)
        result = placeholder ? data.parts[p].placeholder : data.parts[p].text
    })
    ret result
}

// A negative value leaves that one as it is.
void setPartBounds(i64 id, i32 x, i32 y, i32 w, i32 h) {
    withData([id, x, y, w, h](ref Shared data) {
        i64 p = partIndexOf(ref data, id)
        arrangeNow(ref data, p)
        if (x >= 0 || y >= 0) {
            data.parts[p].x = x
            data.parts[p].y = y
        }
        if (w >= 0 || h >= 0) {
            data.parts[p].width = w
            data.parts[p].height = h
        }
        rebase(ref data, p)
    })
}

// 0 x, 1 y, 2 width, 3 height, 4 and 5 the width and the height of an image.
i32 partBound(i64 id, i32 which) {
    i32 result = 0
    withData([id, which, ref result](ref Shared data) {
        i64 p = partIndexOf(ref data, id)
        arrangeNow(ref data, p)
        if (which == 0) {
            result = data.parts[p].x
        } else if (which == 1) {
            result = data.parts[p].y
        } else if (which == 2) {
            result = data.parts[p].width
        } else if (which == 3) {
            result = data.parts[p].height
        } else if (which == 4) {
            result = data.parts[p].imageWidth
        } else {
            result = data.parts[p].imageHeight
        }
    })
    ret result
}

// 0 visible, 1 enabled, 2 checked.
void setPartFlag(i64 id, i32 which, bool value) {
    withData([id, which, value](ref Shared data) {
        i64 p = partIndexOf(ref data, id)
        if (which == 0) {
            data.parts[p].visible = value
        } else if (which == 1) {
            data.parts[p].enabled = value
        } else {
            data.parts[p].checked = value
        }
    })
}

bool partFlag(i64 id, i32 which) {
    bool result = false
    withData([id, which, ref result](ref Shared data) {
        i64 p = partIndexOf(ref data, id)
        result = which == 0 ? data.parts[p].visible : which == 1 ? data.parts[p].enabled : data.parts[p].checked
    })
    ret result
}

// 0 click, 1 change, 2 enter.
void addPartHandler(i64 id, i32 which, addr box) {
    withData([id, which, box](ref Shared data) {
        i64 p = partIndexOf(ref data, id)
        if (which == 0) {
            data.parts[p].click.add(box)
        } else if (which == 1) {
            data.parts[p].change.add(box)
        } else if (which == 2) {
            data.parts[p].enter.add(box)
        } else {
            data.parts[p].closing.add(box)
        }
    })
}

// Puts a component in a window, or in a group with window 0.
void addPart(i64 window, i64 group, i64 part) {
    withData([window, group, part](ref Shared data) {
        i64 p = partIndexOf(ref data, part)
        if (data.parts[p].window != 0 || data.parts[p].parent != 0) {
            panic("the component is already in a window or in a group")
        }
        i64 into = window
        if (data.parts[p].kind == kindAppBar && group != 0) {
            panic("an app bar is put in a window")
        }
        if (group != 0) {
            for (i64 up = group; up != 0; up = data.parts[partIndexOf(ref data, up)].parent) {
                if (up == part) {
                    panic("a group cannot contain itself")
                }
            }
            into = data.parts[partIndexOf(ref data, group)].window
            data.parts[p].parent = group
        } else {
            i64 i = indexOf(ref data, window)
            if (data.parts[p].kind == kindAppBar) {
                if (data.windows[i].appBar != 0) {
                    panic("the window has an app bar already")
                }
                data.windows[i].appBar = part
                data.parts[p].width = data.windows[i].width
                data.parts[p].horizontal = Horizontal.Stretch
            }
        }
        data.parts[p].window = into
        if (into != 0) {
            placeIn(ref data.parts, part, into)
        }
        rebase(ref data, p)
    })
}

// The components inside a group go in the window of the group.
void placeIn(ref list<PartData> parts, i64 group, i64 window) {
    for (i64 i = 0; i < parts.len(); i++) {
        if (parts[i].parent == group) {
            parts[i].window = window
            placeIn(ref parts, parts[i].id, window)
        }
    }
}

// Whether the program runs on Android (D452), where the window has no title bar.
bool onAndroid() {
    ret cText(SDL_GetPlatform()) == "Android"
}

// The size of the content of a window in logical pixels: under the title bar, or
// in the safe area on Android (D456).
i32 contentWidth(WindowData window) {
    ret window.width - i32(window.originX + window.insetRight)
}

i32 contentHeight(WindowData window) {
    ret window.height - i32(window.originY + window.insetBottom)
}

// The position and the size of a component now, for the size of its parent now
// (P40): what the thread of the GUI computes when it draws.
void arrangeNow(ref Shared data, i64 p) {
    i64 group = data.parts[p].parent
    if (data.parts[p].page >= 0 && data.parts[p].window != 0) {
        i64 i = indexOf(ref data, data.parts[p].window)
        placePage(ref data.parts[p], ref data.windows[i])
    } else if (group != 0) {
        i64 g = partIndexOf(ref data, group)
        arrangeNow(ref data, g)
        arrange(ref data.parts[p], data.parts[g].width, data.parts[g].height)
    } else if (data.parts[p].window != 0) {
        i64 i = indexOf(ref data, data.parts[p].window)
        arrange(ref data.parts[p], contentWidth(data.windows[i]), contentHeight(data.windows[i]))
    }
}

// A page takes the room between the bars of its window (P42).
void placePage(ref PartData page, ref WindowData window) {
    i32 top = window.appBar != 0 ? i32(appBarHeight) : 0
    i32 bottom = contentHeight(window) - i32(navigationHeight)
    page.x = 0
    page.y = top
    page.width = contentWidth(window)
    page.height = bottom > top ? bottom - top : 0
    page.baseX = page.x
    page.baseY = page.y
    page.baseWidth = page.width
    page.baseHeight = page.height
}

// The distances that the anchors keep are those of now (P40).
void rebase(ref Shared data, i64 p) {
    i32 w = 0
    i32 h = 0
    i64 group = data.parts[p].parent
    if (group != 0) {
        i64 g = partIndexOf(ref data, group)
        arrangeNow(ref data, g)
        w = data.parts[g].width
        h = data.parts[g].height
    } else if (data.parts[p].window != 0) {
        i64 i = indexOf(ref data, data.parts[p].window)
        w = contentWidth(data.windows[i])
        h = contentHeight(data.windows[i])
    }
    data.parts[p].baseX = data.parts[p].x
    data.parts[p].baseY = data.parts[p].y
    data.parts[p].baseWidth = data.parts[p].width
    data.parts[p].baseHeight = data.parts[p].height
    data.parts[p].parentWidth = w
    data.parts[p].parentHeight = h
}

// Shows a snackbar: the handler of the one before is freed by the thread of the GUI,
// which may be calling it.
void snackbar(i64 id, string text, string action, addr box) {
    withData([id, text, action, box](ref Shared data) {
        i64 i = indexOf(ref data, id)
        for (i64 k = 0; k < data.windows[i].snackHandler.len(); k++) {
            data.windows[i].dropped.add(data.windows[i].snackHandler[k])
        }
        data.windows[i].snackHandler.clear()
        addr none
        if (box != none) {
            data.windows[i].snackHandler.add(box)
        }
        data.windows[i].snackText = text
        data.windows[i].snackAction = action
        data.windows[i].snackFresh = true  // its time from the thread of the GUI, whose clock SDL starts
        data.windows[i].snackHeld = false
    })
}

// The index of a list with its item, or a panic if it has no such item.
i64 listIndex(ref Shared data, i64 id, i64 index) {
    i64 p = partIndexOf(ref data, id)
    if (index < 0 || index >= data.parts[p].items.len()) {
        panic(format("the list has no item {}", index))
    }
    ret p
}

f32 partScroll(i64 id) {
    f32 result = 0
    withData([id, ref result](ref Shared data) { result = data.parts[partIndexOf(ref data, id)].offsetY })
    ret result
}

void setPartScroll(i64 id, f32 y) {
    withData([id, y](ref Shared data) {
        i64 p = partIndexOf(ref data, id)
        data.parts[p].offsetY = y
        data.parts[p].velocity = 0
    })
}

void setPartAnchor(i64 id, Horizontal horizontal, Vertical vertical) {
    withData([id, horizontal, vertical](ref Shared data) {
        i64 p = partIndexOf(ref data, id)
        arrangeNow(ref data, p)
        data.parts[p].horizontal = horizontal
        data.parts[p].vertical = vertical
        rebase(ref data, p)
    })
}

void setPartIcon(i64 id, Icon value) {
    withData([id, value](ref Shared data) { data.parts[partIndexOf(ref data, id)].icon = value })
}

Icon partIcon(i64 id) {
    Icon result = Icon.None
    withData([id, ref result](ref Shared data) { result = data.parts[partIndexOf(ref data, id)].icon })
    ret result
}

Horizontal partHorizontal(i64 id) {
    Horizontal result = Horizontal.Left
    withData([id, ref result](ref Shared data) { result = data.parts[partIndexOf(ref data, id)].horizontal })
    ret result
}

Vertical partVertical(i64 id) {
    Vertical result = Vertical.Top
    withData([id, ref result](ref Shared data) { result = data.parts[partIndexOf(ref data, id)].vertical })
    ret result
}

void setComboItems(i64 id, list<string> items) {
    withData([id, items](ref Shared data) {
        i64 p = partIndexOf(ref data, id)
        data.parts[p].items = items
        data.parts[p].selected = -1
        data.parts[p].first = 0
        data.parts[p].highlight = 0
    })
}

// The pixels of an image, R, G, B and A, with its size: an exception if it cannot
// be read.
addr decodeImage(string file, list<u8> bytes, ref i32 w, ref i32 h) {
    if (bytes.len() == 0) {
        throw Error(format("cannot read the image {}: the file is empty", file))
    }
    addr data = alloc(bytes.len())
    for (i64 i = 0; i < bytes.len(); i++) {
        put<u8>(offset(data, i), bytes[i])
    }
    addr reason = alloc(128)
    addr pixels = cromo_gui_image_decode(data, bytes.len(), ref w, ref h, reason, 128)
    list<u8> why = cText(reason).bytes()
    free(reason)
    if (why.len() > 0) {
        why[0] = lowerByte(why[0])  // stb_image starts with a capital
    }
    free(data)
    addr none
    if (pixels == none) {
        string what = file.len() > 0 ? format("the image {}", file) : "the image"
        throw Error(format("cannot read {}: {}", what, string(why)))
    }
    ret pixels
}

// Decodes the image of an item of a list on this thread and makes it round, or
// removes it when there is neither a file nor bytes.
void setRoundImage(i64 me, i64 index, string file, list<u8> bytes) {
    addr pixels
    if (file.len() > 0 || bytes.len() > 0) {
        i32 w = 0
        i32 h = 0
        addr whole = decodeImage(file, bytes, ref w, ref h)
        pixels = cromo_gui_image_round(whole, w, h, avatarPixels)
        cromo_gui_image_free(whole)
    }
    withData([me, index, pixels](ref Shared data) {
        i64 p = listIndex(ref data, me, index)
        dropImage(ref data.parts[p], index)
        data.parts[p].images[index] = pixels
    })
}

// The image of an item of a list goes: its pixels are freed, its texture is
// destroyed by the thread of the GUI.
void dropImage(ref PartData view, i64 index) {
    addr none
    if (view.images[index] != none) {
        cromo_gui_image_free(view.images[index])
        view.images[index] = none
    }
    if (view.textures[index] != none) {
        view.dropped.add(view.textures[index])
        view.textures[index] = none
    }
}

void loadImage(i64 id, string path) {
    list<u8> bytes
    if (path.len() > 0) {
        bytes = fs.readBytes(path)
        if (bytes.len() == 0) {
            throw Error(format("cannot read the image {}: the file is empty", path))
        }
    }
    setImage(id, path, bytes)
}

// Decodes an image on this thread, and gives its pixels to the thread of the GUI,
// which makes its texture.
void setImage(i64 id, string file, list<u8> bytes) {
    addr pixels
    i32 w = 0
    i32 h = 0
    if (bytes.len() > 0) {
        pixels = decodeImage(file, bytes, ref w, ref h)
    }
    withData([id, file, pixels, w, h](ref Shared data) {
        i64 p = partIndexOf(ref data, id)
        addr none
        if (data.parts[p].pixels != none) {
            cromo_gui_image_free(data.parts[p].pixels)
        }
        data.parts[p].text = file
        data.parts[p].pixels = pixels
        data.parts[p].imageWidth = w
        data.parts[p].imageHeight = h
        data.parts[p].imageChanged = true
    })
}

// ---- The window ----

// A window (D430, D442): made with its title and its size in logical pixels,
// shown by start(). It is a handle: its copies name the same window, and a lambda
// captures it by copy. The program ends when its windows are closed.
public struct Window {
    i64 id

    public Window(string text, i32 w, i32 h) {
        i64 made = 0
        withData([ref made, text, w, h](ref Shared data) {
            data.next++
            WindowData window
            window.id = data.next
            window.title = text
            window.width = w
            window.height = h
            // On Android the components are added for the content that the window
            // would have on the desktop, and their anchors follow the phone (D456).
            window.phone = onAndroid()
            data.windows.add(move window)
            made = data.next
        })
        id = made
    }

    // Puts a component in the window, and gives it back (D434): a component is in
    // one window or in one group only.
    public T add<T : Component>(T component) const {
        addPart(id, 0, component.componentId())
        ret component
    }

    // The bar at the bottom of the window, made the first time (P42).
    public NavigationBar navigationBar() const {
        i64 me = id
        i64 made = 0
        withData([me, ref made](ref Shared data) {
            i64 i = indexOf(ref data, me)
            if (data.windows[i].navigation == 0) {
                i32 content = contentHeight(data.windows[i])
                i64 bar = makePart(ref data, kindNavigation, "", 0, content - i32(navigationHeight), contentWidth(data.windows[i]),
                    i32(navigationHeight))
                i64 p = partIndexOf(ref data, bar)
                data.parts[p].window = me
                data.parts[p].selected = 0
                data.parts[p].horizontal = Horizontal.Stretch
                data.parts[p].vertical = Vertical.Bottom
                rebase(ref data, p)
                data.windows[i].navigation = bar
            }
            made = data.windows[i].navigation
        })
        ret NavigationBar(made)
    }

    public void setTitle(string text) const {
        i64 me = id
        withData([me, text](ref Shared data) {
            i64 i = indexOf(ref data, me)
            data.windows[i].title = text
            data.windows[i].titleChanged = true
        })
    }

    public string title() const {
        i64 me = id
        string result
        withData([me, ref result](ref Shared data) { result = data.windows[indexOf(ref data, me)].title })
        ret result
    }

    // The size of the whole window, with its title bar, in logical pixels.
    public void setSize(i32 w, i32 h) const {
        i64 me = id
        withData([me, w, h](ref Shared data) {
            i64 i = indexOf(ref data, me)
            data.windows[i].width = w
            data.windows[i].height = h
            data.windows[i].sizeChanged = true
        })
    }

    public i32 width() const {
        i64 me = id
        i32 result = 0
        withData([me, ref result](ref Shared data) { result = data.windows[indexOf(ref data, me)].width })
        ret result
    }

    public i32 height() const {
        i64 me = id
        i32 result = 0
        withData([me, ref result](ref Shared data) { result = data.windows[indexOf(ref data, me)].height })
        ret result
    }

    // Whether the edges resize the window, and the button maximizes it.
    public void setResizable(bool value) const {
        i64 me = id
        withData([me, value](ref Shared data) {
            i64 i = indexOf(ref data, me)
            data.windows[i].resizable = value
            data.windows[i].resizableChanged = true
        })
    }

    public bool resizable() const {
        i64 me = id
        bool result = false
        withData([me, ref result](ref Shared data) { result = data.windows[indexOf(ref data, me)].resizable })
        ret result
    }

    // Before start(), the window starts so.
    public void minimize() const {
        showAs(1)
    }

    public void maximize() const {
        showAs(2)
    }

    public void restore() const {
        showAs(0)
    }

    public bool minimized() const {
        i64 me = id
        bool result = false
        withData([me, ref result](ref Shared data) {
            i64 i = indexOf(ref data, me)
            result = data.windows[i].window == addr(0) ? data.windows[i].show == 1 : data.windows[i].minimized
        })
        ret result
    }

    public bool maximized() const {
        i64 me = id
        bool result = false
        withData([me, ref result](ref Shared data) {
            i64 i = indexOf(ref data, me)
            result = data.windows[i].window == addr(0) ? data.windows[i].show == 2 : data.windows[i].maximized
        })
        ret result
    }

    public void setTheme(Theme value) const {
        i64 me = id
        withData([me, value](ref Shared data) { data.windows[indexOf(ref data, me)].theme = value })
    }

    public Theme theme() const {
        i64 me = id
        Theme result = Theme.System
        withData([me, ref result](ref Shared data) { result = data.windows[indexOf(ref data, me)].theme })
        ret result
    }

    // The frames that are drawn each second, from 1 to 240: 60 by default.
    public void setFps(i32 value) const {
        if (value < 1 || value > 240) {
            panic(format("the frames per second are from 1 to 240, found {}", value))
        }
        i64 me = id
        withData([me, value](ref Shared data) { data.windows[indexOf(ref data, me)].fps = value })
    }

    public i32 fps() const {
        i64 me = id
        i32 result = 0
        withData([me, ref result](ref Shared data) { result = data.windows[indexOf(ref data, me)].fps })
        ret result
    }

    // Shows the window and returns: the thread of the GUI draws it (D436).
    public void start() const {
        i64 me = id
        withData([me](ref Shared data) {
            i64 i = indexOf(ref data, me)
            if (data.windows[i].started) {
                panic("the window is already started")
            }
            if (data.windows[i].phone) {
                for (i64 other = 0; other < data.windows.len(); other++) {
                    if (other != i && data.windows[other].started) {
                        panic("an app of Android has one window: this is a second one (D459)")
                    }
                }
            }
            data.windows[i].started = true
            if (!data.running) {
                data.running = true
                guiThread = threadStart([]() { run() })
                guardThread = threadStart([]() { watch() })
                cromo_gui_wait_at_end()
            }
        })
    }

    // Closes the window; it can also be closed with its button.
    public void close() const {
        i64 me = id
        withData([me](ref Shared data) { data.windows[indexOf(ref data, me)].closing = true })
    }

    public bool closed() const {
        i64 me = id
        bool result = false
        withData([me, ref result](ref Shared data) { result = isClosed(ref data.windows[indexOf(ref data, me)]) })
        ret result
    }

    // Waits until the window is closed (D436).
    public void wait() const {
        for (!closed()) {
            time.msleep(10)
        }
    }

    // ---- The events: the lambdas run on the thread of the GUI (D435) ----

    public void onMouseMove(move func(Mouse) handler) const {
        addr box = alloc(sizeOf<func(Mouse)>())
        put<func(Mouse)>(box, move handler)
        i64 me = id
        withData([me, box](ref Shared data) { data.windows[indexOf(ref data, me)].mouseMove.add(box) })
    }

    public void onMouseDown(move func(Mouse) handler) const {
        addr box = alloc(sizeOf<func(Mouse)>())
        put<func(Mouse)>(box, move handler)
        i64 me = id
        withData([me, box](ref Shared data) { data.windows[indexOf(ref data, me)].mouseDown.add(box) })
    }

    public void onMouseUp(move func(Mouse) handler) const {
        addr box = alloc(sizeOf<func(Mouse)>())
        put<func(Mouse)>(box, move handler)
        i64 me = id
        withData([me, box](ref Shared data) { data.windows[indexOf(ref data, me)].mouseUp.add(box) })
    }

    // The keys that the component in focus does not use.
    public void onKeyDown(move func(Key) handler) const {
        addr box = alloc(sizeOf<func(Key)>())
        put<func(Key)>(box, move handler)
        i64 me = id
        withData([me, box](ref Shared data) { data.windows[indexOf(ref data, me)].keyDown.add(box) })
    }

    // The new size of the whole window, in logical pixels.
    public void onResize(move func(i32, i32) handler) const {
        addr box = alloc(sizeOf<func(i32, i32)>())
        put<func(i32, i32)>(box, move handler)
        i64 me = id
        withData([me, box](ref Shared data) { data.windows[indexOf(ref data, me)].resize.add(box) })
    }

    // Opens a dialog over the content (D467): one at a time.
    public void showDialog(Dialog dialog) const {
        i64 me = id
        i64 card = dialog.id
        withData([me, card](ref Shared data) {
            i64 i = indexOf(ref data, me)
            if (data.windows[i].dialog != 0) {
                panic("the window shows a dialog already")
            }
            for (i64 k = 0; k < data.windows.len(); k++) {
                if (data.windows[k].dialog == card) {
                    panic("the dialog is shown in another window")
                }
            }
            data.parts[partIndexOf(ref data, card)].window = me
            placeIn(ref data.parts, card, me)
            data.windows[i].dialog = card
            data.windows[i].dialogFocus = data.windows[i].focus
            data.windows[i].dialogFresh = true
            data.windows[i].popup = 0
        })
    }

    // A short message at the bottom for 4 seconds (D468), in place of the one shown.
    public void showSnackbar(string text) const {
        addr none
        snackbar(id, text, "", none)
    }

    // The same, with an action on its right, as "Undo": a click calls the handler
    // and hides the snackbar.
    public void showSnackbarAction(string text, string action, move func() handler) const {
        addr box = alloc(sizeOf<func()>())
        put<func()>(box, move handler)
        snackbar(id, text, action, box)
    }

    // The back key of Android, or its gesture (D457): without handlers it closes the
    // window, and so the app.
    public void onBack(move func() handler) const {
        addr box = alloc(sizeOf<func()>())
        put<func()>(box, move handler)
        i64 me = id
        withData([me, box](ref Shared data) { data.windows[indexOf(ref data, me)].back.add(box) })
    }

    // After the window is closed.
    public void onClose(move func() handler) const {
        addr box = alloc(sizeOf<func()>())
        put<func()>(box, move handler)
        i64 me = id
        withData([me, box](ref Shared data) { data.windows[indexOf(ref data, me)].close.add(box) })
    }

    void showAs(i32 state) const {
        i64 me = id
        withData([me, state](ref Shared data) {
            i64 i = indexOf(ref data, me)
            data.windows[i].show = state
            data.windows[i].showChanged = true
        })
    }
}

bool isClosed(ref WindowData window) {
    ret window.closed || (window.closing && !window.started)
}

// ---- The end of main (D442) and the exceptions of the handlers (D437) ----

// When main returns, the program waits for its windows. It reads only the data
// under the lock: a failure there is a panic, since C has no exceptions (D395).
[[export("cromo_gui_finish")]]
void finish() {
    try {
        for (openWindows() > 0) {
            time.msleep(10)
        }
    } catch (Exception e) {
        panic(e.message())
    }
}

i64 openWindows() {
    i64 count = 0
    withData([ref count](ref Shared data) {
        for (ref WindowData window in data.windows) {
            if (window.started && !isClosed(ref window)) {
                count++
            }
        }
    })
    ret count
}

// An exception that leaves a handler ends the thread of the GUI: this thread stops
// the program with it, as for a thread that no join() takes (D217).
void watch() {
    if (threadWait(guiThread)) {
        threadUncaught(guiThread)
    }
}

// ---- The thread of the GUI ----

const f32 barHeight = 35
const f32 buttonWidth = 46
const f32 edgeWidth = 6
const f32 titleSize = 12
const f32 bodySize = 14  // text-sm
const f32 padding = 8    // of the text in a text box and in a combo box
const f32 checkSide = 16
const f32 corner = 7       // of the buttons, the text boxes and the combo boxes
const f32 checkCorner = 4  // of the check boxes
const f32 groupCorner = 8
const f32 itemHeight = 26  // of the list of a combo box
const i64 listRows = 8
const f32 buttonIcon = 18  // the size of the icon of a button
const f32 appBarHeight = 56
const f32 navigationHeight = 64
const f32 headingSize = 18    // of the title of an app bar
const f32 captionSize = 12    // of the items of a navigation bar
const f32 rowHeight = 56      // of the items of a list
const i32 avatarPixels = 112  // of the round images of the lists, 40 pixels up to a density of 2.8
const f32 avatarSize = 40
const f32 dialogPadding = 24  // the body of a dialog, from its edges
const f32 dialogTop = 64      // under the title
const f32 dialogBottom = 68   // above the buttons
const f32 dialogButton = 36   // the height of its buttons
const f32 dialogCorner = 16
const f32 switchWidth = 44
const f32 switchHeight = 24
const f32 knob = 20  // of a switch and of a slider
const f32 snackHeight = 48
const u64 snackTime = 4000000000
const f32 wheelStep = 48  // what a step of the wheel scrolls

// The colors of the look (D443): the grays and the indigo of Tailwind, light and
// dark, with buttons in a gradient and a border of a deeper color.
struct Colors {
    u32 bar
    u32 separator
    u32 title
    u32 inactive
    u32 content
    u32 border
    u32 hover
    u32 pressed
    u32 text
    u32 label
    u32 muted
    u32 buttonTop
    u32 buttonBottom
    u32 hoverTop
    u32 hoverBottom
    u32 buttonLine
    u32 buttonText
    u32 highlight  // 0xAARRGGBB, a line of light inside the top of a button
    u32 input
    u32 inputBorder
    u32 check
    u32 checkBorder
    u32 focus
    u32 selection
    u32 shadow       // 0xAARRGGBB, under the buttons
    u32 inputShadow  // under the text boxes, the check boxes and the groups
    u32 glow         // around the text box in focus
    u32 card         // of the groups
    u32 cardBorder
    u32 item        // under the item that the mouse or the keys point at
    u32 listShadow  // 0xAARRGGBB, under the list of a combo box
    u32 accent      // the icon and the text of the item chosen of a navigation bar
}

Colors colorsOf(bool dark) {
    Colors c
    c.buttonTop = 0x6366F1     // indigo-500
    c.buttonBottom = 0x4F46E5  // indigo-600
    c.hoverTop = 0x818CF8      // indigo-400
    c.hoverBottom = 0x6366F1
    c.buttonLine = 0x4338CA  // indigo-700
    c.buttonText = 0xFFFFFF
    c.focus = 0x6366F1
    if (dark) {
        c.bar = 0x111827        // gray-900
        c.separator = 0x1F2937  // gray-800
        c.title = 0xD1D5DB      // gray-300
        c.inactive = 0x6B7280   // gray-500
        c.content = 0x111827
        c.border = 0x1F2937
        c.hover = 0x1F2937
        c.pressed = 0x374151  // gray-700
        c.text = 0xF3F4F6     // gray-100
        c.label = 0xD1D5DB
        c.muted = 0x6B7280
        c.highlight = 0x33FFFFFF
        c.input = 0x1D2331  // white/5 on gray-900
        c.inputBorder = 0x374151
        c.check = 0x1D2331
        c.checkBorder = 0x4B5563  // gray-600
        c.selection = 0x3730A3    // indigo-800
        c.shadow = 0x73000000
        c.inputShadow = 0x40000000
        c.glow = 0x596366F1
        c.card = 0x161E2D
        c.cardBorder = 0x273244
        c.item = 0x2B2F5E
        c.listShadow = 0x99000000
        c.accent = 0xA5B4FC  // indigo-300
    } else {
        c.bar = 0xFFFFFF
        c.separator = 0xE5E7EB  // gray-200
        c.title = 0x374151      // gray-700
        c.inactive = 0x9CA3AF   // gray-400
        c.content = 0xF3F4F6    // gray-100
        c.border = 0xE5E7EB
        c.hover = 0xF3F4F6
        c.pressed = 0xE5E7EB
        c.text = 0x111827  // gray-900
        c.label = 0x374151
        c.muted = 0x9CA3AF
        c.highlight = 0x40FFFFFF
        c.input = 0xFFFFFF
        c.inputBorder = 0xD1D5DB  // gray-300
        c.check = 0xFFFFFF
        c.checkBorder = 0xC9CDD4
        c.selection = 0xC7D2FE  // indigo-200
        c.shadow = 0x30111827
        c.inputShadow = 0x14111827
        c.glow = 0x406366F1
        c.card = 0xFFFFFF
        c.cardBorder = 0xE5E7EB
        c.item = 0xEEF2FF  // indigo-50
        c.listShadow = 0x2E111827
        c.accent = 0x4F46E5  // indigo-600
    }
    ret c
}

const u32 closeHover = 0xDC2626    // red-600
const u32 closePressed = 0xB91C1C  // red-700

u8 red(u32 rgb) {
    ret u8((rgb >> 16) & 0xFF)
}

u8 green(u32 rgb) {
    ret u8((rgb >> 8) & 0xFF)
}

u8 blue(u32 rgb) {
    ret u8(rgb & 0xFF)
}

// A color of the boxes of C, 0xAARRGGBB: opaque, or half for a component disabled.
u32 solid(u32 rgb, bool enabled) {
    ret enabled ? (0xFF000000 | rgb) : (0x80000000 | rgb)
}

void fill(addr renderer, u32 rgb, f32 x, f32 y, f32 w, f32 h) {
    SDL_SetRenderDrawColor(renderer, red(rgb), green(rgb), blue(rgb), 255)
    Rect area = Rect(x, y, w, h)
    SDL_RenderFillRect(renderer, ref area)
}

void text(addr font, string s, f32 x, f32 y, u32 rgb, bool enabled) {
    cromo_gui_text(font, s.cstring(), s.len(), x, y, red(rgb), green(rgb), blue(rgb), enabled ? 255 : 128)
}

f32 textWidth(addr font, string s, i64 bytes) {
    ret cromo_gui_text_width(font, s.cstring(), bytes)
}

// Drawing only inside a rectangle, in logical pixels.
void clipTo(addr renderer, f32 x, f32 y, f32 w, f32 h) {
    clip[0] = i32(x)
    clip[1] = i32(y)
    clip[2] = i32(w)
    clip[3] = i32(h)
    SDL_SetRenderClipRect(renderer, variableAddress(clip))
}

// Drawing only inside the groups of a component.
void clipPart(addr renderer, ref PartData part) {
    clipTo(renderer, part.clipLeft, part.clipTop, part.clipRight - part.clipLeft, part.clipBottom - part.clipTop)
}

// Drawing only inside a rectangle, and inside the groups of a component.
void clipInside(addr renderer, ref PartData part, f32 x, f32 y, f32 w, f32 h) {
    f32 left = most(x, part.clipLeft)
    f32 top = most(y, part.clipTop)
    f32 right = least(x + w, part.clipRight)
    f32 bottom = least(y + h, part.clipBottom)
    clipTo(renderer, left, top, most(right - left, 0), most(bottom - top, 0))
}

f32 least(f32 a, f32 b) {
    ret a < b ? a : b
}

f32 most(f32 a, f32 b) {
    ret a > b ? a : b
}

// A string of C, ended by a zero.
string cText(addr text) {
    i64 n = 0
    for (take<u8>(offset(text, n)) != 0) {
        n++
    }
    ret string(text, n)
}

void run() {
    // On Android the back key comes to std.gui (D457), and the app turns (D458).
    SDL_SetHint("SDL_ANDROID_TRAP_BACK_BUTTON".cstring(), "1".cstring())
    SDL_SetHint("SDL_ORIENTATIONS".cstring(), "LandscapeLeft LandscapeRight Portrait PortraitUpsideDown".cstring())
    if (!SDL_Init(0x20)) {  // SDL_INIT_VIDEO
        panic(format("cannot start the windows: {}", cText(SDL_GetError())))
    }
    arrow = SDL_CreateSystemCursor(0)  // SDL_SYSTEM_CURSOR_DEFAULT
    beam = SDL_CreateSystemCursor(1)   // SDL_SYSTEM_CURSOR_TEXT
    addr event = alloc(128)            // SDL_Event, a union of 128 bytes
    for (true) {
        u64 start = SDL_GetTicksNS()
        i32 fps = prepare()
        for (SDL_PollEvent(event)) {
            handle(event)
        }
        draw()
        u64 frame = 20000000  // without windows, 50 times a second
        if (fps > 0) {
            frame = 1000000000 / u64(fps)
        }
        u64 spent = SDL_GetTicksNS() - start
        if (spent < frame) {
            SDL_DelayPrecise(frame - spent)
        }
    }
}

// Opens the windows started, gives to SDL what the program changed, and closes
// the windows closed. A window is closed for the program after its handlers of
// onClose: if one throws, the program stops before (D437). The frames per second
// are the most among the windows open, or 0 without windows.
i32 prepare() {
    i32 fps = 0
    list<addr> handlers
    list<i64> ended
    list<Call> pending
    list<addr> dropped
    withData([ref fps, ref handlers, ref ended, ref pending, ref dropped](ref Shared data) {
        for (data.pending.len() > 0) {
            pending.add(data.pending.remove(0))
        }
        for (ref WindowData window in data.windows) {
            for (window.dropped.len() > 0) {
                dropped.add(window.dropped.remove(0))
            }
            addr none
            if (window.started && window.window == none && !window.closing) {
                open(ref window)
            }
            if (window.closing && window.started && !window.notified) {
                if (window.window != none) {
                    freeTextures(ref window, ref data.parts)
                    shut(ref window)
                }
                window.notified = true
                for (addr box in window.close) {
                    handlers.add(box)
                }
                ended.add(window.id)
                continue
            }
            if (window.window == none) {
                continue
            }
            apply(ref window)
            if (window.fps > fps) {
                fps = window.fps
            }
        }
    })
    for (addr box in dropped) {  // no call of theirs is running: they ran in the frame before
        func() handler = take<func()>(box)
        free(box)
    }
    for (ref Call call in pending) {
        dispatch(ref call)
    }
    for (addr box in handlers) {
        func() handler = take<func()>(box)
        try {
            handler()
        } finally {
            put<func()>(box, move handler)
        }
    }
    if (ended.len() > 0) {
        withData([ended](ref Shared data) {
            for (i64 id in ended) {
                data.windows[indexOf(ref data, id)].closed = true
            }
        })
    }
    ret fps
}

// From logical pixels to the coordinates of the window, which are pixels on
// Windows and on X11, and logical pixels on Wayland.
f32 toWindow(ref WindowData window) {
    f32 density = SDL_GetWindowPixelDensity(window.window)
    if (density <= 0) {
        ret 1
    }
    ret window.density / density
}

void open(ref WindowData window) {
    f32 scale = SDL_GetDisplayContentScale(SDL_GetPrimaryDisplay())
    if (scale <= 0) {
        scale = 1
    }
    u64 flags = 0x10 | 0x2000  // SDL_WINDOW_BORDERLESS, SDL_WINDOW_HIGH_PIXEL_DENSITY
    if (window.phone) {
        flags = 0x20 | 0x2000  // the whole screen, which turns
    } else if (window.resizable) {
        flags = flags | 0x20
    }
    if (window.show == 1) {
        flags = flags | 0x40
    } else if (window.show == 2) {
        flags = flags | 0x80
    }
    window.window = SDL_CreateWindow(window.title.cstring(), i32(f32(window.width) * scale), i32(f32(window.height) * scale), flags)
    addr none
    if (window.window == none) {
        panic(format("cannot open the window: {}", cText(SDL_GetError())))
    }
    window.renderer = SDL_CreateRenderer(window.window, none)
    if (window.renderer == none) {
        panic(format("cannot draw in the window: {}", cText(SDL_GetError())))
    }
    SDL_SetRenderDrawBlendMode(window.renderer, 1)  // SDL_BLENDMODE_BLEND
    window.sdlId = SDL_GetWindowID(window.window)
    if (!window.phone) {
        window.chrome = cromo_gui_chrome(window.window)
    }
    setDensity(ref window)
    readSafeArea(ref window)
    window.titleChanged = false
    window.sizeChanged = false
    window.resizableChanged = false
    window.showChanged = false
}

// On Android, the size of the screen and the area that the bars of the system leave
// free (D456).
i32[4] safeArea  // the SDL_Rect of SDL_GetWindowSafeArea

void readSafeArea(ref WindowData window) {
    if (!window.phone) {
        ret
    }
    i32 w = 0
    i32 h = 0
    SDL_GetWindowSize(window.window, ref w, ref h)
    f32 scale = toWindow(ref window)
    window.width = i32(f32(w) / scale + 0.5)
    window.height = i32(f32(h) / scale + 0.5)
    if (SDL_GetWindowSafeArea(window.window, variableAddress(safeArea))) {
        window.originX = f32(safeArea[0]) / scale
        window.originY = f32(safeArea[1]) / scale
        window.insetRight = f32(w - safeArea[0] - safeArea[2]) / scale
        window.insetBottom = f32(h - safeArea[1] - safeArea[3]) / scale
    }
}

// The renderer lost its textures, as on Android when an app comes back: they are
// made again when they are drawn.
void resetTextures(ref WindowData window, ref list<PartData> parts) {
    cromo_gui_symbols_free(window.renderer)
    cromo_gui_boxes_free(window.renderer)
    cromo_gui_icons_free(window.renderer)
    setDensity(ref window)
    addr none
    for (ref PartData part in parts) {
        if (part.window == window.id && part.texture != none) {
            SDL_DestroyTexture(part.texture)
            part.texture = none
            part.imageChanged = true
        }
        if (part.window == window.id) {
            freeItemTextures(ref part)
        }
    }
}

// The textures of the round images of a list, made again when they are drawn.
void freeItemTextures(ref PartData part) {
    addr none
    for (i64 i = 0; i < part.textures.len(); i++) {
        if (part.textures[i] != none) {
            SDL_DestroyTexture(part.textures[i])
            part.textures[i] = none
        }
    }
    for (addr texture in part.dropped) {
        SDL_DestroyTexture(texture)
    }
    part.dropped.clear()
}

// The scale of the display: the renderer draws in logical pixels, and the fonts
// are rasterized for the pixels of the display.
void setDensity(ref WindowData window) {
    f32 density = SDL_GetWindowDisplayScale(window.window)
    if (density <= 0) {
        density = 1
    }
    window.density = density
    SDL_SetRenderScale(window.renderer, density, density)
    addr none
    if (window.font != none) {
        cromo_gui_font_free(window.font)
        cromo_gui_font_free(window.body)
        cromo_gui_font_free(window.strong)
        cromo_gui_font_free(window.heading)
        cromo_gui_font_free(window.caption)
    }
    window.font = cromo_gui_font(window.renderer, 0, titleSize, density)
    window.body = cromo_gui_font(window.renderer, 0, bodySize, density)
    window.strong = cromo_gui_font(window.renderer, 1, bodySize, density)
    window.heading = cromo_gui_font(window.renderer, 1, headingSize, density)
    window.caption = cromo_gui_font(window.renderer, 1, captionSize, density)
}

// On Android the window keeps the screen: its size and its state do not change (P45).
void apply(ref WindowData window) {
    if (window.titleChanged) {
        SDL_SetWindowTitle(window.window, window.title.cstring())
        window.titleChanged = false
    }
    if (window.phone) {
        window.sizeChanged = false
        window.resizableChanged = false
        window.showChanged = false
    }
    if (window.sizeChanged) {
        f32 scale = toWindow(ref window)
        SDL_SetWindowSize(window.window, i32(f32(window.width) * scale), i32(f32(window.height) * scale))
        window.sizeChanged = false
    }
    if (window.resizableChanged) {
        SDL_SetWindowResizable(window.window, window.resizable)
        window.resizableChanged = false
    }
    if (window.showChanged) {
        if (window.show == 1) {
            SDL_MinimizeWindow(window.window)
        } else if (window.show == 2) {
            SDL_MaximizeWindow(window.window)
        } else {
            SDL_RestoreWindow(window.window)
        }
        window.showChanged = false
    }
}

// The textures of the images of a window, before its renderer is destroyed.
void freeTextures(ref WindowData window, ref list<PartData> parts) {
    addr none
    for (ref PartData part in parts) {
        if (part.window == window.id && part.texture != none) {
            SDL_DestroyTexture(part.texture)
            part.texture = none
        }
        if (part.window == window.id) {
            freeItemTextures(ref part)
        }
    }
}

void shut(ref WindowData window) {
    addr none
    cromo_gui_font_free(window.font)
    cromo_gui_font_free(window.body)
    cromo_gui_font_free(window.strong)
    cromo_gui_font_free(window.heading)
    cromo_gui_font_free(window.caption)
    window.font = none
    window.body = none
    window.strong = none
    window.heading = none
    window.caption = none
    cromo_gui_symbols_free(window.renderer)
    cromo_gui_boxes_free(window.renderer)
    cromo_gui_icons_free(window.renderer)
    SDL_DestroyRenderer(window.renderer)
    SDL_DestroyWindow(window.window)
    cromo_gui_chrome_free(window.chrome)
    window.window = none
    window.renderer = none
}

// The button of the title bar at a point: 0 minimize, 1 maximize, 2 close, or -1.
i32 buttonAt(f32 x, f32 y, f32 width) {
    f32 start = width - 3 * buttonWidth
    if (y < 0 || y >= barHeight || x < start || x >= width) {
        ret -1
    }
    ret i32((x - start) / buttonWidth)
}

// A call of handlers, made under the lock and run after it.
struct Call {
    i32 kind  // 1 mouse move, 2 mouse down, 3 mouse up, 4 key, 5 resize, 6 click, 7 text, 8 check, 9 choice
    list<addr> boxes
    Mouse mouse
    Key key
    i32 w
    i32 h
    string text
    bool value
    i64 index
}

void handle(addr event) {
    u32 kind = take<u32>(event)
    if (kind == 0x108) {  // SDL_EVENT_SYSTEM_THEME_CHANGED: drawn at the next frame
        ret
    }
    u32 sdlId = take<u32>(offset(event, 16))
    list<Call> calls
    withData([event, kind, sdlId, ref calls](ref Shared data) {
        for (i64 w = 0; w < data.windows.len(); w++) {
            addr none
            if (data.windows[w].window == none || data.windows[w].sdlId != sdlId) {
                continue
            }
            route(ref data.windows[w], ref data.parts, event, kind, ref calls)
            ret
        }
    })
    for (ref Call call in calls) {
        dispatch(ref call)
    }
}

void dispatch(ref Call call) {
    for (addr box in call.boxes) {
        if (call.kind >= 1 && call.kind <= 3) {
            func(Mouse) handler = take<func(Mouse)>(box)
            try {
                handler(call.mouse)
            } finally {
                put<func(Mouse)>(box, move handler)
            }
        } else if (call.kind == 4) {
            func(Key) handler = take<func(Key)>(box)
            try {
                handler(call.key)
            } finally {
                put<func(Key)>(box, move handler)
            }
        } else if (call.kind == 5) {
            func(i32, i32) handler = take<func(i32, i32)>(box)
            try {
                handler(call.w, call.h)
            } finally {
                put<func(i32, i32)>(box, move handler)
            }
        } else if (call.kind == 6) {
            func() handler = take<func()>(box)
            try {
                handler()
            } finally {
                put<func()>(box, move handler)
            }
        } else if (call.kind == 7) {
            func(string) handler = take<func(string)>(box)
            try {
                handler(call.text)
            } finally {
                put<func(string)>(box, move handler)
            }
        } else if (call.kind == 8) {
            func(bool) handler = take<func(bool)>(box)
            try {
                handler(call.value)
            } finally {
                put<func(bool)>(box, move handler)
            }
        } else if (call.kind == 9) {
            func(i64) handler = take<func(i64)>(box)
            try {
                handler(call.index)
            } finally {
                put<func(i64)>(box, move handler)
            }
        }
    }
}

Call callOf(i32 kind, list<addr> boxes) {
    Call call
    call.kind = kind
    call.boxes = boxes
    ret call
}

// An event of a window: the title bar handles its own, the components theirs, and
// the others go to the handlers of the program, in `calls`.
void route(ref WindowData window, ref list<PartData> parts, addr event, u32 kind, ref list<Call> calls) {
    if (kind >= 0x400 && kind <= 0x403) {  // the mouse: in logical pixels
        SDL_ConvertEventToRenderCoordinates(window.renderer, event)
    }
    layout(ref window, ref parts)
    i32 w = 0
    i32 h = 0
    SDL_GetWindowSize(window.window, ref w, ref h)
    f32 width = f32(w) / toWindow(ref window)
    if (kind == 0x400) {  // SDL_EVENT_MOUSE_MOTION
        f32 x = take<f32>(offset(event, 28))
        f32 y = take<f32>(offset(event, 32))
        window.hovered = window.phone ? -1 : buttonAt(x, y, width)
        window.pointerX = x
        window.pointerY = y
        dragScroll(ref window, ref parts, y)
        i64 hot = y >= window.originY && !window.dragMoved ? partAt(ref window, ref parts, x, y) : -1
        i64 open = partNumber(ref parts, window.popup)
        if (open >= 0 && inList(ref window, ref parts[open], x, y)) {
            hot = open
            i64 item = itemAt(ref window, ref parts[open], x, y)
            if (item >= 0) {
                parts[open].highlight = item
            }
        }
        i64 hotId = hot >= 0 ? parts[hot].id : 0
        window.hotItem = hot >= 0 && hot != open ? barItemAt(ref parts[hot], x, y) : -1
        if (hotId != window.hot) {
            window.hot = hotId
            SDL_SetCursor(hot >= 0 && hot != open && parts[hot].kind == kindTextBox && parts[hot].active ? beam : arrow)
        }
        window.snackHot = snackAt(ref window, x, y)
        i64 sliding = partNumber(ref parts, window.held)
        if (sliding >= 0 && parts[sliding].kind == kindSlider && parts[sliding].active) {
            slideTo(ref parts[sliding], x, ref calls)
        }
        if (window.dragging != 0) {
            i64 d = partNumber(ref parts, window.dragging)
            if (d >= 0) {
                parts[d].caret = indexAt(window.body, parts[d].text, x - parts[d].left - padding + parts[d].scroll)
                window.caretStart = SDL_GetTicksNS()
            }
        }
        if (y >= window.originY) {
            Call call = callOf(1, window.mouseMove)
            call.mouse = mouseAt(ref window, x, y, 0)
            calls.add(move call)
        }
    } else if (kind == 0x401 || kind == 0x402) {  // SDL_EVENT_MOUSE_BUTTON_DOWN, _UP
        f32 x = take<f32>(offset(event, 28))
        f32 y = take<f32>(offset(event, 32))
        i32 button = i32(take<u8>(offset(event, 24)))
        i32 on = window.phone ? -1 : buttonAt(x, y, width)
        if (kind == 0x401 && button == 1 && on >= 0) {
            window.pressed = on
        } else if (kind == 0x402 && window.pressed >= 0) {
            if (button == 1 && on == window.pressed) {
                press(ref window, on)
            }
            window.pressed = -1
        } else if (y >= window.originY) {
            bool finger = take<u32>(offset(event, 20)) == 0xFFFFFFFF  // SDL_TOUCH_MOUSEID
            if (kind == 0x401) {
                window.keyboard = false
            }
            if (kind == 0x401 && button == 1) {
                if (snackAt(ref window, x, y)) {
                    window.snackHeld = true
                } else if (!startScroll(ref window, ref parts, x, y, finger)) {
                    pressPart(ref window, ref parts, x, y, ref calls)
                }
            } else if (kind == 0x402 && button == 1 && window.snackHeld) {
                window.snackHeld = false
                if (snackAt(ref window, x, y)) {
                    calls.add(callOf(6, window.snackHandler))
                    window.snackText = ""
                }
            } else if (kind == 0x402 && button == 1) {
                if (endScroll(ref window, ref parts)) {
                    window.held = 0
                    window.heldItem = -1
                    window.dragging = 0
                } else {
                    releasePart(ref window, ref parts, x, y, ref calls)
                }
                if (finger) {  // a finger leaves no component under it
                    window.hot = 0
                    window.hotItem = -1
                }
            }
            Call call = callOf(kind == 0x401 ? 2 : 3, kind == 0x401 ? window.mouseDown : window.mouseUp)
            call.mouse = mouseAt(ref window, x, y, button)
            calls.add(move call)
        }
    } else if (kind == 0x403) {                           // SDL_EVENT_MOUSE_WHEEL: the list open, or a panel or a list
        bool flipped = take<u32>(offset(event, 32)) == 1  // SDL_MOUSEWHEEL_FLIPPED
        i64 open = partNumber(ref parts, window.popup)
        if (open >= 0) {
            i64 ticks = i64(take<i32>(offset(event, 48)))
            parts[open].first = parts[open].first - (flipped ? -ticks : ticks)
            reveal(ref window, ref parts[open], false)
        } else {
            i64 s = scrollerAt(ref window, ref parts, take<f32>(offset(event, 36)), take<f32>(offset(event, 40)))
            if (s >= 0) {
                f32 steps = take<f32>(offset(event, 28))
                parts[s].velocity = 0
                scrollBy(ref parts[s], -(flipped ? -steps : steps) * wheelStep)
            }
        }
    } else if (kind == 0x20D) {  // SDL_EVENT_WINDOW_MOUSE_LEAVE
        window.hovered = -1
        window.pressed = -1
        window.hot = 0
        window.pointerX = -1
        window.pointerY = -1
    } else if (kind == 0x20E) {  // FOCUS_GAINED
        window.focused = true
    } else if (kind == 0x20F) {  // FOCUS_LOST
        window.focused = false
        window.popup = 0
    } else if (kind == 0x210) {  // CLOSE_REQUESTED, as Alt+F4
        window.closing = true
    } else if (kind == 0x209) {  // MINIMIZED
        window.minimized = true
    } else if (kind == 0x20A) {  // MAXIMIZED
        window.maximized = true
        window.minimized = false
    } else if (kind == 0x20B) {  // RESTORED
        window.maximized = false
        window.minimized = false
    } else if (kind == 0x214) {  // DISPLAY_SCALE_CHANGED
        setDensity(ref window)
        readSafeArea(ref window)
    } else if (kind == 0x215) {  // SAFE_AREA_CHANGED
        readSafeArea(ref window)
    } else if (kind == 0x2000 || kind == 0x2001) {  // SDL_EVENT_RENDER_TARGETS_RESET, _DEVICE_RESET
        resetTextures(ref window, ref parts)
    } else if (kind == 0x206) {  // RESIZED, in the coordinates of the window
        f32 scale = toWindow(ref window)
        window.width = i32(f32(take<i32>(offset(event, 20))) / scale + 0.5)
        window.height = i32(f32(take<i32>(offset(event, 24))) / scale + 0.5)
        Call call = callOf(5, window.resize)
        call.w = window.width
        call.h = window.height
        calls.add(move call)
    } else if (kind == 0x300) {  // SDL_EVENT_KEY_DOWN
        window.keyboard = true
        u32 modifiers = u32(take<u16>(offset(event, 32)))
        Key key
        key.code = i64(take<u32>(offset(event, 28)))
        key.shift = (modifiers & 0x3) != 0
        key.control = (modifiers & 0xC0) != 0
        key.alt = (modifiers & 0x300) != 0
        if (window.phone && key.code == keyBack && window.dialog != 0) {  // D467
            endDialog(ref window, ref parts, ref calls)
        } else if (window.phone && key.code == keyBack) {  // D457
            if (window.back.len() > 0) {
                calls.add(callOf(6, window.back))
            } else {
                window.closing = true
            }
        } else if (!keyOfPart(ref window, ref parts, key, ref calls)) {
            if (window.dialog != 0) {  // the keys do not go behind a dialog
                if (key.code == 27) {  // Esc
                    endDialog(ref window, ref parts, ref calls)
                }
            } else {
                Call call = callOf(4, window.keyDown)
                call.key = key
                calls.add(move call)
            }
        }
    } else if (kind == 0x303) {  // SDL_EVENT_TEXT_INPUT, in UTF-8
        i64 f = partNumber(ref parts, window.focus)
        if (f >= 0 && parts[f].kind == kindTextBox && parts[f].active) {
            insert(ref parts[f], cText(take<addr>(offset(event, 24))))
            window.caretStart = SDL_GetTicksNS()
            changed(ref parts[f], ref calls)
        }
    }
}

// The mouse from the top left corner of the content (D438).
Mouse mouseAt(ref WindowData window, f32 x, f32 y, i32 button) {
    Mouse m
    m.x = x - window.originX
    m.y = y - window.originY
    m.button = button
    ret m
}

// A click on a button of the title bar.
void press(ref WindowData window, i32 button) {
    if (button == 0) {
        SDL_MinimizeWindow(window.window)
    } else if (button == 1 && window.maximized) {
        SDL_RestoreWindow(window.window)
    } else if (button == 1 && window.resizable) {
        SDL_MaximizeWindow(window.window)
    } else if (button == 2) {
        window.closing = true
    }
}

// ---- The components on the thread of the GUI ----

// The index of a component in the list, or -1.
i64 partNumber(ref list<PartData> parts, i64 id) {
    if (id == 0) {
        ret -1
    }
    for (i64 i = 0; i < parts.len(); i++) {
        if (parts[i].id == id) {
            ret i
        }
    }
    ret -1
}

// The component of a window at a point of its content: the last drawn is on top.
i64 partAt(ref WindowData window, ref list<PartData> parts, f32 x, f32 y) {
    for (i64 k = window.order.len() - 1; k >= firstReached(ref window); k--) {
        i64 i = window.order[k]
        if (parts[i].shown && inside(ref parts[i], x, y)) {
            ret i
        }
    }
    ret -1
}

// A point of the content on a component, and inside its groups.
bool inside(ref PartData part, f32 x, f32 y) {
    ret x >= part.left && x < part.left + f32(part.width) && y >= part.top && y < part.top + f32(part.height) &&
        x >= part.clipLeft && x < part.clipRight && y >= part.clipTop && y < part.clipBottom
}

bool focusable(ref PartData part) {
    bool takes = part.kind == kindButton || part.kind == kindTextBox || part.kind == kindCheckBox || part.kind == kindComboBox ||
        part.kind == kindListView || part.kind == kindSwitch || part.kind == kindSlider
    ret takes && part.shown && part.active
}

// Gives the keyboard to a component, or to none with 0: a text box receives the
// text of the keyboard, with its input method. The list of another combo box
// closes.
void focusTo(ref WindowData window, ref list<PartData> parts, i64 id) {
    if (window.popup != id) {
        window.popup = 0
    }
    if (window.focus == id) {
        ret
    }
    i64 old = partNumber(ref parts, window.focus)
    i64 now = partNumber(ref parts, id)
    bool wasText = old >= 0 && parts[old].kind == kindTextBox
    bool isText = now >= 0 && parts[now].kind == kindTextBox
    window.focus = id
    if (wasText && !isText) {
        SDL_StopTextInput(window.window)
    } else if (isText && !wasText) {
        SDL_StartTextInput(window.window)
    }
    window.caretStart = SDL_GetTicksNS()
}

// Tab and Shift+Tab: the next or the previous component that takes the keyboard.
void moveFocus(ref WindowData window, ref list<PartData> parts, i64 step) {
    list<i64> order
    i64 current = -1
    for (i64 k = firstReached(ref window); k < window.order.len(); k++) {
        i64 i = window.order[k]
        if (focusable(ref parts[i])) {
            if (parts[i].id == window.focus) {
                current = order.len()
            }
            order.add(parts[i].id)
        }
    }
    if (order.len() == 0) {
        ret
    }
    i64 next = current < 0 ? (step > 0 ? 0 : order.len() - 1) : (current + step + order.len()) % order.len()
    focusTo(ref window, ref parts, order[next])
}

// With the list of a combo box open, a click outside it closes it and does nothing
// else (P39); on an item, the release chooses it.
void pressPart(ref WindowData window, ref list<PartData> parts, f32 x, f32 y, ref list<Call> calls) {
    i64 open = partNumber(ref parts, window.popup)
    if (open >= 0) {
        if (!inList(ref window, ref parts[open], x, y)) {
            window.popup = 0
        }
        ret
    }
    i64 p = partAt(ref window, ref parts, x, y)
    focusTo(ref window, ref parts, p >= 0 && focusable(ref parts[p]) ? parts[p].id : 0)
    if (p < 0 || !parts[p].active) {
        ret
    }
    window.held = parts[p].id
    if (parts[p].kind == kindTextBox) {
        parts[p].caret = indexAt(window.body, parts[p].text, x - parts[p].left - padding + parts[p].scroll)
        parts[p].anchor = parts[p].caret
        window.dragging = parts[p].id
    } else if (parts[p].kind == kindComboBox) {
        openList(ref window, ref parts[p])
    } else if (parts[p].kind == kindSlider) {
        slideTo(ref parts[p], x, ref calls)
    } else if (parts[p].kind == kindAppBar || parts[p].kind == kindNavigation || parts[p].kind == kindListView) {
        window.heldItem = barItemAt(ref parts[p], x, y)
    }
}

void releasePart(ref WindowData window, ref list<PartData> parts, f32 x, f32 y, ref list<Call> calls) {
    i64 p = partNumber(ref parts, window.held)
    window.held = 0
    window.dragging = 0
    i64 open = partNumber(ref parts, window.popup)
    if (open >= 0) {
        i64 item = itemAt(ref window, ref parts[open], x, y)
        if (item >= 0) {
            choose(ref parts[open], item, ref calls)
            window.popup = 0
        }
        ret
    }
    i64 item = window.heldItem
    window.heldItem = -1
    if (p >= 0 && parts[p].active && inside(ref parts[p], x, y)) {
        if (parts[p].kind == kindListView) {
            if (item >= 0 && rowAt(ref parts[p], y) == item) {
                chooseRow(ref parts[p], item, ref calls)
            }
        } else if (parts[p].kind == kindAppBar || parts[p].kind == kindNavigation) {
            if (item >= 0 && barItemAt(ref parts[p], x, y) == item) {
                chooseItem(ref window, ref parts, p, item, ref calls)
            }
        } else {
            activate(ref parts[p], ref calls)
        }
    }
}

// ---- The sliders, the dialogs and the snackbar (D466-D468) ----

// The center of the knob of a slider, between the ends of its track.
f32 knobAt(ref PartData slider) {
    f32 from = slider.left + knob / 2
    f32 span = f32(slider.width) - knob
    if (slider.maximum == slider.minimum || span <= 0) {
        ret from
    }
    ret from + span * f32(slider.value - slider.minimum) / f32(slider.maximum - slider.minimum)
}

// The value of a slider for the mouse at x, and the handlers if it changes.
void slideTo(ref PartData slider, f32 x, ref list<Call> calls) {
    f32 span = f32(slider.width) - knob
    i64 value = slider.minimum
    if (span > 0) {
        f32 part = (x - slider.left - knob / 2) / span
        part = part < 0 ? 0 : part > 1 ? 1 : part
        value = slider.minimum + i64(part * f32(slider.maximum - slider.minimum) + 0.5)
    }
    setSlider(ref slider, value, ref calls)
}

void setSlider(ref PartData slider, i64 value, ref list<Call> calls) {
    i64 kept = value < slider.minimum ? slider.minimum : value > slider.maximum ? slider.maximum : value
    if (kept != slider.value) {
        slider.value = kept
        Call call = callOf(9, slider.change)
        call.index = kept
        calls.add(move call)
    }
}

// The keys of a slider (P48): false for those it does not use.
bool sliderKey(ref PartData slider, Key key, ref list<Call> calls) {
    i64 page = (slider.maximum - slider.minimum) / 10
    page = page > 0 ? page : 1
    if (key.code == keyLeft || key.code == keyDown) {
        setSlider(ref slider, slider.value - 1, ref calls)
    } else if (key.code == keyRight || key.code == keyUp) {
        setSlider(ref slider, slider.value + 1, ref calls)
    } else if (key.code == keyPageDown) {
        setSlider(ref slider, slider.value - page, ref calls)
    } else if (key.code == keyPageUp) {
        setSlider(ref slider, slider.value + page, ref calls)
    } else if (key.code == keyHome) {
        setSlider(ref slider, slider.minimum, ref calls)
    } else if (key.code == keyEnd) {
        setSlider(ref slider, slider.maximum, ref calls)
    } else {
        ret false
    }
    ret true
}

// The dialog closes with Esc or the back key: its handlers of onClose are called.
void endDialog(ref WindowData window, ref list<PartData> parts, ref list<Call> calls) {
    i64 card = partNumber(ref parts, window.dialog)
    window.dialog = 0
    window.dialogEnded = true
    if (card >= 0) {
        calls.add(callOf(6, parts[card].closing))
    }
}

// Whether the snackbar is shown, and where: at the bottom of the content, above the
// navigation bar, at most 560 pixels wide.
bool snackVisible(ref WindowData window) {
    if (window.snackFresh) {
        window.snackFresh = false
        window.snackShown = SDL_GetTicksNS()
    }
    ret window.snackText.len() > 0 && SDL_GetTicksNS() - window.snackShown < snackTime
}

Rect snackBox(ref WindowData window) {
    f32 width = least(f32(contentWidth(window)) - 16, 560)
    f32 bottom = window.originY + f32(contentHeight(window)) - 8
    if (window.navigation != 0) {
        bottom = bottom - navigationHeight
    }
    ret Rect(window.originX + (f32(contentWidth(window)) - width) / 2, bottom - snackHeight, width, snackHeight)
}

// The action of the snackbar at a point, with 8 pixels around its text.
bool snackAt(ref WindowData window, f32 x, f32 y) {
    if (!snackVisible(ref window) || window.snackAction.len() == 0) {
        ret false
    }
    Rect box = snackBox(ref window)
    f32 size = textWidth(window.strong, window.snackAction, window.snackAction.len())
    f32 right = box.x + box.w - 8
    ret x >= right - size - 16 && x < right && y >= box.y && y < box.y + box.h
}

// ---- Scrolling (D460, P46) ----

// The panel or the list that scrolls under a point, the innermost, or -1.
i64 scrollerAt(ref WindowData window, ref list<PartData> parts, f32 x, f32 y) {
    for (i64 k = window.order.len() - 1; k >= firstReached(ref window); k--) {
        i64 i = window.order[k]
        if (parts[i].shown && scrolls(ref parts[i]) && inside(ref parts[i], x, y)) {
            ret i
        }
    }
    ret -1
}

// A finger on a panel or a list that scrolls may scroll it; the mouse scrolls it
// with its bar, on the right edge. True when the press is taken here.
bool startScroll(ref WindowData window, ref list<PartData> parts, f32 x, f32 y, bool finger) {
    i64 s = scrollerAt(ref window, ref parts, x, y)
    i64 under = partAt(ref window, ref parts, x, y)
    if (s < 0 || window.popup != 0 || (under >= 0 && parts[under].kind == kindSlider)) {
        ret false
    }
    parts[s].velocity = 0
    bool bar = !finger && x >= parts[s].left + f32(parts[s].width) - 10
    if (!finger && !bar) {
        ret false
    }
    window.scrolling = parts[s].id
    window.scrollBar = bar
    window.dragMoved = false
    window.dragStart = y
    window.dragY = y
    window.dragTime = SDL_GetTicksNS()
    ret bar
}

// The mouse moved with a finger, or with the bar held: the content follows, once
// the finger moved more than 8 pixels, and then the press is let go.
void dragScroll(ref WindowData window, ref list<PartData> parts, f32 y) {
    i64 s = partNumber(ref parts, window.scrolling)
    if (s < 0) {
        ret
    }
    u64 now = SDL_GetTicksNS()
    f32 seconds = f32(now - window.dragTime) / 1000000000
    if (window.scrollBar) {
        scrollBy(ref parts[s], (y - window.dragY) * parts[s].content / f32(parts[s].height))
    } else {
        if (!window.dragMoved && (y - window.dragStart > 8 || window.dragStart - y > 8)) {
            window.dragMoved = true
            window.held = 0
            window.heldItem = -1
            window.dragging = 0
            window.hot = 0
            window.popup = 0
        }
        if (window.dragMoved) {
            scrollBy(ref parts[s], window.dragY - y)
            if (seconds > 0) {
                parts[s].velocity = parts[s].velocity * 0.2 + (window.dragY - y) / seconds * 0.8
            }
        }
    }
    window.dragY = y
    window.dragTime = now
}

// The finger or the mouse let go: the content goes on with its speed after a
// finger. True when it scrolled, and so nothing is clicked.
bool endScroll(ref WindowData window, ref list<PartData> parts) {
    i64 s = partNumber(ref parts, window.scrolling)
    bool moved = window.dragMoved || window.scrollBar
    if (s >= 0 && (!window.dragMoved || SDL_GetTicksNS() - window.dragTime > 100000000)) {
        parts[s].velocity = 0  // a finger that stopped before it left
    }
    window.scrolling = 0
    window.scrollBar = false
    window.dragMoved = false
    ret moved
}

// At each frame the panels and the lists that a finger left go on, slowing down.
void glide(ref WindowData window, ref list<PartData> parts) {
    u64 now = SDL_GetTicksNS()
    f32 seconds = window.lastFrame == 0 ? 0 : f32(now - window.lastFrame) / 1000000000
    window.lastFrame = now
    if (seconds > 0.05) {
        seconds = 0.05
    }
    for (ref PartData part in parts) {
        if (part.window == window.id && part.velocity != 0 && part.id != window.scrolling) {
            scrollBy(ref part, part.velocity * seconds)
            part.velocity = part.velocity * (1 - least(1, seconds * 3))
            if (part.velocity < 20 && part.velocity > -20) {
                part.velocity = 0
            }
        }
    }
}

// The row of a list at a point of the window, or -1.
i64 rowAt(ref PartData view, f32 y) {
    i64 row = i64((y - view.top + view.offsetY) / rowHeight)
    ret row >= 0 && row < view.items.len() ? row : -1
}

// Scrolls a list so that a row is seen.
void showRow(ref PartData view, i64 row) {
    f32 top = f32(row) * rowHeight
    view.velocity = 0
    if (top < view.offsetY) {
        scrollBy(ref view, top - view.offsetY)
    } else if (top + rowHeight > view.offsetY + f32(view.height)) {
        scrollBy(ref view, top + rowHeight - f32(view.height) - view.offsetY)
    }
}

// The keys of a list (P46): false for those it does not use.
bool listKey(ref PartData view, Key key, ref list<Call> calls) {
    i64 n = view.items.len()
    i64 page = i64(f32(view.height) / rowHeight)
    i64 next = view.selected
    if (key.code == keyUp) {
        next = view.selected > 0 ? view.selected - 1 : 0
    } else if (key.code == keyDown) {
        next = view.selected < n - 1 ? view.selected + 1 : n - 1
    } else if (key.code == keyHome) {
        next = 0
    } else if (key.code == keyEnd) {
        next = n - 1
    } else if (key.code == keyPageUp) {
        next = view.selected - page > 0 ? view.selected - page : 0
    } else if (key.code == keyPageDown) {
        next = view.selected + page < n - 1 ? view.selected + page : n - 1
    } else {
        ret false
    }
    if (next >= 0 && next < n) {
        chooseRow(ref view, next, ref calls)
    }
    ret true
}

// An item of a list chosen: it stays lit, and the handlers are called (D462).
void chooseRow(ref PartData view, i64 row, ref list<Call> calls) {
    view.selected = row
    showRow(ref view, row)
    Call call = callOf(9, view.change)
    call.index = row
    calls.add(move call)
}

// ---- The bars of the apps (D450, D451) ----

// The item of a bar at a point of the content, or -1: on an app bar 0 for the icon
// on the left and from 1 its actions, from the right; on a navigation bar its
// items, from the left.
i64 barItemAt(ref PartData bar, f32 x, f32 y) {
    if (bar.kind == kindAppBar) {
        f32 middle = bar.top + appBarHeight / 2
        if (y < middle - 20 || y >= middle + 20) {
            ret -1
        }
        if (bar.icon != Icon.None && x >= bar.left + 8 && x < bar.left + 48) {
            ret 0
        }
        for (i64 k = 0; k < bar.icons.len(); k++) {
            f32 center = bar.left + f32(bar.width) - 28 - 44 * f32(k)
            if (x >= center - 20 && x < center + 20) {
                ret k + 1
            }
        }
        ret -1
    }
    if (bar.kind == kindListView) {
        ret rowAt(ref bar, y)
    }
    if (bar.kind == kindNavigation && bar.items.len() > 0 && bar.width > 0) {
        i64 item = i64((x - bar.left) * f32(bar.items.len()) / f32(bar.width))
        ret item >= 0 && item < bar.items.len() ? item : -1
    }
    ret -1
}

// A click on an item of a bar: an icon of an app bar calls its handlers, an item of
// a navigation bar shows its page.
void chooseItem(ref WindowData window, ref list<PartData> parts, i64 p, i64 item, ref list<Call> calls) {
    if (parts[p].kind == kindAppBar) {
        if (item == 0) {
            calls.add(callOf(6, parts[p].click))
        } else {
            list<addr> boxes
            boxes.add(parts[p].actions[item - 1])
            calls.add(callOf(6, boxes))
        }
    } else if (item != parts[p].selected) {
        parts[p].selected = item
        focusTo(ref window, ref parts, 0)
        Call call = callOf(9, parts[p].change)
        call.index = item
        calls.add(move call)
    }
}

// ---- The list of a combo box (D445) ----

// How many items the list shows: up to 8, and as many as fit below the combo box
// or above it, where there is more room.
i64 rowsOf(ref WindowData window, ref PartData box) {
    f32 below = window.originY + f32(contentHeight(window)) - box.top - f32(box.height) - 8
    f32 above = box.top - window.originY - 8
    i64 fit = i64((most(below, above) - 6) / itemHeight)
    i64 rows = box.items.len() < listRows ? box.items.len() : listRows
    if (fit < rows) {
        rows = fit < 1 ? 1 : fit
    }
    ret rows
}

// Where the list is, in the content: below the combo box, or above it when there
// is no room below.
Rect listOf(ref WindowData window, ref PartData box) {
    f32 h = f32(rowsOf(ref window, ref box)) * itemHeight + 6
    f32 top = box.top + f32(box.height) + 3
    if (top + h > window.originY + f32(contentHeight(window)) - 4 && box.top - 3 - h >= window.originY + 4) {
        top = box.top - 3 - h
    }
    ret Rect(box.left, top, f32(box.width), h)
}

bool inList(ref WindowData window, ref PartData box, f32 x, f32 y) {
    Rect area = listOf(ref window, ref box)
    ret x >= area.x && x < area.x + area.w && y >= area.y && y < area.y + area.h
}

// The item at a point of the content, or -1.
i64 itemAt(ref WindowData window, ref PartData box, f32 x, f32 y) {
    Rect area = listOf(ref window, ref box)
    if (x < area.x || x >= area.x + area.w || y < area.y + 3 || y >= area.y + area.h - 3) {
        ret -1
    }
    i64 item = box.first + i64((y - area.y - 3) / itemHeight)
    ret item < box.items.len() ? item : -1
}

void openList(ref WindowData window, ref PartData box) {
    if (box.items.len() == 0) {
        ret
    }
    window.popup = box.id
    box.highlight = box.selected >= 0 ? box.selected : 0
    reveal(ref window, ref box, true)
}

// Scrolls the list so that the item pointed at is in it, with `follow`, and not
// beyond its items.
void reveal(ref WindowData window, ref PartData box, bool follow) {
    i64 rows = rowsOf(ref window, ref box)
    if (follow && box.highlight < box.first) {
        box.first = box.highlight
    }
    if (follow && box.highlight >= box.first + rows) {
        box.first = box.highlight - rows + 1
    }
    if (box.first > box.items.len() - rows) {
        box.first = box.items.len() - rows
    }
    if (box.first < 0) {
        box.first = 0
    }
}

// The user chooses an item: the handlers of onChange are called when it changes.
void choose(ref PartData box, i64 item, ref list<Call> calls) {
    if (item == box.selected) {
        ret
    }
    box.selected = item
    Call call = callOf(9, box.change)
    call.index = item
    calls.add(move call)
}

// The next item after `from` that starts with a letter, or -1.
i64 itemByLetter(ref PartData box, i64 code, i64 from) {
    for (i64 k = 1; k <= box.items.len(); k++) {
        i64 i = (from + k) % box.items.len()
        list<u8> bytes = box.items[i].bytes()
        if (bytes.len() > 0 && lowerByte(bytes[0]) == lowerByte(u8(code))) {
            ret i
        }
    }
    ret -1
}

u8 lowerByte(u8 b) {
    ret b >= 65 && b <= 90 ? b + 32 : b
}

// The keys of a combo box (P39): false for those it does not use.
bool comboKey(ref WindowData window, ref PartData box, Key key, ref list<Call> calls) {
    i64 code = key.code
    i64 n = box.items.len()
    bool letter = !key.control && !key.alt && code > 32 && code < 127
    if (window.popup == box.id) {
        if (code == 27) {  // Esc
            window.popup = 0
        } else if (code == 13 || code == keyEnter || code == 32) {
            if (box.highlight >= 0 && box.highlight < n) {
                choose(ref box, box.highlight, ref calls)
            }
            window.popup = 0
        } else if (code == keyUp && box.highlight > 0) {
            box.highlight--
        } else if (code == keyDown && box.highlight < n - 1) {
            box.highlight++
        } else if (code == keyHome) {
            box.highlight = 0
        } else if (code == keyEnd) {
            box.highlight = n - 1
        } else if (letter) {
            i64 found = itemByLetter(ref box, code, box.highlight)
            if (found >= 0) {
                box.highlight = found
            }
        } else if (code != keyUp && code != keyDown) {
            ret false
        }
        reveal(ref window, ref box, true)
        ret true
    }
    if (code == 32 || code == 13 || code == keyEnter || (key.alt && code == keyDown)) {
        openList(ref window, ref box)
        ret true
    }
    i64 next = -1
    if (code == keyUp) {
        next = box.selected > 0 ? box.selected - 1 : 0
    } else if (code == keyDown) {
        next = box.selected < n - 1 ? box.selected + 1 : n - 1
    } else if (code == keyHome) {
        next = 0
    } else if (code == keyEnd) {
        next = n - 1
    } else if (letter) {
        next = itemByLetter(ref box, code, box.selected)
    } else {
        ret false
    }
    if (next >= 0 && next < n) {
        choose(ref box, next, ref calls)
    }
    ret true
}

// A click, or Space: a button calls its handlers, a check box changes.
void activate(ref PartData part, ref list<Call> calls) {
    if (part.kind == kindButton) {
        calls.add(callOf(6, part.click))
    } else if (part.kind == kindCheckBox || part.kind == kindSwitch) {
        part.checked = !part.checked
        part.flipped = SDL_GetTicksNS()
        Call call = callOf(8, part.change)
        call.value = part.checked
        calls.add(move call)
    }
}

// A key for the component in focus: false if it does not use it.
bool keyOfPart(ref WindowData window, ref list<PartData> parts, Key key, ref list<Call> calls) {
    if (key.code == 9) {  // Tab
        moveFocus(ref window, ref parts, key.shift ? -1 : 1)
        ret true
    }
    i64 f = partNumber(ref parts, window.focus)
    if (f < 0 || !parts[f].active || !parts[f].shown) {
        ret false
    }
    if (parts[f].kind == kindTextBox) {
        window.caretStart = SDL_GetTicksNS()
        ret edit(ref parts[f], key, ref calls)
    }
    if (parts[f].kind == kindComboBox) {
        ret comboKey(ref window, ref parts[f], key, ref calls)
    }
    if (parts[f].kind == kindListView) {
        ret listKey(ref parts[f], key, ref calls)
    }
    if (parts[f].kind == kindSlider) {
        ret sliderKey(ref parts[f], key, ref calls)
    }
    if (key.code == 32 || (key.code == 13 && parts[f].kind == kindButton)) {  // Space, Enter
        activate(ref parts[f], ref calls)
        ret true
    }
    ret false
}

const i64 keyLeft = 0x40000050
const i64 keyRight = 0x4000004F
const i64 keyHome = 0x4000004A
const i64 keyEnd = 0x4000004D
const i64 keyEnter = 0x40000058  // of the numeric keypad
const i64 keyUp = 0x40000052
const i64 keyBack = 0x4000011A  // SDLK_AC_BACK, of Android
const i64 keyPageUp = 0x4000004B
const i64 keyPageDown = 0x4000004E
const i64 keyDown = 0x40000051

// The editing of a text box: the characters come with the text of the keyboard.
bool edit(ref PartData box, Key key, ref list<Call> calls) {
    i64 code = key.code
    if (code == 8) {  // Backspace
        if (!removeSelection(ref box) && box.caret > 0) {
            i64 from = previousCharacter(box.text, box.caret)
            box.text = box.text.slice(0, from).concat(box.text.slice(box.caret, box.text.len()))
            box.caret = from
            box.anchor = from
        }
        changed(ref box, ref calls)
    } else if (code == 0x7F) {  // Delete
        if (!removeSelection(ref box) && box.caret < box.text.len()) {
            i64 to = nextCharacter(box.text, box.caret)
            box.text = box.text.slice(0, box.caret).concat(box.text.slice(to, box.text.len()))
        }
        changed(ref box, ref calls)
    } else if (code == keyLeft || code == keyRight || code == keyHome || code == keyEnd) {
        i64 low = box.caret < box.anchor ? box.caret : box.anchor
        i64 high = box.caret < box.anchor ? box.anchor : box.caret
        if (code == keyLeft) {
            box.caret = !key.shift && low != high ? low : previousCharacter(box.text, box.caret)
        } else if (code == keyRight) {
            box.caret = !key.shift && low != high ? high : nextCharacter(box.text, box.caret)
        } else if (code == keyHome) {
            box.caret = 0
        } else {
            box.caret = box.text.len()
        }
        if (!key.shift) {
            box.anchor = box.caret
        }
    } else if (code == 13 || code == keyEnter) {
        Call call = callOf(7, box.enter)
        call.text = box.text
        calls.add(move call)
    } else if (key.control && code == 97) {  // Ctrl+A
        box.anchor = 0
        box.caret = box.text.len()
    } else if (key.control && (code == 99 || code == 120)) {  // Ctrl+C, Ctrl+X
        if (box.caret != box.anchor) {
            SDL_SetClipboardText(selection(ref box).cstring())
            if (code == 120) {
                removeSelection(ref box)
                changed(ref box, ref calls)
            }
        }
    } else if (key.control && code == 118) {  // Ctrl+V: the text in one line
        addr none
        addr pasted = SDL_GetClipboardText()
        if (pasted != none) {
            string line = cText(pasted).replace("\r\n", " ").replace("\n", " ").replace("\r", " ")
            SDL_free(pasted)
            insert(ref box, line)
            changed(ref box, ref calls)
        }
    } else {
        ret !key.control && !key.alt && code >= 32 && code < 127
    }
    ret true
}

void changed(ref PartData box, ref list<Call> calls) {
    Call call = callOf(7, box.change)
    call.text = box.text
    calls.add(move call)
}

string selection(ref PartData box) {
    i64 low = box.caret < box.anchor ? box.caret : box.anchor
    i64 high = box.caret < box.anchor ? box.anchor : box.caret
    ret box.text.slice(low, high)
}

// Removes the text selected: false without a selection.
bool removeSelection(ref PartData box) {
    if (box.caret == box.anchor) {
        ret false
    }
    i64 low = box.caret < box.anchor ? box.caret : box.anchor
    i64 high = box.caret < box.anchor ? box.anchor : box.caret
    box.text = box.text.slice(0, low).concat(box.text.slice(high, box.text.len()))
    box.caret = low
    box.anchor = low
    ret true
}

void insert(ref PartData box, string piece) {
    removeSelection(ref box)
    box.text = box.text.slice(0, box.caret).concat(piece).concat(box.text.slice(box.caret, box.text.len()))
    box.caret = box.caret + piece.len()
    box.anchor = box.caret
}

// Where the characters of UTF-8 start: a byte 10xxxxxx continues one.
i64 previousCharacter(string s, i64 at) {
    list<u8> bytes = s.bytes()
    i64 i = at - 1
    for (i > 0 && (bytes[i] & 0xC0) == 0x80) {
        i--
    }
    ret i < 0 ? 0 : i
}

i64 nextCharacter(string s, i64 at) {
    list<u8> bytes = s.bytes()
    if (at >= bytes.len()) {
        ret bytes.len()
    }
    i64 i = at + 1
    for (i < bytes.len() && (bytes[i] & 0xC0) == 0x80) {
        i++
    }
    ret i
}

// The place between two characters nearest to x, from the start of the text.
i64 indexAt(addr font, string s, f32 x) {
    i64 at = 0
    f32 left = 0
    for (at < s.len()) {
        i64 next = nextCharacter(s, at)
        f32 right = textWidth(font, s, next)
        if (x < (left + right) / 2) {
            ret at
        }
        at = next
        left = right
    }
    ret s.len()
}

// ---- The layout: the groups (D444) and the anchors (D447, P40) ----

// Where the components of a group go: its place in the content, its size, whether
// it is shown and enabled, and the rectangle that clips them.
struct Frame {
    f32 left
    f32 top
    i32 width
    i32 height
    bool shown
    bool active
    f32 clipLeft
    f32 clipTop
    f32 clipRight
    f32 clipBottom
    f32 scrolled  // how far its panel is scrolled
}

// Places the components of a window in its content, each group before its
// components, in the order they are drawn. The list of a combo box hidden or
// disabled closes.
void layout(ref WindowData window, ref list<PartData> parts) {
    window.order.clear()
    Frame content
    content.left = window.originX
    content.top = window.originY
    content.width = contentWidth(window)
    content.height = contentHeight(window)
    content.shown = true
    content.active = true
    content.clipLeft = content.left
    content.clipTop = content.top
    content.clipRight = content.left + f32(content.width)
    content.clipBottom = content.top + f32(content.height)
    layoutIn(ref window, ref parts, 0, content)
    window.dialogStart = window.order.len()
    i64 card = partNumber(ref parts, window.dialog)
    if (card >= 0) {
        layoutDialog(ref window, ref parts, card, content)
    }
    if (window.dialogFresh) {  // the focus to the first component of the dialog that takes it
        window.dialogFresh = false
        i64 first = 0
        for (i64 k = window.dialogStart; k < window.order.len() && first == 0; k++) {
            if (focusable(ref parts[window.order[k]])) {
                first = parts[window.order[k]].id
            }
        }
        focusTo(ref window, ref parts, first)
    }
    if (window.dialogEnded) {  // and back where it was
        window.dialogEnded = false
        window.popup = 0
        focusTo(ref window, ref parts, partNumber(ref parts, window.dialogFocus) >= 0 ? window.dialogFocus : 0)
    }
    i64 open = partNumber(ref parts, window.popup)
    if (open < 0 || !parts[open].shown || !parts[open].active) {
        window.popup = 0
    }
}

// A dialog at the center of the content, at most as large as the content less 32
// pixels, its buttons in a row at the bottom right, each as wide as its text and
// 32 pixels, at least 72, the last indigo (P48).
void layoutDialog(ref WindowData window, ref list<PartData> parts, i64 card, Frame content) {
    placeDialog(ref parts[card], content)
    window.order.add(card)
    list<i64> buttons
    for (i64 i = 0; i < parts.len(); i++) {
        if (parts[i].parent == parts[card].id && parts[i].action != 0) {
            buttons.add(i)
        }
    }
    f32 right = f32(parts[card].width) - 16
    for (i64 k = buttons.len() - 1; k >= 0; k--) {
        i64 b = buttons[k]
        f32 w = most(72, textWidth(window.strong, parts[b].text, parts[b].text.len()) + 32)
        right = right - w
        parts[b].x = i32(right)
        parts[b].y = parts[card].height - i32(16 + dialogButton)
        parts[b].width = i32(w)
        parts[b].height = i32(dialogButton)
        parts[b].action = k == buttons.len() - 1 ? 1 : 2
        right = right - 8
    }
    Frame inner
    inner.left = parts[card].left
    inner.top = parts[card].top
    inner.width = parts[card].width
    inner.height = parts[card].height
    inner.shown = true
    inner.active = true
    inner.clipLeft = most(content.clipLeft, inner.left)
    inner.clipTop = most(content.clipTop, inner.top)
    inner.clipRight = least(content.clipRight, inner.left + f32(inner.width))
    inner.clipBottom = least(content.clipBottom, inner.top + f32(inner.height))
    layoutIn(ref window, ref parts, parts[card].id, inner)
}

void placeDialog(ref PartData dialog, Frame content) {
    i32 width = dialog.baseWidth < content.width - 32 ? dialog.baseWidth : content.width - 32
    i32 height = dialog.baseHeight < content.height - 32 ? dialog.baseHeight : content.height - 32
    dialog.width = width > 0 ? width : 0
    dialog.height = height > 0 ? height : 0
    dialog.x = (content.width - dialog.width) / 2
    dialog.y = (content.height - dialog.height) / 2
    dialog.left = content.left + f32(dialog.x)
    dialog.top = content.top + f32(dialog.y)
    dialog.shown = true
    dialog.active = true
    dialog.clipLeft = content.clipLeft
    dialog.clipTop = content.clipTop
    dialog.clipRight = content.clipRight
    dialog.clipBottom = content.clipBottom
}

// The first component of order that the mouse and the keys reach: those of the
// dialog when one is open (D467).
i64 firstReached(ref WindowData window) {
    ret window.dialog != 0 ? window.dialogStart : 0
}

void layoutIn(ref WindowData window, ref list<PartData> parts, i64 group, Frame frame) {
    for (i64 i = 0; i < parts.len(); i++) {
        if (parts[i].window != window.id || parts[i].parent != group || parts[i].kind == kindDialog) {
            continue  // a dialog comes after the rest
        }
        bool hidden = false
        if (parts[i].action != 0) {
            // placed by layoutDialog
        } else if (parts[i].page >= 0) {
            placePage(ref parts[i], ref window)
            i64 bar = partNumber(ref parts, parts[i].bar)
            hidden = bar < 0 || parts[bar].selected != parts[i].page || !parts[bar].visible
        } else {
            arrange(ref parts[i], frame.width, frame.height)
        }
        parts[i].left = frame.left + f32(parts[i].x)
        parts[i].top = frame.top + f32(parts[i].y)
        if (parts[i].vertical != Vertical.Top) {  // it follows the height seen, and stays (P46)
            parts[i].top = parts[i].top + frame.scrolled
        }
        parts[i].shown = frame.shown && parts[i].visible && !hidden
        parts[i].active = frame.active && parts[i].enabled
        parts[i].clipLeft = frame.clipLeft
        parts[i].clipTop = frame.clipTop
        parts[i].clipRight = frame.clipRight
        parts[i].clipBottom = frame.clipBottom
        window.order.add(i)
        if (parts[i].kind == kindListView) {
            parts[i].content = f32(parts[i].items.len()) * rowHeight
            clampScroll(ref parts[i])
        }
        if (parts[i].kind == kindGroup || parts[i].kind == kindPanel) {
            Frame inner
            inner.left = parts[i].left
            inner.top = parts[i].top
            if (parts[i].kind == kindPanel) {  // D460
                parts[i].content = contentOf(ref parts, window.id, parts[i].id, parts[i].width, parts[i].height)
                clampScroll(ref parts[i])
                inner.top = parts[i].top - parts[i].offsetY
                inner.scrolled = parts[i].offsetY
            }
            inner.width = parts[i].width
            inner.height = parts[i].height
            inner.shown = parts[i].shown
            inner.active = parts[i].active
            inner.clipLeft = most(frame.clipLeft, parts[i].left)
            inner.clipTop = most(frame.clipTop, parts[i].top)
            inner.clipRight = least(frame.clipRight, parts[i].left + f32(parts[i].width))
            inner.clipBottom = least(frame.clipBottom, parts[i].top + f32(parts[i].height))
            layoutIn(ref window, ref parts, parts[i].id, inner)
        }
    }
}

// The height of what a panel has: its components visible anchored at the top,
// arranged for its size, and 16 pixels under the lowest when it ends below the
// panel (P46). The others follow the height seen.
f32 contentOf(ref list<PartData> parts, i64 window, i64 panel, i32 width, i32 height) {
    f32 bottom = 0
    for (i64 i = 0; i < parts.len(); i++) {
        if (parts[i].window == window && parts[i].parent == panel && parts[i].visible && parts[i].vertical == Vertical.Top) {
            arrange(ref parts[i], width, height)
            bottom = most(bottom, f32(parts[i].y + parts[i].height))
        }
    }
    ret bottom > f32(height) ? bottom + 16 : bottom
}

// A panel or a list is scrolled from 0 to its content less its height.
void clampScroll(ref PartData part) {
    f32 most = part.content - f32(part.height)
    if (part.offsetY > most) {
        part.offsetY = most
        part.velocity = 0
    }
    if (part.offsetY < 0) {
        part.offsetY = 0
        part.velocity = 0
    }
}

// Scrolls a panel or a list, and shows its bar for a while.
void scrollBy(ref PartData part, f32 delta) {
    f32 before = part.offsetY
    part.offsetY = part.offsetY + delta
    clampScroll(ref part)
    if (part.offsetY != before) {
        part.scrollShown = SDL_GetTicksNS()
    }
}

bool scrolls(ref PartData part) {
    ret (part.kind == kindPanel || part.kind == kindListView) && part.content > f32(part.height)
}

// The position and the size of a component, for the size of its parent now.
void arrange(ref PartData part, i32 width, i32 height) {
    i32 dw = width - part.parentWidth
    i32 dh = height - part.parentHeight
    part.x = part.baseX
    part.y = part.baseY
    part.width = part.baseWidth
    part.height = part.baseHeight
    if (part.horizontal == Horizontal.Right) {
        part.x = part.baseX + dw
    } else if (part.horizontal == Horizontal.Stretch) {
        part.width = part.baseWidth + dw > 0 ? part.baseWidth + dw : 0
    } else if (part.horizontal == Horizontal.Center) {
        part.x = part.baseX + dw / 2
    }
    if (part.vertical == Vertical.Bottom) {
        part.y = part.baseY + dh
    } else if (part.vertical == Vertical.Stretch) {
        part.height = part.baseHeight + dh > 0 ? part.baseHeight + dh : 0
    } else if (part.vertical == Vertical.Center) {
        part.y = part.baseY + dh / 2
    }
}

// ---- The drawing ----

void draw() {
    withData([](ref Shared data) {
        for (ref WindowData window in data.windows) {
            addr none
            if (window.window != none && !window.closing) {
                drawWindow(ref window, ref data.parts)
            }
        }
    })
}

// The content with its components, the title bar with its title and its buttons,
// and a line at the edges when the window is not maximized (D431).
void drawWindow(ref WindowData window, ref list<PartData> parts) {
    i32 w = 0
    i32 h = 0
    SDL_GetWindowSize(window.window, ref w, ref h)
    f32 scale = toWindow(ref window)
    f32 width = f32(w) / scale
    f32 height = f32(h) / scale
    if (window.phone) {
        readSafeArea(ref window)
    } else {
        cromo_gui_chrome_size(window.chrome, barHeight * scale, 3 * buttonWidth * scale, edgeWidth * scale, window.resizable)
    }
    window.maximized = (SDL_GetWindowFlags(window.window) & 0x80) != 0
    bool dark = window.theme == Theme.Dark || (window.theme == Theme.System && SDL_GetSystemTheme() == 2)
    Colors c = colorsOf(dark)
    addr r = window.renderer
    fill(r, c.content, 0, 0, width, height)
    if (window.phone) {  // the bars of the system of the color of the bars of the app (D456)
        fill(r, c.bar, 0, 0, width, window.originY)
        fill(r, c.bar, 0, height - window.insetBottom, width, window.insetBottom)
        if (window.systemBars != (dark ? 1 : 0)) {
            window.systemBars = dark ? 1 : 0
            cromo_gui_system_bars(c.bar, !dark)
        }
    }

    glide(ref window, ref parts)
    layout(ref window, ref parts)
    drawParts(ref window, ref parts, ref c, 0, window.dialogStart)
    if (window.dialog != 0) {  // the rest darkened under the dialog (D467)
        clipTo(r, window.originX, window.originY, f32(contentWidth(window)), f32(contentHeight(window)))
        shade(r, dark ? 153 : 102, window.originX, window.originY, f32(contentWidth(window)), f32(contentHeight(window)))
        drawParts(ref window, ref parts, ref c, window.dialogStart, window.order.len())
    }
    i64 open = partNumber(ref parts, window.popup)
    if (open >= 0) {
        clipTo(r, window.originX, window.originY, f32(contentWidth(window)), f32(contentHeight(window)))
        drawList(ref window, ref parts[open], ref c)
    }
    if (snackVisible(ref window)) {
        clipTo(r, window.originX, window.originY, f32(contentWidth(window)), f32(contentHeight(window)))
        drawSnackbar(ref window)
    }
    addr none
    SDL_SetRenderClipRect(r, none)
    if (!window.phone) {
        drawTitleBar(ref window, ref c, width, height)
    }
    SDL_RenderPresent(r)
}

// The components from first to end, excluded, in order, then the bars of those that
// scroll, over them.
void drawParts(ref WindowData window, ref list<PartData> parts, ref Colors c, i64 first, i64 end) {
    addr r = window.renderer
    for (i64 k = first; k < end; k++) {
        i64 i = window.order[k]
        if (parts[i].shown && parts[i].clipRight > parts[i].clipLeft && parts[i].clipBottom > parts[i].clipTop) {
            clipPart(r, ref parts[i])
            drawPart(ref window, ref parts[i], ref c)
        }
    }
    u64 now = SDL_GetTicksNS()
    for (i64 k = first; k < end; k++) {
        i64 i = window.order[k]
        bool seen = now - parts[i].scrollShown < 1000000000 || window.scrolling == parts[i].id ||
            !window.phone && inside(ref parts[i], window.pointerX, window.pointerY)
        if (parts[i].shown && scrolls(ref parts[i]) && seen) {
            clipPart(r, ref parts[i])
            drawScrollBar(ref window, ref parts[i], ref c)
        }
    }
}

// Black with an alpha over a rectangle.
void shade(addr renderer, u8 alpha, f32 x, f32 y, f32 w, f32 h) {
    SDL_SetRenderDrawBlendMode(renderer, 1)  // SDL_BLENDMODE_BLEND
    SDL_SetRenderDrawColor(renderer, 0, 0, 0, alpha)
    Rect area = Rect(x, y, w, h)
    SDL_RenderFillRect(renderer, ref area)
}

// The snackbar (D468): gray-800, its text white and its action indigo-300, lighter
// under the mouse.
void drawSnackbar(ref WindowData window) {
    addr r = window.renderer
    f32 d = window.density
    Rect box = snackBox(ref window)
    cromo_gui_shadow(r, box.x, box.y, box.w, box.h, 8, d, 0x40000000, 8, 3)
    cromo_gui_box(r, box.x, box.y, box.w, box.h, 8, 0, d, solid(0x1F2937, true), 0)
    f32 ascent = 0
    f32 descent = 0
    f32 gap = 0
    cromo_gui_font_metrics(window.body, ref ascent, ref descent, ref gap)
    f32 baseline = box.y + box.h / 2 + (ascent - descent) / 2
    f32 right = box.x + box.w - 16
    if (window.snackAction.len() > 0) {
        f32 size = textWidth(window.strong, window.snackAction, window.snackAction.len())
        right = right - size
        if (window.snackHot) {
            cromo_gui_box(r, right - 8, box.y + 6, size + 16, box.h - 12, 6, 0, d, solid(0x374151, true), 0)
        }
        text(window.strong, window.snackAction, right, baseline, 0xA5B4FC, true)
        right = right - 16
    }
    clipTo(r, box.x + 16, box.y, most(right - box.x - 16, 0), box.h)
    text(window.body, window.snackText, box.x + 16, baseline, 0xFFFFFF, true)
}

// The title bar, its title and its buttons, and a line at the edges when the
// window is not maximized (D431).
void drawTitleBar(ref WindowData window, ref Colors c, f32 width, f32 height) {
    addr r = window.renderer
    fill(r, c.bar, 0, 0, width, barHeight)
    u32 title = window.focused ? c.title : c.inactive
    f32 ascent = 0
    f32 descent = 0
    f32 gap = 0
    cromo_gui_font_metrics(window.font, ref ascent, ref descent, ref gap)
    f32 titleWidth = textWidth(window.font, window.title, window.title.len())
    text(window.font, window.title, (width - titleWidth) / 2, barHeight / 2 + (ascent - descent) / 2, title, true)
    for (i32 b = 0; b < 3; b++) {
        f32 x = width - f32(3 - b) * buttonWidth
        u32 symbol = title
        bool disabled = b == 1 && !window.resizable
        if (b == 2 && window.hovered == 2) {
            fill(r, window.pressed == 2 ? closePressed : closeHover, x, 0, buttonWidth, barHeight)
            symbol = 0xFFFFFF
        } else if (b == window.hovered && !disabled) {
            fill(r, window.pressed == b ? c.pressed : c.hover, x, 0, buttonWidth, barHeight)
        }
        if (disabled) {
            symbol = c.inactive
        }
        i32 kind = b == 2 ? 3 : b == 1 && window.maximized ? 2 : b
        cromo_gui_symbol(r, kind, x + buttonWidth / 2, barHeight / 2, window.density, red(symbol), green(symbol), blue(symbol))
    }
    fill(r, c.separator, 0, barHeight - 1, width, 1)
    if (!window.maximized) {
        SDL_SetRenderDrawColor(r, red(c.border), green(c.border), blue(c.border), 255)
        Rect edge = Rect(0, 0, width, height)
        SDL_RenderRect(r, ref edge)
    }
}

// A component, in the look of D443: a soft shadow under it, buttons and check
// boxes checked in a gradient with a line of light and a border of a deeper
// color, a glow around the text box or the combo box in focus and a ring of 2
// pixels around the other components in focus, the groups as cards.
void drawPart(ref WindowData window, ref PartData part, ref Colors c) {
    addr r = window.renderer
    f32 d = window.density
    f32 x = part.left
    f32 y = part.top
    f32 w = f32(part.width)
    f32 h = f32(part.height)
    bool focused = window.focus == part.id && window.focused
    bool ring = focused && window.keyboard  // after a key, as :focus-visible of the browsers (P48)
    bool on = part.active
    f32 ascent = 0
    f32 descent = 0
    f32 gap = 0
    cromo_gui_font_metrics(window.body, ref ascent, ref descent, ref gap)
    f32 baseline = y + h / 2 + (ascent - descent) / 2
    if (part.kind == kindLabel) {
        text(window.body, part.text, x, baseline, c.label, on)
    } else if (part.kind == kindButton && part.action == 2) {  // of a dialog, not the last
        bool hot = window.hot == part.id && on
        cromo_gui_shadow(r, x, y, w, h, corner, d, c.inputShadow, 2, 1)
        cromo_gui_box(r, x, y, w, h, corner, 1, d, solid(hot ? c.hover : c.input, on), solid(c.inputBorder, on))
        f32 size = textWidth(window.strong, part.text, part.text.len())
        text(window.strong, part.text, x + (w - size) / 2, baseline, c.text, on)
        if (ring) {
            cromo_gui_box(r, x - 3, y - 3, w + 6, h + 6, corner + 3, 2, d, 0, solid(c.focus, true))
        }
    } else if (part.kind == kindSwitch) {
        drawSwitch(ref window, ref part, ref c, ring, baseline)
    } else if (part.kind == kindSlider) {
        drawSlider(ref window, ref part, ref c, ring)
    } else if (part.kind == kindDialog) {
        cromo_gui_shadow(r, x, y, w, h, dialogCorner, d, 0x30000000, 10, 4)
        cromo_gui_box(r, x, y, w, h, dialogCorner, 1, d, solid(c.card, true), solid(c.cardBorder, true))
        f32 high = 0
        f32 low = 0
        f32 space = 0
        cromo_gui_font_metrics(window.heading, ref high, ref low, ref space)
        clipInside(r, ref part, x + dialogPadding, y, w - 2 * dialogPadding, dialogTop)
        text(window.heading, part.text, x + dialogPadding, y + dialogPadding + high, c.text, true)
        clipPart(r, ref part)
    } else if (part.kind == kindButton) {
        bool hot = window.hot == part.id && on
        bool down = window.held == part.id && hot
        u32 top = hot ? c.hoverTop : c.buttonTop
        u32 bottom = hot ? c.hoverBottom : c.buttonBottom
        if (down) {
            top = c.buttonBottom
            bottom = c.buttonBottom
        }
        if (on) {
            cromo_gui_shadow(r, x, y, w, h, corner, d, c.shadow, 3, 1.5)
        }
        cromo_gui_gradient(r, x, y, w, h, corner, 1, d, solid(top, on), solid(bottom, on), solid(c.buttonLine, on),
            down || !on ? 0 : c.highlight)
        f32 size = textWidth(window.strong, part.text, part.text.len())
        if (part.icon != Icon.None) {
            f32 space = part.text.len() > 0 ? 6 : 0
            f32 start = x + (w - buttonIcon - space - size) / 2
            drawIcon(r, part.icon, start + buttonIcon / 2, y + h / 2, buttonIcon, d, c.buttonText, on)
            text(window.strong, part.text, start + buttonIcon + space, baseline, c.buttonText, on)
        } else {
            text(window.strong, part.text, x + (w - size) / 2, baseline, c.buttonText, on)
        }
        if (ring) {
            cromo_gui_box(r, x - 3, y - 3, w + 6, h + 6, corner + 3, 2, d, 0, solid(c.focus, true))
        }
    } else if (part.kind == kindTextBox) {
        drawField(ref window, ref part, ref c, focused)
        f32 inner = w - 2 * padding
        f32 caretX = textWidth(window.body, part.text, part.caret)
        f32 total = textWidth(window.body, part.text, part.text.len())
        if (caretX - part.scroll > inner) {
            part.scroll = caretX - inner
        }
        if (caretX < part.scroll) {
            part.scroll = caretX
        }
        if (part.scroll > 0 && total - part.scroll < inner) {
            part.scroll = total > inner ? total - inner : 0
        }
        f32 left = x + padding - part.scroll
        clipInside(r, ref part, x + 2, y + 2, w - 4, h - 4)
        if (part.caret != part.anchor) {
            i64 low = part.caret < part.anchor ? part.caret : part.anchor
            i64 high = part.caret < part.anchor ? part.anchor : part.caret
            f32 from = textWidth(window.body, part.text, low)
            f32 to = textWidth(window.body, part.text, high)
            fill(r, c.selection, left + from, baseline - ascent - 1, to - from, ascent + descent + 2)
        }
        if (part.text.len() == 0) {
            text(window.body, part.placeholder, x + padding, baseline, c.muted, on)
        } else {
            text(window.body, part.text, left, baseline, c.text, on)
        }
        bool blink = ((SDL_GetTicksNS() - window.caretStart) / 500000000) % 2 == 0
        if (focused && blink) {
            fill(r, c.focus, left + caretX, baseline - ascent, 1, ascent + descent)
        }
        clipPart(r, ref part)
    } else if (part.kind == kindCheckBox) {
        f32 top = y + (h - checkSide) / 2
        if (on) {
            cromo_gui_shadow(r, x, top, checkSide, checkSide, checkCorner, d, c.inputShadow, 2, 1)
        }
        if (part.checked) {
            cromo_gui_gradient(r, x, top, checkSide, checkSide, checkCorner, 1, d, solid(c.buttonTop, on), solid(c.buttonBottom, on),
                solid(c.buttonLine, on), on ? c.highlight : 0)
            cromo_gui_symbol(r, 4, x + checkSide / 2, top + checkSide / 2, d, red(c.buttonText), green(c.buttonText),
                blue(c.buttonText))
        } else {
            cromo_gui_box(r, x, top, checkSide, checkSide, checkCorner, 1, d, solid(c.check, on), solid(c.checkBorder, on))
        }
        if (ring) {
            cromo_gui_box(r, x - 3, top - 3, checkSide + 6, checkSide + 6, checkCorner + 3, 2, d, 0, solid(c.focus, true))
        }
        text(window.body, part.text, x + checkSide + 8, baseline, c.text, on)
    } else if (part.kind == kindGroup) {
        cromo_gui_shadow(r, x, y, w, h, groupCorner, d, c.inputShadow, 2, 1)
        cromo_gui_box(r, x, y, w, h, groupCorner, 1, d, solid(c.card, true), solid(c.cardBorder, true))
        clipInside(r, ref part, x + 1, y + 1, w - 2, h - 2)
        text(window.strong, part.text, x + 12, y + 17 + (ascent - descent) / 2, c.text, on)
        clipPart(r, ref part)
    } else if (part.kind == kindComboBox) {
        drawField(ref window, ref part, ref c, focused || window.popup == part.id)
        clipInside(r, ref part, x + 2, y + 2, w - 28, h - 4)
        if (part.selected >= 0 && part.selected < part.items.len()) {
            text(window.body, part.items[part.selected], x + padding, baseline, c.text, on)
        } else {
            text(window.body, part.placeholder, x + padding, baseline, c.muted, on)
        }
        clipPart(r, ref part)
        u32 arrow = on ? c.label : c.muted
        cromo_gui_symbol(r, 5, x + w - 14, y + h / 2, d, red(arrow), green(arrow), blue(arrow))
    } else if (part.kind == kindImageBox) {
        drawImage(ref window, ref part)
    } else if (part.kind == kindIconBox) {
        drawIcon(r, part.icon, x + w / 2, y + h / 2, least(w, h), d, c.label, on)
    } else if (part.kind == kindListView) {
        drawListView(ref window, ref part, ref c)
    } else if (part.kind == kindAppBar) {
        drawAppBar(ref window, ref part, ref c)
    } else if (part.kind == kindNavigation) {
        drawNavigation(ref window, ref part, ref c)
    }
}

// A switch: its text on the left, and at the right edge a track indigo when it is
// on, gray when it is off, with a white knob that slides in 150 ms.
void drawSwitch(ref WindowData window, ref PartData part, ref Colors c, bool focused, f32 baseline) {
    addr r = window.renderer
    f32 d = window.density
    bool on = part.active
    f32 x = part.left + f32(part.width) - switchWidth
    f32 y = part.top + (f32(part.height) - switchHeight) / 2
    f32 moved = f32(SDL_GetTicksNS() - part.flipped) / 150000000
    moved = moved > 1 ? 1 : moved
    f32 at = part.checked ? moved : 1 - moved
    if (part.flipped == 0) {
        at = part.checked ? 1 : 0
    }
    u32 track = part.checked ? c.buttonBottom : c.checkBorder
    cromo_gui_box(r, x, y, switchWidth, switchHeight, switchHeight / 2, 0, d, solid(track, on), 0)
    f32 kx = x + 2 + (switchWidth - knob - 4) * at
    f32 ky = y + (switchHeight - knob) / 2
    if (on) {
        cromo_gui_shadow(r, kx, ky, knob, knob, knob / 2, d, c.shadow, 2, 1)
    }
    cromo_gui_box(r, kx, ky, knob, knob, knob / 2, 0, d, solid(0xFFFFFF, on), 0)
    if (focused) {
        cromo_gui_box(r, x - 3, y - 3, switchWidth + 6, switchHeight + 6, switchHeight / 2 + 3, 2, d, 0, solid(c.focus, true))
    }
    clipInside(r, ref part, part.left, part.top, most(f32(part.width) - switchWidth - 8, 0), f32(part.height))
    text(window.body, part.text, part.left, baseline, c.text, on)
    clipPart(r, ref part)
}

// A slider: its track, indigo up to the knob, and a white knob with an indigo
// border.
void drawSlider(ref WindowData window, ref PartData part, ref Colors c, bool focused) {
    addr r = window.renderer
    f32 d = window.density
    bool on = part.active
    f32 middle = part.top + f32(part.height) / 2
    f32 from = part.left + knob / 2
    f32 to = part.left + f32(part.width) - knob / 2
    f32 at = knobAt(ref part)
    cromo_gui_box(r, from - 2, middle - 2, to - from + 4, 4, 2, 0, d, solid(c.checkBorder, on), 0)
    cromo_gui_box(r, from - 2, middle - 2, at - from + 4, 4, 2, 0, d, solid(c.buttonBottom, on), 0)
    if (on) {
        cromo_gui_shadow(r, at - knob / 2, middle - knob / 2, knob, knob, knob / 2, d, c.shadow, 3, 1)
    }
    bool held = window.held == part.id
    cromo_gui_box(r, at - knob / 2, middle - knob / 2, knob, knob, knob / 2, held ? 3 : 2, d, solid(0xFFFFFF, on),
        solid(c.buttonBottom, on))
    if (focused) {
        cromo_gui_box(r, at - knob / 2 - 4, middle - knob / 2 - 4, knob + 8, knob + 8, knob / 2 + 4, 2, d, 0, solid(c.focus, true))
    }
}

// The thin bar on the right of a panel or of a list that scrolls, while it moves and
// while the mouse is over it, wider while it is dragged.
void drawScrollBar(ref WindowData window, ref PartData part, ref Colors c) {
    f32 h = f32(part.height)
    f32 thumb = most(24, h * h / part.content)
    f32 at = part.top + (h - thumb) * part.offsetY / (part.content - h)
    bool held = window.scrolling == part.id && window.scrollBar
    f32 w = held ? 6 : 4
    cromo_gui_box(window.renderer, part.left + f32(part.width) - w - 3, at + 2, w, thumb - 4, w / 2, 0, window.density,
        solid(c.checkBorder, true), 0)
}

// A list: its rows that are seen, each with its icon, its title and the line under
// it, its text on the right, and a line under the row; the item chosen on the color
// of the pills, with a bar of the accent when the list has the keyboard.
void drawListView(ref WindowData window, ref PartData view, ref Colors c) {
    addr r = window.renderer
    f32 d = window.density
    f32 x = view.left
    f32 w = f32(view.width)
    bool on = view.active
    bool focused = window.focus == view.id && window.focused && window.keyboard
    f32 ascent = 0
    f32 descent = 0
    f32 gap = 0
    cromo_gui_font_metrics(window.body, ref ascent, ref descent, ref gap)
    f32 middle = (ascent - descent) / 2
    f32 bottom = view.top + f32(view.height)
    for (addr texture in view.dropped) {
        SDL_DestroyTexture(texture)
    }
    view.dropped.clear()
    clipInside(r, ref view, x, view.top, w, f32(view.height))
    for (i64 row = i64(view.offsetY / rowHeight); row < view.items.len(); row++) {
        f32 top = view.top + f32(row) * rowHeight - view.offsetY
        if (top >= bottom) {
            break
        }
        if (row == view.selected) {
            fill(r, c.item, x, top, w, rowHeight)
            if (focused) {
                fill(r, c.focus, x, top, 3, rowHeight)
            }
        } else if (window.hot == view.id && window.hotItem == row && on) {
            fill(r, c.hover, x, top, w, rowHeight)
        }
        f32 left = x + 16
        addr none
        if (view.images[row] != none) {  // D469
            if (view.textures[row] == none) {
                view.textures[row] = SDL_CreateTexture(r, 0x16762004, 0, avatarPixels, avatarPixels)  // RGBA32, static
                if (view.textures[row] != none) {
                    SDL_SetTextureBlendMode(view.textures[row], 1)
                    SDL_UpdateTexture(view.textures[row], none, view.images[row], avatarPixels * 4)
                }
            }
            if (view.textures[row] != none) {
                Rect place = Rect(x + 16, top + (rowHeight - avatarSize) / 2, avatarSize, avatarSize)
                SDL_RenderTexture(r, view.textures[row], none, ref place)
            }
            left = x + 72
        } else if (view.icons[row] != Icon.None) {
            drawIcon(r, view.icons[row], x + 28, top + rowHeight / 2, 24, d, c.label, on)
            left = x + 56
        }
        f32 right = x + w - 16
        bool two = view.subtitles[row].len() > 0
        f32 titleLine = two ? top + 20 + middle : top + rowHeight / 2 + middle
        if (view.details[row].len() > 0) {
            f32 size = textWidth(window.body, view.details[row], view.details[row].len())
            text(window.body, view.details[row], right - size, titleLine, c.muted, on)
            right = right - size - 12
        }
        f32 seen = most(top, view.top)
        clipInside(r, ref view, left, seen, right - left, least(top + rowHeight, bottom) - seen)
        text(window.body, view.items[row], left, titleLine, c.text, on)
        if (two) {
            text(window.body, view.subtitles[row], left, top + 40 + middle, c.muted, on)
        }
        clipInside(r, ref view, x, view.top, w, f32(view.height))
        if (row + 1 < view.items.len()) {
            fill(r, c.separator, left, top + rowHeight - 1, x + w - left, 1)
        }
    }
}

// The round background of an icon of a bar under the mouse, or pressed.
void drawHover(ref WindowData window, ref PartData bar, ref Colors c, i64 item, f32 x, f32 y, f32 w, f32 h, f32 radius) {
    if (window.hot == bar.id && window.hotItem == item && bar.active) {
        u32 back = window.held == bar.id && window.heldItem == item ? c.pressed : c.hover
        cromo_gui_box(window.renderer, x, y, w, h, radius, 0, window.density, solid(back, true), 0)
    }
}

// An app bar: its background, a line under it, the icon on the left, the title
// semibold, and the actions from the right edge.
void drawAppBar(ref WindowData window, ref PartData bar, ref Colors c) {
    addr r = window.renderer
    f32 d = window.density
    f32 x = bar.left
    f32 y = bar.top
    f32 w = f32(bar.width)
    f32 h = f32(bar.height)
    bool on = bar.active
    fill(r, c.bar, x, y, w, h)
    fill(r, c.separator, x, y + h - 1, w, 1)
    f32 middle = y + h / 2
    f32 left = x + 16
    if (bar.icon != Icon.None) {
        drawHover(ref window, ref bar, ref c, 0, x + 8, middle - 20, 40, 40, 20)
        drawIcon(r, bar.icon, x + 28, middle, 24, d, c.title, on)
        left = x + 60
    }
    f32 ascent = 0
    f32 descent = 0
    f32 gap = 0
    cromo_gui_font_metrics(window.heading, ref ascent, ref descent, ref gap)
    f32 right = x + w - 8 - 44 * f32(bar.icons.len())
    clipInside(r, ref bar, left, y, right - left, h)
    text(window.heading, bar.text, left, middle + (ascent - descent) / 2, c.text, on)
    clipPart(r, ref bar)
    for (i64 k = 0; k < bar.icons.len(); k++) {
        f32 center = x + w - 28 - 44 * f32(k)
        drawHover(ref window, ref bar, ref c, k + 1, center - 20, middle - 20, 40, 40, 20)
        drawIcon(r, bar.icons[k], center, middle, 24, d, c.title, on)
    }
}

// A navigation bar: its background, a line over it, and its items, the one chosen
// with a pill behind its icon and in the color of the accent, as in Material 3.
void drawNavigation(ref WindowData window, ref PartData bar, ref Colors c) {
    addr r = window.renderer
    f32 d = window.density
    f32 x = bar.left
    f32 y = bar.top
    f32 w = f32(bar.width)
    f32 h = f32(bar.height)
    bool on = bar.active
    fill(r, c.bar, x, y, w, h)
    fill(r, c.separator, x, y, w, 1)
    i64 n = bar.items.len()
    for (i64 k = 0; k < n; k++) {
        f32 center = x + w * (f32(k) + 0.5) / f32(n)
        bool chosen = k == bar.selected
        if (chosen) {
            cromo_gui_box(r, center - 28, y + 8, 56, 28, 14, 0, d, solid(c.item, on), 0)
        } else {
            drawHover(ref window, ref bar, ref c, k, center - 28, y + 8, 56, 28, 14)
        }
        u32 color = chosen ? c.accent : c.label
        drawIcon(r, bar.icons[k], center, y + 22, 22, d, color, on)
        f32 size = textWidth(window.caption, bar.items[k], bar.items[k].len())
        text(window.caption, bar.items[k], center - size / 2, y + 53, color, on)
    }
}

// An icon of Lucide whose square of `size` logical pixels has its center at x, y.
void drawIcon(addr renderer, Icon which, f32 x, f32 y, f32 size, f32 density, u32 rgb, bool enabled) {
    if (which != Icon.None && size > 0) {
        cromo_gui_icon(renderer, i32(which), x, y, size, density, red(rgb), green(rgb), blue(rgb), enabled ? 255 : 128)
    }
}

// The box of a text box or of a combo box: in focus, with a border of indigo and a
// glow around it.
void drawField(ref WindowData window, ref PartData part, ref Colors c, bool lit) {
    addr r = window.renderer
    f32 d = window.density
    f32 x = part.left
    f32 y = part.top
    f32 w = f32(part.width)
    f32 h = f32(part.height)
    bool on = part.active
    if (lit) {
        cromo_gui_shadow(r, x, y, w, h, corner, d, c.glow, 4, 0)
    } else if (on) {
        cromo_gui_shadow(r, x, y, w, h, corner, d, c.inputShadow, 2, 1)
    }
    cromo_gui_box(r, x, y, w, h, corner, lit ? 2 : 1, d, solid(c.input, on), solid(lit ? c.focus : c.inputBorder, on))
}

// The list of an open combo box, over the other components: the item pointed at
// on a light background, the one chosen semibold with a mark, and a bar on the
// right when it scrolls.
void drawList(ref WindowData window, ref PartData box, ref Colors c) {
    addr r = window.renderer
    f32 d = window.density
    Rect area = listOf(ref window, ref box)
    f32 x = area.x
    f32 y = area.y
    cromo_gui_shadow(r, x, y, area.w, area.h, corner, d, c.listShadow, 8, 4)
    cromo_gui_box(r, x, y, area.w, area.h, corner, 1, d, solid(c.input, true), solid(c.inputBorder, true))
    f32 ascent = 0
    f32 descent = 0
    f32 gap = 0
    cromo_gui_font_metrics(window.body, ref ascent, ref descent, ref gap)
    i64 rows = rowsOf(ref window, ref box)
    bool scrolls = box.items.len() > rows
    for (i64 row = 0; row < rows; row++) {
        i64 item = box.first + row
        f32 top = y + 3 + f32(row) * itemHeight
        clipTo(r, x + 1, y + 1, area.w - 2, area.h - 2)
        if (item == box.highlight) {
            cromo_gui_box(r, x + 3, top, area.w - (scrolls ? 14 : 6), itemHeight, 5, 0, d, solid(c.item, true), 0)
        }
        bool chosen = item == box.selected
        clipTo(r, x + 1, y + 1, area.w - 30, area.h - 2)
        text(chosen ? window.strong : window.body, box.items[item], x + padding, top + itemHeight / 2 + (ascent - descent) / 2, c.text,
            true)
        if (chosen) {
            clipTo(r, x + 1, y + 1, area.w - 2, area.h - 2)
            cromo_gui_symbol(r, 4, x + area.w - (scrolls ? 26 : 18), top + itemHeight / 2, d, red(c.focus), green(c.focus),
                blue(c.focus))
        }
    }
    if (scrolls) {
        f32 track = area.h - 6
        f32 thumb = track * f32(rows) / f32(box.items.len())
        f32 at = y + 3 + (track - thumb) * f32(box.first) / f32(box.items.len() - rows)
        clipTo(r, x + 1, y + 1, area.w - 2, area.h - 2)
        cromo_gui_box(r, x + area.w - 7, at, 4, thumb, 2, 0, d, solid(c.checkBorder, true), 0)
    }
}

// An image: its texture is made from its pixels the first time it is drawn after
// it is set; the pixels stay, for when the renderer loses its textures.
void drawImage(ref WindowData window, ref PartData part) {
    addr r = window.renderer
    addr none
    if (part.imageChanged) {
        if (part.texture != none) {
            SDL_DestroyTexture(part.texture)
            part.texture = none
        }
        if (part.pixels != none) {
            part.texture = SDL_CreateTexture(r, 0x16762004, 0, part.imageWidth, part.imageHeight)  // RGBA32, static
            if (part.texture != none) {
                SDL_SetTextureBlendMode(part.texture, 1)
                SDL_UpdateTexture(part.texture, none, part.pixels, part.imageWidth * 4)
            }
        }
        part.imageChanged = false
    }
    if (part.texture == none) {
        ret
    }
    f32 x = part.left
    f32 y = part.top
    f32 w = f32(part.width)
    f32 h = f32(part.height)
    f32 iw = f32(part.imageWidth)
    f32 ih = f32(part.imageHeight)
    f32 dw = w
    f32 dh = h
    if (part.scale == Scale.Fit) {
        f32 k = least(w / iw, h / ih)
        dw = iw * k
        dh = ih * k
    } else if (part.scale == Scale.Fill) {
        f32 k = most(w / iw, h / ih)
        dw = iw * k
        dh = ih * k
    } else if (part.scale == Scale.Center) {
        dw = iw
        dh = ih
    }
    Rect target = Rect(x + (w - dw) / 2, y + (h - dh) / 2, dw, dh)
    clipInside(r, ref part, x, y, w, h)
    SDL_SetTextureAlphaMod(part.texture, part.active ? 255 : 128)
    SDL_RenderTexture(r, part.texture, none, ref target)
    clipPart(r, ref part)
}
