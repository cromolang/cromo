// ---- The end of the icons ----

// The mouse, in logical pixels from the top left corner of the content, under the
// title bar (D438), and its button: 1 left, 2 middle, 3 right, 0 when it moves.
public struct Mouse {
    public f32 x
    public f32 y
    public i32 button
}

// A key pressed: its code is that of SDL, the character for the letters, the
// digits and the signs, 27 for Esc, 13 for Enter.
public struct Key {
    public i64 code
    public bool shift
    public bool control
    public bool alt
}

// What the components have in common, for Window.add (D434).
public interface Component {
    i64 componentId() const
}

// ---- The components (D434, D439) ----
//
// Each is a handle, with its position and its size in logical pixels from the top
// left corner of the content (D438). Its text and its properties are methods.

// A text.
public struct Label : Component {
    i64 id

    public Label(string text, i32 x, i32 y, i32 width, i32 height) {
        id = newPart(kindLabel, text, x, y, width, height)
    }

    i64 componentId() const {
        ret id
    }

    public void setText(string value) const {
        setPartText(id, value)
    }

    public string text() const {
        ret partText(id, false)
    }

    public void setPosition(i32 x, i32 y) const {
        setPartBounds(id, x, y, -1, -1)
    }

    public void setSize(i32 width, i32 height) const {
        setPartBounds(id, -1, -1, width, height)
    }

    public i32 x() const {
        ret partBound(id, 0)
    }

    public i32 y() const {
        ret partBound(id, 1)
    }

    public i32 width() const {
        ret partBound(id, 2)
    }

    public i32 height() const {
        ret partBound(id, 3)
    }

    public void setVisible(bool value) const {
        setPartFlag(id, 0, value)
    }

    public bool visible() const {
        ret partFlag(id, 0)
    }

    public void setEnabled(bool value) const {
        setPartFlag(id, 1, value)
    }

    public bool enabled() const {
        ret partFlag(id, 1)
    }

    // How it follows the edges of its window or of its group (D447).
    public void setAnchor(Horizontal horizontal, Vertical vertical) const {
        setPartAnchor(id, horizontal, vertical)
    }

    public Horizontal horizontalAnchor() const {
        ret partHorizontal(id)
    }

    public Vertical verticalAnchor() const {
        ret partVertical(id)
    }
}

// A button: a click, Space or Enter with it in focus, calls its handlers of onClick.
public struct Button : Component {
    i64 id

    public Button(string text, i32 x, i32 y, i32 width, i32 height) {
        id = newPart(kindButton, text, x, y, width, height)
    }

    i64 componentId() const {
        ret id
    }

    public void onClick(move func() handler) const {
        addr box = alloc(sizeOf<func()>())
        put<func()>(box, move handler)
        addPartHandler(id, 0, box)
    }

    // An icon before the text, or alone in the middle without text (P41).
    public void setIcon(Icon value) const {
        setPartIcon(id, value)
    }

    public Icon icon() const {
        ret partIcon(id)
    }

    public void setText(string value) const {
        setPartText(id, value)
    }

    public string text() const {
        ret partText(id, false)
    }

    public void setPosition(i32 x, i32 y) const {
        setPartBounds(id, x, y, -1, -1)
    }

    public void setSize(i32 width, i32 height) const {
        setPartBounds(id, -1, -1, width, height)
    }

    public i32 x() const {
        ret partBound(id, 0)
    }

    public i32 y() const {
        ret partBound(id, 1)
    }

    public i32 width() const {
        ret partBound(id, 2)
    }

    public i32 height() const {
        ret partBound(id, 3)
    }

    public void setVisible(bool value) const {
        setPartFlag(id, 0, value)
    }

    public bool visible() const {
        ret partFlag(id, 0)
    }

    public void setEnabled(bool value) const {
        setPartFlag(id, 1, value)
    }

    public bool enabled() const {
        ret partFlag(id, 1)
    }

    // How it follows the edges of its window or of its group (D447).
    public void setAnchor(Horizontal horizontal, Vertical vertical) const {
        setPartAnchor(id, horizontal, vertical)
    }

    public Horizontal horizontalAnchor() const {
        ret partHorizontal(id)
    }

    public Vertical verticalAnchor() const {
        ret partVertical(id)
    }
}

// A line of text that the user writes: the arrows, Home and End move in it, with
// Shift they select, Ctrl+A, Ctrl+C, Ctrl+X and Ctrl+V as in every program. Its
// handlers of onChange receive the text at each change, those of onEnter when
// Enter is pressed.
public struct TextBox : Component {
    i64 id

    public TextBox(string text, i32 x, i32 y, i32 width, i32 height) {
        id = newPart(kindTextBox, text, x, y, width, height)
    }

    i64 componentId() const {
        ret id
    }

    public void onChange(move func(string) handler) const {
        addr box = alloc(sizeOf<func(string)>())
        put<func(string)>(box, move handler)
        addPartHandler(id, 1, box)
    }

    public void onEnter(move func(string) handler) const {
        addr box = alloc(sizeOf<func(string)>())
        put<func(string)>(box, move handler)
        addPartHandler(id, 2, box)
    }

    // The text shown while the box is empty.
    public void setPlaceholder(string value) const {
        i64 me = id
        withData([me, value](ref Shared data) { data.parts[partIndexOf(ref data, me)].placeholder = value })
    }

    public string placeholder() const {
        ret partText(id, true)
    }

    public void setText(string value) const {
        setPartText(id, value)
    }

    public string text() const {
        ret partText(id, false)
    }

    public void setPosition(i32 x, i32 y) const {
        setPartBounds(id, x, y, -1, -1)
    }

    public void setSize(i32 width, i32 height) const {
        setPartBounds(id, -1, -1, width, height)
    }

    public i32 x() const {
        ret partBound(id, 0)
    }

    public i32 y() const {
        ret partBound(id, 1)
    }

    public i32 width() const {
        ret partBound(id, 2)
    }

    public i32 height() const {
        ret partBound(id, 3)
    }

    public void setVisible(bool value) const {
        setPartFlag(id, 0, value)
    }

    public bool visible() const {
        ret partFlag(id, 0)
    }

    public void setEnabled(bool value) const {
        setPartFlag(id, 1, value)
    }

    public bool enabled() const {
        ret partFlag(id, 1)
    }

    // How it follows the edges of its window or of its group (D447).
    public void setAnchor(Horizontal horizontal, Vertical vertical) const {
        setPartAnchor(id, horizontal, vertical)
    }

    public Horizontal horizontalAnchor() const {
        ret partHorizontal(id)
    }

    public Vertical verticalAnchor() const {
        ret partVertical(id)
    }
}

