// Windows and their components, drawn by the program itself: labels, buttons, text
// boxes, check boxes, switches, sliders, combo boxes, images and icons, groups and
// panels that scroll, lists, the bars of an app, dialogs and snackbars. A window looks
// the same on Windows and on Linux, flat and quiet, with an ochre accent, light or dark,
// compact on the desktop; the same program compiled with '--target android' is an app
// for Android, with the sizes for the fingers.
//
// 'Window' makes a window, its 'add' puts a component in it and gives it back, and
// 'start' shows it; when 'main' returns, the program waits until its windows are
// closed. A window and a component are handles: small values that name them, which can
// be copied freely and captured by copy in a lambda.
//
// - Positions and sizes are in logical pixels, which the library scales with the
//   density of the screen, from the top left corner of the content of the window, under
//   its title bar, or of the group, the panel or the dialog that holds the component.
// - The anchors, set with 'setAnchor', say which edges of the window, or of its group, a
//   component follows when they move: a window is written for one size, and the anchors
//   adapt it to the others, also to the screen of a phone.
// - The handlers of the events, as 'onClick', run on the thread of the windows, one at a
//   time, and can change any component. A handler that takes long freezes the windows:
//   long work goes to a task. An exception that leaves a handler stops the program.
// - The methods of the windows and of the components can be called from any thread.
//   When the program changes a component, as with 'setText' or 'setChecked', the
//   handlers are not called: they are for what the user does.
//
// '''
// import std.gui
//
// [[window]]
// i32 main() {
//     gui.Window w = gui.Window("Greetings", 420, 230)
//     w.add(gui.Label("Your name", 24, 24, 200, 20))
//     gui.TextBox name = w.add(gui.TextBox("", 24, 48, 372, 32))
//     gui.Button greet = w.add(gui.Button("Greet", 24, 96, 100, 32))
//     gui.Label answer = w.add(gui.Label("", 24, 148, 372, 20))
//     greet.onClick([name, answer]() { answer.setText(format("Hello, {}!", name.text())) })
//     w.start()
//     ret 0
// }
// '''
//
// The guide: [Windows and apps](https://cromolang.org/book/en/gui.html).

// The module std.gui (D429-D449): windows with their title bar drawn by the
// library, in the style of Visual Studio Code (D431), the themes light, dark and of
// the system (D432), the components Label, Button, TextBox, CheckBox, GroupBox,
// ComboBox, ImageBox and IconBox (D434, D439, D444-D446, D448), anchored to the
// edges of their window or group (D447), the icons of Lucide (D448, D449), and the
// events of the mouse, of the keyboard and of the components, given to lambdas
// (D430). A window and a component are handles (D434, D442): their methods can be
// called from any thread, and change their data under one lock. All the windows
// run on one thread of the GUI, which SDL wants (D436); the handlers of the events
// run there, one at a time (D435). SDL is in lib/ (D429), and the parts in C, the
// hit test, the text and the icons, the symbols, the boxes and the images, are in
// runtime/gui (D441).
import std.fs
import std.time
import unsafe

extern "SDL3" {
    bool SDL_Init(u32 flags)
    addr SDL_GetError()
    addr SDL_CreateWindow(addr title, i32 w, i32 h, u64 flags)
    void SDL_DestroyWindow(addr window)
    u32 SDL_GetWindowID(addr window)
    addr SDL_CreateRenderer(addr window, addr name)
    void SDL_DestroyRenderer(addr renderer)
    bool SDL_PollEvent(addr event)
    bool SDL_ConvertEventToRenderCoordinates(addr renderer, addr event)
    bool SDL_SetRenderDrawColor(addr renderer, u8 r, u8 g, u8 b, u8 a)
    bool SDL_SetRenderDrawBlendMode(addr renderer, u32 mode)
    bool SDL_SetRenderScale(addr renderer, f32 x, f32 y)
    bool SDL_SetRenderClipRect(addr renderer, addr rect)
    bool SDL_RenderClear(addr renderer)
    bool SDL_RenderFillRect(addr renderer, ref Rect rect)
    bool SDL_RenderRect(addr renderer, ref Rect rect)
    bool SDL_RenderPresent(addr renderer)
    bool SDL_GetWindowSize(addr window, ref i32 w, ref i32 h)
    bool SDL_SetWindowSize(addr window, i32 w, i32 h)
    bool SDL_SetWindowTitle(addr window, addr title)
    bool SDL_SetWindowResizable(addr window, bool resizable)
    u64 SDL_GetWindowFlags(addr window)
    bool SDL_MinimizeWindow(addr window)
    bool SDL_MaximizeWindow(addr window)
    bool SDL_RestoreWindow(addr window)
    f32 SDL_GetWindowDisplayScale(addr window)
    f32 SDL_GetWindowPixelDensity(addr window)
    u32 SDL_GetPrimaryDisplay()
    f32 SDL_GetDisplayContentScale(u32 display)
    u32 SDL_GetSystemTheme()
    u64 SDL_GetTicksNS()
    void SDL_DelayPrecise(u64 nanoseconds)
    bool SDL_StartTextInput(addr window)
    bool SDL_StopTextInput(addr window)
    bool SDL_ScreenKeyboardShown(addr window)
    bool SDL_SetClipboardText(addr text)
    addr SDL_GetClipboardText()
    void SDL_free(addr memory)
    addr SDL_GetPlatform()
    bool SDL_SetHint(addr name, addr value)
    u16 SDL_GetModState()
    bool SDL_GetWindowSafeArea(addr window, addr rect)
    addr SDL_CreateSystemCursor(u32 kind)
    bool SDL_SetCursor(addr cursor)
    addr SDL_CreateTexture(addr renderer, u32 format, i32 access, i32 w, i32 h)
    bool SDL_UpdateTexture(addr texture, addr rect, addr pixels, i32 pitch)
    bool SDL_SetTextureBlendMode(addr texture, u32 mode)
    bool SDL_SetTextureAlphaMod(addr texture, u8 alpha)
    bool SDL_RenderTexture(addr renderer, addr texture, addr source, ref Rect target)
    void SDL_DestroyTexture(addr texture)
}

extern "cromo" {
    addr cromo_gui_chrome(addr window)
    void cromo_gui_chrome_size(addr chrome, f32 bar, f32 buttons, f32 edge, bool resizable)
    void cromo_gui_chrome_free(addr chrome)
    addr cromo_gui_font(addr renderer, i32 face, f32 size, f32 density)
    void cromo_gui_font_free(addr font)
    void cromo_gui_font_metrics(addr font, ref f32 ascent, ref f32 descent, ref f32 gap)
    f32 cromo_gui_text_width(addr font, addr text, i64 length)
    void cromo_gui_text(addr font, addr text, i64 length, f32 x, f32 y, u8 r, u8 g, u8 b, u8 alpha)
    void cromo_gui_symbol(addr renderer, i32 kind, f32 x, f32 y, f32 density, u8 r, u8 g, u8 b)
    void cromo_gui_symbols_free(addr renderer)
    void cromo_gui_box(addr renderer, f32 x, f32 y, f32 w, f32 h, f32 radius, f32 border, f32 density, u32 fill, u32 line)
    void cromo_gui_boxes_free(addr renderer)
    void cromo_gui_shadow(addr renderer, f32 x, f32 y, f32 w, f32 h, f32 radius, f32 density, u32 color, f32 blur, f32 dy)
    void cromo_gui_wait_at_end()
    addr cromo_gui_image_decode(addr bytes, i64 size, ref i32 width, ref i32 height, addr reason, i64 room)
    void cromo_gui_image_free(addr pixels)
    addr cromo_gui_image_round(addr pixels, i32 width, i32 height, i32 size)
    bool cromo_gui_svg_size(addr bytes, i64 size, ref f32 width, ref f32 height)
    addr cromo_gui_svg_draw(addr bytes, i64 size, i32 width, i32 height)
    void cromo_gui_icon(addr renderer, i32 code, f32 x, f32 y, f32 size, f32 density, u8 r, u8 g, u8 b, u8 alpha)
    void cromo_gui_icons_free(addr renderer)
    void cromo_gui_system_bars(u32 rgb, bool light)
}

// ---- The public types ----

// The colors of a window and of its components, light or dark, set with
// 'Window.setTheme'. On a phone the bars of the system take the same colors.
public enum Theme {
    System  // that of the system, the default, which changes when the user changes it
    Light   // dark text on light grays
    Dark    // light text on dark grays
}

// The style of a button, set with 'Button.setStyle'.
public enum ButtonStyle {
    Normal   // light, with a thin border: the default
    Primary  // filled with the accent, for the main action of a window or of a group
    Danger   // in the color of danger, for an action that destroys, as Delete
}

// The color of a piece of rich text (D491): a role of the theme, which follows the light
// or the dark one by itself.
public enum Ink {
    Normal     // the text
    Secondary  // the text that matters less
    Faint      // muted, as numbers and remarks on the side
    Accent     // the accent, darker for the text: what must stand out
    Selection  // the blue of the selection, as notes and links
    Danger     // errors and warnings
}

// The line along the left edge of a block of rich text, set with 'RichText.startBlock'.
public enum BlockLine {
    None       // no line: only the margin
    Plain      // gray, as the borders of the components
    Selection  // the soft blue of the selection
    Accent     // the accent
}

// How a component follows the left and the right edges of its parent, the window or
// the group, the panel or the dialog that holds it, when the parent changes width. The
// component keeps the distances that it has when its anchors, its position or its size
// are set: so a window is written for one size, and the anchors adapt it to the others.
//
// '''
// gui.TextBox title = w.add(gui.TextBox("", 16, 16, 448, 32))
// title.setAnchor(gui.Horizontal.Stretch, gui.Vertical.Top)   // as wide as the window
// '''
public enum Horizontal {
    Left     // keeps its distance from the left edge, and its width: the default
    Right    // keeps its distance from the right edge, and its width
    Stretch  // keeps its distances from both edges, and so changes its width
    Center   // keeps its center at the same distance from the center, and its width
}

// How a component follows the top and the bottom edges of its parent when the parent
// changes height, as 'Horizontal' does for the left and the right ones. In a panel that
// scrolls, the components anchored to the top scroll with its content, and the others
// stay where they are on the part that is seen, as a button over a list.
//
// '''
// gui.Button save = w.add(gui.Button("Save", 364, 217, 100, 32))
// save.setAnchor(gui.Horizontal.Right, gui.Vertical.Bottom)   // in the bottom right corner
// '''
public enum Vertical {
    Top      // keeps its distance from the top edge, and its height: the default
    Bottom   // keeps its distance from the bottom edge, and its height
    Stretch  // keeps its distances from both edges, and so changes its height
    Center   // keeps its center at the same distance from the center, and its height
}

// How an image box fits its image, set with 'ImageBox.setScale'. The image is at the
// center of the box, and what goes beyond its edges is cut.
public enum Scale {
    Fit      // the whole image, as large as the box allows, with its proportions: the default
    Fill     // the whole box, covered by the image with its proportions, cut at the edges
    Stretch  // the size of the box, without the proportions of the image
    Center   // the size of the image, a pixel of it for each logical pixel
}

// A color with its opacity, for the drawings of a canvas (D483): 'rgb(0x2F6E8F)' is
// opaque, and 'rgba(0x2F6E8F, 115)' lets what is under it show through.
public struct Color {
    public u8 red
    public u8 green
    public u8 blue
    public u8 alpha  // 255 opaque, 0 transparent
}

// An opaque color from its value 0xRRGGBB, as in CSS: 'gui.rgb(0xB4761C)'.
public Color rgb(u32 value) {
    ret rgba(value, 255)
}

// A color from its value 0xRRGGBB and its opacity, from 0, transparent, to 255,
// opaque: 'gui.rgba(0x2F6E8F, 115)' is about 45% opaque.
public Color rgba(u32 value, u8 alpha) {
    Color c
    c.red = u8((value >> 16) & 0xFF)
    c.green = u8((value >> 8) & 0xFF)
    c.blue = u8(value & 0xFF)
    c.alpha = alpha
    ret c
}

// How a piece of rich text looks (D491): its color, a role of the theme; semibold,
// italic and monospaced; and its size, from that of the text of the view.
//
// '''
// gui.TextStyle note = gui.TextStyle(gui.Ink.Faint)
// note.italic = true
// note.scale = 0.9   // 90% of the text of the view
// '''
public struct TextStyle {
    public Ink ink
    public bool strong    // semibold
    public bool italic    // slanted (D493)
    public bool mono      // JetBrains Mono, whose letters are all equally wide (D492)
    public f32 scale = 1  // the size, from that of the text of the view: more than 0

    // A style in a color, regular, of the size of the text of the view.
    public TextStyle(Ink color) {
        ink = color
    }
}

// An image for the drawings of a canvas: PNG, JPEG, BMP, GIF or SVG, read once from
// its bytes and kept for the whole program. It is a handle, as a component: its
// copies name the same image, and a lambda captures it by copy. An SVG image is drawn
// again at the size where it is shown, sharp at every size and density.
//
// '''
// gui.Image logo = gui.Image(embed("images/logo.svg"))
// gui.Drawing d
// d.image(logo, 16, 16, 64, 64)
// '''
public struct Image {
    i64 id

    // Reads the image from its bytes, as 'embed' and 'fs.readBytes' give them. Bytes that
    // are not an image that can be read throw an Error with the reason.
    public Image(list<u8> bytes) {
        id = newImage(bytes)
    }

    // The width of the image in pixels: that of its file, or the one written in the SVG.
    public f32 width() const {
        ret imageSize(id, true)
    }

    // The height of the image in pixels: that of its file, or the one written in the SVG.
    public f32 height() const {
        ret imageSize(id, false)
    }
}

// ---- The icons (D448, D449), written by tools/lucide.py ----

// An icon of Lucide 1.68.0, drawn with lines in the colors of the component that shows
// it, and sharp at every size. A button shows one with 'setIcon', an icon box alone,
// and the app bar, the navigation bar and the items of a list have theirs. The names
// are those of [Lucide](https://lucide.dev/icons/) with capitals and no hyphens:
// 'message-circle' is 'MessageCircle', 'trash-2' is 'Trash2'. 'None', the default, is
// no icon.
public enum Icon {
    None = 0                     // no icon: the default
    Activity = 0xE038            // a pulse line, as that of a heart monitor
    AlarmClock = 0xE03A          // an alarm clock
    Archive = 0xE041             // a box for archives, with its lid
    ArrowDown = 0xE042           // an arrow that points down
    ArrowLeft = 0xE048           // an arrow that points left, to go back
    ArrowRight = 0xE049          // an arrow that points right
    ArrowUp = 0xE04A             // an arrow that points up
    AtSign = 0xE04E              // the sign @
    Award = 0xE04F               // a rosette with ribbons, for a prize
    Ban = 0xE051                 // a circle crossed by a line, for something forbidden
    Battery = 0xE053             // a battery
    Bell = 0xE059                // a bell, for the notifications
    BellOff = 0xE05A             // a bell crossed out, for the notifications off
    Bike = 0xE1D2                // a bicycle
    Bluetooth = 0xE05C           // the sign of Bluetooth
    Book = 0xE05E                // a closed book
    BookOpen = 0xE05F            // an open book
    Bookmark = 0xE060            // a bookmark
    Briefcase = 0xE062           // a briefcase, for work
    Building2 = 0xE290           // an office building
    Calendar = 0xE063            // a calendar
    Camera = 0xE064              // a camera
    Car = 0xE1D5                 // a car
    ChartColumn = 0xE2A3         // a chart with columns
    ChartLine = 0xE2A5           // a chart with a line
    ChartPie = 0xE06B            // a pie chart
    Check = 0xE06C               // a check mark
    ChevronDown = 0xE06D         // a chevron that points down, to open
    ChevronLeft = 0xE06E         // a chevron that points left, to go back
    ChevronRight = 0xE06F        // a chevron that points right, to go on
    ChevronUp = 0xE070           // a chevron that points up, to close
    CircleAlert = 0xE077         // an exclamation mark in a circle, for an error
    CircleCheck = 0xE226         // a check mark in a circle, for a success
    CircleQuestionMark = 0xE082  // a question mark in a circle, for help
    CircleX = 0xE084             // an X in a circle, for a failure
    Clipboard = 0xE085           // a clipboard
    Clock = 0xE087               // a clock, for a time
    Cloud = 0xE088               // a cloud
    Code = 0xE093                // two angle brackets, for code
    Coffee = 0xE096              // a cup of coffee
    Contact = 0xE09C             // a card with a person, for a contact
    Copy = 0xE09E                // two sheets one over the other, to copy
    Cpu = 0xE0A9                 // a processor
    CreditCard = 0xE0AA          // a credit card
    Database = 0xE0AD            // a cylinder, for a database
    Download = 0xE0B2            // an arrow down into a tray, to download
    Droplet = 0xE0B4             // a drop of water
    Ellipsis = 0xE0B6            // three dots in a row, for more
    EllipsisVertical = 0xE0B7    // three dots in a column, for a menu of more actions
    ExternalLink = 0xE0B9        // a box with an arrow out of it, for a link that opens elsewhere
    Eye = 0xE0BA                 // an eye, to show
    EyeOff = 0xE0BB              // an eye crossed out, to hide
    File = 0xE0C0                // a sheet of paper, for a file
    FileText = 0xE0CC            // a sheet with lines of text
    Flag = 0xE0D1                // a flag
    Flame = 0xE0D2               // a flame
    Folder = 0xE0D7              // a folder
    FolderOpen = 0xE247          // an open folder
    Funnel = 0xE0DC              // a funnel, for a filter
    Gift = 0xE0E1                // a gift
    Globe = 0xE0E8               // a globe, for the web or the languages
    GraduationCap = 0xE234       // a graduation cap, for a school
    Heart = 0xE0F2               // a heart, for what is liked
    History = 0xE1F5             // a clock with an arrow around it, for the history
    House = 0xE0F5               // a house, for the home page
    Image = 0xE0F6               // a picture of mountains, for an image
    Inbox = 0xE0F7               // a tray, for the messages received
    Info = 0xE0F9                // an i in a circle, for information
    Key = 0xE0FD                 // a key
    Laptop = 0xE1CD              // a laptop
    Layers = 0xE529              // sheets one over the other, for layers
    LayoutGrid = 0xE0FF          // four squares, for a grid
    Lightbulb = 0xE1C2           // a light bulb, for an idea or a tip
    Link = 0xE102                // two links of a chain, for a link
    List = 0xE106                // lines with dots, for a list
    Loader = 0xE109              // rays in a circle, for something that is loading
    Lock = 0xE10B                // a closed padlock
    LockOpen = 0xE10C            // an open padlock
    LogIn = 0xE10D               // an arrow into a door, to sign in
    LogOut = 0xE10E              // an arrow out of a door, to sign out
    Mail = 0xE10F                // an envelope, for the mail
    Map = 0xE110                 // a folded map
    MapPin = 0xE111              // a pin, for a place on a map
    Menu = 0xE115                // three lines, for a menu
    MessageCircle = 0xE116       // a round speech bubble, for a message
    MessageSquare = 0xE117       // a square speech bubble, for a message
    Mic = 0xE118                 // a microphone
    Minus = 0xE11C               // a minus sign
    Monitor = 0xE11D             // the screen of a computer
    Moon = 0xE11E                // a crescent moon, for the night or the dark theme
    Music = 0xE122               // a musical note
    Package = 0xE129             // a parcel
    Paperclip = 0xE12D           // a paper clip, for an attachment
    Pause = 0xE12E               // two bars, to pause
    Pencil = 0xE1F9              // a pencil, to write or to edit
    Phone = 0xE133               // the handset of a phone, for a call
    Plane = 0xE1DE               // an airplane
    Play = 0xE13C                // a triangle that points right, to play
    Plus = 0xE13D                // a plus sign, to add
    Power = 0xE140               // a circle broken by a line, to switch on or off
    Printer = 0xE141             // a printer
    QrCode = 0xE1DF              // a QR code
    RefreshCw = 0xE145           // two arrows in a circle, to refresh
    RotateCcw = 0xE148           // an arrow that turns back, to undo
    Save = 0xE14D                // a floppy disk, to save
    Scan = 0xE257                // the corners of a frame, to scan
    Search = 0xE151              // a magnifying glass, to search
    Send = 0xE152                // a paper plane, to send
    Server = 0xE153              // a server
    Settings = 0xE154            // a gear, for the settings
    Share2 = 0xE156              // three dots joined by lines, to share
    Shield = 0xE158              // a shield, for security
    ShoppingBag = 0xE15B         // a shopping bag
    ShoppingCart = 0xE15C        // a shopping cart
    SkipBack = 0xE15F            // a triangle to the left against a bar, for the track before
    SkipForward = 0xE160         // a triangle to the right against a bar, for the track after
    SlidersHorizontal = 0xE29A   // horizontal sliders, for options
    Smartphone = 0xE163          // a smartphone
    Smile = 0xE164               // a smiling face
    Square = 0xE167              // a square, to stop
    Star = 0xE176                // a star, for the favorites
    Sun = 0xE178                 // a sun, for the day or the light theme
    Table = 0xE17D               // a table with rows and columns
    Tag = 0xE17F                 // a tag, for a label or a price
    Terminal = 0xE181            // a prompt, for a terminal
    Thermometer = 0xE186         // a thermometer
    ThumbsDown = 0xE189          // a thumb down
    ThumbsUp = 0xE18A            // a thumb up
    Trash2 = 0xE18E              // a bin, to delete
    TriangleAlert = 0xE193       // an exclamation mark in a triangle, for a warning
    Trophy = 0xE373              // a trophy
    Truck = 0xE194               // a truck, for a delivery
    Umbrella = 0xE199            // an umbrella
    Upload = 0xE19E              // an arrow up out of a tray, to upload
    User = 0xE19F                // a person, for a user or an account
    UserCheck = 0xE1A0           // a person with a check mark
    UserPlus = 0xE1A2            // a person with a plus sign, to add someone
    Users = 0xE1A4               // two people, for a group
    Utensils = 0xE2F6            // a fork and a knife, for food
    Video = 0xE1A5               // a video camera
    Volume2 = 0xE1AB             // a speaker with waves, for the sound on
    VolumeX = 0xE1AC             // a speaker with an X, for the sound off
    Wallet = 0xE204              // a wallet
    Wifi = 0xE1AE                // the waves of Wi-Fi
    WifiOff = 0xE1AF             // the waves of Wi-Fi crossed out
    X = 0xE1B2                   // an X, to close or to cancel
    Zap = 0xE1B4                 // a lightning bolt
}

// ---- The end of the icons ----

// Where the mouse is, and which button changed, for the handlers of 'onMouseMove',
// 'onMouseDown' and 'onMouseUp' of a window or of a canvas. A finger on a phone is the
// left button.
public struct Mouse {
    public f32 x       // in logical pixels from the left edge of the content, or of the canvas
    public f32 y       // in logical pixels from the top of the content, or of the canvas
    public i32 button  // 1 left, 2 middle, 3 right, 0 when the mouse moves
}

// A key pressed, for the handlers of 'onKeyDown' of a window.
public struct Key {
    // The keycode of SDL. For the letters, the digits and the signs it is the character
    // of the key without Shift: 97 for A, with Shift too, and 49 for 1. Then 13 is
    // Enter, 27 Esc, 32 Space, 8 Backspace and 127 Delete, and the arrows are
    // 0x40000050 left, 0x4000004F right, 0x40000052 up and 0x40000051 down.
    public i64 code
    public bool shift    // a Shift key is held
    public bool control  // a Ctrl key is held
    public bool alt      // an Alt key is held
}

// A component that a window, a group, a panel or a dialog can hold, with their 'add':
// the components of this module, as 'Label' and 'Button', are its implementations.
public interface Component {
    // The number that names the component inside the module, for 'add'.
    i64 componentId() const
}

// ---- The components (D434, D439) ----
//
// Each is a handle, with its position and its size in logical pixels from the top
// left corner of the content (D438). Its text and its properties are methods.

// A line of text, on the left of its box and in the middle of its height. It takes
// neither the mouse nor the keys.
//
// '''
// gui.Label status = w.add(gui.Label("Ready", 16, 223, 300, 20))
// status.setText("Saved")
// '''
public struct Label : Component {
    i64 id

    // A label with its text. 'x' and 'y' are in logical pixels from the top left corner
    // of its parent, the window, the group, the panel or the dialog whose 'add' puts it
    // there, and 'width' and 'height' its size.
    public Label(string text, i32 x, i32 y, i32 width, i32 height) {
        id = newPart(kindLabel, text, x, y, width, height)
    }

    i64 componentId() const {
        ret id
    }

    // Changes the text of the label.
    public void setText(string value) const {
        setPartText(id, value)
    }

    // The text of the label.
    public string text() const {
        ret partText(id, false)
    }

    // Moves the label, in logical pixels from the top left corner of its parent: the content of
    // the window, or the group, the panel or the dialog that holds it. Its anchors keep the
    // distances from the edges that it has at the new place.
    public void setPosition(i32 x, i32 y) const {
        setPartBounds(id, x, y, -1, -1)
    }

    // Changes the width and the height of the label, in logical pixels. Its anchors keep the
    // distances from the edges that it has with the new size.
    public void setSize(i32 width, i32 height) const {
        setPartBounds(id, -1, -1, width, height)
    }

    // The distance of the label from the left edge of its parent, in logical pixels, where its
    // anchors have placed it now.
    public i32 x() const {
        ret partBound(id, 0)
    }

    // The distance of the label from the top edge of its parent, in logical pixels, where its
    // anchors have placed it now.
    public i32 y() const {
        ret partBound(id, 1)
    }

    // The width of the label now, in logical pixels: a 'Stretch' anchor changes it with its
    // parent.
    public i32 width() const {
        ret partBound(id, 2)
    }

    // The height of the label now, in logical pixels: a 'Stretch' anchor changes it with its
    // parent.
    public i32 height() const {
        ret partBound(id, 3)
    }

    // Sets the text that a small card shows when the mouse stays on the label for a moment,
    // or after a long press on a phone: "" for none, the default; "\n" starts a new line.
    public void setTooltip(string text) const {
        setPartTooltip(id, text)
    }

    // The text of the tooltip of the label, "" for none.
    public string tooltip() const {
        ret partTooltip(id)
    }

    // Shows or hides the label.
    public void setVisible(bool value) const {
        setPartFlag(id, 0, value)
    }

    // Whether the label is visible, as 'setVisible' set it: true by default.
    public bool visible() const {
        ret partFlag(id, 0)
    }

    // Enables or disables the label: disabled, it is drawn at half its opacity.
    public void setEnabled(bool value) const {
        setPartFlag(id, 1, value)
    }

    // Whether the label is enabled, as 'setEnabled' set it: true by default.
    public bool enabled() const {
        ret partFlag(id, 1)
    }

    // Sets which edges of its parent the label follows when the parent changes size: the
    // window, or the group, the panel or the dialog that holds it. It keeps the distances from
    // those edges that it has now, as 'setAnchor(gui.Horizontal.Right, gui.Vertical.Bottom)' in
    // the bottom right corner. By default it is anchored to the left and to the top, and does
    // not move.
    public void setAnchor(Horizontal horizontal, Vertical vertical) const {
        setPartAnchor(id, horizontal, vertical)
    }

    // How the label follows the left and the right edges of its parent: 'Horizontal.Left' by
    // default.
    public Horizontal horizontalAnchor() const {
        ret partHorizontal(id)
    }

    // How the label follows the top and the bottom edges of its parent: 'Vertical.Top' by
    // default.
    public Vertical verticalAnchor() const {
        ret partVertical(id)
    }
}

// A button, with a text, an icon or both. A click, a touch, or Space and Enter while it
// has the keyboard, call its handlers of 'onClick'.
//
// '''
// gui.Button save = w.add(gui.Button("Save", 364, 217, 100, 32))
// save.setIcon(gui.Icon.Save)
// save.onClick([w]() { w.showSnackbar("Saved") })
// '''
public struct Button : Component {
    i64 id

    // A button with its text. 'x' and 'y' are in logical pixels from the top left
    // corner of its parent, the window, the group, the panel or the dialog whose 'add'
    // puts it there, and 'width' and 'height' its size.
    public Button(string text, i32 x, i32 y, i32 width, i32 height) {
        id = newPart(kindButton, text, x, y, width, height)
    }

    i64 componentId() const {
        ret id
    }

    // Adds a handler, called on the thread of the windows when the user presses the
    // button: with a click, a touch, or Space or Enter while it has the keyboard. The
    // handlers are called in the order they were added.
    public void onClick(move func() handler) const {
        addr box = alloc(sizeOf<func()>())
        put<func()>(box, move handler)
        addPartHandler(id, 0, box)
    }

    // Puts an icon of 16 pixels before the text, 18 on a phone, or alone in the middle when
    // the button has no text; 'Icon.None' removes it.
    public void setIcon(Icon value) const {
        setPartIcon(id, value)
    }

    // Changes the style of the button: 'ButtonStyle.Primary' fills it with the accent, for
    // the main action, and 'ButtonStyle.Danger' is for an action that destroys.
    //
    // '''
    // gui.Button save = w.add(gui.Button("Save", 364, 217, 100, 28))
    // save.setStyle(gui.ButtonStyle.Primary)
    // '''
    public void setStyle(ButtonStyle value) const {
        i64 me = id
        withData([me, value](ref Shared data) { data.parts[partIndexOf(ref data, me)].style = value })
    }

    // The style of the button: 'ButtonStyle.Normal' unless it was changed.
    public ButtonStyle style() const {
        i64 me = id
        ButtonStyle result = ButtonStyle.Normal
        withData([me, ref result](ref Shared data) { result = data.parts[partIndexOf(ref data, me)].style })
        ret result
    }

    // The icon of the button, 'Icon.None' without one.
    public Icon icon() const {
        ret partIcon(id)
    }

    // Changes the text of the button; without text, its icon is alone in the middle.
    public void setText(string value) const {
        setPartText(id, value)
    }

    // The text of the button.
    public string text() const {
        ret partText(id, false)
    }

    // Moves the button, in logical pixels from the top left corner of its parent: the content
    // of the window, or the group, the panel or the dialog that holds it. Its anchors keep the
    // distances from the edges that it has at the new place.
    public void setPosition(i32 x, i32 y) const {
        setPartBounds(id, x, y, -1, -1)
    }

    // Changes the width and the height of the button, in logical pixels. Its anchors keep the
    // distances from the edges that it has with the new size.
    public void setSize(i32 width, i32 height) const {
        setPartBounds(id, -1, -1, width, height)
    }

    // The distance of the button from the left edge of its parent, in logical pixels, where its
    // anchors have placed it now.
    public i32 x() const {
        ret partBound(id, 0)
    }

    // The distance of the button from the top edge of its parent, in logical pixels, where its
    // anchors have placed it now.
    public i32 y() const {
        ret partBound(id, 1)
    }

    // The width of the button now, in logical pixels: a 'Stretch' anchor changes it with its
    // parent.
    public i32 width() const {
        ret partBound(id, 2)
    }

    // The height of the button now, in logical pixels: a 'Stretch' anchor changes it with its
    // parent.
    public i32 height() const {
        ret partBound(id, 3)
    }

    // Sets the text that a small card shows when the mouse stays on the button: hidden for a moment,
    // or after a long press on a phone: "" for none, the default; "\n" starts a new line.
    public void setTooltip(string text) const {
        setPartTooltip(id, text)
    }

    // The text of the tooltip of the button: hidden, "" for none.
    public string tooltip() const {
        ret partTooltip(id)
    }

    // Shows or hides the button: hidden, it takes neither the mouse nor the keys.
    public void setVisible(bool value) const {
        setPartFlag(id, 0, value)
    }

    // Whether the button is visible, as 'setVisible' set it: true by default.
    public bool visible() const {
        ret partFlag(id, 0)
    }

    // Enables or disables the button: disabled, it is drawn at half its opacity and takes
    // neither the mouse nor the keys.
    public void setEnabled(bool value) const {
        setPartFlag(id, 1, value)
    }

    // Whether the button is enabled, as 'setEnabled' set it: true by default.
    public bool enabled() const {
        ret partFlag(id, 1)
    }

    // Sets which edges of its parent the button follows when the parent changes size: the
    // window, or the group, the panel or the dialog that holds it. It keeps the distances from
    // those edges that it has now, as 'setAnchor(gui.Horizontal.Right, gui.Vertical.Bottom)' in
    // the bottom right corner. By default it is anchored to the left and to the top, and does
    // not move.
    public void setAnchor(Horizontal horizontal, Vertical vertical) const {
        setPartAnchor(id, horizontal, vertical)
    }

    // How the button follows the left and the right edges of its parent: 'Horizontal.Left' by
    // default.
    public Horizontal horizontalAnchor() const {
        ret partHorizontal(id)
    }

    // How the button follows the top and the bottom edges of its parent: 'Vertical.Top' by
    // default.
    public Vertical verticalAnchor() const {
        ret partVertical(id)
    }
}

// A line of text that the user writes, with the input method of the system and, on a
// phone, the keyboard on the screen. The arrows, Home and End move in it, with Shift
// they select, as the mouse does, and Backspace, Delete, Ctrl+A, Ctrl+C, Ctrl+X and
// Ctrl+V do what they do in every program; a text pasted becomes one line. Its
// handlers of 'onChange' receive the text at each change, those of 'onEnter' when
// Enter is pressed.
//
// '''
// gui.TextBox name = w.add(gui.TextBox("", 24, 48, 372, 32))
// name.setPlaceholder("Write your name")
// name.onEnter([](string text) { println("Hello, {}!", text) })
// '''
public struct TextBox : Component {
    i64 id

    // A text box with its first text, maybe "". 'x' and 'y' are in logical pixels from
    // the top left corner of its parent, the window, the group, the panel or the dialog
    // whose 'add' puts it there, and 'width' and 'height' its size.
    public TextBox(string text, i32 x, i32 y, i32 width, i32 height) {
        id = newPart(kindTextBox, text, x, y, width, height)
    }

    i64 componentId() const {
        ret id
    }

    // Adds a handler, called on the thread of the windows with the new text at each
    // change that the user makes: a character written or deleted, a text cut or pasted.
    // 'setText' does not call it.
    public void onChange(move func(string) handler) const {
        addr box = alloc(sizeOf<func(string)>())
        put<func(string)>(box, move handler)
        addPartHandler(id, 1, box)
    }

    // Adds a handler, called on the thread of the windows with the text when the user
    // presses Enter in the box.
    public void onEnter(move func(string) handler) const {
        addr box = alloc(sizeOf<func(string)>())
        put<func(string)>(box, move handler)
        addPartHandler(id, 2, box)
    }

    // Sets the text shown in gray while the box is empty, as a hint of what to write.
    public void setPlaceholder(string value) const {
        i64 me = id
        withData([me, value](ref Shared data) { data.parts[partIndexOf(ref data, me)].placeholder = value })
    }

    // The text shown while the box is empty, "" by default.
    public string placeholder() const {
        ret partText(id, true)
    }

    // Replaces the text, with the cursor at its end, without calling the handlers of
    // 'onChange'.
    public void setText(string value) const {
        setPartText(id, value)
    }

    // The text written in the box.
    public string text() const {
        ret partText(id, false)
    }

    // Moves the text box, in logical pixels from the top left corner of its parent: the content
    // of the window, or the group, the panel or the dialog that holds it. Its anchors keep the
    // distances from the edges that it has at the new place.
    public void setPosition(i32 x, i32 y) const {
        setPartBounds(id, x, y, -1, -1)
    }

    // Changes the width and the height of the text box, in logical pixels. Its anchors keep the
    // distances from the edges that it has with the new size.
    public void setSize(i32 width, i32 height) const {
        setPartBounds(id, -1, -1, width, height)
    }

    // The distance of the text box from the left edge of its parent, in logical pixels, where
    // its anchors have placed it now.
    public i32 x() const {
        ret partBound(id, 0)
    }

    // The distance of the text box from the top edge of its parent, in logical pixels, where
    // its anchors have placed it now.
    public i32 y() const {
        ret partBound(id, 1)
    }

    // The width of the text box now, in logical pixels: a 'Stretch' anchor changes it with its
    // parent.
    public i32 width() const {
        ret partBound(id, 2)
    }

    // The height of the text box now, in logical pixels: a 'Stretch' anchor changes it with its
    // parent.
    public i32 height() const {
        ret partBound(id, 3)
    }

    // Sets the text that a small card shows when the mouse stays on the text box: hidden for a moment,
    // or after a long press on a phone: "" for none, the default; "\n" starts a new line.
    public void setTooltip(string text) const {
        setPartTooltip(id, text)
    }

    // The text of the tooltip of the text box: hidden, "" for none.
    public string tooltip() const {
        ret partTooltip(id)
    }

    // Shows or hides the text box: hidden, it takes neither the mouse nor the keys.
    public void setVisible(bool value) const {
        setPartFlag(id, 0, value)
    }

    // Whether the text box is visible, as 'setVisible' set it: true by default.
    public bool visible() const {
        ret partFlag(id, 0)
    }

    // Enables or disables the text box: disabled, it is drawn at half its opacity and takes
    // neither the mouse nor the keys.
    public void setEnabled(bool value) const {
        setPartFlag(id, 1, value)
    }

    // Whether the text box is enabled, as 'setEnabled' set it: true by default.
    public bool enabled() const {
        ret partFlag(id, 1)
    }

    // Sets which edges of its parent the text box follows when the parent changes size: the
    // window, or the group, the panel or the dialog that holds it. It keeps the distances from
    // those edges that it has now, as 'setAnchor(gui.Horizontal.Right, gui.Vertical.Bottom)' in
    // the bottom right corner. By default it is anchored to the left and to the top, and does
    // not move.
    public void setAnchor(Horizontal horizontal, Vertical vertical) const {
        setPartAnchor(id, horizontal, vertical)
    }

    // How the text box follows the left and the right edges of its parent: 'Horizontal.Left' by
    // default.
    public Horizontal horizontalAnchor() const {
        ret partHorizontal(id)
    }

    // How the text box follows the top and the bottom edges of its parent: 'Vertical.Top' by
    // default.
    public Vertical verticalAnchor() const {
        ret partVertical(id)
    }
}

// A box to check, with its text on its right. A click on the box or on its text, or
// Space while it has the keyboard, checks or unchecks it, and calls its handlers of
// 'onChange' with the new state.
//
// '''
// gui.CheckBox news = w.add(gui.CheckBox("Send me the news", 12, 154, 260, 22))
// news.onChange([](bool checked) { println("news: {}", checked) })
// '''
public struct CheckBox : Component {
    i64 id

    // A check box with its text, not checked. 'x' and 'y' are in logical pixels from
    // the top left corner of its parent, the window, the group, the panel or the dialog
    // whose 'add' puts it there, and 'width' and 'height' its size, with the text.
    public CheckBox(string text, i32 x, i32 y, i32 width, i32 height) {
        id = newPart(kindCheckBox, text, x, y, width, height)
    }

    i64 componentId() const {
        ret id
    }

    // Adds a handler, called on the thread of the windows with the new state when the
    // user checks or unchecks the box. 'setChecked' does not call it.
    public void onChange(move func(bool) handler) const {
        addr box = alloc(sizeOf<func(bool)>())
        put<func(bool)>(box, move handler)
        addPartHandler(id, 1, box)
    }

    // Checks or unchecks the box, without calling the handlers of 'onChange'.
    public void setChecked(bool value) const {
        setPartFlag(id, 2, value)
    }

    // Whether the box is checked: false at the start.
    public bool checked() const {
        ret partFlag(id, 2)
    }

    // Changes the text on the right of the box.
    public void setText(string value) const {
        setPartText(id, value)
    }

    // The text on the right of the box.
    public string text() const {
        ret partText(id, false)
    }

    // Moves the check box, in logical pixels from the top left corner of its parent: the
    // content of the window, or the group, the panel or the dialog that holds it. Its anchors
    // keep the distances from the edges that it has at the new place.
    public void setPosition(i32 x, i32 y) const {
        setPartBounds(id, x, y, -1, -1)
    }

    // Changes the width and the height of the check box, in logical pixels. Its anchors keep
    // the distances from the edges that it has with the new size.
    public void setSize(i32 width, i32 height) const {
        setPartBounds(id, -1, -1, width, height)
    }

    // The distance of the check box from the left edge of its parent, in logical pixels, where
    // its anchors have placed it now.
    public i32 x() const {
        ret partBound(id, 0)
    }

    // The distance of the check box from the top edge of its parent, in logical pixels, where
    // its anchors have placed it now.
    public i32 y() const {
        ret partBound(id, 1)
    }

    // The width of the check box now, in logical pixels: a 'Stretch' anchor changes it with its
    // parent.
    public i32 width() const {
        ret partBound(id, 2)
    }

    // The height of the check box now, in logical pixels: a 'Stretch' anchor changes it with
    // its parent.
    public i32 height() const {
        ret partBound(id, 3)
    }

    // Sets the text that a small card shows when the mouse stays on the check box: hidden for a moment,
    // or after a long press on a phone: "" for none, the default; "\n" starts a new line.
    public void setTooltip(string text) const {
        setPartTooltip(id, text)
    }

    // The text of the tooltip of the check box: hidden, "" for none.
    public string tooltip() const {
        ret partTooltip(id)
    }

    // Shows or hides the check box: hidden, it takes neither the mouse nor the keys.
    public void setVisible(bool value) const {
        setPartFlag(id, 0, value)
    }

    // Whether the check box is visible, as 'setVisible' set it: true by default.
    public bool visible() const {
        ret partFlag(id, 0)
    }

    // Enables or disables the check box: disabled, it is drawn at half its opacity and takes
    // neither the mouse nor the keys.
    public void setEnabled(bool value) const {
        setPartFlag(id, 1, value)
    }

    // Whether the check box is enabled, as 'setEnabled' set it: true by default.
    public bool enabled() const {
        ret partFlag(id, 1)
    }

    // Sets which edges of its parent the check box follows when the parent changes size: the
    // window, or the group, the panel or the dialog that holds it. It keeps the distances from
    // those edges that it has now, as 'setAnchor(gui.Horizontal.Right, gui.Vertical.Bottom)' in
    // the bottom right corner. By default it is anchored to the left and to the top, and does
    // not move.
    public void setAnchor(Horizontal horizontal, Vertical vertical) const {
        setPartAnchor(id, horizontal, vertical)
    }

    // How the check box follows the left and the right edges of its parent: 'Horizontal.Left'
    // by default.
    public Horizontal horizontalAnchor() const {
        ret partHorizontal(id)
    }

    // How the check box follows the top and the bottom edges of its parent: 'Vertical.Top' by
    // default.
    public Vertical verticalAnchor() const {
        ret partVertical(id)
    }
}

// A card with its title in a band at its top, 32 pixels high, 40 on a phone, which holds other
// components: their positions are from its top left corner, so the first ones go under the band, at
// about 42 pixels. Without a title the card has no band. They move, hide and are disabled with the
// group, follow its edges with their anchors, and are drawn only inside it. A group can hold
// groups; unlike a panel, it does not scroll.
//
// '''
// gui.GroupBox account = w.add(gui.GroupBox("Account", 12, 12, 300, 200))
// account.add(gui.Label("Name", 12, 42, 200, 18))
// gui.TextBox name = account.add(gui.TextBox("", 12, 62, 276, 28))
// account.setEnabled(false)   // name too
// '''
public struct GroupBox : Component {
    i64 id

    // A group with its title. 'x' and 'y' are in logical pixels from the top left
    // corner of its parent, the window, the group, the panel or the dialog whose 'add'
    // puts it there, and 'width' and 'height' its size.
    public GroupBox(string text, i32 x, i32 y, i32 width, i32 height) {
        id = newPart(kindGroup, text, x, y, width, height)
    }

    i64 componentId() const {
        ret id
    }

    // Puts a component in the group, with its position from the top left corner of the
    // group, and gives it back. The group can be put in its window before or after. A
    // component that is already in a window or in a group is a panic, and so are an app
    // bar and a group put in itself or in a group that it holds.
    public T add<T : Component>(T component) const {
        addPart(0, id, component.componentId())
        ret component
    }

    // Changes the title of the group.
    public void setText(string value) const {
        setPartText(id, value)
    }

    // The title of the group.
    public string text() const {
        ret partText(id, false)
    }

    // Moves the group, in logical pixels from the top left corner of its parent: the content of
    // the window, or the group, the panel or the dialog that holds it. Its anchors keep the
    // distances from the edges that it has at the new place.
    public void setPosition(i32 x, i32 y) const {
        setPartBounds(id, x, y, -1, -1)
    }

    // Changes the width and the height of the group, in logical pixels. Its anchors keep the
    // distances from the edges that it has with the new size.
    public void setSize(i32 width, i32 height) const {
        setPartBounds(id, -1, -1, width, height)
    }

    // The distance of the group from the left edge of its parent, in logical pixels, where its
    // anchors have placed it now.
    public i32 x() const {
        ret partBound(id, 0)
    }

    // The distance of the group from the top edge of its parent, in logical pixels, where its
    // anchors have placed it now.
    public i32 y() const {
        ret partBound(id, 1)
    }

    // The width of the group now, in logical pixels: a 'Stretch' anchor changes it with its
    // parent.
    public i32 width() const {
        ret partBound(id, 2)
    }

    // The height of the group now, in logical pixels: a 'Stretch' anchor changes it with its
    // parent.
    public i32 height() const {
        ret partBound(id, 3)
    }

    // Sets the text that a small card shows when the mouse stays on the group for a moment,
    // or after a long press on a phone: "" for none, the default; "\n" starts a new line.
    public void setTooltip(string text) const {
        setPartTooltip(id, text)
    }

    // The text of the tooltip of the group, "" for none.
    public string tooltip() const {
        ret partTooltip(id)
    }

    // Shows or hides the group, and its components with it.
    public void setVisible(bool value) const {
        setPartFlag(id, 0, value)
    }

    // Whether the group is visible, as 'setVisible' set it: true by default.
    public bool visible() const {
        ret partFlag(id, 0)
    }

    // Enables or disables the group, and its components with it: disabled, they are drawn at
    // half their opacity and take neither the mouse nor the keys.
    public void setEnabled(bool value) const {
        setPartFlag(id, 1, value)
    }

    // Whether the group is enabled, as 'setEnabled' set it: true by default.
    public bool enabled() const {
        ret partFlag(id, 1)
    }

    // Sets which edges of its parent the group follows when the parent changes size: the
    // window, or the group, the panel or the dialog that holds it. It keeps the distances from
    // those edges that it has now, as 'setAnchor(gui.Horizontal.Right, gui.Vertical.Bottom)' in
    // the bottom right corner. By default it is anchored to the left and to the top, and does
    // not move.
    public void setAnchor(Horizontal horizontal, Vertical vertical) const {
        setPartAnchor(id, horizontal, vertical)
    }

    // How the group follows the left and the right edges of its parent: 'Horizontal.Left' by
    // default.
    public Horizontal horizontalAnchor() const {
        ret partHorizontal(id)
    }

    // How the group follows the top and the bottom edges of its parent: 'Vertical.Top' by
    // default.
    public Vertical verticalAnchor() const {
        ret partVertical(id)
    }
}

// A choice among a list of items, which the user chooses and cannot write. A click, or
// Space, Enter or Alt+Down while it has the keyboard, opens the list over the other
// components, below the box or above it when there is no room below, with up to 8
// items and the others with the wheel of the mouse. In the list Up, Down, Home, End and
// the first letter of an item move, Enter, Space or a click choose, and Esc or a click
// out of the list close it. With the list closed, the same keys choose an item at once.
// Without a choice the box shows its placeholder.
//
// '''
// gui.ComboBox role = w.add(gui.ComboBox(["Developer", "Designer", "Viewer"], 12, 110, 276, 28))
// role.setPlaceholder("Choose a role")
// role.onChange([role](i64 index) { println("{}: {}", index, role.text()) })
// '''
public struct ComboBox : Component {
    i64 id

    // A combo box with a copy of its items, none chosen. 'x' and 'y' are in logical
    // pixels from the top left corner of its parent, the window, the group, the panel or
    // the dialog whose 'add' puts it there, and 'width' and 'height' its size.
    public ComboBox(list<string> items, i32 x, i32 y, i32 width, i32 height) {
        id = newPart(kindComboBox, "", x, y, width, height)
        setComboItems(id, items)
    }

    i64 componentId() const {
        ret id
    }

    // Adds a handler, called on the thread of the windows with the index of the item
    // that the user chooses, when it is not the one chosen before. 'setSelected' and
    // 'setItems' do not call it.
    public void onChange(move func(i64) handler) const {
        addr box = alloc(sizeOf<func(i64)>())
        put<func(i64)>(box, move handler)
        addPartHandler(id, 1, box)
    }

    // Replaces the items with a copy of 'items', and leaves none chosen.
    public void setItems(list<string> items) const {
        setComboItems(id, items)
    }

    // A copy of the items.
    public list<string> items() const {
        list<string> result
        i64 me = id
        withData([me, ref result](ref Shared data) { result = data.parts[partIndexOf(ref data, me)].items })
        ret result
    }

    // Adds an item at the end of the list; the item chosen stays the same.
    public void addItem(string item) const {
        i64 me = id
        withData([me, item](ref Shared data) { data.parts[partIndexOf(ref data, me)].items.add(item) })
    }

    // Chooses the item at 'index', from 0, or none with -1, without calling the handlers
    // of 'onChange'. Another index out of the items is a panic.
    public void setSelected(i64 index) const {
        i64 me = id
        withData([me, index](ref Shared data) {
            i64 p = partIndexOf(ref data, me)
            if (index < -1 || index >= data.parts[p].items.len()) {
                panic(format("the combo box has no item {}", index))
            }
            data.parts[p].selected = index
        })
    }

    // The index of the item chosen, from 0, or -1 when none is: the default.
    public i64 selected() const {
        i64 me = id
        i64 result = -1
        withData([me, ref result](ref Shared data) { result = data.parts[partIndexOf(ref data, me)].selected })
        ret result
    }

    // The item chosen, or "" when none is.
    public string text() const {
        i64 me = id
        string result
        withData([me, ref result](ref Shared data) {
            i64 p = partIndexOf(ref data, me)
            if (data.parts[p].selected >= 0) {
                result = data.parts[p].items[data.parts[p].selected]
            }
        })
        ret result
    }

    // Sets the text shown in gray while no item is chosen, as "Choose a role".
    public void setPlaceholder(string value) const {
        i64 me = id
        withData([me, value](ref Shared data) { data.parts[partIndexOf(ref data, me)].placeholder = value })
    }

    // The text shown while no item is chosen, "" by default.
    public string placeholder() const {
        ret partText(id, true)
    }

    // Moves the combo box, in logical pixels from the top left corner of its parent: the
    // content of the window, or the group, the panel or the dialog that holds it. Its anchors
    // keep the distances from the edges that it has at the new place.
    public void setPosition(i32 x, i32 y) const {
        setPartBounds(id, x, y, -1, -1)
    }

    // Changes the width and the height of the combo box, in logical pixels. Its anchors keep
    // the distances from the edges that it has with the new size.
    public void setSize(i32 width, i32 height) const {
        setPartBounds(id, -1, -1, width, height)
    }

    // The distance of the combo box from the left edge of its parent, in logical pixels, where
    // its anchors have placed it now.
    public i32 x() const {
        ret partBound(id, 0)
    }

    // The distance of the combo box from the top edge of its parent, in logical pixels, where
    // its anchors have placed it now.
    public i32 y() const {
        ret partBound(id, 1)
    }

    // The width of the combo box now, in logical pixels: a 'Stretch' anchor changes it with its
    // parent.
    public i32 width() const {
        ret partBound(id, 2)
    }

    // The height of the combo box now, in logical pixels: a 'Stretch' anchor changes it with
    // its parent.
    public i32 height() const {
        ret partBound(id, 3)
    }

    // Sets the text that a small card shows when the mouse stays on the combo box: hidden for a moment,
    // or after a long press on a phone: "" for none, the default; "\n" starts a new line.
    public void setTooltip(string text) const {
        setPartTooltip(id, text)
    }

    // The text of the tooltip of the combo box: hidden, "" for none.
    public string tooltip() const {
        ret partTooltip(id)
    }

    // Shows or hides the combo box: hidden, it takes neither the mouse nor the keys.
    public void setVisible(bool value) const {
        setPartFlag(id, 0, value)
    }

    // Whether the combo box is visible, as 'setVisible' set it: true by default.
    public bool visible() const {
        ret partFlag(id, 0)
    }

    // Enables or disables the combo box: disabled, it is drawn at half its opacity and takes
    // neither the mouse nor the keys.
    public void setEnabled(bool value) const {
        setPartFlag(id, 1, value)
    }

    // Whether the combo box is enabled, as 'setEnabled' set it: true by default.
    public bool enabled() const {
        ret partFlag(id, 1)
    }

    // Sets which edges of its parent the combo box follows when the parent changes size: the
    // window, or the group, the panel or the dialog that holds it. It keeps the distances from
    // those edges that it has now, as 'setAnchor(gui.Horizontal.Right, gui.Vertical.Bottom)' in
    // the bottom right corner. By default it is anchored to the left and to the top, and does
    // not move.
    public void setAnchor(Horizontal horizontal, Vertical vertical) const {
        setPartAnchor(id, horizontal, vertical)
    }

    // How the combo box follows the left and the right edges of its parent: 'Horizontal.Left'
    // by default.
    public Horizontal horizontalAnchor() const {
        ret partHorizontal(id)
    }

    // How the combo box follows the top and the bottom edges of its parent: 'Vertical.Top' by
    // default.
    public Vertical verticalAnchor() const {
        ret partVertical(id)
    }
}

// An image in PNG, JPEG, BMP, GIF or SVG, of which a GIF shows its first frame, from a
// file or from bytes in memory, placed in its box as 'setScale' says: by default the
// whole image, as large as the box allows. An SVG image is drawn at the size where it
// is shown, sharp at every size. The image is read and decoded by the thread that
// sets it, which receives the errors as exceptions. An app on a phone has no files
// next to it: there the images come from 'embed'.
//
// '''
// gui.ImageBox logo = w.add(gui.ImageBox("", 16, 16, 64, 64))
// logo.setBytes(embed("images/logo.png"))
// '''
public struct ImageBox : Component {
    i64 id

    // An image box with the image of 'file', or none with "". 'x' and 'y' are in
    // logical pixels from the top left corner of its parent, the window, the group, the
    // panel or the dialog whose 'add' puts it there, and 'width' and 'height' its size.
    // Throws an 'Error' when the file cannot be read, is empty or is not an image.
    public ImageBox(string file, i32 x, i32 y, i32 width, i32 height) {
        id = newPart(kindImageBox, "", x, y, width, height)
        loadImage(id, file)
    }

    i64 componentId() const {
        ret id
    }

    // Shows the image of a file, read and decoded by this thread, or none with "".
    // Throws an 'Error' when the file cannot be read, is empty or is not an image, and
    // then the image shown stays.
    public void setFile(string path) const {
        loadImage(id, path)
    }

    // The path of the image shown, "" when there is none or it came from bytes.
    public string file() const {
        ret partText(id, false)
    }

    // Shows an image in memory, as 'embed' or 'fs.readBytes' give it, or none with an
    // empty list. The bytes are decoded by this thread and not kept. Throws an 'Error'
    // when they are not an image, and then the image shown stays.
    public void setBytes(list<u8> bytes) const {
        setImage(id, "", bytes)
    }

    // The width of the image, in its own pixels, or 0 without an image.
    public i32 imageWidth() const {
        ret partBound(id, 4)
    }

    // The height of the image, in its own pixels, or 0 without an image.
    public i32 imageHeight() const {
        ret partBound(id, 5)
    }

    // Sets how the image fits the box: 'Scale.Fit' by default.
    public void setScale(Scale value) const {
        i64 me = id
        withData([me, value](ref Shared data) { data.parts[partIndexOf(ref data, me)].scale = value })
    }

    // How the image fits the box: 'Scale.Fit' by default.
    public Scale scale() const {
        i64 me = id
        Scale result = Scale.Fit
        withData([me, ref result](ref Shared data) { result = data.parts[partIndexOf(ref data, me)].scale })
        ret result
    }

    // Moves the image box, in logical pixels from the top left corner of its parent: the
    // content of the window, or the group, the panel or the dialog that holds it. Its anchors
    // keep the distances from the edges that it has at the new place.
    public void setPosition(i32 x, i32 y) const {
        setPartBounds(id, x, y, -1, -1)
    }

    // Changes the width and the height of the image box, in logical pixels. Its anchors keep
    // the distances from the edges that it has with the new size.
    public void setSize(i32 width, i32 height) const {
        setPartBounds(id, -1, -1, width, height)
    }

    // The distance of the image box from the left edge of its parent, in logical pixels, where
    // its anchors have placed it now.
    public i32 x() const {
        ret partBound(id, 0)
    }

    // The distance of the image box from the top edge of its parent, in logical pixels, where
    // its anchors have placed it now.
    public i32 y() const {
        ret partBound(id, 1)
    }

    // The width of the image box now, in logical pixels: a 'Stretch' anchor changes it with its
    // parent.
    public i32 width() const {
        ret partBound(id, 2)
    }

    // The height of the image box now, in logical pixels: a 'Stretch' anchor changes it with
    // its parent.
    public i32 height() const {
        ret partBound(id, 3)
    }

    // Sets the text that a small card shows when the mouse stays on the image box for a moment,
    // or after a long press on a phone: "" for none, the default; "\n" starts a new line.
    public void setTooltip(string text) const {
        setPartTooltip(id, text)
    }

    // The text of the tooltip of the image box, "" for none.
    public string tooltip() const {
        ret partTooltip(id)
    }

    // Shows or hides the image box.
    public void setVisible(bool value) const {
        setPartFlag(id, 0, value)
    }

    // Whether the image box is visible, as 'setVisible' set it: true by default.
    public bool visible() const {
        ret partFlag(id, 0)
    }

    // Enables or disables the image box: disabled, it is drawn at half its opacity.
    public void setEnabled(bool value) const {
        setPartFlag(id, 1, value)
    }

    // Whether the image box is enabled, as 'setEnabled' set it: true by default.
    public bool enabled() const {
        ret partFlag(id, 1)
    }

    // Sets which edges of its parent the image box follows when the parent changes size: the
    // window, or the group, the panel or the dialog that holds it. It keeps the distances from
    // those edges that it has now, as 'setAnchor(gui.Horizontal.Right, gui.Vertical.Bottom)' in
    // the bottom right corner. By default it is anchored to the left and to the top, and does
    // not move.
    public void setAnchor(Horizontal horizontal, Vertical vertical) const {
        setPartAnchor(id, horizontal, vertical)
    }

    // How the image box follows the left and the right edges of its parent: 'Horizontal.Left'
    // by default.
    public Horizontal horizontalAnchor() const {
        ret partHorizontal(id)
    }

    // How the image box follows the top and the bottom edges of its parent: 'Vertical.Top' by
    // default.
    public Vertical verticalAnchor() const {
        ret partVertical(id)
    }
}

// An icon alone, at the center of its box, as large as the smaller side of the box, in
// the color of the labels. It takes neither the mouse nor the keys.
//
// '''
// w.add(gui.IconBox(gui.Icon.CircleCheck, 16, 16, 48, 48))
// '''
public struct IconBox : Component {
    i64 id

    // An icon box with its icon; 'Icon.None' shows nothing. 'x' and 'y' are in logical
    // pixels from the top left corner of its parent, the window, the group, the panel or
    // the dialog whose 'add' puts it there, and 'width' and 'height' its size.
    public IconBox(Icon icon, i32 x, i32 y, i32 width, i32 height) {
        id = newPart(kindIconBox, "", x, y, width, height)
        setPartIcon(id, icon)
    }

    i64 componentId() const {
        ret id
    }

    // Changes the icon; 'Icon.None' shows nothing.
    public void setIcon(Icon value) const {
        setPartIcon(id, value)
    }

    // The icon shown, 'Icon.None' for none.
    public Icon icon() const {
        ret partIcon(id)
    }

    // Moves the icon box, in logical pixels from the top left corner of its parent: the content
    // of the window, or the group, the panel or the dialog that holds it. Its anchors keep the
    // distances from the edges that it has at the new place.
    public void setPosition(i32 x, i32 y) const {
        setPartBounds(id, x, y, -1, -1)
    }

    // Changes the width and the height of the icon box, in logical pixels. Its anchors keep the
    // distances from the edges that it has with the new size.
    public void setSize(i32 width, i32 height) const {
        setPartBounds(id, -1, -1, width, height)
    }

    // The distance of the icon box from the left edge of its parent, in logical pixels, where
    // its anchors have placed it now.
    public i32 x() const {
        ret partBound(id, 0)
    }

    // The distance of the icon box from the top edge of its parent, in logical pixels, where
    // its anchors have placed it now.
    public i32 y() const {
        ret partBound(id, 1)
    }

    // The width of the icon box now, in logical pixels: a 'Stretch' anchor changes it with its
    // parent.
    public i32 width() const {
        ret partBound(id, 2)
    }

    // The height of the icon box now, in logical pixels: a 'Stretch' anchor changes it with its
    // parent.
    public i32 height() const {
        ret partBound(id, 3)
    }

    // Sets the text that a small card shows when the mouse stays on the icon box for a moment,
    // or after a long press on a phone: "" for none, the default; "\n" starts a new line.
    public void setTooltip(string text) const {
        setPartTooltip(id, text)
    }

    // The text of the tooltip of the icon box, "" for none.
    public string tooltip() const {
        ret partTooltip(id)
    }

    // Shows or hides the icon box.
    public void setVisible(bool value) const {
        setPartFlag(id, 0, value)
    }

    // Whether the icon box is visible, as 'setVisible' set it: true by default.
    public bool visible() const {
        ret partFlag(id, 0)
    }

    // Enables or disables the icon box: disabled, it is drawn at half its opacity.
    public void setEnabled(bool value) const {
        setPartFlag(id, 1, value)
    }

    // Whether the icon box is enabled, as 'setEnabled' set it: true by default.
    public bool enabled() const {
        ret partFlag(id, 1)
    }

    // Sets which edges of its parent the icon box follows when the parent changes size: the
    // window, or the group, the panel or the dialog that holds it. It keeps the distances from
    // those edges that it has now, as 'setAnchor(gui.Horizontal.Right, gui.Vertical.Bottom)' in
    // the bottom right corner. By default it is anchored to the left and to the top, and does
    // not move.
    public void setAnchor(Horizontal horizontal, Vertical vertical) const {
        setPartAnchor(id, horizontal, vertical)
    }

    // How the icon box follows the left and the right edges of its parent: 'Horizontal.Left' by
    // default.
    public Horizontal horizontalAnchor() const {
        ret partHorizontal(id)
    }

    // How the icon box follows the top and the bottom edges of its parent: 'Vertical.Top' by
    // default.
    public Vertical verticalAnchor() const {
        ret partVertical(id)
    }
}

// A container with no look of its own: its components take their positions from its
// top left corner, as in a group, and are drawn only inside it. A panel scrolls up and
// down when its components anchored to the top go below its bottom edge: with a finger,
// with the wheel of the mouse, or with the thin bar that shows on its right. There is
// nothing to write for it. Its components anchored otherwise stay where they are on
// the part that is seen, as a button over a list. A page of a navigation bar is a
// panel.
//
// '''
// gui.Panel form = w.add(gui.Panel(0, 0, 420, 300))
// form.setAnchor(gui.Horizontal.Stretch, gui.Vertical.Stretch)
// for (i64 i = 0; i < 20; i++) {
//     form.add(gui.CheckBox(format("Option {}", i + 1), 16, 16 + 32 * i32(i), 300, 22))
// }
// '''
public struct Panel : Component {
    i64 id

    // A panel, empty. 'x' and 'y' are in logical pixels from the top left corner of its
    // parent, the window, the group, the panel or the dialog whose 'add' puts it there,
    // and 'width' and 'height' its size.
    public Panel(i32 x, i32 y, i32 width, i32 height) {
        id = newPart(kindPanel, "", x, y, width, height)
    }

    i64 componentId() const {
        ret id
    }

    // Puts a component in the panel, with its position from the top left corner of the
    // panel, and gives it back. A component that is already in a window or in a group is
    // a panic, and so are an app bar and a panel put in itself or in a panel that it
    // holds.
    public T add<T : Component>(T component) const {
        addPart(0, id, component.componentId())
        ret component
    }

    // How far the panel is scrolled, in logical pixels from the top: 0 when it is not.
    public i32 scrollY() const {
        ret i32(partScroll(id))
    }

    // Scrolls the panel so that 'y', in logical pixels from the top of its content, is
    // at its top edge: 0 goes back to the top. At the next frame the value is kept
    // between 0 and the most that the components of the panel allow.
    public void scrollTo(i32 y) const {
        setPartScroll(id, f32(y))
    }

    // Moves the panel, in logical pixels from the top left corner of its parent: the content of
    // the window, or the group, the panel or the dialog that holds it. Its anchors keep the
    // distances from the edges that it has at the new place.
    public void setPosition(i32 x, i32 y) const {
        setPartBounds(id, x, y, -1, -1)
    }

    // Changes the width and the height of the panel, in logical pixels. Its anchors keep the
    // distances from the edges that it has with the new size.
    public void setSize(i32 width, i32 height) const {
        setPartBounds(id, -1, -1, width, height)
    }

    // The distance of the panel from the left edge of its parent, in logical pixels, where its
    // anchors have placed it now.
    public i32 x() const {
        ret partBound(id, 0)
    }

    // The distance of the panel from the top edge of its parent, in logical pixels, where its
    // anchors have placed it now.
    public i32 y() const {
        ret partBound(id, 1)
    }

    // The width of the panel now, in logical pixels: a 'Stretch' anchor changes it with its
    // parent.
    public i32 width() const {
        ret partBound(id, 2)
    }

    // The height of the panel now, in logical pixels: a 'Stretch' anchor changes it with its
    // parent.
    public i32 height() const {
        ret partBound(id, 3)
    }

    // Sets the text that a small card shows when the mouse stays on the panel for a moment,
    // or after a long press on a phone: "" for none, the default; "\n" starts a new line.
    public void setTooltip(string text) const {
        setPartTooltip(id, text)
    }

    // The text of the tooltip of the panel, "" for none.
    public string tooltip() const {
        ret partTooltip(id)
    }

    // Shows or hides the panel, and its components with it.
    public void setVisible(bool value) const {
        setPartFlag(id, 0, value)
    }

    // Whether the panel is visible, as 'setVisible' set it: true by default.
    public bool visible() const {
        ret partFlag(id, 0)
    }

    // Enables or disables the panel, and its components with it: disabled, they are drawn at
    // half their opacity and take neither the mouse nor the keys.
    public void setEnabled(bool value) const {
        setPartFlag(id, 1, value)
    }

    // Whether the panel is enabled, as 'setEnabled' set it: true by default.
    public bool enabled() const {
        ret partFlag(id, 1)
    }

    // Sets which edges of its parent the panel follows when the parent changes size: the
    // window, or the group, the panel or the dialog that holds it. It keeps the distances from
    // those edges that it has now, as 'setAnchor(gui.Horizontal.Right, gui.Vertical.Bottom)' in
    // the bottom right corner. By default it is anchored to the left and to the top, and does
    // not move.
    public void setAnchor(Horizontal horizontal, Vertical vertical) const {
        setPartAnchor(id, horizontal, vertical)
    }

    // How the panel follows the left and the right edges of its parent: 'Horizontal.Left' by
    // default.
    public Horizontal horizontalAnchor() const {
        ret partHorizontal(id)
    }

    // How the panel follows the top and the bottom edges of its parent: 'Vertical.Top' by
    // default.
    public Vertical verticalAnchor() const {
        ret partVertical(id)
    }
}

// The bar at the top of an app: its title, an icon on its left, as a menu or an arrow
// back, and the icons of its actions on its right. Put in a window with 'add', it takes
// the top of the content, the whole width and 44 pixels, 56 on a phone: the other components of the
// window go under it, and the pages of a navigation bar start there by themselves. On
// the desktop it is under the title bar of the window.
//
// '''
// gui.AppBar top = w.add(gui.AppBar("Inbox"))
// top.setNavigation(gui.Icon.Menu)
// top.onNavigation([]() { println("the menu") })
// top.addAction(gui.Icon.Search, [w]() { w.showSnackbar("Search") })
// '''
public struct AppBar : Component {
    i64 id

    // An app bar with its title, to put in a window with 'add'. A window has one at most:
    // a second one, or an app bar put in a group, a panel or a dialog, is a panic of
    // 'add'.
    public AppBar(string title) {
        id = newPart(kindAppBar, title, 0, 0, 0, i32(appBarHeight()))
    }

    i64 componentId() const {
        ret id
    }

    // Changes the title of the bar.
    public void setTitle(string value) const {
        setPartText(id, value)
    }

    // The title of the bar.
    public string title() const {
        ret partText(id, false)
    }

    // Puts an icon on the left of the bar, as 'Icon.Menu' or 'Icon.ArrowLeft', which
    // calls the handlers of 'onNavigation' when it is clicked; 'Icon.None' removes it.
    public void setNavigation(Icon value) const {
        setPartIcon(id, value)
    }

    // The icon on the left of the bar, 'Icon.None' without one.
    public Icon navigation() const {
        ret partIcon(id)
    }

    // Adds a handler, called on the thread of the windows when the user clicks or
    // touches the icon on the left of the bar.
    public void onNavigation(move func() handler) const {
        addr box = alloc(sizeOf<func()>())
        put<func()>(box, move handler)
        addPartHandler(id, 0, box)
    }

    // Adds an icon on the right of the bar, with the handler that a click or a touch on
    // it calls on the thread of the windows. The first action added is at the right
    // edge, and each next one on the left of the one before.
    public void addAction(Icon icon, move func() handler) const {
        addr box = alloc(sizeOf<func()>())
        put<func()>(box, move handler)
        i64 me = id
        withData([me, icon, box](ref Shared data) {
            i64 p = partIndexOf(ref data, me)
            data.parts[p].icons.add(icon)
            data.parts[p].actions.add(box)
        })
    }

    // The distance of the app bar from the left edge of the content: 0.
    public i32 x() const {
        ret partBound(id, 0)
    }

    // The distance of the app bar from the top of the content: 0.
    public i32 y() const {
        ret partBound(id, 1)
    }

    // The width of the app bar, in logical pixels: that of the content of its window, once it
    // is in one.
    public i32 width() const {
        ret partBound(id, 2)
    }

    // The height of the app bar: 56 logical pixels.
    public i32 height() const {
        ret partBound(id, 3)
    }

    // Shows or hides the app bar: the room that it takes at the top stays empty.
    public void setVisible(bool value) const {
        setPartFlag(id, 0, value)
    }

    // Whether the app bar is visible, as 'setVisible' set it: true by default.
    public bool visible() const {
        ret partFlag(id, 0)
    }

    // Enables or disables the app bar: disabled, it is drawn at half its opacity and its icons
    // do not respond.
    public void setEnabled(bool value) const {
        setPartFlag(id, 1, value)
    }

    // Whether the app bar is enabled, as 'setEnabled' set it: true by default.
    public bool enabled() const {
        ret partFlag(id, 1)
    }
}

// The bar at the bottom of an app, whose items, an icon and a text each, choose the
// page that is shown. A window has one, made the first time that 'Window.navigationBar'
// is called: it takes the bottom of the content, the whole width and 56 pixels, 64 on a phone. Each
// page is a panel that fills the room between it and the app bar, and scrolls when its
// components go below its bottom. On a phone the keyboard on the screen covers the
// bar, and the pages go down to the keyboard.
//
// '''
// gui.NavigationBar bar = w.navigationBar()
// gui.Panel home = bar.addPage("Home", gui.Icon.House)
// home.add(gui.Label("Welcome", 16, 16, 200, 20))
// gui.Panel settings = bar.addPage("Settings", gui.Icon.Settings)
// bar.onChange([top](i64 index) { top.setTitle(index == 0 ? "Home" : "Settings") })
// '''
public struct NavigationBar : Component {
    i64 id

    NavigationBar(i64 number) {
        id = number
    }

    i64 componentId() const {
        ret id
    }

    // Adds an item with its text and its icon, and gives back its page: a panel that
    // fills the room between the bars, follows the size of the window, and is shown
    // while its item is chosen. Its components take their positions from its top left
    // corner; its own position and size are those of the room, whatever is set.
    public Panel addPage(string text, Icon icon) const {
        i64 me = id
        i64 made = 0
        withData([me, text, icon, ref made](ref Shared data) {
            i64 p = partIndexOf(ref data, me)
            made = makePart(ref data, kindPanel, "", 0, 0, 0, 0)
            i64 page = partIndexOf(ref data, made)
            data.parts[page].page = data.parts[p].items.len()
            data.parts[page].bar = me
            data.parts[page].window = data.parts[p].window
            data.parts[p].items.add(text)
            data.parts[p].icons.add(icon)
            data.parts[p].pages.add(made)
            arrangeNow(ref data, page)
        })
        Panel page
        page.id = made
        ret page
    }

    // Chooses the item at 'index', from 0, and shows its page, without calling the
    // handlers of 'onChange'. An index out of the items is a panic.
    public void setSelected(i64 index) const {
        i64 me = id
        withData([me, index](ref Shared data) {
            i64 p = partIndexOf(ref data, me)
            if (index < 0 || index >= data.parts[p].items.len()) {
                panic(format("the navigation bar has no item {}", index))
            }
            data.parts[p].selected = index
        })
    }

    // The index of the item chosen, whose page is shown: 0 at the start.
    public i64 selected() const {
        i64 me = id
        i64 result = 0
        withData([me, ref result](ref Shared data) { result = data.parts[partIndexOf(ref data, me)].selected })
        ret result
    }

    // Adds a handler, called on the thread of the windows with the index of the item
    // that the user chooses, when it is not the one chosen before. 'setSelected' does
    // not call it.
    public void onChange(move func(i64) handler) const {
        addr box = alloc(sizeOf<func(i64)>())
        put<func(i64)>(box, move handler)
        addPartHandler(id, 1, box)
    }

    // The distance of the navigation bar from the left edge of the content: 0.
    public i32 x() const {
        ret partBound(id, 0)
    }

    // The distance of the navigation bar from the top of the content, in logical pixels: the
    // height of the content less the 64 of the bar.
    public i32 y() const {
        ret partBound(id, 1)
    }

    // The width of the navigation bar, in logical pixels: that of the content of its window.
    public i32 width() const {
        ret partBound(id, 2)
    }

    // The height of the navigation bar: 64 logical pixels.
    public i32 height() const {
        ret partBound(id, 3)
    }

    // Shows or hides the navigation bar, and its pages with it.
    public void setVisible(bool value) const {
        setPartFlag(id, 0, value)
    }

    // Whether the navigation bar is visible, as 'setVisible' set it: true by default.
    public bool visible() const {
        ret partFlag(id, 0)
    }

    // Enables or disables the navigation bar: disabled, it is drawn at half its opacity and its
    // items do not respond; its pages stay as they are.
    public void setEnabled(bool value) const {
        setPartFlag(id, 1, value)
    }

    // Whether the navigation bar is enabled, as 'setEnabled' set it: true by default.
    public bool enabled() const {
        ret partFlag(id, 1)
    }
}

// A list of items in rows of 44 pixels, 56 on a phone, as those of an app of mail: each has an icon
// or a round image, a title, a line under it and a text on its right, as a time, all
// optional. Only the rows that are seen are drawn, so a list can have thousands of
// items, and it scrolls as a panel, with a finger, the wheel or its bar. The item
// chosen stays lit: a click, a touch, or Up, Down, Home, End, Page Up and Page Down
// while the list has the keyboard, choose an item and call the handlers of 'onChoose'
// with its index.
//
// '''
// gui.ListView inbox = page.add(gui.ListView(0, 0, 390, 605))
// inbox.setAnchor(gui.Horizontal.Stretch, gui.Vertical.Stretch)
// inbox.addItem(gui.Icon.User, "Ada Lovelace", "The notes on the engine", "10:42")
// inbox.addItem(gui.Icon.Mail, "The workshop", "The report of the day", "Mon")
// inbox.setItemImageBytes(0, embed("images/ada.png"))
// inbox.onChoose([inbox](i64 index) { println("open {}", inbox.itemTitle(index)) })
// '''
public struct ListView : Component {
    i64 id

    // An empty list. 'x' and 'y' are in logical pixels from the top left corner of its
    // parent, the window, the group, the panel or the dialog whose 'add' puts it there,
    // and 'width' and 'height' its size.
    public ListView(i32 x, i32 y, i32 width, i32 height) {
        id = newPart(kindListView, "", x, y, width, height)
    }

    i64 componentId() const {
        ret id
    }

    // Adds an item at the end: its icon, its title, the line under the title and the
    // text on the right, with 'Icon.None' and "" for what the item does not have.
    public void addItem(Icon icon, string title, string subtitle, string detail) const {
        i64 me = id
        withData([me, icon, title, subtitle, detail](ref Shared data) {
            i64 p = partIndexOf(ref data, me)
            data.parts[p].icons.add(icon)
            data.parts[p].items.add(title)
            data.parts[p].subtitles.add(subtitle)
            data.parts[p].details.add(detail)
            addr none
            data.parts[p].images.add(none)
            data.parts[p].textures.add(none)
        })
    }

    // Inserts an item before the one at 'index', or at the end with 'count()', with the
    // same parts as 'addItem'. The item chosen stays the same, at its new index. An
    // index below 0 or above 'count()' is a panic.
    public void insertItem(i64 index, Icon icon, string title, string subtitle, string detail) const {
        i64 me = id
        withData([me, index, icon, title, subtitle, detail](ref Shared data) {
            i64 p = partIndexOf(ref data, me)
            if (index < 0 || index > data.parts[p].items.len()) {
                panic(format("the list has no place {}", index))
            }
            data.parts[p].icons.insert(index, icon)
            data.parts[p].items.insert(index, title)
            data.parts[p].subtitles.insert(index, subtitle)
            data.parts[p].details.insert(index, detail)
            addr none
            data.parts[p].images.insert(index, none)
            data.parts[p].textures.insert(index, none)
            if (data.parts[p].selected >= index) {
                data.parts[p].selected++
            }
        })
    }

    // Replaces the icon and the texts of the item at 'index', which keeps its image and
    // stays chosen if it is. An index out of the items is a panic.
    public void setItem(i64 index, Icon icon, string title, string subtitle, string detail) const {
        i64 me = id
        withData([me, index, icon, title, subtitle, detail](ref Shared data) {
            i64 p = listIndex(ref data, me, index)
            data.parts[p].icons[index] = icon
            data.parts[p].items[index] = title
            data.parts[p].subtitles[index] = subtitle
            data.parts[p].details[index] = detail
        })
    }

    // Removes the item at 'index', with its image; if it was the item chosen, none is.
    // The items after it go back by one, and so does the index of the item chosen. An
    // index out of the items is a panic.
    public void removeItem(i64 index) const {
        i64 me = id
        withData([me, index](ref Shared data) {
            i64 p = listIndex(ref data, me, index)
            data.parts[p].icons.remove(index)
            data.parts[p].items.remove(index)
            data.parts[p].subtitles.remove(index)
            data.parts[p].details.remove(index)
            dropImage(ref data.parts[p], index)
            data.parts[p].images.remove(index)
            data.parts[p].textures.remove(index)
            if (data.parts[p].selected == index) {
                data.parts[p].selected = -1
            } else if (data.parts[p].selected > index) {
                data.parts[p].selected--
            }
        })
    }

    // Removes all the items, with their images, leaves none chosen, and scrolls back to
    // the top.
    public void clear() const {
        i64 me = id
        withData([me](ref Shared data) {
            i64 p = partIndexOf(ref data, me)
            data.parts[p].icons.clear()
            data.parts[p].items.clear()
            data.parts[p].subtitles.clear()
            data.parts[p].details.clear()
            for (i64 i = 0; i < data.parts[p].images.len(); i++) {
                dropImage(ref data.parts[p], i)
            }
            data.parts[p].images.clear()
            data.parts[p].textures.clear()
            data.parts[p].selected = -1
            data.parts[p].offsetY = 0
        })
    }

    // How many items the list has.
    public i64 count() const {
        i64 me = id
        i64 result = 0
        withData([me, ref result](ref Shared data) { result = data.parts[partIndexOf(ref data, me)].items.len() })
        ret result
    }

    // The title of the item at 'index'. An index out of the items is a panic.
    public string itemTitle(i64 index) const {
        i64 me = id
        string result
        withData([me, index, ref result](ref Shared data) { result = data.parts[listIndex(ref data, me, index)].items[index] })
        ret result
    }

    // The line under the title of the item at 'index', "" if it has none. An index out of
    // the items is a panic.
    public string itemSubtitle(i64 index) const {
        i64 me = id
        string result
        withData([me, index, ref result](ref Shared data) { result = data.parts[listIndex(ref data, me, index)].subtitles[index] })
        ret result
    }

    // The text on the right of the item at 'index', "" if it has none. An index out of the
    // items is a panic.
    public string itemDetail(i64 index) const {
        i64 me = id
        string result
        withData([me, index, ref result](ref Shared data) { result = data.parts[listIndex(ref data, me, index)].details[index] })
        ret result
    }

    // The icon of the item at 'index', 'Icon.None' if it has none. An index out of the
    // items is a panic.
    public Icon itemIcon(i64 index) const {
        i64 me = id
        Icon result = Icon.None
        withData([me, index, ref result](ref Shared data) { result = data.parts[listIndex(ref data, me, index)].icons[index] })
        ret result
    }

    // Chooses the item at 'index', which stays lit, or none with -1, without calling the
    // handlers of 'onChoose' and without scrolling to it, which 'scrollTo' does. Another
    // index out of the items is a panic.
    public void setSelected(i64 index) const {
        i64 me = id
        withData([me, index](ref Shared data) {
            i64 p = partIndexOf(ref data, me)
            if (index != -1) {
                listIndex(ref data, me, index)
            }
            data.parts[p].selected = index
        })
    }

    // The index of the item chosen, from 0, or -1 when none is: the default.
    public i64 selected() const {
        i64 me = id
        i64 result = -1
        withData([me, ref result](ref Shared data) { result = data.parts[partIndexOf(ref data, me)].selected })
        ret result
    }

    // Adds a handler, called on the thread of the windows with the index of the item
    // that the user chooses, with a click, a touch or the keys, also when it was the item
    // chosen already. 'setSelected' does not call it.
    public void onChoose(move func(i64) handler) const {
        addr box = alloc(sizeOf<func(i64)>())
        put<func(i64)>(box, move handler)
        addPartHandler(id, 1, box)
    }

    // Shows a round image of 40 pixels in place of the icon of the item at 'index', as
    // the photo of a contact: the square at the center of the image of 'file', in PNG,
    // JPEG, BMP or GIF, read and decoded by this thread. "" removes it. Throws an
    // 'Error' when the file cannot be read, is empty or is not an image; an index out of
    // the items is a panic.
    public void setItemImage(i64 index, string file) const {
        list<u8> bytes
        if (file.len() > 0) {
            bytes = fs.readBytes(file)
        }
        setRoundImage(id, index, file, bytes)
    }

    // Shows a round image in place of the icon of the item at 'index', as
    // 'setItemImage' does, from an image in memory, as 'embed' gives it; an empty list
    // removes it. Throws an 'Error' when the bytes are not an image; an index out of the
    // items is a panic.
    public void setItemImageBytes(i64 index, list<u8> bytes) const {
        setRoundImage(id, index, "", bytes)
    }

    // Scrolls the list as little as it takes to show the item at 'index'. An index out
    // of the items is a panic.
    public void scrollTo(i64 index) const {
        i64 me = id
        withData([me, index](ref Shared data) {
            i64 p = listIndex(ref data, me, index)
            showRow(ref data.parts[p], index)
        })
    }

    // Moves the list, in logical pixels from the top left corner of its parent: the content of
    // the window, or the group, the panel or the dialog that holds it. Its anchors keep the
    // distances from the edges that it has at the new place.
    public void setPosition(i32 x, i32 y) const {
        setPartBounds(id, x, y, -1, -1)
    }

    // Changes the width and the height of the list, in logical pixels. Its anchors keep the
    // distances from the edges that it has with the new size.
    public void setSize(i32 width, i32 height) const {
        setPartBounds(id, -1, -1, width, height)
    }

    // The distance of the list from the left edge of its parent, in logical pixels, where its
    // anchors have placed it now.
    public i32 x() const {
        ret partBound(id, 0)
    }

    // The distance of the list from the top edge of its parent, in logical pixels, where its
    // anchors have placed it now.
    public i32 y() const {
        ret partBound(id, 1)
    }

    // The width of the list now, in logical pixels: a 'Stretch' anchor changes it with its
    // parent.
    public i32 width() const {
        ret partBound(id, 2)
    }

    // The height of the list now, in logical pixels: a 'Stretch' anchor changes it with its
    // parent.
    public i32 height() const {
        ret partBound(id, 3)
    }

    // Sets the text that a small card shows when the mouse stays on the list: hidden for a moment,
    // or after a long press on a phone: "" for none, the default; "\n" starts a new line.
    public void setTooltip(string text) const {
        setPartTooltip(id, text)
    }

    // The text of the tooltip of the list: hidden, "" for none.
    public string tooltip() const {
        ret partTooltip(id)
    }

    // Shows or hides the list: hidden, it takes neither the mouse nor the keys.
    public void setVisible(bool value) const {
        setPartFlag(id, 0, value)
    }

    // Whether the list is visible, as 'setVisible' set it: true by default.
    public bool visible() const {
        ret partFlag(id, 0)
    }

    // Enables or disables the list: disabled, it is drawn at half its opacity and takes neither
    // the mouse nor the keys.
    public void setEnabled(bool value) const {
        setPartFlag(id, 1, value)
    }

    // Whether the list is enabled, as 'setEnabled' set it: true by default.
    public bool enabled() const {
        ret partFlag(id, 1)
    }

    // Sets which edges of its parent the list follows when the parent changes size: the window,
    // or the group, the panel or the dialog that holds it. It keeps the distances from those
    // edges that it has now, as 'setAnchor(gui.Horizontal.Right, gui.Vertical.Bottom)' in the
    // bottom right corner. By default it is anchored to the left and to the top, and does not
    // move.
    public void setAnchor(Horizontal horizontal, Vertical vertical) const {
        setPartAnchor(id, horizontal, vertical)
    }

    // How the list follows the left and the right edges of its parent: 'Horizontal.Left' by
    // default.
    public Horizontal horizontalAnchor() const {
        ret partHorizontal(id)
    }

    // How the list follows the top and the bottom edges of its parent: 'Vertical.Top' by
    // default.
    public Vertical verticalAnchor() const {
        ret partVertical(id)
    }
}

// A switch, on or off, as those in the settings of a phone: its text on the left and
// the switch at the right edge of its box. A click, a touch, or Space while it has the
// keyboard, turns it, and calls its handlers of 'onChange' with the new state.
//
// '''
// gui.Switch notify = w.add(gui.Switch("Notifications", 16, 16, 358, 32))
// notify.setChecked(true)
// notify.onChange([](bool on) { println("notifications: {}", on) })
// '''
public struct Switch : Component {
    i64 id

    // A switch with its text, off. 'x' and 'y' are in logical pixels from the top left
    // corner of its parent, the window, the group, the panel or the dialog whose 'add'
    // puts it there, and 'width' and 'height' its size, with the text.
    public Switch(string text, i32 x, i32 y, i32 width, i32 height) {
        id = newPart(kindSwitch, text, x, y, width, height)
    }

    i64 componentId() const {
        ret id
    }

    // Adds a handler, called on the thread of the windows with the new state when the
    // user turns the switch on or off. 'setChecked' does not call it.
    public void onChange(move func(bool) handler) const {
        addr box = alloc(sizeOf<func(bool)>())
        put<func(bool)>(box, move handler)
        addPartHandler(id, 1, box)
    }

    // Turns the switch on, with true, or off, without calling the handlers of
    // 'onChange'.
    public void setChecked(bool value) const {
        setPartFlag(id, 2, value)
    }

    // Whether the switch is on: false at the start.
    public bool checked() const {
        ret partFlag(id, 2)
    }

    // Changes the text on the left of the switch.
    public void setText(string value) const {
        setPartText(id, value)
    }

    // The text on the left of the switch.
    public string text() const {
        ret partText(id, false)
    }

    // Moves the switch, in logical pixels from the top left corner of its parent: the content
    // of the window, or the group, the panel or the dialog that holds it. Its anchors keep the
    // distances from the edges that it has at the new place.
    public void setPosition(i32 x, i32 y) const {
        setPartBounds(id, x, y, -1, -1)
    }

    // Changes the width and the height of the switch, in logical pixels. Its anchors keep the
    // distances from the edges that it has with the new size.
    public void setSize(i32 width, i32 height) const {
        setPartBounds(id, -1, -1, width, height)
    }

    // The distance of the switch from the left edge of its parent, in logical pixels, where its
    // anchors have placed it now.
    public i32 x() const {
        ret partBound(id, 0)
    }

    // The distance of the switch from the top edge of its parent, in logical pixels, where its
    // anchors have placed it now.
    public i32 y() const {
        ret partBound(id, 1)
    }

    // The width of the switch now, in logical pixels: a 'Stretch' anchor changes it with its
    // parent.
    public i32 width() const {
        ret partBound(id, 2)
    }

    // The height of the switch now, in logical pixels: a 'Stretch' anchor changes it with its
    // parent.
    public i32 height() const {
        ret partBound(id, 3)
    }

    // Sets the text that a small card shows when the mouse stays on the switch: hidden for a moment,
    // or after a long press on a phone: "" for none, the default; "\n" starts a new line.
    public void setTooltip(string text) const {
        setPartTooltip(id, text)
    }

    // The text of the tooltip of the switch: hidden, "" for none.
    public string tooltip() const {
        ret partTooltip(id)
    }

    // Shows or hides the switch: hidden, it takes neither the mouse nor the keys.
    public void setVisible(bool value) const {
        setPartFlag(id, 0, value)
    }

    // Whether the switch is visible, as 'setVisible' set it: true by default.
    public bool visible() const {
        ret partFlag(id, 0)
    }

    // Enables or disables the switch: disabled, it is drawn at half its opacity and takes
    // neither the mouse nor the keys.
    public void setEnabled(bool value) const {
        setPartFlag(id, 1, value)
    }

    // Whether the switch is enabled, as 'setEnabled' set it: true by default.
    public bool enabled() const {
        ret partFlag(id, 1)
    }

    // Sets which edges of its parent the switch follows when the parent changes size: the
    // window, or the group, the panel or the dialog that holds it. It keeps the distances from
    // those edges that it has now, as 'setAnchor(gui.Horizontal.Right, gui.Vertical.Bottom)' in
    // the bottom right corner. By default it is anchored to the left and to the top, and does
    // not move.
    public void setAnchor(Horizontal horizontal, Vertical vertical) const {
        setPartAnchor(id, horizontal, vertical)
    }

    // How the switch follows the left and the right edges of its parent: 'Horizontal.Left' by
    // default.
    public Horizontal horizontalAnchor() const {
        ret partHorizontal(id)
    }

    // How the switch follows the top and the bottom edges of its parent: 'Vertical.Top' by
    // default.
    public Vertical verticalAnchor() const {
        ret partVertical(id)
    }
}

// An integer between a minimum and a maximum, as a volume or a quantity, chosen by
// dragging the knob, with a click on the track, or with the keys while the slider has
// the keyboard: Left and Down take 1, Right and Up add 1, Page Down and Page Up move by
// a tenth of the range, Home and End go to the minimum and to the maximum. A value with
// decimals comes from dividing it. Its handlers of 'onChange' receive the new value,
// also while the knob is dragged.
//
// '''
// gui.Label size = w.add(gui.Label("Text size: 100%", 16, 64, 358, 20))
// gui.Slider zoom = w.add(gui.Slider(80, 150, 16, 88, 358, 32))
// zoom.setValue(100)
// zoom.onChange([size](i64 value) { size.setText(format("Text size: {}%", value)) })
// '''
public struct Slider : Component {
    i64 id

    // A slider from 'minimum' to 'maximum', both included, at the minimum. 'x' and 'y'
    // are in logical pixels from the top left corner of its parent, the window, the
    // group, the panel or the dialog whose 'add' puts it there, and 'width' and 'height'
    // its size. A minimum above the maximum is a panic.
    public Slider(i64 minimum, i64 maximum, i32 x, i32 y, i32 width, i32 height) {
        if (minimum > maximum) {
            panic(format("the minimum of the slider, {}, is above its maximum, {}", minimum, maximum))
        }
        id = newPart(kindSlider, "", x, y, width, height)
        i64 me = id
        withData([me, minimum, maximum](ref Shared data) {
            i64 p = partIndexOf(ref data, me)
            data.parts[p].minimum = minimum
            data.parts[p].maximum = maximum
            data.parts[p].value = minimum
        })
    }

    i64 componentId() const {
        ret id
    }

    // Adds a handler, called on the thread of the windows with the new value whenever
    // the user changes it, also while the knob is dragged. 'setValue' does not call it.
    public void onChange(move func(i64) handler) const {
        addr box = alloc(sizeOf<func(i64)>())
        put<func(i64)>(box, move handler)
        addPartHandler(id, 1, box)
    }

    // Sets the value, kept between the minimum and the maximum, without calling the
    // handlers of 'onChange'.
    public void setValue(i64 value) const {
        i64 me = id
        withData([me, value](ref Shared data) {
            i64 p = partIndexOf(ref data, me)
            i64 low = data.parts[p].minimum
            i64 high = data.parts[p].maximum
            data.parts[p].value = value < low ? low : value > high ? high : value
        })
    }

    // The value now, between the minimum and the maximum.
    public i64 value() const {
        i64 me = id
        i64 result = 0
        withData([me, ref result](ref Shared data) { result = data.parts[partIndexOf(ref data, me)].value })
        ret result
    }

    // The smallest value, at the left end of the track.
    public i64 minimum() const {
        i64 me = id
        i64 result = 0
        withData([me, ref result](ref Shared data) { result = data.parts[partIndexOf(ref data, me)].minimum })
        ret result
    }

    // The largest value, at the right end of the track.
    public i64 maximum() const {
        i64 me = id
        i64 result = 0
        withData([me, ref result](ref Shared data) { result = data.parts[partIndexOf(ref data, me)].maximum })
        ret result
    }

    // Moves the slider, in logical pixels from the top left corner of its parent: the content
    // of the window, or the group, the panel or the dialog that holds it. Its anchors keep the
    // distances from the edges that it has at the new place.
    public void setPosition(i32 x, i32 y) const {
        setPartBounds(id, x, y, -1, -1)
    }

    // Changes the width and the height of the slider, in logical pixels. Its anchors keep the
    // distances from the edges that it has with the new size.
    public void setSize(i32 width, i32 height) const {
        setPartBounds(id, -1, -1, width, height)
    }

    // The distance of the slider from the left edge of its parent, in logical pixels, where its
    // anchors have placed it now.
    public i32 x() const {
        ret partBound(id, 0)
    }

    // The distance of the slider from the top edge of its parent, in logical pixels, where its
    // anchors have placed it now.
    public i32 y() const {
        ret partBound(id, 1)
    }

    // The width of the slider now, in logical pixels: a 'Stretch' anchor changes it with its
    // parent.
    public i32 width() const {
        ret partBound(id, 2)
    }

    // The height of the slider now, in logical pixels: a 'Stretch' anchor changes it with its
    // parent.
    public i32 height() const {
        ret partBound(id, 3)
    }

    // Sets the text that a small card shows when the mouse stays on the slider: hidden for a moment,
    // or after a long press on a phone: "" for none, the default; "\n" starts a new line.
    public void setTooltip(string text) const {
        setPartTooltip(id, text)
    }

    // The text of the tooltip of the slider: hidden, "" for none.
    public string tooltip() const {
        ret partTooltip(id)
    }

    // Shows or hides the slider: hidden, it takes neither the mouse nor the keys.
    public void setVisible(bool value) const {
        setPartFlag(id, 0, value)
    }

    // Whether the slider is visible, as 'setVisible' set it: true by default.
    public bool visible() const {
        ret partFlag(id, 0)
    }

    // Enables or disables the slider: disabled, it is drawn at half its opacity and takes
    // neither the mouse nor the keys.
    public void setEnabled(bool value) const {
        setPartFlag(id, 1, value)
    }

    // Whether the slider is enabled, as 'setEnabled' set it: true by default.
    public bool enabled() const {
        ret partFlag(id, 1)
    }

    // Sets which edges of its parent the slider follows when the parent changes size: the
    // window, or the group, the panel or the dialog that holds it. It keeps the distances from
    // those edges that it has now, as 'setAnchor(gui.Horizontal.Right, gui.Vertical.Bottom)' in
    // the bottom right corner. By default it is anchored to the left and to the top, and does
    // not move.
    public void setAnchor(Horizontal horizontal, Vertical vertical) const {
        setPartAnchor(id, horizontal, vertical)
    }

    // How the slider follows the left and the right edges of its parent: 'Horizontal.Left' by
    // default.
    public Horizontal horizontalAnchor() const {
        ret partHorizontal(id)
    }

    // How the slider follows the top and the bottom edges of its parent: 'Vertical.Top' by
    // default.
    public Vertical verticalAnchor() const {
        ret partVertical(id)
    }
}

// Rows of cells in columns, with their titles at the top (D486-D489): also millions
// of rows, since the table keeps only those near the ones shown. It knows how many
// rows it has, and asks for those it must show and does not have with 'onNeedRows';
// the program gives them with 'setRows', also later and from another thread, and a
// row not given yet is empty. A small table gives all its rows at once.
//
// A click on the title of a column calls 'onSort', and the program sorts its rows and
// gives them again. A click chooses a row, Ctrl and a click add or remove one, Shift
// and a click choose those between; the arrows, Page Up, Page Down, Home and End move
// the row chosen, and a double click or Enter opens it, with 'onChoose'.
//
// '''
// gui.Table orders = w.add(gui.Table(16, 16, 600, 400))
// orders.addColumn("Customer", 0, gui.Horizontal.Left)    // the room left
// orders.addColumn("Total", 96, gui.Horizontal.Right)
// orders.setRowCount(1000000)
// orders.onNeedRows([orders](i64 first, i64 count) {
//     list<list<string>> rows
//     for (i64 i = first; i < first + count; i++) {
//         rows.add([format("Customer {}", i), format("{}.00", i % 1000)])
//     }
//     orders.setRows(first, rows)
// })
// '''
public struct Table : Component {
    i64 id

    // A table without columns and without rows. 'x' and 'y' are in logical pixels from
    // the top left corner of its parent, the window, the group, the panel or the dialog
    // whose 'add' puts it there, and 'width' and 'height' its size.
    public Table(i32 x, i32 y, i32 width, i32 height) {
        id = newPart(kindTable, "", x, y, width, height)
    }

    i64 componentId() const {
        ret id
    }

    // Adds a column at the right of the others, with its title and its width in logical
    // pixels; a width of 0 takes the room that the others leave, shared among the
    // columns of width 0. 'align' places the title and the cells: 'Horizontal.Left',
    // 'Center' or 'Right'.
    public void addColumn(string title, i32 width, Horizontal align) const {
        i64 me = id
        withData([me, title, width, align](ref Shared data) {
            TableColumn column
            column.title = title
            column.width = width
            column.align = align
            data.parts[partIndexOf(ref data, me)].columns.add(move column)
        })
    }

    // The number of the columns, also those hidden.
    public i64 columnCount() const {
        i64 me = id
        i64 count = 0
        withData([me, ref count](ref Shared data) { count = data.parts[partIndexOf(ref data, me)].columns.len() })
        ret count
    }

    // Shows or hides the column at 'index', from 0; the others take its place. An index
    // out of the columns is a panic.
    public void setColumnVisible(i64 index, bool visible) const {
        i64 me = id
        withData([me, index, visible](ref Shared data) {
            i64 p = partIndexOf(ref data, me)
            if (index < 0 || index >= data.parts[p].columns.len()) {
                panic(format("the table has no column {}", index))
            }
            data.parts[p].columns[index].visible = visible
        })
    }

    // Changes the number of the rows. The rows already given stay, those beyond the
    // number are forgotten, and so are the chosen ones beyond it.
    public void setRowCount(i64 count) const {
        i64 me = id
        withData([me, count](ref Shared data) {
            i64 p = partIndexOf(ref data, me)
            data.parts[p].tableRows = count > 0 ? count : 0
            trimSelection(ref data.parts[p])
            forgetBeyond(ref data.parts[p])
        })
    }

    // The number of the rows.
    public i64 rowCount() const {
        i64 me = id
        i64 count = 0
        withData([me, ref count](ref Shared data) { count = data.parts[partIndexOf(ref data, me)].tableRows })
        ret count
    }

    // Gives the cells of the rows from 'first', a list of strings for each row, in the
    // order of the columns. It can be called from any thread, as the answer to
    // 'onNeedRows' or before; the rows beyond the number of the rows are ignored.
    public void setRows(i64 first, list<list<string>> rows) const {
        i64 me = id
        withData([me, first, rows](ref Shared data) {
            i64 p = partIndexOf(ref data, me)
            for (i64 k = 0; k < rows.len(); k++) {
                i64 row = first + k
                if (row >= 0 && row < data.parts[p].tableRows) {
                    data.parts[p].cells[row] = rows[k]
                }
            }
        })
    }

    // Forgets all the rows given, as after the rows were sorted or filtered: the table
    // asks again for those it shows. The rows chosen stay.
    public void clearRows() const {
        i64 me = id
        withData([me](ref Shared data) {
            i64 p = partIndexOf(ref data, me)
            map<i64, list<string>> none
            map<i64, bool> nothing
            data.parts[p].cells = move none
            data.parts[p].asked = move nothing
        })
    }

    // The cell of a row and a column, from 0, or "" when the row has not been given.
    public string cell(i64 row, i64 column) const {
        i64 me = id
        string value
        withData([me, row, column, ref value](ref Shared data) {
            i64 p = partIndexOf(ref data, me)
            if (data.parts[p].cells.contains(row)) {
                list<string> cells = data.parts[p].cells[row]
                if (column >= 0 && column < cells.len()) {
                    value = cells[column]
                }
            }
        })
        ret value
    }

    // Adds a handler, called on the thread of the windows when the table shows rows that
    // it does not have: 'first' and 'count', the rows to give with 'setRows'. It asks
    // for each row once, in blocks of 100, until 'clearRows'.
    public void onNeedRows(move func(i64, i64) handler) const {
        addr box = alloc(sizeOf<func(i64, i64)>())
        put<func(i64, i64)>(box, move handler)
        addPartHandler(id, 7, box)
    }

    // Adds a handler, called on the thread of the windows when the user clicks the title
    // of a column: the column, from 0, and whether the order is descending, true at the
    // second click on the same column. The table shows the order with an arrow; the
    // program sorts its rows and gives them again.
    public void onSort(move func(i64, bool) handler) const {
        addr box = alloc(sizeOf<func(i64, bool)>())
        put<func(i64, bool)>(box, move handler)
        addPartHandler(id, 8, box)
    }

    // Shows the order of a column, -1 for none, without calling the handlers of 'onSort'.
    public void setSort(i64 column, bool descending) const {
        i64 me = id
        withData([me, column, descending](ref Shared data) {
            i64 p = partIndexOf(ref data, me)
            data.parts[p].sortColumn = column
            data.parts[p].sortDescending = descending
        })
    }

    // The column of the order, or -1.
    public i64 sortColumn() const {
        i64 me = id
        i64 column = -1
        withData([me, ref column](ref Shared data) { column = data.parts[partIndexOf(ref data, me)].sortColumn })
        ret column
    }

    // Whether the order is descending.
    public bool sortDescending() const {
        i64 me = id
        bool descending = false
        withData([me, ref descending](ref Shared data) { descending = data.parts[partIndexOf(ref data, me)].sortDescending })
        ret descending
    }

    // Adds a handler, called on the thread of the windows when the row chosen changes,
    // with a click or with the keys: the row, from 0. With Ctrl and Shift the rows chosen
    // can be more: 'selectedRows' gives them all.
    public void onChange(move func(i64) handler) const {
        addr box = alloc(sizeOf<func(i64)>())
        put<func(i64)>(box, move handler)
        addPartHandler(id, 1, box)
    }

    // Adds a handler, called on the thread of the windows when the user opens a row: a
    // double click on it, or Enter while the table has the keyboard.
    public void onChoose(move func(i64) handler) const {
        addr box = alloc(sizeOf<func(i64)>())
        put<func(i64)>(box, move handler)
        addPartHandler(id, 9, box)
    }

    // Chooses only the row at 'index', or none with -1, and scrolls to show it, without
    // calling the handlers of 'onChange'. An index out of the rows is a panic.
    public void setSelected(i64 index) const {
        i64 me = id
        withData([me, index](ref Shared data) {
            i64 p = partIndexOf(ref data, me)
            if (index < -1 || index >= data.parts[p].tableRows) {
                panic(format("the table has no row {}: it has {}", index, data.parts[p].tableRows))
            }
            selectOnly(ref data.parts[p], index)
            if (index >= 0) {
                showTableRow(ref data.parts[p], index)
            }
        })
    }

    // The row chosen last, from 0, or -1 for none.
    public i64 selected() const {
        i64 me = id
        i64 row = -1
        withData([me, ref row](ref Shared data) { row = data.parts[partIndexOf(ref data, me)].selected })
        ret row
    }

    // All the rows chosen, in order. Shift and a click on a table of millions of rows
    // can choose millions of them.
    public list<i64> selectedRows() const {
        i64 me = id
        list<i64> rows
        withData([me, ref rows](ref Shared data) {
            i64 p = partIndexOf(ref data, me)
            for (i64 k = 0; k + 1 < data.parts[p].ranges.len(); k += 2) {
                for (i64 row = data.parts[p].ranges[k]; row < data.parts[p].ranges[k + 1]; row++) {
                    rows.add(row)
                }
            }
        })
        ret rows
    }

    // Scrolls the table to show the row at 'index', from 0.
    public void scrollTo(i64 index) const {
        i64 me = id
        withData([me, index](ref Shared data) {
            i64 p = partIndexOf(ref data, me)
            if (index >= 0 && index < data.parts[p].tableRows) {
                showTableRow(ref data.parts[p], index)
            }
        })
    }

    // Moves the table, in logical pixels from the top left corner of its parent: the content of
    // the window, or the group, the panel or the dialog that holds it. Its anchors keep the
    // distances from the edges that it has at the new place.
    public void setPosition(i32 x, i32 y) const {
        setPartBounds(id, x, y, -1, -1)
    }

    // Changes the width and the height of the table, in logical pixels. Its anchors keep the
    // distances from the edges that it has with the new size.
    public void setSize(i32 width, i32 height) const {
        setPartBounds(id, -1, -1, width, height)
    }

    // The distance of the table from the left edge of its parent, in logical pixels, where its
    // anchors have placed it now.
    public i32 x() const {
        ret partBound(id, 0)
    }

    // The distance of the table from the top edge of its parent, in logical pixels, where its
    // anchors have placed it now.
    public i32 y() const {
        ret partBound(id, 1)
    }

    // The width of the table now, in logical pixels: a 'Stretch' anchor changes it with its
    // parent.
    public i32 width() const {
        ret partBound(id, 2)
    }

    // The height of the table now, in logical pixels: a 'Stretch' anchor changes it with its
    // parent.
    public i32 height() const {
        ret partBound(id, 3)
    }

    // Sets the text that a small card shows when the mouse stays on the table for a moment,
    // or after a long press on a phone: "" for none, the default; "\n" starts a new line.
    public void setTooltip(string text) const {
        setPartTooltip(id, text)
    }

    // The text of the tooltip of the table, "" for none.
    public string tooltip() const {
        ret partTooltip(id)
    }

    // Shows or hides the table.
    public void setVisible(bool value) const {
        setPartFlag(id, 0, value)
    }

    // Whether the table is visible, as 'setVisible' set it: true by default.
    public bool visible() const {
        ret partFlag(id, 0)
    }

    // Enables or disables the table: disabled, it is drawn at half its opacity.
    public void setEnabled(bool value) const {
        setPartFlag(id, 1, value)
    }

    // Whether the table is enabled, as 'setEnabled' set it: true by default.
    public bool enabled() const {
        ret partFlag(id, 1)
    }

    // Sets which edges of its parent the table follows when the parent changes size: the
    // window, or the group, the panel or the dialog that holds it. It keeps the distances from
    // those edges that it has now, as 'setAnchor(gui.Horizontal.Right, gui.Vertical.Bottom)' in
    // the bottom right corner. By default it is anchored to the left and to the top, and does
    // not move.
    public void setAnchor(Horizontal horizontal, Vertical vertical) const {
        setPartAnchor(id, horizontal, vertical)
    }

    // How the table follows the left and the right edges of its parent: 'Horizontal.Left' by
    // default.
    public Horizontal horizontalAnchor() const {
        ret partHorizontal(id)
    }

    // How the table follows the top and the bottom edges of its parent: 'Vertical.Top' by
    // default.
    public Vertical verticalAnchor() const {
        ret partVertical(id)
    }
}

// Rich text, which a 'TextView' shows (D490): pieces of text in their styles, which go
// to the next line by themselves, at the spaces and at the gaps; small images among
// them; new lines; and blocks, with a margin on their left and a line along it. A
// piece made with 'link' has a number, and the view says when the user clicks it. A
// rich text is a value: the program builds it, on any thread, and hands it to the view
// with 'TextView.setText', which keeps it until the next one.
//
// '''
// gui.TextStyle plain = gui.TextStyle(gui.Ink.Normal)
// gui.TextStyle code = gui.TextStyle(gui.Ink.Accent)
// code.mono = true
// gui.RichText t
// t.text("Call ", plain)
// t.link(1, "connect()", code)
// t.text(" before you send.", plain)
// t.startBlock(14, gui.BlockLine.Selection)
// t.text("It waits at most 5 seconds.", plain)
// t.endBlock()
// view.setText(move t)
// '''
public struct RichText {
    list<Run> runs
    i64 open  // the blocks started and not ended

    // Adds a text in a style. It breaks into lines at its spaces, and "\n" starts a new
    // line.
    public void text(string value, TextStyle style) {
        addRuns(ref runs, -1, value, style)
    }

    // Adds a text that the user can click, with the number of its piece, from 0: the
    // texts and the images that follow one another with the same number are one piece,
    // which does not break into lines, is lit under the mouse and is marked as a whole.
    // A number less than 0 is a panic.
    public void link(i64 piece, string value, TextStyle style) {
        if (piece < 0) {
            panic(format("the number of a piece of rich text is from 0, found {}", piece))
        }
        addRuns(ref runs, piece, value, style)
    }

    // Adds an image among the words, as large as 'width' by 'height' logical pixels allow
    // with its proportions, in the middle of the line.
    public void image(Image picture, f32 width, f32 height) {
        runs.add(imageRun(-1, picture, width, height))
    }

    // Adds an image that the user can click, as a part of the piece with that number, as
    // 'link' does with a text.
    public void linkImage(i64 piece, Image picture, f32 width, f32 height) {
        if (piece < 0) {
            panic(format("the number of a piece of rich text is from 0, found {}", piece))
        }
        runs.add(imageRun(piece, picture, width, height))
    }

    // Adds an empty space 'width' logical pixels wide, where the line can break, as a
    // space can.
    public void gap(f32 width) {
        Run r
        r.kind = 3
        r.width = width > 0 ? width : 0
        runs.add(move r)
    }

    // Ends the line: what follows starts on the next one. Two new lines leave an empty
    // line between.
    public void newLine() {
        Run r
        r.kind = 4
        runs.add(move r)
    }

    // Starts a block on a new line, 'indent' logical pixels from the left of the text
    // around it, with a line along its left edge, as 'line' says; its text starts 10
    // pixels after the line. Blocks can be inside blocks.
    public void startBlock(f32 indent, BlockLine line) {
        Run r
        r.kind = 5
        r.width = indent > 0 ? indent : 0
        r.line = line
        runs.add(move r)
        open++
    }

    // Ends the last block started: what follows goes on under it, at the left of the text
    // around it. Without a block started it is a panic.
    public void endBlock() {
        if (open == 0) {
            panic("endBlock without a block started with startBlock")
        }
        Run r
        r.kind = 6
        runs.add(move r)
        open--
    }

    // Removes everything.
    public void clear() {
        runs.clear()
        open = 0
    }

    // The number of the parts added: texts, images, gaps, new lines, starts and ends of
    // blocks.
    public i64 len() const {
        ret runs.len()
    }
}

// A view of rich text (D490), as an article, a log, a discussion or a list of links: it
// shows the 'RichText' given to 'setText' on the surface, goes to the next line
// by itself at its width, and scrolls when the text is longer than its height. It says
// which piece the user clicks, with any button, and marks one piece, as the current one,
// in the accent.
//
// '''
// gui.TextView notes = w.add(gui.TextView(16, 16, 360, 240))
// notes.setText(move t)
// notes.onClick([notes](i64 piece, gui.Mouse m) { notes.setMarked(piece) })
// '''
public struct TextView : Component {
    i64 id

    // A text view, empty. 'x' and 'y' are in logical pixels from the top left corner of its
    // parent, the window, the group, the panel or the dialog whose 'add' puts it there, and
    // 'width' and 'height' its size.
    public TextView(i32 x, i32 y, i32 width, i32 height) {
        id = newPart(kindTextView, "", x, y, width, height)
    }

    i64 componentId() const {
        ret id
    }

    // Shows the rich text, in place of the one shown before, and stays where it was
    // scrolled. It can be called from any thread; the blocks not ended end with the text.
    public void setText(move RichText text) const {
        addr box = alloc(sizeOf<RichText>())
        put<RichText>(box, move text)
        i64 me = id
        withData([me, box](ref Shared data) {
            i64 p = partIndexOf(ref data, me)
            data.parts[p].rich = take<RichText>(box)
            data.parts[p].richChanged = true
        })
        free(box)
    }

    // Adds a handler, called on the thread of the windows when the user clicks a piece made
    // with 'link' or 'linkImage', with any button of the mouse: the number of the piece, and
    // where the mouse is, from the top left corner of the view, with its button, 1 left, 2
    // middle, 3 right. A click is a press and a release on the same piece.
    public void onClick(move func(i64, Mouse) handler) const {
        addr box = alloc(sizeOf<func(i64, Mouse)>())
        put<func(i64, Mouse)>(box, move handler)
        addPartHandler(id, 10, box)
    }

    // Marks the piece with that number in the accent, semibold, as the current one, and
    // scrolls as little as it takes to show it; -1 marks none. A number that the text does
    // not have marks nothing.
    public void setMarked(i64 piece) const {
        i64 me = id
        withData([me, piece](ref Shared data) {
            i64 p = partIndexOf(ref data, me)
            data.parts[p].marked = piece >= 0 ? piece : -1
            data.parts[p].reveal = piece
        })
    }

    // The number of the piece marked, or -1.
    public i64 marked() const {
        i64 me = id
        i64 piece = -1
        withData([me, ref piece](ref Shared data) { piece = data.parts[partIndexOf(ref data, me)].marked })
        ret piece
    }

    // Scrolls the view as little as it takes to show the piece with that number.
    public void scrollTo(i64 piece) const {
        i64 me = id
        withData([me, piece](ref Shared data) { data.parts[partIndexOf(ref data, me)].reveal = piece })
    }

    // How far the view is scrolled, in logical pixels from the top: 0 when it is not.
    public i32 scrollY() const {
        ret i32(partScroll(id))
    }

    // Sets the size of the text, in logical pixels, from 6 to 72, to which the scale of the
    // styles applies: by default that of the text of the components, 13 on the desktop
    // and 14 on a phone. A size out of the range is a panic.
    public void setTextSize(f32 size) const {
        if (size < 6 || size > 72) {
            panic(format("the size of the text is from 6 to 72, found {}", size))
        }
        i64 me = id
        withData([me, size](ref Shared data) { data.parts[partIndexOf(ref data, me)].textSize = size })
    }

    // The size of the text, in logical pixels.
    public f32 textSize() const {
        i64 me = id
        f32 size = 0
        withData([me, ref size](ref Shared data) { size = data.parts[partIndexOf(ref data, me)].textSize })
        ret size > 0 ? size : bodySize()
    }

    // Sets the height of the lines, from the size of their text: from 1 to 3, 1.5 by
    // default. A value out of the range is a panic.
    public void setLineSpacing(f32 value) const {
        if (value < 1 || value > 3) {
            panic(format("the spacing of the lines is from 1 to 3, found {}", value))
        }
        i64 me = id
        withData([me, value](ref Shared data) { data.parts[partIndexOf(ref data, me)].lineSpacing = value })
    }

    // The height of the lines, from the size of their text.
    public f32 lineSpacing() const {
        i64 me = id
        f32 value = 0
        withData([me, ref value](ref Shared data) { value = data.parts[partIndexOf(ref data, me)].lineSpacing })
        ret value
    }

    // Moves the view, in logical pixels from the top left corner of its parent: the content of
    // the window, or the group, the panel or the dialog that holds it. Its anchors keep the
    // distances from the edges that it has at the new place.
    public void setPosition(i32 x, i32 y) const {
        setPartBounds(id, x, y, -1, -1)
    }

    // Changes the width and the height of the view, in logical pixels. Its anchors keep the
    // distances from the edges that it has with the new size.
    public void setSize(i32 width, i32 height) const {
        setPartBounds(id, -1, -1, width, height)
    }

    // The distance of the view from the left edge of its parent, in logical pixels, where its
    // anchors have placed it now.
    public i32 x() const {
        ret partBound(id, 0)
    }

    // The distance of the view from the top edge of its parent, in logical pixels, where its
    // anchors have placed it now.
    public i32 y() const {
        ret partBound(id, 1)
    }

    // The width of the view now, in logical pixels: a 'Stretch' anchor changes it with its
    // parent.
    public i32 width() const {
        ret partBound(id, 2)
    }

    // The height of the view now, in logical pixels: a 'Stretch' anchor changes it with its
    // parent.
    public i32 height() const {
        ret partBound(id, 3)
    }

    // Sets the text that a small card shows when the mouse stays on the view for a moment,
    // or after a long press on a phone: "" for none, the default; "\n" starts a new line.
    public void setTooltip(string text) const {
        setPartTooltip(id, text)
    }

    // The text of the tooltip of the view, "" for none.
    public string tooltip() const {
        ret partTooltip(id)
    }

    // Shows or hides the view.
    public void setVisible(bool value) const {
        setPartFlag(id, 0, value)
    }

    // Whether the view is visible, as 'setVisible' set it: true by default.
    public bool visible() const {
        ret partFlag(id, 0)
    }

    // Enables or disables the view: disabled, it is drawn at half its opacity.
    public void setEnabled(bool value) const {
        setPartFlag(id, 1, value)
    }

    // Whether the view is enabled, as 'setEnabled' set it: true by default.
    public bool enabled() const {
        ret partFlag(id, 1)
    }

    // Sets which edges of its parent the view follows when the parent changes size: the
    // window, or the group, the panel or the dialog that holds it. It keeps the distances from
    // those edges that it has now, as 'setAnchor(gui.Horizontal.Right, gui.Vertical.Bottom)' in
    // the bottom right corner. By default it is anchored to the left and to the top, and does
    // not move.
    public void setAnchor(Horizontal horizontal, Vertical vertical) const {
        setPartAnchor(id, horizontal, vertical)
    }

    // How the view follows the left and the right edges of its parent: 'Horizontal.Left' by
    // default.
    public Horizontal horizontalAnchor() const {
        ret partHorizontal(id)
    }

    // How the view follows the top and the bottom edges of its parent: 'Vertical.Top' by
    // default.
    public Vertical verticalAnchor() const {
        ret partVertical(id)
    }
}

// Pages one over the other in a card, with their tabs in the band at its top (D494): a
// click on a tab shows its page, and while the tabs have the keyboard Left, Right,
// Home and End choose one. Each page is a panel that fills the card under the band,
// with its components; the first tab is chosen at the start.
//
// '''
// gui.TabView views = w.add(gui.TabView(16, 16, 520, 300))
// gui.Panel files = views.addPage("Files")
// files.add(gui.ListView(0, 0, 518, 267))
// gui.Panel notes = views.addPage("Notes")
// views.onChange([](i64 index) { println("tab {}", index) })
// '''
public struct TabView : Component {
    i64 id

    // A card without tabs. 'x' and 'y' are in logical pixels from the top left corner of
    // its parent, the window, the group, the panel or the dialog whose 'add' puts it there,
    // and 'width' and 'height' its size, with the band of the tabs.
    public TabView(i32 x, i32 y, i32 width, i32 height) {
        id = newPart(kindTabView, "", x, y, width, height)
        i64 me = id
        withData([me](ref Shared data) { data.parts[partIndexOf(ref data, me)].selected = 0 })
    }

    i64 componentId() const {
        ret id
    }

    // Adds a tab with its title, on the right of the others, and gives back its page: a
    // panel that fills the card under the band and follows its size, shown while its tab
    // is chosen. Its components take their positions from its top left corner; its own
    // position and size are those of the card, whatever is set.
    public Panel addPage(string title) const {
        i64 me = id
        i64 made = 0
        withData([me, title, ref made](ref Shared data) {
            i64 p = partIndexOf(ref data, me)
            made = makePart(ref data, kindPanel, "", 0, 0, 0, 0)
            i64 page = partIndexOf(ref data, made)
            data.parts[page].page = data.parts[p].items.len()
            data.parts[page].bar = me
            data.parts[page].parent = me
            data.parts[page].window = data.parts[p].window
            data.parts[p].items.add(title)
            data.parts[p].pages.add(made)
            arrangeNow(ref data, page)
        })
        Panel page
        page.id = made
        ret page
    }

    // The number of the tabs.
    public i64 pageCount() const {
        i64 me = id
        i64 count = 0
        withData([me, ref count](ref Shared data) { count = data.parts[partIndexOf(ref data, me)].items.len() })
        ret count
    }

    // Changes the title of the tab at 'index', from 0. An index out of the tabs is a panic.
    public void setPageTitle(i64 index, string title) const {
        i64 me = id
        withData([me, index, title](ref Shared data) {
            i64 p = partIndexOf(ref data, me)
            if (index < 0 || index >= data.parts[p].items.len()) {
                panic(format("the tab view has no tab {}", index))
            }
            data.parts[p].items[index] = title
        })
    }

    // The title of the tab at 'index', from 0. An index out of the tabs is a panic.
    public string pageTitle(i64 index) const {
        i64 me = id
        string title
        withData([me, index, ref title](ref Shared data) {
            i64 p = partIndexOf(ref data, me)
            if (index < 0 || index >= data.parts[p].items.len()) {
                panic(format("the tab view has no tab {}", index))
            }
            title = data.parts[p].items[index]
        })
        ret title
    }

    // Chooses the tab at 'index', from 0, and shows its page, without calling the handlers
    // of 'onChange'. An index out of the tabs is a panic.
    public void setSelected(i64 index) const {
        i64 me = id
        withData([me, index](ref Shared data) {
            i64 p = partIndexOf(ref data, me)
            if (index < 0 || index >= data.parts[p].items.len()) {
                panic(format("the tab view has no tab {}", index))
            }
            data.parts[p].selected = index
        })
    }

    // The index of the tab chosen, whose page is shown: 0 at the start.
    public i64 selected() const {
        i64 me = id
        i64 result = 0
        withData([me, ref result](ref Shared data) { result = data.parts[partIndexOf(ref data, me)].selected })
        ret result
    }

    // Adds a handler, called on the thread of the windows with the index of the tab that
    // the user chooses, when it is not the one chosen before. 'setSelected' does not call
    // it.
    public void onChange(move func(i64) handler) const {
        addr box = alloc(sizeOf<func(i64)>())
        put<func(i64)>(box, move handler)
        addPartHandler(id, 1, box)
    }

    // Moves the tab view, in logical pixels from the top left corner of its parent: the content of
    // the window, or the group, the panel or the dialog that holds it. Its anchors keep the
    // distances from the edges that it has at the new place.
    public void setPosition(i32 x, i32 y) const {
        setPartBounds(id, x, y, -1, -1)
    }

    // Changes the width and the height of the tab view, in logical pixels. Its anchors keep the
    // distances from the edges that it has with the new size.
    public void setSize(i32 width, i32 height) const {
        setPartBounds(id, -1, -1, width, height)
    }

    // The distance of the tab view from the left edge of its parent, in logical pixels, where its
    // anchors have placed it now.
    public i32 x() const {
        ret partBound(id, 0)
    }

    // The distance of the tab view from the top edge of its parent, in logical pixels, where its
    // anchors have placed it now.
    public i32 y() const {
        ret partBound(id, 1)
    }

    // The width of the tab view now, in logical pixels: a 'Stretch' anchor changes it with its
    // parent.
    public i32 width() const {
        ret partBound(id, 2)
    }

    // The height of the tab view now, in logical pixels: a 'Stretch' anchor changes it with its
    // parent.
    public i32 height() const {
        ret partBound(id, 3)
    }

    // Sets the text that a small card shows when the mouse stays on the tab view for a moment,
    // or after a long press on a phone: "" for none, the default; "\n" starts a new line.
    public void setTooltip(string text) const {
        setPartTooltip(id, text)
    }

    // The text of the tooltip of the tab view, "" for none.
    public string tooltip() const {
        ret partTooltip(id)
    }

    // Shows or hides the tab view.
    public void setVisible(bool value) const {
        setPartFlag(id, 0, value)
    }

    // Whether the tab view is visible, as 'setVisible' set it: true by default.
    public bool visible() const {
        ret partFlag(id, 0)
    }

    // Enables or disables the tab view: disabled, it is drawn at half its opacity.
    public void setEnabled(bool value) const {
        setPartFlag(id, 1, value)
    }

    // Whether the tab view is enabled, as 'setEnabled' set it: true by default.
    public bool enabled() const {
        ret partFlag(id, 1)
    }

    // Sets which edges of its parent the tab view follows when the parent changes size: the
    // window, or the group, the panel or the dialog that holds it. It keeps the distances from
    // those edges that it has now, as 'setAnchor(gui.Horizontal.Right, gui.Vertical.Bottom)' in
    // the bottom right corner. By default it is anchored to the left and to the top, and does
    // not move.
    public void setAnchor(Horizontal horizontal, Vertical vertical) const {
        setPartAnchor(id, horizontal, vertical)
    }

    // How the tab view follows the left and the right edges of its parent: 'Horizontal.Left' by
    // default.
    public Horizontal horizontalAnchor() const {
        ret partHorizontal(id)
    }

    // How the tab view follows the top and the bottom edges of its parent: 'Vertical.Top' by
    // default.
    public Vertical verticalAnchor() const {
        ret partVertical(id)
    }
}

// A row of buttons joined together, one of them chosen and filled with the accent
// (D495): a choice among a few values that are all seen, as a view by day, by week or
// by month. The segments share the width in equal parts. A click chooses one, and while
// it has the keyboard Left, Right, Home and End do.
//
// '''
// gui.Segmented period = w.add(gui.Segmented(["Day", "Week", "Month"], 16, 16, 240, 28))
// period.onChange([](i64 index) { println("period {}", index) })
// '''
public struct Segmented : Component {
    i64 id

    // A segmented control with a copy of its segments, the first one chosen. 'x' and 'y'
    // are in logical pixels from the top left corner of its parent, the window, the group,
    // the panel or the dialog whose 'add' puts it there, and 'width' and 'height' its size.
    public Segmented(list<string> segments, i32 x, i32 y, i32 width, i32 height) {
        id = newPart(kindSegmented, "", x, y, width, height)
        setSegments(id, segments)
    }

    i64 componentId() const {
        ret id
    }

    // Replaces the segments with a copy of 'segments', and chooses the first one.
    public void setItems(list<string> segments) const {
        setSegments(id, segments)
    }

    // A copy of the segments.
    public list<string> items() const {
        list<string> result
        i64 me = id
        withData([me, ref result](ref Shared data) { result = data.parts[partIndexOf(ref data, me)].items })
        ret result
    }

    // Chooses the segment at 'index', from 0, without calling the handlers of 'onChange'.
    // An index out of the segments is a panic.
    public void setSelected(i64 index) const {
        i64 me = id
        withData([me, index](ref Shared data) {
            i64 p = partIndexOf(ref data, me)
            if (index < 0 || index >= data.parts[p].items.len()) {
                panic(format("the segmented control has no segment {}", index))
            }
            data.parts[p].selected = index
        })
    }

    // The index of the segment chosen, from 0: -1 only without segments.
    public i64 selected() const {
        i64 me = id
        i64 result = -1
        withData([me, ref result](ref Shared data) { result = data.parts[partIndexOf(ref data, me)].selected })
        ret result
    }

    // The text of the segment chosen, or "" without segments.
    public string text() const {
        i64 me = id
        string result
        withData([me, ref result](ref Shared data) {
            i64 p = partIndexOf(ref data, me)
            if (data.parts[p].selected >= 0) {
                result = data.parts[p].items[data.parts[p].selected]
            }
        })
        ret result
    }

    // Adds a handler, called on the thread of the windows with the index of the segment
    // that the user chooses, when it is not the one chosen before. 'setSelected' and
    // 'setItems' do not call it.
    public void onChange(move func(i64) handler) const {
        addr box = alloc(sizeOf<func(i64)>())
        put<func(i64)>(box, move handler)
        addPartHandler(id, 1, box)
    }

    // Moves the segmented control, in logical pixels from the top left corner of its parent: the content of
    // the window, or the group, the panel or the dialog that holds it. Its anchors keep the
    // distances from the edges that it has at the new place.
    public void setPosition(i32 x, i32 y) const {
        setPartBounds(id, x, y, -1, -1)
    }

    // Changes the width and the height of the segmented control, in logical pixels. Its anchors keep the
    // distances from the edges that it has with the new size.
    public void setSize(i32 width, i32 height) const {
        setPartBounds(id, -1, -1, width, height)
    }

    // The distance of the segmented control from the left edge of its parent, in logical pixels, where its
    // anchors have placed it now.
    public i32 x() const {
        ret partBound(id, 0)
    }

    // The distance of the segmented control from the top edge of its parent, in logical pixels, where its
    // anchors have placed it now.
    public i32 y() const {
        ret partBound(id, 1)
    }

    // The width of the segmented control now, in logical pixels: a 'Stretch' anchor changes it with its
    // parent.
    public i32 width() const {
        ret partBound(id, 2)
    }

    // The height of the segmented control now, in logical pixels: a 'Stretch' anchor changes it with its
    // parent.
    public i32 height() const {
        ret partBound(id, 3)
    }

    // Sets the text that a small card shows when the mouse stays on the segmented control for a moment,
    // or after a long press on a phone: "" for none, the default; "\n" starts a new line.
    public void setTooltip(string text) const {
        setPartTooltip(id, text)
    }

    // The text of the tooltip of the segmented control, "" for none.
    public string tooltip() const {
        ret partTooltip(id)
    }

    // Shows or hides the segmented control.
    public void setVisible(bool value) const {
        setPartFlag(id, 0, value)
    }

    // Whether the segmented control is visible, as 'setVisible' set it: true by default.
    public bool visible() const {
        ret partFlag(id, 0)
    }

    // Enables or disables the segmented control: disabled, it is drawn at half its opacity.
    public void setEnabled(bool value) const {
        setPartFlag(id, 1, value)
    }

    // Whether the segmented control is enabled, as 'setEnabled' set it: true by default.
    public bool enabled() const {
        ret partFlag(id, 1)
    }

    // Sets which edges of its parent the segmented control follows when the parent changes size: the
    // window, or the group, the panel or the dialog that holds it. It keeps the distances from
    // those edges that it has now, as 'setAnchor(gui.Horizontal.Right, gui.Vertical.Bottom)' in
    // the bottom right corner. By default it is anchored to the left and to the top, and does
    // not move.
    public void setAnchor(Horizontal horizontal, Vertical vertical) const {
        setPartAnchor(id, horizontal, vertical)
    }

    // How the segmented control follows the left and the right edges of its parent: 'Horizontal.Left' by
    // default.
    public Horizontal horizontalAnchor() const {
        ret partHorizontal(id)
    }

    // How the segmented control follows the top and the bottom edges of its parent: 'Vertical.Top' by
    // default.
    public Vertical verticalAnchor() const {
        ret partVertical(id)
    }
}

// A menu of items, as the one that the right button opens (D496): a value that the
// program builds when it needs it, with a handler for each item, which captures what the
// menu is about, and opens with 'Window.showMenu' where the mouse is. It goes away when
// an item is chosen, with Esc, or with a click out of it; Up, Down and Enter choose with
// the keys. On a phone a long press on a piece of rich text is the right button.
//
// '''
// view.onClick([w](i64 piece, gui.Mouse m) {
//     if (m.button == 3) {
//         gui.Menu menu
//         menu.addItem("Copy", [piece]() { println("copy {}", piece) })
//         menu.addSeparator()
//         menu.addItem("Delete", [piece]() { println("delete {}", piece) })
//         w.showMenu(move menu)
//     }
// })
// '''
public struct Menu {
    list<MenuItem> items
    list<func()> actions

    // Adds an item with its text under the others, and its handler, called on the thread
    // of the windows when the user chooses it, after the menu has gone away.
    public void addItem(string text, move func() handler) {
        MenuItem item
        item.text = text
        item.action = actions.len()
        actions.add(move handler)
        items.add(move item)
    }

    // Adds an item with an icon on the left of its text, as 'addItem' does.
    public void addIconItem(Icon icon, string text, move func() handler) {
        MenuItem item
        item.text = text
        item.icon = icon
        item.action = actions.len()
        actions.add(move handler)
        items.add(move item)
    }

    // Adds a line between the items above and those below.
    public void addSeparator() {
        MenuItem line
        line.separator = true
        items.add(move line)
    }

    // Enables or disables the entry at 'index', from 0, counting the separators too: a
    // disabled item is gray and cannot be chosen. An index out of the entries, or that of
    // a separator, is a panic.
    public void setEnabled(i64 index, bool enabled) {
        if (index < 0 || index >= items.len() || items[index].separator) {
            panic(format("the menu has no item {}", index))
        }
        items[index].enabled = enabled
    }

    // The number of the entries: the items and the separators.
    public i64 len() const {
        ret items.len()
    }

    // Removes all the entries.
    public void clear() {
        items.clear()
        actions.clear()
    }
}

// What a canvas shows (D483): its shapes, each drawn over the ones before it. The
// positions are in logical pixels from the top left corner of the canvas. A drawing is
// a value: the program builds it, on any thread, and hands it to the canvas with
// 'Canvas.setDrawing', which keeps it until the next one.
//
// '''
// gui.Drawing d
// d.rect(0, 0, 320, 200, gui.rgb(0xFFFFFF))
// d.polyline([20.0, 180.0, 120.0, 90.0, 300.0, 40.0], 3, gui.rgb(0xB4761C))
// d.circle(300, 40, 6, gui.rgb(0x2F6E8F))
// d.text("Sales", 20, 20, 13, gui.rgb(0x18212A), gui.Horizontal.Left)
// chart.setDrawing(move d)
// '''
public struct Drawing {
    list<Shape> shapes

    // A rectangle filled with a color.
    public void rect(f32 x, f32 y, f32 width, f32 height, Color color) {
        Shape s = shapeOf(1, x, y, width, height, color)
        shapes.add(move s)
    }

    // A rectangle with round corners of 'radius' pixels, filled with a color.
    public void roundRect(f32 x, f32 y, f32 width, f32 height, f32 radius, Color color) {
        Shape s = shapeOf(1, x, y, width, height, color)
        s.radius = radius
        shapes.add(move s)
    }

    // The outline of a rectangle: a line 'thickness' pixels wide inside its edges.
    public void frame(f32 x, f32 y, f32 width, f32 height, f32 thickness, Color color) {
        Shape s = shapeOf(2, x, y, width, height, color)
        s.thickness = thickness
        shapes.add(move s)
    }

    // A circle with its center at x, y, filled with a color.
    public void circle(f32 x, f32 y, f32 radius, Color color) {
        Shape s = shapeOf(3, x - radius, y - radius, 2 * radius, 2 * radius, color)
        s.radius = radius
        shapes.add(move s)
    }

    // The outline of a circle with its center at x, y: a line 'thickness' pixels wide
    // inside its radius.
    public void ring(f32 x, f32 y, f32 radius, f32 thickness, Color color) {
        Shape s = shapeOf(4, x - radius, y - radius, 2 * radius, 2 * radius, color)
        s.radius = radius
        s.thickness = thickness
        shapes.add(move s)
    }

    // A segment from x1, y1 to x2, y2, 'thickness' pixels wide, with round ends.
    public void line(f32 x1, f32 y1, f32 x2, f32 y2, f32 thickness, Color color) {
        Shape s = shapeOf(5, 0, 0, 0, 0, color)
        s.thickness = thickness
        s.points = [x1, y1, x2, y2]
        shapes.add(move s)
    }

    // A polygon filled with a color: 'points' are its corners, the x and the y of each
    // one after the other. Fewer than three corners, or an odd number of values, is a
    // panic.
    public void polygon(list<f32> points, Color color) {
        if (points.len() < 6 || points.len() % 2 != 0) {
            panic(format("a polygon needs the x and the y of three corners at least, not {} numbers", points.len()))
        }
        Shape s = shapeOf(6, 0, 0, 0, 0, color)
        s.points = points
        shapes.add(move s)
    }

    // A line through 'points', the x and the y of each one after the other, 'thickness'
    // pixels wide, with round joins and ends. Fewer than two points, or an odd number
    // of values, is a panic.
    public void polyline(list<f32> points, f32 thickness, Color color) {
        if (points.len() < 4 || points.len() % 2 != 0) {
            panic(format("a polyline needs the x and the y of two points at least, not {} numbers", points.len()))
        }
        Shape s = shapeOf(7, 0, 0, 0, 0, color)
        s.thickness = thickness
        s.points = points
        shapes.add(move s)
    }

    // An image in the rectangle, as large as the rectangle allows with its proportions,
    // at its center.
    public void image(Image picture, f32 x, f32 y, f32 width, f32 height) {
        Shape s = shapeOf(8, x, y, width, height, rgb(0xFFFFFF))
        s.image = picture.id
        shapes.add(move s)
    }

    // A line of text in Inter, 'size' pixels high. 'y' is the middle of the line, and 'x'
    // its left edge, its center or its right edge, as 'align' says: 'Horizontal.Left',
    // 'Center' or 'Right'.
    public void text(string value, f32 x, f32 y, f32 size, Color color, Horizontal align) {
        Shape s = shapeOf(9, x, y, 0, size, color)
        s.text = value
        s.align = align
        shapes.add(move s)
    }

    // Removes all the shapes.
    public void clear() {
        shapes.clear()
    }

    // The number of shapes.
    public i64 len() const {
        ret shapes.len()
    }
}

// A surface on which the program draws (D483): a chart, a map, a diagram, a game. It
// shows the 'Drawing' given to 'setDrawing', and draws it again by itself whenever it
// must; it tells where the mouse is pressed, moves and is released, so that the program
// can drag what it draws, and a new drawing takes the place of the old one. A canvas
// draws nothing else: under its shapes its parent shows.
//
// '''
// gui.Canvas chart = w.add(gui.Canvas(16, 16, 480, 320))
// gui.Drawing d
// d.rect(0, 0, 480, 320, gui.rgb(0xFFFFFF))
// d.circle(240, 160, 40, gui.rgba(0x2F6E8F, 115))
// chart.setDrawing(move d)
// chart.onMouseDown([](gui.Mouse m) { println("pressed at {}, {}", m.x, m.y) })
// '''
public struct Canvas : Component {
    i64 id

    // A canvas. 'x' and 'y' are in logical pixels from the top left corner of its parent,
    // the window, the group, the panel or the dialog whose 'add' puts it there, and
    // 'width' and 'height' its size.
    public Canvas(i32 x, i32 y, i32 width, i32 height) {
        id = newPart(kindCanvas, "", x, y, width, height)
    }

    i64 componentId() const {
        ret id
    }

    // Shows the drawing, in place of the one shown before. It can be called from any
    // thread, as often as the drawing changes: while the mouse drags a shape, at each of
    // its moves.
    public void setDrawing(move Drawing drawing) const {
        addr box = alloc(sizeOf<Drawing>())
        put<Drawing>(box, move drawing)
        i64 me = id
        withData([me, box](ref Shared data) {
            i64 p = partIndexOf(ref data, me)
            data.parts[p].drawing = take<Drawing>(box)
            data.parts[p].drawingChanged = true
        })
        free(box)
    }

    // Adds a handler, called on the thread of the windows when a button of the mouse, or
    // a finger, is pressed on the canvas. The position of 'gui.Mouse' is from the top left
    // corner of the canvas, and its button 1 left, 2 middle, 3 right. Until the button is
    // released, the canvas has the mouse: its moves and its release come to it, also
    // outside it.
    public void onMouseDown(move func(Mouse) handler) const {
        addr box = alloc(sizeOf<func(Mouse)>())
        put<func(Mouse)>(box, move handler)
        addPartHandler(id, 4, box)
    }

    // Adds a handler, called on the thread of the windows when the mouse moves over the
    // canvas, or anywhere while a button pressed on it is held. The position is from the
    // top left corner of the canvas, and the button 0.
    public void onMouseMove(move func(Mouse) handler) const {
        addr box = alloc(sizeOf<func(Mouse)>())
        put<func(Mouse)>(box, move handler)
        addPartHandler(id, 5, box)
    }

    // Adds a handler, called on the thread of the windows when the button pressed on the
    // canvas is released, wherever the mouse is. The position is from the top left
    // corner of the canvas.
    public void onMouseUp(move func(Mouse) handler) const {
        addr box = alloc(sizeOf<func(Mouse)>())
        put<func(Mouse)>(box, move handler)
        addPartHandler(id, 6, box)
    }

    // Moves the canvas, in logical pixels from the top left corner of its parent: the content of
    // the window, or the group, the panel or the dialog that holds it. Its anchors keep the
    // distances from the edges that it has at the new place.
    public void setPosition(i32 x, i32 y) const {
        setPartBounds(id, x, y, -1, -1)
    }

    // Changes the width and the height of the canvas, in logical pixels. Its anchors keep the
    // distances from the edges that it has with the new size.
    public void setSize(i32 width, i32 height) const {
        setPartBounds(id, -1, -1, width, height)
    }

    // The distance of the canvas from the left edge of its parent, in logical pixels, where its
    // anchors have placed it now.
    public i32 x() const {
        ret partBound(id, 0)
    }

    // The distance of the canvas from the top edge of its parent, in logical pixels, where its
    // anchors have placed it now.
    public i32 y() const {
        ret partBound(id, 1)
    }

    // The width of the canvas now, in logical pixels: a 'Stretch' anchor changes it with its
    // parent.
    public i32 width() const {
        ret partBound(id, 2)
    }

    // The height of the canvas now, in logical pixels: a 'Stretch' anchor changes it with its
    // parent.
    public i32 height() const {
        ret partBound(id, 3)
    }

    // Sets the text that a small card shows when the mouse stays on the canvas for a moment,
    // or after a long press on a phone: "" for none, the default; "\n" starts a new line.
    public void setTooltip(string text) const {
        setPartTooltip(id, text)
    }

    // The text of the tooltip of the canvas, "" for none.
    public string tooltip() const {
        ret partTooltip(id)
    }

    // Shows or hides the canvas.
    public void setVisible(bool value) const {
        setPartFlag(id, 0, value)
    }

    // Whether the canvas is visible, as 'setVisible' set it: true by default.
    public bool visible() const {
        ret partFlag(id, 0)
    }

    // Enables or disables the canvas: disabled, it is drawn at half its opacity.
    public void setEnabled(bool value) const {
        setPartFlag(id, 1, value)
    }

    // Whether the canvas is enabled, as 'setEnabled' set it: true by default.
    public bool enabled() const {
        ret partFlag(id, 1)
    }

    // Sets which edges of its parent the canvas follows when the parent changes size: the
    // window, or the group, the panel or the dialog that holds it. It keeps the distances from
    // those edges that it has now, as 'setAnchor(gui.Horizontal.Right, gui.Vertical.Bottom)' in
    // the bottom right corner. By default it is anchored to the left and to the top, and does
    // not move.
    public void setAnchor(Horizontal horizontal, Vertical vertical) const {
        setPartAnchor(id, horizontal, vertical)
    }

    // How the canvas follows the left and the right edges of its parent: 'Horizontal.Left' by
    // default.
    public Horizontal horizontalAnchor() const {
        ret partHorizontal(id)
    }

    // How the canvas follows the top and the bottom edges of its parent: 'Vertical.Top' by
    // default.
    public Vertical verticalAnchor() const {
        ret partVertical(id)
    }
}

// A dialog: a card with a title, its components and its buttons at the bottom, which
// 'Window.showDialog' opens at the center of the window, over the rest darkened, which
// the mouse and the keys do not reach until it closes. It is drawn inside the window,
// the same on the desktop and on a phone. Its buttons do not close it by themselves:
// their handlers call 'close'. Esc, or the back key of a phone, closes it too. A
// dialog is made once and can be shown again after it closes.
//
// '''
// gui.Dialog ask = gui.Dialog("Delete the message?", 320, 156)
// ask.add(gui.Label("It cannot be undone.", 0, 0, 272, 20))
// ask.addButton("Cancel", [ask]() { ask.close() })
// ask.addButton("Delete", [w, ask]() {
//     ask.close()
//     w.showSnackbar("Message deleted")
// })
// trash.onClick([w, ask]() { w.showDialog(ask) })
// '''
public struct Dialog {
    i64 id

    // A dialog with its title and the size of its card, in logical pixels. The title is in a band
    // at the top of the card, 32 pixels high, and the buttons in a band at the bottom, 44 pixels
    // high. The body, where 'add' puts the components, starts 14 pixels from the left edge of the
    // card and 14 under the band of the title, and ends 14 pixels above the band of the buttons:
    // 'Dialog("...", 320, 156)' has a body of 292 by 52. On a phone the bands are 40 and 60 pixels
    // high and the margins 16. The card is at most as large as the content of the window less 32
    // pixels: in a smaller window it shrinks, and the components of its body follow their anchors.
    public Dialog(string title, i32 width, i32 height) {
        i64 made = 0
        withData([ref made, title, width, height](ref Shared data) {
            made = makePart(ref data, kindDialog, title, 0, 0, width, height)
            f32 pad = dialogPadding()
            i64 body = makePart(ref data, kindPanel, "", i32(pad), i32(bandHeight() + pad), width - 2 * i32(pad),
                height - i32(bandHeight() + dialogFooter() + 2 * pad))
            i64 p = partIndexOf(ref data, body)
            data.parts[p].parent = made
            data.parts[p].horizontal = Horizontal.Stretch
            data.parts[p].vertical = Vertical.Stretch
            rebase(ref data, p)
            data.parts[partIndexOf(ref data, made)].inner = body
        })
        id = made
    }

    // Puts a component in the body of the dialog, with its position from the top left
    // corner of the body, under the title, and gives it back. A component that is
    // already in a window or in a group is a panic, and so is an app bar.
    public T add<T : Component>(T component) const {
        i64 me = id
        i64 body = 0
        withData([me, ref body](ref Shared data) { body = data.parts[partIndexOf(ref data, me)].inner })
        addPart(0, body, component.componentId())
        ret component
    }

    // Adds a button in the band at the bottom of the card, on the right of those added before, as
    // wide as its text: the last one is the main one, filled with the accent, the others are normal
    // buttons. A click, or Space and Enter while it has the keyboard, call the handler on the
    // thread of the windows; the dialog stays open until it calls 'close'.
    public void addButton(string text, move func() handler) const {
        addr box = alloc(sizeOf<func()>())
        put<func()>(box, move handler)
        i64 me = id
        withData([me, text, box](ref Shared data) {
            i64 card = partIndexOf(ref data, me)
            i64 window = data.parts[card].window
            i64 button = makePart(ref data, kindButton, text, 0, 0, 0, i32(dialogButton()))
            i64 p = partIndexOf(ref data, button)
            data.parts[p].parent = me
            data.parts[p].window = window
            data.parts[p].action = 2
            data.parts[p].click.add(box)
        })
    }

    // Closes the dialog, if a window shows it, and then calls its handlers of 'onClose'
    // on the thread of the windows; the keyboard goes back to the component that had it
    // before. A dialog that is not shown stays as it is.
    public void close() const {
        i64 me = id
        withData([me](ref Shared data) {
            for (i64 i = 0; i < data.windows.len(); i++) {
                if (data.windows[i].dialog == me) {
                    data.windows[i].dialog = 0
                    data.windows[i].dialogEnded = true
                    data.pending.add(callOf(6, data.parts[partIndexOf(ref data, me)].closing))
                }
            }
        })
    }

    // Adds a handler, called on the thread of the windows whenever the dialog closes: by
    // 'close', with Esc, or with the back key of a phone.
    public void onClose(move func() handler) const {
        addr box = alloc(sizeOf<func()>())
        put<func()>(box, move handler)
        addPartHandler(id, 3, box)
    }

    // Whether a window shows the dialog now.
    public bool shown() const {
        i64 me = id
        bool result = false
        withData([me, ref result](ref Shared data) {
            for (i64 i = 0; i < data.windows.len(); i++) {
                result = result || data.windows[i].dialog == me
            }
        })
        ret result
    }

    // Changes the title of the dialog.
    public void setTitle(string value) const {
        setPartText(id, value)
    }

    // The title of the dialog.
    public string title() const {
        ret partText(id, false)
    }
}

// ---- The data of the windows and of the components ----

struct Rect {
    f32 x
    f32 y
    f32 w
    f32 h

    Rect(f32 left, f32 top, f32 width, f32 height) {
        x = left
        y = top
        w = width
        h = height
    }
}

// What a window has: what the program asks, and what only the thread of the GUI
// uses. The handlers are in boxes on the heap, which never move: the thread of
// the GUI calls them without the lock.
struct WindowData {
    i64 id
    string title
    i32 width  // of the whole window, in logical pixels
    i32 height
    bool resizable = true
    i32 show  // what is asked: 0 normal, 1 minimized, 2 maximized
    Theme theme
    i32 fps = 60
    bool started
    bool closing
    bool notified  // its handlers of onClose are called
    bool closed    // after them
    bool titleChanged
    bool sizeChanged
    bool resizableChanged
    bool showChanged
    list<addr> mouseMove
    list<addr> mouseDown
    list<addr> mouseUp
    list<addr> keyDown
    list<addr> resize
    list<addr> close
    list<addr> back      // the back key of Android (D457)
    bool phone           // on Android: without a title bar, the content in the safe area (D456)
    f32 originX          // where the content starts in the window, in logical pixels
    f32 originY = 35     // under the title bar
    f32 insetRight       // what the bars of the system cover on Android
    f32 insetBottom      // and the keyboard on the screen (D471)
    f32 barsBottom       // what the bars cover at the bottom, without the keyboard
    f32 fullHeight       // and the height of the window
    f32 screenKeyboard   // what the keyboard on the screen covers above the bars, or 0
    bool revealFocus     // the panels scroll to show the component in focus at the next layout
    i32 systemBars = -1  // the theme of the bars of the system on Android: 0 light, 1 dark

    // The thread of the GUI.
    addr window
    addr renderer
    addr chrome
    addr font     // of the title
    addr body     // of the components
    addr strong   // of the buttons, semibold
    addr heading  // of the title of an app bar, semibold
    addr caption  // of the items of a navigation bar, semibold
    addr band     // of the titles of the bands of the groups and of the dialogs, semibold
    u32 sdlId
    f32 density = 1
    i32 hovered = -1  // the button of the title bar under the mouse
    i32 pressed = -1
    bool focused = true
    bool maximized
    bool minimized
    i64 focus            // the component with the keyboard, or 0
    i64 hot              // the component under the mouse
    i64 held             // the component pressed with the mouse
    i64 dragging         // the text box whose text the mouse selects
    i64 popup            // the combo box whose list is open
    i64 canvasHeld       // the canvas that has the mouse while the button pressed on it is held (D483)
    i32 clicks           // of the last press of the mouse: 2 for a double click
    list<Call> requests  // the rows that the tables ask for while they are drawn (D486)
    list<f32> fontSizes  // of the texts of the drawings and of the rich text, with their faces and their fonts
    list<i32> fontFaces
    list<addr> fonts
    bool hand     // the mouse is on a piece of a text view: the cursor is a hand (D490)
    i64 sideView  // the text view and the piece pressed with another button than the left one
    i64 sidePiece = -1
    i32 sideButton
    Menu menu  // the menu open (D496)
    bool menuOpen
    bool menuPlaced  // its size and its place, computed when it is first drawn
    i64 menuAnchor   // the component under which it opens, or 0 for the mouse
    f32 menuX        // in logical pixels of the window
    f32 menuY
    f32 menuW
    f32 menuH
    i64 menuHot = -1   // the item under the mouse, or chosen with the keys
    i64 menuHeld = -1  // the item pressed
    u64 hotSince       // when the mouse came on the component under it (D497)
    bool tipBlocked    // a press since then: no tooltip until it goes on another one
    i64 tipPart        // on a phone, the component whose tooltip a long press shows
    f32 tipX
    f32 tipY
    i64 longPart  // the component held with a finger, for a long press (D496)
    i64 longPiece = -1
    u64 longStart
    f32 longX
    f32 longY
    i64 appBar         // its bar at the top, or 0
    i64 navigation     // its bar at the bottom, or 0
    i64 hotItem = -1   // the item of a bar or the row of a list under the mouse
    i64 heldItem = -1  // the item of a bar or the row of a list pressed
    i64 scrolling      // the panel or the list that a finger or the mouse on its bar scrolls
    bool scrollBar     // the mouse drags its bar
    bool dragMoved     // the finger moved more than 8 pixels
    f32 dragStart
    f32 dragY
    u64 dragTime
    u64 lastFrame
    f32 pointerX = -1  // the mouse, -1 when it is out of the window
    f32 pointerY = -1
    u64 caretStart
    i64 dialog        // the dialog shown (D467), or 0
    i64 dialogStart   // where it starts in order
    i64 dialogFocus   // the component in focus before it, which has it back after
    bool dialogFresh  // the focus goes to the dialog at the next layout
    bool dialogEnded  // and comes back
    bool keyboard     // the last input was a key, not the mouse or a finger: the ring of the focus shows
    f32 snackLift     // how far the snackbar is above its place, over the components at the bottom (D472)
    string snackText  // the snackbar (D468), shown from snackShown for 4 seconds
    string snackAction
    list<addr> snackHandler
    u64 snackShown
    bool snackFresh
    bool snackHot
    bool snackHeld
    list<addr> dropped  // func(), handlers of snackbars replaced, freed by the thread of the GUI
    list<i64> order     // the indices of its components, in the order they are drawn
}

const i32 kindLabel = 1
const i32 kindButton = 2
const i32 kindTextBox = 3
const i32 kindCheckBox = 4
const i32 kindGroup = 5
const i32 kindComboBox = 6
const i32 kindImageBox = 7
const i32 kindIconBox = 8
const i32 kindPanel = 9
const i32 kindAppBar = 10
const i32 kindNavigation = 11
const i32 kindListView = 12
const i32 kindSwitch = 13
const i32 kindSlider = 14
const i32 kindDialog = 15
const i32 kindCanvas = 16
const i32 kindTable = 17
const i32 kindTextView = 18
const i32 kindTabView = 19
const i32 kindSegmented = 20

// A component: its kind, its window and its group once added, its properties, for
// a text box where its cursor and the other end of its selection are, as indices
// of bytes, and how much its text is scrolled, the items of a combo box and the
// image of an image box.
struct PartData {
    i64 id
    i64 window
    i64 parent  // its group, or 0
    i32 kind
    string text  // the file of an image box
    string placeholder
    i32 x  // now, from the top left corner of its parent (P40)
    i32 y
    i32 width
    i32 height
    Horizontal horizontal
    Vertical vertical
    i32 baseX  // as set last, when its parent had the size below (P40)
    i32 baseY
    i32 baseWidth
    i32 baseHeight
    i32 parentWidth
    i32 parentHeight
    bool visible = true
    bool enabled = true
    bool checked
    i64 caret
    i64 anchor
    f32 scroll
    list<string> items
    i64 selected = -1
    i64 first      // the first item shown in the list
    i64 highlight  // the item that the mouse or the keys point at in the list
    addr pixels    // of an image, until the thread of the GUI makes its texture
    i32 imageWidth
    i32 imageHeight
    bool imageChanged
    Scale scale
    addr texture
    Icon icon               // of an icon box, of a button, or on the left of an app bar
    list<Icon> icons        // of the actions of an app bar, of the items of a navigation bar
    list<addr> actions      // func(), of the actions of an app bar
    list<i64> pages         // of the items of a navigation bar
    i64 page = -1           // of a page, its item in its navigation bar
    list<string> subtitles  // of the items of a list
    list<string> details
    f32 offsetY          // how far a panel or a list is scrolled (D460)
    f32 content          // the height of what it has
    f32 velocity         // in logical pixels each second, after a finger leaves it
    u64 scrollShown      // when it scrolled last, for its bar
    list<addr> images    // of the items of a list: round pixels of avatarPixels, or none
    list<addr> textures  // their textures, made by the thread of the GUI
    list<addr> dropped   // textures to destroy on the thread of the GUI
    i64 value            // of a slider, between its minimum and its maximum
    i64 minimum
    i64 maximum
    u64 flipped                        // when the user changed a switch, for its knob
    i32 action                         // a button of a dialog: 1 the last, the main one, 2 the others
    Drawing drawing                    // of a canvas (D483)
    bool drawingChanged                // since its layers were drawn
    f32 drawnDensity                   // at which its layers were drawn
    list<CanvasLayer> layers           // of a canvas: its vector shapes, drawn by nanosvg
    list<CanvasTexture> imageTextures  // of a canvas: its images
    list<addr> downs                   // func(Mouse), of a canvas
    list<addr> moves
    list<addr> ups
    list<TableColumn> columns     // of a table (D486)
    i64 tableRows                 // its number of rows
    map<i64, list<string>> cells  // the rows given, near those shown
    map<i64, bool> asked          // the blocks of rows asked for
    list<i64> ranges              // the rows chosen: the first and the end of each range
    i64 anchorRow = -1            // where Shift starts
    i64 sortColumn = -1
    bool sortDescending
    list<addr> needs    // func(i64, i64), of a table
    list<addr> sorts    // func(i64, bool)
    list<addr> chooses  // func(i64)
    RichText rich       // of a text view (D490)
    bool richChanged    // since it was laid out
    TextLayout laid     // its lines
    f32 textSize        // 0 for that of the components
    f32 lineSpacing = 1.5
    i64 marked = -1     // the piece marked
    i64 reveal = -1     // the piece to show after the next layout
    list<addr> pieces   // func(i64, Mouse), of a text view
    string tooltip      // shown when the mouse stays on it (D497)
    list<f32> tabSpans  // of a tab view: the left and the width of each tab, from its left (D494)
    addr svg            // of an image box with an SVG image, and its size in bytes (D484)
    i64 svgSize
    i32 textureWidth  // the size in pixels of the texture of an SVG image
    i32 textureHeight
    ButtonStyle style   // of a button (D482)
    i64 inner           // of a dialog, the panel of its components
    list<addr> closing  // func(), of a dialog
    i64 bar             // of a page, its navigation bar
    list<addr> click    // func()
    list<addr> change   // func(string) of a text box, func(bool) of a check box, func(i64) of a combo box or a list
    list<addr> enter    // func(string)

    // Laid out by the thread of the GUI: its place in the content of the window,
    // whether it and its groups are visible and enabled, and the rectangle of
    // its groups that clips it.
    f32 left
    f32 top
    bool shown
    bool active
    f32 clipLeft
    f32 clipTop
    f32 clipRight
    f32 clipBottom
}

struct Shared {
    list<WindowData> windows
    list<PartData> parts
    list<ImageData> images  // of the drawings, by their number less 1 (D483)
    i64 next
    bool running        // the thread of the GUI
    list<Call> pending  // handlers to call on the thread of the GUI, as onClose of a dialog
}

u64 lock          // of the data of all the windows
addr shared       // Shared, from the first window
addr guiThread    // the thread of the GUI, in the runtime
addr guardThread  // the thread that waits for it (D437)
addr arrow        // the cursors of the mouse, made by the thread of the GUI
addr beam
addr pointer  // the hand, on the pieces of the rich text
i32[4] clip   // the SDL_Rect of SDL_SetRenderClipRect

// The data under the lock, as a Mutex (D216).
void withData(func(ref Shared) body) {
    mutexLock(variableAddress(lock))
    addr none
    if (shared == none) {
        shared = alloc(sizeOf<Shared>())
        Shared fresh
        put<Shared>(shared, move fresh)
    }
    Shared data = take<Shared>(shared)
    try {
        body(ref data)
    } finally {
        put<Shared>(shared, move data)
        mutexUnlock(variableAddress(lock))
    }
}

i64 indexOf(ref Shared data, i64 id) {
    for (i64 i = 0; i < data.windows.len(); i++) {
        if (data.windows[i].id == id) {
            ret i
        }
    }
    panic("the window does not exist")
}

i64 partIndexOf(ref Shared data, i64 id) {
    for (i64 i = 0; i < data.parts.len(); i++) {
        if (data.parts[i].id == id) {
            ret i
        }
    }
    panic("the component does not exist")
}

i64 newPart(i32 kind, string text, i32 x, i32 y, i32 w, i32 h) {
    i64 made = 0
    withData([ref made, kind, text, x, y, w, h](ref Shared data) { made = makePart(ref data, kind, text, x, y, w, h) })
    ret made
}

// A new component, under the lock.
i64 makePart(ref Shared data, i32 kind, string text, i32 x, i32 y, i32 w, i32 h) {
    data.next++
    PartData part
    part.id = data.next
    part.kind = kind
    part.text = text
    part.x = x
    part.y = y
    part.width = w
    part.height = h
    part.baseX = x
    part.baseY = y
    part.baseWidth = w
    part.baseHeight = h
    part.caret = text.len()
    part.anchor = part.caret
    data.parts.add(move part)
    ret data.next
}

void setPartText(i64 id, string value) {
    withData([id, value](ref Shared data) {
        i64 p = partIndexOf(ref data, id)
        data.parts[p].text = value
        data.parts[p].caret = value.len()
        data.parts[p].anchor = value.len()
    })
}

string partText(i64 id, bool placeholder) {
    string result
    withData([id, placeholder, ref result](ref Shared data) {
        i64 p = partIndexOf(ref data, id)
        result = placeholder ? data.parts[p].placeholder : data.parts[p].text
    })
    ret result
}

// A negative value leaves that one as it is.
void setPartBounds(i64 id, i32 x, i32 y, i32 w, i32 h) {
    withData([id, x, y, w, h](ref Shared data) {
        i64 p = partIndexOf(ref data, id)
        arrangeNow(ref data, p)
        if (x >= 0 || y >= 0) {
            data.parts[p].x = x
            data.parts[p].y = y
        }
        if (w >= 0 || h >= 0) {
            data.parts[p].width = w
            data.parts[p].height = h
        }
        rebase(ref data, p)
    })
}

// 0 x, 1 y, 2 width, 3 height, 4 and 5 the width and the height of an image.
i32 partBound(i64 id, i32 which) {
    i32 result = 0
    withData([id, which, ref result](ref Shared data) {
        i64 p = partIndexOf(ref data, id)
        arrangeNow(ref data, p)
        if (which == 0) {
            result = data.parts[p].x
        } else if (which == 1) {
            result = data.parts[p].y
        } else if (which == 2) {
            result = data.parts[p].width
        } else if (which == 3) {
            result = data.parts[p].height
        } else if (which == 4) {
            result = data.parts[p].imageWidth
        } else {
            result = data.parts[p].imageHeight
        }
    })
    ret result
}

// 0 visible, 1 enabled, 2 checked.
void setPartFlag(i64 id, i32 which, bool value) {
    withData([id, which, value](ref Shared data) {
        i64 p = partIndexOf(ref data, id)
        if (which == 0) {
            data.parts[p].visible = value
        } else if (which == 1) {
            data.parts[p].enabled = value
        } else {
            data.parts[p].checked = value
        }
    })
}

bool partFlag(i64 id, i32 which) {
    bool result = false
    withData([id, which, ref result](ref Shared data) {
        i64 p = partIndexOf(ref data, id)
        result = which == 0 ? data.parts[p].visible : which == 1 ? data.parts[p].enabled : data.parts[p].checked
    })
    ret result
}

// 0 click, 1 change, 2 enter.
void addPartHandler(i64 id, i32 which, addr box) {
    withData([id, which, box](ref Shared data) {
        i64 p = partIndexOf(ref data, id)
        if (which == 0) {
            data.parts[p].click.add(box)
        } else if (which == 1) {
            data.parts[p].change.add(box)
        } else if (which == 2) {
            data.parts[p].enter.add(box)
        } else if (which == 3) {
            data.parts[p].closing.add(box)
        } else if (which == 4) {
            data.parts[p].downs.add(box)
        } else if (which == 5) {
            data.parts[p].moves.add(box)
        } else if (which == 6) {
            data.parts[p].ups.add(box)
        } else if (which == 7) {
            data.parts[p].needs.add(box)
        } else if (which == 8) {
            data.parts[p].sorts.add(box)
        } else if (which == 9) {
            data.parts[p].chooses.add(box)
        } else {
            data.parts[p].pieces.add(box)
        }
    })
}

// Puts a component in a window, or in a group with window 0.
void addPart(i64 window, i64 group, i64 part) {
    withData([window, group, part](ref Shared data) {
        i64 p = partIndexOf(ref data, part)
        if (data.parts[p].window != 0 || data.parts[p].parent != 0) {
            panic("the component is already in a window or in a group")
        }
        i64 into = window
        if (data.parts[p].kind == kindAppBar && group != 0) {
            panic("an app bar is put in a window")
        }
        if (group != 0) {
            for (i64 up = group; up != 0; up = data.parts[partIndexOf(ref data, up)].parent) {
                if (up == part) {
                    panic("a group cannot contain itself")
                }
            }
            into = data.parts[partIndexOf(ref data, group)].window
            data.parts[p].parent = group
        } else {
            i64 i = indexOf(ref data, window)
            if (data.parts[p].kind == kindAppBar) {
                if (data.windows[i].appBar != 0) {
                    panic("the window has an app bar already")
                }
                data.windows[i].appBar = part
                data.parts[p].width = data.windows[i].width
                data.parts[p].horizontal = Horizontal.Stretch
            }
        }
        data.parts[p].window = into
        if (into != 0) {
            placeIn(ref data.parts, part, into)
        }
        rebase(ref data, p)
    })
}

// The components inside a group go in the window of the group.
void placeIn(ref list<PartData> parts, i64 group, i64 window) {
    for (i64 i = 0; i < parts.len(); i++) {
        if (parts[i].parent == group) {
            parts[i].window = window
            placeIn(ref parts, parts[i].id, window)
        }
    }
}

// Whether the program runs on Android (D452), where the window has no title bar.
bool onAndroid() {
    ret cText(SDL_GetPlatform()) == "Android"
}

// The size of the content of a window in logical pixels: under the title bar, or
// in the safe area on Android (D456).
i32 contentWidth(WindowData window) {
    ret window.width - i32(window.originX + window.insetRight)
}

i32 contentHeight(WindowData window) {
    ret window.height - i32(window.originY + window.insetBottom)
}

// The position and the size of a component now, for the size of its parent now
// (P40): what the thread of the GUI computes when it draws.
void arrangeNow(ref Shared data, i64 p) {
    i64 group = data.parts[p].parent
    if (data.parts[p].page >= 0 && group != 0) {  // a page of a tab view (D494)
        i64 g = partIndexOf(ref data, group)
        arrangeNow(ref data, g)
        i32 gw = data.parts[g].width
        i32 gh = data.parts[g].height
        placeTabPage(ref data.parts[p], gw, gh)
    } else if (data.parts[p].page >= 0 && data.parts[p].window != 0) {
        i64 i = indexOf(ref data, data.parts[p].window)
        placePage(ref data.parts[p], ref data.windows[i])
    } else if (group != 0) {
        i64 g = partIndexOf(ref data, group)
        arrangeNow(ref data, g)
        arrange(ref data.parts[p], data.parts[g].width, data.parts[g].height)
    } else if (data.parts[p].window != 0) {
        i64 i = indexOf(ref data, data.parts[p].window)
        arrange(ref data.parts[p], contentWidth(data.windows[i]), contentHeight(data.windows[i]))
    }
}

// A page takes the room between the bars of its window (P42), down to the keyboard
// on the screen, which covers the navigation bar (D471).
void placePage(ref PartData page, ref WindowData window) {
    i32 top = window.appBar != 0 ? i32(appBarHeight()) : 0
    i32 bottom = contentHeight(window) - (window.screenKeyboard > 0 ? 0 : i32(navigationHeight()))
    page.x = 0
    page.y = top
    page.width = contentWidth(window)
    page.height = bottom > top ? bottom - top : 0
    page.baseX = page.x
    page.baseY = page.y
    page.baseWidth = page.width
    page.baseHeight = page.height
}

// The distances that the anchors keep are those of now (P40).
void rebase(ref Shared data, i64 p) {
    i32 w = 0
    i32 h = 0
    i64 group = data.parts[p].parent
    if (group != 0) {
        i64 g = partIndexOf(ref data, group)
        arrangeNow(ref data, g)
        w = data.parts[g].width
        h = data.parts[g].height
    } else if (data.parts[p].window != 0) {
        i64 i = indexOf(ref data, data.parts[p].window)
        w = contentWidth(data.windows[i])
        h = contentHeight(data.windows[i])
    }
    data.parts[p].baseX = data.parts[p].x
    data.parts[p].baseY = data.parts[p].y
    data.parts[p].baseWidth = data.parts[p].width
    data.parts[p].baseHeight = data.parts[p].height
    data.parts[p].parentWidth = w
    data.parts[p].parentHeight = h
}

// Shows a snackbar: the handler of the one before is freed by the thread of the GUI,
// which may be calling it.
void snackbar(i64 id, string text, string action, addr box) {
    withData([id, text, action, box](ref Shared data) {
        i64 i = indexOf(ref data, id)
        for (i64 k = 0; k < data.windows[i].snackHandler.len(); k++) {
            data.windows[i].dropped.add(data.windows[i].snackHandler[k])
        }
        data.windows[i].snackHandler.clear()
        addr none
        if (box != none) {
            data.windows[i].snackHandler.add(box)
        }
        data.windows[i].snackText = text
        data.windows[i].snackAction = action
        data.windows[i].snackFresh = true  // its time from the thread of the GUI, whose clock SDL starts
        data.windows[i].snackHeld = false
    })
}

// The index of a list with its item, or a panic if it has no such item.
i64 listIndex(ref Shared data, i64 id, i64 index) {
    i64 p = partIndexOf(ref data, id)
    if (index < 0 || index >= data.parts[p].items.len()) {
        panic(format("the list has no item {}", index))
    }
    ret p
}

f32 partScroll(i64 id) {
    f32 result = 0
    withData([id, ref result](ref Shared data) { result = data.parts[partIndexOf(ref data, id)].offsetY })
    ret result
}

void setPartScroll(i64 id, f32 y) {
    withData([id, y](ref Shared data) {
        i64 p = partIndexOf(ref data, id)
        data.parts[p].offsetY = y
        data.parts[p].velocity = 0
    })
}

void setPartAnchor(i64 id, Horizontal horizontal, Vertical vertical) {
    withData([id, horizontal, vertical](ref Shared data) {
        i64 p = partIndexOf(ref data, id)
        arrangeNow(ref data, p)
        data.parts[p].horizontal = horizontal
        data.parts[p].vertical = vertical
        rebase(ref data, p)
    })
}

void setPartIcon(i64 id, Icon value) {
    withData([id, value](ref Shared data) { data.parts[partIndexOf(ref data, id)].icon = value })
}

Icon partIcon(i64 id) {
    Icon result = Icon.None
    withData([id, ref result](ref Shared data) { result = data.parts[partIndexOf(ref data, id)].icon })
    ret result
}

Horizontal partHorizontal(i64 id) {
    Horizontal result = Horizontal.Left
    withData([id, ref result](ref Shared data) { result = data.parts[partIndexOf(ref data, id)].horizontal })
    ret result
}

Vertical partVertical(i64 id) {
    Vertical result = Vertical.Top
    withData([id, ref result](ref Shared data) { result = data.parts[partIndexOf(ref data, id)].vertical })
    ret result
}

void setComboItems(i64 id, list<string> items) {
    withData([id, items](ref Shared data) {
        i64 p = partIndexOf(ref data, id)
        data.parts[p].items = items
        data.parts[p].selected = -1
        data.parts[p].first = 0
        data.parts[p].highlight = 0
    })
}

// The pixels of an image, R, G, B and A, with its size: an exception if it cannot
// be read.
addr decodeImage(string file, list<u8> bytes, ref i32 w, ref i32 h) {
    if (bytes.len() == 0) {
        throw Error(format("cannot read the image {}: the file is empty", file))
    }
    addr data = alloc(bytes.len())
    for (i64 i = 0; i < bytes.len(); i++) {
        put<u8>(offset(data, i), bytes[i])
    }
    addr reason = alloc(128)
    addr pixels = cromo_gui_image_decode(data, bytes.len(), ref w, ref h, reason, 128)
    list<u8> why = cText(reason).bytes()
    free(reason)
    if (why.len() > 0) {
        why[0] = lowerByte(why[0])  // stb_image starts with a capital
    }
    free(data)
    addr none
    if (pixels == none) {
        string what = file.len() > 0 ? format("the image {}", file) : "the image"
        throw Error(format("cannot read {}: {}", what, string(why)))
    }
    ret pixels
}

// Decodes the image of an item of a list on this thread and makes it round, or
// removes it when there is neither a file nor bytes.
void setRoundImage(i64 me, i64 index, string file, list<u8> bytes) {
    addr pixels
    if (file.len() > 0 || bytes.len() > 0) {
        i32 w = 0
        i32 h = 0
        addr whole = decodeImage(file, bytes, ref w, ref h)
        pixels = cromo_gui_image_round(whole, w, h, avatarPixels)
        cromo_gui_image_free(whole)
    }
    withData([me, index, pixels](ref Shared data) {
        i64 p = listIndex(ref data, me, index)
        dropImage(ref data.parts[p], index)
        data.parts[p].images[index] = pixels
    })
}

// The image of an item of a list goes: its pixels are freed, its texture is
// destroyed by the thread of the GUI.
void dropImage(ref PartData view, i64 index) {
    addr none
    if (view.images[index] != none) {
        cromo_gui_image_free(view.images[index])
        view.images[index] = none
    }
    if (view.textures[index] != none) {
        view.dropped.add(view.textures[index])
        view.textures[index] = none
    }
}

void loadImage(i64 id, string path) {
    list<u8> bytes
    if (path.len() > 0) {
        bytes = fs.readBytes(path)
        if (bytes.len() == 0) {
            throw Error(format("cannot read the image {}: the file is empty", path))
        }
    }
    setImage(id, path, bytes)
}

// Decodes an image on this thread, and gives its pixels to the thread of the GUI,
// which makes its texture.
void setImage(i64 id, string file, list<u8> bytes) {
    addr pixels
    addr svg
    i64 svgSize = 0
    i32 w = 0
    i32 h = 0
    if (bytes.len() > 0 && isSvg(bytes)) {  // D484: drawn at the size where it is shown
        svg = memoryOf(bytes)
        f32 fw = 0
        f32 fh = 0
        if (!cromo_gui_svg_size(svg, bytes.len(), ref fw, ref fh)) {
            free(svg)
            string what = file.len() > 0 ? format("the image {}", file) : "the image"
            throw Error(format("cannot read {}: it is not an SVG image that can be read, or it has no size", what))
        }
        svgSize = bytes.len()
        w = i32(fw + 0.5)
        h = i32(fh + 0.5)
    } else if (bytes.len() > 0) {
        pixels = decodeImage(file, bytes, ref w, ref h)
    }
    withData([id, file, pixels, svg, svgSize, w, h](ref Shared data) {
        i64 p = partIndexOf(ref data, id)
        addr none
        if (data.parts[p].pixels != none) {
            cromo_gui_image_free(data.parts[p].pixels)
        }
        if (data.parts[p].svg != none) {
            free(data.parts[p].svg)
        }
        data.parts[p].svg = svg
        data.parts[p].svgSize = svgSize
        data.parts[p].text = file
        data.parts[p].pixels = pixels
        data.parts[p].imageWidth = w
        data.parts[p].imageHeight = h
        data.parts[p].imageChanged = true
    })
}

// ---- The window ----

// A window, with its title bar, drawn by the library in the colors of its theme, and its
// components. It is a handle: its copies name the same window, and a lambda captures it
// by copy, so that a button can close its own window. 'start' shows it, and when 'main'
// returns the program waits until its windows are closed. The handlers of its events
// and of its components run on the thread of the windows, one at a time.
//
// On Android an app has one window, which fills the screen between the bars of the
// system, without a title bar: its components, placed for the size given to the
// constructor, follow the screen with their anchors, also when the phone turns. Its
// size and its state do not change there.
//
// '''
// gui.Window w = gui.Window("Notes", 480, 300)
// gui.TextBox title = w.add(gui.TextBox("", 16, 16, 448, 32))
// title.setAnchor(gui.Horizontal.Stretch, gui.Vertical.Top)
// gui.Button quit = w.add(gui.Button("Quit", 364, 217, 100, 32))
// quit.setAnchor(gui.Horizontal.Right, gui.Vertical.Bottom)
// quit.onClick([w]() { w.close() })
// w.start()
// '''
public struct Window {
    i64 id

    // A window with its title and the size of the whole window, in logical pixels, its
    // title bar of 35 pixels included: the content, where the components go, is 'w'
    // wide and 'h' less 35 high. The window is shown by 'start'.
    public Window(string text, i32 w, i32 h) {
        i64 made = 0
        withData([ref made, text, w, h](ref Shared data) {
            data.next++
            WindowData window
            window.id = data.next
            window.title = text
            window.width = w
            window.height = h
            // On Android the components are added for the content that the window
            // would have on the desktop, and their anchors follow the phone (D456).
            window.phone = onAndroid()
            data.windows.add(move window)
            made = data.next
        })
        id = made
    }

    // Puts a component in the window, with its position from the top left corner of the
    // content, and gives it back, so that its handle can be kept:
    // 'gui.Button ok = w.add(gui.Button("OK", 20, 20, 100, 32))'. A component that is
    // already in a window or in a group is a panic, and so is a second app bar.
    public T add<T : Component>(T component) const {
        addPart(id, 0, component.componentId())
        ret component
    }

    // The navigation bar at the bottom of the window, made the first time that it is
    // called: a window has one at most, and each call gives the same bar.
    public NavigationBar navigationBar() const {
        i64 me = id
        i64 made = 0
        withData([me, ref made](ref Shared data) {
            i64 i = indexOf(ref data, me)
            if (data.windows[i].navigation == 0) {
                i32 content = contentHeight(data.windows[i])
                i64 bar = makePart(ref data, kindNavigation, "", 0, content - i32(navigationHeight()), contentWidth(data.windows[i]),
                    i32(navigationHeight()))
                i64 p = partIndexOf(ref data, bar)
                data.parts[p].window = me
                data.parts[p].selected = 0
                data.parts[p].horizontal = Horizontal.Stretch
                data.parts[p].vertical = Vertical.Bottom
                rebase(ref data, p)
                data.windows[i].navigation = bar
            }
            made = data.windows[i].navigation
        })
        ret NavigationBar(made)
    }

    // Changes the title, shown at the center of the title bar and by the system, as in
    // the taskbar; on a phone it is not shown.
    public void setTitle(string text) const {
        i64 me = id
        withData([me, text](ref Shared data) {
            i64 i = indexOf(ref data, me)
            data.windows[i].title = text
            data.windows[i].titleChanged = true
        })
    }

    // The title of the window.
    public string title() const {
        i64 me = id
        string result
        withData([me, ref result](ref Shared data) { result = data.windows[indexOf(ref data, me)].title })
        ret result
    }

    // Changes the size of the whole window, its title bar included, in logical pixels;
    // before 'start', the size it starts with. The anchors move the components. On
    // Android it does nothing.
    public void setSize(i32 w, i32 h) const {
        i64 me = id
        withData([me, w, h](ref Shared data) {
            i64 i = indexOf(ref data, me)
            data.windows[i].width = w
            data.windows[i].height = h
            data.windows[i].sizeChanged = true
        })
    }

    // The width of the whole window in logical pixels, which follows the user who resizes
    // it; on a phone, once the window is shown, that of the screen.
    public i32 width() const {
        i64 me = id
        i32 result = 0
        withData([me, ref result](ref Shared data) { result = data.windows[indexOf(ref data, me)].width })
        ret result
    }

    // The height of the whole window in logical pixels, its title bar included, which
    // follows the user who resizes it; on a phone, once the window is shown, that of the
    // screen.
    public i32 height() const {
        i64 me = id
        i32 result = 0
        withData([me, ref result](ref Shared data) { result = data.windows[indexOf(ref data, me)].height })
        ret result
    }

    // Sets whether the user can resize the window with its edges and maximize it with
    // its button: true by default. On Android it does nothing.
    public void setResizable(bool value) const {
        i64 me = id
        withData([me, value](ref Shared data) {
            i64 i = indexOf(ref data, me)
            data.windows[i].resizable = value
            data.windows[i].resizableChanged = true
        })
    }

    // Whether the user can resize the window: true by default.
    public bool resizable() const {
        i64 me = id
        bool result = false
        withData([me, ref result](ref Shared data) { result = data.windows[indexOf(ref data, me)].resizable })
        ret result
    }

    // Minimizes the window; called before 'start', the window starts minimized. On
    // Android it does nothing.
    public void minimize() const {
        showAs(1)
    }

    // Maximizes the window; called before 'start', the window starts maximized. On
    // Android it does nothing.
    public void maximize() const {
        showAs(2)
    }

    // Brings the window back from minimized or maximized to its size; called before
    // 'start', the window starts so, as it does by default. On Android it does nothing.
    public void restore() const {
        showAs(0)
    }

    // Whether the window is minimized now; before 'start', whether it starts so.
    public bool minimized() const {
        i64 me = id
        bool result = false
        withData([me, ref result](ref Shared data) {
            i64 i = indexOf(ref data, me)
            result = data.windows[i].window == addr(0) ? data.windows[i].show == 1 : data.windows[i].minimized
        })
        ret result
    }

    // Whether the window is maximized now; before 'start', whether it starts so.
    public bool maximized() const {
        i64 me = id
        bool result = false
        withData([me, ref result](ref Shared data) {
            i64 i = indexOf(ref data, me)
            result = data.windows[i].window == addr(0) ? data.windows[i].show == 2 : data.windows[i].maximized
        })
        ret result
    }

    // Sets the colors of the window and of its components, light or dark, at once:
    // 'Theme.System', the default, follows those of the system and changes with them.
    public void setTheme(Theme value) const {
        i64 me = id
        withData([me, value](ref Shared data) { data.windows[indexOf(ref data, me)].theme = value })
    }

    // The theme of the window, 'Theme.System' by default.
    public Theme theme() const {
        i64 me = id
        Theme result = Theme.System
        withData([me, ref result](ref Shared data) { result = data.windows[indexOf(ref data, me)].theme })
        ret result
    }

    // Sets how many frames are drawn each second, from 1 to 240: 60 by default. The
    // windows are drawn together, at the most frames among those open. A value out of
    // the range is a panic.
    public void setFps(i32 value) const {
        if (value < 1 || value > 240) {
            panic(format("the frames per second are from 1 to 240, found {}", value))
        }
        i64 me = id
        withData([me, value](ref Shared data) { data.windows[indexOf(ref data, me)].fps = value })
    }

    // How many frames of the window are drawn each second: 60 by default.
    public i32 fps() const {
        i64 me = id
        i32 result = 0
        withData([me, ref result](ref Shared data) { result = data.windows[indexOf(ref data, me)].fps })
        ret result
    }

    // Shows the window and returns at once: the window is drawn, and the handlers are
    // called, by the thread of the windows, which the first 'start' starts. Starting a
    // window twice is a panic, and so is starting a second window on Android, where an
    // app has one.
    public void start() const {
        i64 me = id
        withData([me](ref Shared data) {
            i64 i = indexOf(ref data, me)
            if (data.windows[i].started) {
                panic("the window is already started")
            }
            if (data.windows[i].phone) {
                for (i64 other = 0; other < data.windows.len(); other++) {
                    if (other != i && data.windows[other].started) {
                        panic("an app of Android has one window: this is a second one (D459)")
                    }
                }
            }
            data.windows[i].started = true
            if (!data.running) {
                data.running = true
                guiThread = threadStart([]() { run() })
                guardThread = threadStart([]() { watch() })
                cromo_gui_wait_at_end()
            }
        })
    }

    // Closes the window, as its button does, and then calls its handlers of 'onClose' on
    // the thread of the windows. A window closed before 'start' is never shown.
    public void close() const {
        i64 me = id
        withData([me](ref Shared data) { data.windows[indexOf(ref data, me)].closing = true })
    }

    // Whether the window is closed, by the user or by 'close', once its handlers of
    // 'onClose' have run.
    public bool closed() const {
        i64 me = id
        bool result = false
        withData([me, ref result](ref Shared data) { result = isClosed(ref data.windows[indexOf(ref data, me)]) })
        ret result
    }

    // Waits until the window is closed, for a program that has more to do after it: at
    // the end of 'main' the program waits for its windows anyway. It waits forever for a
    // window never started, and for an open one when it is called from a handler, which
    // holds the thread that would close it.
    public void wait() const {
        for (!closed()) {
            time.msleep(10)
        }
    }

    // ---- The events: the lambdas run on the thread of the GUI (D435) ----

    // Adds a handler, called on the thread of the windows when the mouse moves over the
    // content of the window, also over the components, with its position and button 0.
    public void onMouseMove(move func(Mouse) handler) const {
        addr box = alloc(sizeOf<func(Mouse)>())
        put<func(Mouse)>(box, move handler)
        i64 me = id
        withData([me, box](ref Shared data) { data.windows[indexOf(ref data, me)].mouseMove.add(box) })
    }

    // Adds a handler, called on the thread of the windows when a button of the mouse, or
    // a finger, is pressed on the content of the window, with its position and the
    // button. The presses on the components come here too, after the components.
    public void onMouseDown(move func(Mouse) handler) const {
        addr box = alloc(sizeOf<func(Mouse)>())
        put<func(Mouse)>(box, move handler)
        i64 me = id
        withData([me, box](ref Shared data) { data.windows[indexOf(ref data, me)].mouseDown.add(box) })
    }

    // Adds a handler, called on the thread of the windows when a button of the mouse, or
    // a finger, is released on the content of the window, with its position and the
    // button. The releases on the components come here too, after the components.
    public void onMouseUp(move func(Mouse) handler) const {
        addr box = alloc(sizeOf<func(Mouse)>())
        put<func(Mouse)>(box, move handler)
        i64 me = id
        withData([me, box](ref Shared data) { data.windows[indexOf(ref data, me)].mouseUp.add(box) })
    }

    // Adds a handler, called on the thread of the windows with each key pressed that the
    // component with the keyboard does not use, as F5 in a text box; a key held down
    // comes again as it repeats. Tab, which moves the keyboard to the next component,
    // the back key of a phone, and the keys pressed while a dialog is shown, do not come
    // here.
    public void onKeyDown(move func(Key) handler) const {
        addr box = alloc(sizeOf<func(Key)>())
        put<func(Key)>(box, move handler)
        i64 me = id
        withData([me, box](ref Shared data) { data.windows[indexOf(ref data, me)].keyDown.add(box) })
    }

    // Adds a handler, called on the thread of the windows with the new width and height
    // of the whole window, in logical pixels, when its size changes. The anchors move
    // the components by themselves.
    public void onResize(move func(i32, i32) handler) const {
        addr box = alloc(sizeOf<func(i32, i32)>())
        put<func(i32, i32)>(box, move handler)
        i64 me = id
        withData([me, box](ref Shared data) { data.windows[indexOf(ref data, me)].resize.add(box) })
    }

    // Opens a dialog at the center of the content, over the rest darkened, which the
    // mouse and the keys do not reach until it closes; the keyboard goes to the first of
    // its components that takes it. A window shows one dialog at a time: opening one
    // while another is shown is a panic, and so is a dialog shown by another window.
    public void showDialog(Dialog dialog) const {
        i64 me = id
        i64 card = dialog.id
        withData([me, card](ref Shared data) {
            i64 i = indexOf(ref data, me)
            if (data.windows[i].dialog != 0) {
                panic("the window shows a dialog already")
            }
            for (i64 k = 0; k < data.windows.len(); k++) {
                if (data.windows[k].dialog == card) {
                    panic("the dialog is shown in another window")
                }
            }
            data.parts[partIndexOf(ref data, card)].window = me
            placeIn(ref data.parts, card, me)
            data.windows[i].dialog = card
            data.windows[i].dialogFocus = data.windows[i].focus
            data.windows[i].dialogFresh = true
            data.windows[i].popup = 0
        })
    }

    // Opens a menu where the mouse is, or where the finger is on a phone, over everything,
    // and on the left of the mouse or above it when there is no room (D496). It takes the
    // place of the menu open, and a menu without entries closes it. It can be called from
    // any thread, as from the handler of a right click.
    public void showMenu(move Menu menu) const {
        openMenu(id, move menu, 0)
    }

    // Opens a menu under a component of the window, from its left edge, as the list of a
    // button: above it when there is no room below.
    public void showMenuUnder<T : Component>(move Menu menu, T anchor) const {
        openMenu(id, move menu, anchor.componentId())
    }

    // Closes the menu open, if there is one, without calling its handlers.
    public void closeMenu() const {
        i64 me = id
        withData([me](ref Shared data) { data.windows[indexOf(ref data, me)].menuOpen = false })
    }

    // Shows a short message at the bottom of the content for 4 seconds, above the
    // navigation bar and above the components anchored to the bottom that it would cover,
    // which stay visible and can be pressed. It takes the place of the one shown, and ""
    // hides it.
    public void showSnackbar(string text) const {
        addr none
        snackbar(id, text, "", none)
    }

    // Shows a snackbar as 'showSnackbar' does, with an action on its right, as "Undo":
    // a click or a touch on it calls the handler on the thread of the windows and hides
    // the snackbar. The handler is dropped when another snackbar takes the place of this
    // one, so it must own what it captures.
    //
    // '''
    // string title = messages.itemTitle(index)
    // messages.removeItem(index)
    // w.showSnackbarAction("Message deleted", "Undo", [messages, index, move title]() {
    //     messages.insertItem(index, gui.Icon.Mail, title, "", "")
    // })
    // '''
    public void showSnackbarAction(string text, string action, move func() handler) const {
        addr box = alloc(sizeOf<func()>())
        put<func()>(box, move handler)
        snackbar(id, text, action, box)
    }

    // Adds a handler, called on the thread of the windows when the user presses the back
    // key of Android, or makes its gesture, in place of what the key does without
    // handlers: closing the window, and so the app. While a dialog is shown, the key
    // closes the dialog instead. On the desktop the handlers are never called.
    //
    // '''
    // w.onBack([w, pages]() {
    //     if (pages.selected() == 0) {
    //         w.close()
    //     } else {
    //         pages.setSelected(0)
    //     }
    // })
    // '''
    public void onBack(move func() handler) const {
        addr box = alloc(sizeOf<func()>())
        put<func()>(box, move handler)
        i64 me = id
        withData([me, box](ref Shared data) { data.windows[indexOf(ref data, me)].back.add(box) })
    }

    // Adds a handler, called on the thread of the windows after the window is closed: by
    // its button, by the keys of the system, by the back key of a phone or by 'close'.
    // The window is 'closed' once its handlers have run.
    public void onClose(move func() handler) const {
        addr box = alloc(sizeOf<func()>())
        put<func()>(box, move handler)
        i64 me = id
        withData([me, box](ref Shared data) { data.windows[indexOf(ref data, me)].close.add(box) })
    }

    void showAs(i32 state) const {
        i64 me = id
        withData([me, state](ref Shared data) {
            i64 i = indexOf(ref data, me)
            data.windows[i].show = state
            data.windows[i].showChanged = true
        })
    }
}

bool isClosed(ref WindowData window) {
    ret window.closed || (window.closing && !window.started)
}

// ---- The end of main (D442) and the exceptions of the handlers (D437) ----

// When main returns, the program waits for its windows. It reads only the data
// under the lock: a failure there is a panic, since C has no exceptions (D395).
[[export("cromo_gui_finish")]]
void finish() {
    try {
        for (openWindows() > 0) {
            time.msleep(10)
        }
    } catch (Exception e) {
        panic(e.message())
    }
}

i64 openWindows() {
    i64 count = 0
    withData([ref count](ref Shared data) {
        for (ref WindowData window in data.windows) {
            if (window.started && !isClosed(ref window)) {
                count++
            }
        }
    })
    ret count
}

// An exception that leaves a handler ends the thread of the GUI: this thread stops
// the program with it, as for a thread that no join() takes (D217).
void watch() {
    if (threadWait(guiThread)) {
        threadUncaught(guiThread)
    }
}

// ---- The thread of the GUI ----

const f32 barHeight = 35
const f32 buttonWidth = 46
const f32 edgeWidth = 6
const f32 titleSize = 12
const f32 padding = 8  // of the text in a text box and in a combo box
const f32 checkSide = 16
const f32 corner = 4       // of the buttons, the text boxes and the combo boxes (D479)
const f32 checkCorner = 3  // of the check boxes
const f32 groupCorner = 8  // of the groups, which are cards
const f32 menuCorner = 8   // of the list of a combo box, and of a menu (D496)
const i64 listRows = 8
const i32 avatarPixels = 112  // of the round images of the lists, 40 pixels up to a density of 2.8
const f32 switchWidth = 40
const f32 switchHeight = 22
const f32 knob = 18  // of a switch and of a slider

// 0 until it is known, then 1 on the desktop and 2 on a phone (D480).
i32 platformKind

// Whether std.gui is comfortable, for the fingers, as on a phone, or compact, as on
// the desktop (D480).
bool comfortable() {
    if (platformKind == 0) {
        platformKind = onAndroid() ? 2 : 1
    }
    ret platformKind == 2
}

f32 bodySize() {  // the text of the components
    ret comfortable() ? 14 : 13
}

f32 headingSize() {  // the title of an app bar
    ret comfortable() ? 18 : 15
}

f32 captionSize() {  // the items of a navigation bar
    ret comfortable() ? 12 : 11
}

f32 bandSize() {  // the titles of the bands, in capitals
    ret comfortable() ? 12 : 11
}

f32 bandHeight() {  // the band at the top of a group or of a dialog
    ret comfortable() ? 40 : 32
}

f32 itemHeight() {  // a row of the list of a combo box
    ret comfortable() ? 40 : 28
}

f32 rowHeight() {  // an item of a list
    ret comfortable() ? 56 : 44
}

f32 avatarSize() {  // a round image in a list
    ret comfortable() ? 40 : 32
}

f32 buttonIcon() {  // the icon of a button
    ret comfortable() ? 18 : 16
}

f32 barIcon() {  // the icons of an app bar
    ret comfortable() ? 24 : 20
}

f32 appBarHeight() {
    ret comfortable() ? 56 : 44
}

f32 navigationHeight() {
    ret comfortable() ? 64 : 56
}

f32 dialogPadding() {  // the body of a dialog from the edges of the card and from its bands
    ret comfortable() ? 16 : 14
}

f32 dialogFooter() {  // the band of the buttons of a dialog
    ret comfortable() ? 60 : 44
}

f32 dialogButton() {  // the height of the buttons of a dialog
    ret comfortable() ? 36 : 26
}

f32 dialogCorner() {
    ret comfortable() ? 14 : 9
}

const f32 snackHeight = 48
const u64 snackTime = 4000000000
const f32 wheelStep = 48  // what a step of the wheel scrolls

// The colors of the look (D479): grays with a hint of blue, an ochre accent and a
// blue for the selection, light and dark.
struct Colors {
    u32 background     // under the components
    u32 surface        // cards, dialogs, fields, buttons and bars
    u32 surface2       // the bands of the groups and of the dialogs, under the mouse
    u32 surface3       // pressed, and the tracks
    u32 ink            // the text
    u32 ink2           // secondary text, labels and icons
    u32 ink3           // muted text, the titles of the bands, the placeholders
    u32 rule           // lines, and the borders of the cards
    u32 rule2          // the borders of the controls
    u32 accent         // main buttons, checked boxes, switches and sliders
    u32 accent2        // the accent under the mouse, and the text on the soft accent
    u32 accentSoft     // the item pointed at in a list, the item chosen of a bar
    u32 selection      // the focus, and the bar of the selected row
    u32 selectionSoft  // the selected row and the selected text
    u32 onAccent       // the text on the accent
    u32 danger         // the buttons that destroy
    u32 shadowNear     // 0xAARRGGBB, the sharp part of the shadow of the cards
    u32 shadowFar      // 0xAARRGGBB, its soft part, further down
}

Colors colorsOf(bool dark) {
    Colors c
    if (dark) {
        c.background = 0x0F1418
        c.surface = 0x171D22
        c.surface2 = 0x1D242A
        c.surface3 = 0x252E35
        c.ink = 0xE3E9ED
        c.ink2 = 0xAEBBC4
        c.ink3 = 0x7B8A95
        c.rule = 0x2A343B
        c.rule2 = 0x37434B
        c.accent = 0xE0A64A
        c.accent2 = 0xF0C177
        c.accentSoft = 0x2E2413
        c.selection = 0x6FB2D2
        c.selectionSoft = 0x182B36
        c.onAccent = 0x1A1206
        c.danger = 0xE0786D
        c.shadowNear = 0x80000000
        c.shadowFar = 0x99000000
    } else {
        c.background = 0xEDF1F4
        c.surface = 0xFFFFFF
        c.surface2 = 0xF5F7F9
        c.surface3 = 0xE7ECF0
        c.ink = 0x18212A
        c.ink2 = 0x4A5A67
        c.ink3 = 0x7A8B99
        c.rule = 0xD5DDE3
        c.rule2 = 0xC2CDD5
        c.accent = 0xB4761C
        c.accent2 = 0x8A5A12
        c.accentSoft = 0xFBEFD9
        c.selection = 0x2F6E8F
        c.selectionSoft = 0xDFECF3
        c.onAccent = 0xFFFFFF
        c.danger = 0xB0453C
        c.shadowNear = 0x1218212A
        c.shadowFar = 0x4018212A
    }
    ret c
}

const u32 closeHover = 0xC42B1C
const u32 closePressed = 0xA3241A
const u32 scrim = 0x730A0F14  // over the content under a dialog

u8 red(u32 rgb) {
    ret u8((rgb >> 16) & 0xFF)
}

u8 green(u32 rgb) {
    ret u8((rgb >> 8) & 0xFF)
}

u8 blue(u32 rgb) {
    ret u8(rgb & 0xFF)
}

// A color of the boxes of C, 0xAARRGGBB: opaque, or half for a component disabled.
u32 solid(u32 rgb, bool enabled) {
    ret enabled ? (0xFF000000 | rgb) : (0x80000000 | rgb)
}

void fill(addr renderer, u32 rgb, f32 x, f32 y, f32 w, f32 h) {
    SDL_SetRenderDrawColor(renderer, red(rgb), green(rgb), blue(rgb), 255)
    Rect area = Rect(x, y, w, h)
    SDL_RenderFillRect(renderer, ref area)
}

void text(addr font, string s, f32 x, f32 y, u32 rgb, bool enabled) {
    cromo_gui_text(font, s.cstring(), s.len(), x, y, red(rgb), green(rgb), blue(rgb), enabled ? 255 : 128)
}

f32 textWidth(addr font, string s, i64 bytes) {
    ret cromo_gui_text_width(font, s.cstring(), bytes)
}

// Drawing only inside a rectangle, in logical pixels.
void clipTo(addr renderer, f32 x, f32 y, f32 w, f32 h) {
    clip[0] = i32(x)
    clip[1] = i32(y)
    clip[2] = i32(w)
    clip[3] = i32(h)
    SDL_SetRenderClipRect(renderer, variableAddress(clip))
}

// Drawing only inside the groups of a component.
void clipPart(addr renderer, ref PartData part) {
    clipTo(renderer, part.clipLeft, part.clipTop, part.clipRight - part.clipLeft, part.clipBottom - part.clipTop)
}

// Drawing only inside a rectangle, and inside the groups of a component.
void clipInside(addr renderer, ref PartData part, f32 x, f32 y, f32 w, f32 h) {
    f32 left = most(x, part.clipLeft)
    f32 top = most(y, part.clipTop)
    f32 right = least(x + w, part.clipRight)
    f32 bottom = least(y + h, part.clipBottom)
    clipTo(renderer, left, top, most(right - left, 0), most(bottom - top, 0))
}

f32 least(f32 a, f32 b) {
    ret a < b ? a : b
}

f32 most(f32 a, f32 b) {
    ret a > b ? a : b
}

// A string of C, ended by a zero.
string cText(addr text) {
    i64 n = 0
    for (take<u8>(offset(text, n)) != 0) {
        n++
    }
    ret string(text, n)
}

void run() {
    // On Android the back key comes to std.gui (D457), and the app turns (D458).
    SDL_SetHint("SDL_ANDROID_TRAP_BACK_BUTTON".cstring(), "1".cstring())
    SDL_SetHint("SDL_ORIENTATIONS".cstring(), "LandscapeLeft LandscapeRight Portrait PortraitUpsideDown".cstring())
    if (!SDL_Init(0x20)) {  // SDL_INIT_VIDEO
        panic(format("cannot start the windows: {}", cText(SDL_GetError())))
    }
    arrow = SDL_CreateSystemCursor(0)     // SDL_SYSTEM_CURSOR_DEFAULT
    beam = SDL_CreateSystemCursor(1)      // SDL_SYSTEM_CURSOR_TEXT
    pointer = SDL_CreateSystemCursor(11)  // SDL_SYSTEM_CURSOR_POINTER
    addr event = alloc(128)               // SDL_Event, a union of 128 bytes
    for (true) {
        u64 start = SDL_GetTicksNS()
        i32 fps = prepare()
        for (SDL_PollEvent(event)) {
            handle(event)
        }
        draw()
        u64 frame = 20000000  // without windows, 50 times a second
        if (fps > 0) {
            frame = 1000000000 / u64(fps)
        }
        u64 spent = SDL_GetTicksNS() - start
        if (spent < frame) {
            SDL_DelayPrecise(frame - spent)
        }
    }
}

// Opens the windows started, gives to SDL what the program changed, and closes
// the windows closed. A window is closed for the program after its handlers of
// onClose: if one throws, the program stops before (D437). The frames per second
// are the most among the windows open, or 0 without windows.
i32 prepare() {
    i32 fps = 0
    list<addr> handlers
    list<i64> ended
    list<Call> pending
    list<addr> dropped
    withData([ref fps, ref handlers, ref ended, ref pending, ref dropped](ref Shared data) {
        for (data.pending.len() > 0) {
            pending.add(data.pending.remove(0))
        }
        for (ref WindowData window in data.windows) {
            for (window.dropped.len() > 0) {
                dropped.add(window.dropped.remove(0))
            }
            addr none
            if (window.started && window.window == none && !window.closing) {
                open(ref window)
            }
            if (window.closing && window.started && !window.notified) {
                if (window.window != none) {
                    freeTextures(ref window, ref data.parts)
                    shut(ref window)
                }
                window.notified = true
                for (addr box in window.close) {
                    handlers.add(box)
                }
                ended.add(window.id)
                continue
            }
            if (window.window == none) {
                continue
            }
            apply(ref window)
            if (window.fps > fps) {
                fps = window.fps
            }
        }
    })
    for (addr box in dropped) {  // no call of theirs is running: they ran in the frame before
        func() handler = take<func()>(box)
        free(box)
    }
    for (ref Call call in pending) {
        dispatch(ref call)
    }
    for (addr box in handlers) {
        func() handler = take<func()>(box)
        try {
            handler()
        } finally {
            put<func()>(box, move handler)
        }
    }
    if (ended.len() > 0) {
        withData([ended](ref Shared data) {
            for (i64 id in ended) {
                data.windows[indexOf(ref data, id)].closed = true
            }
        })
    }
    ret fps
}

// From logical pixels to the coordinates of the window, which are pixels on
// Windows and on X11, and logical pixels on Wayland.
f32 toWindow(ref WindowData window) {
    f32 density = SDL_GetWindowPixelDensity(window.window)
    if (density <= 0) {
        ret 1
    }
    ret window.density / density
}

void open(ref WindowData window) {
    f32 scale = SDL_GetDisplayContentScale(SDL_GetPrimaryDisplay())
    if (scale <= 0) {
        scale = 1
    }
    u64 flags = 0x10 | 0x2000  // SDL_WINDOW_BORDERLESS, SDL_WINDOW_HIGH_PIXEL_DENSITY
    if (window.phone) {
        flags = 0x20 | 0x2000  // the whole screen, which turns
    } else if (window.resizable) {
        flags = flags | 0x20
    }
    if (window.show == 1) {
        flags = flags | 0x40
    } else if (window.show == 2) {
        flags = flags | 0x80
    }
    window.window = SDL_CreateWindow(window.title.cstring(), i32(f32(window.width) * scale), i32(f32(window.height) * scale), flags)
    addr none
    if (window.window == none) {
        panic(format("cannot open the window: {}", cText(SDL_GetError())))
    }
    window.renderer = SDL_CreateRenderer(window.window, none)
    if (window.renderer == none) {
        panic(format("cannot draw in the window: {}", cText(SDL_GetError())))
    }
    SDL_SetRenderDrawBlendMode(window.renderer, 1)  // SDL_BLENDMODE_BLEND
    window.sdlId = SDL_GetWindowID(window.window)
    if (!window.phone) {
        window.chrome = cromo_gui_chrome(window.window)
    }
    setDensity(ref window)
    readSafeArea(ref window)
    window.titleChanged = false
    window.sizeChanged = false
    window.resizableChanged = false
    window.showChanged = false
}

// On Android, the size of the screen and the area that the bars of the system leave
// free (D456).
i32[4] safeArea  // the SDL_Rect of SDL_GetWindowSafeArea

void readSafeArea(ref WindowData window) {
    if (!window.phone) {
        ret
    }
    i32 w = 0
    i32 h = 0
    SDL_GetWindowSize(window.window, ref w, ref h)
    f32 scale = toWindow(ref window)
    window.width = i32(f32(w) / scale + 0.5)
    window.height = i32(f32(h) / scale + 0.5)
    if (SDL_GetWindowSafeArea(window.window, variableAddress(safeArea))) {
        window.originX = f32(safeArea[0]) / scale
        window.originY = f32(safeArea[1]) / scale
        window.insetRight = f32(w - safeArea[0] - safeArea[2]) / scale
        window.insetBottom = f32(h - safeArea[1] - safeArea[3]) / scale
    }
    // The keyboard on the screen (D471): from Android 11 the safe area of the
    // activity of Cromo leaves it out, before it the window is shorter. Its part
    // above the bars is what the window had more without it. It can come in steps,
    // and each one higher shows the component in focus again.
    f32 lost = window.insetBottom - window.barsBottom + window.fullHeight - f32(window.height)
    if (SDL_ScreenKeyboardShown(window.window) && lost > 1) {
        if (lost > window.screenKeyboard + 1) {
            window.revealFocus = true
        }
        window.screenKeyboard = lost
    } else {
        window.barsBottom = window.insetBottom
        window.fullHeight = f32(window.height)
        window.screenKeyboard = 0
    }
}

// The renderer lost its textures, as on Android when an app comes back: they are
// made again when they are drawn.
void resetTextures(ref WindowData window, ref list<PartData> parts) {
    cromo_gui_symbols_free(window.renderer)
    cromo_gui_boxes_free(window.renderer)
    cromo_gui_icons_free(window.renderer)
    setDensity(ref window)
    addr none
    for (ref PartData part in parts) {
        if (part.window == window.id && part.texture != none) {
            SDL_DestroyTexture(part.texture)
            part.texture = none
            part.imageChanged = true
        }
        if (part.window == window.id) {
            freeItemTextures(ref part)
        }
    }
}

// The textures of the round images of a list, made again when they are drawn.
void freeItemTextures(ref PartData part) {
    if (part.kind == kindCanvas || part.kind == kindTextView) {
        freeCanvasTextures(ref part)
    }
    addr none
    for (i64 i = 0; i < part.textures.len(); i++) {
        if (part.textures[i] != none) {
            SDL_DestroyTexture(part.textures[i])
            part.textures[i] = none
        }
    }
    for (addr texture in part.dropped) {
        SDL_DestroyTexture(texture)
    }
    part.dropped.clear()
}

// The scale of the display: the renderer draws in logical pixels, and the fonts
// are rasterized for the pixels of the display.
void setDensity(ref WindowData window) {
    f32 density = SDL_GetWindowDisplayScale(window.window)
    if (density <= 0) {
        density = 1
    }
    window.density = density
    SDL_SetRenderScale(window.renderer, density, density)
    addr none
    if (window.font != none) {
        cromo_gui_font_free(window.font)
        cromo_gui_font_free(window.body)
        cromo_gui_font_free(window.strong)
        cromo_gui_font_free(window.heading)
        cromo_gui_font_free(window.caption)
        cromo_gui_font_free(window.band)
    }
    freeFonts(ref window)
    window.font = cromo_gui_font(window.renderer, 0, titleSize, density)
    window.body = cromo_gui_font(window.renderer, 0, bodySize(), density)
    window.strong = cromo_gui_font(window.renderer, 1, bodySize(), density)
    window.heading = cromo_gui_font(window.renderer, 1, headingSize(), density)
    window.caption = cromo_gui_font(window.renderer, 1, captionSize(), density)
    window.band = cromo_gui_font(window.renderer, 1, bandSize(), density)
}

// On Android the window keeps the screen: its size and its state do not change (P45).
void apply(ref WindowData window) {
    if (window.titleChanged) {
        SDL_SetWindowTitle(window.window, window.title.cstring())
        window.titleChanged = false
    }
    if (window.phone) {
        window.sizeChanged = false
        window.resizableChanged = false
        window.showChanged = false
    }
    if (window.sizeChanged) {
        f32 scale = toWindow(ref window)
        SDL_SetWindowSize(window.window, i32(f32(window.width) * scale), i32(f32(window.height) * scale))
        window.sizeChanged = false
    }
    if (window.resizableChanged) {
        SDL_SetWindowResizable(window.window, window.resizable)
        window.resizableChanged = false
    }
    if (window.showChanged) {
        if (window.show == 1) {
            SDL_MinimizeWindow(window.window)
        } else if (window.show == 2) {
            SDL_MaximizeWindow(window.window)
        } else {
            SDL_RestoreWindow(window.window)
        }
        window.showChanged = false
    }
}

// The textures of the images of a window, before its renderer is destroyed.
void freeTextures(ref WindowData window, ref list<PartData> parts) {
    addr none
    for (ref PartData part in parts) {
        if (part.window == window.id && part.texture != none) {
            SDL_DestroyTexture(part.texture)
            part.texture = none
        }
        if (part.window == window.id) {
            freeItemTextures(ref part)
        }
    }
}

void shut(ref WindowData window) {
    addr none
    cromo_gui_font_free(window.font)
    cromo_gui_font_free(window.body)
    cromo_gui_font_free(window.strong)
    cromo_gui_font_free(window.heading)
    cromo_gui_font_free(window.caption)
    cromo_gui_font_free(window.band)
    freeFonts(ref window)
    window.font = none
    window.body = none
    window.strong = none
    window.heading = none
    window.caption = none
    window.band = none
    cromo_gui_symbols_free(window.renderer)
    cromo_gui_boxes_free(window.renderer)
    cromo_gui_icons_free(window.renderer)
    SDL_DestroyRenderer(window.renderer)
    SDL_DestroyWindow(window.window)
    cromo_gui_chrome_free(window.chrome)
    window.window = none
    window.renderer = none
}

// The button of the title bar at a point: 0 minimize, 1 maximize, 2 close, or -1.
i32 buttonAt(f32 x, f32 y, f32 width) {
    f32 start = width - 3 * buttonWidth
    if (y < 0 || y >= barHeight || x < start || x >= width) {
        ret -1
    }
    ret i32((x - start) / buttonWidth)
}

// A call of handlers, made under the lock and run after it.
struct Call {
    i32 kind  // 1 mouse move, 2 mouse down, 3 mouse up, 4 key, 5 resize, 6 click, 7 text, 8 check, 9 choice,
    // 10 func(i64, i64), 11 func(i64, bool), 12 func(i64, Mouse)
    list<addr> boxes
    Mouse mouse
    Key key
    i32 w
    i32 h
    string text
    bool value
    i64 index
    i64 second  // the second number of a func(i64, i64)
}

void handle(addr event) {
    u32 kind = take<u32>(event)
    if (kind == 0x108) {  // SDL_EVENT_SYSTEM_THEME_CHANGED: drawn at the next frame
        ret
    }
    u32 sdlId = take<u32>(offset(event, 16))
    list<Call> calls
    withData([event, kind, sdlId, ref calls](ref Shared data) {
        for (i64 w = 0; w < data.windows.len(); w++) {
            addr none
            if (data.windows[w].window == none || data.windows[w].sdlId != sdlId) {
                continue
            }
            route(ref data.windows[w], ref data.parts, event, kind, ref calls)
            ret
        }
    })
    for (ref Call call in calls) {
        dispatch(ref call)
    }
}

void dispatch(ref Call call) {
    for (addr box in call.boxes) {
        if (call.kind >= 1 && call.kind <= 3) {
            func(Mouse) handler = take<func(Mouse)>(box)
            try {
                handler(call.mouse)
            } finally {
                put<func(Mouse)>(box, move handler)
            }
        } else if (call.kind == 4) {
            func(Key) handler = take<func(Key)>(box)
            try {
                handler(call.key)
            } finally {
                put<func(Key)>(box, move handler)
            }
        } else if (call.kind == 5) {
            func(i32, i32) handler = take<func(i32, i32)>(box)
            try {
                handler(call.w, call.h)
            } finally {
                put<func(i32, i32)>(box, move handler)
            }
        } else if (call.kind == 6) {
            func() handler = take<func()>(box)
            try {
                handler()
            } finally {
                put<func()>(box, move handler)
            }
        } else if (call.kind == 7) {
            func(string) handler = take<func(string)>(box)
            try {
                handler(call.text)
            } finally {
                put<func(string)>(box, move handler)
            }
        } else if (call.kind == 8) {
            func(bool) handler = take<func(bool)>(box)
            try {
                handler(call.value)
            } finally {
                put<func(bool)>(box, move handler)
            }
        } else if (call.kind == 9) {
            func(i64) handler = take<func(i64)>(box)
            try {
                handler(call.index)
            } finally {
                put<func(i64)>(box, move handler)
            }
        } else if (call.kind == 10) {
            func(i64, i64) handler = take<func(i64, i64)>(box)
            try {
                handler(call.index, call.second)
            } finally {
                put<func(i64, i64)>(box, move handler)
            }
        } else if (call.kind == 11) {
            func(i64, bool) handler = take<func(i64, bool)>(box)
            try {
                handler(call.index, call.value)
            } finally {
                put<func(i64, bool)>(box, move handler)
            }
        } else if (call.kind == 12) {
            func(i64, Mouse) handler = take<func(i64, Mouse)>(box)
            try {
                handler(call.index, call.mouse)
            } finally {
                put<func(i64, Mouse)>(box, move handler)
            }
        }
    }
}

Call callOf(i32 kind, list<addr> boxes) {
    Call call
    call.kind = kind
    call.boxes = boxes
    ret call
}

// An event of a window: the title bar handles its own, the components theirs, and
// the others go to the handlers of the program, in `calls`.
void route(ref WindowData window, ref list<PartData> parts, addr event, u32 kind, ref list<Call> calls) {
    if (kind >= 0x400 && kind <= 0x403) {  // the mouse: in logical pixels
        SDL_ConvertEventToRenderCoordinates(window.renderer, event)
    }
    layout(ref window, ref parts)
    i32 w = 0
    i32 h = 0
    SDL_GetWindowSize(window.window, ref w, ref h)
    f32 width = f32(w) / toWindow(ref window)
    if (window.menuOpen && menuEvent(ref window, event, kind, ref calls)) {  // D496
        ret
    }
    if (kind == 0x400) {  // SDL_EVENT_MOUSE_MOTION
        f32 x = take<f32>(offset(event, 28))
        f32 y = take<f32>(offset(event, 32))
        window.hovered = window.phone ? -1 : buttonAt(x, y, width)
        window.pointerX = x
        window.pointerY = y
        dragScroll(ref window, ref parts, y)
        i64 hot = y >= window.originY && !window.dragMoved ? partAt(ref window, ref parts, x, y) : -1
        i64 open = partNumber(ref parts, window.popup)
        if (open >= 0 && inList(ref window, ref parts[open], x, y)) {
            hot = open
            i64 item = itemAt(ref window, ref parts[open], x, y)
            if (item >= 0) {
                parts[open].highlight = item
            }
        }
        i64 hotId = hot >= 0 ? parts[hot].id : 0
        window.hotItem = hot >= 0 && hot != open ? barItemAt(ref parts[hot], x, y) : -1
        bool hand = hot >= 0 && hot != open && parts[hot].kind == kindTextView && parts[hot].active && window.hotItem >= 0
        if (hotId != window.hot) {  // D497: the tooltip waits from here
            window.hotSince = SDL_GetTicksNS()
            window.tipBlocked = false
        }
        if (hotId != window.hot || hand != window.hand) {
            window.hot = hotId
            window.hand = hand
            bool typing = hot >= 0 && hot != open && parts[hot].kind == kindTextBox && parts[hot].active
            SDL_SetCursor(hand ? pointer : typing ? beam : arrow)
        }
        window.snackHot = snackAt(ref window, x, y)
        i64 held = partNumber(ref parts, window.canvasHeld)
        i64 over = held >= 0 ? held : hot >= 0 && hot != open && parts[hot].kind == kindCanvas && parts[hot].active ? hot : -1
        if (over >= 0 && parts[over].moves.len() > 0) {  // D483
            Call moved = callOf(1, parts[over].moves)
            moved.mouse = canvasMouse(ref parts[over], x, y, 0)
            calls.add(move moved)
        }
        i64 sliding = partNumber(ref parts, window.held)
        if (sliding >= 0 && parts[sliding].kind == kindSlider && parts[sliding].active) {
            slideTo(ref parts[sliding], x, ref calls)
        }
        if (window.dragging != 0) {
            i64 d = partNumber(ref parts, window.dragging)
            if (d >= 0) {
                parts[d].caret = indexAt(window.body, parts[d].text, x - parts[d].left - padding + parts[d].scroll)
                window.caretStart = SDL_GetTicksNS()
            }
        }
        if (y >= window.originY) {
            Call call = callOf(1, window.mouseMove)
            call.mouse = mouseAt(ref window, x, y, 0)
            calls.add(move call)
        }
    } else if (kind == 0x401 || kind == 0x402) {  // SDL_EVENT_MOUSE_BUTTON_DOWN, _UP
        f32 x = take<f32>(offset(event, 28))
        f32 y = take<f32>(offset(event, 32))
        i32 button = i32(take<u8>(offset(event, 24)))
        if (kind == 0x401) {
            window.clicks = i32(take<u8>(offset(event, 26)))
            window.tipBlocked = true
        } else {
            window.longPart = 0
            window.tipPart = 0
        }
        i32 on = window.phone ? -1 : buttonAt(x, y, width)
        i64 canvas = -1
        if (kind == 0x402) {
            canvas = partNumber(ref parts, window.canvasHeld)
        } else if (on < 0 && y >= window.originY) {
            canvas = canvasAt(ref window, ref parts, x, y)
        }
        if (canvas >= 0) {  // D483: the canvas has the mouse until the button is released
            if (kind == 0x401) {
                window.keyboard = false
                focusTo(ref window, ref parts, 0)
                window.canvasHeld = parts[canvas].id
            } else {
                window.canvasHeld = 0
            }
            Call pressed = callOf(kind == 0x401 ? 2 : 3, kind == 0x401 ? parts[canvas].downs : parts[canvas].ups)
            pressed.mouse = canvasMouse(ref parts[canvas], x, y, button)
            calls.add(move pressed)
            Call call = callOf(kind == 0x401 ? 2 : 3, kind == 0x401 ? window.mouseDown : window.mouseUp)
            call.mouse = mouseAt(ref window, x, y, button)
            calls.add(move call)
        } else if (kind == 0x401 && button == 1 && on >= 0) {
            window.pressed = on
        } else if (kind == 0x402 && window.pressed >= 0) {
            if (button == 1 && on == window.pressed) {
                press(ref window, on)
            }
            window.pressed = -1
        } else if (y >= window.originY) {
            bool finger = take<u32>(offset(event, 20)) == 0xFFFFFFFF  // SDL_TOUCH_MOUSEID
            if (kind == 0x401) {
                window.keyboard = false
            }
            if (kind == 0x401 && button == 1) {
                if (snackAt(ref window, x, y)) {
                    window.snackHeld = true
                } else if (!startScroll(ref window, ref parts, x, y, finger)) {
                    pressPart(ref window, ref parts, x, y, ref calls)
                    if (finger && window.held != 0) {  // D496: maybe a long press
                        window.longPart = window.held
                        window.longPiece = window.heldItem
                        window.longStart = SDL_GetTicksNS()
                        window.longX = x
                        window.longY = y
                    }
                }
            } else if (kind == 0x402 && button == 1 && window.snackHeld) {
                window.snackHeld = false
                if (snackAt(ref window, x, y)) {
                    calls.add(callOf(6, window.snackHandler))
                    window.snackText = ""
                }
            } else if (kind == 0x402 && button == 1) {
                if (endScroll(ref window, ref parts)) {
                    window.held = 0
                    window.heldItem = -1
                    window.dragging = 0
                } else {
                    releasePart(ref window, ref parts, x, y, ref calls)
                }
                if (finger) {  // a finger leaves no component under it
                    window.hot = 0
                    window.hotItem = -1
                }
            } else if (button != 1) {  // D490: the other buttons click the pieces of the rich text
                otherButton(ref window, ref parts, kind == 0x401, button, x, y, ref calls)
            }
            Call call = callOf(kind == 0x401 ? 2 : 3, kind == 0x401 ? window.mouseDown : window.mouseUp)
            call.mouse = mouseAt(ref window, x, y, button)
            calls.add(move call)
        }
    } else if (kind == 0x403) {                           // SDL_EVENT_MOUSE_WHEEL: the list open, or a panel or a list
        bool flipped = take<u32>(offset(event, 32)) == 1  // SDL_MOUSEWHEEL_FLIPPED
        i64 open = partNumber(ref parts, window.popup)
        if (open >= 0) {
            i64 ticks = i64(take<i32>(offset(event, 48)))
            parts[open].first = parts[open].first - (flipped ? -ticks : ticks)
            reveal(ref window, ref parts[open], false)
        } else {
            i64 s = scrollerAt(ref window, ref parts, take<f32>(offset(event, 36)), take<f32>(offset(event, 40)))
            if (s >= 0) {
                f32 steps = take<f32>(offset(event, 28))
                parts[s].velocity = 0
                scrollBy(ref parts[s], -(flipped ? -steps : steps) * wheelStep)
            }
        }
    } else if (kind == 0x20D) {  // SDL_EVENT_WINDOW_MOUSE_LEAVE
        window.hovered = -1
        window.pressed = -1
        window.hot = 0
        window.pointerX = -1
        window.pointerY = -1
    } else if (kind == 0x20E) {  // FOCUS_GAINED
        window.focused = true
    } else if (kind == 0x20F) {  // FOCUS_LOST
        window.focused = false
        window.popup = 0
    } else if (kind == 0x210) {  // CLOSE_REQUESTED, as Alt+F4
        window.closing = true
    } else if (kind == 0x209) {  // MINIMIZED
        window.minimized = true
    } else if (kind == 0x20A) {  // MAXIMIZED
        window.maximized = true
        window.minimized = false
    } else if (kind == 0x20B) {  // RESTORED
        window.maximized = false
        window.minimized = false
    } else if (kind == 0x214) {  // DISPLAY_SCALE_CHANGED
        setDensity(ref window)
        readSafeArea(ref window)
    } else if (kind == 0x215) {  // SAFE_AREA_CHANGED
        readSafeArea(ref window)
    } else if (kind == 0x2000 || kind == 0x2001) {  // SDL_EVENT_RENDER_TARGETS_RESET, _DEVICE_RESET
        resetTextures(ref window, ref parts)
    } else if (kind == 0x206) {  // RESIZED, in the coordinates of the window
        f32 scale = toWindow(ref window)
        window.width = i32(f32(take<i32>(offset(event, 20))) / scale + 0.5)
        window.height = i32(f32(take<i32>(offset(event, 24))) / scale + 0.5)
        Call call = callOf(5, window.resize)
        call.w = window.width
        call.h = window.height
        calls.add(move call)
    } else if (kind == 0x300) {  // SDL_EVENT_KEY_DOWN
        window.keyboard = true
        window.tipBlocked = true
        u32 modifiers = u32(take<u16>(offset(event, 32)))
        Key key
        key.code = i64(take<u32>(offset(event, 28)))
        key.shift = (modifiers & 0x3) != 0
        key.control = (modifiers & 0xC0) != 0
        key.alt = (modifiers & 0x300) != 0
        if (window.phone && key.code == keyBack && window.dialog != 0) {  // D467
            endDialog(ref window, ref parts, ref calls)
        } else if (window.phone && key.code == keyBack) {  // D457
            if (window.back.len() > 0) {
                calls.add(callOf(6, window.back))
            } else {
                window.closing = true
            }
        } else if (!keyOfPart(ref window, ref parts, key, ref calls)) {
            if (window.dialog != 0) {  // the keys do not go behind a dialog
                if (key.code == 27) {  // Esc
                    endDialog(ref window, ref parts, ref calls)
                }
            } else {
                Call call = callOf(4, window.keyDown)
                call.key = key
                calls.add(move call)
            }
        }
    } else if (kind == 0x303) {  // SDL_EVENT_TEXT_INPUT, in UTF-8
        i64 f = partNumber(ref parts, window.focus)
        if (f >= 0 && parts[f].kind == kindTextBox && parts[f].active) {
            insert(ref parts[f], cText(take<addr>(offset(event, 24))))
            window.caretStart = SDL_GetTicksNS()
            changed(ref parts[f], ref calls)
        }
    }
}

// The mouse from the top left corner of the content (D438).
Mouse mouseAt(ref WindowData window, f32 x, f32 y, i32 button) {
    Mouse m
    m.x = x - window.originX
    m.y = y - window.originY
    m.button = button
    ret m
}

// A click on a button of the title bar.
void press(ref WindowData window, i32 button) {
    if (button == 0) {
        SDL_MinimizeWindow(window.window)
    } else if (button == 1 && window.maximized) {
        SDL_RestoreWindow(window.window)
    } else if (button == 1 && window.resizable) {
        SDL_MaximizeWindow(window.window)
    } else if (button == 2) {
        window.closing = true
    }
}

// ---- The components on the thread of the GUI ----

// The index of a component in the list, or -1.
i64 partNumber(ref list<PartData> parts, i64 id) {
    if (id == 0) {
        ret -1
    }
    for (i64 i = 0; i < parts.len(); i++) {
        if (parts[i].id == id) {
            ret i
        }
    }
    ret -1
}

// The component of a window at a point of its content: the last drawn is on top.
i64 partAt(ref WindowData window, ref list<PartData> parts, f32 x, f32 y) {
    for (i64 k = window.order.len() - 1; k >= firstReached(ref window); k--) {
        i64 i = window.order[k]
        if (parts[i].shown && inside(ref parts[i], x, y)) {
            ret i
        }
    }
    ret -1
}

// A point of the content on a component, and inside its groups.
bool inside(ref PartData part, f32 x, f32 y) {
    ret x >= part.left && x < part.left + f32(part.width) && y >= part.top && y < part.top + f32(part.height) &&
        x >= part.clipLeft && x < part.clipRight && y >= part.clipTop && y < part.clipBottom
}

bool focusable(ref PartData part) {
    bool takes = part.kind == kindButton || part.kind == kindTextBox || part.kind == kindCheckBox || part.kind == kindComboBox ||
        part.kind == kindListView || part.kind == kindSwitch || part.kind == kindSlider || part.kind == kindTable ||
        part.kind == kindTabView || part.kind == kindSegmented
    ret takes && part.shown && part.active
}

// Gives the keyboard to a component, or to none with 0: a text box receives the
// text of the keyboard, with its input method. The list of another combo box
// closes.
void focusTo(ref WindowData window, ref list<PartData> parts, i64 id) {
    if (window.popup != id) {
        window.popup = 0
    }
    if (window.focus == id) {
        ret
    }
    i64 old = partNumber(ref parts, window.focus)
    i64 now = partNumber(ref parts, id)
    bool wasText = old >= 0 && parts[old].kind == kindTextBox
    bool isText = now >= 0 && parts[now].kind == kindTextBox
    window.focus = id
    if (isText && window.screenKeyboard > 0) {
        window.revealFocus = true
    }
    if (wasText && !isText) {
        SDL_StopTextInput(window.window)
    } else if (isText && !wasText) {
        SDL_StartTextInput(window.window)
    }
    window.caretStart = SDL_GetTicksNS()
}

// Tab and Shift+Tab: the next or the previous component that takes the keyboard.
void moveFocus(ref WindowData window, ref list<PartData> parts, i64 step) {
    list<i64> order
    i64 current = -1
    for (i64 k = firstReached(ref window); k < window.order.len(); k++) {
        i64 i = window.order[k]
        if (focusable(ref parts[i])) {
            if (parts[i].id == window.focus) {
                current = order.len()
            }
            order.add(parts[i].id)
        }
    }
    if (order.len() == 0) {
        ret
    }
    i64 next = current < 0 ? (step > 0 ? 0 : order.len() - 1) : (current + step + order.len()) % order.len()
    focusTo(ref window, ref parts, order[next])
}

// With the list of a combo box open, a click outside it closes it and does nothing
// else (P39); on an item, the release chooses it.
void pressPart(ref WindowData window, ref list<PartData> parts, f32 x, f32 y, ref list<Call> calls) {
    i64 open = partNumber(ref parts, window.popup)
    if (open >= 0) {
        if (!inList(ref window, ref parts[open], x, y)) {
            window.popup = 0
        }
        ret
    }
    i64 p = partAt(ref window, ref parts, x, y)
    focusTo(ref window, ref parts, p >= 0 && focusable(ref parts[p]) ? parts[p].id : 0)
    if (p < 0 || !parts[p].active) {
        ret
    }
    window.held = parts[p].id
    if (parts[p].kind == kindTextBox) {
        parts[p].caret = indexAt(window.body, parts[p].text, x - parts[p].left - padding + parts[p].scroll)
        parts[p].anchor = parts[p].caret
        window.dragging = parts[p].id
    } else if (parts[p].kind == kindComboBox) {
        openList(ref window, ref parts[p])
    } else if (parts[p].kind == kindSlider) {
        slideTo(ref parts[p], x, ref calls)
    } else if (parts[p].kind == kindAppBar || parts[p].kind == kindNavigation || parts[p].kind == kindListView) {
        window.heldItem = barItemAt(ref parts[p], x, y)
    } else if (parts[p].kind == kindTable) {
        window.heldItem = tableItemAt(ref parts[p], x, y)
    } else if (parts[p].kind == kindTextView) {
        window.heldItem = pieceAt(ref parts[p], x, y)
    } else if (parts[p].kind == kindTabView || parts[p].kind == kindSegmented) {
        window.heldItem = choiceAt(ref parts[p], x, y)
    }
}

void releasePart(ref WindowData window, ref list<PartData> parts, f32 x, f32 y, ref list<Call> calls) {
    i64 p = partNumber(ref parts, window.held)
    window.held = 0
    window.dragging = 0
    i64 open = partNumber(ref parts, window.popup)
    if (open >= 0) {
        i64 item = itemAt(ref window, ref parts[open], x, y)
        if (item >= 0) {
            choose(ref parts[open], item, ref calls)
            window.popup = 0
        }
        ret
    }
    i64 item = window.heldItem
    window.heldItem = -1
    if (p >= 0 && parts[p].active && inside(ref parts[p], x, y)) {
        if (parts[p].kind == kindListView) {
            if (item >= 0 && rowAt(ref parts[p], y) == item) {
                chooseRow(ref parts[p], item, ref calls)
            }
        } else if (parts[p].kind == kindTable) {
            if (item != -1 && tableItemAt(ref parts[p], x, y) == item) {
                tableClick(ref window, ref parts[p], item, ref calls)
            }
        } else if (parts[p].kind == kindTextView) {
            if (item >= 0 && pieceAt(ref parts[p], x, y) == item) {
                pieceClick(ref parts[p], item, x, y, 1, ref calls)
            }
        } else if (parts[p].kind == kindTabView || parts[p].kind == kindSegmented) {
            if (item >= 0 && choiceAt(ref parts[p], x, y) == item) {
                chooseChoice(ref parts[p], item, ref calls)
            }
        } else if (parts[p].kind == kindAppBar || parts[p].kind == kindNavigation) {
            if (item >= 0 && barItemAt(ref parts[p], x, y) == item) {
                chooseItem(ref window, ref parts, p, item, ref calls)
            }
        } else {
            activate(ref parts[p], ref calls)
        }
    }
}

// ---- The sliders, the dialogs and the snackbar (D466-D468) ----

// The center of the knob of a slider, between the ends of its track.
f32 knobAt(ref PartData slider) {
    f32 from = slider.left + knob / 2
    f32 span = f32(slider.width) - knob
    if (slider.maximum == slider.minimum || span <= 0) {
        ret from
    }
    ret from + span * f32(slider.value - slider.minimum) / f32(slider.maximum - slider.minimum)
}

// The value of a slider for the mouse at x, and the handlers if it changes.
void slideTo(ref PartData slider, f32 x, ref list<Call> calls) {
    f32 span = f32(slider.width) - knob
    i64 value = slider.minimum
    if (span > 0) {
        f32 part = (x - slider.left - knob / 2) / span
        part = part < 0 ? 0 : part > 1 ? 1 : part
        value = slider.minimum + i64(part * f32(slider.maximum - slider.minimum) + 0.5)
    }
    setSlider(ref slider, value, ref calls)
}

void setSlider(ref PartData slider, i64 value, ref list<Call> calls) {
    i64 kept = value < slider.minimum ? slider.minimum : value > slider.maximum ? slider.maximum : value
    if (kept != slider.value) {
        slider.value = kept
        Call call = callOf(9, slider.change)
        call.index = kept
        calls.add(move call)
    }
}

// The keys of a slider (P48): false for those it does not use.
bool sliderKey(ref PartData slider, Key key, ref list<Call> calls) {
    i64 page = (slider.maximum - slider.minimum) / 10
    page = page > 0 ? page : 1
    if (key.code == keyLeft || key.code == keyDown) {
        setSlider(ref slider, slider.value - 1, ref calls)
    } else if (key.code == keyRight || key.code == keyUp) {
        setSlider(ref slider, slider.value + 1, ref calls)
    } else if (key.code == keyPageDown) {
        setSlider(ref slider, slider.value - page, ref calls)
    } else if (key.code == keyPageUp) {
        setSlider(ref slider, slider.value + page, ref calls)
    } else if (key.code == keyHome) {
        setSlider(ref slider, slider.minimum, ref calls)
    } else if (key.code == keyEnd) {
        setSlider(ref slider, slider.maximum, ref calls)
    } else {
        ret false
    }
    ret true
}

// The dialog closes with Esc or the back key: its handlers of onClose are called.
void endDialog(ref WindowData window, ref list<PartData> parts, ref list<Call> calls) {
    i64 card = partNumber(ref parts, window.dialog)
    window.dialog = 0
    window.dialogEnded = true
    if (card >= 0) {
        calls.add(callOf(6, parts[card].closing))
    }
}

// Whether the snackbar is shown, and where: at the bottom of the content, above the
// navigation bar, at most 560 pixels wide.
bool snackVisible(ref WindowData window) {
    if (window.snackFresh) {
        window.snackFresh = false
        window.snackShown = SDL_GetTicksNS()
    }
    ret window.snackText.len() > 0 && SDL_GetTicksNS() - window.snackShown < snackTime
}

Rect snackBox(ref WindowData window) {
    f32 width = least(f32(contentWidth(window)) - 16, 560)
    f32 bottom = window.originY + f32(contentHeight(window)) - 8 - window.snackLift
    if (window.navigation != 0 && window.screenKeyboard == 0) {
        bottom = bottom - navigationHeight()
    }
    ret Rect(window.originX + (f32(contentWidth(window)) - width) / 2, bottom - snackHeight, width, snackHeight)
}

// The action of the snackbar at a point, with 8 pixels around its text.
bool snackAt(ref WindowData window, f32 x, f32 y) {
    if (!snackVisible(ref window) || window.snackAction.len() == 0) {
        ret false
    }
    Rect box = snackBox(ref window)
    f32 size = textWidth(window.strong, window.snackAction, window.snackAction.len())
    f32 right = box.x + box.w - 8
    ret x >= right - size - 16 && x < right && y >= box.y && y < box.y + box.h
}

// ---- Scrolling (D460, P46) ----

// The panel or the list that scrolls under a point, the innermost, or -1.
i64 scrollerAt(ref WindowData window, ref list<PartData> parts, f32 x, f32 y) {
    for (i64 k = window.order.len() - 1; k >= firstReached(ref window); k--) {
        i64 i = window.order[k]
        if (parts[i].shown && scrolls(ref parts[i]) && inside(ref parts[i], x, y)) {
            ret i
        }
    }
    ret -1
}

// A finger on a panel or a list that scrolls may scroll it; the mouse scrolls it
// with its bar, on the right edge. True when the press is taken here.
bool startScroll(ref WindowData window, ref list<PartData> parts, f32 x, f32 y, bool finger) {
    i64 s = scrollerAt(ref window, ref parts, x, y)
    i64 under = partAt(ref window, ref parts, x, y)
    if (s < 0 || window.popup != 0 || (under >= 0 && parts[under].kind == kindSlider)) {
        ret false
    }
    parts[s].velocity = 0
    bool bar = !finger && x >= parts[s].left + f32(parts[s].width) - 10
    if (!finger && !bar) {
        ret false
    }
    window.scrolling = parts[s].id
    window.scrollBar = bar
    window.dragMoved = false
    window.dragStart = y
    window.dragY = y
    window.dragTime = SDL_GetTicksNS()
    ret bar
}

// The mouse moved with a finger, or with the bar held: the content follows, once
// the finger moved more than 8 pixels, and then the press is let go.
void dragScroll(ref WindowData window, ref list<PartData> parts, f32 y) {
    i64 s = partNumber(ref parts, window.scrolling)
    if (s < 0) {
        ret
    }
    u64 now = SDL_GetTicksNS()
    f32 seconds = f32(now - window.dragTime) / 1000000000
    if (window.scrollBar) {
        scrollBy(ref parts[s], (y - window.dragY) * parts[s].content / f32(parts[s].height))
    } else {
        if (!window.dragMoved && (y - window.dragStart > 8 || window.dragStart - y > 8)) {
            window.dragMoved = true
            window.held = 0
            window.heldItem = -1
            window.dragging = 0
            window.hot = 0
            window.popup = 0
        }
        if (window.dragMoved) {
            scrollBy(ref parts[s], window.dragY - y)
            if (seconds > 0) {
                parts[s].velocity = parts[s].velocity * 0.2 + (window.dragY - y) / seconds * 0.8
            }
        }
    }
    window.dragY = y
    window.dragTime = now
}

// The finger or the mouse let go: the content goes on with its speed after a
// finger. True when it scrolled, and so nothing is clicked.
bool endScroll(ref WindowData window, ref list<PartData> parts) {
    i64 s = partNumber(ref parts, window.scrolling)
    bool moved = window.dragMoved || window.scrollBar
    if (s >= 0 && (!window.dragMoved || SDL_GetTicksNS() - window.dragTime > 100000000)) {
        parts[s].velocity = 0  // a finger that stopped before it left
    }
    window.scrolling = 0
    window.scrollBar = false
    window.dragMoved = false
    ret moved
}

// At each frame the panels and the lists that a finger left go on, slowing down.
void glide(ref WindowData window, ref list<PartData> parts) {
    u64 now = SDL_GetTicksNS()
    f32 seconds = window.lastFrame == 0 ? 0 : f32(now - window.lastFrame) / 1000000000
    window.lastFrame = now
    if (seconds > 0.05) {
        seconds = 0.05
    }
    for (ref PartData part in parts) {
        if (part.window == window.id && part.velocity != 0 && part.id != window.scrolling) {
            scrollBy(ref part, part.velocity * seconds)
            part.velocity = part.velocity * (1 - least(1, seconds * 3))
            if (part.velocity < 20 && part.velocity > -20) {
                part.velocity = 0
            }
        }
    }
}

// The row of a list at a point of the window, or -1.
i64 rowAt(ref PartData view, f32 y) {
    i64 row = i64((y - view.top + view.offsetY) / rowHeight())
    ret row >= 0 && row < view.items.len() ? row : -1
}

// Scrolls a list so that a row is seen.
void showRow(ref PartData view, i64 row) {
    f32 top = f32(row) * rowHeight()
    view.velocity = 0
    if (top < view.offsetY) {
        scrollBy(ref view, top - view.offsetY)
    } else if (top + rowHeight() > view.offsetY + f32(view.height)) {
        scrollBy(ref view, top + rowHeight() - f32(view.height) - view.offsetY)
    }
}

// The keys of a list (P46): false for those it does not use.
bool listKey(ref PartData view, Key key, ref list<Call> calls) {
    i64 n = view.items.len()
    i64 page = i64(f32(view.height) / rowHeight())
    i64 next = view.selected
    if (key.code == keyUp) {
        next = view.selected > 0 ? view.selected - 1 : 0
    } else if (key.code == keyDown) {
        next = view.selected < n - 1 ? view.selected + 1 : n - 1
    } else if (key.code == keyHome) {
        next = 0
    } else if (key.code == keyEnd) {
        next = n - 1
    } else if (key.code == keyPageUp) {
        next = view.selected - page > 0 ? view.selected - page : 0
    } else if (key.code == keyPageDown) {
        next = view.selected + page < n - 1 ? view.selected + page : n - 1
    } else {
        ret false
    }
    if (next >= 0 && next < n) {
        chooseRow(ref view, next, ref calls)
    }
    ret true
}

// An item of a list chosen: it stays lit, and the handlers are called (D462).
void chooseRow(ref PartData view, i64 row, ref list<Call> calls) {
    view.selected = row
    showRow(ref view, row)
    Call call = callOf(9, view.change)
    call.index = row
    calls.add(move call)
}

// ---- The bars of the apps (D450, D451) ----

// The item of a bar at a point of the content, or -1: on an app bar 0 for the icon
// on the left and from 1 its actions, from the right; on a navigation bar its
// items, from the left.
i64 barItemAt(ref PartData bar, f32 x, f32 y) {
    if (bar.kind == kindAppBar) {
        f32 middle = bar.top + appBarHeight() / 2
        if (y < middle - 20 || y >= middle + 20) {
            ret -1
        }
        if (bar.icon != Icon.None && x >= bar.left + 8 && x < bar.left + 48) {
            ret 0
        }
        for (i64 k = 0; k < bar.icons.len(); k++) {
            f32 center = bar.left + f32(bar.width) - 28 - 44 * f32(k)
            if (x >= center - 20 && x < center + 20) {
                ret k + 1
            }
        }
        ret -1
    }
    if (bar.kind == kindListView) {
        ret rowAt(ref bar, y)
    }
    if (bar.kind == kindTable) {
        ret tableItemAt(ref bar, x, y)
    }
    if (bar.kind == kindTextView) {
        ret pieceAt(ref bar, x, y)
    }
    if (bar.kind == kindTabView || bar.kind == kindSegmented) {
        ret choiceAt(ref bar, x, y)
    }
    if (bar.kind == kindNavigation && bar.items.len() > 0 && bar.width > 0) {
        i64 item = i64((x - bar.left) * f32(bar.items.len()) / f32(bar.width))
        ret item >= 0 && item < bar.items.len() ? item : -1
    }
    ret -1
}

// A click on an item of a bar: an icon of an app bar calls its handlers, an item of
// a navigation bar shows its page.
void chooseItem(ref WindowData window, ref list<PartData> parts, i64 p, i64 item, ref list<Call> calls) {
    if (parts[p].kind == kindAppBar) {
        if (item == 0) {
            calls.add(callOf(6, parts[p].click))
        } else {
            list<addr> boxes
            boxes.add(parts[p].actions[item - 1])
            calls.add(callOf(6, boxes))
        }
    } else if (item != parts[p].selected) {
        parts[p].selected = item
        focusTo(ref window, ref parts, 0)
        Call call = callOf(9, parts[p].change)
        call.index = item
        calls.add(move call)
    }
}

// ---- The list of a combo box (D445) ----

// How many items the list shows: up to 8, and as many as fit below the combo box
// or above it, where there is more room.
i64 rowsOf(ref WindowData window, ref PartData box) {
    f32 below = window.originY + f32(contentHeight(window)) - box.top - f32(box.height) - 8
    f32 above = box.top - window.originY - 8
    i64 fit = i64((most(below, above) - 6) / itemHeight())
    i64 rows = box.items.len() < listRows ? box.items.len() : listRows
    if (fit < rows) {
        rows = fit < 1 ? 1 : fit
    }
    ret rows
}

// Where the list is, in the content: below the combo box, or above it when there
// is no room below.
Rect listOf(ref WindowData window, ref PartData box) {
    f32 h = f32(rowsOf(ref window, ref box)) * itemHeight() + 6
    f32 top = box.top + f32(box.height) + 3
    if (top + h > window.originY + f32(contentHeight(window)) - 4 && box.top - 3 - h >= window.originY + 4) {
        top = box.top - 3 - h
    }
    ret Rect(box.left, top, f32(box.width), h)
}

bool inList(ref WindowData window, ref PartData box, f32 x, f32 y) {
    Rect area = listOf(ref window, ref box)
    ret x >= area.x && x < area.x + area.w && y >= area.y && y < area.y + area.h
}

// The item at a point of the content, or -1.
i64 itemAt(ref WindowData window, ref PartData box, f32 x, f32 y) {
    Rect area = listOf(ref window, ref box)
    if (x < area.x || x >= area.x + area.w || y < area.y + 3 || y >= area.y + area.h - 3) {
        ret -1
    }
    i64 item = box.first + i64((y - area.y - 3) / itemHeight())
    ret item < box.items.len() ? item : -1
}

void openList(ref WindowData window, ref PartData box) {
    if (box.items.len() == 0) {
        ret
    }
    window.popup = box.id
    box.highlight = box.selected >= 0 ? box.selected : 0
    reveal(ref window, ref box, true)
}

// Scrolls the list so that the item pointed at is in it, with `follow`, and not
// beyond its items.
void reveal(ref WindowData window, ref PartData box, bool follow) {
    i64 rows = rowsOf(ref window, ref box)
    if (follow && box.highlight < box.first) {
        box.first = box.highlight
    }
    if (follow && box.highlight >= box.first + rows) {
        box.first = box.highlight - rows + 1
    }
    if (box.first > box.items.len() - rows) {
        box.first = box.items.len() - rows
    }
    if (box.first < 0) {
        box.first = 0
    }
}

// The user chooses an item: the handlers of onChange are called when it changes.
void choose(ref PartData box, i64 item, ref list<Call> calls) {
    if (item == box.selected) {
        ret
    }
    box.selected = item
    Call call = callOf(9, box.change)
    call.index = item
    calls.add(move call)
}

// The next item after `from` that starts with a letter, or -1.
i64 itemByLetter(ref PartData box, i64 code, i64 from) {
    for (i64 k = 1; k <= box.items.len(); k++) {
        i64 i = (from + k) % box.items.len()
        list<u8> bytes = box.items[i].bytes()
        if (bytes.len() > 0 && lowerByte(bytes[0]) == lowerByte(u8(code))) {
            ret i
        }
    }
    ret -1
}

u8 lowerByte(u8 b) {
    ret b >= 65 && b <= 90 ? b + 32 : b
}

// The keys of a combo box (P39): false for those it does not use.
bool comboKey(ref WindowData window, ref PartData box, Key key, ref list<Call> calls) {
    i64 code = key.code
    i64 n = box.items.len()
    bool letter = !key.control && !key.alt && code > 32 && code < 127
    if (window.popup == box.id) {
        if (code == 27) {  // Esc
            window.popup = 0
        } else if (code == 13 || code == keyEnter || code == 32) {
            if (box.highlight >= 0 && box.highlight < n) {
                choose(ref box, box.highlight, ref calls)
            }
            window.popup = 0
        } else if (code == keyUp && box.highlight > 0) {
            box.highlight--
        } else if (code == keyDown && box.highlight < n - 1) {
            box.highlight++
        } else if (code == keyHome) {
            box.highlight = 0
        } else if (code == keyEnd) {
            box.highlight = n - 1
        } else if (letter) {
            i64 found = itemByLetter(ref box, code, box.highlight)
            if (found >= 0) {
                box.highlight = found
            }
        } else if (code != keyUp && code != keyDown) {
            ret false
        }
        reveal(ref window, ref box, true)
        ret true
    }
    if (code == 32 || code == 13 || code == keyEnter || (key.alt && code == keyDown)) {
        openList(ref window, ref box)
        ret true
    }
    i64 next = -1
    if (code == keyUp) {
        next = box.selected > 0 ? box.selected - 1 : 0
    } else if (code == keyDown) {
        next = box.selected < n - 1 ? box.selected + 1 : n - 1
    } else if (code == keyHome) {
        next = 0
    } else if (code == keyEnd) {
        next = n - 1
    } else if (letter) {
        next = itemByLetter(ref box, code, box.selected)
    } else {
        ret false
    }
    if (next >= 0 && next < n) {
        choose(ref box, next, ref calls)
    }
    ret true
}

// A click, or Space: a button calls its handlers, a check box changes.
void activate(ref PartData part, ref list<Call> calls) {
    if (part.kind == kindButton) {
        calls.add(callOf(6, part.click))
    } else if (part.kind == kindCheckBox || part.kind == kindSwitch) {
        part.checked = !part.checked
        part.flipped = SDL_GetTicksNS()
        Call call = callOf(8, part.change)
        call.value = part.checked
        calls.add(move call)
    }
}

// A key for the component in focus: false if it does not use it.
bool keyOfPart(ref WindowData window, ref list<PartData> parts, Key key, ref list<Call> calls) {
    if (key.code == 9) {  // Tab
        moveFocus(ref window, ref parts, key.shift ? -1 : 1)
        ret true
    }
    i64 f = partNumber(ref parts, window.focus)
    if (f < 0 || !parts[f].active || !parts[f].shown) {
        ret false
    }
    if (parts[f].kind == kindTextBox) {
        window.caretStart = SDL_GetTicksNS()
        ret edit(ref parts[f], key, ref calls)
    }
    if (parts[f].kind == kindComboBox) {
        ret comboKey(ref window, ref parts[f], key, ref calls)
    }
    if (parts[f].kind == kindListView) {
        ret listKey(ref parts[f], key, ref calls)
    }
    if (parts[f].kind == kindTable) {
        ret tableKey(ref parts[f], key, ref calls)
    }
    if (parts[f].kind == kindSlider) {
        ret sliderKey(ref parts[f], key, ref calls)
    }
    if (parts[f].kind == kindTabView || parts[f].kind == kindSegmented) {
        ret choiceKey(ref parts[f], key, ref calls)
    }
    if (key.code == 32 || (key.code == 13 && parts[f].kind == kindButton)) {  // Space, Enter
        activate(ref parts[f], ref calls)
        ret true
    }
    ret false
}

const i64 keyLeft = 0x40000050
const i64 keyRight = 0x4000004F
const i64 keyHome = 0x4000004A
const i64 keyEnd = 0x4000004D
const i64 keyEnter = 0x40000058  // of the numeric keypad
const i64 keyUp = 0x40000052
const i64 keyBack = 0x4000011A  // SDLK_AC_BACK, of Android
const i64 keyPageUp = 0x4000004B
const i64 keyPageDown = 0x4000004E
const i64 keyDown = 0x40000051

// The editing of a text box: the characters come with the text of the keyboard.
bool edit(ref PartData box, Key key, ref list<Call> calls) {
    i64 code = key.code
    if (code == 8) {  // Backspace
        if (!removeSelection(ref box) && box.caret > 0) {
            i64 from = previousCharacter(box.text, box.caret)
            box.text = box.text.slice(0, from).concat(box.text.slice(box.caret, box.text.len()))
            box.caret = from
            box.anchor = from
        }
        changed(ref box, ref calls)
    } else if (code == 0x7F) {  // Delete
        if (!removeSelection(ref box) && box.caret < box.text.len()) {
            i64 to = nextCharacter(box.text, box.caret)
            box.text = box.text.slice(0, box.caret).concat(box.text.slice(to, box.text.len()))
        }
        changed(ref box, ref calls)
    } else if (code == keyLeft || code == keyRight || code == keyHome || code == keyEnd) {
        i64 low = box.caret < box.anchor ? box.caret : box.anchor
        i64 high = box.caret < box.anchor ? box.anchor : box.caret
        if (code == keyLeft) {
            box.caret = !key.shift && low != high ? low : previousCharacter(box.text, box.caret)
        } else if (code == keyRight) {
            box.caret = !key.shift && low != high ? high : nextCharacter(box.text, box.caret)
        } else if (code == keyHome) {
            box.caret = 0
        } else {
            box.caret = box.text.len()
        }
        if (!key.shift) {
            box.anchor = box.caret
        }
    } else if (code == 13 || code == keyEnter) {
        Call call = callOf(7, box.enter)
        call.text = box.text
        calls.add(move call)
    } else if (key.control && code == 97) {  // Ctrl+A
        box.anchor = 0
        box.caret = box.text.len()
    } else if (key.control && (code == 99 || code == 120)) {  // Ctrl+C, Ctrl+X
        if (box.caret != box.anchor) {
            SDL_SetClipboardText(selection(ref box).cstring())
            if (code == 120) {
                removeSelection(ref box)
                changed(ref box, ref calls)
            }
        }
    } else if (key.control && code == 118) {  // Ctrl+V: the text in one line
        addr none
        addr pasted = SDL_GetClipboardText()
        if (pasted != none) {
            string line = cText(pasted).replace("\r\n", " ").replace("\n", " ").replace("\r", " ")
            SDL_free(pasted)
            insert(ref box, line)
            changed(ref box, ref calls)
        }
    } else {
        ret !key.control && !key.alt && code >= 32 && code < 127
    }
    ret true
}

void changed(ref PartData box, ref list<Call> calls) {
    Call call = callOf(7, box.change)
    call.text = box.text
    calls.add(move call)
}

string selection(ref PartData box) {
    i64 low = box.caret < box.anchor ? box.caret : box.anchor
    i64 high = box.caret < box.anchor ? box.anchor : box.caret
    ret box.text.slice(low, high)
}

// Removes the text selected: false without a selection.
bool removeSelection(ref PartData box) {
    if (box.caret == box.anchor) {
        ret false
    }
    i64 low = box.caret < box.anchor ? box.caret : box.anchor
    i64 high = box.caret < box.anchor ? box.anchor : box.caret
    box.text = box.text.slice(0, low).concat(box.text.slice(high, box.text.len()))
    box.caret = low
    box.anchor = low
    ret true
}

void insert(ref PartData box, string piece) {
    removeSelection(ref box)
    box.text = box.text.slice(0, box.caret).concat(piece).concat(box.text.slice(box.caret, box.text.len()))
    box.caret = box.caret + piece.len()
    box.anchor = box.caret
}

// Where the characters of UTF-8 start: a byte 10xxxxxx continues one.
i64 previousCharacter(string s, i64 at) {
    list<u8> bytes = s.bytes()
    i64 i = at - 1
    for (i > 0 && (bytes[i] & 0xC0) == 0x80) {
        i--
    }
    ret i < 0 ? 0 : i
}

i64 nextCharacter(string s, i64 at) {
    list<u8> bytes = s.bytes()
    if (at >= bytes.len()) {
        ret bytes.len()
    }
    i64 i = at + 1
    for (i < bytes.len() && (bytes[i] & 0xC0) == 0x80) {
        i++
    }
    ret i
}

// The place between two characters nearest to x, from the start of the text.
i64 indexAt(addr font, string s, f32 x) {
    i64 at = 0
    f32 left = 0
    for (at < s.len()) {
        i64 next = nextCharacter(s, at)
        f32 right = textWidth(font, s, next)
        if (x < (left + right) / 2) {
            ret at
        }
        at = next
        left = right
    }
    ret s.len()
}

// ---- The layout: the groups (D444) and the anchors (D447, P40) ----

// Where the components of a group go: its place in the content, its size, whether
// it is shown and enabled, and the rectangle that clips them.
struct Frame {
    f32 left
    f32 top
    i32 width
    i32 height
    bool shown
    bool active
    f32 clipLeft
    f32 clipTop
    f32 clipRight
    f32 clipBottom
    f32 scrolled  // how far its panel is scrolled
}

// Places the components of a window in its content, each group before its
// components, in the order they are drawn. The list of a combo box hidden or
// disabled closes.
void layout(ref WindowData window, ref list<PartData> parts) {
    window.order.clear()
    Frame content
    content.left = window.originX
    content.top = window.originY
    content.width = contentWidth(window)
    content.height = contentHeight(window)
    content.shown = true
    content.active = true
    content.clipLeft = content.left
    content.clipTop = content.top
    content.clipRight = content.left + f32(content.width)
    content.clipBottom = content.top + f32(content.height)
    layoutIn(ref window, ref parts, 0, content)
    window.dialogStart = window.order.len()
    liftSnackbar(ref window, ref parts)
    i64 card = partNumber(ref parts, window.dialog)
    if (card >= 0) {
        layoutDialog(ref window, ref parts, card, content)
    }
    if (window.dialogFresh) {  // the focus to the first component of the dialog that takes it
        window.dialogFresh = false
        i64 first = 0
        for (i64 k = window.dialogStart; k < window.order.len() && first == 0; k++) {
            if (focusable(ref parts[window.order[k]])) {
                first = parts[window.order[k]].id
            }
        }
        focusTo(ref window, ref parts, first)
    }
    if (window.dialogEnded) {  // and back where it was
        window.dialogEnded = false
        window.popup = 0
        focusTo(ref window, ref parts, partNumber(ref parts, window.dialogFocus) >= 0 ? window.dialogFocus : 0)
    }
    i64 open = partNumber(ref parts, window.popup)
    if (open < 0 || !parts[open].shown || !parts[open].active) {
        window.popup = 0
    }
    if (window.revealFocus) {  // above the keyboard on the screen (D471)
        window.revealFocus = false
        if (bringIntoView(ref parts, window.focus)) {
            layout(ref window, ref parts)
        }
    }
}

// The snackbar goes above the components anchored at the bottom of the content that
// it would cover, as a floating button in the Scaffold of Material 3 (D472).
void liftSnackbar(ref WindowData window, ref list<PartData> parts) {
    window.snackLift = 0
    bool moved = true
    for (moved) {
        moved = false
        Rect box = snackBox(ref window)
        for (i64 k = 0; k < window.dialogStart && !moved; k++) {
            i64 i = window.order[k]
            bool low = parts[i].vertical == Vertical.Bottom && parts[i].kind != kindNavigation && parts[i].shown
            if (low && parts[i].left < box.x + box.w && parts[i].left + f32(parts[i].width) > box.x &&
                parts[i].top < box.y + box.h && parts[i].top + f32(parts[i].height) > box.y) {
                window.snackLift = window.snackLift + box.y + box.h - (parts[i].top - 8)
                moved = true
            }
        }
    }
}

// Scrolls the panels that hold a component, from the innermost, so that it is seen
// with 8 pixels around it: true when one scrolled (D471).
bool bringIntoView(ref list<PartData> parts, i64 id) {
    i64 p = partNumber(ref parts, id)
    if (p < 0) {
        ret false
    }
    f32 top = parts[p].top - 8
    f32 bottom = parts[p].top + f32(parts[p].height) + 8
    bool moved = false
    i64 holder = partNumber(ref parts, parts[p].parent)
    for (holder >= 0) {
        if (parts[holder].kind == kindPanel && scrolls(ref parts[holder])) {
            f32 delta = 0
            f32 low = parts[holder].top + f32(parts[holder].height)
            if (bottom > low) {
                delta = bottom - low
            }
            if (top - delta < parts[holder].top) {
                delta = top - parts[holder].top
            }
            f32 before = parts[holder].offsetY
            scrollBy(ref parts[holder], delta)
            f32 done = parts[holder].offsetY - before
            top = top - done
            bottom = bottom - done
            moved = moved || done != 0
        }
        holder = partNumber(ref parts, parts[holder].parent)
    }
    ret moved
}

// A dialog at the center of the content, at most as large as the content less 32
// pixels, its buttons in the band at the bottom right, each as wide as its text and 24
// pixels, at least 64, 72 on a phone, the last the main one (P48, D479).
void layoutDialog(ref WindowData window, ref list<PartData> parts, i64 card, Frame content) {
    placeDialog(ref parts[card], content)
    window.order.add(card)
    list<i64> buttons
    for (i64 i = 0; i < parts.len(); i++) {
        if (parts[i].parent == parts[card].id && parts[i].action != 0) {
            buttons.add(i)
        }
    }
    f32 right = f32(parts[card].width) - 12
    f32 footer = dialogFooter()
    for (i64 k = buttons.len() - 1; k >= 0; k--) {
        i64 b = buttons[k]
        f32 w = most(comfortable() ? 72 : 64, textWidth(window.strong, parts[b].text, parts[b].text.len()) + 24)
        right = right - w
        parts[b].x = i32(right)
        parts[b].y = parts[card].height - i32((footer + dialogButton()) / 2)
        parts[b].width = i32(w)
        parts[b].height = i32(dialogButton())
        parts[b].action = k == buttons.len() - 1 ? 1 : 2
        right = right - (comfortable() ? 8 : 7)
    }
    Frame inner
    inner.left = parts[card].left
    inner.top = parts[card].top
    inner.width = parts[card].width
    inner.height = parts[card].height
    inner.shown = true
    inner.active = true
    inner.clipLeft = most(content.clipLeft, inner.left)
    inner.clipTop = most(content.clipTop, inner.top)
    inner.clipRight = least(content.clipRight, inner.left + f32(inner.width))
    inner.clipBottom = least(content.clipBottom, inner.top + f32(inner.height))
    layoutIn(ref window, ref parts, parts[card].id, inner)
}

void placeDialog(ref PartData dialog, Frame content) {
    i32 width = dialog.baseWidth < content.width - 32 ? dialog.baseWidth : content.width - 32
    i32 height = dialog.baseHeight < content.height - 32 ? dialog.baseHeight : content.height - 32
    dialog.width = width > 0 ? width : 0
    dialog.height = height > 0 ? height : 0
    dialog.x = (content.width - dialog.width) / 2
    dialog.y = (content.height - dialog.height) / 2
    dialog.left = content.left + f32(dialog.x)
    dialog.top = content.top + f32(dialog.y)
    dialog.shown = true
    dialog.active = true
    dialog.clipLeft = content.clipLeft
    dialog.clipTop = content.clipTop
    dialog.clipRight = content.clipRight
    dialog.clipBottom = content.clipBottom
}

// The first component of order that the mouse and the keys reach: those of the
// dialog when one is open (D467).
i64 firstReached(ref WindowData window) {
    ret window.dialog != 0 ? window.dialogStart : 0
}

void layoutIn(ref WindowData window, ref list<PartData> parts, i64 group, Frame frame) {
    for (i64 i = 0; i < parts.len(); i++) {
        if (parts[i].window != window.id || parts[i].parent != group || parts[i].kind == kindDialog) {
            continue  // a dialog comes after the rest
        }
        bool hidden = false
        if (parts[i].action != 0) {
            // placed by layoutDialog
        } else if (parts[i].page >= 0) {
            if (parts[i].parent != 0) {
                placeTabPage(ref parts[i], frame.width, frame.height)
            } else {
                placePage(ref parts[i], ref window)
            }
            i64 bar = partNumber(ref parts, parts[i].bar)
            hidden = bar < 0 || parts[bar].selected != parts[i].page || !parts[bar].visible
        } else {
            arrange(ref parts[i], frame.width, frame.height)
            hidden = parts[i].kind == kindNavigation && window.screenKeyboard > 0  // under the keyboard (D471)
        }
        parts[i].left = frame.left + f32(parts[i].x)
        parts[i].top = frame.top + f32(parts[i].y)
        if (parts[i].vertical != Vertical.Top) {  // it follows the height seen, and stays (P46)
            parts[i].top = parts[i].top + frame.scrolled
        }
        parts[i].shown = frame.shown && parts[i].visible && !hidden
        parts[i].active = frame.active && parts[i].enabled
        parts[i].clipLeft = frame.clipLeft
        parts[i].clipTop = frame.clipTop
        parts[i].clipRight = frame.clipRight
        parts[i].clipBottom = frame.clipBottom
        window.order.add(i)
        if (parts[i].kind == kindListView) {
            parts[i].content = f32(parts[i].items.len()) * rowHeight()
            clampScroll(ref parts[i])
        }
        if (parts[i].kind == kindTable) {  // D486: the titles, then the rows
            parts[i].content = tableHeader() + f32(parts[i].tableRows) * tableRow()
            clampScroll(ref parts[i])
        }
        if (parts[i].kind == kindTextView) {  // D490: its height from its last layout
            clampScroll(ref parts[i])
        }
        if (parts[i].kind == kindGroup || parts[i].kind == kindPanel || parts[i].kind == kindTabView) {
            Frame inner
            inner.left = parts[i].left
            inner.top = parts[i].top
            if (parts[i].kind == kindPanel) {  // D460
                parts[i].content = contentOf(ref parts, window.id, parts[i].id, parts[i].width, parts[i].height)
                clampScroll(ref parts[i])
                inner.top = parts[i].top - parts[i].offsetY
                inner.scrolled = parts[i].offsetY
            }
            inner.width = parts[i].width
            inner.height = parts[i].height
            inner.shown = parts[i].shown
            inner.active = parts[i].active
            inner.clipLeft = most(frame.clipLeft, parts[i].left)
            inner.clipTop = most(frame.clipTop, parts[i].top)
            inner.clipRight = least(frame.clipRight, parts[i].left + f32(parts[i].width))
            inner.clipBottom = least(frame.clipBottom, parts[i].top + f32(parts[i].height))
            layoutIn(ref window, ref parts, parts[i].id, inner)
        }
    }
}

// The height of what a panel has: its components visible anchored at the top,
// arranged for its size, and 16 pixels under the lowest when it ends below the
// panel (P46). The others follow the height seen.
f32 contentOf(ref list<PartData> parts, i64 window, i64 panel, i32 width, i32 height) {
    f32 bottom = 0
    for (i64 i = 0; i < parts.len(); i++) {
        if (parts[i].window == window && parts[i].parent == panel && parts[i].visible && parts[i].vertical == Vertical.Top) {
            arrange(ref parts[i], width, height)
            bottom = most(bottom, f32(parts[i].y + parts[i].height))
        }
    }
    ret bottom > f32(height) ? bottom + 16 : bottom
}

// A panel or a list is scrolled from 0 to its content less its height.
void clampScroll(ref PartData part) {
    f32 most = part.content - f32(part.height)
    if (part.offsetY > most) {
        part.offsetY = most
        part.velocity = 0
    }
    if (part.offsetY < 0) {
        part.offsetY = 0
        part.velocity = 0
    }
}

// Scrolls a panel or a list, and shows its bar for a while.
void scrollBy(ref PartData part, f32 delta) {
    f32 before = part.offsetY
    part.offsetY = part.offsetY + delta
    clampScroll(ref part)
    if (part.offsetY != before) {
        part.scrollShown = SDL_GetTicksNS()
    }
}

bool scrolls(ref PartData part) {
    ret (part.kind == kindPanel || part.kind == kindListView || part.kind == kindTable || part.kind == kindTextView) &&
        part.content > f32(part.height)
}

// The position and the size of a component, for the size of its parent now.
void arrange(ref PartData part, i32 width, i32 height) {
    i32 dw = width - part.parentWidth
    i32 dh = height - part.parentHeight
    part.x = part.baseX
    part.y = part.baseY
    part.width = part.baseWidth
    part.height = part.baseHeight
    if (part.horizontal == Horizontal.Right) {
        part.x = part.baseX + dw
    } else if (part.horizontal == Horizontal.Stretch) {
        part.width = part.baseWidth + dw > 0 ? part.baseWidth + dw : 0
    } else if (part.horizontal == Horizontal.Center) {
        part.x = part.baseX + dw / 2
    }
    if (part.vertical == Vertical.Bottom) {
        part.y = part.baseY + dh
    } else if (part.vertical == Vertical.Stretch) {
        part.height = part.baseHeight + dh > 0 ? part.baseHeight + dh : 0
    } else if (part.vertical == Vertical.Center) {
        part.y = part.baseY + dh / 2
    }
}

// ---- The drawing ----

void draw() {
    withData([](ref Shared data) {
        for (ref WindowData window in data.windows) {
            addr none
            if (window.window != none && !window.closing) {
                drawWindow(ref window, ref data.parts, ref data.images)
                for (ref Call call in window.requests) {  // D486: called before the next frame
                    data.pending.add(move call)
                }
                window.requests.clear()
            }
        }
    })
}

// The content with its components, the title bar with its title and its buttons,
// and a line at the edges when the window is not maximized (D431).
void drawWindow(ref WindowData window, ref list<PartData> parts, ref list<ImageData> images) {
    i32 w = 0
    i32 h = 0
    SDL_GetWindowSize(window.window, ref w, ref h)
    f32 scale = toWindow(ref window)
    f32 width = f32(w) / scale
    f32 height = f32(h) / scale
    if (window.phone) {
        readSafeArea(ref window)
    } else {
        cromo_gui_chrome_size(window.chrome, barHeight * scale, 3 * buttonWidth * scale, edgeWidth * scale, window.resizable)
    }
    window.maximized = (SDL_GetWindowFlags(window.window) & 0x80) != 0
    bool dark = window.theme == Theme.Dark || (window.theme == Theme.System && SDL_GetSystemTheme() == 2)
    Colors c = colorsOf(dark)
    addr r = window.renderer
    fill(r, c.background, 0, 0, width, height)
    if (window.phone) {  // the bars of the system of the color of the bars of the app (D456)
        fill(r, c.surface, 0, 0, width, window.originY)
        fill(r, c.surface, 0, height - window.barsBottom, width, window.barsBottom)
        if (window.systemBars != (dark ? 1 : 0)) {
            window.systemBars = dark ? 1 : 0
            cromo_gui_system_bars(c.surface, !dark)
        }
    }

    glide(ref window, ref parts)
    checkLongPress(ref window, ref parts)
    layout(ref window, ref parts)
    drawParts(ref window, ref parts, ref c, 0, window.dialogStart, ref images)
    if (window.dialog != 0) {  // the rest darkened under the dialog (D467)
        clipTo(r, window.originX, window.originY, f32(contentWidth(window)), f32(contentHeight(window)))
        shade(r, scrim, window.originX, window.originY, f32(contentWidth(window)), f32(contentHeight(window)))
        drawParts(ref window, ref parts, ref c, window.dialogStart, window.order.len(), ref images)
    }
    i64 open = partNumber(ref parts, window.popup)
    if (open >= 0) {
        clipTo(r, window.originX, window.originY, f32(contentWidth(window)), f32(contentHeight(window)))
        drawList(ref window, ref parts[open], ref c)
    }
    if (snackVisible(ref window)) {
        clipTo(r, window.originX, window.originY, f32(contentWidth(window)), f32(contentHeight(window)))
        drawSnackbar(ref window, ref c, dark)
    }
    if (window.menuOpen) {  // over everything (D496)
        clipTo(r, window.originX, window.originY, f32(contentWidth(window)), f32(contentHeight(window)))
        drawMenu(ref window, ref parts, ref c)
    }
    i64 tip = tipPart(ref window, ref parts)
    if (tip >= 0) {  // D497
        clipTo(r, window.originX, window.originY, f32(contentWidth(window)), f32(contentHeight(window)))
        drawTooltip(ref window, ref c, parts[tip].tooltip)
    }
    addr none
    SDL_SetRenderClipRect(r, none)
    if (!window.phone) {
        drawTitleBar(ref window, ref c, width, height)
    }
    SDL_RenderPresent(r)
}

// The components from first to end, excluded, in order, then the bars of those that
// scroll, over them.
void drawParts(ref WindowData window, ref list<PartData> parts, ref Colors c, i64 first, i64 end, ref list<ImageData> images) {
    addr r = window.renderer
    for (i64 k = first; k < end; k++) {
        i64 i = window.order[k]
        if (parts[i].shown && parts[i].clipRight > parts[i].clipLeft && parts[i].clipBottom > parts[i].clipTop) {
            clipPart(r, ref parts[i])
            drawPart(ref window, ref parts[i], ref c, ref images)
        }
    }
    u64 now = SDL_GetTicksNS()
    for (i64 k = first; k < end; k++) {
        i64 i = window.order[k]
        bool seen = now - parts[i].scrollShown < 1000000000 || window.scrolling == parts[i].id ||
            !window.phone && inside(ref parts[i], window.pointerX, window.pointerY)
        if (parts[i].shown && scrolls(ref parts[i]) && seen) {
            clipPart(r, ref parts[i])
            drawScrollBar(ref window, ref parts[i], ref c)
        }
    }
}

// A color, 0xAARRGGBB, over a rectangle.
void shade(addr renderer, u32 argb, f32 x, f32 y, f32 w, f32 h) {
    SDL_SetRenderDrawBlendMode(renderer, 1)  // SDL_BLENDMODE_BLEND
    SDL_SetRenderDrawColor(renderer, red(argb), green(argb), blue(argb), u8(argb >> 24))
    Rect area = Rect(x, y, w, h)
    SDL_RenderFillRect(renderer, ref area)
}

// The shadow of the cards, of the dialogs and of the lists (D479): a sharp one just
// under the box, and a soft one, smaller than the box and further down.
void cardShadow(addr renderer, f32 x, f32 y, f32 w, f32 h, f32 radius, f32 density, ref Colors c) {
    cromo_gui_shadow(renderer, x, y, w, h, radius, density, c.shadowNear, 2, 1)
    if (w > 36 && h > 26) {  // as 0 10px 26px -18px of CSS: hardly at the sides, softly under the box
        cromo_gui_shadow(renderer, x + 18, y + 18, w - 36, h - 26, radius, density, c.shadowFar, 20, 0)
    }
}

// The title of a band, as those of the groups and of the dialogs: small, semibold, in
// capitals and spaced (D479), on the middle of the band, from x.
void bandTitle(ref WindowData window, string title, f32 x, f32 top, f32 height, u32 rgb, bool enabled) {
    f32 ascent = 0
    f32 descent = 0
    f32 gap = 0
    cromo_gui_font_metrics(window.band, ref ascent, ref descent, ref gap)
    f32 baseline = top + height / 2 + (ascent - descent) / 2
    string upper = title.upper()
    f32 spacing = bandSize() * 0.09
    f32 at = x
    i64 next = 0
    for (i64 i = 0; i < upper.len(); i = next) {
        u8 lead = upper[i]
        next = least64(i + (lead < 0x80 ? 1 : lead < 0xE0 ? 2 : lead < 0xF0 ? 3 : 4), upper.len())
        string letter = upper.slice(i, next)
        text(window.band, letter, at, baseline, rgb, enabled)
        at = at + textWidth(window.band, letter, letter.len()) + spacing
    }
}

i64 least64(i64 a, i64 b) {
    ret a < b ? a : b
}

// A card with a band at its top, as the groups and the dialogs: the band in the
// second surface, with a line under it, and the rest of the card in the first.
void bandCard(addr renderer, ref PartData part, f32 band, f32 radius, f32 density, ref Colors c, u32 border) {
    f32 x = part.left
    f32 y = part.top
    f32 w = f32(part.width)
    f32 h = f32(part.height)
    cromo_gui_box(renderer, x, y, w, h, radius, 1, density, solid(c.surface, true), solid(border, true))
    if (band > 0) {
        clipInside(renderer, ref part, x, y, w, band)
        cromo_gui_box(renderer, x, y, w, h, radius, 1, density, solid(c.surface2, true), solid(border, true))
        clipPart(renderer, ref part)
        fill(renderer, c.rule, x + 1, y + band - 1, w - 2, 1)
    }
}

// The snackbar (D468): in the colors of the other theme, the text of the ink on the
// ink, and its action in the accent of the other theme, which reads on it.
void drawSnackbar(ref WindowData window, ref Colors c, bool dark) {
    addr r = window.renderer
    f32 d = window.density
    Rect box = snackBox(ref window)
    cardShadow(r, box.x, box.y, box.w, box.h, 8, d, ref c)
    cromo_gui_box(r, box.x, box.y, box.w, box.h, 8, 0, d, solid(c.ink, true), 0)
    f32 ascent = 0
    f32 descent = 0
    f32 gap = 0
    cromo_gui_font_metrics(window.body, ref ascent, ref descent, ref gap)
    f32 baseline = box.y + box.h / 2 + (ascent - descent) / 2
    f32 right = box.x + box.w - 16
    if (window.snackAction.len() > 0) {
        f32 size = textWidth(window.strong, window.snackAction, window.snackAction.len())
        right = right - size
        if (window.snackHot) {
            cromo_gui_box(r, right - 8, box.y + 6, size + 16, box.h - 12, 6, 0, d, solid(dark ? 0xD5DDE3 : 0x2A343B, true), 0)
        }
        text(window.strong, window.snackAction, right, baseline, dark ? 0x8A5A12 : 0xE0A64A, true)
        right = right - 16
    }
    clipTo(r, box.x + 16, box.y, most(right - box.x - 16, 0), box.h)
    text(window.body, window.snackText, box.x + 16, baseline, c.surface, true)
}

// The title bar, its title and its buttons, and a line at the edges when the
// window is not maximized (D431).
void drawTitleBar(ref WindowData window, ref Colors c, f32 width, f32 height) {
    addr r = window.renderer
    fill(r, c.surface, 0, 0, width, barHeight)
    u32 title = window.focused ? c.ink2 : c.ink3
    f32 ascent = 0
    f32 descent = 0
    f32 gap = 0
    cromo_gui_font_metrics(window.font, ref ascent, ref descent, ref gap)
    f32 titleWidth = textWidth(window.font, window.title, window.title.len())
    text(window.font, window.title, (width - titleWidth) / 2, barHeight / 2 + (ascent - descent) / 2, title, true)
    for (i32 b = 0; b < 3; b++) {
        f32 x = width - f32(3 - b) * buttonWidth
        u32 symbol = title
        bool disabled = b == 1 && !window.resizable
        if (b == 2 && window.hovered == 2) {
            fill(r, window.pressed == 2 ? closePressed : closeHover, x, 0, buttonWidth, barHeight)
            symbol = 0xFFFFFF
        } else if (b == window.hovered && !disabled) {
            fill(r, window.pressed == b ? c.surface3 : c.surface2, x, 0, buttonWidth, barHeight)
        }
        if (disabled) {
            symbol = c.rule2
        }
        i32 kind = b == 2 ? 3 : b == 1 && window.maximized ? 2 : b
        cromo_gui_symbol(r, kind, x + buttonWidth / 2, barHeight / 2, window.density, red(symbol), green(symbol), blue(symbol))
    }
    fill(r, c.rule, 0, barHeight - 1, width, 1)
    if (!window.maximized) {
        SDL_SetRenderDrawColor(r, red(c.rule2), green(c.rule2), blue(c.rule2), 255)
        Rect edge = Rect(0, 0, width, height)
        SDL_RenderRect(r, ref edge)
    }
}

// The ring of the focus: 2 pixels in the blue of the selection, 1 pixel out of the
// component (D479).
void focusRing(addr renderer, f32 x, f32 y, f32 w, f32 h, f32 radius, f32 density, ref Colors c) {
    cromo_gui_box(renderer, x - 3, y - 3, w + 6, h + 6, radius + 3, 2, density, 0, solid(c.selection, true))
}

// A component, in the look of D479: flat, with borders of 1 pixel; the main buttons
// and the boxes checked in the accent; the groups and the dialogs as cards with a band
// at the top; a ring of 2 pixels around the component in focus.
void drawPart(ref WindowData window, ref PartData part, ref Colors c, ref list<ImageData> images) {
    addr r = window.renderer
    f32 d = window.density
    f32 x = part.left
    f32 y = part.top
    f32 w = f32(part.width)
    f32 h = f32(part.height)
    bool focused = window.focus == part.id && window.focused
    bool ring = focused && window.keyboard  // after a key, as :focus-visible of the browsers (P48)
    bool on = part.active
    f32 ascent = 0
    f32 descent = 0
    f32 gap = 0
    cromo_gui_font_metrics(window.body, ref ascent, ref descent, ref gap)
    f32 baseline = y + h / 2 + (ascent - descent) / 2
    if (part.kind == kindLabel) {
        text(window.body, part.text, x, baseline, c.ink2, on)
    } else if (part.kind == kindSwitch) {
        drawSwitch(ref window, ref part, ref c, ring, baseline)
    } else if (part.kind == kindSlider) {
        drawSlider(ref window, ref part, ref c, ring)
    } else if (part.kind == kindDialog) {
        f32 radius = dialogCorner()
        f32 band = bandHeight()
        f32 footer = dialogFooter()
        cardShadow(r, x, y, w, h, radius, d, ref c)
        bandCard(r, ref part, band, radius, d, ref c, c.rule2)
        clipInside(r, ref part, x, y + h - footer, w, footer)  // the band of the buttons
        cromo_gui_box(r, x, y, w, h, radius, 1, d, solid(c.surface2, true), solid(c.rule2, true))
        clipPart(r, ref part)
        fill(r, c.rule, x + 1, y + h - footer, w - 2, 1)
        clipInside(r, ref part, x + 12, y, w - 24, band)
        bandTitle(ref window, part.text, x + 12, y, band, c.ink3, true)
        clipPart(r, ref part)
    } else if (part.kind == kindButton) {
        bool hot = window.hot == part.id && on
        bool down = window.held == part.id && hot
        ButtonStyle style = part.action == 1 ? ButtonStyle.Primary : part.action == 2 ? ButtonStyle.Normal : part.style
        u32 back = down ? c.surface3 : c.surface
        u32 line = hot ? c.ink3 : c.rule2
        u32 fore = hot ? c.ink : c.ink2
        addr font = window.body
        if (style == ButtonStyle.Primary) {
            back = hot ? c.accent2 : c.accent
            line = back
            fore = c.onAccent
            font = window.strong
        } else if (style == ButtonStyle.Danger) {
            back = hot ? c.danger : c.surface
            line = hot ? c.danger : c.rule2
            fore = hot ? c.onAccent : c.danger
        }
        cromo_gui_box(r, x, y, w, h, corner, 1, d, solid(back, on), solid(line, on))
        f32 size = textWidth(font, part.text, part.text.len())
        if (part.icon != Icon.None) {
            f32 icon = buttonIcon()
            f32 space = part.text.len() > 0 ? 6 : 0
            f32 start = x + (w - icon - space - size) / 2
            drawIcon(r, part.icon, start + icon / 2, y + h / 2, icon, d, fore, on)
            text(font, part.text, start + icon + space, baseline, fore, on)
        } else {
            text(font, part.text, x + (w - size) / 2, baseline, fore, on)
        }
        if (ring) {
            focusRing(r, x, y, w, h, corner, d, ref c)
        }
    } else if (part.kind == kindTextBox) {
        drawField(ref window, ref part, ref c, focused)
        f32 inner = w - 2 * padding
        f32 caretX = textWidth(window.body, part.text, part.caret)
        f32 total = textWidth(window.body, part.text, part.text.len())
        if (caretX - part.scroll > inner) {
            part.scroll = caretX - inner
        }
        if (caretX < part.scroll) {
            part.scroll = caretX
        }
        if (part.scroll > 0 && total - part.scroll < inner) {
            part.scroll = total > inner ? total - inner : 0
        }
        f32 left = x + padding - part.scroll
        clipInside(r, ref part, x + 2, y + 2, w - 4, h - 4)
        if (part.caret != part.anchor) {
            i64 low = part.caret < part.anchor ? part.caret : part.anchor
            i64 high = part.caret < part.anchor ? part.anchor : part.caret
            f32 from = textWidth(window.body, part.text, low)
            f32 to = textWidth(window.body, part.text, high)
            fill(r, c.selectionSoft, left + from, baseline - ascent - 1, to - from, ascent + descent + 2)
        }
        if (part.text.len() == 0) {
            text(window.body, part.placeholder, x + padding, baseline, c.ink3, on)
        } else {
            text(window.body, part.text, left, baseline, c.ink, on)
        }
        bool blink = ((SDL_GetTicksNS() - window.caretStart) / 500000000) % 2 == 0
        if (focused && blink) {
            fill(r, c.ink, left + caretX, baseline - ascent, 1, ascent + descent)
        }
        clipPart(r, ref part)
    } else if (part.kind == kindCheckBox) {
        f32 top = y + (h - checkSide) / 2
        bool hot = window.hot == part.id && on
        if (part.checked) {
            u32 back = hot ? c.accent2 : c.accent
            cromo_gui_box(r, x, top, checkSide, checkSide, checkCorner, 1, d, solid(back, on), solid(back, on))
            cromo_gui_symbol(r, 4, x + checkSide / 2, top + checkSide / 2, d, red(c.onAccent), green(c.onAccent), blue(c.onAccent))
        } else {
            cromo_gui_box(r, x, top, checkSide, checkSide, checkCorner, 1, d, solid(c.surface, on), solid(hot ? c.ink3 : c.rule2, on))
        }
        if (ring) {
            focusRing(r, x, top, checkSide, checkSide, checkCorner, d, ref c)
        }
        text(window.body, part.text, x + checkSide + 8, baseline, c.ink, on)
    } else if (part.kind == kindGroup) {
        f32 band = part.text.len() > 0 ? bandHeight() : 0
        cardShadow(r, x, y, w, h, groupCorner, d, ref c)
        bandCard(r, ref part, band, groupCorner, d, ref c, c.rule)
        if (band > 0) {
            clipInside(r, ref part, x + 12, y, w - 24, band)
            bandTitle(ref window, part.text, x + 12, y, band, c.ink3, on)
            clipPart(r, ref part)
        }
    } else if (part.kind == kindComboBox) {
        drawField(ref window, ref part, ref c, focused || window.popup == part.id)
        clipInside(r, ref part, x + 2, y + 2, w - 28, h - 4)
        if (part.selected >= 0 && part.selected < part.items.len()) {
            text(window.body, part.items[part.selected], x + padding, baseline, c.ink, on)
        } else {
            text(window.body, part.placeholder, x + padding, baseline, c.ink3, on)
        }
        clipPart(r, ref part)
        cromo_gui_symbol(r, 5, x + w - 14, y + h / 2, d, red(c.ink3), green(c.ink3), blue(c.ink3))
    } else if (part.kind == kindImageBox) {
        drawImage(ref window, ref part)
    } else if (part.kind == kindIconBox) {
        drawIcon(r, part.icon, x + w / 2, y + h / 2, least(w, h), d, c.ink2, on)
    } else if (part.kind == kindListView) {
        drawListView(ref window, ref part, ref c)
    } else if (part.kind == kindAppBar) {
        drawAppBar(ref window, ref part, ref c)
    } else if (part.kind == kindNavigation) {
        drawNavigation(ref window, ref part, ref c)
    } else if (part.kind == kindCanvas) {
        drawCanvas(ref window, ref part, ref images)
    } else if (part.kind == kindTable) {
        drawTable(ref window, ref part, ref c)
    } else if (part.kind == kindTextView) {
        drawTextView(ref window, ref part, ref c, ref images)
    } else if (part.kind == kindTabView) {
        drawTabView(ref window, ref part, ref c, ring)
    } else if (part.kind == kindSegmented) {
        drawSegmented(ref window, ref part, ref c, ring)
    }
}

// A switch: its text on the left, and at the right edge a track in the accent when it
// is on, gray when it is off, with a white knob that slides in 150 ms.
void drawSwitch(ref WindowData window, ref PartData part, ref Colors c, bool focused, f32 baseline) {
    addr r = window.renderer
    f32 d = window.density
    bool on = part.active
    f32 x = part.left + f32(part.width) - switchWidth
    f32 y = part.top + (f32(part.height) - switchHeight) / 2
    f32 moved = f32(SDL_GetTicksNS() - part.flipped) / 150000000
    moved = moved > 1 ? 1 : moved
    f32 at = part.checked ? moved : 1 - moved
    if (part.flipped == 0) {
        at = part.checked ? 1 : 0
    }
    u32 track = part.checked ? c.accent : c.rule2
    cromo_gui_box(r, x, y, switchWidth, switchHeight, switchHeight / 2, 0, d, solid(track, on), 0)
    f32 side = switchHeight - 4
    f32 kx = x + 2 + (switchWidth - side - 4) * at
    f32 ky = y + 2
    if (on) {
        cromo_gui_shadow(r, kx, ky, side, side, side / 2, d, c.shadowNear, 2, 1)
    }
    cromo_gui_box(r, kx, ky, side, side, side / 2, 0, d, solid(0xFFFFFF, on), 0)
    if (focused) {
        focusRing(r, x, y, switchWidth, switchHeight, switchHeight / 2, d, ref c)
    }
    clipInside(r, ref part, part.left, part.top, most(f32(part.width) - switchWidth - 8, 0), f32(part.height))
    text(window.body, part.text, part.left, baseline, c.ink, on)
    clipPart(r, ref part)
}

// A slider: its track, in the accent up to the knob, and a knob in the accent with a
// ring of the surface around it.
void drawSlider(ref WindowData window, ref PartData part, ref Colors c, bool focused) {
    addr r = window.renderer
    f32 d = window.density
    bool on = part.active
    f32 middle = part.top + f32(part.height) / 2
    f32 from = part.left + knob / 2
    f32 to = part.left + f32(part.width) - knob / 2
    f32 at = knobAt(ref part)
    cromo_gui_box(r, from - 2, middle - 2, to - from + 4, 4, 2, 0, d, solid(c.rule2, on), 0)
    cromo_gui_box(r, from - 2, middle - 2, at - from + 4, 4, 2, 0, d, solid(c.accent, on), 0)
    bool held = window.held == part.id
    bool hot = window.hot == part.id && on
    f32 side = knob - 2
    if (on) {
        cromo_gui_shadow(r, at - side / 2, middle - side / 2, side, side, side / 2, d, c.shadowNear, 2, 1)
    }
    cromo_gui_box(r, at - side / 2, middle - side / 2, side, side, side / 2, 2, d, solid(held || hot ? c.accent2 : c.accent, on),
        solid(c.surface, on))
    if (focused) {
        focusRing(r, at - side / 2, middle - side / 2, side, side, side / 2, d, ref c)
    }
}

// The thin bar on the right of a panel or of a list that scrolls, while it moves and
// while the mouse is over it, wider and darker while it is dragged.
void drawScrollBar(ref WindowData window, ref PartData part, ref Colors c) {
    f32 h = f32(part.height)
    f32 thumb = most(24, h * h / part.content)
    f32 at = part.top + (h - thumb) * part.offsetY / (part.content - h)
    bool held = window.scrolling == part.id && window.scrollBar
    f32 w = held ? 6 : 4
    cromo_gui_box(window.renderer, part.left + f32(part.width) - w - 3, at + 2, w, thumb - 4, w / 2, 0, window.density,
        solid(held ? c.ink3 : c.rule2, true), 0)
}

// A list, on the surface: its rows that are seen, each with its icon, its title and
// the line under it, its text on the right, and a line under the row; the selected row
// in the soft blue of the selection, with a bar of the selection on its left (D479).
void drawListView(ref WindowData window, ref PartData view, ref Colors c) {
    addr r = window.renderer
    f32 d = window.density
    f32 x = view.left
    f32 w = f32(view.width)
    bool on = view.active
    f32 ascent = 0
    f32 descent = 0
    f32 gap = 0
    cromo_gui_font_metrics(window.body, ref ascent, ref descent, ref gap)
    f32 middle = (ascent - descent) / 2
    f32 bottom = view.top + f32(view.height)
    f32 row = rowHeight()
    f32 avatar = avatarSize()
    for (addr texture in view.dropped) {
        SDL_DestroyTexture(texture)
    }
    view.dropped.clear()
    clipInside(r, ref view, x, view.top, w, f32(view.height))
    fill(r, c.surface, x, view.top, w, f32(view.height))  // as a table in a card
    for (i64 k = i64(view.offsetY / row); k < view.items.len(); k++) {
        f32 top = view.top + f32(k) * row - view.offsetY
        if (top >= bottom) {
            break
        }
        if (k == view.selected) {
            fill(r, c.selectionSoft, x, top, w, row)
            fill(r, c.selection, x, top, 3, row)
        } else if (window.hot == view.id && window.hotItem == k && on) {
            fill(r, c.surface2, x, top, w, row)
        }
        f32 left = x + 16
        addr none
        if (view.images[k] != none) {  // D469
            if (view.textures[k] == none) {
                view.textures[k] = SDL_CreateTexture(r, 0x16762004, 0, avatarPixels, avatarPixels)  // RGBA32, static
                if (view.textures[k] != none) {
                    SDL_SetTextureBlendMode(view.textures[k], 1)
                    SDL_UpdateTexture(view.textures[k], none, view.images[k], avatarPixels * 4)
                }
            }
            if (view.textures[k] != none) {
                Rect place = Rect(x + 16, top + (row - avatar) / 2, avatar, avatar)
                SDL_RenderTexture(r, view.textures[k], none, ref place)
            }
            left = x + 32 + avatar
        } else if (view.icons[k] != Icon.None) {
            f32 icon = comfortable() ? 24 : 20
            drawIcon(r, view.icons[k], x + 16 + icon / 2, top + row / 2, icon, d, c.ink2, on)
            left = x + 32 + icon
        }
        f32 right = x + w - 16
        bool two = view.subtitles[k].len() > 0
        f32 titleLine = two ? top + row * 0.36 + middle : top + row / 2 + middle
        if (view.details[k].len() > 0) {
            f32 size = textWidth(window.body, view.details[k], view.details[k].len())
            text(window.body, view.details[k], right - size, titleLine, c.ink3, on)
            right = right - size - 12
        }
        f32 seen = most(top, view.top)
        clipInside(r, ref view, left, seen, right - left, least(top + row, bottom) - seen)
        text(window.body, view.items[k], left, titleLine, c.ink, on)
        if (two) {
            text(window.body, view.subtitles[k], left, top + row * 0.71 + middle, c.ink3, on)
        }
        clipInside(r, ref view, x, view.top, w, f32(view.height))
        if (k + 1 < view.items.len()) {
            fill(r, c.rule, left, top + row - 1, x + w - left, 1)
        }
    }
}

// The round background of an icon of a bar under the mouse, or pressed.
void drawHover(ref WindowData window, ref PartData bar, ref Colors c, i64 item, f32 x, f32 y, f32 w, f32 h, f32 radius) {
    if (window.hot == bar.id && window.hotItem == item && bar.active) {
        u32 back = window.held == bar.id && window.heldItem == item ? c.surface3 : c.surface2
        cromo_gui_box(window.renderer, x, y, w, h, radius, 0, window.density, solid(back, true), 0)
    }
}

// An app bar: its background, a line under it, the icon on the left, the title
// semibold, and the actions from the right edge.
void drawAppBar(ref WindowData window, ref PartData bar, ref Colors c) {
    addr r = window.renderer
    f32 d = window.density
    f32 x = bar.left
    f32 y = bar.top
    f32 w = f32(bar.width)
    f32 h = f32(bar.height)
    bool on = bar.active
    fill(r, c.surface, x, y, w, h)
    fill(r, c.rule, x, y + h - 1, w, 1)
    f32 middle = y + h / 2
    f32 icon = barIcon()
    f32 round = least(40, h - 8)
    f32 left = x + 16
    if (bar.icon != Icon.None) {
        drawHover(ref window, ref bar, ref c, 0, x + 28 - round / 2, middle - round / 2, round, round, round / 2)
        drawIcon(r, bar.icon, x + 28, middle, icon, d, c.ink2, on)
        left = x + 60
    }
    f32 ascent = 0
    f32 descent = 0
    f32 gap = 0
    cromo_gui_font_metrics(window.heading, ref ascent, ref descent, ref gap)
    f32 right = x + w - 8 - 44 * f32(bar.icons.len())
    clipInside(r, ref bar, left, y, right - left, h)
    text(window.heading, bar.text, left, middle + (ascent - descent) / 2, c.ink, on)
    clipPart(r, ref bar)
    for (i64 k = 0; k < bar.icons.len(); k++) {
        f32 center = x + w - 28 - 44 * f32(k)
        drawHover(ref window, ref bar, ref c, k + 1, center - round / 2, middle - round / 2, round, round, round / 2)
        drawIcon(r, bar.icons[k], center, middle, icon, d, c.ink2, on)
    }
}

// A navigation bar: its background, a line over it, and its items, the one chosen
// in the accent, with a pill of the soft accent behind its icon.
void drawNavigation(ref WindowData window, ref PartData bar, ref Colors c) {
    addr r = window.renderer
    f32 d = window.density
    f32 x = bar.left
    f32 y = bar.top
    f32 w = f32(bar.width)
    f32 h = f32(bar.height)
    bool on = bar.active
    fill(r, c.surface, x, y, w, h)
    fill(r, c.rule, x, y, w, 1)
    f32 pill = y + (h - 48) / 2  // the top of the pill: 8 pixels in a bar of 64
    i64 n = bar.items.len()
    for (i64 k = 0; k < n; k++) {
        f32 center = x + w * (f32(k) + 0.5) / f32(n)
        bool chosen = k == bar.selected
        if (chosen) {
            cromo_gui_box(r, center - 28, pill, 56, 28, 14, 0, d, solid(c.accentSoft, on), 0)
        } else {
            drawHover(ref window, ref bar, ref c, k, center - 28, pill, 56, 28, 14)
        }
        u32 color = chosen ? c.accent2 : c.ink3
        drawIcon(r, bar.icons[k], center, pill + 14, 22, d, color, on)
        f32 size = textWidth(window.caption, bar.items[k], bar.items[k].len())
        text(window.caption, bar.items[k], center - size / 2, pill + 45, color, on)
    }
}

// An icon of Lucide whose square of `size` logical pixels has its center at x, y.
void drawIcon(addr renderer, Icon which, f32 x, f32 y, f32 size, f32 density, u32 rgb, bool enabled) {
    if (which != Icon.None && size > 0) {
        cromo_gui_icon(renderer, i32(which), x, y, size, density, red(rgb), green(rgb), blue(rgb), enabled ? 255 : 128)
    }
}

// The box of a text box or of a combo box: the surface with a border of 1 pixel, and
// the ring of the focus around it while it has the keyboard.
void drawField(ref WindowData window, ref PartData part, ref Colors c, bool lit) {
    addr r = window.renderer
    f32 d = window.density
    f32 x = part.left
    f32 y = part.top
    f32 w = f32(part.width)
    f32 h = f32(part.height)
    bool on = part.active
    bool hot = window.hot == part.id && on
    cromo_gui_box(r, x, y, w, h, corner, 1, d, solid(c.surface, on), solid(hot && !lit ? c.ink3 : c.rule2, on))
    if (lit) {
        focusRing(r, x, y, w, h, corner, d, ref c)
    }
}

// The list of an open combo box, over the other components, as a menu: the item
// pointed at in the soft accent, the one chosen semibold with a mark, and a bar on
// the right when it scrolls.
void drawList(ref WindowData window, ref PartData box, ref Colors c) {
    addr r = window.renderer
    f32 d = window.density
    Rect area = listOf(ref window, ref box)
    f32 x = area.x
    f32 y = area.y
    cardShadow(r, x, y, area.w, area.h, menuCorner, d, ref c)
    cromo_gui_box(r, x, y, area.w, area.h, menuCorner, 1, d, solid(c.surface, true), solid(c.rule2, true))
    f32 ascent = 0
    f32 descent = 0
    f32 gap = 0
    cromo_gui_font_metrics(window.body, ref ascent, ref descent, ref gap)
    i64 rows = rowsOf(ref window, ref box)
    bool scrolls = box.items.len() > rows
    f32 item = itemHeight()
    for (i64 row = 0; row < rows; row++) {
        i64 at = box.first + row
        f32 top = y + 3 + f32(row) * item
        clipTo(r, x + 1, y + 1, area.w - 2, area.h - 2)
        bool lit = at == box.highlight
        if (lit) {
            cromo_gui_box(r, x + 3, top, area.w - (scrolls ? 14 : 6), item, 5, 0, d, solid(c.accentSoft, true), 0)
        }
        bool chosen = at == box.selected
        clipTo(r, x + 1, y + 1, area.w - 30, area.h - 2)
        text(chosen ? window.strong : window.body, box.items[at], x + padding + 4, top + item / 2 + (ascent - descent) / 2,
            lit ? c.accent2 : c.ink, true)
        if (chosen) {
            clipTo(r, x + 1, y + 1, area.w - 2, area.h - 2)
            cromo_gui_symbol(r, 4, x + area.w - (scrolls ? 26 : 18), top + item / 2, d, red(c.accent), green(c.accent),
                blue(c.accent))
        }
    }
    if (scrolls) {
        f32 track = area.h - 6
        f32 thumb = track * f32(rows) / f32(box.items.len())
        f32 at = y + 3 + (track - thumb) * f32(box.first) / f32(box.items.len() - rows)
        clipTo(r, x + 1, y + 1, area.w - 2, area.h - 2)
        cromo_gui_box(r, x + area.w - 7, at, 4, thumb, 2, 0, d, solid(c.rule2, true), 0)
    }
}

// An image: its texture is made from its pixels the first time it is drawn after
// it is set; the pixels stay, for when the renderer loses its textures. An SVG image
// is drawn again by nanosvg when the size at which it is shown changes (D484).
void drawImage(ref WindowData window, ref PartData part) {
    addr r = window.renderer
    addr none
    if (part.imageChanged) {
        if (part.texture != none) {
            SDL_DestroyTexture(part.texture)
            part.texture = none
        }
        if (part.pixels != none) {
            part.texture = SDL_CreateTexture(r, 0x16762004, 0, part.imageWidth, part.imageHeight)  // RGBA32, static
            if (part.texture != none) {
                SDL_SetTextureBlendMode(part.texture, 1)
                SDL_UpdateTexture(part.texture, none, part.pixels, part.imageWidth * 4)
            }
        }
        part.textureWidth = 0
        part.imageChanged = false
    }
    if (part.imageWidth <= 0 || part.imageHeight <= 0) {
        ret
    }
    f32 x = part.left
    f32 y = part.top
    f32 w = f32(part.width)
    f32 h = f32(part.height)
    f32 iw = f32(part.imageWidth)
    f32 ih = f32(part.imageHeight)
    f32 dw = w
    f32 dh = h
    if (part.scale == Scale.Fit) {
        f32 k = least(w / iw, h / ih)
        dw = iw * k
        dh = ih * k
    } else if (part.scale == Scale.Fill) {
        f32 k = most(w / iw, h / ih)
        dw = iw * k
        dh = ih * k
    } else if (part.scale == Scale.Center) {
        dw = iw
        dh = ih
    }
    if (part.svg != none) {
        i32 pw = i32(dw * window.density + 0.5)
        i32 ph = i32(dh * window.density + 0.5)
        if (part.texture == none || part.textureWidth != pw || part.textureHeight != ph) {
            if (part.texture != none) {
                SDL_DestroyTexture(part.texture)
            }
            part.texture = textureOf(r, cromo_gui_svg_draw(part.svg, part.svgSize, pw, ph), pw, ph)
            part.textureWidth = pw
            part.textureHeight = ph
        }
    }
    if (part.texture == none) {
        ret
    }
    Rect target = Rect(x + (w - dw) / 2, y + (h - dh) / 2, dw, dh)
    clipInside(r, ref part, x, y, w, h)
    SDL_SetTextureAlphaMod(part.texture, part.active ? 255 : 128)
    SDL_RenderTexture(r, part.texture, none, ref target)
    clipPart(r, ref part)
}

// ---- The table (D486-D489) ----

// A column of a table: its title, its width, 0 for the room left, and how its title
// and its cells are placed.
struct TableColumn {
    string title
    i32 width
    Horizontal align
    bool visible = true
}

f32 tableRow() {  // the height of a row of a table
    ret comfortable() ? 44 : 26
}

f32 tableHeader() {  // the height of the titles of a table
    ret comfortable() ? 40 : 30
}

const i64 tablePage = 100   // the rows that a table asks for at once
const i64 tableKept = 3000  // the rows that it keeps at most, near those shown

// The rows chosen are ranges, the first and the end of each one after the other, in
// order and apart: so Shift can choose millions of rows.
bool isChosen(ref PartData table, i64 row) {
    for (i64 k = 0; k + 1 < table.ranges.len(); k += 2) {
        if (row >= table.ranges[k] && row < table.ranges[k + 1]) {
            ret true
        }
    }
    ret false
}

void selectOnly(ref PartData table, i64 row) {
    table.ranges.clear()
    if (row >= 0) {
        table.ranges.add(row)
        table.ranges.add(row + 1)
    }
    table.selected = row
    table.anchorRow = row
}

// The rows from `low` to `high`, both included, added to those chosen.
void chooseRange(ref PartData table, i64 low, i64 high) {
    list<i64> merged
    i64 from = low
    i64 to = high + 1
    bool placed = false
    for (i64 k = 0; k + 1 < table.ranges.len(); k += 2) {
        i64 a = table.ranges[k]
        i64 b = table.ranges[k + 1]
        if (b < from) {
            merged.add(a)
            merged.add(b)
        } else if (a > to) {
            if (!placed) {
                merged.add(from)
                merged.add(to)
                placed = true
            }
            merged.add(a)
            merged.add(b)
        } else {  // they touch: one range
            from = a < from ? a : from
            to = b > to ? b : to
        }
    }
    if (!placed) {
        merged.add(from)
        merged.add(to)
    }
    table.ranges = merged
}

// A row removed from those chosen, or added when it was not.
void toggleRow(ref PartData table, i64 row) {
    if (!isChosen(ref table, row)) {
        chooseRange(ref table, row, row)
        ret
    }
    list<i64> split
    for (i64 k = 0; k + 1 < table.ranges.len(); k += 2) {
        i64 a = table.ranges[k]
        i64 b = table.ranges[k + 1]
        if (row >= a && row < b) {
            if (row > a) {
                split.add(a)
                split.add(row)
            }
            if (row + 1 < b) {
                split.add(row + 1)
                split.add(b)
            }
        } else {
            split.add(a)
            split.add(b)
        }
    }
    table.ranges = split
}

// The rows chosen beyond the number of the rows are no more.
void trimSelection(ref PartData table) {
    list<i64> kept
    for (i64 k = 0; k + 1 < table.ranges.len(); k += 2) {
        i64 b = table.ranges[k + 1] < table.tableRows ? table.ranges[k + 1] : table.tableRows
        if (table.ranges[k] < b) {
            kept.add(table.ranges[k])
            kept.add(b)
        }
    }
    table.ranges = kept
    if (table.selected >= table.tableRows) {
        table.selected = table.tableRows - 1
    }
}

// The rows and the blocks asked for beyond the number of the rows are forgotten.
void forgetBeyond(ref PartData table) {
    list<i64> rows
    for (i64 row, ref list<string> cells in table.cells) {
        if (row >= table.tableRows) {
            rows.add(row)
        }
    }
    for (i64 row in rows) {
        table.cells.remove(row)
    }
    list<i64> pages
    for (i64 page, ref bool asked in table.asked) {
        if (page * tablePage >= table.tableRows) {
            pages.add(page)
        }
    }
    for (i64 page in pages) {
        table.asked.remove(page)
    }
}

void showTableRow(ref PartData table, i64 row) {
    f32 seen = f32(table.height) - tableHeader()
    f32 top = f32(row) * tableRow()
    table.velocity = 0
    if (top < table.offsetY) {
        scrollBy(ref table, top - table.offsetY)
    } else if (top + tableRow() > table.offsetY + seen) {
        scrollBy(ref table, top + tableRow() - seen - table.offsetY)
    }
}

// The left edges and the widths of the columns shown, from the left of the table: the
// columns of width 0 share the room left, at least 40 pixels each.
void columnPlaces(ref PartData table, ref list<f32> lefts, ref list<f32> widths) {
    f32 fixed = 0
    i64 free = 0
    for (ref TableColumn c in table.columns) {
        if (c.visible) {
            fixed = fixed + f32(c.width)
            free = c.width == 0 ? free + 1 : free
        }
    }
    f32 share = free > 0 ? most((f32(table.width) - fixed) / f32(free), 40) : 0
    f32 at = 0
    for (ref TableColumn c in table.columns) {
        f32 w = c.visible ? (c.width == 0 ? share : f32(c.width)) : 0
        lefts.add(at)
        widths.add(w)
        at = at + w
    }
}

// What a point of a table is: -2 less the column for a title, the row for a row, or
// -1 for nothing.
i64 tableItemAt(ref PartData table, f32 x, f32 y) {
    if (y < table.top + tableHeader()) {
        list<f32> lefts
        list<f32> widths
        columnPlaces(ref table, ref lefts, ref widths)
        for (i64 k = 0; k < table.columns.len(); k++) {
            if (widths[k] > 0 && x >= table.left + lefts[k] && x < table.left + lefts[k] + widths[k]) {
                ret -2 - k
            }
        }
        ret -1
    }
    i64 row = i64((y - table.top - tableHeader() + table.offsetY) / tableRow())
    ret row >= 0 && row < table.tableRows ? row : -1
}

// A click released on what it was pressed on: a title sorts, a row is chosen as the
// keys of Ctrl and Shift say, and a double click opens it (D487, D488).
void tableClick(ref WindowData window, ref PartData table, i64 item, ref list<Call> calls) {
    if (item <= -2) {
        i64 column = -2 - item
        table.sortDescending = table.sortColumn == column ? !table.sortDescending : false
        table.sortColumn = column
        Call call = callOf(11, table.sorts)
        call.index = column
        call.value = table.sortDescending
        calls.add(move call)
        ret
    }
    u32 keys = u32(SDL_GetModState())
    bool control = (keys & 0xC0) != 0
    bool shift = (keys & 0x3) != 0
    if (shift && table.anchorRow >= 0) {
        if (!control) {
            table.ranges.clear()
        }
        chooseRange(ref table, table.anchorRow < item ? table.anchorRow : item, table.anchorRow < item ? item : table.anchorRow)
        table.selected = item
    } else if (control) {
        toggleRow(ref table, item)
        table.selected = item
        table.anchorRow = item
    } else {
        selectOnly(ref table, item)
    }
    Call call = callOf(9, table.change)
    call.index = item
    calls.add(move call)
    if (window.clicks >= 2 && !shift && !control) {
        Call open = callOf(9, table.chooses)
        open.index = item
        calls.add(move open)
    }
}

// The keys of a table that has the keyboard: the arrows, Page Up and Down, Home and
// End move the row chosen, with Shift those between; Enter opens it; Ctrl+A chooses
// all the rows.
bool tableKey(ref PartData table, Key key, ref list<Call> calls) {
    i64 n = table.tableRows
    if (n == 0) {
        ret false
    }
    if (key.code == 13 || key.code == keyEnter) {
        if (table.selected >= 0) {
            Call open = callOf(9, table.chooses)
            open.index = table.selected
            calls.add(move open)
        }
        ret true
    }
    if (key.control && key.code == 97) {  // Ctrl+A
        table.ranges = [0, n]
        ret true
    }
    i64 page = most64(i64((f32(table.height) - tableHeader()) / tableRow()) - 1, 1)
    i64 at = table.selected
    i64 next = at
    if (key.code == keyUp) {
        next = at > 0 ? at - 1 : 0
    } else if (key.code == keyDown) {
        next = at < n - 1 ? at + 1 : n - 1
    } else if (key.code == keyHome) {
        next = 0
    } else if (key.code == keyEnd) {
        next = n - 1
    } else if (key.code == keyPageUp) {
        next = at - page > 0 ? at - page : 0
    } else if (key.code == keyPageDown) {
        next = at + page < n - 1 ? at + page : n - 1
    } else {
        ret false
    }
    if (key.shift && table.anchorRow >= 0) {
        table.ranges.clear()
        chooseRange(ref table, table.anchorRow < next ? table.anchorRow : next, table.anchorRow < next ? next : table.anchorRow)
        table.selected = next
    } else {
        selectOnly(ref table, next)
    }
    showTableRow(ref table, next)
    Call call = callOf(9, table.change)
    call.index = next
    calls.add(move call)
    ret true
}

// A line of text in a cell or a title, placed as its column says, inside the width.
void cellText(addr renderer, addr font, string value, f32 x, f32 w, f32 baseline, u32 rgb, bool enabled, Horizontal align) {
    f32 size = textWidth(font, value, value.len())
    f32 left = x + 8
    if (align == Horizontal.Right) {
        left = x + w - 8 - size
    } else if (align == Horizontal.Center) {
        left = x + (w - size) / 2
    }
    text(font, value, most(left, x + 8), baseline, rgb, enabled)
}

// A table: its titles, in capitals as those of the bands, with the arrow of the order;
// its rows that are seen, the chosen ones in the soft blue of the selection and the
// last one chosen with a bar on its left; the rows not given are empty, and asked for.
void drawTable(ref WindowData window, ref PartData table, ref Colors c) {
    addr r = window.renderer
    f32 d = window.density
    f32 x = table.left
    f32 y = table.top
    f32 w = f32(table.width)
    f32 h = f32(table.height)
    bool on = table.active
    f32 header = tableHeader()
    f32 row = tableRow()
    list<f32> lefts
    list<f32> widths
    columnPlaces(ref table, ref lefts, ref widths)
    f32 ascent = 0
    f32 descent = 0
    f32 gap = 0
    cromo_gui_font_metrics(window.body, ref ascent, ref descent, ref gap)
    f32 middle = (ascent - descent) / 2
    clipInside(r, ref table, x, y, w, h)
    fill(r, c.surface, x, y, w, h)

    // The rows that are seen, under the titles.
    i64 first = i64(table.offsetY / row)
    i64 last = first
    clipInside(r, ref table, x, y + header, w, h - header)
    for (i64 k = first; k < table.tableRows; k++) {
        f32 top = y + header + f32(k) * row - table.offsetY
        if (top >= y + h) {
            break
        }
        last = k
        if (isChosen(ref table, k)) {
            fill(r, c.selectionSoft, x, top, w, row)
        } else if (window.hot == table.id && window.hotItem == k && on) {
            fill(r, c.surface2, x, top, w, row)
        }
        if (k == table.selected && (isChosen(ref table, k) || window.focus == table.id)) {
            fill(r, c.selection, x, top, 3, row)
        }
        if (table.cells.contains(k)) {
            list<string> cells = table.cells[k]
            for (i64 col = 0; col < table.columns.len() && col < cells.len(); col++) {
                if (widths[col] > 0) {
                    clipInside(r, ref table, x + lefts[col], most(top, y + header), widths[col], least(row, y + h - top))
                    cellText(r, window.body, cells[col], x + lefts[col], widths[col], top + row / 2 + middle, c.ink, on,
                        table.columns[col].align)
                }
            }
            clipInside(r, ref table, x, y + header, w, h - header)
        }
        fill(r, c.rule, x, top + row - 1, w, 1)
    }

    // The titles, over the rows.
    clipInside(r, ref table, x, y, w, header)
    fill(r, c.surface, x, y, w, header)
    fill(r, c.rule2, x, y + header - 1, w, 1)
    for (i64 col = 0; col < table.columns.len(); col++) {
        if (widths[col] <= 0) {
            continue
        }
        f32 cx = x + lefts[col]
        bool hot = window.hot == table.id && window.hotItem == -2 - col && on
        f32 size = bandTitleWidth(ref window, table.columns[col].title)
        bool sorted = table.sortColumn == col
        f32 arrow = sorted ? 16 : 0
        f32 left = cx + 8
        Horizontal align = table.columns[col].align
        if (align == Horizontal.Right) {
            left = cx + widths[col] - 8 - size - arrow
        } else if (align == Horizontal.Center) {
            left = cx + (widths[col] - size - arrow) / 2
        }
        clipInside(r, ref table, cx, y, widths[col], header)
        bandTitle(ref window, table.columns[col].title, most(left, cx + 8), y, header, hot ? c.ink2 : c.ink3, on)
        if (sorted) {
            drawIcon(r, table.sortDescending ? Icon.ChevronDown : Icon.ChevronUp, most(left, cx + 8) + size + 10, y + header / 2,
                12, d, c.ink2, on)
        }
    }
    clipPart(r, ref table)

    // The rows seen and those near them that are not given are asked for, in blocks;
    // the rows far from them are forgotten when they are too many.
    i64 from = most64(first - tablePage, 0)
    i64 to = last + tablePage
    for (i64 page = from / tablePage; page * tablePage < table.tableRows && page * tablePage <= to; page++) {
        if (!table.asked.contains(page)) {
            i64 start = page * tablePage
            bool missing = false
            for (i64 k = start; k < start + tablePage && k < table.tableRows && !missing; k++) {
                missing = !table.cells.contains(k)
            }
            table.asked[page] = true
            if (missing && table.needs.len() > 0) {
                Call call = callOf(10, table.needs)
                call.index = start
                call.second = least64(tablePage, table.tableRows - start)
                window.requests.add(move call)
            }
        }
    }
    if (table.cells.len() > tableKept) {
        list<i64> far
        for (i64 k, ref list<string> cells in table.cells) {
            if (k < first - tableKept / 3 || k > last + tableKept / 3) {
                far.add(k)
            }
        }
        for (i64 k in far) {
            table.cells.remove(k)
            table.asked.remove(k / tablePage)
        }
    }
}

// ---- The menus and the tooltips (D496, D497) ----

// An entry of a menu: an item with its text, its icon and the index of its handler, or
// a separator.
struct MenuItem {
    string text
    Icon icon
    bool enabled = true
    bool separator
    i64 action = -1
}

f32 menuRow() {  // an item of a menu
    ret comfortable() ? 44 : 30
}

f32 tipSize() {  // the text of a tooltip
    ret comfortable() ? 13 : 12
}

const f32 menuPad = 4            // the items from the edges of the card
const f32 menuLine = 9           // the height of a separator
const f32 menuWidth = 190        // at least
const u64 tipDelay = 600000000   // the mouse stays on a component 0.6 s before its tooltip shows
const u64 longPress = 500000000  // a finger held 0.5 s is a long press

void setPartTooltip(i64 id, string text) {
    withData([id, text](ref Shared data) { data.parts[partIndexOf(ref data, id)].tooltip = text })
}

string partTooltip(i64 id) {
    string text
    withData([id, ref text](ref Shared data) { text = data.parts[partIndexOf(ref data, id)].tooltip })
    ret text
}

// Opens a menu, at the mouse or under a component, at the next frame.
void openMenu(i64 window, move Menu menu, i64 anchor) {
    addr box = alloc(sizeOf<Menu>())
    put<Menu>(box, move menu)
    withData([window, box, anchor](ref Shared data) {
        i64 i = indexOf(ref data, window)
        data.windows[i].menu = take<Menu>(box)
        data.windows[i].menuOpen = data.windows[i].menu.items.len() > 0
        data.windows[i].menuPlaced = false
        data.windows[i].menuAnchor = anchor
        data.windows[i].menuHot = -1
        data.windows[i].menuHeld = -1
        data.windows[i].popup = 0
    })
    free(box)
}

// Closes the menu, and frees its handlers: none of them is running.
void closeMenu(ref WindowData window) {
    window.menuOpen = false
    window.menuHot = -1
    window.menuHeld = -1
    window.menu.clear()
}

// The size of the menu, from its texts, and its place: at the mouse, on its left or above
// it when there is no room, or under its component, or above it; inside the content.
void placeMenu(ref WindowData window, ref list<PartData> parts) {
    f32 w = menuWidth
    f32 h = 2 * menuPad
    for (ref MenuItem item in window.menu.items) {
        if (item.separator) {
            h = h + menuLine
        } else {
            f32 icon = item.icon != Icon.None ? 24 : 0
            w = most(w, textWidth(window.body, item.text, item.text.len()) + icon + 2 * menuPad + 36)
            h = h + menuRow()
        }
    }
    f32 left = window.originX + 4
    f32 top = window.originY + 4
    f32 right = window.originX + f32(contentWidth(window)) - 4
    f32 bottom = window.originY + f32(contentHeight(window)) - 4
    f32 x = window.pointerX >= 0 ? window.pointerX + 2 : (left + right - w) / 2
    f32 y = window.pointerY >= 0 ? window.pointerY + 2 : (top + bottom - h) / 2
    i64 a = partNumber(ref parts, window.menuAnchor)
    if (a >= 0) {
        x = parts[a].left
        y = parts[a].top + f32(parts[a].height) + 4
        if (y + h > bottom) {
            y = parts[a].top - h - 4
        }
        if (x + w > right) {
            x = right - w
        }
    } else {
        if (x + w > right) {
            x = window.pointerX >= 0 ? window.pointerX - w - 2 : right - w
        }
        if (y + h > bottom) {
            y = window.pointerY >= 0 ? window.pointerY - h - 2 : bottom - h
        }
    }
    window.menuX = most(x, left)
    window.menuY = most(y, top)
    window.menuW = w
    window.menuH = h
    window.menuPlaced = true
}

bool inMenu(ref WindowData window, f32 x, f32 y) {
    ret window.menuPlaced && x >= window.menuX && x < window.menuX + window.menuW && y >= window.menuY &&
        y < window.menuY + window.menuH
}

// The entry of the menu at a point of the window, or -1.
i64 menuItemAt(ref WindowData window, f32 x, f32 y) {
    if (!inMenu(ref window, x, y)) {
        ret -1
    }
    f32 at = window.menuY + menuPad
    for (i64 k = 0; k < window.menu.items.len(); k++) {
        f32 tall = window.menu.items[k].separator ? menuLine : menuRow()
        if (y >= at && y < at + tall) {
            ret k
        }
        at = at + tall
    }
    ret -1
}

bool choosable(ref WindowData window, i64 k) {
    ret k >= 0 && k < window.menu.items.len() && !window.menu.items[k].separator && window.menu.items[k].enabled
}

// An item chosen: the menu goes away, and its handler is called, in a box that the
// thread of the GUI frees at the next frame.
void chooseMenuItem(ref WindowData window, i64 k, ref list<Call> calls) {
    i64 action = window.menu.items[k].action
    if (action >= 0 && action < window.menu.actions.len()) {
        addr box = alloc(sizeOf<func()>())
        put<func()>(box, window.menu.actions.remove(action))
        list<addr> boxes
        boxes.add(box)
        calls.add(callOf(6, boxes))
        window.dropped.add(box)
    }
    closeMenu(ref window)
}

// The events of a window while its menu is open: the mouse and the keys go to the menu,
// and a press out of it closes it and does nothing else. True when the event is taken.
bool menuEvent(ref WindowData window, addr event, u32 kind, ref list<Call> calls) {
    if (kind == 0x20F) {  // FOCUS_LOST
        closeMenu(ref window)
        ret false
    }
    if (kind == 0x206) {  // RESIZED: placed again in the new content
        window.menuPlaced = false
        ret false
    }
    if (kind == 0x400) {
        window.pointerX = take<f32>(offset(event, 28))
        window.pointerY = take<f32>(offset(event, 32))
        i64 k = menuItemAt(ref window, window.pointerX, window.pointerY)
        window.menuHot = choosable(ref window, k) ? k : -1
        window.hot = 0
        window.hotItem = -1
        ret true
    }
    if (kind == 0x401 || kind == 0x402) {
        f32 x = take<f32>(offset(event, 28))
        f32 y = take<f32>(offset(event, 32))
        i64 k = menuItemAt(ref window, x, y)
        if (kind == 0x401) {
            if (!inMenu(ref window, x, y)) {
                closeMenu(ref window)
            } else {
                window.menuHeld = k
            }
        } else if (k >= 0 && k == window.menuHeld && choosable(ref window, k)) {
            chooseMenuItem(ref window, k, ref calls)
        } else {
            window.menuHeld = -1
        }
        ret true
    }
    if (kind == 0x403) {
        ret true
    }
    if (kind == 0x300) {
        i64 code = i64(take<u32>(offset(event, 28)))
        menuKey(ref window, code, ref calls)
        ret true
    }
    ret false
}

// Up, Down, Home and End move among the items that can be chosen; Enter and Space choose,
// Esc closes.
void menuKey(ref WindowData window, i64 code, ref list<Call> calls) {
    i64 n = window.menu.items.len()
    if (code == 27 || (window.phone && code == keyBack)) {
        closeMenu(ref window)
        ret
    }
    if ((code == 13 || code == 32 || code == keyEnter) && choosable(ref window, window.menuHot)) {
        chooseMenuItem(ref window, window.menuHot, ref calls)
        ret
    }
    i64 step = code == keyDown || code == keyHome ? 1 : code == keyUp || code == keyEnd ? -1 : 0
    if (step == 0) {
        ret
    }
    i64 at = code == keyHome ? -1 : code == keyEnd ? n : window.menuHot
    if (at < 0 && step < 0) {
        at = n
    }
    for (i64 k = 0; k < n; k++) {
        at = at + step
        if (at < 0 || at >= n) {
            at = step > 0 ? 0 : n - 1
        }
        if (choosable(ref window, at)) {
            window.menuHot = at
            ret
        }
    }
}

// The menu: a card on the surface, with the border of the controls and the shadow of the
// cards; the item under the mouse in accent 2 on the soft accent, the disabled ones in
// ink 3, a line of rule for a separator (D496).
void drawMenu(ref WindowData window, ref list<PartData> parts, ref Colors c) {
    addr r = window.renderer
    f32 d = window.density
    if (!window.menuPlaced) {
        placeMenu(ref window, ref parts)
    }
    f32 x = window.menuX
    f32 y = window.menuY
    f32 w = window.menuW
    cardShadow(r, x, y, w, window.menuH, menuCorner, d, ref c)
    cromo_gui_box(r, x, y, w, window.menuH, menuCorner, 1, d, solid(c.surface, true), solid(c.rule2, true))
    f32 ascent = 0
    f32 descent = 0
    f32 gap = 0
    cromo_gui_font_metrics(window.body, ref ascent, ref descent, ref gap)
    f32 at = y + menuPad
    for (i64 k = 0; k < window.menu.items.len(); k++) {
        if (window.menu.items[k].separator) {
            fill(r, c.rule, x + 1, at + menuLine / 2, w - 2, 1)
            at = at + menuLine
            continue
        }
        bool enabled = window.menu.items[k].enabled
        bool hot = k == window.menuHot && enabled
        if (hot) {
            cromo_gui_box(r, x + menuPad, at, w - 2 * menuPad, menuRow(), 5, 0, d, solid(c.accentSoft, true), 0)
        }
        u32 ink = !enabled ? c.ink3 : hot ? c.accent2 : c.ink
        f32 left = x + menuPad + 12
        if (window.menu.items[k].icon != Icon.None) {
            drawIcon(r, window.menu.items[k].icon, left + 8, at + menuRow() / 2, 16, d, hot ? c.accent2 : enabled ? c.ink2 : c.ink3, true)
            left = left + 24
        }
        clipTo(r, left, at, x + w - menuPad - 12 - left, menuRow())
        text(window.body, window.menu.items[k].text, left, at + menuRow() / 2 + (ascent - descent) / 2, ink, true)
        clipTo(r, window.originX, window.originY, f32(contentWidth(window)), f32(contentHeight(window)))
        at = at + menuRow()
    }
}

// The component whose tooltip shows now, or -1: on the desktop the one under the mouse
// since 0.6 s, without a press since it came there; on a phone the one of a long press.
i64 tipPart(ref WindowData window, ref list<PartData> parts) {
    if (window.menuOpen || window.popup != 0) {
        ret -1
    }
    if (window.phone) {
        i64 p = partNumber(ref parts, window.tipPart)
        ret p >= 0 && parts[p].shown && parts[p].tooltip.len() > 0 ? p : -1
    }
    if (window.hot == 0 || window.tipBlocked || window.held != 0 || window.canvasHeld != 0 || window.scrolling != 0 ||
        SDL_GetTicksNS() - window.hotSince < tipDelay) {
        ret -1
    }
    i64 p = partNumber(ref parts, window.hot)
    ret p >= 0 && parts[p].shown && parts[p].tooltip.len() > 0 ? p : -1
}

// A tooltip: a small card on the surface, with the border of the controls and a light
// shadow, its lines in ink 2 (D497); under the mouse, or above the finger on a phone.
void drawTooltip(ref WindowData window, ref Colors c, string value) {
    addr r = window.renderer
    f32 d = window.density
    addr font = faceFor(ref window, 0, tipSize())
    f32 ascent = 0
    f32 descent = 0
    f32 gap = 0
    cromo_gui_font_metrics(font, ref ascent, ref descent, ref gap)
    list<string> lines = value.split("\n")
    f32 line = tipSize() * 1.45
    f32 w = 0
    for (string s in lines) {
        w = most(w, textWidth(font, s, s.len()))
    }
    w = w + 16
    f32 h = f32(lines.len()) * line + 8
    f32 left = window.originX + 4
    f32 top = window.originY + 4
    f32 right = window.originX + f32(contentWidth(window)) - 4
    f32 bottom = window.originY + f32(contentHeight(window)) - 4
    f32 x = window.phone ? window.tipX - w / 2 : window.pointerX
    f32 y = window.phone ? window.tipY - h - 32 : window.pointerY + 22
    if (x + w > right) {
        x = right - w
    }
    if (y + h > bottom) {
        y = window.pointerY - h - 6
    }
    x = most(x, left)
    y = most(y, top)
    cromo_gui_shadow(r, x, y, w, h, 4, d, c.shadowNear, 2, 1)
    cromo_gui_box(r, x, y, w, h, 4, 1, d, solid(c.surface, true), solid(c.rule2, true))
    for (i64 k = 0; k < lines.len(); k++) {
        text(font, lines[k], x + 8, y + 4 + f32(k) * line + line / 2 + (ascent - descent) / 2, c.ink2, true)
    }
}

// A finger held still on a component for 0.5 s (D496): on a piece of rich text it is a
// click of the right button, on a component with a tooltip it shows it; then its
// release clicks nothing.
void checkLongPress(ref WindowData window, ref list<PartData> parts) {
    if (window.longPart == 0) {
        ret
    }
    if (window.held != window.longPart || window.dragMoved) {
        window.longPart = 0
        ret
    }
    if (SDL_GetTicksNS() - window.longStart < longPress) {
        ret
    }
    i64 p = partNumber(ref parts, window.longPart)
    window.longPart = 0
    if (p < 0) {
        ret
    }
    if (parts[p].kind == kindTextView && window.longPiece >= 0) {
        pieceClick(ref parts[p], window.longPiece, window.longX, window.longY, 3, ref window.requests)
    } else if (parts[p].tooltip.len() > 0) {
        window.tipPart = parts[p].id
        window.tipX = window.longX
        window.tipY = window.longY
    } else {
        ret
    }
    window.held = 0
    window.heldItem = -1
}

// ---- The tabs and the segmented controls (D494, D495) ----

f32 tabHeight() {  // a tab in the band of a tab view
    ret comfortable() ? 30 : 22
}

const f32 tabInset = 12  // the first tab from the left edge of the card
const f32 tabPad = 10    // the title of a tab from its edges
const f32 tabCorner = 5
const f32 segmentCorner = 4

void setSegments(i64 id, list<string> segments) {
    withData([id, segments](ref Shared data) {
        i64 p = partIndexOf(ref data, id)
        data.parts[p].items = segments
        data.parts[p].selected = segments.len() > 0 ? 0 : -1
    })
}

// A page of a tab view fills its card under the band, inside its border.
void placeTabPage(ref PartData page, i32 width, i32 height) {
    i32 band = i32(bandHeight())
    page.x = 1
    page.y = band
    page.width = width > 2 ? width - 2 : 0
    page.height = height > band + 1 ? height - band - 1 : 0
    page.baseX = page.x
    page.baseY = page.y
    page.baseWidth = page.width
    page.baseHeight = page.height
    page.parentWidth = width
    page.parentHeight = height
}

// The width of a title in the capitals of the bands, as bandTitle draws it.
f32 bandTitleWidth(ref WindowData window, string title) {
    string upper = title.upper()
    f32 spacing = bandSize() * 0.09
    f32 size = 0
    i64 next = 0
    for (i64 i = 0; i < upper.len(); i = next) {
        u8 lead = upper[i]
        next = least64(i + (lead < 0x80 ? 1 : lead < 0xE0 ? 2 : lead < 0xF0 ? 3 : 4), upper.len())
        size = size + textWidth(window.band, upper.slice(i, next), next - i) + (next < upper.len() ? spacing : 0)
    }
    ret size
}

// The tab or the segment at a point of the content, or -1. The tabs are where the last
// drawing put them.
i64 choiceAt(ref PartData part, f32 x, f32 y) {
    if (part.kind == kindSegmented) {
        if (part.items.len() == 0 || part.width <= 0) {
            ret -1
        }
        i64 item = i64((x - part.left) * f32(part.items.len()) / f32(part.width))
        ret item >= 0 && item < part.items.len() ? item : -1
    }
    f32 middle = part.top + bandHeight() / 2
    if (y < middle - tabHeight() / 2 || y >= middle + tabHeight() / 2) {
        ret -1
    }
    for (i64 k = 0; k + 1 < part.tabSpans.len() && k / 2 < part.items.len(); k += 2) {
        if (x >= part.left + part.tabSpans[k] && x < part.left + part.tabSpans[k] + part.tabSpans[k + 1]) {
            ret k / 2
        }
    }
    ret -1
}

// A tab or a segment chosen with the mouse or the keys: the handlers are called when it
// changes.
void chooseChoice(ref PartData part, i64 item, ref list<Call> calls) {
    if (item < 0 || item >= part.items.len() || item == part.selected) {
        ret
    }
    part.selected = item
    Call call = callOf(9, part.change)
    call.index = item
    calls.add(move call)
}

// Left, Right, Home and End on tabs or on a segmented control.
bool choiceKey(ref PartData part, Key key, ref list<Call> calls) {
    i64 n = part.items.len()
    if (n == 0) {
        ret false
    }
    i64 at = part.selected
    i64 next = at
    if (key.code == keyLeft) {
        next = at > 0 ? at - 1 : 0
    } else if (key.code == keyRight) {
        next = at < n - 1 ? at + 1 : n - 1
    } else if (key.code == keyHome) {
        next = 0
    } else if (key.code == keyEnd) {
        next = n - 1
    } else {
        ret false
    }
    chooseChoice(ref part, next, ref calls)
    ret true
}

// A tab view: a card as a group, with its tabs in the band, small, in capitals, as the
// titles of the bands: in ink 3, ink 2 on surface 3 under the mouse, the one chosen in
// accent 2 on the soft accent (D494).
void drawTabView(ref WindowData window, ref PartData view, ref Colors c, bool ring) {
    addr r = window.renderer
    f32 d = window.density
    f32 x = view.left
    f32 y = view.top
    f32 w = f32(view.width)
    f32 h = f32(view.height)
    bool on = view.active
    f32 band = bandHeight()
    cardShadow(r, x, y, w, h, groupCorner, d, ref c)
    bandCard(r, ref view, band, groupCorner, d, ref c, c.rule)
    clipInside(r, ref view, x + 1, y, w - 2, band)
    view.tabSpans.clear()
    f32 at = tabInset
    f32 top = y + (band - tabHeight()) / 2
    for (i64 k = 0; k < view.items.len(); k++) {
        f32 tab = bandTitleWidth(ref window, view.items[k]) + 2 * tabPad
        view.tabSpans.add(at)
        view.tabSpans.add(tab)
        bool chosen = k == view.selected
        bool hot = window.hot == view.id && window.hotItem == k && on
        u32 ink = c.ink3
        if (chosen) {
            cromo_gui_box(r, x + at, top, tab, tabHeight(), tabCorner, 0, d, solid(c.accentSoft, on), 0)
            ink = c.accent2
        } else if (hot) {
            cromo_gui_box(r, x + at, top, tab, tabHeight(), tabCorner, 0, d, solid(c.surface3, on), 0)
            ink = c.ink2
        }
        bandTitle(ref window, view.items[k], x + at + tabPad, top, tabHeight(), ink, on)
        if (chosen && ring) {
            clipPart(r, ref view)
            focusRing(r, x + at, top, tab, tabHeight(), tabCorner, d, ref c)
            clipInside(r, ref view, x + 1, y, w - 2, band)
        }
        at = at + tab + 2
    }
    clipPart(r, ref view)
}

// A segmented control: a box with the border of the controls, its segments in equal
// parts with a line between them, the one chosen filled with the accent, with its text
// semibold on the accent, the one under the mouse in surface 3 (D495).
void drawSegmented(ref WindowData window, ref PartData part, ref Colors c, bool ring) {
    addr r = window.renderer
    f32 d = window.density
    f32 x = part.left
    f32 y = part.top
    f32 w = f32(part.width)
    f32 h = f32(part.height)
    bool on = part.active
    i64 n = part.items.len()
    cromo_gui_box(r, x, y, w, h, segmentCorner, 1, d, solid(c.surface, on), solid(c.rule2, on))
    f32 ascent = 0
    f32 descent = 0
    f32 gap = 0
    cromo_gui_font_metrics(window.body, ref ascent, ref descent, ref gap)
    f32 baseline = y + h / 2 + (ascent - descent) / 2
    for (i64 k = 0; k < n; k++) {
        f32 left = x + w * f32(k) / f32(n)
        f32 right = x + w * f32(k + 1) / f32(n)
        bool chosen = k == part.selected
        bool hot = window.hot == part.id && window.hotItem == k && on
        if (chosen || hot) {  // inside the border; round only at the ends of the box
            f32 from = k == 0 ? x + 1 : left - segmentCorner
            f32 to = k == n - 1 ? x + w - 1 : right + segmentCorner
            clipInside(r, ref part, left, y, right - left, h)
            cromo_gui_box(r, from, y + 1, to - from, h - 2, segmentCorner - 1, 0, d, solid(chosen ? c.accent : c.surface3, on), 0)
        }
        if (k > 0 && !chosen && k - 1 != part.selected) {
            clipPart(r, ref part)
            fill(r, c.rule2, left, y + 1, 1, h - 2)
        }
        addr font = chosen ? window.strong : window.body
        f32 size = textWidth(font, part.items[k], part.items[k].len())
        clipInside(r, ref part, left + 4, y, right - left - 8, h)
        text(font, part.items[k], most(left + (right - left - size) / 2, left + 4), baseline, chosen ? c.onAccent : c.ink, on)
    }
    clipPart(r, ref part)
    if (ring) {
        focusRing(r, x, y, w, h, segmentCorner, d, ref c)
    }
}

// ---- The rich text (D490-D493) ----

const f32 viewPadX = 10    // the text of a text view from its left and right edges
const f32 viewPadY = 8     // from its top and bottom edges
const f32 blockGap = 3     // above and under a block
const f32 blockInset = 10  // from the line of a block to its text

// A part of a rich text: 1 a text, 2 an image, 3 a gap, 4 a new line, 5 the start of a
// block, 6 its end.
struct Run {
    i32 kind
    string text
    TextStyle style
    i64 piece = -1
    i64 image
    f32 width   // of an image or of a gap, the indent of a block
    f32 height  // of an image
    BlockLine line
}

// The runs of a text, a new line for each "\n".
void addRuns(ref list<Run> runs, i64 piece, string value, TextStyle style) {
    if (!(style.scale > 0)) {
        panic(format("the scale of a style of rich text is more than 0, found {}", style.scale))
    }
    i64 start = 0
    for (i64 i = 0; i <= value.len(); i++) {
        if (i == value.len() || value[i] == 10) {
            if (i > start) {
                Run r
                r.kind = 1
                r.text = value.slice(start, i)
                r.style = style
                r.piece = piece
                runs.add(move r)
            }
            if (i < value.len()) {
                Run line
                line.kind = 4
                runs.add(move line)
            }
            start = i + 1
        }
    }
}

Run imageRun(i64 piece, Image picture, f32 width, f32 height) {
    Run r
    r.kind = 2
    r.piece = piece
    r.image = picture.id
    r.width = width > 0 ? width : 0
    r.height = height > 0 ? height : 0
    ret r
}

// A part of a run as the layout places it on a line: its x from the left of the text.
struct Placed {
    i64 run
    string text  // of a text, its part on the line
    i64 piece
    i32 face  // of its font, and its size
    f32 size
    f32 x
    f32 width
    f32 ascent  // of its font, for its line
    f32 descent
    f32 tall    // the height of the line that it needs
    bool space  // spaces or a gap, where a line can break
}

// A line of the layout: its top from the top of the text, its height, its baseline and
// the middle of its letters from its top, and its parts, from first to end.
struct TextLine {
    f32 top
    f32 height
    f32 baseline
    f32 middle
    i64 first
    i64 end
}

// The line along a block, from the left and the top of the text.
struct BlockMark {
    f32 x
    f32 top
    f32 bottom
    BlockLine line
}

// The layout of a text view, made for its width, the piece marked, the size and the
// spacing of its text and the density of its display, which it keeps until they change.
struct TextLayout {
    list<Placed> placed
    list<TextLine> lines
    list<BlockMark> blocks
    f32 width = -1
    i64 marked = -1
    f32 size
    f32 spacing
    f32 density
}

// Where the layout is: the line that it fills, and the parts since the last place where
// a line can break, which go on this line or on the next one together.
struct Flow {
    f32 width  // of the text
    f32 left   // the margin of the blocks open
    f32 x      // where the next part goes, from the margin
    f32 y      // the top of the line
    i64 first  // the first part of the line
    f32 ascent
    f32 descent
    f32 tall
    bool empty = true
    bool wrapped    // the line comes after one that broke by itself
    i64 piece = -1  // of the last text or image, for the room around the pieces
    list<Placed> unit
    f32 unitWidth
    f32 unitInk     // without the spaces at its end
    f32 baseAscent  // of the text of the view, for the lines without text
    f32 baseDescent
    f32 baseTall
    list<f32> lefts  // of the blocks open: the margin before them, their top, their line
    list<f32> tops
    list<f32> bars
    list<BlockLine> kinds
}

u32 inkOf(Ink ink, ref Colors c) {
    if (ink == Ink.Secondary) {
        ret c.ink2
    }
    if (ink == Ink.Faint) {
        ret c.ink3
    }
    if (ink == Ink.Accent) {
        ret c.accent2
    }
    if (ink == Ink.Selection) {
        ret c.selection
    }
    if (ink == Ink.Danger) {
        ret c.danger
    }
    ret c.ink
}

u32 blockColor(BlockLine line, ref Colors c) {
    if (line == BlockLine.Selection) {
        ret c.selectionSoft
    }
    if (line == BlockLine.Accent) {
        ret c.accent
    }
    ret c.rule2
}

// The face of the font of a style: 0 Inter, 3 JetBrains Mono, 1 more for semibold, as
// a piece marked, and 8 more for the italic (D492, D493).
i32 faceOf(TextStyle style, bool marked) {
    i32 face = style.mono ? 3 : 0
    if (style.strong || marked) {
        face = face + 1
    }
    if (style.italic) {
        face = face + 8
    }
    ret face
}

f32 viewSize(ref PartData view) {
    ret view.textSize > 0 ? view.textSize : bodySize()
}

// Lays out the rich text of a view, when it, its width, its piece marked, its size, its
// spacing or the density changed.
void layoutText(ref WindowData window, ref PartData view) {
    f32 size = viewSize(ref view)
    f32 width = most(f32(view.width) - 2 * viewPadX, 1)
    if (!view.richChanged && view.laid.width == width && view.laid.marked == view.marked && view.laid.size == size &&
        view.laid.spacing == view.lineSpacing && view.laid.density == window.density) {
        ret
    }
    TextLayout laid
    laid.width = width
    laid.marked = view.marked
    laid.size = size
    laid.spacing = view.lineSpacing
    laid.density = window.density
    Flow f
    f.width = width
    f32 ascent = 0
    f32 descent = 0
    f32 gap = 0
    cromo_gui_font_metrics(faceFor(ref window, 0, size), ref ascent, ref descent, ref gap)
    f.baseAscent = ascent
    f.baseDescent = descent
    f.baseTall = size * view.lineSpacing
    for (i64 r = 0; r < view.rich.runs.len(); r++) {
        i32 kind = view.rich.runs[r].kind
        i64 piece = kind == 1 || kind == 2 ? view.rich.runs[r].piece : -1
        if (piece != f.piece) {  // 2 pixels on each side of a piece, inside its box
            if (f.piece >= 0) {
                padPiece(ref window, ref f, ref laid)
            }
            if (piece >= 0) {
                padPiece(ref window, ref f, ref laid)
            }
            f.piece = piece
        }
        if (kind == 1) {
            flowText(ref window, ref f, ref laid, ref view, r, size)
        } else if (kind == 2 || kind == 3) {
            Placed p
            p.run = r
            p.piece = view.rich.runs[r].piece
            p.width = view.rich.runs[r].width
            p.space = kind == 3
            p.tall = kind == 2 ? view.rich.runs[r].height + 4 : 0
            flowPart(ref window, ref f, ref laid, p)
        } else if (kind == 4) {
            commitUnit(ref window, ref f, ref laid)
            endLine(ref f, ref laid, false)
        } else if (kind == 5) {
            commitUnit(ref window, ref f, ref laid)
            if (!f.empty) {
                endLine(ref f, ref laid, false)
            }
            f.y = f.y + blockGap
            BlockLine line = view.rich.runs[r].line
            f.lefts.add(f.left)
            f.tops.add(f.y)
            f.bars.add(f.left + view.rich.runs[r].width)
            f.kinds.add(line)
            f.left = f.left + view.rich.runs[r].width + (line == BlockLine.None ? 0 : blockInset)
            f.wrapped = false
        } else if (kind == 6) {
            closeBlock(ref window, ref f, ref laid)
        }
    }
    commitUnit(ref window, ref f, ref laid)
    if (!f.empty) {
        endLine(ref f, ref laid, false)
    }
    for (f.lefts.len() > 0) {
        closeBlock(ref window, ref f, ref laid)
    }
    view.content = f.y + 2 * viewPadY
    view.laid = move laid
    view.richChanged = false
    clampScroll(ref view)
}

// The words and the spaces of a text, each a part: a line can break after the spaces,
// but not inside a piece.
void flowText(ref WindowData window, ref Flow f, ref TextLayout laid, ref PartData view, i64 r, f32 base) {
    TextStyle style = view.rich.runs[r].style
    i64 piece = view.rich.runs[r].piece
    string value = view.rich.runs[r].text
    i32 face = faceOf(style, piece >= 0 && piece == view.marked)
    f32 size = base * style.scale
    addr font = faceFor(ref window, face, size)
    f32 ascent = 0
    f32 descent = 0
    f32 gap = 0
    cromo_gui_font_metrics(font, ref ascent, ref descent, ref gap)
    i64 start = 0
    for (i64 i = 1; i <= value.len(); i++) {
        if (i == value.len() || (value[i] == 32) != (value[i - 1] == 32)) {
            Placed p
            p.run = r
            p.text = value.slice(start, i)
            p.piece = piece
            p.face = face
            p.size = size
            p.width = textWidth(font, p.text, i - start)
            p.ascent = ascent
            p.descent = descent
            p.tall = size * view.lineSpacing
            p.space = value[start] == 32 && piece < 0
            flowPart(ref window, ref f, ref laid, p)
            start = i
        }
    }
}

// The room on a side of a piece, which goes with it.
void padPiece(ref WindowData window, ref Flow f, ref TextLayout laid) {
    Placed pad
    pad.run = -1
    pad.piece = -1
    pad.width = 2
    flowPart(ref window, ref f, ref laid, pad)
}

// A part joins the unit; after spaces or a gap the unit goes on a line.
void flowPart(ref WindowData window, ref Flow f, ref TextLayout laid, Placed p) {
    f.unitWidth = f.unitWidth + p.width
    if (!p.space) {
        f.unitInk = f.unitWidth
    }
    bool breaks = p.space
    f.unit.add(p)
    if (breaks) {
        commitUnit(ref window, ref f, ref laid)
    }
}

// The unit on the line, or on the next one when it does not fit; a word wider than the
// whole line is cut where the line ends.
void commitUnit(ref WindowData window, ref Flow f, ref TextLayout laid) {
    if (f.unit.len() == 0) {
        ret
    }
    f32 room = f.width - f.left
    if (!f.empty && f.x + f.unitInk > room) {
        endLine(ref f, ref laid, true)
    }
    bool fits = f.x + f.unitInk <= room
    for (i64 k = 0; k < f.unit.len(); k++) {
        if (f.empty && f.wrapped && f.unit[k].space) {
            continue  // a line that broke by itself does not start with spaces
        }
        if (!fits && !f.unit[k].space && f.x + f.unit[k].width > room) {
            if (!f.empty && f.unit[k].width <= room) {
                endLine(ref f, ref laid, true)
            } else if (f.unit[k].text.len() > 0) {
                Placed word = f.unit[k]
                cutWord(ref window, ref f, ref laid, word)
                continue
            }
        }
        Placed p = f.unit[k]
        putOnLine(ref f, ref laid, p)
    }
    f.unit.clear()
    f.unitWidth = 0
    f.unitInk = 0
}

// A part on the line, after those already there.
void putOnLine(ref Flow f, ref TextLayout laid, Placed p) {
    Placed q = p
    q.x = f.left + f.x
    f.x = f.x + q.width
    f.ascent = most(f.ascent, q.ascent)
    f.descent = most(f.descent, q.descent)
    f.tall = most(f.tall, q.tall)
    f.empty = false
    laid.placed.add(move q)
}

// A word wider than the room left, on as many lines as it takes, cut between its letters.
void cutWord(ref WindowData window, ref Flow f, ref TextLayout laid, Placed p) {
    addr font = faceFor(ref window, p.face, p.size)
    f32 room = f.width - f.left
    i64 start = 0
    f32 used = 0
    i64 next = 0
    for (i64 i = 0; i < p.text.len(); i = next) {
        u8 lead = p.text[i]
        next = least64(i + (lead < 0x80 ? 1 : lead < 0xE0 ? 2 : lead < 0xF0 ? 3 : 4), p.text.len())
        f32 w = textWidth(font, p.text.slice(i, next), next - i)
        if (f.x + used + w > room && (i > start || !f.empty)) {
            if (i > start) {
                Placed part = p
                part.text = p.text.slice(start, i)
                part.width = used
                putOnLine(ref f, ref laid, part)
            }
            endLine(ref f, ref laid, true)
            start = i
            used = 0
        }
        used = used + w
    }
    if (p.text.len() > start) {
        Placed part = p
        part.text = p.text.slice(start, p.text.len())
        part.width = used
        putOnLine(ref f, ref laid, part)
    }
}

// Ends the line: its height is the most that its parts need, and its letters are in its
// middle.
void endLine(ref Flow f, ref TextLayout laid, bool wrapped) {
    TextLine line
    line.top = f.y
    f32 ascent = f.ascent > 0 ? f.ascent : f.baseAscent
    f32 descent = f.descent > 0 ? f.descent : f.baseDescent
    f32 height = f.tall > 0 ? f.tall : f.baseTall
    line.height = height
    line.baseline = (height + ascent - descent) / 2
    line.middle = line.baseline - (f.baseAscent - f.baseDescent) / 2
    line.first = f.first
    line.end = laid.placed.len()
    laid.lines.add(move line)
    f.y = f.y + height
    f.x = 0
    f.first = laid.placed.len()
    f.ascent = 0
    f.descent = 0
    f.tall = 0
    f.empty = true
    f.wrapped = wrapped
}

// Ends the last block open, with its line from its top to here.
void closeBlock(ref WindowData window, ref Flow f, ref TextLayout laid) {
    commitUnit(ref window, ref f, ref laid)
    if (!f.empty) {
        endLine(ref f, ref laid, false)
    }
    i64 last = f.lefts.len() - 1
    if (last < 0) {
        ret
    }
    if (f.kinds[last] != BlockLine.None) {
        BlockMark mark
        mark.x = f.bars[last]
        mark.top = f.tops[last]
        mark.bottom = f.y
        mark.line = f.kinds[last]
        laid.blocks.add(move mark)
    }
    f.left = f.lefts.remove(last)
    f.tops.remove(last)
    f.bars.remove(last)
    f.kinds.remove(last)
    f.y = f.y + blockGap
    f.wrapped = false
}

// The first line whose bottom is under y, from the top of the text, or the number of
// the lines.
i64 lineBelow(ref TextLayout laid, f32 y) {
    i64 low = 0
    i64 high = laid.lines.len()
    for (low < high) {
        i64 middle = (low + high) / 2
        if (laid.lines[middle].top + laid.lines[middle].height <= y) {
            low = middle + 1
        } else {
            high = middle
        }
    }
    ret low
}

// The piece at a point of the window, or -1: its parts, and the 2 pixels on each side.
i64 pieceAt(ref PartData view, f32 x, f32 y) {
    f32 tx = x - view.left - viewPadX
    f32 ty = y - view.top - viewPadY + view.offsetY
    i64 k = lineBelow(ref view.laid, ty)
    if (k >= view.laid.lines.len() || view.laid.lines[k].top > ty) {
        ret -1
    }
    for (i64 a = view.laid.lines[k].first; a < view.laid.lines[k].end; a++) {
        if (view.laid.placed[a].piece >= 0 && tx >= view.laid.placed[a].x - 2 &&
            tx < view.laid.placed[a].x + view.laid.placed[a].width + 2) {
            ret view.laid.placed[a].piece
        }
    }
    ret -1
}

// Scrolls a view as little as it takes to show the line of a piece, after its layout.
void revealPiece(ref PartData view) {
    i64 piece = view.reveal
    view.reveal = -1
    if (piece < 0) {
        ret
    }
    for (i64 k = 0; k < view.laid.lines.len(); k++) {
        for (i64 a = view.laid.lines[k].first; a < view.laid.lines[k].end; a++) {
            if (view.laid.placed[a].piece == piece) {
                f32 top = view.laid.lines[k].top
                f32 bottom = top + view.laid.lines[k].height + 2 * viewPadY
                view.velocity = 0
                if (top < view.offsetY) {
                    scrollBy(ref view, top - view.offsetY)
                } else if (bottom > view.offsetY + f32(view.height)) {
                    scrollBy(ref view, bottom - f32(view.height) - view.offsetY)
                }
                ret
            }
        }
    }
}

// A click on a piece, with a button of the mouse.
void pieceClick(ref PartData view, i64 piece, f32 x, f32 y, i32 button, ref list<Call> calls) {
    Call call = callOf(12, view.pieces)
    call.index = piece
    call.mouse = canvasMouse(ref view, x, y, button)
    calls.add(move call)
}

// The middle and the right buttons of the mouse on a piece: a press and a release on
// the same one click it, as the left button does through pressPart and releasePart.
void otherButton(ref WindowData window, ref list<PartData> parts, bool down, i32 button, f32 x, f32 y, ref list<Call> calls) {
    i64 p = window.popup == 0 && !snackAt(ref window, x, y) ? partAt(ref window, ref parts, x, y) : -1
    i64 piece = p >= 0 && parts[p].kind == kindTextView && parts[p].active ? pieceAt(ref parts[p], x, y) : -1
    if (down) {
        window.sideView = piece >= 0 ? parts[p].id : 0
        window.sidePiece = piece
        window.sideButton = button
    } else {
        if (piece >= 0 && parts[p].id == window.sideView && piece == window.sidePiece && button == window.sideButton) {
            pieceClick(ref parts[p], piece, x, y, button, ref calls)
        }
        window.sideView = 0
    }
}

// A text view on the surface: the lines of its blocks, the box of the piece marked in
// the accent and that of the piece under the mouse in the third surface, then the texts
// and the images of the lines that are seen.
void drawTextView(ref WindowData window, ref PartData view, ref Colors c, ref list<ImageData> images) {
    addr r = window.renderer
    f32 d = window.density
    f32 x = view.left
    f32 y = view.top
    f32 w = f32(view.width)
    f32 h = f32(view.height)
    bool on = view.active
    layoutText(ref window, ref view)
    revealPiece(ref view)
    clipInside(r, ref view, x, y, w, h)
    fill(r, c.surface, x, y, w, h)
    f32 left = x + viewPadX
    f32 top = y + viewPadY - view.offsetY
    for (ref BlockMark mark in view.laid.blocks) {
        if (top + mark.bottom > y && top + mark.top < y + h) {
            cromo_gui_box(r, left + mark.x, top + mark.top, 2, mark.bottom - mark.top, 0, 0, d, solid(blockColor(mark.line, ref c), on), 0)
        }
    }
    for (ref CanvasTexture t in view.imageTextures) {
        t.used = false
    }
    addr none
    bool hot = window.hot == view.id && on
    for (i64 k = lineBelow(ref view.laid, view.offsetY - viewPadY); k < view.laid.lines.len(); k++) {
        f32 lineTop = top + view.laid.lines[k].top
        if (lineTop >= y + h) {
            break
        }
        f32 lineHeight = view.laid.lines[k].height
        i64 end = view.laid.lines[k].end
        i64 a = view.laid.lines[k].first
        for (a < end) {
            i64 piece = view.laid.placed[a].piece
            i64 b = a + 1
            for (b < end && view.laid.placed[b].piece == piece) {
                b++
            }
            bool marked = piece >= 0 && piece == view.marked
            if (marked || (piece >= 0 && hot && window.hotItem == piece)) {
                f32 from = view.laid.placed[a].x
                f32 to = view.laid.placed[b - 1].x + view.laid.placed[b - 1].width
                cromo_gui_box(r, left + from - 2, lineTop + 1, to - from + 4, lineHeight - 2, 3, 0, d,
                    solid(marked ? c.accent : c.surface3, on), 0)
            }
            a = b
        }
        for (a = view.laid.lines[k].first; a < end; a++) {
            i64 run = view.laid.placed[a].run
            if (view.laid.placed[a].space || run < 0) {
                continue
            }
            f32 px = left + view.laid.placed[a].x
            if (view.rich.runs[run].kind == 1) {
                bool marked = view.laid.placed[a].piece >= 0 && view.laid.placed[a].piece == view.marked
                u32 ink = marked ? c.onAccent : inkOf(view.rich.runs[run].style.ink, ref c)
                addr font = faceFor(ref window, view.laid.placed[a].face, view.laid.placed[a].size)
                text(font, view.laid.placed[a].text, px, lineTop + view.laid.lines[k].baseline, ink, on)
            } else if (view.rich.runs[run].kind == 2) {
                i64 id = view.rich.runs[run].image
                f32 bw = view.rich.runs[run].width
                f32 bh = view.rich.runs[run].height
                if (id >= 1 && id <= images.len() && bw > 0 && bh > 0) {
                    f32 k2 = least(bw / images[id - 1].width, bh / images[id - 1].height)
                    f32 dw = images[id - 1].width * k2
                    f32 dh = images[id - 1].height * k2
                    addr texture = imageTexture(ref window, ref view, ref images, id, i32(dw * d + 0.5), i32(dh * d + 0.5))
                    if (texture != none) {
                        if (!on) {
                            SDL_SetTextureAlphaMod(texture, 128)
                        }
                        Rect place = Rect(px + (bw - dw) / 2, lineTop + view.laid.lines[k].middle - dh / 2, dw, dh)
                        SDL_RenderTexture(r, texture, none, ref place)
                        SDL_SetTextureAlphaMod(texture, 255)
                    }
                }
            }
        }
    }
    for (i64 k = view.imageTextures.len() - 1; k >= 0; k--) {
        if (!view.imageTextures[k].used) {
            SDL_DestroyTexture(view.imageTextures[k].texture)
            view.imageTextures.remove(k)
        }
    }
    clipPart(r, ref view)
}

// ---- The canvas and the images of the drawings (D483, D484) ----

// A shape of a drawing: 1 a rectangle, 2 the outline of one, 3 a circle, 4 the outline
// of one, 5 a segment, 6 a polygon, 7 a polyline, 8 an image, 9 a text. A circle has
// the square around it; a text has its x, the middle of its line and its size in h.
struct Shape {
    i32 kind
    f32 x
    f32 y
    f32 w
    f32 h
    f32 radius
    f32 thickness
    Color color
    list<f32> points
    i64 image
    string text
    Horizontal align
}

Shape shapeOf(i32 kind, f32 x, f32 y, f32 w, f32 h, Color color) {
    Shape s
    s.kind = kind
    s.x = x
    s.y = y
    s.w = w
    s.h = h
    s.color = color
    ret s
}

// An image of the drawings, kept for the whole program: the pixels of a raster image,
// or the bytes of an SVG image, with its size.
struct ImageData {
    addr pixels
    addr svg
    i64 svgSize
    f32 width
    f32 height
}

// The texture of an image as a canvas draws it, of the size in pixels of the display
// at which it was made, for the images of SVG; the others are made once.
struct CanvasTexture {
    i64 image
    i32 w
    i32 h
    addr texture
    bool used
}

// The segments, polygons and polylines of a drawing that follow one another, from
// `first` to `end`, drawn by nanosvg into one texture, smoothed, over the rectangle
// that holds them.
struct CanvasLayer {
    i64 first
    i64 end
    f32 x
    f32 y
    f32 w
    f32 h
    addr texture
}

// Bytes that start with '<', after the spaces and the mark of UTF-8, are SVG.
bool isSvg(list<u8> bytes) {
    for (i64 i = 0; i < bytes.len(); i++) {
        u8 b = bytes[i]
        bool skipped = b == 32 || b == 9 || b == 10 || b == 13 || (i < 3 && (b == 0xEF || b == 0xBB || b == 0xBF))
        if (!skipped) {
            ret b == 60
        }
    }
    ret false
}

// The bytes in memory of C, which the caller frees.
addr memoryOf(list<u8> bytes) {
    addr data = alloc(most64(bytes.len(), 1))
    for (i64 i = 0; i < bytes.len(); i++) {
        put<u8>(offset(data, i), bytes[i])
    }
    ret data
}

i64 most64(i64 a, i64 b) {
    ret a > b ? a : b
}

i64 newImage(list<u8> bytes) {
    ImageData image
    if (isSvg(bytes)) {
        addr data = memoryOf(bytes)
        f32 w = 0
        f32 h = 0
        if (!cromo_gui_svg_size(data, bytes.len(), ref w, ref h)) {
            free(data)
            throw Error("cannot read the image: it is not an SVG image that can be read, or it has no size")
        }
        image.svg = data
        image.svgSize = bytes.len()
        image.width = w
        image.height = h
    } else {
        i32 w = 0
        i32 h = 0
        image.pixels = decodeImage("", bytes, ref w, ref h)
        image.width = f32(w)
        image.height = f32(h)
    }
    addr box = alloc(sizeOf<ImageData>())
    put<ImageData>(box, move image)
    i64 made = 0
    withData([box, ref made](ref Shared data) {
        data.images.add(take<ImageData>(box))
        made = data.images.len()
    })
    free(box)
    ret made
}

f32 imageSize(i64 id, bool wide) {
    f32 size = 0
    withData([id, wide, ref size](ref Shared data) {
        if (id >= 1 && id <= data.images.len()) {
            size = wide ? data.images[id - 1].width : data.images[id - 1].height
        }
    })
    ret size
}

// The font of the texts of the drawings at a size, made the first time it is used.
addr fontFor(ref WindowData window, f32 size) {
    ret faceFor(ref window, 0, size)
}

// The font of a face at a size, made the first time it is used: 0 Inter, 1 semibold, 3
// JetBrains Mono, 4 semibold, 8 more for the italic (D492, D493).
addr faceFor(ref WindowData window, i32 face, f32 size) {
    for (i64 i = 0; i < window.fontSizes.len(); i++) {
        if (window.fontSizes[i] == size && window.fontFaces[i] == face) {
            ret window.fonts[i]
        }
    }
    addr font = cromo_gui_font(window.renderer, face, size, window.density)
    window.fontSizes.add(size)
    window.fontFaces.add(face)
    window.fonts.add(font)
    ret font
}

void freeFonts(ref WindowData window) {
    for (addr font in window.fonts) {
        cromo_gui_font_free(font)
    }
    window.fonts.clear()
    window.fontSizes.clear()
    window.fontFaces.clear()
}

// The textures of a canvas, as when its renderer loses them or its window closes.
void freeCanvasTextures(ref PartData part) {
    for (ref CanvasTexture t in part.imageTextures) {
        SDL_DestroyTexture(t.texture)
    }
    part.imageTextures.clear()
    dropLayers(ref part)
    part.drawingChanged = true
}

void dropLayers(ref PartData part) {
    addr none
    for (ref CanvasLayer layer in part.layers) {
        if (layer.texture != none) {
            SDL_DestroyTexture(layer.texture)
        }
    }
    part.layers.clear()
}

u32 argbOf(Color c) {
    ret (u32(c.alpha) << 24) | (u32(c.red) << 16) | (u32(c.green) << 8) | u32(c.blue)
}

bool isVector(i32 kind) {
    ret kind >= 5 && kind <= 7
}

// A texture from pixels R, G, B, A, which it frees; none without them.
addr textureOf(addr renderer, addr pixels, i32 w, i32 h) {
    addr none
    if (pixels == none) {
        ret none
    }
    addr texture = SDL_CreateTexture(renderer, 0x16762004, 0, w, h)  // RGBA32, static
    if (texture != none) {
        SDL_SetTextureBlendMode(texture, 1)
        SDL_UpdateTexture(texture, none, pixels, w * 4)
    }
    cromo_gui_image_free(pixels)
    ret texture
}

string svgNumber(f32 v) {
    ret format("{:.2f}", v)
}

string svgPaint(Color c) {
    ret format("#{:02x}{:02x}{:02x}", c.red, c.green, c.blue)
}

string svgOpacity(Color c) {
    ret format("{:.3f}", f32(c.alpha) / 255)
}

string svgPoints(list<f32> points) {
    string text
    for (i64 i = 0; i + 1 < points.len(); i += 2) {
        text += format("{}{},{}", i > 0 ? " " : "", svgNumber(points[i]), svgNumber(points[i + 1]))
    }
    ret text
}

// The vector shapes of a drawing from `first`, as long as they follow one another, as
// one layer: the rectangle that holds them, and the texture that nanosvg draws of them
// at the density of the display (D484).
CanvasLayer vectorLayer(ref WindowData window, ref list<Shape> shapes, i64 first) {
    CanvasLayer layer
    layer.first = first
    f32 left = 1e30
    f32 top = 1e30
    f32 right = -1e30
    f32 bottom = -1e30
    i64 end = first
    for (i64 k = first; k < shapes.len() && isVector(shapes[k].kind); k++) {
        end = k + 1
        f32 grow = shapes[k].kind == 6 ? 1 : shapes[k].thickness / 2 + 1
        for (i64 i = 0; i + 1 < shapes[k].points.len(); i += 2) {
            left = least(left, shapes[k].points[i] - grow)
            right = most(right, shapes[k].points[i] + grow)
            top = least(top, shapes[k].points[i + 1] - grow)
            bottom = most(bottom, shapes[k].points[i + 1] + grow)
        }
    }
    layer.end = end
    layer.x = f32(i64(left) - 1)
    layer.y = f32(i64(top) - 1)
    layer.w = f32(i64(right - layer.x) + 2)
    layer.h = f32(i64(bottom - layer.y) + 2)
    string svg = format("<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"{}\" height=\"{}\" viewBox=\"{} {} {} {}\">",
        svgNumber(layer.w), svgNumber(layer.h), svgNumber(layer.x), svgNumber(layer.y), svgNumber(layer.w),
        svgNumber(layer.h))
    for (i64 k = first; k < end; k++) {
        Color c = shapes[k].color
        if (shapes[k].kind == 5) {
            svg += format("<line x1=\"{}\" y1=\"{}\" x2=\"{}\" y2=\"{}\" stroke=\"{}\" stroke-opacity=\"{}\" stroke-width=\"{}\" stroke-linecap=\"round\"/>",
                svgNumber(shapes[k].points[0]), svgNumber(shapes[k].points[1]), svgNumber(shapes[k].points[2]),
                svgNumber(shapes[k].points[3]), svgPaint(c), svgOpacity(c), svgNumber(shapes[k].thickness))
        } else if (shapes[k].kind == 6) {
            svg += format("<polygon points=\"{}\" fill=\"{}\" fill-opacity=\"{}\"/>", svgPoints(shapes[k].points), svgPaint(c),
                svgOpacity(c))
        } else {
            svg += format("<polyline points=\"{}\" fill=\"none\" stroke=\"{}\" stroke-opacity=\"{}\" stroke-width=\"{}\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>",
                svgPoints(shapes[k].points), svgPaint(c), svgOpacity(c), svgNumber(shapes[k].thickness))
        }
    }
    svg += "</svg>"
    i32 pw = i32(layer.w * window.density + 0.999)
    i32 ph = i32(layer.h * window.density + 0.999)
    addr pixels = cromo_gui_svg_draw(svg.cstring(), svg.len(), pw, ph)
    layer.texture = textureOf(window.renderer, pixels, pw, ph)
    ret layer
}

// The texture of an image as a canvas draws it at `w` by `h` pixels of the display:
// the same one for a raster image, one for each size for an SVG image.
addr imageTexture(ref WindowData window, ref PartData part, ref list<ImageData> images, i64 id, i32 w, i32 h) {
    addr none
    if (id < 1 || id > images.len()) {
        ret none
    }
    bool vector = images[id - 1].svg != none
    for (ref CanvasTexture t in part.imageTextures) {
        if (t.image == id && (!vector || (t.w == w && t.h == h))) {
            t.used = true
            ret t.texture
        }
    }
    CanvasTexture made
    made.image = id
    made.w = w
    made.h = h
    made.used = true
    if (vector) {
        made.texture = textureOf(window.renderer, cromo_gui_svg_draw(images[id - 1].svg, images[id - 1].svgSize, w, h), w, h)
    } else {
        made.texture = SDL_CreateTexture(window.renderer, 0x16762004, 0, i32(images[id - 1].width), i32(images[id - 1].height))
        if (made.texture != none) {
            SDL_SetTextureBlendMode(made.texture, 1)
            SDL_UpdateTexture(made.texture, none, images[id - 1].pixels, i32(images[id - 1].width) * 4)
        }
    }
    addr texture = made.texture
    if (texture != none) {
        part.imageTextures.add(move made)
    }
    ret texture
}

// A canvas: its shapes in order, the rectangles and the circles as the boxes of the
// components, the vector shapes in their layers, the images and the texts (D483).
void drawCanvas(ref WindowData window, ref PartData part, ref list<ImageData> images) {
    addr r = window.renderer
    f32 d = window.density
    f32 x0 = part.left
    f32 y0 = part.top
    clipInside(r, ref part, x0, y0, f32(part.width), f32(part.height))
    if (part.drawingChanged || part.drawnDensity != d) {
        dropLayers(ref part)
        for (i64 i = 0; i < part.drawing.shapes.len(); i++) {
            if (isVector(part.drawing.shapes[i].kind) && (i == 0 || !isVector(part.drawing.shapes[i - 1].kind))) {
                CanvasLayer made = vectorLayer(ref window, ref part.drawing.shapes, i)
                part.layers.add(move made)
            }
        }
        part.drawingChanged = false
        part.drawnDensity = d
    }
    for (ref CanvasTexture t in part.imageTextures) {
        t.used = false
    }
    addr none
    i64 layer = 0
    for (i64 i = 0; i < part.drawing.shapes.len(); i++) {
        i32 kind = part.drawing.shapes[i].kind
        Color c = part.drawing.shapes[i].color
        f32 x = x0 + part.drawing.shapes[i].x
        f32 y = y0 + part.drawing.shapes[i].y
        f32 w = part.drawing.shapes[i].w
        f32 h = part.drawing.shapes[i].h
        if (kind == 1 || kind == 3) {
            cromo_gui_box(r, x, y, w, h, part.drawing.shapes[i].radius, 0, d, argbOf(c), 0)
        } else if (kind == 2 || kind == 4) {
            f32 radius = kind == 4 ? part.drawing.shapes[i].radius : 0
            cromo_gui_box(r, x, y, w, h, radius, part.drawing.shapes[i].thickness, d, 0, argbOf(c))
        } else if (isVector(kind)) {
            if (layer < part.layers.len() && part.layers[layer].first == i) {
                if (part.layers[layer].texture != none) {
                    f32 pw = f32(i32(part.layers[layer].w * d + 0.999)) / d
                    f32 ph = f32(i32(part.layers[layer].h * d + 0.999)) / d
                    Rect place = Rect(x0 + part.layers[layer].x, y0 + part.layers[layer].y, pw, ph)
                    SDL_RenderTexture(r, part.layers[layer].texture, none, ref place)
                }
                layer++
            }
        } else if (kind == 8) {
            i64 id = part.drawing.shapes[i].image
            if (id >= 1 && id <= images.len() && w > 0 && h > 0) {
                f32 iw = images[id - 1].width
                f32 ih = images[id - 1].height
                f32 k = least(w / iw, h / ih)
                f32 dw = iw * k
                f32 dh = ih * k
                addr texture = imageTexture(ref window, ref part, ref images, id, i32(dw * d + 0.5), i32(dh * d + 0.5))
                if (texture != none) {
                    Rect place = Rect(x + (w - dw) / 2, y + (h - dh) / 2, dw, dh)
                    SDL_RenderTexture(r, texture, none, ref place)
                }
            }
        } else if (kind == 9 && h > 0) {
            addr font = fontFor(ref window, h)
            string value = part.drawing.shapes[i].text
            f32 ascent = 0
            f32 descent = 0
            f32 gap = 0
            cromo_gui_font_metrics(font, ref ascent, ref descent, ref gap)
            f32 size = textWidth(font, value, value.len())
            Horizontal align = part.drawing.shapes[i].align
            f32 left = align == Horizontal.Center ? x - size / 2 : align == Horizontal.Right ? x - size : x
            cromo_gui_text(font, value.cstring(), value.len(), left, y + (ascent - descent) / 2, c.red, c.green, c.blue, c.alpha)
        }
    }
    for (i64 k = part.imageTextures.len() - 1; k >= 0; k--) {
        if (!part.imageTextures[k].used) {
            SDL_DestroyTexture(part.imageTextures[k].texture)
            part.imageTextures.remove(k)
        }
    }
    clipPart(r, ref part)
}

// The canvas that a press at x, y reaches, or -1: not under the snackbar, the list of a
// combo box or a dialog.
i64 canvasAt(ref WindowData window, ref list<PartData> parts, f32 x, f32 y) {
    if (snackAt(ref window, x, y)) {
        ret -1
    }
    i64 open = partNumber(ref parts, window.popup)
    if (open >= 0) {
        ret -1
    }
    i64 p = partAt(ref window, ref parts, x, y)
    ret p >= 0 && parts[p].kind == kindCanvas && parts[p].active ? p : -1
}

// The mouse from the top left corner of a canvas.
Mouse canvasMouse(ref PartData part, f32 x, f32 y, i32 button) {
    Mouse m
    m.x = x - part.left
    m.y = y - part.top
    m.button = button
    ret m
}
