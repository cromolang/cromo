// The bar at the top of an app (D450, P42): its title, an icon on the left, as a
// back arrow or a menu, and icons of actions on the right. Put in a window, it
// takes the top of the content, the whole width.
public struct AppBar : Component {
    i64 id

    public AppBar(string title) {
        id = newPart(kindAppBar, title, 0, 0, 0, i32(appBarHeight))
    }

    i64 componentId() const {
        ret id
    }

    public void setTitle(string value) const {
        setPartText(id, value)
    }

    public string title() const {
        ret partText(id, false)
    }

    // The icon on the left, None for none, and what a click on it does.
    public void setNavigation(Icon value) const {
        setPartIcon(id, value)
    }

    public Icon navigation() const {
        ret partIcon(id)
    }

    public void onNavigation(move func() handler) const {
        addr box = alloc(sizeOf<func()>())
        put<func()>(box, move handler)
        addPartHandler(id, 0, box)
    }

    // An icon on the right, the first added on the right edge, and what a click on
    // it does.
    public void addAction(Icon icon, move func() handler) const {
        addr box = alloc(sizeOf<func()>())
        put<func()>(box, move handler)
        i64 me = id
        withData([me, icon, box](ref Shared data) {
            i64 p = partIndexOf(ref data, me)
            data.parts[p].icons.add(icon)
            data.parts[p].actions.add(box)
        })
    }

    public i32 x() const {
        ret partBound(id, 0)
    }

    public i32 y() const {
        ret partBound(id, 1)
    }

    public i32 width() const {
        ret partBound(id, 2)
    }

    public i32 height() const {
        ret partBound(id, 3)
    }

    public void setVisible(bool value) const {
        setPartFlag(id, 0, value)
    }

    public bool visible() const {
        ret partFlag(id, 0)
    }

    public void setEnabled(bool value) const {
        setPartFlag(id, 1, value)
    }

    public bool enabled() const {
        ret partFlag(id, 1)
    }
}

// The bar at the bottom of an app (D450, D451, P42): its items, an icon and a text
// each, choose the page of the app that is shown. A window has one, given by
// Window.navigationBar.
public struct NavigationBar : Component {
    i64 id

    NavigationBar(i64 number) {
        id = number
    }

    i64 componentId() const {
        ret id
    }

    // Adds an item, and gives back its page, with the room between the bars.
    public Panel addPage(string text, Icon icon) const {
        i64 me = id
        i64 made = 0
        withData([me, text, icon, ref made](ref Shared data) {
            i64 p = partIndexOf(ref data, me)
            made = makePart(ref data, kindPanel, "", 0, 0, 0, 0)
            i64 page = partIndexOf(ref data, made)
            data.parts[page].page = data.parts[p].items.len()
            data.parts[page].bar = me
            data.parts[page].window = data.parts[p].window
            data.parts[p].items.add(text)
            data.parts[p].icons.add(icon)
            data.parts[p].pages.add(made)
            arrangeNow(ref data, page)
        })
        Panel page
        page.id = made
        ret page
    }

    // The item chosen, from 0, whose page is shown.
    public void setSelected(i64 index) const {
        i64 me = id
        withData([me, index](ref Shared data) {
            i64 p = partIndexOf(ref data, me)
            if (index < 0 || index >= data.parts[p].items.len()) {
                panic(format("the navigation bar has no item {}", index))
            }
            data.parts[p].selected = index
        })
    }

    public i64 selected() const {
        i64 me = id
        i64 result = 0
        withData([me, ref result](ref Shared data) { result = data.parts[partIndexOf(ref data, me)].selected })
        ret result
    }

    // When the user chooses an item.
    public void onChange(move func(i64) handler) const {
        addr box = alloc(sizeOf<func(i64)>())
        put<func(i64)>(box, move handler)
        addPartHandler(id, 1, box)
    }

    public i32 x() const {
        ret partBound(id, 0)
    }

    public i32 y() const {
        ret partBound(id, 1)
    }

    public i32 width() const {
        ret partBound(id, 2)
    }

    public i32 height() const {
        ret partBound(id, 3)
    }

    public void setVisible(bool value) const {
        setPartFlag(id, 0, value)
    }

    public bool visible() const {
        ret partFlag(id, 0)
    }

    public void setEnabled(bool value) const {
        setPartFlag(id, 1, value)
    }

    public bool enabled() const {
        ret partFlag(id, 1)
    }
}

// A list of items (D461, D462), each a row with an icon, a title, a line under it
// and a text on the right, all optional: only the rows that are seen are drawn,
// and the list scrolls as a panel. The item chosen stays lit; a click, a touch or
// the keys choose an item and call the handlers of onChoose with its index.
public struct ListView : Component {
    i64 id

    public ListView(i32 x, i32 y, i32 width, i32 height) {
        id = newPart(kindListView, "", x, y, width, height)
    }

    i64 componentId() const {
        ret id
    }

    // Icon.None and "" for what the item does not have.
    public void addItem(Icon icon, string title, string subtitle, string detail) const {
        i64 me = id
        withData([me, icon, title, subtitle, detail](ref Shared data) {
            i64 p = partIndexOf(ref data, me)
            data.parts[p].icons.add(icon)
            data.parts[p].items.add(title)
            data.parts[p].subtitles.add(subtitle)
            data.parts[p].details.add(detail)
            addr none
            data.parts[p].images.add(none)
            data.parts[p].textures.add(none)
        })
    }

    // An item before the one at index, or at the end with count(): the item chosen
    // stays the same.
    public void insertItem(i64 index, Icon icon, string title, string subtitle, string detail) const {
        i64 me = id
        withData([me, index, icon, title, subtitle, detail](ref Shared data) {
            i64 p = partIndexOf(ref data, me)
            if (index < 0 || index > data.parts[p].items.len()) {
                panic(format("the list has no place {}", index))
            }
            data.parts[p].icons.insert(index, icon)
            data.parts[p].items.insert(index, title)
            data.parts[p].subtitles.insert(index, subtitle)
            data.parts[p].details.insert(index, detail)
            addr none
            data.parts[p].images.insert(index, none)
            data.parts[p].textures.insert(index, none)
            if (data.parts[p].selected >= index) {
                data.parts[p].selected++
            }
        })
    }

    public void setItem(i64 index, Icon icon, string title, string subtitle, string detail) const {
        i64 me = id
        withData([me, index, icon, title, subtitle, detail](ref Shared data) {
            i64 p = listIndex(ref data, me, index)
            data.parts[p].icons[index] = icon
            data.parts[p].items[index] = title
            data.parts[p].subtitles[index] = subtitle
            data.parts[p].details[index] = detail
        })
    }

    public void removeItem(i64 index) const {
        i64 me = id
        withData([me, index](ref Shared data) {
            i64 p = listIndex(ref data, me, index)
            data.parts[p].icons.remove(index)
            data.parts[p].items.remove(index)
            data.parts[p].subtitles.remove(index)
            data.parts[p].details.remove(index)
            dropImage(ref data.parts[p], index)
            data.parts[p].images.remove(index)
            data.parts[p].textures.remove(index)
            if (data.parts[p].selected == index) {
                data.parts[p].selected = -1
            } else if (data.parts[p].selected > index) {
                data.parts[p].selected--
            }
        })
    }

    public void clear() const {
        i64 me = id
        withData([me](ref Shared data) {
            i64 p = partIndexOf(ref data, me)
            data.parts[p].icons.clear()
            data.parts[p].items.clear()
            data.parts[p].subtitles.clear()
            data.parts[p].details.clear()
            for (i64 i = 0; i < data.parts[p].images.len(); i++) {
                dropImage(ref data.parts[p], i)
            }
            data.parts[p].images.clear()
            data.parts[p].textures.clear()
            data.parts[p].selected = -1
            data.parts[p].offsetY = 0
        })
    }

    public i64 count() const {
        i64 me = id
        i64 result = 0
        withData([me, ref result](ref Shared data) { result = data.parts[partIndexOf(ref data, me)].items.len() })
        ret result
    }

    public string itemTitle(i64 index) const {
        i64 me = id
        string result
        withData([me, index, ref result](ref Shared data) { result = data.parts[listIndex(ref data, me, index)].items[index] })
        ret result
    }

    public string itemSubtitle(i64 index) const {
        i64 me = id
        string result
        withData([me, index, ref result](ref Shared data) { result = data.parts[listIndex(ref data, me, index)].subtitles[index] })
        ret result
    }

    public string itemDetail(i64 index) const {
        i64 me = id
        string result
        withData([me, index, ref result](ref Shared data) { result = data.parts[listIndex(ref data, me, index)].details[index] })
        ret result
    }

    public Icon itemIcon(i64 index) const {
        i64 me = id
        Icon result = Icon.None
        withData([me, index, ref result](ref Shared data) { result = data.parts[listIndex(ref data, me, index)].icons[index] })
        ret result
    }

    // The item chosen, or -1 for none.
    public void setSelected(i64 index) const {
        i64 me = id
        withData([me, index](ref Shared data) {
            i64 p = partIndexOf(ref data, me)
            if (index != -1) {
                listIndex(ref data, me, index)
            }
            data.parts[p].selected = index
        })
    }

    public i64 selected() const {
        i64 me = id
        i64 result = -1
        withData([me, ref result](ref Shared data) { result = data.parts[partIndexOf(ref data, me)].selected })
        ret result
    }

    // When the user chooses an item.
    public void onChoose(move func(i64) handler) const {
        addr box = alloc(sizeOf<func(i64)>())
        put<func(i64)>(box, move handler)
        addPartHandler(id, 1, box)
    }

    // A round image in place of the icon of an item (D469), "" for none: read and
    // decoded by this thread, as that of an image box.
    public void setItemImage(i64 index, string file) const {
        list<u8> bytes
        if (file.len() > 0) {
            bytes = fs.readBytes(file)
        }
        setRoundImage(id, index, file, bytes)
    }

    // An image in memory for the item, as embed() gives it (D470), or none
    // without bytes.
    public void setItemImageBytes(i64 index, list<u8> bytes) const {
        setRoundImage(id, index, "", bytes)
    }

    // Scrolls the list so that the item is seen.
    public void scrollTo(i64 index) const {
        i64 me = id
        withData([me, index](ref Shared data) {
            i64 p = listIndex(ref data, me, index)
            showRow(ref data.parts[p], index)
        })
    }

    public void setPosition(i32 x, i32 y) const {
        setPartBounds(id, x, y, -1, -1)
    }

    public void setSize(i32 width, i32 height) const {
        setPartBounds(id, -1, -1, width, height)
    }

    public i32 x() const {
        ret partBound(id, 0)
    }

    public i32 y() const {
        ret partBound(id, 1)
    }

    public i32 width() const {
        ret partBound(id, 2)
    }

    public i32 height() const {
        ret partBound(id, 3)
    }

    public void setVisible(bool value) const {
        setPartFlag(id, 0, value)
    }

    public bool visible() const {
        ret partFlag(id, 0)
    }

    public void setEnabled(bool value) const {
        setPartFlag(id, 1, value)
    }

    public bool enabled() const {
        ret partFlag(id, 1)
    }

    // How it follows the edges of its window or of its group (D447).
    public void setAnchor(Horizontal horizontal, Vertical vertical) const {
        setPartAnchor(id, horizontal, vertical)
    }

    public Horizontal horizontalAnchor() const {
        ret partHorizontal(id)
    }

    public Vertical verticalAnchor() const {
        ret partVertical(id)
    }
}

