// A card with a title that contains components (D444): their positions are from
// its top left corner, and they move, hide and are disabled with it.
public struct GroupBox : Component {
    i64 id

    public GroupBox(string text, i32 x, i32 y, i32 width, i32 height) {
        id = newPart(kindGroup, text, x, y, width, height)
    }

    i64 componentId() const {
        ret id
    }

    // Puts a component in the group, and gives it back: a component is in one
    // window or in one group only.
    public T add<T : Component>(T component) const {
        addPart(0, id, component.componentId())
        ret component
    }

    public void setText(string value) const {
        setPartText(id, value)
    }

    public string text() const {
        ret partText(id, false)
    }

    public void setPosition(i32 x, i32 y) const {
        setPartBounds(id, x, y, -1, -1)
    }

    public void setSize(i32 width, i32 height) const {
        setPartBounds(id, -1, -1, width, height)
    }

    public i32 x() const {
        ret partBound(id, 0)
    }

    public i32 y() const {
        ret partBound(id, 1)
    }

    public i32 width() const {
        ret partBound(id, 2)
    }

    public i32 height() const {
        ret partBound(id, 3)
    }

    public void setVisible(bool value) const {
        setPartFlag(id, 0, value)
    }

    public bool visible() const {
        ret partFlag(id, 0)
    }

    public void setEnabled(bool value) const {
        setPartFlag(id, 1, value)
    }

    public bool enabled() const {
        ret partFlag(id, 1)
    }

    // How it follows the edges of its window or of its group (D447).
    public void setAnchor(Horizontal horizontal, Vertical vertical) const {
        setPartAnchor(id, horizontal, vertical)
    }

    public Horizontal horizontalAnchor() const {
        ret partHorizontal(id)
    }

    public Vertical verticalAnchor() const {
        ret partVertical(id)
    }
}

// A choice among items (D445): a click, Space or Enter opens the list of its items
// over the other components, and its handlers of onChange receive the index of
// the item that the user chooses. Without a choice it shows its placeholder.
public struct ComboBox : Component {
    i64 id

    public ComboBox(list<string> items, i32 x, i32 y, i32 width, i32 height) {
        id = newPart(kindComboBox, "", x, y, width, height)
        setComboItems(id, items)
    }

    i64 componentId() const {
        ret id
    }

    public void onChange(move func(i64) handler) const {
        addr box = alloc(sizeOf<func(i64)>())
        put<func(i64)>(box, move handler)
        addPartHandler(id, 1, box)
    }

    // The items, and no choice.
    public void setItems(list<string> items) const {
        setComboItems(id, items)
    }

    public list<string> items() const {
        list<string> result
        i64 me = id
        withData([me, ref result](ref Shared data) { result = data.parts[partIndexOf(ref data, me)].items })
        ret result
    }

    public void addItem(string item) const {
        i64 me = id
        withData([me, item](ref Shared data) { data.parts[partIndexOf(ref data, me)].items.add(item) })
    }

    // The index of the item chosen, or -1 for none.
    public void setSelected(i64 index) const {
        i64 me = id
        withData([me, index](ref Shared data) {
            i64 p = partIndexOf(ref data, me)
            if (index < -1 || index >= data.parts[p].items.len()) {
                panic(format("the combo box has no item {}", index))
            }
            data.parts[p].selected = index
        })
    }

    public i64 selected() const {
        i64 me = id
        i64 result = -1
        withData([me, ref result](ref Shared data) { result = data.parts[partIndexOf(ref data, me)].selected })
        ret result
    }

    // The item chosen, or "".
    public string text() const {
        i64 me = id
        string result
        withData([me, ref result](ref Shared data) {
            i64 p = partIndexOf(ref data, me)
            if (data.parts[p].selected >= 0) {
                result = data.parts[p].items[data.parts[p].selected]
            }
        })
        ret result
    }

    // The text shown without a choice.
    public void setPlaceholder(string value) const {
        i64 me = id
        withData([me, value](ref Shared data) { data.parts[partIndexOf(ref data, me)].placeholder = value })
    }

    public string placeholder() const {
        ret partText(id, true)
    }

    public void setPosition(i32 x, i32 y) const {
        setPartBounds(id, x, y, -1, -1)
    }

    public void setSize(i32 width, i32 height) const {
        setPartBounds(id, -1, -1, width, height)
    }

    public i32 x() const {
        ret partBound(id, 0)
    }

    public i32 y() const {
        ret partBound(id, 1)
    }

    public i32 width() const {
        ret partBound(id, 2)
    }

    public i32 height() const {
        ret partBound(id, 3)
    }

    public void setVisible(bool value) const {
        setPartFlag(id, 0, value)
    }

    public bool visible() const {
        ret partFlag(id, 0)
    }

    public void setEnabled(bool value) const {
        setPartFlag(id, 1, value)
    }

    public bool enabled() const {
        ret partFlag(id, 1)
    }

    // How it follows the edges of its window or of its group (D447).
    public void setAnchor(Horizontal horizontal, Vertical vertical) const {
        setPartAnchor(id, horizontal, vertical)
    }

    public Horizontal horizontalAnchor() const {
        ret partHorizontal(id)
    }

    public Vertical verticalAnchor() const {
        ret partVertical(id)
    }
}

// An image in PNG, JPEG, BMP or GIF (D446), from a file or from bytes, fitted to
// its box as its scale says. It is decoded on the thread that sets it, which
// receives the errors.
public struct ImageBox : Component {
    i64 id

    // Throws the errors of reading the file, and an Error if it is not an image.
    public ImageBox(string file, i32 x, i32 y, i32 width, i32 height) {
        id = newPart(kindImageBox, "", x, y, width, height)
        loadImage(id, file)
    }

    i64 componentId() const {
        ret id
    }

    // The image of a file, or none with "".
    public void setFile(string path) const {
        loadImage(id, path)
    }

    public string file() const {
        ret partText(id, false)
    }

    // An image in memory, or none without bytes.
    public void setBytes(list<u8> bytes) const {
        setImage(id, "", bytes)
    }

    // The size of the image, in pixels.
    public i32 imageWidth() const {
        ret partBound(id, 4)
    }

    public i32 imageHeight() const {
        ret partBound(id, 5)
    }

    public void setScale(Scale value) const {
        i64 me = id
        withData([me, value](ref Shared data) { data.parts[partIndexOf(ref data, me)].scale = value })
    }

    public Scale scale() const {
        i64 me = id
        Scale result = Scale.Fit
        withData([me, ref result](ref Shared data) { result = data.parts[partIndexOf(ref data, me)].scale })
        ret result
    }

    public void setPosition(i32 x, i32 y) const {
        setPartBounds(id, x, y, -1, -1)
    }

    public void setSize(i32 width, i32 height) const {
        setPartBounds(id, -1, -1, width, height)
    }

    public i32 x() const {
        ret partBound(id, 0)
    }

    public i32 y() const {
        ret partBound(id, 1)
    }

    public i32 width() const {
        ret partBound(id, 2)
    }

    public i32 height() const {
        ret partBound(id, 3)
    }

    public void setVisible(bool value) const {
        setPartFlag(id, 0, value)
    }

    public bool visible() const {
        ret partFlag(id, 0)
    }

    public void setEnabled(bool value) const {
        setPartFlag(id, 1, value)
    }

    public bool enabled() const {
        ret partFlag(id, 1)
    }

    // How it follows the edges of its window or of its group (D447).
    public void setAnchor(Horizontal horizontal, Vertical vertical) const {
        setPartAnchor(id, horizontal, vertical)
    }

    public Horizontal horizontalAnchor() const {
        ret partHorizontal(id)
    }

    public Vertical verticalAnchor() const {
        ret partVertical(id)
    }
}

// ---- The data of the windows and of the components ----

struct Rect {
    f32 x
    f32 y
    f32 w
    f32 h

    Rect(f32 left, f32 top, f32 width, f32 height) {
        x = left
        y = top
        w = width
        h = height
    }
}

// What a window has: what the program asks, and what only the thread of the GUI
// uses. The handlers are in boxes on the heap, which never move: the thread of
// the GUI calls them without the lock.
struct WindowData {
    i64 id
    string title
    i32 width  // of the whole window, in logical pixels
    i32 height
    bool resizable = true
    i32 show  // what is asked: 0 normal, 1 minimized, 2 maximized
    Theme theme
    i32 fps = 60
    bool started
    bool closing
    bool notified  // its handlers of onClose are called
    bool closed    // after them
    bool titleChanged
    bool sizeChanged
    bool resizableChanged
    bool showChanged
    list<addr> mouseMove
    list<addr> mouseDown
    list<addr> mouseUp
    list<addr> keyDown
    list<addr> resize
    list<addr> close

    // The thread of the GUI.
    addr window
    addr renderer
    addr chrome
    addr font    // of the title
    addr body    // of the components
    addr strong  // of the buttons, semibold
    u32 sdlId
    f32 density = 1
    i32 hovered = -1  // the button of the title bar under the mouse
    i32 pressed = -1
    bool focused = true
    bool maximized
    bool minimized
    i64 focus     // the component with the keyboard, or 0
    i64 hot       // the component under the mouse
    i64 held      // the component pressed with the mouse
    i64 dragging  // the text box whose text the mouse selects
    i64 popup     // the combo box whose list is open
    u64 caretStart
    list<i64> order  // the indices of its components, in the order they are drawn
}

const i32 kindLabel = 1
const i32 kindButton = 2
const i32 kindTextBox = 3
const i32 kindCheckBox = 4
const i32 kindGroup = 5
const i32 kindComboBox = 6
const i32 kindImageBox = 7

// A component: its kind, its window and its group once added, its properties, for
// a text box where its cursor and the other end of its selection are, as indices
// of bytes, and how much its text is scrolled, the items of a combo box and the
// image of an image box.
struct PartData {
    i64 id
    i64 window
    i64 parent  // its group, or 0
    i32 kind
    string text  // the file of an image box
    string placeholder
    i32 x  // now, from the top left corner of its parent (P40)
    i32 y
    i32 width
    i32 height
    Horizontal horizontal
    Vertical vertical
    i32 baseX  // as set last, when its parent had the size below (P40)
    i32 baseY
    i32 baseWidth
    i32 baseHeight
    i32 parentWidth
    i32 parentHeight
    bool visible = true
    bool enabled = true
    bool checked
    i64 caret
    i64 anchor
    f32 scroll
    list<string> items
    i64 selected = -1
    i64 first      // the first item shown in the list
    i64 highlight  // the item that the mouse or the keys point at in the list
    addr pixels    // of an image, until the thread of the GUI makes its texture
    i32 imageWidth
    i32 imageHeight
    bool imageChanged
    Scale scale
    addr texture
    list<addr> click   // func()
    list<addr> change  // func(string) of a text box, func(bool) of a check box, func(i64) of a combo box
    list<addr> enter   // func(string)

    // Laid out by the thread of the GUI: its place in the content of the window,
    // whether it and its groups are visible and enabled, and the rectangle of
    // its groups that clips it.
    f32 left
    f32 top
    bool shown
    bool active
    f32 clipLeft
    f32 clipTop
    f32 clipRight
    f32 clipBottom
}

struct Shared {
    list<WindowData> windows
    list<PartData> parts
    i64 next
    bool running  // the thread of the GUI
}

u64 lock          // of the data of all the windows
addr shared       // Shared, from the first window
addr guiThread    // the thread of the GUI, in the runtime
addr guardThread  // the thread that waits for it (D437)
addr arrow        // the cursors of the mouse, made by the thread of the GUI
addr beam
i32[4] clip  // the SDL_Rect of SDL_SetRenderClipRect

// The data under the lock, as a Mutex (D216).
void withData(func(ref Shared) body) {
    mutexLock(variableAddress(lock))
    addr none
    if (shared == none) {
        shared = alloc(sizeOf<Shared>())
        Shared fresh
        put<Shared>(shared, move fresh)
    }
    Shared data = take<Shared>(shared)
    try {
        body(ref data)
    } finally {
        put<Shared>(shared, move data)
        mutexUnlock(variableAddress(lock))
    }
}

i64 indexOf(ref Shared data, i64 id) {
    for (i64 i = 0; i < data.windows.len(); i++) {
        if (data.windows[i].id == id) {
            ret i
        }
    }
    panic("the window does not exist")
}

i64 partIndexOf(ref Shared data, i64 id) {
    for (i64 i = 0; i < data.parts.len(); i++) {
        if (data.parts[i].id == id) {
            ret i
        }
    }
    panic("the component does not exist")
}

i64 newPart(i32 kind, string text, i32 x, i32 y, i32 w, i32 h) {
    i64 made = 0
    withData([ref made, kind, text, x, y, w, h](ref Shared data) {
        data.next++
        PartData part
        part.id = data.next
        part.kind = kind
        part.text = text
        part.x = x
        part.y = y
        part.width = w
        part.height = h
        part.baseX = x
        part.baseY = y
        part.baseWidth = w
        part.baseHeight = h
        part.caret = text.len()
        part.anchor = part.caret
        data.parts.add(move part)
        made = data.next
    })
    ret made
}

void setPartText(i64 id, string value) {
    withData([id, value](ref Shared data) {
        i64 p = partIndexOf(ref data, id)
        data.parts[p].text = value
        data.parts[p].caret = value.len()
        data.parts[p].anchor = value.len()
    })
}

string partText(i64 id, bool placeholder) {
    string result
    withData([id, placeholder, ref result](ref Shared data) {
        i64 p = partIndexOf(ref data, id)
        result = placeholder ? data.parts[p].placeholder : data.parts[p].text
    })
    ret result
}

// A negative value leaves that one as it is.
void setPartBounds(i64 id, i32 x, i32 y, i32 w, i32 h) {
    withData([id, x, y, w, h](ref Shared data) {
        i64 p = partIndexOf(ref data, id)
        arrangeNow(ref data, p)
        if (x >= 0 || y >= 0) {
            data.parts[p].x = x
            data.parts[p].y = y
        }
        if (w >= 0 || h >= 0) {
            data.parts[p].width = w
            data.parts[p].height = h
        }
        rebase(ref data, p)
    })
}

// 0 x, 1 y, 2 width, 3 height, 4 and 5 the width and the height of an image.
i32 partBound(i64 id, i32 which) {
    i32 result = 0
    withData([id, which, ref result](ref Shared data) {
        i64 p = partIndexOf(ref data, id)
        arrangeNow(ref data, p)
        if (which == 0) {
            result = data.parts[p].x
        } else if (which == 1) {
            result = data.parts[p].y
        } else if (which == 2) {
            result = data.parts[p].width
        } else if (which == 3) {
            result = data.parts[p].height
        } else if (which == 4) {
            result = data.parts[p].imageWidth
        } else {
            result = data.parts[p].imageHeight
        }
    })
    ret result
}

// 0 visible, 1 enabled, 2 checked.
void setPartFlag(i64 id, i32 which, bool value) {
    withData([id, which, value](ref Shared data) {
        i64 p = partIndexOf(ref data, id)
        if (which == 0) {
            data.parts[p].visible = value
        } else if (which == 1) {
            data.parts[p].enabled = value
        } else {
            data.parts[p].checked = value
        }
    })
}

bool partFlag(i64 id, i32 which) {
    bool result = false
    withData([id, which, ref result](ref Shared data) {
        i64 p = partIndexOf(ref data, id)
        result = which == 0 ? data.parts[p].visible : which == 1 ? data.parts[p].enabled : data.parts[p].checked
    })
    ret result
}

// 0 click, 1 change, 2 enter.
void addPartHandler(i64 id, i32 which, addr box) {
    withData([id, which, box](ref Shared data) {
        i64 p = partIndexOf(ref data, id)
        if (which == 0) {
            data.parts[p].click.add(box)
        } else if (which == 1) {
            data.parts[p].change.add(box)
        } else {
            data.parts[p].enter.add(box)
        }
    })
}

// Puts a component in a window, or in a group with window 0.
void addPart(i64 window, i64 group, i64 part) {
    withData([window, group, part](ref Shared data) {
        i64 p = partIndexOf(ref data, part)
        if (data.parts[p].window != 0 || data.parts[p].parent != 0) {
            panic("the component is already in a window or in a group")
        }
        i64 into = window
        if (group != 0) {
            for (i64 up = group; up != 0; up = data.parts[partIndexOf(ref data, up)].parent) {
                if (up == part) {
                    panic("a group cannot contain itself")
                }
            }
            into = data.parts[partIndexOf(ref data, group)].window
            data.parts[p].parent = group
        } else {
            indexOf(ref data, window)
        }
        data.parts[p].window = into
        if (into != 0) {
            placeIn(ref data.parts, part, into)
        }
        rebase(ref data, p)
    })
}

// The components inside a group go in the window of the group.
void placeIn(ref list<PartData> parts, i64 group, i64 window) {
    for (i64 i = 0; i < parts.len(); i++) {
        if (parts[i].parent == group) {
            parts[i].window = window
            placeIn(ref parts, parts[i].id, window)
        }
    }
}

// The position and the size of a component now, for the size of its parent now
// (P40): what the thread of the GUI computes when it draws.
void arrangeNow(ref Shared data, i64 p) {
    i64 group = data.parts[p].parent
    if (group != 0) {
        i64 g = partIndexOf(ref data, group)
        arrangeNow(ref data, g)
        arrange(ref data.parts[p], data.parts[g].width, data.parts[g].height)
    } else if (data.parts[p].window != 0) {
        i64 i = indexOf(ref data, data.parts[p].window)
        arrange(ref data.parts[p], data.windows[i].width, data.windows[i].height - i32(barHeight))
    }
}

// The distances that the anchors keep are those of now (P40).
void rebase(ref Shared data, i64 p) {
    i32 w = 0
    i32 h = 0
    i64 group = data.parts[p].parent
    if (group != 0) {
        i64 g = partIndexOf(ref data, group)
        arrangeNow(ref data, g)
        w = data.parts[g].width
        h = data.parts[g].height
    } else if (data.parts[p].window != 0) {
        i64 i = indexOf(ref data, data.parts[p].window)
        w = data.windows[i].width
        h = data.windows[i].height - i32(barHeight)
    }
    data.parts[p].baseX = data.parts[p].x
    data.parts[p].baseY = data.parts[p].y
    data.parts[p].baseWidth = data.parts[p].width
    data.parts[p].baseHeight = data.parts[p].height
    data.parts[p].parentWidth = w
    data.parts[p].parentHeight = h
}

void setPartAnchor(i64 id, Horizontal horizontal, Vertical vertical) {
    withData([id, horizontal, vertical](ref Shared data) {
        i64 p = partIndexOf(ref data, id)
        arrangeNow(ref data, p)
        data.parts[p].horizontal = horizontal
        data.parts[p].vertical = vertical
        rebase(ref data, p)
    })
}

Horizontal partHorizontal(i64 id) {
    Horizontal result = Horizontal.Left
    withData([id, ref result](ref Shared data) { result = data.parts[partIndexOf(ref data, id)].horizontal })
    ret result
}

Vertical partVertical(i64 id) {
    Vertical result = Vertical.Top
    withData([id, ref result](ref Shared data) { result = data.parts[partIndexOf(ref data, id)].vertical })
    ret result
}

void setComboItems(i64 id, list<string> items) {
    withData([id, items](ref Shared data) {
        i64 p = partIndexOf(ref data, id)
        data.parts[p].items = items
        data.parts[p].selected = -1
        data.parts[p].first = 0
        data.parts[p].highlight = 0
    })
}

void loadImage(i64 id, string path) {
    list<u8> bytes
    if (path.len() > 0) {
        bytes = fs.readBytes(path)
        if (bytes.len() == 0) {
            throw Error(format("cannot read the image {}: the file is empty", path))
        }
    }
    setImage(id, path, bytes)
}

// Decodes an image on this thread, and gives its pixels to the thread of the GUI,
// which makes its texture.
void setImage(i64 id, string file, list<u8> bytes) {
    addr none
    addr pixels
    i32 w = 0
    i32 h = 0
    if (bytes.len() > 0) {
        addr data = alloc(bytes.len())
        for (i64 i = 0; i < bytes.len(); i++) {
            put<u8>(offset(data, i), bytes[i])
        }
        addr reason = alloc(128)
        pixels = cromo_gui_image_decode(data, bytes.len(), ref w, ref h, reason, 128)
        list<u8> why = cText(reason).bytes()
        free(reason)
        if (why.len() > 0) {
            why[0] = lowerByte(why[0])  // stb_image starts with a capital
        }
        free(data)
        if (pixels == none) {
            string what = file.len() > 0 ? format("the image {}", file) : "the image"
            throw Error(format("cannot read {}: {}", what, string(why)))
        }
    }
    withData([id, file, pixels, w, h](ref Shared data) {
        i64 p = partIndexOf(ref data, id)
        addr none
        if (data.parts[p].pixels != none) {
            cromo_gui_image_free(data.parts[p].pixels)
        }
        data.parts[p].text = file
        data.parts[p].pixels = pixels
        data.parts[p].imageWidth = w
        data.parts[p].imageHeight = h
        data.parts[p].imageChanged = true
    })
}

// ---- The window ----

// A window (D430, D442): made with its title and its size in logical pixels,
// shown by start(). It is a handle: its copies name the same window, and a lambda
// captures it by copy. The program ends when its windows are closed.
public struct Window {
    i64 id

    public Window(string text, i32 w, i32 h) {
        i64 made = 0
        withData([ref made, text, w, h](ref Shared data) {
            data.next++
            WindowData window
            window.id = data.next
            window.title = text
            window.width = w
            window.height = h
            data.windows.add(move window)
            made = data.next
        })
        id = made
    }

    // Puts a component in the window, and gives it back (D434): a component is in
    // one window or in one group only.
    public T add<T : Component>(T component) const {
        addPart(id, 0, component.componentId())
        ret component
    }

    public void setTitle(string text) const {
        i64 me = id
        withData([me, text](ref Shared data) {
            i64 i = indexOf(ref data, me)
            data.windows[i].title = text
            data.windows[i].titleChanged = true
        })
    }

    public string title() const {
        i64 me = id
        string result
        withData([me, ref result](ref Shared data) { result = data.windows[indexOf(ref data, me)].title })
        ret result
    }

    // The size of the whole window, with its title bar, in logical pixels.
    public void setSize(i32 w, i32 h) const {
        i64 me = id
        withData([me, w, h](ref Shared data) {
            i64 i = indexOf(ref data, me)
            data.windows[i].width = w
            data.windows[i].height = h
            data.windows[i].sizeChanged = true
        })
    }

    public i32 width() const {
        i64 me = id
        i32 result = 0
        withData([me, ref result](ref Shared data) { result = data.windows[indexOf(ref data, me)].width })
        ret result
    }

    public i32 height() const {
        i64 me = id
        i32 result = 0
        withData([me, ref result](ref Shared data) { result = data.windows[indexOf(ref data, me)].height })
        ret result
    }

    // Whether the edges resize the window, and the button maximizes it.
    public void setResizable(bool value) const {
        i64 me = id
        withData([me, value](ref Shared data) {
            i64 i = indexOf(ref data, me)
            data.windows[i].resizable = value
            data.windows[i].resizableChanged = true
        })
    }

    public bool resizable() const {
        i64 me = id
        bool result = false
        withData([me, ref result](ref Shared data) { result = data.windows[indexOf(ref data, me)].resizable })
        ret result
    }

    // Before start(), the window starts so.
    public void minimize() const {
        showAs(1)
    }

    public void maximize() const {
        showAs(2)
    }

    public void restore() const {
        showAs(0)
    }

    public bool minimized() const {
        i64 me = id
        bool result = false
        withData([me, ref result](ref Shared data) {
            i64 i = indexOf(ref data, me)
            result = data.windows[i].window == addr(0) ? data.windows[i].show == 1 : data.windows[i].minimized
        })
        ret result
    }

    public bool maximized() const {
        i64 me = id
        bool result = false
        withData([me, ref result](ref Shared data) {
            i64 i = indexOf(ref data, me)
            result = data.windows[i].window == addr(0) ? data.windows[i].show == 2 : data.windows[i].maximized
        })
        ret result
    }

    public void setTheme(Theme value) const {
        i64 me = id
        withData([me, value](ref Shared data) { data.windows[indexOf(ref data, me)].theme = value })
    }

    public Theme theme() const {
        i64 me = id
        Theme result = Theme.System
        withData([me, ref result](ref Shared data) { result = data.windows[indexOf(ref data, me)].theme })
        ret result
    }

    // The frames that are drawn each second, from 1 to 240: 60 by default.
    public void setFps(i32 value) const {
        if (value < 1 || value > 240) {
            panic(format("the frames per second are from 1 to 240, found {}", value))
        }
        i64 me = id
        withData([me, value](ref Shared data) { data.windows[indexOf(ref data, me)].fps = value })
    }

    public i32 fps() const {
        i64 me = id
        i32 result = 0
        withData([me, ref result](ref Shared data) { result = data.windows[indexOf(ref data, me)].fps })
        ret result
    }

    // Shows the window and returns: the thread of the GUI draws it (D436).
    public void start() const {
        i64 me = id
        withData([me](ref Shared data) {
            i64 i = indexOf(ref data, me)
            if (data.windows[i].started) {
                panic("the window is already started")
            }
            data.windows[i].started = true
            if (!data.running) {
                data.running = true
                guiThread = threadStart([]() { run() })
                guardThread = threadStart([]() { watch() })
                cromo_gui_wait_at_end()
            }
        })
    }

    // Closes the window; it can also be closed with its button.
    public void close() const {
        i64 me = id
        withData([me](ref Shared data) { data.windows[indexOf(ref data, me)].closing = true })
    }

    public bool closed() const {
        i64 me = id
        bool result = false
        withData([me, ref result](ref Shared data) { result = isClosed(ref data.windows[indexOf(ref data, me)]) })
        ret result
    }

    // Waits until the window is closed (D436).
    public void wait() const {
        for (!closed()) {
            time.msleep(10)
        }
    }

    // ---- The events: the lambdas run on the thread of the GUI (D435) ----

    public void onMouseMove(move func(Mouse) handler) const {
        addr box = alloc(sizeOf<func(Mouse)>())
        put<func(Mouse)>(box, move handler)
        i64 me = id
        withData([me, box](ref Shared data) { data.windows[indexOf(ref data, me)].mouseMove.add(box) })
    }

    public void onMouseDown(move func(Mouse) handler) const {
        addr box = alloc(sizeOf<func(Mouse)>())
        put<func(Mouse)>(box, move handler)
        i64 me = id
        withData([me, box](ref Shared data) { data.windows[indexOf(ref data, me)].mouseDown.add(box) })
    }

    public void onMouseUp(move func(Mouse) handler) const {
        addr box = alloc(sizeOf<func(Mouse)>())
        put<func(Mouse)>(box, move handler)
        i64 me = id
        withData([me, box](ref Shared data) { data.windows[indexOf(ref data, me)].mouseUp.add(box) })
    }

    // The keys that the component in focus does not use.
    public void onKeyDown(move func(Key) handler) const {
        addr box = alloc(sizeOf<func(Key)>())
        put<func(Key)>(box, move handler)
        i64 me = id
        withData([me, box](ref Shared data) { data.windows[indexOf(ref data, me)].keyDown.add(box) })
    }

    // The new size of the whole window, in logical pixels.
    public void onResize(move func(i32, i32) handler) const {
        addr box = alloc(sizeOf<func(i32, i32)>())
        put<func(i32, i32)>(box, move handler)
        i64 me = id
        withData([me, box](ref Shared data) { data.windows[indexOf(ref data, me)].resize.add(box) })
    }

    // After the window is closed.
    public void onClose(move func() handler) const {
        addr box = alloc(sizeOf<func()>())
        put<func()>(box, move handler)
        i64 me = id
        withData([me, box](ref Shared data) { data.windows[indexOf(ref data, me)].close.add(box) })
    }

    void showAs(i32 state) const {
        i64 me = id
        withData([me, state](ref Shared data) {
            i64 i = indexOf(ref data, me)
            data.windows[i].show = state
            data.windows[i].showChanged = true
        })
    }
}

bool isClosed(ref WindowData window) {
    ret window.closed || (window.closing && !window.started)
}

// ---- The end of main (D442) and the exceptions of the handlers (D437) ----

// When main returns, the program waits for its windows. It reads only the data
// under the lock: a failure there is a panic, since C has no exceptions (D395).
[[export("cromo_gui_finish")]]
void finish() {
    try {
        for (openWindows() > 0) {
            time.msleep(10)
        }
    } catch (Exception e) {
        panic(e.message())
    }
}

i64 openWindows() {
    i64 count = 0
    withData([ref count](ref Shared data) {
        for (ref WindowData window in data.windows) {
            if (window.started && !isClosed(ref window)) {
                count++
            }
        }
    })
    ret count
}

// An exception that leaves a handler ends the thread of the GUI: this thread stops
// the program with it, as for a thread that no join() takes (D217).
void watch() {
    if (threadWait(guiThread)) {
        threadUncaught(guiThread)
    }
}

// ---- The thread of the GUI ----

const f32 barHeight = 35
const f32 buttonWidth = 46
const f32 edgeWidth = 6
const f32 titleSize = 12
const f32 bodySize = 14  // text-sm
const f32 padding = 8    // of the text in a text box and in a combo box
const f32 checkSide = 16
const f32 corner = 7       // of the buttons, the text boxes and the combo boxes
const f32 checkCorner = 4  // of the check boxes
const f32 groupCorner = 8
const f32 itemHeight = 26  // of the list of a combo box
const i64 listRows = 8

// The colors of the look (D443): the grays and the indigo of Tailwind, light and
// dark, with buttons in a gradient and a border of a deeper color.
struct Colors {
    u32 bar
    u32 separator
    u32 title
    u32 inactive
    u32 content
    u32 border
    u32 hover
    u32 pressed
    u32 text
    u32 label
    u32 muted
    u32 buttonTop
    u32 buttonBottom
    u32 hoverTop
    u32 hoverBottom
    u32 buttonLine
    u32 buttonText
    u32 highlight  // 0xAARRGGBB, a line of light inside the top of a button
    u32 input
    u32 inputBorder
    u32 check
    u32 checkBorder
    u32 focus
    u32 selection
    u32 shadow       // 0xAARRGGBB, under the buttons
    u32 inputShadow  // under the text boxes, the check boxes and the groups
    u32 glow         // around the text box in focus
    u32 card         // of the groups
    u32 cardBorder
    u32 item        // under the item that the mouse or the keys point at
    u32 listShadow  // 0xAARRGGBB, under the list of a combo box
}

Colors colorsOf(bool dark) {
    Colors c
    c.buttonTop = 0x6366F1     // indigo-500
    c.buttonBottom = 0x4F46E5  // indigo-600
    c.hoverTop = 0x818CF8      // indigo-400
    c.hoverBottom = 0x6366F1
    c.buttonLine = 0x4338CA  // indigo-700
    c.buttonText = 0xFFFFFF
    c.focus = 0x6366F1
    if (dark) {
        c.bar = 0x111827        // gray-900
        c.separator = 0x1F2937  // gray-800
        c.title = 0xD1D5DB      // gray-300
        c.inactive = 0x6B7280   // gray-500
        c.content = 0x111827
        c.border = 0x1F2937
        c.hover = 0x1F2937
        c.pressed = 0x374151  // gray-700
        c.text = 0xF3F4F6     // gray-100
        c.label = 0xD1D5DB
        c.muted = 0x6B7280
        c.highlight = 0x33FFFFFF
        c.input = 0x1D2331  // white/5 on gray-900
        c.inputBorder = 0x374151
        c.check = 0x1D2331
        c.checkBorder = 0x4B5563  // gray-600
        c.selection = 0x3730A3    // indigo-800
        c.shadow = 0x73000000
        c.inputShadow = 0x40000000
        c.glow = 0x596366F1
        c.card = 0x161E2D
        c.cardBorder = 0x273244
        c.item = 0x2B2F5E
        c.listShadow = 0x99000000
    } else {
        c.bar = 0xFFFFFF
        c.separator = 0xE5E7EB  // gray-200
        c.title = 0x374151      // gray-700
        c.inactive = 0x9CA3AF   // gray-400
        c.content = 0xF3F4F6    // gray-100
        c.border = 0xE5E7EB
        c.hover = 0xF3F4F6
        c.pressed = 0xE5E7EB
        c.text = 0x111827  // gray-900
        c.label = 0x374151
        c.muted = 0x9CA3AF
        c.highlight = 0x40FFFFFF
        c.input = 0xFFFFFF
        c.inputBorder = 0xD1D5DB  // gray-300
        c.check = 0xFFFFFF
        c.checkBorder = 0xC9CDD4
        c.selection = 0xC7D2FE  // indigo-200
        c.shadow = 0x30111827
        c.inputShadow = 0x14111827
        c.glow = 0x406366F1
        c.card = 0xFFFFFF
        c.cardBorder = 0xE5E7EB
        c.item = 0xEEF2FF  // indigo-50
        c.listShadow = 0x2E111827
    }
    ret c
}

const u32 closeHover = 0xDC2626    // red-600
const u32 closePressed = 0xB91C1C  // red-700

u8 red(u32 rgb) {
    ret u8((rgb >> 16) & 0xFF)
}

u8 green(u32 rgb) {
    ret u8((rgb >> 8) & 0xFF)
}

u8 blue(u32 rgb) {
    ret u8(rgb & 0xFF)
}

// A color of the boxes of C, 0xAARRGGBB: opaque, or half for a component disabled.
u32 solid(u32 rgb, bool enabled) {
    ret enabled ? (0xFF000000 | rgb) : (0x80000000 | rgb)
}

void fill(addr renderer, u32 rgb, f32 x, f32 y, f32 w, f32 h) {
    SDL_SetRenderDrawColor(renderer, red(rgb), green(rgb), blue(rgb), 255)
    Rect area = Rect(x, y, w, h)
    SDL_RenderFillRect(renderer, ref area)
}

void text(addr font, string s, f32 x, f32 y, u32 rgb, bool enabled) {
    cromo_gui_text(font, s.cstring(), s.len(), x, y, red(rgb), green(rgb), blue(rgb), enabled ? 255 : 128)
}

f32 textWidth(addr font, string s, i64 bytes) {
    ret cromo_gui_text_width(font, s.cstring(), bytes)
}

// Drawing only inside a rectangle, in logical pixels.
void clipTo(addr renderer, f32 x, f32 y, f32 w, f32 h) {
    clip[0] = i32(x)
    clip[1] = i32(y)
    clip[2] = i32(w)
    clip[3] = i32(h)
    SDL_SetRenderClipRect(renderer, variableAddress(clip))
}

// Drawing only inside the groups of a component.
void clipPart(addr renderer, ref PartData part) {
    clipTo(renderer, part.clipLeft, barHeight + part.clipTop, part.clipRight - part.clipLeft, part.clipBottom - part.clipTop)
}

// Drawing only inside a rectangle, and inside the groups of a component.
void clipInside(addr renderer, ref PartData part, f32 x, f32 y, f32 w, f32 h) {
    f32 left = most(x, part.clipLeft)
    f32 top = most(y, barHeight + part.clipTop)
    f32 right = least(x + w, part.clipRight)
    f32 bottom = least(y + h, barHeight + part.clipBottom)
    clipTo(renderer, left, top, most(right - left, 0), most(bottom - top, 0))
}

f32 least(f32 a, f32 b) {
    ret a < b ? a : b
}

f32 most(f32 a, f32 b) {
    ret a > b ? a : b
}

// A string of C, ended by a zero.
string cText(addr text) {
    i64 n = 0
    for (take<u8>(offset(text, n)) != 0) {
        n++
    }
    ret string(text, n)
}

void run() {
    if (!SDL_Init(0x20)) {  // SDL_INIT_VIDEO
        panic(format("cannot start the windows: {}", cText(SDL_GetError())))
    }
    arrow = SDL_CreateSystemCursor(0)  // SDL_SYSTEM_CURSOR_DEFAULT
    beam = SDL_CreateSystemCursor(1)   // SDL_SYSTEM_CURSOR_TEXT
    addr event = alloc(128)            // SDL_Event, a union of 128 bytes
    for (true) {
        u64 start = SDL_GetTicksNS()
        i32 fps = prepare()
        for (SDL_PollEvent(event)) {
            handle(event)
        }
        draw()
        u64 frame = 20000000  // without windows, 50 times a second
        if (fps > 0) {
            frame = 1000000000 / u64(fps)
        }
        u64 spent = SDL_GetTicksNS() - start
        if (spent < frame) {
            SDL_DelayPrecise(frame - spent)
        }
    }
}

// Opens the windows started, gives to SDL what the program changed, and closes
// the windows closed. A window is closed for the program after its handlers of
// onClose: if one throws, the program stops before (D437). The frames per second
// are the most among the windows open, or 0 without windows.
i32 prepare() {
    i32 fps = 0
    list<addr> handlers
    list<i64> ended
    withData([ref fps, ref handlers, ref ended](ref Shared data) {
        for (ref WindowData window in data.windows) {
            addr none
            if (window.started && window.window == none && !window.closing) {
                open(ref window)
            }
            if (window.closing && window.started && !window.notified) {
                if (window.window != none) {
                    freeTextures(ref window, ref data.parts)
                    shut(ref window)
                }
                window.notified = true
                for (addr box in window.close) {
                    handlers.add(box)
                }
                ended.add(window.id)
                continue
            }
            if (window.window == none) {
                continue
            }
            apply(ref window)
            if (window.fps > fps) {
                fps = window.fps
            }
        }
    })
    for (addr box in handlers) {
        func() handler = take<func()>(box)
        try {
            handler()
        } finally {
            put<func()>(box, move handler)
        }
    }
    if (ended.len() > 0) {
        withData([ended](ref Shared data) {
            for (i64 id in ended) {
                data.windows[indexOf(ref data, id)].closed = true
            }
        })
    }
    ret fps
}

// From logical pixels to the coordinates of the window, which are pixels on
// Windows and on X11, and logical pixels on Wayland.
f32 toWindow(ref WindowData window) {
    f32 density = SDL_GetWindowPixelDensity(window.window)
    if (density <= 0) {
        ret 1
    }
    ret window.density / density
}

void open(ref WindowData window) {
    f32 scale = SDL_GetDisplayContentScale(SDL_GetPrimaryDisplay())
    if (scale <= 0) {
        scale = 1
    }
    u64 flags = 0x10 | 0x2000  // SDL_WINDOW_BORDERLESS, SDL_WINDOW_HIGH_PIXEL_DENSITY
    if (window.resizable) {
        flags = flags | 0x20
    }
    if (window.show == 1) {
        flags = flags | 0x40
    } else if (window.show == 2) {
        flags = flags | 0x80
    }
    window.window = SDL_CreateWindow(window.title.cstring(), i32(f32(window.width) * scale), i32(f32(window.height) * scale), flags)
    addr none
    if (window.window == none) {
        panic(format("cannot open the window: {}", cText(SDL_GetError())))
    }
    window.renderer = SDL_CreateRenderer(window.window, none)
    if (window.renderer == none) {
        panic(format("cannot draw in the window: {}", cText(SDL_GetError())))
    }
    SDL_SetRenderDrawBlendMode(window.renderer, 1)  // SDL_BLENDMODE_BLEND
    window.sdlId = SDL_GetWindowID(window.window)
    window.chrome = cromo_gui_chrome(window.window)
    setDensity(ref window)
    window.titleChanged = false
    window.sizeChanged = false
    window.resizableChanged = false
    window.showChanged = false
}

// The scale of the display: the renderer draws in logical pixels, and the fonts
// are rasterized for the pixels of the display.
void setDensity(ref WindowData window) {
    f32 density = SDL_GetWindowDisplayScale(window.window)
    if (density <= 0) {
        density = 1
    }
    window.density = density
    SDL_SetRenderScale(window.renderer, density, density)
    addr none
    if (window.font != none) {
        cromo_gui_font_free(window.font)
        cromo_gui_font_free(window.body)
        cromo_gui_font_free(window.strong)
    }
    window.font = cromo_gui_font(window.renderer, 0, titleSize, density)
    window.body = cromo_gui_font(window.renderer, 0, bodySize, density)
    window.strong = cromo_gui_font(window.renderer, 1, bodySize, density)
}

void apply(ref WindowData window) {
    if (window.titleChanged) {
        SDL_SetWindowTitle(window.window, window.title.cstring())
        window.titleChanged = false
    }
    if (window.sizeChanged) {
        f32 scale = toWindow(ref window)
        SDL_SetWindowSize(window.window, i32(f32(window.width) * scale), i32(f32(window.height) * scale))
        window.sizeChanged = false
    }
    if (window.resizableChanged) {
        SDL_SetWindowResizable(window.window, window.resizable)
        window.resizableChanged = false
    }
    if (window.showChanged) {
        if (window.show == 1) {
            SDL_MinimizeWindow(window.window)
        } else if (window.show == 2) {
            SDL_MaximizeWindow(window.window)
        } else {
            SDL_RestoreWindow(window.window)
        }
        window.showChanged = false
    }
}

// The textures of the images of a window, before its renderer is destroyed.
void freeTextures(ref WindowData window, ref list<PartData> parts) {
    addr none
    for (ref PartData part in parts) {
        if (part.window == window.id && part.texture != none) {
            SDL_DestroyTexture(part.texture)
            part.texture = none
        }
    }
}

void shut(ref WindowData window) {
    addr none
    cromo_gui_font_free(window.font)
    cromo_gui_font_free(window.body)
    cromo_gui_font_free(window.strong)
    window.font = none
    window.body = none
    window.strong = none
    cromo_gui_symbols_free(window.renderer)
    cromo_gui_boxes_free(window.renderer)
    SDL_DestroyRenderer(window.renderer)
    SDL_DestroyWindow(window.window)
    cromo_gui_chrome_free(window.chrome)
    window.window = none
    window.renderer = none
}

// The button of the title bar at a point: 0 minimize, 1 maximize, 2 close, or -1.
i32 buttonAt(f32 x, f32 y, f32 width) {
    f32 start = width - 3 * buttonWidth
    if (y < 0 || y >= barHeight || x < start || x >= width) {
        ret -1
    }
    ret i32((x - start) / buttonWidth)
}

// A call of handlers, made under the lock and run after it.
struct Call {
    i32 kind  // 1 mouse move, 2 mouse down, 3 mouse up, 4 key, 5 resize, 6 click, 7 text, 8 check, 9 choice
    list<addr> boxes
    Mouse mouse
    Key key
    i32 w
    i32 h
    string text
    bool value
    i64 index
}

void handle(addr event) {
    u32 kind = take<u32>(event)
    if (kind == 0x108) {  // SDL_EVENT_SYSTEM_THEME_CHANGED: drawn at the next frame
        ret
    }
    u32 sdlId = take<u32>(offset(event, 16))
    list<Call> calls
    withData([event, kind, sdlId, ref calls](ref Shared data) {
        for (i64 w = 0; w < data.windows.len(); w++) {
            addr none
            if (data.windows[w].window == none || data.windows[w].sdlId != sdlId) {
                continue
            }
            route(ref data.windows[w], ref data.parts, event, kind, ref calls)
            ret
        }
    })
    for (ref Call call in calls) {
        dispatch(ref call)
    }
}

void dispatch(ref Call call) {
    for (addr box in call.boxes) {
        if (call.kind >= 1 && call.kind <= 3) {
            func(Mouse) handler = take<func(Mouse)>(box)
            try {
                handler(call.mouse)
            } finally {
                put<func(Mouse)>(box, move handler)
            }
        } else if (call.kind == 4) {
            func(Key) handler = take<func(Key)>(box)
            try {
                handler(call.key)
            } finally {
                put<func(Key)>(box, move handler)
            }
        } else if (call.kind == 5) {
            func(i32, i32) handler = take<func(i32, i32)>(box)
            try {
                handler(call.w, call.h)
            } finally {
                put<func(i32, i32)>(box, move handler)
            }
        } else if (call.kind == 6) {
            func() handler = take<func()>(box)
            try {
                handler()
            } finally {
                put<func()>(box, move handler)
            }
        } else if (call.kind == 7) {
            func(string) handler = take<func(string)>(box)
            try {
                handler(call.text)
            } finally {
                put<func(string)>(box, move handler)
            }
        } else if (call.kind == 8) {
            func(bool) handler = take<func(bool)>(box)
            try {
                handler(call.value)
            } finally {
                put<func(bool)>(box, move handler)
            }
        } else if (call.kind == 9) {
            func(i64) handler = take<func(i64)>(box)
            try {
                handler(call.index)
            } finally {
                put<func(i64)>(box, move handler)
            }
        }
    }
}

Call callOf(i32 kind, list<addr> boxes) {
    Call call
    call.kind = kind
    call.boxes = boxes
    ret call
}

// An event of a window: the title bar handles its own, the components theirs, and
// the others go to the handlers of the program, in `calls`.
void route(ref WindowData window, ref list<PartData> parts, addr event, u32 kind, ref list<Call> calls) {
    if (kind >= 0x400 && kind <= 0x402) {  // the mouse: in logical pixels
        SDL_ConvertEventToRenderCoordinates(window.renderer, event)
    }
    layout(ref window, ref parts)
    i32 w = 0
    i32 h = 0
    SDL_GetWindowSize(window.window, ref w, ref h)
    f32 width = f32(w) / toWindow(ref window)
    if (kind == 0x400) {  // SDL_EVENT_MOUSE_MOTION
        f32 x = take<f32>(offset(event, 28))
        f32 y = take<f32>(offset(event, 32))
        window.hovered = buttonAt(x, y, width)
        i64 hot = y >= barHeight ? partAt(ref window, ref parts, x, y - barHeight) : -1
        i64 open = partNumber(ref parts, window.popup)
        if (open >= 0 && inList(ref window, ref parts[open], x, y - barHeight)) {
            hot = open
            i64 item = itemAt(ref window, ref parts[open], x, y - barHeight)
            if (item >= 0) {
                parts[open].highlight = item
            }
        }
        i64 hotId = hot >= 0 ? parts[hot].id : 0
        if (hotId != window.hot) {
            window.hot = hotId
            SDL_SetCursor(hot >= 0 && hot != open && parts[hot].kind == kindTextBox && parts[hot].active ? beam : arrow)
        }
        if (window.dragging != 0) {
            i64 d = partNumber(ref parts, window.dragging)
            if (d >= 0) {
                parts[d].caret = indexAt(window.body, parts[d].text, x - parts[d].left - padding + parts[d].scroll)
                window.caretStart = SDL_GetTicksNS()
            }
        }
        if (y >= barHeight) {
            Call call = callOf(1, window.mouseMove)
            call.mouse = mouseAt(x, y, 0)
            calls.add(move call)
        }
    } else if (kind == 0x401 || kind == 0x402) {  // SDL_EVENT_MOUSE_BUTTON_DOWN, _UP
        f32 x = take<f32>(offset(event, 28))
        f32 y = take<f32>(offset(event, 32))
        i32 button = i32(take<u8>(offset(event, 24)))
        i32 on = buttonAt(x, y, width)
        if (kind == 0x401 && button == 1 && on >= 0) {
            window.pressed = on
        } else if (kind == 0x402 && window.pressed >= 0) {
            if (button == 1 && on == window.pressed) {
                press(ref window, on)
            }
            window.pressed = -1
        } else if (y >= barHeight) {
            if (kind == 0x401 && button == 1) {
                pressPart(ref window, ref parts, x, y - barHeight)
            } else if (kind == 0x402 && button == 1) {
                releasePart(ref window, ref parts, x, y - barHeight, ref calls)
            }
            Call call = callOf(kind == 0x401 ? 2 : 3, kind == 0x401 ? window.mouseDown : window.mouseUp)
            call.mouse = mouseAt(x, y, button)
            calls.add(move call)
        }
    } else if (kind == 0x403) {  // SDL_EVENT_MOUSE_WHEEL: it scrolls the list open
        i64 open = partNumber(ref parts, window.popup)
        if (open >= 0) {
            i64 ticks = i64(take<i32>(offset(event, 48)))
            if (take<u32>(offset(event, 32)) == 1) {  // SDL_MOUSEWHEEL_FLIPPED
                ticks = -ticks
            }
            parts[open].first = parts[open].first - ticks
            reveal(ref window, ref parts[open], false)
        }
    } else if (kind == 0x20D) {  // SDL_EVENT_WINDOW_MOUSE_LEAVE
        window.hovered = -1
        window.pressed = -1
        window.hot = 0
    } else if (kind == 0x20E) {  // FOCUS_GAINED
        window.focused = true
    } else if (kind == 0x20F) {  // FOCUS_LOST
        window.focused = false
        window.popup = 0
    } else if (kind == 0x210) {  // CLOSE_REQUESTED, as Alt+F4
        window.closing = true
    } else if (kind == 0x209) {  // MINIMIZED
        window.minimized = true
    } else if (kind == 0x20A) {  // MAXIMIZED
        window.maximized = true
        window.minimized = false
    } else if (kind == 0x20B) {  // RESTORED
        window.maximized = false
        window.minimized = false
    } else if (kind == 0x214) {  // DISPLAY_SCALE_CHANGED
        setDensity(ref window)
    } else if (kind == 0x206) {  // RESIZED, in the coordinates of the window
        f32 scale = toWindow(ref window)
        window.width = i32(f32(take<i32>(offset(event, 20))) / scale + 0.5)
        window.height = i32(f32(take<i32>(offset(event, 24))) / scale + 0.5)
        Call call = callOf(5, window.resize)
        call.w = window.width
        call.h = window.height
        calls.add(move call)
    } else if (kind == 0x300) {  // SDL_EVENT_KEY_DOWN
        u32 modifiers = u32(take<u16>(offset(event, 32)))
        Key key
        key.code = i64(take<u32>(offset(event, 28)))
        key.shift = (modifiers & 0x3) != 0
        key.control = (modifiers & 0xC0) != 0
        key.alt = (modifiers & 0x300) != 0
        if (!keyOfPart(ref window, ref parts, key, ref calls)) {
            Call call = callOf(4, window.keyDown)
            call.key = key
            calls.add(move call)
        }
    } else if (kind == 0x303) {  // SDL_EVENT_TEXT_INPUT, in UTF-8
        i64 f = partNumber(ref parts, window.focus)
        if (f >= 0 && parts[f].kind == kindTextBox && parts[f].active) {
            insert(ref parts[f], cText(take<addr>(offset(event, 24))))
            window.caretStart = SDL_GetTicksNS()
            changed(ref parts[f], ref calls)
        }
    }
}

Mouse mouseAt(f32 x, f32 y, i32 button) {
    Mouse m
    m.x = x
    m.y = y - barHeight
    m.button = button
    ret m
}

// A click on a button of the title bar.
void press(ref WindowData window, i32 button) {
    if (button == 0) {
        SDL_MinimizeWindow(window.window)
    } else if (button == 1 && window.maximized) {
        SDL_RestoreWindow(window.window)
    } else if (button == 1 && window.resizable) {
        SDL_MaximizeWindow(window.window)
    } else if (button == 2) {
        window.closing = true
    }
}

// ---- The components on the thread of the GUI ----

// The index of a component in the list, or -1.
i64 partNumber(ref list<PartData> parts, i64 id) {
    if (id == 0) {
        ret -1
    }
    for (i64 i = 0; i < parts.len(); i++) {
        if (parts[i].id == id) {
            ret i
        }
    }
    ret -1
}

// The component of a window at a point of its content: the last drawn is on top.
i64 partAt(ref WindowData window, ref list<PartData> parts, f32 x, f32 y) {
    for (i64 k = window.order.len() - 1; k >= 0; k--) {
        i64 i = window.order[k]
        if (parts[i].shown && inside(ref parts[i], x, y)) {
            ret i
        }
    }
    ret -1
}

// A point of the content on a component, and inside its groups.
bool inside(ref PartData part, f32 x, f32 y) {
    ret x >= part.left && x < part.left + f32(part.width) && y >= part.top && y < part.top + f32(part.height) &&
        x >= part.clipLeft && x < part.clipRight && y >= part.clipTop && y < part.clipBottom
}

bool focusable(ref PartData part) {
    bool takes = part.kind == kindButton || part.kind == kindTextBox || part.kind == kindCheckBox || part.kind == kindComboBox
    ret takes && part.shown && part.active
}

// Gives the keyboard to a component, or to none with 0: a text box receives the
// text of the keyboard, with its input method. The list of another combo box
// closes.
void focusTo(ref WindowData window, ref list<PartData> parts, i64 id) {
    if (window.popup != id) {
        window.popup = 0
    }
    if (window.focus == id) {
        ret
    }
    i64 old = partNumber(ref parts, window.focus)
    i64 now = partNumber(ref parts, id)
    bool wasText = old >= 0 && parts[old].kind == kindTextBox
    bool isText = now >= 0 && parts[now].kind == kindTextBox
    window.focus = id
    if (wasText && !isText) {
        SDL_StopTextInput(window.window)
    } else if (isText && !wasText) {
        SDL_StartTextInput(window.window)
    }
    window.caretStart = SDL_GetTicksNS()
}

// Tab and Shift+Tab: the next or the previous component that takes the keyboard.
void moveFocus(ref WindowData window, ref list<PartData> parts, i64 step) {
    list<i64> order
    i64 current = -1
    for (i64 k = 0; k < window.order.len(); k++) {
        i64 i = window.order[k]
        if (focusable(ref parts[i])) {
            if (parts[i].id == window.focus) {
                current = order.len()
            }
            order.add(parts[i].id)
        }
    }
    if (order.len() == 0) {
        ret
    }
    i64 next = current < 0 ? (step > 0 ? 0 : order.len() - 1) : (current + step + order.len()) % order.len()
    focusTo(ref window, ref parts, order[next])
}

// With the list of a combo box open, a click outside it closes it and does nothing
// else (P39); on an item, the release chooses it.
void pressPart(ref WindowData window, ref list<PartData> parts, f32 x, f32 y) {
    i64 open = partNumber(ref parts, window.popup)
    if (open >= 0) {
        if (!inList(ref window, ref parts[open], x, y)) {
            window.popup = 0
        }
        ret
    }
    i64 p = partAt(ref window, ref parts, x, y)
    focusTo(ref window, ref parts, p >= 0 && focusable(ref parts[p]) ? parts[p].id : 0)
    if (p < 0 || !parts[p].active) {
        ret
    }
    window.held = parts[p].id
    if (parts[p].kind == kindTextBox) {
        parts[p].caret = indexAt(window.body, parts[p].text, x - parts[p].left - padding + parts[p].scroll)
        parts[p].anchor = parts[p].caret
        window.dragging = parts[p].id
    } else if (parts[p].kind == kindComboBox) {
        openList(ref window, ref parts[p])
    }
}

void releasePart(ref WindowData window, ref list<PartData> parts, f32 x, f32 y, ref list<Call> calls) {
    i64 p = partNumber(ref parts, window.held)
    window.held = 0
    window.dragging = 0
    i64 open = partNumber(ref parts, window.popup)
    if (open >= 0) {
        i64 item = itemAt(ref window, ref parts[open], x, y)
        if (item >= 0) {
            choose(ref parts[open], item, ref calls)
            window.popup = 0
        }
        ret
    }
    if (p >= 0 && parts[p].active && inside(ref parts[p], x, y)) {
        activate(ref parts[p], ref calls)
    }
}

// ---- The list of a combo box (D445) ----

// How many items the list shows: up to 8, and as many as fit below the combo box
// or above it, where there is more room.
i64 rowsOf(ref WindowData window, ref PartData box) {
    f32 below = f32(window.height) - barHeight - box.top - f32(box.height) - 8
    f32 above = box.top - 8
    i64 fit = i64((most(below, above) - 6) / itemHeight)
    i64 rows = box.items.len() < listRows ? box.items.len() : listRows
    if (fit < rows) {
        rows = fit < 1 ? 1 : fit
    }
    ret rows
}

// Where the list is, in the content: below the combo box, or above it when there
// is no room below.
Rect listOf(ref WindowData window, ref PartData box) {
    f32 h = f32(rowsOf(ref window, ref box)) * itemHeight + 6
    f32 top = box.top + f32(box.height) + 3
    if (top + h > f32(window.height) - barHeight - 4 && box.top - 3 - h >= 4) {
        top = box.top - 3 - h
    }
    ret Rect(box.left, top, f32(box.width), h)
}

bool inList(ref WindowData window, ref PartData box, f32 x, f32 y) {
    Rect area = listOf(ref window, ref box)
    ret x >= area.x && x < area.x + area.w && y >= area.y && y < area.y + area.h
}

// The item at a point of the content, or -1.
i64 itemAt(ref WindowData window, ref PartData box, f32 x, f32 y) {
    Rect area = listOf(ref window, ref box)
    if (x < area.x || x >= area.x + area.w || y < area.y + 3 || y >= area.y + area.h - 3) {
        ret -1
    }
    i64 item = box.first + i64((y - area.y - 3) / itemHeight)
    ret item < box.items.len() ? item : -1
}

void openList(ref WindowData window, ref PartData box) {
    if (box.items.len() == 0) {
        ret
    }
    window.popup = box.id
    box.highlight = box.selected >= 0 ? box.selected : 0
    reveal(ref window, ref box, true)
}

// Scrolls the list so that the item pointed at is in it, with `follow`, and not
// beyond its items.
void reveal(ref WindowData window, ref PartData box, bool follow) {
    i64 rows = rowsOf(ref window, ref box)
    if (follow && box.highlight < box.first) {
        box.first = box.highlight
    }
    if (follow && box.highlight >= box.first + rows) {
        box.first = box.highlight - rows + 1
    }
    if (box.first > box.items.len() - rows) {
        box.first = box.items.len() - rows
    }
    if (box.first < 0) {
        box.first = 0
    }
}

// The user chooses an item: the handlers of onChange are called when it changes.
void choose(ref PartData box, i64 item, ref list<Call> calls) {
    if (item == box.selected) {
        ret
    }
    box.selected = item
    Call call = callOf(9, box.change)
    call.index = item
    calls.add(move call)
}

// The next item after `from` that starts with a letter, or -1.
i64 itemByLetter(ref PartData box, i64 code, i64 from) {
    for (i64 k = 1; k <= box.items.len(); k++) {
        i64 i = (from + k) % box.items.len()
        list<u8> bytes = box.items[i].bytes()
        if (bytes.len() > 0 && lowerByte(bytes[0]) == lowerByte(u8(code))) {
            ret i
        }
    }
    ret -1
}

u8 lowerByte(u8 b) {
    ret b >= 65 && b <= 90 ? b + 32 : b
}

// The keys of a combo box (P39): false for those it does not use.
bool comboKey(ref WindowData window, ref PartData box, Key key, ref list<Call> calls) {
    i64 code = key.code
    i64 n = box.items.len()
    bool letter = !key.control && !key.alt && code > 32 && code < 127
    if (window.popup == box.id) {
        if (code == 27) {  // Esc
            window.popup = 0
        } else if (code == 13 || code == keyEnter || code == 32) {
            if (box.highlight >= 0 && box.highlight < n) {
                choose(ref box, box.highlight, ref calls)
            }
            window.popup = 0
        } else if (code == keyUp && box.highlight > 0) {
            box.highlight--
        } else if (code == keyDown && box.highlight < n - 1) {
            box.highlight++
        } else if (code == keyHome) {
            box.highlight = 0
        } else if (code == keyEnd) {
            box.highlight = n - 1
        } else if (letter) {
            i64 found = itemByLetter(ref box, code, box.highlight)
            if (found >= 0) {
                box.highlight = found
            }
        } else if (code != keyUp && code != keyDown) {
            ret false
        }
        reveal(ref window, ref box, true)
        ret true
    }
    if (code == 32 || code == 13 || code == keyEnter || (key.alt && code == keyDown)) {
        openList(ref window, ref box)
        ret true
    }
    i64 next = -1
    if (code == keyUp) {
        next = box.selected > 0 ? box.selected - 1 : 0
    } else if (code == keyDown) {
        next = box.selected < n - 1 ? box.selected + 1 : n - 1
    } else if (code == keyHome) {
        next = 0
    } else if (code == keyEnd) {
        next = n - 1
    } else if (letter) {
        next = itemByLetter(ref box, code, box.selected)
    } else {
        ret false
    }
    if (next >= 0 && next < n) {
        choose(ref box, next, ref calls)
    }
    ret true
}

// A click, or Space: a button calls its handlers, a check box changes.
void activate(ref PartData part, ref list<Call> calls) {
    if (part.kind == kindButton) {
        calls.add(callOf(6, part.click))
    } else if (part.kind == kindCheckBox) {
        part.checked = !part.checked
        Call call = callOf(8, part.change)
        call.value = part.checked
        calls.add(move call)
    }
}

// A key for the component in focus: false if it does not use it.
bool keyOfPart(ref WindowData window, ref list<PartData> parts, Key key, ref list<Call> calls) {
    if (key.code == 9) {  // Tab
        moveFocus(ref window, ref parts, key.shift ? -1 : 1)
        ret true
    }
    i64 f = partNumber(ref parts, window.focus)
    if (f < 0 || !parts[f].active || !parts[f].shown) {
        ret false
    }
    if (parts[f].kind == kindTextBox) {
        window.caretStart = SDL_GetTicksNS()
        ret edit(ref parts[f], key, ref calls)
    }
    if (parts[f].kind == kindComboBox) {
        ret comboKey(ref window, ref parts[f], key, ref calls)
    }
    if (key.code == 32 || (key.code == 13 && parts[f].kind == kindButton)) {  // Space, Enter
        activate(ref parts[f], ref calls)
        ret true
    }
    ret false
}

const i64 keyLeft = 0x40000050
const i64 keyRight = 0x4000004F
const i64 keyHome = 0x4000004A
const i64 keyEnd = 0x4000004D
const i64 keyEnter = 0x40000058  // of the numeric keypad
const i64 keyUp = 0x40000052
const i64 keyDown = 0x40000051

// The editing of a text box: the characters come with the text of the keyboard.
bool edit(ref PartData box, Key key, ref list<Call> calls) {
    i64 code = key.code
    if (code == 8) {  // Backspace
        if (!removeSelection(ref box) && box.caret > 0) {
            i64 from = previousCharacter(box.text, box.caret)
            box.text = box.text.slice(0, from).concat(box.text.slice(box.caret, box.text.len()))
            box.caret = from
            box.anchor = from
        }
        changed(ref box, ref calls)
    } else if (code == 0x7F) {  // Delete
        if (!removeSelection(ref box) && box.caret < box.text.len()) {
            i64 to = nextCharacter(box.text, box.caret)
            box.text = box.text.slice(0, box.caret).concat(box.text.slice(to, box.text.len()))
        }
        changed(ref box, ref calls)
    } else if (code == keyLeft || code == keyRight || code == keyHome || code == keyEnd) {
        i64 low = box.caret < box.anchor ? box.caret : box.anchor
        i64 high = box.caret < box.anchor ? box.anchor : box.caret
        if (code == keyLeft) {
            box.caret = !key.shift && low != high ? low : previousCharacter(box.text, box.caret)
        } else if (code == keyRight) {
            box.caret = !key.shift && low != high ? high : nextCharacter(box.text, box.caret)
        } else if (code == keyHome) {
            box.caret = 0
        } else {
            box.caret = box.text.len()
        }
        if (!key.shift) {
            box.anchor = box.caret
        }
    } else if (code == 13 || code == keyEnter) {
        Call call = callOf(7, box.enter)
        call.text = box.text
        calls.add(move call)
    } else if (key.control && code == 97) {  // Ctrl+A
        box.anchor = 0
        box.caret = box.text.len()
    } else if (key.control && (code == 99 || code == 120)) {  // Ctrl+C, Ctrl+X
        if (box.caret != box.anchor) {
            SDL_SetClipboardText(selection(ref box).cstring())
            if (code == 120) {
                removeSelection(ref box)
                changed(ref box, ref calls)
            }
        }
    } else if (key.control && code == 118) {  // Ctrl+V: the text in one line
        addr none
        addr pasted = SDL_GetClipboardText()
        if (pasted != none) {
            string line = cText(pasted).replace("\r\n", " ").replace("\n", " ").replace("\r", " ")
            SDL_free(pasted)
            insert(ref box, line)
            changed(ref box, ref calls)
        }
    } else {
        ret !key.control && !key.alt && code >= 32 && code < 127
    }
    ret true
}

void changed(ref PartData box, ref list<Call> calls) {
    Call call = callOf(7, box.change)
    call.text = box.text
    calls.add(move call)
}

string selection(ref PartData box) {
    i64 low = box.caret < box.anchor ? box.caret : box.anchor
    i64 high = box.caret < box.anchor ? box.anchor : box.caret
    ret box.text.slice(low, high)
}

// Removes the text selected: false without a selection.
bool removeSelection(ref PartData box) {
    if (box.caret == box.anchor) {
        ret false
    }
    i64 low = box.caret < box.anchor ? box.caret : box.anchor
    i64 high = box.caret < box.anchor ? box.anchor : box.caret
    box.text = box.text.slice(0, low).concat(box.text.slice(high, box.text.len()))
    box.caret = low
    box.anchor = low
    ret true
}

void insert(ref PartData box, string piece) {
    removeSelection(ref box)
    box.text = box.text.slice(0, box.caret).concat(piece).concat(box.text.slice(box.caret, box.text.len()))
    box.caret = box.caret + piece.len()
    box.anchor = box.caret
}

// Where the characters of UTF-8 start: a byte 10xxxxxx continues one.
i64 previousCharacter(string s, i64 at) {
    list<u8> bytes = s.bytes()
    i64 i = at - 1
    for (i > 0 && (bytes[i] & 0xC0) == 0x80) {
        i--
    }
    ret i < 0 ? 0 : i
}

i64 nextCharacter(string s, i64 at) {
    list<u8> bytes = s.bytes()
    if (at >= bytes.len()) {
        ret bytes.len()
    }
    i64 i = at + 1
    for (i < bytes.len() && (bytes[i] & 0xC0) == 0x80) {
        i++
    }
    ret i
}

// The place between two characters nearest to x, from the start of the text.
i64 indexAt(addr font, string s, f32 x) {
    i64 at = 0
    f32 left = 0
    for (at < s.len()) {
        i64 next = nextCharacter(s, at)
        f32 right = textWidth(font, s, next)
        if (x < (left + right) / 2) {
            ret at
        }
        at = next
        left = right
    }
    ret s.len()
}

// ---- The layout: the groups (D444) and the anchors (D447, P40) ----

// Where the components of a group go: its place in the content, its size, whether
// it is shown and enabled, and the rectangle that clips them.
struct Frame {
    f32 left
    f32 top
    i32 width
    i32 height
    bool shown
    bool active
    f32 clipLeft
    f32 clipTop
    f32 clipRight
    f32 clipBottom
}

// Places the components of a window in its content, each group before its
// components, in the order they are drawn. The list of a combo box hidden or
// disabled closes.
void layout(ref WindowData window, ref list<PartData> parts) {
    window.order.clear()
    Frame content
    content.width = window.width
    content.height = window.height - i32(barHeight)
    content.shown = true
    content.active = true
    content.clipRight = f32(content.width)
    content.clipBottom = f32(content.height)
    layoutIn(ref window, ref parts, 0, content)
    i64 open = partNumber(ref parts, window.popup)
    if (open < 0 || !parts[open].shown || !parts[open].active) {
        window.popup = 0
    }
}

void layoutIn(ref WindowData window, ref list<PartData> parts, i64 group, Frame frame) {
    for (i64 i = 0; i < parts.len(); i++) {
        if (parts[i].window != window.id || parts[i].parent != group) {
            continue
        }
        arrange(ref parts[i], frame.width, frame.height)
        parts[i].left = frame.left + f32(parts[i].x)
        parts[i].top = frame.top + f32(parts[i].y)
        parts[i].shown = frame.shown && parts[i].visible
        parts[i].active = frame.active && parts[i].enabled
        parts[i].clipLeft = frame.clipLeft
        parts[i].clipTop = frame.clipTop
        parts[i].clipRight = frame.clipRight
        parts[i].clipBottom = frame.clipBottom
        window.order.add(i)
        if (parts[i].kind == kindGroup) {
            Frame inner
            inner.left = parts[i].left
            inner.top = parts[i].top
            inner.width = parts[i].width
            inner.height = parts[i].height
            inner.shown = parts[i].shown
            inner.active = parts[i].active
            inner.clipLeft = most(frame.clipLeft, parts[i].left)
            inner.clipTop = most(frame.clipTop, parts[i].top)
            inner.clipRight = least(frame.clipRight, parts[i].left + f32(parts[i].width))
            inner.clipBottom = least(frame.clipBottom, parts[i].top + f32(parts[i].height))
            layoutIn(ref window, ref parts, parts[i].id, inner)
        }
    }
}

// The position and the size of a component, for the size of its parent now.
void arrange(ref PartData part, i32 width, i32 height) {
    i32 dw = width - part.parentWidth
    i32 dh = height - part.parentHeight
    part.x = part.baseX
    part.y = part.baseY
    part.width = part.baseWidth
    part.height = part.baseHeight
    if (part.horizontal == Horizontal.Right) {
        part.x = part.baseX + dw
    } else if (part.horizontal == Horizontal.Stretch) {
        part.width = part.baseWidth + dw > 0 ? part.baseWidth + dw : 0
    } else if (part.horizontal == Horizontal.Center) {
        part.x = part.baseX + dw / 2
    }
    if (part.vertical == Vertical.Bottom) {
        part.y = part.baseY + dh
    } else if (part.vertical == Vertical.Stretch) {
        part.height = part.baseHeight + dh > 0 ? part.baseHeight + dh : 0
    } else if (part.vertical == Vertical.Center) {
        part.y = part.baseY + dh / 2
    }
}

// ---- The drawing ----

void draw() {
    withData([](ref Shared data) {
        for (ref WindowData window in data.windows) {
            addr none
            if (window.window != none && !window.closing) {
                drawWindow(ref window, ref data.parts)
            }
        }
    })
}

// The content with its components, the title bar with its title and its buttons,
// and a line at the edges when the window is not maximized (D431).
void drawWindow(ref WindowData window, ref list<PartData> parts) {
    i32 w = 0
    i32 h = 0
    SDL_GetWindowSize(window.window, ref w, ref h)
    f32 scale = toWindow(ref window)
    f32 width = f32(w) / scale
    f32 height = f32(h) / scale
    cromo_gui_chrome_size(window.chrome, barHeight * scale, 3 * buttonWidth * scale, edgeWidth * scale, window.resizable)
    window.maximized = (SDL_GetWindowFlags(window.window) & 0x80) != 0
    bool dark = window.theme == Theme.Dark || (window.theme == Theme.System && SDL_GetSystemTheme() == 2)
    Colors c = colorsOf(dark)
    addr r = window.renderer
    fill(r, c.content, 0, 0, width, height)

    layout(ref window, ref parts)
    for (i64 k = 0; k < window.order.len(); k++) {
        i64 i = window.order[k]
        if (parts[i].shown && parts[i].clipRight > parts[i].clipLeft && parts[i].clipBottom > parts[i].clipTop) {
            clipPart(r, ref parts[i])
            drawPart(ref window, ref parts[i], ref c)
        }
    }
    i64 open = partNumber(ref parts, window.popup)
    if (open >= 0) {
        clipTo(r, 0, barHeight, width, height - barHeight)
        drawList(ref window, ref parts[open], ref c)
    }
    addr none
    SDL_SetRenderClipRect(r, none)

    fill(r, c.bar, 0, 0, width, barHeight)
    u32 title = window.focused ? c.title : c.inactive
    f32 ascent = 0
    f32 descent = 0
    f32 gap = 0
    cromo_gui_font_metrics(window.font, ref ascent, ref descent, ref gap)
    f32 titleWidth = textWidth(window.font, window.title, window.title.len())
    text(window.font, window.title, (width - titleWidth) / 2, barHeight / 2 + (ascent - descent) / 2, title, true)
    for (i32 b = 0; b < 3; b++) {
        f32 x = width - f32(3 - b) * buttonWidth
        u32 symbol = title
        bool disabled = b == 1 && !window.resizable
        if (b == 2 && window.hovered == 2) {
            fill(r, window.pressed == 2 ? closePressed : closeHover, x, 0, buttonWidth, barHeight)
            symbol = 0xFFFFFF
        } else if (b == window.hovered && !disabled) {
            fill(r, window.pressed == b ? c.pressed : c.hover, x, 0, buttonWidth, barHeight)
        }
        if (disabled) {
            symbol = c.inactive
        }
        i32 kind = b == 2 ? 3 : b == 1 && window.maximized ? 2 : b
        cromo_gui_symbol(r, kind, x + buttonWidth / 2, barHeight / 2, window.density, red(symbol), green(symbol), blue(symbol))
    }
    fill(r, c.separator, 0, barHeight - 1, width, 1)
    if (!window.maximized) {
        SDL_SetRenderDrawColor(r, red(c.border), green(c.border), blue(c.border), 255)
        Rect edge = Rect(0, 0, width, height)
        SDL_RenderRect(r, ref edge)
    }
    SDL_RenderPresent(r)
}

// A component, in the look of D443: a soft shadow under it, buttons and check
// boxes checked in a gradient with a line of light and a border of a deeper
// color, a glow around the text box or the combo box in focus and a ring of 2
// pixels around the other components in focus, the groups as cards.
void drawPart(ref WindowData window, ref PartData part, ref Colors c) {
    addr r = window.renderer
    f32 d = window.density
    f32 x = part.left
    f32 y = barHeight + part.top
    f32 w = f32(part.width)
    f32 h = f32(part.height)
    bool focused = window.focus == part.id && window.focused
    bool on = part.active
    f32 ascent = 0
    f32 descent = 0
    f32 gap = 0
    cromo_gui_font_metrics(window.body, ref ascent, ref descent, ref gap)
    f32 baseline = y + h / 2 + (ascent - descent) / 2
    if (part.kind == kindLabel) {
        text(window.body, part.text, x, baseline, c.label, on)
    } else if (part.kind == kindButton) {
        bool hot = window.hot == part.id && on
        bool down = window.held == part.id && hot
        u32 top = hot ? c.hoverTop : c.buttonTop
        u32 bottom = hot ? c.hoverBottom : c.buttonBottom
        if (down) {
            top = c.buttonBottom
            bottom = c.buttonBottom
        }
        if (on) {
            cromo_gui_shadow(r, x, y, w, h, corner, d, c.shadow, 3, 1.5)
        }
        cromo_gui_gradient(r, x, y, w, h, corner, 1, d, solid(top, on), solid(bottom, on), solid(c.buttonLine, on),
            down || !on ? 0 : c.highlight)
        f32 size = textWidth(window.strong, part.text, part.text.len())
        text(window.strong, part.text, x + (w - size) / 2, baseline, c.buttonText, on)
        if (focused) {
            cromo_gui_box(r, x - 3, y - 3, w + 6, h + 6, corner + 3, 2, d, 0, solid(c.focus, true))
        }
    } else if (part.kind == kindTextBox) {
        drawField(ref window, ref part, ref c, focused)
        f32 inner = w - 2 * padding
        f32 caretX = textWidth(window.body, part.text, part.caret)
        f32 total = textWidth(window.body, part.text, part.text.len())
        if (caretX - part.scroll > inner) {
            part.scroll = caretX - inner
        }
        if (caretX < part.scroll) {
            part.scroll = caretX
        }
        if (part.scroll > 0 && total - part.scroll < inner) {
            part.scroll = total > inner ? total - inner : 0
        }
        f32 left = x + padding - part.scroll
        clipInside(r, ref part, x + 2, y + 2, w - 4, h - 4)
        if (part.caret != part.anchor) {
            i64 low = part.caret < part.anchor ? part.caret : part.anchor
            i64 high = part.caret < part.anchor ? part.anchor : part.caret
            f32 from = textWidth(window.body, part.text, low)
            f32 to = textWidth(window.body, part.text, high)
            fill(r, c.selection, left + from, baseline - ascent - 1, to - from, ascent + descent + 2)
        }
        if (part.text.len() == 0) {
            text(window.body, part.placeholder, x + padding, baseline, c.muted, on)
        } else {
            text(window.body, part.text, left, baseline, c.text, on)
        }
        bool blink = ((SDL_GetTicksNS() - window.caretStart) / 500000000) % 2 == 0
        if (focused && blink) {
            fill(r, c.focus, left + caretX, baseline - ascent, 1, ascent + descent)
        }
        clipPart(r, ref part)
    } else if (part.kind == kindCheckBox) {
        f32 top = y + (h - checkSide) / 2
        if (on) {
            cromo_gui_shadow(r, x, top, checkSide, checkSide, checkCorner, d, c.inputShadow, 2, 1)
        }
        if (part.checked) {
            cromo_gui_gradient(r, x, top, checkSide, checkSide, checkCorner, 1, d, solid(c.buttonTop, on), solid(c.buttonBottom, on),
                solid(c.buttonLine, on), on ? c.highlight : 0)
            cromo_gui_symbol(r, 4, x + checkSide / 2, top + checkSide / 2, d, red(c.buttonText), green(c.buttonText),
                blue(c.buttonText))
        } else {
            cromo_gui_box(r, x, top, checkSide, checkSide, checkCorner, 1, d, solid(c.check, on), solid(c.checkBorder, on))
        }
        if (focused) {
            cromo_gui_box(r, x - 3, top - 3, checkSide + 6, checkSide + 6, checkCorner + 3, 2, d, 0, solid(c.focus, true))
        }
        text(window.body, part.text, x + checkSide + 8, baseline, c.text, on)
    } else if (part.kind == kindGroup) {
        cromo_gui_shadow(r, x, y, w, h, groupCorner, d, c.inputShadow, 2, 1)
        cromo_gui_box(r, x, y, w, h, groupCorner, 1, d, solid(c.card, true), solid(c.cardBorder, true))
        clipInside(r, ref part, x + 1, y + 1, w - 2, h - 2)
        text(window.strong, part.text, x + 12, y + 17 + (ascent - descent) / 2, c.text, on)
        clipPart(r, ref part)
    } else if (part.kind == kindComboBox) {
        drawField(ref window, ref part, ref c, focused || window.popup == part.id)
        clipInside(r, ref part, x + 2, y + 2, w - 28, h - 4)
        if (part.selected >= 0 && part.selected < part.items.len()) {
            text(window.body, part.items[part.selected], x + padding, baseline, c.text, on)
        } else {
            text(window.body, part.placeholder, x + padding, baseline, c.muted, on)
        }
        clipPart(r, ref part)
        u32 arrow = on ? c.label : c.muted
        cromo_gui_symbol(r, 5, x + w - 14, y + h / 2, d, red(arrow), green(arrow), blue(arrow))
    } else if (part.kind == kindImageBox) {
        drawImage(ref window, ref part)
    }
}

// The box of a text box or of a combo box: in focus, with a border of indigo and a
// glow around it.
void drawField(ref WindowData window, ref PartData part, ref Colors c, bool lit) {
    addr r = window.renderer
    f32 d = window.density
    f32 x = part.left
    f32 y = barHeight + part.top
    f32 w = f32(part.width)
    f32 h = f32(part.height)
    bool on = part.active
    if (lit) {
        cromo_gui_shadow(r, x, y, w, h, corner, d, c.glow, 4, 0)
    } else if (on) {
        cromo_gui_shadow(r, x, y, w, h, corner, d, c.inputShadow, 2, 1)
    }
    cromo_gui_box(r, x, y, w, h, corner, lit ? 2 : 1, d, solid(c.input, on), solid(lit ? c.focus : c.inputBorder, on))
}

// The list of an open combo box, over the other components: the item pointed at
// on a light background, the one chosen semibold with a mark, and a bar on the
// right when it scrolls.
void drawList(ref WindowData window, ref PartData box, ref Colors c) {
    addr r = window.renderer
    f32 d = window.density
    Rect area = listOf(ref window, ref box)
    f32 x = area.x
    f32 y = barHeight + area.y
    cromo_gui_shadow(r, x, y, area.w, area.h, corner, d, c.listShadow, 8, 4)
    cromo_gui_box(r, x, y, area.w, area.h, corner, 1, d, solid(c.input, true), solid(c.inputBorder, true))
    f32 ascent = 0
    f32 descent = 0
    f32 gap = 0
    cromo_gui_font_metrics(window.body, ref ascent, ref descent, ref gap)
    i64 rows = rowsOf(ref window, ref box)
    bool scrolls = box.items.len() > rows
    for (i64 row = 0; row < rows; row++) {
        i64 item = box.first + row
        f32 top = y + 3 + f32(row) * itemHeight
        clipTo(r, x + 1, y + 1, area.w - 2, area.h - 2)
        if (item == box.highlight) {
            cromo_gui_box(r, x + 3, top, area.w - (scrolls ? 14 : 6), itemHeight, 5, 0, d, solid(c.item, true), 0)
        }
        bool chosen = item == box.selected
        clipTo(r, x + 1, y + 1, area.w - 30, area.h - 2)
        text(chosen ? window.strong : window.body, box.items[item], x + padding, top + itemHeight / 2 + (ascent - descent) / 2, c.text,
            true)
        if (chosen) {
            clipTo(r, x + 1, y + 1, area.w - 2, area.h - 2)
            cromo_gui_symbol(r, 4, x + area.w - (scrolls ? 26 : 18), top + itemHeight / 2, d, red(c.focus), green(c.focus),
                blue(c.focus))
        }
    }
    if (scrolls) {
        f32 track = area.h - 6
        f32 thumb = track * f32(rows) / f32(box.items.len())
        f32 at = y + 3 + (track - thumb) * f32(box.first) / f32(box.items.len() - rows)
        clipTo(r, x + 1, y + 1, area.w - 2, area.h - 2)
        cromo_gui_box(r, x + area.w - 7, at, 4, thumb, 2, 0, d, solid(c.checkBorder, true), 0)
    }
}

// An image: its texture is made from its pixels the first time it is drawn after
// it is set, and its pixels are freed.
void drawImage(ref WindowData window, ref PartData part) {
    addr r = window.renderer
    addr none
    if (part.imageChanged) {
        if (part.texture != none) {
            SDL_DestroyTexture(part.texture)
            part.texture = none
        }
        if (part.pixels != none) {
            part.texture = SDL_CreateTexture(r, 0x16762004, 0, part.imageWidth, part.imageHeight)  // RGBA32, static
            if (part.texture != none) {
                SDL_SetTextureBlendMode(part.texture, 1)
                SDL_UpdateTexture(part.texture, none, part.pixels, part.imageWidth * 4)
            }
            cromo_gui_image_free(part.pixels)
            part.pixels = none
        }
        part.imageChanged = false
    }
    if (part.texture == none) {
        ret
    }
    f32 x = part.left
    f32 y = barHeight + part.top
    f32 w = f32(part.width)
    f32 h = f32(part.height)
    f32 iw = f32(part.imageWidth)
    f32 ih = f32(part.imageHeight)
    f32 dw = w
    f32 dh = h
    if (part.scale == Scale.Fit) {
        f32 k = least(w / iw, h / ih)
        dw = iw * k
        dh = ih * k
    } else if (part.scale == Scale.Fill) {
        f32 k = most(w / iw, h / ih)
        dw = iw * k
        dh = ih * k
    } else if (part.scale == Scale.Center) {
        dw = iw
        dh = ih
    }
    Rect target = Rect(x + (w - dw) / 2, y + (h - dh) / 2, dw, dh)
    clipInside(r, ref part, x, y, w, h)
    SDL_SetTextureAlphaMod(part.texture, part.active ? 255 : 128)
    SDL_RenderTexture(r, part.texture, none, ref target)
    clipPart(r, ref part)
}
