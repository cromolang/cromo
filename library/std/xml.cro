// XML, read and written: the answers of the services that speak it, as S3, SOAP and
// the feeds of RSS, and the files of settings. 'parse' gives the tree of the elements
// of a text, and 'encode' and 'pretty' write a tree as text.
//
// '''
// import std.xml
//
// xml.Element list = xml.parse("<list><item id=\"7\">pen</item><item id=\"8\">ink</item></list>")
// for (xml.Element item in list.all("item")) {
//     println("{} {}", item.attribute("id"), item.text)     // 7 pen, 8 ink
// }
//
// xml.Element made = xml.element("order")
// made.setAttribute("id", "42")
// made.addText("item", "pen & ink")
// println("{}", xml.encode(made))    // <?xml ...?><order id="42"><item>pen &amp; ink</item></order>
// '''
//
// The guide: [JSON](https://cromolang.org/book/en/json.html).

// The module std.xml (D590), in Cromo. The reader takes the documents that are well
// formed and checks nothing against a DTD or a schema: a DOCTYPE is passed over, and
// the entities it declares are not known, so a document cannot grow in memory by its
// own entities (the "billion laughs"). The names keep their prefix, as "s:Envelope":
// the namespaces are attributes like the others.

// An attribute of an element.
public struct Attribute {
    public string name   // "id", or with its prefix, "xml:lang"
    public string value  // without the quotes and with the entities read: "a & b"
}

// An element of XML: its name, its attributes, its text and the elements inside it.
// One declared without a value has no name: it is what 'child' gives when there is no
// such element, so that a chain as 'root.child("a").child("b").text' gives "" and
// does not throw.
public struct Element {
    public string name                 // "item", or with its prefix, "s:Body"
    public list<Attribute> attributes  // in their order
    public string text                 // the text right inside it, with the entities read
    public list<Element> children      // the elements inside it, in their order

    // The name without its prefix: "Body" for "s:Body".
    public string localName() const {
        i64 colon = name.find(":")
        ret colon < 0 ? name.copy() : name.slice(colon + 1, name.len())
    }

    // The value of the attribute 'key', or "" when the element has none.
    public string attribute(string key) const {
        for (Attribute each in attributes) {
            if (each.name == key) {
                ret each.value.copy()
            }
        }
        ret ""
    }

    // Whether the element has the attribute 'key'.
    public bool hasAttribute(string key) const {
        for (Attribute each in attributes) {
            if (each.name == key) {
                ret true
            }
        }
        ret false
    }

    // Gives the attribute 'key' a value, in place of the one it had or as a new one.
    public void setAttribute(string key, string value) {
        for (i64 i = 0; i < attributes.len(); i++) {
            if (attributes[i].name == key) {
                attributes[i].value = value.copy()
                ret
            }
        }
        Attribute added
        added.name = key.copy()
        added.value = value.copy()
        attributes.add(move added)
    }

    // Whether an element named 'key' is right inside this one.
    public bool has(string key) const {
        for (i64 i = 0; i < children.len(); i++) {
            if (children[i].name == key) {
                ret true
            }
        }
        ret false
    }

    // The first element named 'key' right inside this one, or an element without a
    // name when there is none.
    public Element child(string key) const {
        for (i64 i = 0; i < children.len(); i++) {
            if (children[i].name == key) {
                ret children[i].copy()
            }
        }
        Element none
        ret none
    }

    // The text of the first element named 'key' right inside this one, or "" when
    // there is none: 'entry.textOf("Size")' for '<Size>12</Size>'.
    public string textOf(string key) const {
        for (i64 i = 0; i < children.len(); i++) {
            if (children[i].name == key) {
                ret children[i].text.copy()
            }
        }
        ret ""
    }

    // The elements named 'key' right inside this one, in their order.
    public list<Element> all(string key) const {
        list<Element> found
        for (i64 i = 0; i < children.len(); i++) {
            if (children[i].name == key) {
                found.add(children[i].copy())
            }
        }
        ret found
    }

    // Puts an element inside this one, after the others.
    public void add(move Element inside) {
        children.add(move inside)
    }

    // Puts inside this one an element named 'key' with a text:
    // 'part.addText("ETag", tag)' for '<ETag>...</ETag>'.
    public void addText(string key, string content) {
        Element inside
        inside.name = key.copy()
        inside.text = content.copy()
        children.add(move inside)
    }
}

// An element named 'name', with nothing in it, to fill and to write.
public Element element(string name) {
    Element made
    made.name = name.copy()
    ret made
}

// ---- Writing ----

// The text with the characters that XML keeps for itself written as entities: '&',
// '<', '>' and the two quotes. 'xml.escape("a < b")' gives "a &lt; b".
public string escape(string text) {
    list<u8> out
    for (i64 i = 0; i < text.len(); i++) {
        u8 c = text[i]
        if (c == '&') {
            append(ref out, "&amp;")
        } else if (c == '<') {
            append(ref out, "&lt;")
        } else if (c == '>') {
            append(ref out, "&gt;")
        } else if (c == '"') {
            append(ref out, "&quot;")
        } else if (c == '\'') {
            append(ref out, "&apos;")
        } else {
            out.add(c)
        }
    }
    ret string(out)
}

void append(ref list<u8> out, string text) {
    for (i64 i = 0; i < text.len(); i++) {
        out.add(text[i])
    }
}

bool isNameStart(u8 c) {
    ret (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_' || c == ':' || c >= 0x80
}

bool isNameChar(u8 c) {
    ret isNameStart(c) || (c >= '0' && c <= '9') || c == '-' || c == '.'
}

void checkName(string name, string what) {
    bool fine = name.len() > 0 && isNameStart(name[0])
    for (i64 i = 0; fine && i < name.len(); i++) {
        fine = isNameChar(name[i])
    }
    if (!fine) {
        throw Error(format("'{}' cannot be the name of {} of XML", name, what))
    }
}

// An element and what is inside it; `indent` is -1 for one line, or the depth.
void write(ref list<u8> out, Element item, i64 indent) {
    checkName(item.name, "an element")
    for (i64 i = 0; i < indent; i++) {
        append(ref out, "  ")
    }
    out.add('<')
    append(ref out, item.name)
    for (Attribute each in item.attributes) {
        checkName(each.name, "an attribute")
        out.add(' ')
        append(ref out, each.name)
        append(ref out, "=\"")
        append(ref out, escape(each.value))
        out.add('"')
    }
    if (item.text.len() == 0 && item.children.len() == 0) {
        append(ref out, "/>")
    } else {
        out.add('>')
        append(ref out, escape(item.text))
        if (item.children.len() > 0) {
            if (indent >= 0) {
                out.add('\n')
            }
            for (i64 i = 0; i < item.children.len(); i++) {
                write(ref out, item.children[i], indent < 0 ? -1 : indent + 1)
            }
            for (i64 i = 0; i < indent; i++) {
                append(ref out, "  ")
            }
        }
        append(ref out, "</")
        append(ref out, item.name)
        out.add('>')
    }
    if (indent >= 0) {
        out.add('\n')
    }
}

// The document of the element as text on one line, in UTF-8, with the declaration
// of XML in front. Throws an 'Error' for a name of an element or of an attribute
// that XML does not take, as an empty one or one with a space.
public string encode(Element root) {
    list<u8> out
    append(ref out, "<?xml version=\"1.0\" encoding=\"UTF-8\"?>")
    write(ref out, root, -1)
    ret string(out)
}

// The document of the element as text for a person: an element on each line, two
// spaces deeper than the one around it. An element with a text and elements inside
// has its text right after its tag.
public string pretty(Element root) {
    list<u8> out
    append(ref out, "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n")
    write(ref out, root, 0)
    ret string(out)
}

// ---- Reading ----

struct Reader {
    string source
    i64 at

    Error wrong(string what) const {
        i64 line = 1
        i64 column = 1
        for (i64 i = 0; i < at && i < source.len(); i++) {
            if (source[i] == '\n') {
                line++
                column = 1
            } else if ((source[i] & 0xC0) != 0x80) {
                column++
            }
        }
        ret Error(format("the XML is wrong at line {}, column {}: {}", line, column, what))
    }

    bool ended() const {
        ret at >= source.len()
    }

    bool next(string text) const {
        if (at + text.len() > source.len()) {
            ret false
        }
        for (i64 i = 0; i < text.len(); i++) {
            if (source[at + i] != text[i]) {
                ret false
            }
        }
        ret true
    }

    void spaces() {
        for (at < source.len() && (source[at] == ' ' || source[at] == '\t' || source[at] == '\n' || source[at] == '\r')) {
            at++
        }
    }

    // Past the text `end`, which must come: the end of a comment, of a CDATA.
    void past(string end, string what) {
        i64 found = source.findFrom(end, at)
        if (found < 0) {
            throw wrong(what + " does not end")
        }
        at = found + end.len()
    }

    // What is not an element: the declaration, the comments, the instructions and
    // the DOCTYPE, whose declarations are not read.
    void misc() {
        for {
            spaces()
            if (next("<?")) {
                past("?>", "an instruction")
            } else if (next("<!--")) {
                past("-->", "a comment")
            } else if (next("<!DOCTYPE")) {
                i64 depth = 0
                for (at < source.len()) {
                    u8 c = source[at]
                    at++
                    if (c == '[') {
                        depth++
                    } else if (c == ']') {
                        depth--
                    } else if (c == '>' && depth <= 0) {
                        break
                    }
                }
            } else {
                ret
            }
        }
    }

    string readName() {
        i64 start = at
        if (at >= source.len() || !isNameStart(source[at])) {
            throw wrong("a name is expected")
        }
        for (at < source.len() && isNameChar(source[at])) {
            at++
        }
        ret source.slice(start, at)
    }

    // An entity, from its '&': the five of XML and the characters by their number.
    void entity(ref list<u8> out) {
        i64 end = source.findFrom(";", at)
        if (end < 0 || end - at > 12) {
            throw wrong("an & starts an entity, as &amp;")
        }
        string name = source.slice(at + 1, end)
        if (name == "amp") {
            out.add('&')
        } else if (name == "lt") {
            out.add('<')
        } else if (name == "gt") {
            out.add('>')
        } else if (name == "quot") {
            out.add('"')
        } else if (name == "apos") {
            out.add('\'')
        } else if (name.len() > 1 && name[0] == '#') {
            i64 code = 0
            bool hex = name[1] == 'x'
            bool fine = name.len() > (hex ? 2 : 1)
            for (i64 i = hex ? 2 : 1; fine && i < name.len(); i++) {
                u8 c = name[i]
                i64 digit = c >= '0' && c <= '9' ? i64(c) - 48 : hex && c >= 'a' && c <= 'f' ? i64(c) - 87 :
                    hex && c >= 'A' && c <= 'F' ? i64(c) - 55 : -1
                fine = digit >= 0 && code <= 0x10FFFF
                code = code * (hex ? 16 : 10) + digit
            }
            if (!fine || code == 0 || code > 0x10FFFF || (code >= 0xD800 && code <= 0xDFFF)) {
                throw wrong(format("&{}; is not a character", name))
            }
            if (code < 0x80) {
                out.add(u8(code))
            } else if (code < 0x800) {
                out.add(u8(0xC0 | (code >> 6)))
                out.add(u8(0x80 | (code & 0x3F)))
            } else if (code < 0x10000) {
                out.add(u8(0xE0 | (code >> 12)))
                out.add(u8(0x80 | ((code >> 6) & 0x3F)))
                out.add(u8(0x80 | (code & 0x3F)))
            } else {
                out.add(u8(0xF0 | (code >> 18)))
                out.add(u8(0x80 | ((code >> 12) & 0x3F)))
                out.add(u8(0x80 | ((code >> 6) & 0x3F)))
                out.add(u8(0x80 | (code & 0x3F)))
            }
        } else {
            throw wrong(format("the entity &{}; is not known", name))
        }
        at = end + 1
    }

    Element readElement(i64 depth) {
        if (depth > 200) {
            throw wrong("the elements are more than 200 deep")
        }
        at++  // the <
        Element item
        item.name = readName()
        for {
            i64 before = at
            spaces()
            if (ended()) {
                throw wrong(format("the tag of {} does not end", item.name))
            }
            if (next("/>")) {
                at += 2
                ret item
            }
            if (source[at] == '>') {
                at++
                break
            }
            if (before == at) {
                throw wrong("a space is expected before an attribute")
            }
            Attribute added
            added.name = readName()
            if (item.hasAttribute(added.name)) {
                throw wrong(format("the attribute {} is written twice", added.name))
            }
            spaces()
            if (ended() || source[at] != '=') {
                throw wrong(format("the attribute {} has no =", added.name))
            }
            at++
            spaces()
            if (ended() || (source[at] != '"' && source[at] != '\'')) {
                throw wrong(format("the value of {} is between quotes", added.name))
            }
            u8 quote = source[at]
            at++
            list<u8> value
            for (!ended() && source[at] != quote) {
                if (source[at] == '&') {
                    entity(ref value)
                } else if (source[at] == '<') {
                    throw wrong("a < in the value of an attribute is written &lt;")
                } else {
                    value.add(source[at])
                    at++
                }
            }
            if (ended()) {
                throw wrong(format("the value of {} does not end", added.name))
            }
            at++
            added.value = string(value)
            item.attributes.add(move added)
        }
        list<u8> content
        for {
            if (ended()) {
                throw wrong(format("the element {} does not end", item.name))
            }
            if (next("</")) {
                at += 2
                string closed = readName()
                if (closed != item.name) {
                    throw wrong(format("</{}> closes {}", closed, item.name))
                }
                spaces()
                if (ended() || source[at] != '>') {
                    throw wrong(format("the tag </{}> does not end", closed))
                }
                at++
                break
            }
            if (next("<![CDATA[")) {
                i64 end = source.findFrom("]]>", at)
                if (end < 0) {
                    throw wrong("a CDATA does not end")
                }
                for (i64 i = at + 9; i < end; i++) {
                    content.add(source[i])
                }
                at = end + 3
            } else if (next("<!--")) {
                past("-->", "a comment")
            } else if (next("<?")) {
                past("?>", "an instruction")
            } else if (source[at] == '<') {
                item.children.add(readElement(depth + 1))
            } else if (source[at] == '&') {
                entity(ref content)
            } else {
                content.add(source[at])
                at++
            }
        }
        item.text = string(content)
        // The spaces and the lines between the elements are not a text.
        if (item.children.len() > 0 && item.text.trim().len() == 0) {
            item.text = ""
        }
        ret item
    }
}

// The element at the top of the document in 'text', with all that is inside it. The
// declaration, the comments and the instructions are passed over, a CDATA is its
// text, and the entities are read: the five of XML and the characters by their
// number, as '&#233;'. Throws an 'Error' with the line and the column for a text that
// is not well formed, as a tag that is not closed, and for an entity of a DTD, which
// is not known.
public Element parse(string text) {
    Reader reader
    reader.source = text.copy()
    if (text.len() >= 3 && text[0] == 0xEF && text[1] == 0xBB && text[2] == 0xBF) {
        reader.at = 3  // the mark of UTF-8 of some editors
    }
    reader.misc()
    if (reader.ended() || text[reader.at] != '<') {
        throw reader.wrong("an element is expected")
    }
    Element root = reader.readElement(0)
    reader.misc()
    if (!reader.ended()) {
        throw reader.wrong("the document has one element at its top")
    }
    ret root
}
