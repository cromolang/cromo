// WebSocket (RFC 6455): a connection that stays open and carries messages in both
// directions, texts or bytes, with TLS for wss. A client opens one with 'connect(url)';
// a handler of std.http turns its request into one with 'req.webSocket(...)'. Both
// sides then use a 'Socket': 'send' and 'sendBytes' send a message, 'receive()' waits
// for the next one, answering the pings by itself, and throws 'Closed' when the other
// side closes.
//
// '''
// websocket.Socket ws = websocket.connect("wss://example.com/chat")
// ws.send("hello")
// switch (ws.receive()) {
//     case Text(string text) {
//         println("{}", text)
//     }
//     case Binary(list<u8> bytes) {
//         println("{} bytes", bytes.len())
//     }
// }
// ws.close()
// '''
//
// The guide: [Networking and HTTP](https://cromolang.org/book/en/networking.html).

// For who works on std.websocket: D368.
import std.crypto
import std.net

// A message of a WebSocket: a text, or bytes.
public enum Message {
    Text(string text)       // a message of text, UTF-8
    Binary(list<u8> bytes)  // a message of bytes
}

// The exception of a WebSocket that is closed: 'receive()' throws it when the other
// side has closed, or the connection has ended, and so do 'send' and 'sendBytes' after
// a close.
//
// '''
// try {
//     for {
//         ws.receive()
//     }
// } catch (websocket.Closed e) {
//     println("closed: {} {}", e.code, e.reason)
// }
// '''
public struct Closed : Exception {
    // The code of the close: 1000 a normal end, 1001 a side that goes away, 1005 a
    // close without a code, 1006 a connection that ended without a close.
    public i32 code
    public string reason  // the reason that the other side gave, often ""

    // The text of the exception: "the WebSocket is closed: 1000", followed by the
    // reason when there is one.
    public string message() const {
        if (reason.len() > 0) {
            ret format("the WebSocket is closed: {} {}", code, reason)
        }
        ret format("the WebSocket is closed: {}", code)
    }
}

// A WebSocket, of a client from 'connect' or of a server from 'Request.webSocket' of
// std.http. Each call waits until it is done, or until the timeout; in a task, the wait
// leaves the thread to the other tasks. The destructor ends the connection without a
// close of WebSocket, which the other side sees as the code 1006: 'close()' ends it
// cleanly. It can be moved, not copied.
public struct Socket {
    net.Connection connection
    list<u8> pending  // read from the connection, not yet used
    i64 at
    bool client   // its frames are masked
    bool closing  // the close is sent
    i32 code      // of the close received, 0 before

    // Sends the text as one message. An exception on an error of the network or a
    // timeout, and 'Closed' after a close.
    public void send(string text) {
        sendFrame(1, text.bytes())
    }

    // Sends the bytes as one message, binary. An exception on an error of the network
    // or a timeout, and 'Closed' after a close.
    public void sendBytes(list<u8> bytes) {
        sendFrame(2, bytes)
    }

    // Sets how long each read and write waits, in milliseconds, as for a connection;
    // past it the call throws. -1, the default, lets 'receive()' wait as long as it
    // takes.
    public void timeout(i64 milliseconds) {
        connection.timeout(milliseconds)
    }

    // The next message, a text or bytes, waiting for it. The fragments of a message are
    // joined, and the pings that arrive meanwhile are answered. It throws 'Closed' when
    // the other side closes, after answering its close, or when the connection ends
    // without one, and again at each call after. An exception for a message larger
    // than 16 MiB, a frame that is not valid, a text that is not UTF-8, or a timeout.
    public Message receive() {
        if (code != 0) {
            throw closed(code, "")
        }
        list<u8> message
        i32 kind = 0
        for {
            u8 first = byte(0)
            u8 second = byte(1)
            i32 opcode = i32(first & 15)
            bool last = (first & 128) != 0
            i64 length = i64(second & 127)
            i64 head = 2
            if (length == 126) {
                length = i64(byte(2)) << 8 | i64(byte(3))
                head = 4
            } else if (length == 127) {
                length = 0
                for (i64 i = 0; i < 8; i++) {
                    length = length << 8 | i64(byte(2 + i))
                }
                head = 10
            }
            if (length < 0 || length + message.len() > maxMessage()) {
                throw Error("cannot receive: the message of the WebSocket is too large")
            }
            bool masked = (second & 128) != 0
            list<u8> mask
            if (masked) {
                for (i64 i = 0; i < 4; i++) {
                    mask.add(byte(head + i))
                }
                head += 4
            }
            fill(head + length)
            list<u8> payload
            payload.reserve(length)
            for (i64 i = 0; i < length; i++) {
                u8 b = pending[at + head + i]
                if (masked) {
                    b = b ^ mask[i % 4]
                }
                payload.add(b)
            }
            at += head + length
            if (opcode >= 8) {  // a control frame, between the fragments too
                control(opcode, payload)
                continue
            }
            if (opcode == 1 || opcode == 2) {
                kind = opcode
            } else if (opcode != 0 || kind == 0) {
                throw Error(format("cannot receive: the frame {} of the WebSocket is not valid", opcode))
            }
            for (u8 b in payload) {
                message.add(b)
            }
            if (last) {
                if (kind == 1) {
                    ret Message.Text(string(message))
                }
                ret Message.Binary(move message)
            }
        }
    }

    // Ends the WebSocket cleanly: sends the close, with the code 1000, and waits for
    // that of the other side, dropping the messages that arrive meanwhile, then closes
    // the connection. Without a timeout it waits as long as the other side takes to
    // answer; with one, an answer that does not come in time is an exception. Then
    // 'send' and 'receive()' throw 'Closed'.
    public void close() {
        if (!closing) {
            list<u8> payload
            payload.add(3)  // 1000, a normal end
            payload.add(232)
            sendFrame(8, payload)
            closing = true
        }
        try {
            for (code == 0) {
                receive()
            }
        } catch (Closed e) {
        }
        connection.close()
    }

    void control(i32 opcode, list<u8> payload) {
        if (opcode == 9) {  // ping: the pong with the same data
            sendFrame(10, payload)
            ret
        }
        if (opcode != 8) {  // pong
            ret
        }
        code = 1005  // a close without a code
        string reason = ""
        if (payload.len() >= 2) {
            code = i32(payload[0]) << 8 | i32(payload[1])
            list<u8> text
            for (i64 i = 2; i < payload.len(); i++) {
                text.add(payload[i])
            }
            reason = string(text)
        }
        if (!closing) {  // the answer to a close
            closing = true
            list<u8> answer
            if (payload.len() >= 2) {
                answer.add(payload[0])
                answer.add(payload[1])
            }
            try {
                sendFrame(8, answer)
            } catch (Exception e) {
            }
        }
        throw closed(code, reason)
    }

    void sendFrame(i32 opcode, list<u8> payload) {
        if (closing && opcode != 8) {
            throw closed(code, "")
        }
        list<u8> frame
        frame.reserve(payload.len() + 14)
        frame.add(u8(128 | opcode))
        u8 maskBit = 0
        if (client) {
            maskBit = 128
        }
        i64 length = payload.len()
        if (length < 126) {
            frame.add(maskBit | u8(length))
        } else if (length < 65536) {
            frame.add(maskBit | 126)
            frame.add(u8(length >> 8))
            frame.add(u8(length & 255))
        } else {
            frame.add(maskBit | 127)
            for (i64 i = 7; i >= 0; i--) {
                frame.add(u8((length >> (8 * i)) & 255))
            }
        }
        if (client) {  // RFC 6455: a client masks its frames
            list<u8> mask = crypto.random(4)
            for (u8 b in mask) {
                frame.add(b)
            }
            for (i64 i = 0; i < length; i++) {
                frame.add(payload[i] ^ mask[i % 4])
            }
        } else {
            for (u8 b in payload) {
                frame.add(b)
            }
        }
        connection.write(frame)
    }

    // The byte at `offset` from the first not used, reading as needed.
    u8 byte(i64 offset) {
        fill(offset + 1)
        ret pending[at + offset]
    }

    void fill(i64 count) {
        if (at > 0 && pending.len() - at < count) {  // the bytes used go
            list<u8> rest
            for (i64 i = at; i < pending.len(); i++) {
                rest.add(pending[i])
            }
            pending = move rest
            at = 0
        }
        for (pending.len() - at < count) {
            list<u8> bytes = connection.read(65536)
            if (bytes.len() == 0) {
                code = 1006
                throw closed(1006, "the connection ended")
            }
            for (u8 b in bytes) {
                pending.add(b)
            }
        }
    }
}

i64 maxMessage() {
    ret 16777216
}

Closed closed(i32 code, string reason) {
    Closed result
    result.code = code
    result.reason = reason.copy()
    ret result
}

// A WebSocket of a client, opened with a URL as "ws://host:port/path", or "wss://..."
// with TLS; without a port, 80 or 443. An exception if the URL does not start with
// ws:// or wss://, or its port is not a number, if the host is not found or cannot be
// reached, or if the server does not accept the WebSocket, with what it answered, as
// "HTTP/1.1 404 Not Found". Connecting, with the handshake of TLS, has no timeout; then
// the server must answer within 30 seconds. The socket it gives has no timeout.
public Socket connect(string url) {
    bool secure = startsWith(url, "wss://")
    if (!secure && !startsWith(url, "ws://")) {
        throw Error(format("cannot open the WebSocket '{}': the URL does not start with ws:// or wss://", url))
    }
    i64 start = 5
    i32 port = 80
    if (secure) {
        start = 6
        port = 443
    }
    i64 end = start
    for (end < url.len() && url[end] != '/' && url[end] != '?' && url[end] != '#') {
        end++
    }
    string authority = url.slice(start, end)
    string path = url.slice(end, url.len())
    i64 hash = path.find("#")
    if (hash >= 0) {
        path = path.slice(0, hash)
    }
    if (path.len() == 0 || path[0] == '?') {
        path = "/" + path
    }
    string host = authority.copy()
    i64 colon = authority.findLast(":")
    i64 bracket = authority.findLast("]")
    if (colon > bracket) {
        host = authority.slice(0, colon)
        port = i32(authority.slice(colon + 1, authority.len()))
    }
    if (host.startsWith("[") && host.endsWith("]")) {
        host = host.slice(1, host.len() - 1)
    }

    Socket socket
    socket.client = true
    if (secure) {
        socket.connection = net.connectTls(host, port)
    } else {
        socket.connection = net.connect(host, port)
    }
    socket.connection.timeout(30000)
    string key = crypto.base64(crypto.random(16))
    string request = format("GET {} HTTP/1.1\r\nHost: {}\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n", path, authority) +
        format("Sec-WebSocket-Key: {}\r\nSec-WebSocket-Version: 13\r\nUser-Agent: cromo\r\n\r\n", key)
    socket.connection.write(request.bytes())

    // The answer of the server: 101, and the key that proves it read ours.
    i64 headEnd = -1
    for (headEnd < 0) {
        list<u8> bytes = socket.connection.read(16384)
        if (bytes.len() == 0) {
            throw Error(format("cannot open the WebSocket {}: the server ended the connection", url))
        }
        for (u8 b in bytes) {
            socket.pending.add(b)
        }
        if (socket.pending.len() > 65536) {
            throw Error(format("cannot open the WebSocket {}: the answer is too large", url))
        }
        headEnd = findEnd(socket.pending)
    }
    list<u8> headBytes
    for (i64 i = 0; i < headEnd; i++) {
        headBytes.add(socket.pending[i])
    }
    socket.at = headEnd + 4
    list<string> lines = string(headBytes).split("\r\n")
    if (!lines[0].startsWith("HTTP/1.1 101")) {
        throw Error(format("cannot open the WebSocket {}: the server answered '{}'", url, lines[0]))
    }
    string accepted = ""
    for (string line in lines) {
        i64 at = line.find(":")
        if (at > 0 && line.slice(0, at).lower() == "sec-websocket-accept") {
            accepted = line.slice(at + 1, line.len()).trim()
        }
    }
    if (accepted != acceptKey(key)) {
        throw Error(format("cannot open the WebSocket {}: the server did not accept it", url))
    }
    socket.connection.timeout(-1)
    ret socket
}

// The WebSocket of a server, on a connection whose request it has answered with "101
// Switching Protocols", which is moved into it; it has no timeout. 'Request.webSocket'
// of std.http does all this: a program rarely needs it.
public Socket accepted(move net.Connection connection) {
    Socket socket
    socket.connection = move connection
    socket.connection.timeout(-1)
    ret socket
}

// The value of Sec-WebSocket-Accept that answers the Sec-WebSocket-Key of a request
// (RFC 6455): the base64 of the SHA-1 of the key with a fixed GUID.
public string acceptKey(string key) {
    ret crypto.base64(crypto.sha1((key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11").bytes()))
}

i64 findEnd(list<u8> bytes) {
    for (i64 i = 0; i + 3 < bytes.len(); i++) {
        if (bytes[i] == '\r' && bytes[i + 1] == '\n' && bytes[i + 2] == '\r' && bytes[i + 3] == '\n') {
            ret i
        }
    }
    ret -1
}

bool startsWith(string text, string start) {
    ret text.lower().startsWith(start)
}
