// Code that runs at the same time: the threads of the system (Thread), lightweight
// tasks that share a few threads (Task and Group), and what they use together:
// Mutex for data that change, Shared for a value that the handlers of the windows
// change too, Channel to pass values and Atomic for counters.
//
// The compiler checks what a thread or a task captures: while it runs, the code
// that started it cannot change what it reads, nor touch what it changes. Data that
// several of them change go in a Mutex.
//
// '''
// import std.thread
//
// thread.Atomic<i64> done
// thread.Group jobs
// for (i64 i = 0; i < 100; i++) {
//     jobs.start([done]() { done.add(1) })
// }
// jobs.wait()
// println("{}", done.load())   // 100
// '''
//
// The guide: [Threads, tasks and channels](https://cromolang.org/book/en/concurrency.html).

// The module std.thread (D214-D217, D269, D273, D326-D328): threads, tasks,
// groups of tasks, mutexes, channels and atomics. The threads of the system and the
// workers of the tasks are in the runtime; the compiler keeps a thread or a task
// whose lambda captures by address in its block, and checks what the block does
// while it runs (D215).
import unsafe

extern "cromo" {
    addr cromo_group_new()
    addr cromo_channel_ensure(addr slot, i64 capacity, i64 size)
    i64 cromo_channel_send(addr channel, addr value)     // 0: closed
    i64 cromo_channel_receive(addr channel, addr value)  // 0: closed and empty
    void cromo_channel_close(addr channel)
    i64 cromo_channel_drain(addr channel, addr value)  // 0: empty
    void cromo_channel_free(addr channel)
}

// A thread of the system, made from a lambda, started with start() and waited for
// with join(). An exception that ends the thread is thrown again by join(); one that
// no join() takes stops the program.
//
// A thread whose lambda captures by address, with 'ref' or by reading a value that
// is not simple, belongs to its block: if join() was not called, the block waits
// for the thread at its end. A thread that owns all that it uses, with 'move' or
// simple values, can outlive the block, as in a list.
//
// '''
// i64 total = 0
// thread.Thread worker = thread.Thread([ref total]() { total = 42 })
// worker.start()
// worker.join()
// '''
public struct Thread {
    func() body
    addr record  // of the runtime, from start() on
    bool joined

    // A thread that will run 'work', which is moved into it; it starts with start().
    public Thread(move func() work) {
        body = move work
    }

    // A thread still running is waited for; an exception that no join() took
    // stops the program (D217).
    ~Thread() {
        if (!started()) {
            ret
        }
        if (!joined && threadWait(record)) {
            threadUncaught(record)
        }
        threadFree(record)
    }

    // Starts the thread. Starting it a second time is a panic.
    public void start() {
        if (started()) {
            panic("the thread is already started (D214)")
        }
        record = threadStart(body)
    }

    // Waits for the end of the thread, and throws again the exception that ended it,
    // if any. A panic if the thread is not started or is already joined.
    public void join() {
        if (!started()) {
            panic("the thread is not started: call start() first (D214)")
        }
        if (joined) {
            panic("the thread is already joined (D214)")
        }
        joined = true
        if (threadWait(record)) {
            threadRethrow(record)
        }
    }

    bool started() const {
        addr none
        ret record != none
    }
}

// A lightweight task, with the interface and the rules of Thread: the runtime runs
// many tasks on a few threads of the system, one for each processor, and a task
// costs a few kilobytes. A task that waits, for the network, for time.sleep(), for
// a mutex, for a channel or for join(), leaves its thread to the other tasks. A task
// that blocks its thread, as in a C function, keeps it, and after about a
// millisecond the runtime gives the other tasks another thread.
//
// Use tasks for work that waits, as servers and clients of the network, and threads
// for long computations.
public struct Task {
    func() body
    addr record  // of the runtime, from start() on
    bool joined

    // A task that will run 'work', which is moved into it; it starts with start().
    public Task(move func() work) {
        body = move work
    }

    // A task still running is waited for; an exception that no join() took stops
    // the program (D217).
    ~Task() {
        if (!started()) {
            ret
        }
        if (!joined && threadWait(record)) {
            threadUncaught(record)
        }
        threadFree(record)
    }

    // Starts the task. Starting it a second time is a panic.
    public void start() {
        if (started()) {
            panic("the task is already started (D269)")
        }
        record = taskStart(body)
    }

    // Waits for the end of the task, and throws again the exception that ended it, if
    // any. A panic if the task is not started or is already joined.
    public void join() {
        if (!started()) {
            panic("the task is not started: call start() first (D269)")
        }
        if (joined) {
            panic("the task is already joined (D269)")
        }
        joined = true
        if (threadWait(record)) {
            threadRethrow(record)
        }
    }

    bool started() const {
        addr none
        ret record != none
    }
}

// Tasks started one by one, also in a loop, and waited for together. The tasks can
// read the variables declared before the group, which stay constant until the end
// of its block, and take others with 'move'; they cannot capture with 'ref'. At the
// end of its block the group waits for all its tasks, and an exception that no
// wait() took stops the program.
public struct Group {
    addr record  // of the runtime, from the first start() on

    // An exception that no wait() took stops the program (D217).
    ~Group() {
        addr none
        if (record == none) {
            ret
        }
        if (threadWait(record)) {
            threadUncaught(record)
        }
        threadFree(record)
    }

    // Starts a task of the group that runs 'work', which is moved into it.
    public void start(move func() work) {
        addr none
        if (record == none) {
            record = cromo_group_new()
        }
        groupStart(record, move work)
    }

    // Waits for the tasks started so far, and throws again the first exception of
    // one of them; the others are lost.
    public void wait() {
        addr none
        if (record != none && threadWait(record)) {
            threadRethrow(record)
        }
    }
}

// Data that threads and tasks share and change, which start with the default value
// of T. They are reached only inside lock(), by one at a time, so a lock cannot be
// forgotten.
public struct Mutex<T> {
    u64 state  // the lock of the system, free at zero: the first field
    T data

    ~Mutex() {
    }

    // Locks the mutex, calls 'body' with the data by 'ref', and unlocks it at the end
    // of 'body', also when an exception goes through. Who finds it locked waits; a
    // task leaves its thread to the others meanwhile. Locking the same mutex again
    // inside 'body' waits for ever.
    //
    // '''
    // thread.Mutex<i64> counter
    // counter.lock([](ref i64 n) { n++ })
    // '''
    public void lock(func(ref T) body) const {
        // const: the threads of a block read the same mutex (D215), and the lock
        // gives them 'ref' to the data one at a time.
        addr me = selfAddress()
        mutexLock(me)
        addr place = offset(me, 8)  // the data, after the lock
        T value = take<T>(place)
        try {
            body(ref value)
        } finally {
            put<T>(place, move value)
            mutexUnlock(me)
        }
    }
}

// A value that the handlers of the windows, the threads and the tasks change: a handle
// to the value with its lock, which stays until the end of the program. A handle is a
// simple value, copied freely: every copy reaches the same value, and a lambda that is
// kept, as a handler of a window, captures it by copy, where a 'Mutex' could not go.
// The value is reached only inside 'lock', by one at a time.
//
// '''
// thread.Shared<i64> clicks = thread.Shared<i64>(0)
// button.onClick([clicks, label]() {
//     clicks.lock([label](ref i64 n) {
//         n++
//         label.setText(format("{} clicks", n))
//     })
// })
// '''
public struct Shared<T> {
    addr place  // the lock of the system, then the value, on the heap

    // Keeps the value, moved here, for the whole program.
    public Shared(move T value) {
        place = alloc(8 + sizeOf<T>())
        put<u64>(place, 0)
        put<T>(offset(place, 8), move value)
    }

    // Locks the value, calls 'body' with it by 'ref', and unlocks it at the end of
    // 'body', also when an exception goes through. Who finds it locked waits; a task
    // leaves its thread to the others meanwhile. Locking it again inside 'body' waits
    // for ever. A 'Shared' declared without a value has none: locking it is a panic.
    public void lock(func(ref T) body) const {
        addr none
        if (place == none) {
            panic("this thread.Shared has no value: make it with thread.Shared<T>(value)")
        }
        mutexLock(place)
        addr at = offset(place, 8)
        T value = take<T>(at)
        try {
            body(ref value)
        } finally {
            put<T>(at, move value)
            mutexUnlock(place)
        }
    }
}

// Values passed from task to task and from thread to thread, in the order they are
// sent. It holds up to a capacity of values, given to its constructor; with
// capacity 0, the default, the sender waits until a receiver has the value. close()
// ends it, and 'for (T v in channel)' receives until then. The values still in the
// channel when it is destroyed are destroyed with it.
//
// '''
// thread.Channel<string> lines = thread.Channel<string>(16)
// thread.Task reader = thread.Task([lines]() {
//     for (string line in lines) {
//         println("{}", line)
//     }
// })
// reader.start()
// lines.send("hello")
// lines.close()
// reader.join()
// '''
public struct Channel<T> {
    addr record  // of the runtime, made by the first use: the first field
    i64 capacity

    // A channel that holds up to 'count' values before send() waits; with 0, the
    // sender waits until a receiver has the value. A negative count is a panic.
    public Channel(i64 count) {
        if (count < 0) {
            panic(format("the capacity of a channel is 0 or more, found {} (D326)", count))
        }
        capacity = count
    }

    // The values still in the channel end with it.
    ~Channel() {
        addr none
        if (record == none) {
            ret
        }
        addr place = alloc(sizeOf<T>())
        for (cromo_channel_drain(record, place) != 0) {
            destroy<T>(place)
        }
        free(place)
        cromo_channel_free(record)
    }

    // Sends the value, which is moved into the channel, and waits while the channel
    // is full. Throws if the channel is closed; the value is then destroyed.
    public void send(move T value) const {
        addr place = alloc(sizeOf<T>())
        put<T>(place, move value)
        if (cromo_channel_send(own(), place) == 0) {
            destroy<T>(place)
            free(place)
            throw Error("cannot send: the channel is closed (D327)")
        }
        free(place)
    }

    // The next value, in the order they were sent; waits while the channel is empty.
    // Throws once the channel is closed and empty.
    public T receive() const {
        addr place = alloc(sizeOf<T>())
        if (cromo_channel_receive(own(), place) == 0) {
            free(place)
            throw Error("cannot receive: the channel is closed (D327)")
        }
        T value = take<T>(place)
        free(place)
        ret value
    }

    // As receive(), but without the exception: puts the next value in 'value' and
    // gives true, or gives false, with 'value' unchanged, once the channel is closed
    // and empty. It is the step of 'for (T v in channel)'.
    public bool next(ref T value) const {
        addr place = alloc(sizeOf<T>())
        bool received = cromo_channel_receive(own(), place) != 0
        if (received) {
            value = take<T>(place)
        }
        free(place)
        ret received
    }

    // Closes the channel: from then on send() throws, while the values already sent
    // can still be received; after them receive() throws and the loops on the
    // channel end. A second close() does nothing.
    public void close() const {
        cromo_channel_close(own())
    }

    addr own() const {
        ret cromo_channel_ensure(selfAddress(), capacity, sizeOf<T>())
    }
}

// An integer or a bool that threads and tasks read and change together without a
// lock. Each operation happens whole, and all of them in one order that every
// thread sees, the sequential consistency. An atomic cannot be copied: the threads
// and the tasks capture it by reading it.
public struct Atomic<T> {
    T state

    // An atomic with the value 'initial'; one declared without a value starts with 0
    // or false.
    public Atomic(move T initial) {
        state = move initial
    }

    // No copies: two threads would see two values.
    ~Atomic() {
    }

    // The value.
    public T load() const {
        ret atomicLoad<T>(selfAddress())
    }

    // Writes the value.
    public void store(T value) const {
        atomicStore<T>(selfAddress(), value)
    }

    // Adds 'amount', and gives the value before; for an integer only.
    public T add(T amount) const {
        ret atomicAdd<T>(selfAddress(), amount)
    }

    // Writes the value, and gives the one before.
    public T exchange(T value) const {
        ret atomicExchange<T>(selfAddress(), value)
    }

    // Writes 'desired' only if the value is 'expected', in one step: true if it did.
    public bool compareExchange(T expected, T desired) const {
        ret atomicCompareExchange<T>(selfAddress(), expected, desired)
    }
}
