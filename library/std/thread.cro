// The module std.thread (D214-D217, D269, D273, D326-D328): threads, tasks,
// groups of tasks, mutexes, channels and atomics. The threads of the system and the
// workers of the tasks are in the runtime; the compiler keeps a thread or a task
// whose lambda captures by address in its block, and checks what the block does
// while it runs (D215).
import unsafe

extern "cromo" {
    addr cromo_group_new()
    addr cromo_channel_ensure(addr slot, i64 capacity, i64 size)
    i64 cromo_channel_send(addr channel, addr value)     // 0: closed
    i64 cromo_channel_receive(addr channel, addr value)  // 0: closed and empty
    void cromo_channel_close(addr channel)
    i64 cromo_channel_drain(addr channel, addr value)  // 0: empty
    void cromo_channel_free(addr channel)
}

// A thread made from a lambda, started with start() and waited for with join().
public struct Thread {
    func() body
    addr record  // of the runtime, from start() on
    bool joined

    public Thread(move func() work) {
        body = move work
    }

    // A thread still running is waited for; an exception that no join() took
    // stops the program (D217).
    ~Thread() {
        if (!started()) {
            ret
        }
        if (!joined && threadWait(record)) {
            threadUncaught(record)
        }
        threadFree(record)
    }

    public void start() {
        if (started()) {
            panic("the thread is already started (D214)")
        }
        record = threadStart(body)
    }

    // Waits for the end of the thread, and throws again its exception (D217).
    public void join() {
        if (!started()) {
            panic("the thread is not started: call start() first (D214)")
        }
        if (joined) {
            panic("the thread is already joined (D214)")
        }
        joined = true
        if (threadWait(record)) {
            threadRethrow(record)
        }
    }

    bool started() const {
        addr none
        ret record != none
    }
}

// A lightweight task (D269), with the interface and the rules of Thread: many of
// them run on a few threads of the system. A task that waits for the network, for
// time.sleep, for a mutex or for join() leaves its thread to the others.
public struct Task {
    func() body
    addr record  // of the runtime, from start() on
    bool joined

    public Task(move func() work) {
        body = move work
    }

    // A task still running is waited for; an exception that no join() took stops
    // the program (D217).
    ~Task() {
        if (!started()) {
            ret
        }
        if (!joined && threadWait(record)) {
            threadUncaught(record)
        }
        threadFree(record)
    }

    public void start() {
        if (started()) {
            panic("the task is already started (D269)")
        }
        record = taskStart(body)
    }

    // Waits for the end of the task, and throws again its exception (D217).
    public void join() {
        if (!started()) {
            panic("the task is not started: call start() first (D269)")
        }
        if (joined) {
            panic("the task is already joined (D269)")
        }
        joined = true
        if (threadWait(record)) {
            threadRethrow(record)
        }
    }

    bool started() const {
        addr none
        ret record != none
    }
}

// Tasks started one by one, also in a loop (D273): they can read the variables
// declared before the group, which stay constant until the end of its block, and
// there the group waits for all of them.
public struct Group {
    addr record  // of the runtime, from the first start() on

    // An exception that no wait() took stops the program (D217).
    ~Group() {
        addr none
        if (record == none) {
            ret
        }
        if (threadWait(record)) {
            threadUncaught(record)
        }
        threadFree(record)
    }

    public void start(move func() work) {
        addr none
        if (record == none) {
            record = cromo_group_new()
        }
        groupStart(record, move work)
    }

    // Waits for the tasks started so far, and throws again the first exception of
    // one of them; the others are lost.
    public void wait() {
        addr none
        if (record != none && threadWait(record)) {
            threadRethrow(record)
        }
    }
}

// The data of a mutex are reached only while it is locked, in a lambda (D216).
public struct Mutex<T> {
    u64 state  // the lock of the system, free at zero: the first field
    T data

    ~Mutex() {
    }

    // const: the threads of a block read the same mutex (D215), and the lock gives
    // them `ref` to the data one at a time.
    public void lock(func(ref T) body) const {
        addr me = selfAddress()
        mutexLock(me)
        addr place = offset(me, 8)  // the data, after the lock
        T value = take<T>(place)
        try {
            body(ref value)
        } finally {
            put<T>(place, move value)
            mutexUnlock(me)
        }
    }
}

// Values passed from task to task and from thread to thread, in the order they are
// sent (D326). It holds up to `capacity` values; with capacity 0, the default, the
// sender waits until a receiver has the value. close() ends it (D327).
public struct Channel<T> {
    addr record  // of the runtime, made by the first use: the first field
    i64 capacity

    public Channel(i64 count) {
        if (count < 0) {
            panic(format("the capacity of a channel is 0 or more, found {} (D326)", count))
        }
        capacity = count
    }

    // The values still in the channel end with it.
    ~Channel() {
        addr none
        if (record == none) {
            ret
        }
        addr place = alloc(sizeOf<T>())
        for (cromo_channel_drain(record, place) != 0) {
            destroy<T>(place)
        }
        free(place)
        cromo_channel_free(record)
    }

    // Waits while the channel is full; throws if it is closed (D327).
    public void send(move T value) const {
        addr place = alloc(sizeOf<T>())
        put<T>(place, move value)
        if (cromo_channel_send(own(), place) == 0) {
            destroy<T>(place)
            free(place)
            throw Error("cannot send: the channel is closed (D327)")
        }
        free(place)
    }

    // Waits while the channel is empty; throws once it is closed and empty (D327).
    public T receive() const {
        addr place = alloc(sizeOf<T>())
        if (cromo_channel_receive(own(), place) == 0) {
            free(place)
            throw Error("cannot receive: the channel is closed (D327)")
        }
        T value = take<T>(place)
        free(place)
        ret value
    }

    // As receive(), but false once the channel is closed and empty: the step of
    // `for (T v in channel)`.
    public bool next(ref T value) const {
        addr place = alloc(sizeOf<T>())
        bool received = cromo_channel_receive(own(), place) != 0
        if (received) {
            value = take<T>(place)
        }
        free(place)
        ret received
    }

    // The values already sent can still be received; a second close() does nothing.
    public void close() const {
        cromo_channel_close(own())
    }

    addr own() const {
        ret cromo_channel_ensure(selfAddress(), capacity, sizeOf<T>())
    }
}

// An integer or a bool that the threads and the tasks read and write together,
// each operation in the one order of the sequence (D328).
public struct Atomic<T> {
    T state

    public Atomic(move T initial) {
        state = move initial
    }

    // No copies: two threads would see two values.
    ~Atomic() {
    }

    public T load() const {
        ret atomicLoad<T>(selfAddress())
    }

    public void store(T value) const {
        atomicStore<T>(selfAddress(), value)
    }

    // Adds, and returns the value before; an integer only.
    public T add(T amount) const {
        ret atomicAdd<T>(selfAddress(), amount)
    }

    // Writes the value, and returns the one before.
    public T exchange(T value) const {
        ret atomicExchange<T>(selfAddress(), value)
    }

    // Writes `desired` only if the value is `expected`: true if it did.
    public bool compareExchange(T expected, T desired) const {
        ret atomicCompareExchange<T>(selfAddress(), expected, desired)
    }
}
