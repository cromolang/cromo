// std.runtime on Linux (D202, D393): the system calls, through systemCall, whose
// numbers are in runtime_linux_x86_64.cro and runtime_linux_arm64.cro (D408, P23).
import unsafe

extern "cromo" {
    void cromo_pause()                                    // in assembly: the hint of a loop that waits for another thread
    addr cromo_heap_cache()                               // in the runtime in C: the cache of the heap of this thread, or addr(0)
    i32 cromo_app_write(i64 stream, addr data, i64 size)  // the log of an app of Android (P44)
}

// ---- The heap (D98) ----
//
// A simple allocator on top of mmap. Every block starts with 16 bytes that hold
// how many bytes it can contain. The small blocks, up to 128 KB with those 16
// bytes, have a size that is a power of two from 32 bytes: they are cut from areas
// of 4 MB, whose pages the system gives when they are used, and the freed ones are
// kept in a list for each size, linked through their first 8 bytes. The larger
// blocks have a mapping of their own, as for malloc of glibc: a mapping for every
// block of a few KB costs two system calls, which wait for each other in a process
// with threads.
//
// The lists and the area are of all the threads, under the lock of the heap. In a
// program with threads each thread has lists of its own in front of them, its
// cache, which it reads and writes without the lock: 13 lists and then the 13
// numbers of their blocks, in the block of the thread of the runtime in C. An
// empty list of the cache takes some blocks from the shared ones at once, and one
// that grows too long gives half of them back, so the lock is taken once every
// many allocations, and the threads do not wait for each other. A block can be
// freed by another thread than the one that allocated it: it goes in the cache of
// the one that frees it. A thread without a cache, as the main one with glibc or
// one that the runtime did not start, uses the shared lists.

addr[13] freeBlocks  // of 32 bytes, 64, ..., 128 KB
addr areaNext
u64 areaLeft
u32 heapLock  // 0 free, 1 taken, 2 taken with threads waiting

addr heapAlloc(u64 size) {
    u64 total = size + 16
    if (total > smallLimit()) {
        total = pagesFor(total)
        addr mapping = mapPages(total)
        if (mapping == addr(0)) {
            ret mapping
        }
        put<u64>(mapping, total - 16)
        ret offset(mapping, 16)
    }
    i64 index = sizeIndex(total)
    addr block
    addr cache = addr(0)
    if (threaded) {
        cache = cromo_heap_cache()
    }
    if (cache == addr(0)) {
        lockHeap()
        block = sharedBlock(index)
        unlockHeap()
    } else {
        addr head = offset(cache, index * 8)
        block = copyAt<addr>(head)
        if (block == addr(0)) {
            block = refill(cache, index)
        } else {
            put<addr>(head, copyAt<addr>(block))
            addr count = offset(cache, 104 + index * 8)
            put<i64>(count, copyAt<i64>(count) - 1)
        }
    }
    if (block == addr(0)) {
        ret block
    }
    put<u64>(block, (u64(32) << index) - 16)  // where a list kept the next block
    ret offset(block, 16)
}

// A block of the shared lists, or cut from the area, with the lock taken: its
// first 16 bytes are not written yet. addr(0) when the system gives no memory.
addr sharedBlock(i64 index) {
    addr block = freeBlocks[index]
    if (block != addr(0)) {
        freeBlocks[index] = copyAt<addr>(block)
        ret block
    }
    u64 total = u64(32) << index
    if (areaLeft < total) {  // the rest of the old area is not used, nor touched
        addr area = mapPages(areaSize())
        if (area == addr(0)) {
            ret area
        }
        areaNext = area
        areaLeft = areaSize()
    }
    block = areaNext
    areaNext = offset(areaNext, i64(total))
    areaLeft -= total
    ret block
}

// How many blocks of a size a cache takes and gives back at once: 32 up to 2 KB,
// then half for each size, down to one.
i64 batch(i64 index) {
    if (index <= 6) {
        ret 32
    }
    if (index >= 11) {
        ret 1
    }
    ret 32 >> (index - 6)
}

// An empty list of the cache: a block for who asks, and the others of a batch in
// the list. It is cold, so that heapAlloc stays short.
[[cold]]
addr refill(addr cache, i64 index) {
    lockHeap()
    addr first = sharedBlock(index)
    if (first != addr(0)) {
        addr head = offset(cache, index * 8)
        i64 taken = 0
        for (i64 k = 1; k < batch(index); k++) {
            addr block = sharedBlock(index)
            if (block == addr(0)) {
                break
            }
            put<addr>(block, copyAt<addr>(head))
            put<addr>(head, block)
            taken++
        }
        addr count = offset(cache, 104 + index * 8)
        put<i64>(count, copyAt<i64>(count) + taken)
    }
    unlockHeap()
    ret first
}

void heapFree(addr memory) {
    addr block = offset(memory, -16)
    u64 total = copyAt<u64>(block) + 16
    if (total > smallLimit()) {
        systemCall(i64(Call.Munmap), block, i64(total), 0, 0, 0, 0)
        ret
    }
    i64 index = sizeIndex(total)
    addr cache = addr(0)
    if (threaded) {
        cache = cromo_heap_cache()
    }
    if (cache == addr(0)) {
        lockHeap()
        put<addr>(block, freeBlocks[index])
        freeBlocks[index] = block
        unlockHeap()
        ret
    }
    addr head = offset(cache, index * 8)
    put<addr>(block, copyAt<addr>(head))
    put<addr>(head, block)
    addr count = offset(cache, 104 + index * 8)
    i64 held = copyAt<i64>(count) + 1
    put<i64>(count, held)
    if (held > 2 * batch(index)) {
        spill(cache, index, batch(index))
    }
}

// Gives `blocks` blocks of a list of the cache back to the shared one.
[[cold]]
void spill(addr cache, i64 index, i64 blocks) {
    addr head = offset(cache, index * 8)
    addr count = offset(cache, 104 + index * 8)
    lockHeap()
    for (i64 k = 0; k < blocks; k++) {
        addr block = copyAt<addr>(head)
        put<addr>(head, copyAt<addr>(block))
        put<addr>(block, freeBlocks[index])
        freeBlocks[index] = block
    }
    unlockHeap()
    put<i64>(count, copyAt<i64>(count) - blocks)
}

// The runtime in C calls it when a thread ends, with its cache: its blocks go
// back to the shared lists, for the other threads.
[[export("cromo_heap_flush")]]
void flushCache(addr cache) {
    for (i64 index = 0; index < 13; index++) {
        i64 held = copyAt<i64>(offset(cache, 104 + index * 8))
        if (held > 0) {
            spill(cache, index, held)
        }
    }
}

addr heapResize(addr memory, u64 size) {
    addr block = offset(memory, -16)
    u64 capacity = copyAt<u64>(block)
    if (size <= capacity) {
        ret memory
    }
    if (capacity + 16 > smallLimit()) {  // a large block grows with its mapping
        u64 total = pagesFor(size + 16)
        addr moved = mapped(systemCall(i64(Call.Mremap), block, i64(capacity + 16), i64(total), 1, 0, 0))  // MREMAP_MAYMOVE
        if (moved == addr(0)) {
            ret moved
        }
        put<u64>(moved, total - 16)
        ret offset(moved, 16)
    }
    addr result = heapAlloc(size)
    if (result == addr(0)) {
        ret result
    }
    copyMemory(result, memory, i64(capacity))
    heapFree(memory)
    ret result
}

// The list of a small block: 0 for 32 bytes, 1 for 64, and so on.
i64 sizeIndex(u64 total) {
    i64 index = 0
    for (u64(32) << index < total) {
        index++
    }
    ret index
}

u64 smallLimit() {
    ret 131072  // 128 KB
}

u64 areaSize() {
    ret 4194304  // 4 MB
}

u64 pagesFor(u64 size) {
    ret size + 4095 & !u64(4095)
}

// Pages of a mapping of their own, readable and writable, or addr(0).
addr mapPages(u64 size) {
    ret mapped(systemCall(i64(Call.Mmap), 0, i64(size), 3, 0x22, -1, 0))  // PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS
}

// The address that mmap and mremap give, or addr(0) for an error, from -4095 to -1.
addr mapped(i64 result) {
    if (result < 0 && result > -4096) {
        ret addr(0)
    }
    ret addr(result)
}

// ---- The lock of the heap (Drepper, "Futexes are tricky") ----
//
// It is held briefly, and only by a thread without a cache or by one that fills
// or empties a list of its cache: a short spin before sleeping, as the SRWLOCK of
// Windows does, avoids a sleep and a wake.

void lockHeap() {
    if (!threaded) {
        ret
    }
    addr state = variableAddress(heapLock)
    if (atomicCompareExchange<u32>(state, 0, 1)) {
        ret
    }
    u32 seen = atomicLoad<u32>(state)
    for (i64 spins = 0; spins < 100 && seen != 2; spins++) {
        cromo_pause()
        seen = atomicLoad<u32>(state)
        if (seen == 0 && atomicCompareExchange<u32>(state, 0, 1)) {
            ret
        }
    }
    if (seen != 2) {
        seen = atomicExchange<u32>(state, 2)
    }
    for (seen != 0) {
        systemCall(i64(Call.Futex), state, 128, 2, 0, 0, 0)  // FUTEX_WAIT | FUTEX_PRIVATE, while it is 2
        seen = atomicExchange<u32>(state, 2)
    }
}

void unlockHeap() {
    if (!threaded) {
        ret
    }
    addr state = variableAddress(heapLock)
    if (atomicExchange<u32>(state, 0) == 2) {
        systemCall(i64(Call.Futex), state, 129, 1, 0, 0, 0)  // FUTEX_WAKE | FUTEX_PRIVATE, one thread
    }
}

// ---- The output (P25) ----

// The bytes of a buffer on the standard output (1) or error (2). With nowhere to
// write, the text is lost, as on Windows.
void writeRaw(i64 stream, addr data, i64 size) {
    if (cromo_app_write(stream, data, size) != 0) {
        ret
    }
    i64 descriptor = 1
    if (stream == 2) {
        descriptor = 2
    }
    i64 done = 0
    for (done < size) {
        i64 written = systemCall(i64(Call.Write), descriptor, offset(data, done), size - done, 0, 0, 0)
        if (written == -4) {  // EINTR
            continue
        }
        if (written <= 0) {
            ret
        }
        done += written
    }
}
