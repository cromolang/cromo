// Clocks and pauses: now() reads a monotonic clock to measure how long something
// takes, utcNow() and localNow() give the date and the time, unix() the seconds from
// 1970, and sleep(), msleep() and usleep() pause the program.
//
// '''
// import std.time
//
// time.Instant start = time.now()
// time.msleep(50)
// println("{} ms", start.elapsed().milliseconds())
// println("{}", time.localNow().text())   // 2026-10-29T14:03:12.250+01:00
// '''
//
// The guide: [Files, processes and time](https://cromolang.org/book/en/system.html).

// The module std.time (D203): a monotonic clock to measure, the date and the
// time in UTC and in the zone of the system, and pauses. The clocks are in
// time_windows.cro and time_linux.cro (D202), with:
//   i64 monotonic()               nanoseconds from an origin of the system
//   i64 unixNanoseconds()         nanoseconds from 1970-01-01 UTC
//   i32 localOffset(i64 seconds)  the offset of the zone at that time, in minutes
//   void pause(i64 nanoseconds)

// A span of time, as elapsed() and since() give it.
public struct Duration {
    public i64 nanoseconds  // the whole span, in nanoseconds

    // The span in seconds, with their fractions.
    public f64 seconds() const {
        ret f64(nanoseconds) / 1e9
    }

    // The whole milliseconds of the span, without the rest.
    public i64 milliseconds() const {
        ret nanoseconds / 1000000
    }

    // The whole microseconds of the span, without the rest.
    public i64 microseconds() const {
        ret nanoseconds / 1000
    }
}

// A moment of the monotonic clock, from now(). That clock never goes back, also
// when the date of the system changes: it serves to measure how long something
// takes.
public struct Instant {
    i64 ticks

    // The time from this instant to now.
    public Duration elapsed() const {
        Duration result
        result.nanoseconds = monotonic() - ticks
        ret result
    }

    // The time from 'earlier' to this instant; negative if 'earlier' comes after it.
    public Duration since(Instant earlier) const {
        Duration result
        result.nanoseconds = ticks - earlier.ticks
        ret result
    }
}

// A date with the time of day, in UTC or in the zone of the system, from utcNow()
// or localNow().
public struct DateTime {
    public i32 year        // with all its digits: 2026
    public i32 month       // 1 to 12
    public i32 day         // 1 to 31
    public i32 hour        // 0 to 23
    public i32 minute      // 0 to 59
    public i32 second      // 0 to 59
    public i32 nanosecond  // 0 to 999999999
    public i32 offset      // from UTC, in minutes: 60 in Rome in winter, 0 in UTC

    // The date and the time in the format of ISO 8601, with the milliseconds:
    // "2026-10-29T14:03:12.250+01:00", or with Z at the end in UTC.
    public string text() const {
        string zone = "Z"
        if (offset != 0) {
            i32 minutes = offset
            string sign = "+"
            if (minutes < 0) {
                sign = "-"
                minutes = -minutes
            }
            zone = format("{}{:02}:{:02}", sign, minutes / 60, minutes % 60)
        }
        ret format("{:04}-{:02}-{:02}T{:02}:{:02}:{:02}.{:03}{}", year, month, day, hour, minute, second,
            nanosecond / 1000000, zone)
    }
}

// The present moment of the monotonic clock, to measure the time until a later
// one with elapsed() or since().
public Instant now() {
    Instant result
    result.ticks = monotonic()
    ret result
}

// The seconds from 1970-01-01 UTC, the time of Unix, which fs.modified() and the
// times of a JSON Web Token use too.
public i64 unix() {
    i64 nanoseconds = unixNanoseconds()
    i64 seconds = nanoseconds / 1000000000
    if (nanoseconds % 1000000000 < 0) {
        seconds--  // before 1970 too, the second that has begun
    }
    ret seconds
}

// The date and the time now, in UTC.
public DateTime utcNow() {
    ret dateTime(unixNanoseconds(), 0)
}

// The date and the time now, in the zone of the system, whose offset from UTC is
// in the field offset. On Linux the zone is that of /etc/localtime, and UTC
// without it.
public DateTime localNow() {
    i64 now = unixNanoseconds()
    ret dateTime(now, localOffset(now / 1000000000))
}

// Pauses for 'seconds' seconds; in a task, the task waits and its thread runs the
// other tasks. Nothing happens for 0 or less.
public void sleep(i64 seconds) {
    pause(seconds * 1000000000)
}

// Pauses for 'milliseconds' milliseconds, as sleep() does.
public void msleep(i64 milliseconds) {
    pause(milliseconds * 1000000)
}

// Pauses for 'microseconds' microseconds, as sleep() does.
public void usleep(i64 microseconds) {
    pause(microseconds * 1000)
}

// The date of `nanoseconds` from 1970-01-01 UTC, moved by `offset` minutes, with
// the algorithm of Howard Hinnant for the days.
DateTime dateTime(i64 nanoseconds, i32 offset) {
    i64 seconds = nanoseconds / 1000000000 + i64(offset) * 60
    i64 days = seconds / 86400
    i64 rest = seconds % 86400
    i64 shifted = days + 719468
    i64 era = shifted / 146097
    i64 dayOfEra = shifted - era * 146097
    i64 yearOfEra = (dayOfEra - dayOfEra / 1460 + dayOfEra / 36524 - dayOfEra / 146096) / 365
    i64 dayOfYear = dayOfEra - (365 * yearOfEra + yearOfEra / 4 - yearOfEra / 100)
    i64 shiftedMonth = (5 * dayOfYear + 2) / 153  // from March
    DateTime result
    result.year = i32(yearOfEra + era * 400)
    result.day = i32(dayOfYear - (153 * shiftedMonth + 2) / 5 + 1)
    result.month = i32(shiftedMonth + 3)
    if (shiftedMonth >= 10) {
        result.month = i32(shiftedMonth - 9)
        result.year++
    }
    result.hour = i32(rest / 3600)
    result.minute = i32(rest % 3600 / 60)
    result.second = i32(rest % 60)
    result.nanosecond = i32(nanoseconds % 1000000000)
    result.offset = offset
    ret result
}

// The days from 1970-01-01 to a date, for the rules of the zones.
i64 daysFromCivil(i64 year, i64 month, i64 day) {
    i64 y = year
    if (month <= 2) {
        y--
    }
    i64 era = y / 400
    i64 yearOfEra = y - era * 400
    i64 shiftedMonth = (month + 9) % 12
    i64 dayOfYear = (153 * shiftedMonth + 2) / 5 + day - 1
    ret era * 146097 + yearOfEra * 365 + yearOfEra / 4 - yearOfEra / 100 + dayOfYear - 719468
}
