// std.os on Windows (D202): the functions of kernel32, with the texts in UTF-16.
import unsafe

extern "kernel32" {
    u32 GetEnvironmentVariableW(addr name, addr value, u32 size)
    u32 GetCurrentProcessId()
    u32 GetCurrentDirectoryW(u32 size, addr buffer)
    i32 MultiByteToWideChar(u32 page, u32 flags, addr text, i32 size, addr wide, i32 wideSize)
    i32 WideCharToMultiByte(u32 page, u32 flags, addr wide, i32 size, addr text, i32 textSize, addr fallback, addr used)
    i64 GetStdHandle(u32 which)
    i32 GetConsoleMode(i64 console, ref u32 mode)
    i32 ReadConsoleW(i64 console, addr buffer, u32 count, ref u32 read, addr control)
    i32 ReadFile(i64 file, addr data, u32 size, ref u32 done, addr overlapped)
}

// The name of the system: "windows", or "linux", also on Android.
public string name() {
    ret "windows"
}

// The id that the system gives to this process.
public i64 processId() {
    ret i64(GetCurrentProcessId())
}

// Whether the variable 'name' is in the environment, also with an empty value. On
// Windows the names do not distinguish upper and lower case.
public bool hasEnv(string name) {
    addr none
    addr key = wide(name)
    u32 size = GetEnvironmentVariableW(key, none, 0)
    free(key)
    ret size > 0
}

// The value of the variable 'name' of the environment, or "" when it is not set:
// hasEnv tells an empty value from a missing one. On Windows the names do not
// distinguish upper and lower case.
public string env(string name) {
    addr none
    addr key = wide(name)
    u32 size = GetEnvironmentVariableW(key, none, 0)
    if (size == 0) {
        free(key)
        ret ""
    }
    addr buffer = alloc(i64(size) * 2)
    u32 length = GetEnvironmentVariableW(key, buffer, size)
    free(key)
    string value = narrow(buffer, i32(length))
    free(buffer)
    ret value
}

// The absolute path of the current folder, from which the relative paths start.
public string currentFolder() {
    addr none
    u32 size = GetCurrentDirectoryW(0, none)
    addr buffer = alloc(i64(size) * 2)
    u32 length = GetCurrentDirectoryW(size, buffer)
    string folder = narrow(buffer, i32(length))
    free(buffer)
    ret folder
}

// The text in UTF-16 with a zero at the end, for Windows: to be freed.
addr wide(string text) {
    addr none
    i32 n = i32(text.len())
    i32 size = MultiByteToWideChar(65001, 0, text.cstring(), n, none, 0) + 1
    addr buffer = alloc(i64(size) * 2)
    i32 written = MultiByteToWideChar(65001, 0, text.cstring(), n, buffer, size)
    put<u16>(offset(buffer, i64(written) * 2), 0)
    ret buffer
}

// `count` characters of UTF-16 as a string.
string narrow(addr text, i32 count) {
    addr none
    if (count == 0) {
        ret ""
    }
    i32 size = WideCharToMultiByte(65001, 0, text, count, none, 0, none, none)
    addr buffer = alloc(i64(size))
    WideCharToMultiByte(65001, 0, text, count, buffer, size, none, none)
    string result = string(buffer, i64(size))
    free(buffer)
    ret result
}

u16[1024] consoleInput  // what a console gives, in UTF-16

// Up to `size` bytes of the standard input in `buffer`, 0 at the end (D420). A
// console gives UTF-16, converted to UTF-8, which fits: 1024 units are at most 3072
// bytes; a Ctrl+Z at the start of a line ends the input.
i64 readSome(addr buffer, i64 size) {
    i64 handle = GetStdHandle(0xFFFFFFF6)  // STD_INPUT_HANDLE
    u32 mode = 0
    u32 read = 0
    if (GetConsoleMode(handle, ref mode) != 0) {
        if (ReadConsoleW(handle, variableAddress(consoleInput), 1024, ref read, addr(0)) == 0 || read == 0) {
            ret 0
        }
        if (consoleInput[0] == 26) {  // Ctrl+Z
            ret 0
        }
        ret i64(WideCharToMultiByte(65001, 0, variableAddress(consoleInput), i32(read), buffer, i32(size), addr(0),
            addr(0)))
    }
    if (ReadFile(handle, buffer, u32(size), ref read, addr(0)) == 0) {  // the end of a pipe
        ret 0
    }
    ret i64(read)
}
