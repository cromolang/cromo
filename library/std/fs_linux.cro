// std.fs on Linux (D202): the system calls openat, read, write, close, newfstatat,
// unlinkat, mkdirat, renameat2, getdents64, symlinkat, readlinkat and fchmodat,
// whose numbers are in fs_linux_x86_64.cro and fs_linux_arm64.cro (D408, P23).
// -100 is AT_FDCWD: a path from the current folder.
import unsafe

extern "cromo" {
    addr cromo_content_load(addr name, ref i64 size)  // a document of Android (D501), in memory of SDL
    i32 cromo_content_save(addr name, addr data, i64 size)
    void cromo_content_free(addr data)
}

// The bytes of a file, in memory to be freed, and how many they are.
addr loadFile(string path, ref i64 size) {
    if (path.startsWith("content://")) {
        ret loadDocument(path, ref size)
    }
    i64 file = systemCall(i64(Call.OpenAt), -100, path.cstring(), 0x80000, 0, 0, 0)  // O_RDONLY | O_CLOEXEC
    if (file < 0) {
        throw failure("read", path, file)
    }
    i64 capacity = 4096
    addr data = alloc(capacity)
    i64 total = 0
    for {
        if (total == capacity) {
            capacity *= 2
            data = resize(data, capacity)
        }
        i64 count = systemCall(i64(Call.Read), file, offset(data, total), capacity - total, 0, 0, 0)
        if (count == -4) {  // EINTR
            continue
        }
        if (count < 0) {
            systemCall(i64(Call.Close), file, 0, 0, 0, 0, 0)
            free(data)
            throw failure("read", path, count)
        }
        if (count == 0) {
            break
        }
        total += count
    }
    systemCall(i64(Call.Close), file, 0, 0, 0, 0, 0)
    size = total
    ret data
}

void storeFile(string path, addr data, i64 size, bool append) {
    if (path.startsWith("content://")) {
        storeDocument(path, data, size, append)
        ret
    }
    i64 flags = 0x80000 | 0x40 | 1  // O_CLOEXEC | O_CREAT | O_WRONLY
    if (append) {
        flags |= 0x400  // O_APPEND
    } else {
        flags |= 0x200  // O_TRUNC
    }
    i64 file = systemCall(i64(Call.OpenAt), -100, path.cstring(), flags, 420, 0, 0)  // 0644
    if (file < 0) {
        throw failure("write", path, file)
    }
    i64 done = 0
    for (done < size) {
        i64 count = systemCall(i64(Call.Write), file, offset(data, done), size - done, 0, 0, 0)
        if (count == -4) {
            continue
        }
        if (count < 0) {
            systemCall(i64(Call.Close), file, 0, 0, 0, 0, 0)
            throw failure("write", path, count)
        }
        done += count
    }
    systemCall(i64(Call.Close), file, 0, 0, 0, 0, 0)
}

// On Android a document that its picker gave, "content://...", which SDL reads and
// writes for std.gui (D501): whole, and only in a program with windows.
addr loadDocument(string path, ref i64 size) {
    i64 total = 0
    addr held = cromo_content_load(path.cstring(), ref total)
    if (held == addr(0)) {
        throw Error(format("cannot read '{}': a document of Android is read by a program with windows, which can reach it", path))
    }
    addr data = alloc(total > 0 ? total : 1)
    copyMemory(data, held, total)
    cromo_content_free(held)
    size = total
    ret data
}

void storeDocument(string path, addr data, i64 size, bool append) {
    if (append) {
        throw Error(format("cannot append to '{}': a document of Android is written whole", path))
    }
    if (cromo_content_save(path.cstring(), data, size) == 0) {
        throw Error(format("cannot write '{}': a document of Android is written by a program with windows, which can reach it", path))
    }
}

// Whether a file or a folder exists at the path. It never throws: a path that
// cannot be reached gives false.
public bool exists(string path) {
    ret mode(path) >= 0
}

// Whether the path is a folder, or a link to one; false if nothing is there.
public bool isFolder(string path) {
    i64 bits = mode(path)
    ret bits >= 0 && bits & 0xF000 == 0x4000  // S_IFDIR
}

// Whether the path is a file, or a link to one; false if nothing is there.
public bool isFile(string path) {
    i64 bits = mode(path)
    ret bits >= 0 && bits & 0xF000 == 0x8000  // S_IFREG
}

// Whether the path is a link: a symbolic link, or on Windows a junction too. The
// link itself is checked, not what it points to; false if nothing is there.
public bool isLink(string path) {
    addr info = alloc(144)
    i64 status = systemCall(i64(Call.NewFstatAt), -100, path.cstring(), info, 0x100, 0, 0)  // AT_SYMLINK_NOFOLLOW
    i64 bits = modeOf(info)
    free(info)
    ret status >= 0 && bits & 0xF000 == 0xA000  // S_IFLNK
}

// The size of a file, in bytes. Throws if it does not exist.
public i64 size(string path) {
    ret statField(path, 48, "read the size of")  // st_size
}

// The time of the last change of a file or a folder, in seconds from 1970-01-01
// UTC, as time.unix() gives it. Throws if the path does not exist.
public i64 modified(string path) {
    ret statField(path, 88, "read the date of")  // st_mtime
}

// Renames or moves a file or a folder; 'to' is the new path, also in another
// folder, and a file already there is replaced. Throws if 'from' does not exist.
// Only a file on Windows can move to another disk: otherwise both paths must be on
// the same one.
public void rename(string from, string to) {
    i64 status = systemCall(i64(Call.RenameAt2), -100, from.cstring(), -100, to.cstring(), 0, 0)
    if (status < 0) {
        throw failure("rename", from, status)
    }
}

// Copies the file 'from' to 'to', which is replaced if it exists. Throws if 'from'
// does not exist or is a folder. On Linux the copy does not keep the permissions of
// the original: call makeExecutable for a program.
public void copy(string from, string to) {
    // The bytes, 64 KB at a time; the new file has the permissions 0644.
    i64 source = systemCall(i64(Call.OpenAt), -100, from.cstring(), 0x80000, 0, 0, 0)  // O_RDONLY | O_CLOEXEC
    if (source < 0) {
        throw failure("copy", from, source)
    }
    i64 flags = 0x80000 | 0x40 | 0x200 | 1  // O_CREAT|O_TRUNC|O_WRONLY
    i64 target = systemCall(i64(Call.OpenAt), -100, to.cstring(), flags, 420, 0, 0)
    if (target < 0) {
        systemCall(i64(Call.Close), source, 0, 0, 0, 0, 0)
        throw failure("copy to", to, target)
    }
    addr buffer = alloc(65536)
    try {
        for {
            i64 count = systemCall(i64(Call.Read), source, buffer, 65536, 0, 0, 0)
            if (count == -4) {
                continue
            }
            if (count < 0) {
                throw failure("copy", from, count)
            }
            if (count == 0) {
                break
            }
            i64 done = 0
            for (done < count) {
                i64 written = systemCall(i64(Call.Write), target, offset(buffer, done), count - done, 0, 0, 0)
                if (written == -4) {
                    continue
                }
                if (written < 0) {
                    throw failure("copy to", to, written)
                }
                done += written
            }
        }
    } finally {
        free(buffer)
        systemCall(i64(Call.Close), source, 0, 0, 0, 0, 0)
        systemCall(i64(Call.Close), target, 0, 0, 0, 0, 0)
    }
}

// Whether the byte separates the names of a path: '/', and on Windows '\\' too.
public bool isSeparator(u8 c) {
    ret c == '/'
}

// The separator that joinPath puts between the names of a path: "/" on Linux,
// '"\\"' on Windows.
public string separator() {
    ret "/"
}

// A field of 8 bytes of struct stat, which has st_size and st_mtime in the same
// places on x86-64 and on ARM64.
i64 statField(string path, i64 at, string action) {
    addr info = alloc(144)
    i64 status = systemCall(i64(Call.NewFstatAt), -100, path.cstring(), info, 0, 0, 0)
    i64 value = copyAt<i64>(offset(info, at))
    free(info)
    if (status < 0) {
        throw failure(action, path, status)
    }
    ret value
}

// Removes a file, a link or an empty folder; a link is removed itself, not what it
// points to. Throws if the path does not exist, or if the folder is not empty:
// removeAll removes a folder with all that it holds.
public void remove(string path) {
    i64 status = systemCall(i64(Call.UnlinkAt), -100, path.cstring(), 0, 0, 0, 0)
    if (status == -21) {                                                               // EISDIR
        status = systemCall(i64(Call.UnlinkAt), -100, path.cstring(), 0x200, 0, 0, 0)  // AT_REMOVEDIR
    }
    if (status < 0) {
        throw failure("remove", path, status)
    }
}

// Creates a folder. Throws if the path exists already, or if the folder above it is
// missing: createFolders creates those too.
public void createFolder(string path) {
    i64 status = systemCall(i64(Call.MkdirAt), -100, path.cstring(), 493, 0, 0, 0)  // 0755
    if (status < 0) {
        throw failure("create", path, status)
    }
}

// The names of the files, the folders and the links in a folder, without "." and
// "..", in no order: 'joinPath(path, name)' gives the path of each. Throws if the
// folder does not exist.
public list<string> listFolder(string path) {
    i64 folder = systemCall(i64(Call.OpenAt), -100, path.cstring(), 0x80000 | directoryFlag(), 0, 0, 0)
    if (folder < 0) {
        throw failure("list", path, folder)
    }
    list<string> names
    addr buffer = alloc(4096)
    for {
        i64 count = systemCall(i64(Call.GetDents64), folder, buffer, 4096, 0, 0, 0)
        if (count <= 0) {
            break
        }
        i64 at = 0
        for (at < count) {
            addr entry = offset(buffer, at)
            addr name = offset(entry, 19)  // after d_ino, d_off, d_reclen and d_type
            i64 n = 0
            for (copyAt<u8>(offset(name, n)) != 0) {
                n++
            }
            string text = string(name, n)
            if (text != "." && text != "..") {
                names.add(move text)
            }
            at += i64(copyAt<u16>(offset(entry, 16)))
        }
    }
    free(buffer)
    systemCall(i64(Call.Close), folder, 0, 0, 0, 0, 0)
    ret names
}

// Makes 'path' a link to 'target'. On Linux it is a symbolic link that holds
// 'target' as it is written: a relative target is read from the folder of the link.
// On Windows it is a junction, which needs no administrator rights but can point
// only to a folder, and holds the absolute path of 'target'. Throws if 'path'
// exists already, and on Windows if 'target' is not a folder.
public void createLink(string target, string path) {
    i64 status = systemCall(i64(Call.SymlinkAt), target.cstring(), -100, path.cstring(), 0, 0, 0)
    if (status < 0) {
        throw failure("link", path, status)
    }
}

// Where the link at the path points, as the link holds it: for a junction of
// Windows, an absolute path. Throws if the path does not exist or is not a link.
public string readLink(string path) {
    addr buffer = alloc(4096)
    i64 length = systemCall(i64(Call.ReadlinkAt), -100, path.cstring(), buffer, 4096, 0, 0)
    if (length < 0) {
        free(buffer)
        if (length == -22) {  // EINVAL
            throw fileError("read the link", path, "it is not a link")
        }
        throw failure("read the link", path, length)
    }
    string target = string(buffer, length)
    free(buffer)
    ret target
}

// Makes a file executable: on Linux it adds the permission to run it for those who
// can read it, as chmod +x does; on Windows, which runs a file by its extension,
// nothing changes. Throws if the file does not exist.
public void makeExecutable(string path) {
    // x for those who can read the file, as chmod +x with the usual umask.
    i64 bits = mode(path)
    if (bits < 0) {
        throw failure("make executable", path, bits)
    }
    i64 status = systemCall(i64(Call.FchmodAt), -100, path.cstring(), bits & 0xFFF | (bits & 0x124) >> 2, 0, 0, 0)  // 0444 >> 2
    if (status < 0) {
        throw failure("make executable", path, status)
    }
}

// The st_mode of the file, or -errno.
i64 mode(string path) {
    addr info = alloc(144)
    i64 status = systemCall(i64(Call.NewFstatAt), -100, path.cstring(), info, 0, 0, 0)
    i64 bits = modeOf(info)
    free(info)
    if (status < 0) {
        ret status
    }
    ret bits
}

Error failure(string action, string path, i64 code) {
    string reason = format("error {}", -code)
    if (code == -2) {
        reason = "no such file or folder"
    } else if (code == -13) {
        reason = "permission denied"
    } else if (code == -17) {
        reason = "it exists already"
    } else if (code == -20) {
        reason = "a part of the path is not a folder"
    } else if (code == -21) {
        reason = "it is a folder"
    } else if (code == -39) {
        reason = "the folder is not empty"
    } else if (code == -28) {
        reason = "no space left"
    }
    ret fileError(action, path, reason)
}
