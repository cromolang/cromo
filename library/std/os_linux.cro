// std.os on Linux (D202): system calls, whose numbers are in os_linux_x86_64.cro
// and os_linux_arm64.cro (D408, P23), and the environment on the initial stack.
import unsafe

// The name of the system: "windows", or "linux", also on Android.
public string name() {
    ret "linux"
}

// The id that the system gives to this process.
public i64 processId() {
    ret systemCall(i64(Call.GetPid), 0, 0, 0, 0, 0, 0)
}

// Whether the variable 'name' is in the environment, also with an empty value. On
// Windows the names do not distinguish upper and lower case.
public bool hasEnv(string name) {
    ret envIndex(name) >= 0
}

// The value of the variable 'name' of the environment, or "" when it is not set:
// hasEnv tells an empty value from a missing one. On Windows the names do not
// distinguish upper and lower case.
public string env(string name) {
    i64 index = envIndex(name)
    if (index < 0) {
        ret ""
    }
    addr entry = environment(index)
    i64 start = name.len() + 1
    i64 end = start
    for (copyAt<u8>(offset(entry, end)) != 0) {
        end++
    }
    ret string(offset(entry, start), end - start)
}

// The absolute path of the current folder, from which the relative paths start.
public string currentFolder() {
    addr buffer = alloc(4096)
    i64 length = systemCall(i64(Call.GetCwd), buffer, 4096, 0, 0, 0, 0)  // with its zero
    string folder
    if (length > 0) {
        folder = string(buffer, length - 1)
    }
    free(buffer)
    ret folder
}

// The index of "name=value" among the variables of the environment, or -1.
i64 envIndex(string name) {
    addr none
    i64 n = name.len()
    i64 i = 0
    for {
        addr entry = environment(i)
        if (entry == none) {
            ret -1
        }
        bool same = true
        for (i64 k = 0; k < n && same; k++) {
            same = copyAt<u8>(offset(entry, k)) == name[k]
        }
        if (same && copyAt<u8>(offset(entry, n)) == '=') {
            ret i
        }
        i++
    }
}

// Up to `size` bytes of the standard input in `buffer`, 0 at the end (D420).
i64 readSome(addr buffer, i64 size) {
    for (;;) {
        i64 read = systemCall(i64(Call.Read), 0, buffer, size, 0, 0, 0)
        if (read == -4) {  // EINTR
            continue
        }
        if (read < 0) {
            ret 0
        }
        ret read
    }
}
