// std.process on Linux (D202): fork and execve with pipes. Everything the child
// needs is made before fork; the child only makes system calls, as a program
// with threads must, until execve. The numbers of the calls are in
// process_linux_x86_64.cro and process_linux_arm64.cro (D408, P23).
import std.os
import unsafe

void launch(ref Process p, string program, list<string> args, bool errors) {
    string path = findProgram(program)
    if (path.len() == 0) {
        throw startError(program, "no such program")
    }
    ignoreBrokenPipes()
    // The arguments and the environment as arrays of C strings.
    list<string> all = [path.copy()]
    for (string arg in args) {
        all.add(arg.copy())
    }
    addr argv = alloc((all.len() + 1) * 8)
    for (i64 i = 0; i < all.len(); i++) {
        put<addr>(offset(argv, i * 8), cText(all[i]))
    }
    addr none
    put<addr>(offset(argv, all.len() * 8), none)
    i64 count = 0
    for (environment(count) != none) {
        count++
    }
    addr envp = alloc((count + 1) * 8)
    for (i64 i = 0; i <= count; i++) {
        put<addr>(offset(envp, i * 8), environment(i))
    }

    addr fds = alloc(32)  // four pipes of two descriptors of 4 bytes
    makePipe(fds, 0)
    makePipe(fds, 8)
    if (errors) {
        makePipe(fds, 16)
    }
    makePipe(fds, 24)  // closed by execve: a failure of execve writes its error there
    i64 childInput = i64(copyAt<i32>(fds))
    i64 parentInput = i64(copyAt<i32>(offset(fds, 4)))
    i64 parentOutput = i64(copyAt<i32>(offset(fds, 8)))
    i64 childOutput = i64(copyAt<i32>(offset(fds, 12)))
    i64 parentErrors = -1
    i64 childErrors = -1
    if (errors) {
        parentErrors = i64(copyAt<i32>(offset(fds, 16)))
        childErrors = i64(copyAt<i32>(offset(fds, 20)))
    }
    i64 failureRead = i64(copyAt<i32>(offset(fds, 24)))
    i64 failureWrite = i64(copyAt<i32>(offset(fds, 28)))
    addr failure = alloc(8)
    addr defaultAction = alloc(32)  // struct sigaction with SIG_DFL
    for (i64 i = 0; i < 32; i++) {
        put<u8>(offset(defaultAction, i), 0)
    }

    i64 pid = systemCall(i64(Call.Clone), 17, 0, 0, 0, 0, 0)  // fork: SIGCHLD, the same stack
    if (pid == 0) {
        // The child: its standard descriptors, SIGPIPE as by default, the program.
        systemCall(i64(Call.Dup3), childInput, 0, 0, 0, 0, 0)
        systemCall(i64(Call.Dup3), childOutput, 1, 0, 0, 0, 0)
        if (childErrors >= 0) {
            systemCall(i64(Call.Dup3), childErrors, 2, 0, 0, 0, 0)
        }
        systemCall(i64(Call.RtSigAction), 13, defaultAction, none, 8, 0, 0)  // SIGPIPE
        i64 result = systemCall(i64(Call.Execve), copyAt<addr>(argv), argv, envp, 0, 0, 0)
        put<i32>(failure, i32(-result))
        systemCall(i64(Call.Write), failureWrite, failure, 4, 0, 0, 0)
        systemCall(i64(Call.Exit), 127, 0, 0, 0, 0, 0)
    }

    for (i64 fd in [childInput, childOutput, childErrors, failureWrite]) {
        if (fd >= 0) {
            systemCall(i64(Call.Close), fd, 0, 0, 0, 0, 0)
        }
    }
    for (i64 i = 0; i < all.len(); i++) {
        free(copyAt<addr>(offset(argv, i * 8)))
    }
    free(argv)
    free(envp)
    free(defaultAction)
    free(fds)
    if (pid < 0) {
        free(failure)
        closeAll([parentInput, parentOutput, parentErrors, failureRead])
        throw startError(program, format("error {}", -pid))
    }
    // Nothing on the pipe of the failure, closed by execve: the program runs.
    i64 got = readSome(failureRead, failure, 4)
    systemCall(i64(Call.Close), failureRead, 0, 0, 0, 0, 0)
    i32 code = copyAt<i32>(failure)
    free(failure)
    if (got == 4) {
        closeAll([parentInput, parentOutput, parentErrors])
        waitProcess(pid)
        throw startError(program, reason(i64(code)))
    }
    p.id = pid
    p.input = parentInput
    p.output = parentOutput
    p.errors = parentErrors
}

// The path of the program: as it is with a folder, else the first in a folder of
// PATH where it can be run; "" if there is none.
string findProgram(string program) {
    if (program.contains("/")) {
        ret program.copy()
    }
    string folders = "/usr/local/bin:/usr/bin:/bin"
    if (os.hasEnv("PATH")) {
        folders = os.env("PATH")
    }
    for (string folder in folders.split(":")) {
        string candidate = "./" + program  // an empty folder in PATH is the current one
        if (folder.len() > 0) {
            candidate = folder + "/" + program
        }
        if (systemCall(i64(Call.FaccessAt), -100, candidate.cstring(), 1, 0, 0, 0) == 0) {  // AT_FDCWD, X_OK
            ret candidate
        }
    }
    ret ""
}

// A write to a pipe whose program has ended is an exception, not the signal
// SIGPIPE that would end this program; its children have SIGPIPE back as usual.
void ignoreBrokenPipes() {
    addr action = alloc(32)  // handler SIG_IGN, flags, restorer, mask
    for (i64 i = 0; i < 32; i++) {
        put<u8>(offset(action, i), 0)
    }
    put<i64>(action, 1)
    addr none
    systemCall(i64(Call.RtSigAction), 13, action, none, 8, 0, 0)
    free(action)
}

void makePipe(addr fds, i64 at) {
    i64 status = systemCall(i64(Call.Pipe2), offset(fds, at), 0x80000, 0, 0, 0, 0)  // O_CLOEXEC
    if (status < 0) {
        throw Error(format("cannot make a pipe for a program: error {}", -status))
    }
}

// A copy of the text that ends with a zero, to be freed.
addr cText(string text) {
    addr data = alloc(text.len() + 1)
    copyMemory(data, text.cstring(), text.len() + 1)
    ret data
}

void closeAll(list<i64> fds) {
    for (i64 fd in fds) {
        if (fd >= 0) {
            systemCall(i64(Call.Close), fd, 0, 0, 0, 0, 0)
        }
    }
}

i64 readSome(i64 pipe, addr data, i64 most) {
    for {
        i64 count = systemCall(i64(Call.Read), pipe, data, most, 0, 0, 0)
        if (count >= 0) {
            ret count
        }
        if (count != -4) {  // EINTR: again
            throw Error(format("cannot read from the program: error {}", -count))
        }
    }
}

void writeAll(i64 pipe, addr data, i64 size) {
    i64 total = 0
    for (total < size) {
        i64 count = systemCall(i64(Call.Write), pipe, offset(data, total), size - total, 0, 0, 0)
        if (count == -4) {
            continue
        }
        if (count == -32) {  // EPIPE
            throw Error("cannot write to the program: it does not read its input any more")
        }
        if (count < 0) {
            throw Error(format("cannot write to the program: error {}", -count))
        }
        total += count
    }
}

void closePipe(i64 pipe) {
    systemCall(i64(Call.Close), pipe, 0, 0, 0, 0, 0)
}

// The exit code, or 128 + the signal that ended it, as the shells say (D298).
i32 waitProcess(i64 id) {
    addr status = alloc(4)
    addr none
    for (systemCall(i64(Call.Wait4), id, status, 0, none, 0, 0) == -4) {
    }
    i32 value = copyAt<i32>(status)
    free(status)
    if (value & 0x7F == 0) {
        ret (value >> 8) & 0xFF
    }
    ret 128 + (value & 0x7F)
}

void killProcess(i64 id) {
    systemCall(i64(Call.Kill), id, 9, 0, 0, 0, 0)  // SIGKILL
}

string reason(i64 code) {
    if (code == 2) {
        ret "no such program"
    } else if (code == 13) {
        ret "permission denied"
    } else if (code == 8) {
        ret "it is not a program for this system"
    }
    ret format("error {}", code)
}
