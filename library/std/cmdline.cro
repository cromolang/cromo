// The module std.cmdline: the options of a program, read from the arguments of main, and the
// text of the help. A 'CmdLine' declares the options, each with a long name, a short name of
// one letter and a description; then 'parse' reads the arguments, and 'getInt', 'getFloat',
// 'getString', 'exists' and 'rest' give what they hold.
//
// '''
// import std.cmdline
//
// i32 main(list<string> args) {
//     cmdline.CmdLine cmd
//     cmd.flag("verbose", 'v', "print more")
//     cmd.addInt("port", 'p', "port to listen on", false, 8080)
//     cmd.parse(args)
//     i64 port = cmd.getInt("port")
//     ret 0
// }
// '''
//
// A wrong use of the module, as two options with the same name, is a panic: it is an error of
// the program. A wrong command line is an error of who runs it: 'parse' prints the error and
// the help, and ends the program with the exit code 2.
//
// The guide: [Files, processes and time](https://cromolang.org/book/en/system.html).

// D415, D416; the forms of the command line are in P26, the help in P27.
import std.fs
import std.os

enum Kind {
    Flag
    Int
    Float
    Text
}

struct Option {
    string name
    char letter  // ' ' without a short name
    string description
    Kind kind
    bool required
    list<string> choices
    bool given
    i64 integer
    f64 real
    string text
    string defaultText  // the value before the command line, for the help

    // The type in the help: "int", "float" or "string".
    string typeName() const {
        switch (kind) {
            case Int {
                ret "int"
            }
            case Float {
                ret "float"
            }
            default {
                ret "string"
            }
        }
    }

    // The value as text, for the default in the help and for the choices.
    string valueText() const {
        switch (kind) {
            case Int {
                ret format("{}", integer)
            }
            case Float {
                ret format("{}", real)
            }
            default {
                ret text.copy()
            }
        }
    }
}

// The options of a program, the arguments that are not options, and the text of the help.
// The options are added first, then 'parse' reads the arguments of main, and the methods
// that start with 'get' give their values. The options can be written '--port 9000',
// '--port=9000', '-p 9000' or '-p9000', and the flags together, as '-vq'; an option given
// twice keeps its last value.
//
// '''
// cmdline.CmdLine cmd
// cmd.flag("verbose", 'v', "print more")
// cmd.addString("format", 'f', "output format", false, "text")
// cmd.choices("format", ["text", "json"])
// cmd.footer("files...")
// cmd.parse(args)
// list<string> files = cmd.rest()
// '''
public struct CmdLine {
    list<Option> options
    list<string> others
    string footerText
    string program = "program"

    // Adds an option without a value, as '--verbose' and '-v': 'name' is the long name,
    // without '--', 'letter' the short one, or a space, ' ', when there is none, and
    // 'description' the text of the help. 'exists' says whether it was given. A name that is
    // empty, starts with '-' or is "help", the letters '-' and 'h', and a name or a letter used
    // twice, are a panic.
    public void flag(string name, char letter, string description) {
        options.add(newOption(name, letter, description, Kind.Flag, false))
    }

    // Adds an option with an i64, as '--port 8080' or '-p 8080': 'name', 'letter' and
    // 'description' as in 'flag'. 'value' is the default, which 'getInt' gives when the option
    // is not given; a 'required' option must be given, and its default is not used. The value
    // is read as 'i64("...")' reads it.
    public void addInt(string name, char letter, string description, bool required, i64 value) {
        Option option = newOption(name, letter, description, Kind.Int, required)
        option.integer = value
        option.defaultText = option.valueText()
        options.add(move option)
    }

    // Adds an option with an f64, as '--ratio 0.5': 'value' is the default, which 'getFloat'
    // gives when the option is not given; the rest as in 'addInt'. The value is read as
    // 'f64("...")' reads it.
    public void addFloat(string name, char letter, string description, bool required, f64 value) {
        Option option = newOption(name, letter, description, Kind.Float, required)
        option.real = value
        option.defaultText = option.valueText()
        options.add(move option)
    }

    // Adds an option with a string, as '--format json': 'value' is the default, which
    // 'getString' gives when the option is not given; the rest as in 'addInt'.
    public void addString(string name, char letter, string description, bool required, string value) {
        Option option = newOption(name, letter, description, Kind.Text, required)
        option.text = value.copy()
        option.defaultText = value.copy()
        options.add(move option)
    }

    // Sets the values allowed for the option 'name', as texts: '["text", "json"]'. A number is
    // compared as 'format("{}", n)' writes it, so 2.0 is "2". A value given outside the
    // choices is an error of the command line. An option that was not added, a flag, and the
    // default of an option that is not required when it is not among the values, are a panic.
    public void choices(string name, list<string> values) {
        i64 at = indexOf(name)
        if (options[at].kind == Kind.Flag) {
            panic(format("cmdline: --{} is a flag and has no values", name))
        }
        options[at].choices = values.copy()
        if (!options[at].required && !allowed(options[at], options[at].defaultText)) {
            panic(format("cmdline: the default of --{} is not among its choices", name))
        }
    }

    // Sets what the line of usage of the help shows after the options, as "files...", for the
    // arguments that are not options.
    public void footer(string text) {
        footerText = text.copy()
    }

    // Reads the options from the arguments of main, where 'args[0]' is the program: its name,
    // without the folder and '.exe', goes in the help. The arguments that are not options go to
    // 'rest()'; after '--' every argument goes there, also when it starts with '-', and so does
    // '-' alone.
    //
    // With '-h' or '--help' it prints the help on the standard output and ends the program with
    // the exit code 0. A wrong command line, as an unknown option, a missing value, a number
    // that is not valid, a value outside the choices or a required option that is missing,
    // prints the error and the help on the standard error, and ends the program with the exit
    // code 2.
    public void parse(list<string> args) {
        if (args.len() > 0) {
            program = fs.fileName(args[0])
            if (program.lower().endsWith(".exe")) {
                program = program.slice(0, program.len() - 4)
            }
        }
        bool ended = false  // after --, everything is an argument
        for (i64 i = 1; i < args.len(); i++) {
            if (ended || args[i] == "-" || !args[i].startsWith("-")) {
                others.add(args[i].copy())
                continue
            }
            if (args[i] == "--") {
                ended = true
                continue
            }
            if (args[i] == "--help") {
                showHelp()
            }
            if (args[i].startsWith("--")) {
                i = readLong(args, i)
            } else {
                i = readShort(args, i)
            }
        }
        for (Option option in options) {
            if (option.required && !option.given) {
                fail(format("the option --{} is required", option.name))
            }
        }
    }

    // Whether the option 'name', a flag or one with a value, was on the command line. A name
    // that was not added is a panic.
    public bool exists(string name) const {
        ret options[indexOf(name)].given
    }

    // The value of the option 'name', added with 'addInt': the one given, or the default. A
    // name that was not added, or an option of another type, is a panic.
    public i64 getInt(string name) const {
        ret options[kindOf(name, Kind.Int)].integer
    }

    // The value of the option 'name', added with 'addFloat': the one given, or the default. A
    // name that was not added, or an option of another type, is a panic.
    public f64 getFloat(string name) const {
        ret options[kindOf(name, Kind.Float)].real
    }

    // The value of the option 'name', added with 'addString': the one given, or the default.
    // A name that was not added, or an option of another type, is a panic.
    public string getString(string name) const {
        ret options[kindOf(name, Kind.Text)].text.copy()
    }

    // The arguments that are not options, in their order, without 'args[0]'.
    public list<string> rest() const {
        ret others.copy()
    }

    // The text of the help, which '-h' and '--help' print: the line of usage, as
    // "usage: server [options] files...", with the required options and the footer, then a line
    // for each option, with its short and long names, its type, its description, its choices
    // and its default. Before 'parse' the name of the program is "program".
    public string help() const {
        string usage = "usage: " + program
        for (Option option in options) {
            if (option.required) {
                usage += format(" --{} <{}>", option.name, option.typeName())
            }
        }
        usage += " [options]"
        if (footerText.len() > 0) {
            usage += " " + footerText
        }

        list<string> left
        i64 width = 10  // "-h, --help"
        for (Option option in options) {
            string text = "    --" + option.name
            if (option.letter != ' ') {
                text = format("-{:c}, --{}", option.letter, option.name)
            }
            if (option.kind != Kind.Flag) {
                text += format(" <{}>", option.typeName())
            }
            if (text.len() > width) {
                width = text.len()
            }
            left.add(move text)
        }

        string out = usage + "\noptions:\n"
        for (i64 i = 0; i < options.len(); i++) {
            out += "  " + left[i] + " ".repeat(width - left[i].len() + 2) + options[i].description
            string notes = ""
            if (options[i].choices.len() > 0) {
                notes = join(options[i].choices, ", ")
            }
            if (options[i].required) {
                notes = joined(notes, "required")
            } else if (options[i].defaultText.len() > 0) {
                notes = joined(notes, "default " + options[i].defaultText)
            }
            if (notes.len() > 0) {
                out += " (" + notes + ")"
            }
            out += "\n"
        }
        ret out + "  -h, --help" + " ".repeat(width - 10 + 2) + "print this help\n"
    }

    Option newOption(string name, char letter, string description, Kind kind, bool required) {
        if (name.len() == 0 || name.startsWith("-") || name == "help") {
            panic(format("cmdline: '{}' cannot be the name of an option", name))
        }
        if (letter == '-' || letter == 'h') {
            panic(format("cmdline: '{:c}' cannot be the short name of an option", letter))
        }
        for (Option option in options) {
            if (option.name == name) {
                panic(format("cmdline: the option --{} is added twice", name))
            }
            if (letter != ' ' && option.letter == letter) {
                panic(format("cmdline: the short name -{:c} is used twice", letter))
            }
        }
        Option option
        option.name = name.copy()
        option.letter = letter
        option.description = description.copy()
        option.kind = kind
        option.required = required
        ret option
    }

    i64 indexOf(string name) const {
        for (i64 i = 0; i < options.len(); i++) {
            if (options[i].name == name) {
                ret i
            }
        }
        panic(format("cmdline: there is no option --{}", name))
    }

    i64 kindOf(string name, Kind kind) const {
        i64 at = indexOf(name)
        if (options[at].kind != kind) {
            panic(format("cmdline: --{} is not an option of {}", name, kindName(kind)))
        }
        ret at
    }

    // --name, --name=value or --name value; returns the index of the last argument read.
    i64 readLong(list<string> args, i64 i) {
        string body = args[i].slice(2, args[i].len())
        string name = body.copy()
        string value = ""
        bool hasValue = false
        i64 equal = body.find("=")
        if (equal >= 0) {
            name = body.slice(0, equal)
            value = body.slice(equal + 1, body.len())
            hasValue = true
        }
        i64 at = find(name)
        if (at < 0) {
            fail(format("unknown option --{}", name))
        }
        if (options[at].kind == Kind.Flag) {
            if (hasValue) {
                fail(format("the option --{} takes no value", name))
            }
            options[at].given = true
            ret i
        }
        i64 last = i
        if (!hasValue) {
            if (i + 1 >= args.len()) {
                fail(format("the option --{} needs a value", name))
            }
            last = i + 1
            value = args[last].copy()
        }
        setValue(at, value)
        ret last
    }

    // -v, -vq, -p 8080, -p8080 and -vp 8080; returns the index of the last argument read.
    i64 readShort(list<string> args, i64 i) {
        for (i64 k = 1; k < args[i].len(); k++) {
            char letter = args[i][k]
            if (letter == 'h') {
                showHelp()
            }
            i64 at = findLetter(letter)
            if (at < 0) {
                fail(format("unknown option -{:c}", letter))
            }
            if (options[at].kind == Kind.Flag) {
                options[at].given = true
                continue
            }
            if (k + 1 < args[i].len()) {
                setValue(at, args[i].slice(k + 1, args[i].len()))
                ret i
            }
            if (i + 1 >= args.len()) {
                fail(format("the option -{:c} needs a value", letter))
            }
            setValue(at, args[i + 1])
            ret i + 1
        }
        ret i
    }

    i64 find(string name) const {
        for (i64 i = 0; i < options.len(); i++) {
            if (options[i].name == name) {
                ret i
            }
        }
        ret -1
    }

    i64 findLetter(char letter) const {
        for (i64 i = 0; i < options.len(); i++) {
            if (options[i].letter == letter) {
                ret i
            }
        }
        ret -1
    }

    // The value of an option from its text, checked as a number and among the choices.
    void setValue(i64 at, string value) {
        string name = options[at].name.copy()
        if (options[at].kind == Kind.Int) {
            try {
                options[at].integer = i64(value)
            } catch (Exception e) {
                fail(format("the value of --{} is not an integer: '{}'", name, value))
            }
        } else if (options[at].kind == Kind.Float) {
            try {
                options[at].real = f64(value)
            } catch (Exception e) {
                fail(format("the value of --{} is not a number: '{}'", name, value))
            }
        } else {
            options[at].text = value.copy()
        }
        if (!allowed(options[at], options[at].valueText())) {
            fail(format("the value of --{} is '{}', and it can be {}", name, value, join(options[at].choices, ", ")))
        }
        options[at].given = true
    }

    void showHelp() const {
        print("{}", help())
        os.exit(0)
    }

    // D416: the error and the help on the standard error, and the exit code 2.
    void fail(string message) const {
        eprint("{}: {}\n\n{}", program, message, help())
        os.exit(2)
    }
}

bool allowed(Option option, string value) {
    if (option.choices.len() == 0) {
        ret true
    }
    for (string choice in option.choices) {
        if (choice == value) {
            ret true
        }
    }
    ret false
}

string joined(string first, string second) {
    if (first.len() == 0) {
        ret second.copy()
    }
    ret first + "; " + second
}

string kindName(Kind kind) {
    switch (kind) {
        case Int {
            ret "int"
        }
        case Float {
            ret "float"
        }
        case Text {
            ret "string"
        }
        default {
            ret "flag"
        }
    }
}
