// TCP connections and listeners, UDP sockets, TLS and the names of the hosts. A call
// waits until it is done, as in C, or until the timeout set on its socket with
// 'timeout()', and then it throws. In a task, the wait leaves the thread to the other
// tasks, so a server can give each connection a task of its own. An error of the network
// is an exception of type 'Error', whose message says what failed and why, as "cannot
// connect to example.com:80: connection refused".
//
// '''
// net.Connection site = net.connectTls("example.com", 443)
// site.timeout(10000)
// site.writeText("GET / HTTP/1.1\r\nHost: example.com\r\nConnection: close\r\n\r\n")
// println("{}", string(site.read(200)))
// '''
//
// The main types are 'Listener', 'Connection' and 'Udp'. A name is resolved on Linux
// from '/etc/hosts', then by the servers of '/etc/resolv.conf', and on Windows by the
// resolver of the system; IPv4 and IPv6 work on both. TLS comes from mbedTLS, inside the
// runtime: the executables need no other library.
//
// The guide: [Networking and HTTP](https://cromolang.org/book/en/networking.html).

// For who works on std.net (D223-D226): a call waits until it is done, or until the
// timeout set on its socket (D225); in a task, the task waits and its thread runs the
// others (D269). The sockets do not block: the calls of the system say when they
// would wait, -1 or false below, and the library waits for the socket. They are in
// net_windows.cro and net_linux.cro (D202), with:
//   i32 inet6()                                        the code of IPv6 for the system
//   i64 openSocket(i32 version, bool stream)
//   void reuseAddress(i64 socket)                      for a listener
//   i64 connectTo(i64 socket, Address to)              0, -1 while it connects, or the code of the error
//   i64 connectError(i64 socket)                       then: 0, or the code of the error
//   void bindTo(i64 socket, Address to)
//   void listenOn(i64 socket)
//   i64 acceptOn(i64 socket)
//   i64 receiveSome(i64 socket, addr data, i64 most)   0 at the end
//   i64 sendSome(i64 socket, addr data, i64 size)
//   bool sendTo(i64 socket, addr data, i64 size, Address to)
//   i64 receiveFrom(i64 socket, addr data, i64 most, ref Address from)
//   bool waitFor(i64 socket, bool reading, i64 milliseconds)  as a thread; -1 as long as it takes
//   i32 localPort(i64 socket)
//   void closeSocket(i64 socket)
//   list<Address> resolveHost(string host, i32 port)
//   string errorText(i64 code)
// TLS (D233-D235) is in the runtime, with mbedTLS (runtime/tls): a session
// encrypts and decrypts in memory, and the functions here move its records to and
// from the socket, with the same timeouts (D243). The functions of the runtime
// are declared with extern "cromo" (D240).
import unsafe

extern "cromo" {
    addr cromo_tls_connect(addr host, i64 length)
    addr cromo_tls_server(addr certificate, i64 certificateLength, addr key, i64 keyLength)
    void cromo_tls_server_end(addr server)
    addr cromo_tls_accept(addr server)
    i64 cromo_tls_handshake(addr session)                   // 0 done, -1 it needs bytes, -2 an error
    i64 cromo_tls_read(addr session, addr out, i64 most)    // bytes, 0 at the end, -1, -2
    i64 cromo_tls_write(addr session, addr data, i64 size)  // bytes taken, -1, -2
    void cromo_tls_close(addr session)
    void cromo_tls_end(addr session)
    addr cromo_tls_input(addr session, i64 most)
    void cromo_tls_received(addr session, i64 count)
    i64 cromo_tls_pending(addr session)
    addr cromo_tls_output(addr session)
    void cromo_tls_sent(addr session, i64 count)
    i64 cromo_tls_error(addr object, addr out, i64 most)
    i64 cromo_task_wait_socket(i64 handle, i64 reading, i64 milliseconds)  // -1 outside a task (D269)
}

// An address of IPv4 or IPv6, with a port.
struct Address {
    i32 version  // 4 or 6
    u8[16] ip
    i32 port
}

// Waits for connections on an address and a port, made by 'listen' or 'listenTls':
// 'accept()' gives them one by one. The destructor closes it. It can be moved, as into a
// task, but not copied.
//
// '''
// net.Listener listener = net.listen("0.0.0.0", 7000)
// thread.Group clients
// for {
//     net.Connection client = listener.accept()
//     clients.start([move client]() {
//         client.write(client.read(1024))  // an echo
//     })
// }
// '''
public struct Listener {
    i64 handle = -1
    i64 wait = -1  // milliseconds; -1 waits as long as it takes (D225)
    addr tls       // the certificate and the key of listenTls (D235)

    ~Listener() {
        close()
    }

    // The next connection, waiting for it; with a timeout, an exception if none arrives
    // in time. An exception also when the listener is closed, or the system refuses
    // the connection. With TLS, the handshake of the connection comes with its first
    // read or write, in the task that serves it, so that a slow client does not keep
    // the others waiting. It is const: several threads or tasks can accept from the
    // same listener.
    public Connection accept() const {
        checkOpen(handle, "accept a connection")
        Connection connection
        connection.handle = acceptOn(handle)
        for (connection.handle < 0) {
            waitReady(handle, true, wait, "accept a connection")
            connection.handle = acceptOn(handle)
        }
        addr none
        if (tls != none) {
            connection.tls = cromo_tls_accept(tls)
        }
        ret connection
    }

    // Sets how long 'accept()' waits for a connection, in milliseconds; -1, the default,
    // waits as long as it takes.
    public void timeout(i64 milliseconds) {
        wait = milliseconds
    }

    // The port it listens on, also when 0 asked the system for a free one.
    public i32 port() const {
        ret localPort(handle)
    }

    // Stops listening, and then 'accept()' throws; the destructor does it too, and a
    // second call does nothing. The connections already accepted stay open.
    public void close() {
        if (handle >= 0) {
            closeSocket(handle)
            handle = -1
        }
        addr none
        if (tls != none) {
            cromo_tls_server_end(tls)  // its connections keep it while they need it
            tls = none
        }
    }

    void open(string host, i32 port) {
        Address address = resolveHost(host, port)[0]
        handle = openSocket(address.version, true)
        reuseAddress(handle)
        bindTo(handle, address)
        listenOn(handle)
    }
}

// A connection of TCP, from 'connect' or 'accept()', encrypted when it comes from
// 'connectTls' or 'listenTls', with the same 'read' and 'write'. Each call waits until it
// is done, or until the timeout; in a task, the wait leaves the thread to the other
// tasks. The destructor closes it. It can be moved, as into a task, but not copied.
//
// '''
// net.Connection connection = net.connect("127.0.0.1", 7000)
// connection.timeout(5000)
// connection.writeText("hello")
// list<u8> answer = connection.read(1024)  // empty if the other side has closed
// '''
public struct Connection {
    i64 handle = -1
    i64 wait = -1
    addr tls  // the session of TLS

    ~Connection() {
        close()
    }

    // Up to 'most' bytes, as soon as some arrive, which can be fewer than those the other
    // side wrote: an empty list when the other side has closed the connection. With
    // TLS, also when it has ended without saying so. An exception on a timeout, on an
    // error of the network or of TLS, as a handshake that fails, and after 'close()'.
    public list<u8> read(i64 most) {
        addr none
        if (tls != none) {
            ret readTls(most)
        }
        checkOpen(handle, "read")
        addr buffer = alloc(most)
        try {
            i64 count = receiveSome(handle, buffer, most)
            for (count < 0) {
                waitReady(handle, true, wait, "read")
                count = receiveSome(handle, buffer, most)
            }
            list<u8> bytes
            bytes.reserve(count)
            for (i64 i = 0; i < count; i++) {
                bytes.add(copyAt<u8>(offset(buffer, i)))
            }
            ret bytes
        } finally {
            free(buffer)
        }
    }

    // Writes all the bytes, waiting while the system has no room for them; nothing is
    // kept after it returns. An exception on a timeout, on an error of the network, as a
    // connection that the other side has reset, and after 'close()'.
    public void write(list<u8> bytes) {
        addr data = copyBytes(bytes)
        try {
            sendAll(data, bytes.len())
        } finally {
            free(data)
        }
    }

    // Writes the bytes of the text, UTF-8, as 'write' does.
    public void writeText(string text) {
        sendAll(text.cstring(), text.len())
    }

    // Starts TLS on a connection that 'connect' gave, for the protocols that begin in
    // clear and then ask for it, as SMTP and PostgreSQL: from then on 'read' and 'write'
    // are encrypted. The certificate of the server must come from an authority that the
    // system trusts, and name 'host', as for 'connectTls': otherwise an exception says
    // why. On a connection that has TLS already it is a panic.
    public void startTls(string host) {
        addr none
        if (tls != none) {
            panic("net: the connection has TLS already")
        }
        tls = cromo_tls_connect(host.cstring(), host.len())
        handshake(format("start TLS with {}", host))
    }

    // Sets how long each following read or write waits for the other side, in
    // milliseconds, also in the handshake of TLS of a server; past it the call throws.
    // -1, the default, waits as long as it takes.
    public void timeout(i64 milliseconds) {
        wait = milliseconds
    }

    // Closes the connection, and then 'read' and 'write' throw; the destructor does it
    // too, and a second call does nothing. With TLS, it says close_notify to the other
    // side first, if it can, ignoring the errors.
    public void close() {
        addr none
        if (tls != none) {
            if (handle >= 0) {
                try {
                    cromo_tls_close(tls)
                    flush("close")
                } catch (Exception e) {
                }
            }
            cromo_tls_end(tls)
            tls = none
        }
        if (handle >= 0) {
            closeSocket(handle)
            handle = -1
        }
    }

    void sendAll(addr data, i64 size) {
        addr none
        if (tls != none) {
            writeTls(data, size)
            ret
        }
        checkOpen(handle, "write")
        i64 done = 0
        for (done < size) {
            i64 count = sendSome(handle, offset(data, done), size - done)
            if (count < 0) {
                waitReady(handle, false, wait, "write")
            } else {
                done += count
            }
        }
    }

    // The handshake of a client, which verifies the certificate of the server.
    void handshake(string action) {
        for {
            i64 status = cromo_tls_handshake(tls)
            if (status == -2) {
                throw failure(action, tlsError(tls))
            }
            flush(action)
            if (status == 0) {
                ret
            }
            receive(action)
        }
    }

    list<u8> readTls(i64 most) {
        addr buffer = alloc(most)
        try {
            for {
                i64 count = cromo_tls_read(tls, buffer, most)
                if (count == -2) {
                    throw failure("read", tlsError(tls))
                }
                flush("read")
                if (count >= 0) {
                    list<u8> bytes
                    bytes.reserve(count)
                    for (i64 i = 0; i < count; i++) {
                        bytes.add(copyAt<u8>(offset(buffer, i)))
                    }
                    ret bytes
                }
                receive("read")
            }
        } finally {
            free(buffer)
        }
    }

    void writeTls(addr data, i64 size) {
        i64 done = 0
        for (done < size) {
            i64 count = cromo_tls_write(tls, offset(data, done), size - done)
            if (count == -2) {
                throw failure("write", tlsError(tls))
            }
            flush("write")
            if (count >= 0) {
                done += count
            } else {
                receive("write")  // the handshake of a server needs the client
            }
        }
    }

    // Sends what the session has written for the other side.
    void flush(string action) {
        checkOpen(handle, action)
        for (cromo_tls_pending(tls) > 0) {
            i64 count = sendSome(handle, cromo_tls_output(tls), cromo_tls_pending(tls))
            if (count < 0) {
                waitReady(handle, false, wait, action)
            } else {
                cromo_tls_sent(tls, count)
            }
        }
    }

    // More bytes from the socket for the session, or the news that there are none.
    void receive(string action) {
        checkOpen(handle, action)
        addr room = cromo_tls_input(tls, 16384)
        i64 count = receiveSome(handle, room, 16384)
        for (count < 0) {
            waitReady(handle, true, wait, action)
            count = receiveSome(handle, room, 16384)
        }
        cromo_tls_received(tls, count)
    }
}

// A message of UDP, with the address it comes from.
public struct Datagram {
    public list<u8> data  // the bytes of the message
    public string host    // the address of the sender, as "192.168.1.2" or "fe80::1"
    public i32 port       // the port of the sender
}

// A socket of UDP, bound to an address and a port, made by 'udp': it sends and receives
// messages, each whole or not at all, with no connection and no promise that they
// arrive, nor in which order. The destructor closes it. It can be moved, not copied.
//
// '''
// net.Udp socket = net.udp("0.0.0.0", 0)
// socket.timeout(2000)
// socket.send("192.168.1.20", 9000, "ping".bytes())
// net.Datagram answer = socket.receive(1500)
// println("{} bytes from {}:{}", answer.data.len(), answer.host, answer.port)
// '''
public struct Udp {
    i64 handle = -1
    i64 wait = -1
    i32 version

    ~Udp() {
        close()
    }

    // Sends the bytes as one message to the port of a host, a name or an address of
    // the same version of IP as the socket. An exception if the host is not found or
    // has no address of that version, on a timeout, or on an error of the network; none
    // if the message is lost on the way.
    public void send(string host, i32 port, list<u8> bytes) {
        Address target = pick(resolveHost(host, port), version, host)
        addr data = copyBytes(bytes)
        try {
            checkOpen(handle, "send")
            for (!sendTo(handle, data, bytes.len(), target)) {
                waitReady(handle, false, wait, "send")
            }
        } finally {
            free(data)
        }
    }

    // The next message, of at most 'most' bytes, and who sent it; with a timeout, an
    // exception if none arrives in time. Give room for the largest message: a longer
    // one is cut to 'most' bytes on Linux, and is an exception on Windows.
    public Datagram receive(i64 most) {
        checkOpen(handle, "receive")
        addr buffer = alloc(most)
        try {
            Address from
            i64 count = receiveFrom(handle, buffer, most, ref from)
            for (count < 0) {
                waitReady(handle, true, wait, "receive")
                count = receiveFrom(handle, buffer, most, ref from)
            }
            Datagram message
            message.data.reserve(count)
            for (i64 i = 0; i < count; i++) {
                message.data.add(copyAt<u8>(offset(buffer, i)))
            }
            message.host = text(from)
            message.port = from.port
            ret message
        } finally {
            free(buffer)
        }
    }

    // Sets how long 'send' and 'receive' wait, in milliseconds; past it they throw. -1,
    // the default, waits as long as it takes.
    public void timeout(i64 milliseconds) {
        wait = milliseconds
    }

    // The port it is bound to, also when 0 asked the system for a free one.
    public i32 port() const {
        ret localPort(handle)
    }

    // Closes the socket, and then 'send' and 'receive' throw; the destructor does it
    // too, and a second call does nothing.
    public void close() {
        if (handle >= 0) {
            closeSocket(handle)
            handle = -1
        }
    }
}

// A listener on a name or an address, as "127.0.0.1" for this computer alone or
// "0.0.0.0" for all its addresses of IPv4 ("::" for IPv6); port 0 asks the system for a
// free one, which 'port()' gives. A name with several addresses listens on the first.
// An exception if the name is not found or the port is taken, as "cannot use 0.0.0.0
// port 8080: the address is in use".
public Listener listen(string host, i32 port) {
    Listener listener
    listener.open(host, port)
    ret listener
}

// A listener as 'listen' gives, whose connections encrypt with TLS: 'certificate' is
// the text in PEM of the certificate of the server, followed by those of its chain, and
// 'key' the text in PEM of its private key. An exception if they cannot be read. The
// handshake of each connection comes with its first read or write.
public Listener listenTls(string host, i32 port, string certificate, string key) {
    Listener listener
    listener.tls = cromo_tls_server(certificate.cstring(), certificate.len(), key.cstring(), key.len())
    string problem = tlsError(listener.tls)
    if (problem.len() > 0) {
        throw failure("listen with TLS", problem)
    }
    listener.open(host, port)
    ret listener
}

// A connection to the port of a name or an address, trying the addresses of the name
// in turn until one answers. An exception if the name is not found, or with the error
// of the last address if none answers, as "cannot connect to example.com:80: connection
// refused". It has no timeout of its own: it waits as long as the system does.
public Connection connect(string host, i32 port) {
    list<Address> addresses = resolveHost(host, port)
    i64 code = 0
    for (Address address in addresses) {
        Connection connection
        connection.handle = openSocket(address.version, true)
        code = connectTo(connection.handle, address)
        if (code < 0) {  // it connects: writable when done
            readyFor(connection.handle, false, -1)
            code = connectError(connection.handle)
        }
        if (code == 0) {
            ret connection
        }
    }
    throw failure(format("connect to {}:{}", host, port), errorText(code))
}

// A connection with TLS to the port of a name or an address, as 'connect' gives,
// after the handshake. The certificate of the server must come from an authority that
// the system trusts, and name the host: otherwise an exception says why, as "the
// certificate has expired". As 'connect', it has no timeout of its own, in the
// handshake too.
public Connection connectTls(string host, i32 port) {
    Connection connection = connect(host, port)
    connection.tls = cromo_tls_connect(host.cstring(), host.len())
    connection.handshake(format("connect to {}:{} with TLS", host, port))
    ret connection
}

// A socket of UDP bound to the port of a name or an address, as "0.0.0.0" for all the
// addresses of IPv4 or "::" for those of IPv6; port 0 asks the system for a free one.
// The socket sends to the addresses of its version of IP. An exception if the name is
// not found or the port is taken.
public Udp udp(string host, i32 port) {
    Address address = resolveHost(host, port)[0]
    Udp opened
    opened.version = address.version
    opened.handle = openSocket(address.version, false)
    bindTo(opened.handle, address)
    ret opened
}

// The addresses of a name, as text: "93.184.215.14", "2606:2800::1". An address
// written with numbers gives itself. An exception if the name is not found.
public list<string> resolve(string host) {
    list<string> names
    for (Address address in resolveHost(host, 0)) {
        names.add(text(address))
    }
    ret names
}

void checkOpen(i64 handle, string action) {
    if (handle < 0) {
        throw failure(action, "the socket is closed")
    }
}

// Whether the socket can be read or written before the timeout, -1 as long as it
// takes: in a task the task waits, and its thread runs the others (D269).
bool readyFor(i64 handle, bool reading, i64 milliseconds) {
    i64 reads = 0
    if (reading) {
        reads = 1
    }
    i64 parked = cromo_task_wait_socket(handle, reads, milliseconds)
    if (parked >= 0) {
        ret parked == 1
    }
    ret waitFor(handle, reading, milliseconds)
}

// D225: an operation waits for its socket only as long as the timeout.
void waitReady(i64 handle, bool reading, i64 wait, string action) {
    if (!readyFor(handle, reading, wait)) {
        throw failure(action, format("timed out after {} ms", wait))
    }
}

Error failure(string action, string reason) {
    ret Error(format("cannot {}: {}", action, reason))
}

// What went wrong in a session or a server of TLS; empty if nothing.
string tlsError(addr object) {
    addr text = alloc(512)
    try {
        ret string(text, cromo_tls_error(object, text, 512))
    } finally {
        free(text)
    }
}

addr copyBytes(list<u8> bytes) {
    addr data = alloc(bytes.len())
    for (i64 i = 0; i < bytes.len(); i++) {
        put<u8>(offset(data, i), bytes[i])
    }
    ret data
}

Address pick(list<Address> addresses, i32 version, string host) {
    for (Address address in addresses) {
        if (address.version == version) {
            ret address
        }
    }
    throw failure(format("send to {}", host), format("it has no address of IPv{}", version))
}

// The sockaddr of the system: 16 bytes for IPv4, 28 for IPv6, to be freed.
addr socketAddress(Address address, ref i32 length) {
    addr raw = alloc(28)
    for (i64 i = 0; i < 28; i++) {
        put<u8>(offset(raw, i), 0)
    }
    put<u8>(offset(raw, 2), u8(address.port >> 8))
    put<u8>(offset(raw, 3), u8(address.port & 0xFF))
    if (address.version == 4) {
        put<u16>(raw, 2)  // AF_INET
        for (i64 i = 0; i < 4; i++) {
            put<u8>(offset(raw, 4 + i), address.ip[i])
        }
        length = 16
    } else {
        put<u16>(raw, u16(inet6()))
        for (i64 i = 0; i < 16; i++) {
            put<u8>(offset(raw, 8 + i), address.ip[i])
        }
        length = 28
    }
    ret raw
}

Address fromSocketAddress(addr raw) {
    Address address
    address.port = i32(copyAt<u8>(offset(raw, 2))) << 8 | i32(copyAt<u8>(offset(raw, 3)))
    if (copyAt<u16>(raw) == 2) {
        address.version = 4
        for (i64 i = 0; i < 4; i++) {
            address.ip[i] = copyAt<u8>(offset(raw, 4 + i))
        }
    } else {
        address.version = 6
        for (i64 i = 0; i < 16; i++) {
            address.ip[i] = copyAt<u8>(offset(raw, 8 + i))
        }
    }
    ret address
}

// As written by people: 192.168.1.2, or the groups of IPv6 with the longest run
// of zeros as `::` (RFC 5952).
string text(Address address) {
    if (address.version == 4) {
        ret format("{}.{}.{}.{}", address.ip[0], address.ip[1], address.ip[2], address.ip[3])
    }
    list<i64> groups
    for (i64 i = 0; i < 8; i++) {
        groups.add(i64(address.ip[2 * i]) << 8 | i64(address.ip[2 * i + 1]))
    }
    i64 bestStart = -1
    i64 bestLength = 1
    i64 start = -1
    for (i64 i = 0; i <= 8; i++) {
        if (i < 8 && groups[i] == 0) {
            if (start < 0) {
                start = i
            }
        } else if (start >= 0) {
            if (i - start > bestLength) {
                bestStart = start
                bestLength = i - start
            }
            start = -1
        }
    }
    string out
    i64 i = 0
    for (i < 8) {
        if (i == bestStart) {
            out += "::"
            i += bestLength
            continue
        }
        if (out.len() > 0 && out[out.len() - 1] != ':') {
            out += ":"
        }
        out += format("{:x}", groups[i])
        i++
    }
    ret out
}

// An address written with numbers: "192.168.1.2" or "fe80::1".
bool parseAddress(string text, i32 port, ref Address address) {
    address.port = port
    ret parseIPv4(text, ref address) || parseIPv6(text, ref address)
}

bool parseIPv4(string text, ref Address address) {
    i64 part = 0
    i64 value = -1
    for (i64 i = 0; i <= text.len(); i++) {
        if (i == text.len() || text[i] == '.') {
            if (value < 0 || part > 3) {
                ret false
            }
            address.ip[part] = u8(value)
            part++
            value = -1
        } else if (text[i] >= '0' && text[i] <= '9') {
            if (value < 0) {
                value = 0
            }
            value = value * 10 + i64(text[i] - '0')
            if (value > 255) {
                ret false
            }
        } else {
            ret false
        }
    }
    if (part != 4) {
        ret false
    }
    address.version = 4
    ret true
}

// Up to eight groups of hex digits, one `::` for the zeros, and an optional zone
// after `%`, which is left out.
bool parseIPv6(string text, ref Address address) {
    i64 end = text.len()
    for (i64 i = 0; i < text.len(); i++) {
        if (text[i] == '%') {
            end = i
            break
        }
    }
    i64 gap = -1
    for (i64 i = 0; i + 1 < end; i++) {
        if (text[i] == ':' && text[i + 1] == ':') {
            gap = i
            break
        }
    }
    list<i64> left
    list<i64> right
    if (gap < 0) {
        if (!hexGroups(text, 0, end, ref left) || left.len() != 8) {
            ret false
        }
    } else if (!hexGroups(text, 0, gap, ref left) || !hexGroups(text, gap + 2, end, ref right) ||
        left.len() + right.len() > 7) {
        ret false
    }
    for (i64 i = 0; i < 8; i++) {
        setGroup(ref address, i, 0)
    }
    i64 at = 0
    for (i64 group in left) {
        setGroup(ref address, at, group)
        at++
    }
    at = 8 - right.len()
    for (i64 group in right) {
        setGroup(ref address, at, group)
        at++
    }
    address.version = 6
    ret true
}

void setGroup(ref Address address, i64 index, i64 group) {
    address.ip[2 * index] = u8(group >> 8)
    address.ip[2 * index + 1] = u8(group & 0xFF)
}

// The groups of hex digits from `from` to `to`, separated by ':'; none if empty.
bool hexGroups(string text, i64 from, i64 to, ref list<i64> groups) {
    if (from == to) {
        ret true
    }
    i64 value = 0
    i64 digits = 0
    for (i64 i = from; i <= to; i++) {
        if (i == to || text[i] == ':') {
            if (digits == 0 || digits > 4) {
                ret false
            }
            groups.add(value)
            value = 0
            digits = 0
        } else {
            i64 digit = hexDigit(text[i])
            if (digit < 0) {
                ret false
            }
            value = value * 16 + digit
            digits++
        }
    }
    ret true
}

i64 hexDigit(u8 c) {
    if (c >= '0' && c <= '9') {
        ret i64(c - '0')
    }
    u8 lower = c | 0x20
    if (lower >= 'a' && lower <= 'f') {
        ret i64(lower - 'a') + 10
    }
    ret -1
}
