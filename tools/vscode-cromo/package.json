{
  "name": "cromo",
  "displayName": "Cromo",
  "description": "The Cromo language: syntax highlighting, errors as you type, hover, go to definition, outline, completion and formatting, with the language server of cromo",
  "version": "0.11.0",
  "publisher": "cromolang",
  "license": "(MIT OR Apache-2.0)",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#0e131b",
    "theme": "dark"
  },
  "homepage": "https://cromolang.org",
  "bugs": {
    "url": "https://github.com/cromolang/cromo/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cromolang/cromo"
  },
  "keywords": [
    "cromo",
    "cro",
    "language server",
    "lsp",
    "llvm",
    "systems programming"
  ],
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:cromo"
  ],
  "contributes": {
    "languages": [
      {
        "id": "cromo",
        "aliases": [
          "Cromo",
          "cromo"
        ],
        "extensions": [
          ".cro"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "cromo",
        "scopeName": "source.cromo",
        "path": "./syntaxes/cromo.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Cromo",
      "properties": {
        "cromo.trace": {
          "type": "boolean",
          "default": false,
          "description": "Writes every message between VS Code and cromo lsp in the Cromo output panel."
        },
        "cromo.path": {
          "type": "string",
          "default": "",
          "description": "The cromo executable that runs the language server, for example C:\\cromo\\bin\\cromo.exe. Empty: build\\cromo.exe in a folder of the workspace, if there is one, else cromo from PATH."
        }
      }
    },
    "configurationDefaults": {
      "[cromo]": {
        "editor.formatOnSave": true
      }
    }
  }
}
