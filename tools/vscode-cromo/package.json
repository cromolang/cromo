{
  "name": "cromo-lang",
  "displayName": "Cromo",
  "description": "Syntax highlighting, errors, hover, definitions and formatting for the Cromo language, with cromo lsp",
  "version": "0.7.0",
  "publisher": "cromo",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:cromo"
  ],
  "contributes": {
    "languages": [
      {
        "id": "cromo",
        "aliases": [
          "Cromo",
          "cromo"
        ],
        "extensions": [
          ".cro"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "cromo",
        "scopeName": "source.cromo",
        "path": "./syntaxes/cromo.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Cromo",
      "properties": {
        "cromo.trace": {
          "type": "boolean",
          "default": false,
          "description": "Writes every message between VS Code and cromo lsp in the Cromo output panel."
        },
        "cromo.path": {
          "type": "string",
          "default": "",
          "description": "The cromo executable that runs the language server, for example C:\\dati\\projects\\cromo\\build\\cromo.exe. Empty: build\\cromo.exe in a folder of the workspace, if there is one, else cromo from PATH."
        }
      }
    },
    "configurationDefaults": {
      "[cromo]": {
        "editor.formatOnSave": true
      }
    }
  }
}
