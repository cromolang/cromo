{
  "name": "cromo-lang",
  "displayName": "Cromo",
  "description": "Syntax highlighting, errors, hover, definitions and formatting for the Cromo language, with cromo lsp",
  "version": "0.3.0",
  "publisher": "cromo",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:cromo"
  ],
  "contributes": {
    "languages": [
      {
        "id": "cromo",
        "aliases": [
          "Cromo",
          "cromo"
        ],
        "extensions": [
          ".cro"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "cromo",
        "scopeName": "source.cromo",
        "path": "./syntaxes/cromo.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Cromo",
      "properties": {
        "cromo.path": {
          "type": "string",
          "default": "cromo",
          "description": "The cromo executable that runs the language server, for example C:\\dati\\projects\\cromo\\build\\cromo.exe. Without a path it is looked for in PATH."
        }
      }
    },
    "configurationDefaults": {
      "[cromo]": {
        "editor.formatOnSave": true
      }
    }
  }
}
