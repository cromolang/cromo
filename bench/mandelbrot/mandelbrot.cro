// Benchmark mandelbrot: floating point in a tight loop, without memory.
// The Mandelbrot set on a grid of 4000 x 4000 points, at most 50 iterations
// each: the points inside and the total of the iterations.
struct Totals {
    i64 inside
    i64 iterations
}

// The rows first, first + step, first + 2 step, ... of the grid.
Totals rows(i64 size, i64 first, i64 step) {
    Totals totals
    for (i64 y = first; y < size; y += step) {
        f64 ci = 2.0 * f64(y) / f64(size) - 1.0
        for (i64 x = 0; x < size; x++) {
            f64 cr = 2.0 * f64(x) / f64(size) - 1.5
            f64 zr = 0.0
            f64 zi = 0.0
            f64 tr = 0.0
            f64 ti = 0.0
            i64 i = 0
            for (i < 50 && tr + ti <= 4.0) {
                zi = 2.0 * zr * zi + ci
                zr = tr - ti + cr
                tr = zr * zr
                ti = zi * zi
                i++
            }
            if (tr + ti <= 4.0) {
                totals.inside++
            }
            totals.iterations += i
        }
    }
    ret totals
}

i32 main() {
    Totals totals = rows(4000, 0, 1)
    println("inside {} iterations {}", totals.inside, totals.iterations)
    ret 0
}
