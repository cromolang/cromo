// Benchmark collatz: integer arithmetic and loops.
// The lengths of the Collatz sequences of the numbers below 5,000,000: their sum,
// and the number with the longest one.
i32 main() {
    i64 limit = 5_000_000
    i64 total = 0
    i64 longest = 0
    i64 start = 0
    for (i64 n = 1; n < limit; n++) {
        i64 x = n
        i64 steps = 0
        for (x != 1) {
            if (x % 2 == 0) {
                x = x / 2
            } else {
                x = 3 * x + 1
            }
            steps++
        }
        total += steps
        if (steps > longest) {
            longest = steps
            start = n
        }
    }
    println("steps {} longest {} from {}", total, longest, start)
    ret 0
}
