// Benchmark binarytrees: allocation and freeing of many small objects.
// As in the Benchmarks Game: a tree of depth 19 built and checked once, a tree
// of depth 18 that lives until the end, and many trees of depth 4, 6, ... 18,
// built, checked and freed. A node keeps its two children in a list.
struct Node {
    list<Node> children
}

Node build(i64 depth) {
    Node node
    if (depth > 0) {
        node.children.reserve(2)
        node.children.add(build(depth - 1))
        node.children.add(build(depth - 1))
    }
    ret node
}

// The number of nodes.
i64 check(Node node) {
    if (node.children.len() == 0) {
        ret 1
    }
    ret 1 + check(node.children[0]) + check(node.children[1])
}

i32 main() {
    i64 maxDepth = 18
    println("stretch tree of depth {} check {}", maxDepth + 1, check(build(maxDepth + 1)))
    Node longLived = build(maxDepth)
    for (i64 depth = 4; depth <= maxDepth; depth += 2) {
        i64 iterations = i64(1) << (maxDepth - depth + 4)
        i64 sum = 0
        for (i64 i = 0; i < iterations; i++) {
            sum += check(build(depth))
        }
        println("{} trees of depth {} check {}", iterations, depth, sum)
    }
    println("long lived tree of depth {} check {}", maxDepth, check(longLived))
    ret 0
}
