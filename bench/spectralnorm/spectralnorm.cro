// Benchmark spectralnorm: floating point, calls and lists of f64.
// The spectral norm of the infinite matrix A(i, j) = 1 / ((i + j)(i + j + 1) / 2 + i + 1),
// cut to 3500 x 3500, with 10 steps of the power method, as in the Benchmarks Game.
// Cromo has no sqrt yet: every version prints the square of the norm.
f64 element(i64 i, i64 j) {
    ret 1.0 / f64((i + j) * (i + j + 1) / 2 + i + 1)
}

// result = A v
void multiplyAv(list<f64> v, ref list<f64> result) {
    i64 n = v.len()
    for (i64 i = 0; i < n; i++) {
        f64 sum = 0.0
        for (i64 j = 0; j < n; j++) {
            sum += element(i, j) * v[j]
        }
        result[i] = sum
    }
}

// result = A' v
void multiplyAtv(list<f64> v, ref list<f64> result) {
    i64 n = v.len()
    for (i64 i = 0; i < n; i++) {
        f64 sum = 0.0
        for (i64 j = 0; j < n; j++) {
            sum += element(j, i) * v[j]
        }
        result[i] = sum
    }
}

// result = A' A v
void multiplyAtAv(list<f64> v, ref list<f64> result, ref list<f64> temporary) {
    multiplyAv(v, ref temporary)
    multiplyAtv(temporary, ref result)
}

i32 main() {
    i64 n = 3500
    list<f64> u
    list<f64> v
    list<f64> temporary
    for (i64 i = 0; i < n; i++) {
        u.add(1.0)
        v.add(0.0)
        temporary.add(0.0)
    }
    for (i64 step = 0; step < 10; step++) {
        multiplyAtAv(u, ref v, ref temporary)
        multiplyAtAv(v, ref u, ref temporary)
    }
    f64 vBv = 0.0
    f64 vv = 0.0
    for (i64 i = 0; i < n; i++) {
        vBv += u[i] * v[i]
        vv += v[i] * v[i]
    }
    println("norm squared {:.12f}", vBv / vv)
    ret 0
}
