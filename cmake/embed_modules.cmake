# Turns the modules of library/std into C++ arrays with their names, to embed them
# in cromo.exe (D201). Usage: cmake -DFOLDER=<library/std> -DOUTPUT=<file.inc> -P embed_modules.cmake
file(GLOB files "${FOLDER}/*.cro")
list(SORT files)
set(arrays "")
set(table "const Embedded kModules[] = {\n")
set(index 0)
foreach(file ${files})
  get_filename_component(name "${file}" NAME)
  file(READ "${file}" content HEX)
  string(REGEX REPLACE "(([0-9a-f][0-9a-f]){32})" "\\1\n" content "${content}")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," content "${content}")
  string(APPEND arrays "const unsigned char kModule${index}[] = {\n${content}\n};\n")
  string(APPEND table "    {\"std/${name}\", kModule${index}, sizeof kModule${index}},\n")
  math(EXPR index "${index} + 1")
endforeach()
string(APPEND table "};\n")
file(WRITE "${OUTPUT}" "${arrays}${table}")
