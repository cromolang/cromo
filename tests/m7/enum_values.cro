// expect-output: 1 2 4
// expect-output: green
// expect-output: blue
// expect-output: 4
// expect-output: -1 0
// expect-output: 0 1 2
// expect-output: default red
// The values of the cases, and conversions to and from numbers (D135).
enum Color {
    Red = 1
    Green = 2
    Blue = 4
}

enum Level {
    Low = -1
    High = 0
}

enum Plain {
    A
    B
    C
}

void show(Color c) {
    switch (c) {
        case Red {
            println("red")
        }
        case Green {
            println("green")
        }
        case Blue {
            println("blue")
        }
    }
}

i32 main() {
    println("{} {} {}", i32(Color.Red), i32(Color.Green), i32(Color.Blue))
    show(Color(2))
    u8 four = 4
    show(Color(four))
    println("{}", i64(Color.Blue))
    println("{} {}", i32(Level.Low), i32(Level.High))
    println("{} {} {}", i32(Plain.A), i32(Plain.B), i32(Plain.C))
    Color first  // the default value is the first case (D111)
    if (first == Color.Red) {
        println("default red")
    }
    ret 0
}
