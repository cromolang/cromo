// A window shows one dialog at a time (P48).
// target: windows linux-x86_64
// expect-exit: 101
// expect-stderr: panic: the window shows a dialog already
import std.gui

i32 main() {
    gui.Window w = gui.Window("w", 400, 300)
    w.showDialog(gui.Dialog("one", 300, 160))
    w.showDialog(gui.Dialog("two", 300, 160))
    ret 0
}
