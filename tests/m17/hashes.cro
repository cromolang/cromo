// The hashes of std.crypto (D236), with the vectors of FIPS 180 and RFC 1321,
// and HMAC with those of RFC 4231 and RFC 2202.
// expect-output: 900150983cd24fb0d6963f7d28e17f72
// expect-output: a9993e364706816aba3e25717850c26c9cd0d89d
// expect-output: ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad
// expect-output: ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f
// expect-output: e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
// expect-output: 248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1
// expect-output: b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7
// expect-output: 87aa7cdea5ef619d4ff0b4241a1d6cb02379f4e2ce4ec2787ad0b30545e17cdedaa833b7d6b8a702038b274eaea3f4e4be9d914eeb61f1702e696c203a126854
// expect-output: effcdf6ae5eb2fa2d27416d5f184df9c259a7c79
// expect-output: b617318655057264e28bc0b6fb378c8ef146be00
// expect-output: 248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1
// expect-output: e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
import std.crypto

i32 main() {
    list<u8> abc = "abc".bytes()
    println("{}", crypto.hex(crypto.md5(abc)))
    println("{}", crypto.hex(crypto.sha1(abc)))
    println("{}", crypto.hex(crypto.sha256(abc)))
    println("{}", crypto.hex(crypto.sha512(abc)))
    println("{}", crypto.hex(crypto.sha256(list<u8>())))
    println("{}", crypto.hex(crypto.sha256("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq".bytes())))

    list<u8> key
    for (i64 i = 0; i < 20; i++) {
        key.add(0x0b)
    }
    list<u8> hiThere = "Hi There".bytes()
    println("{}", crypto.hex(crypto.hmac(crypto.Hash.Sha256, key, hiThere)))
    println("{}", crypto.hex(crypto.hmac(crypto.Hash.Sha512, key, hiThere)))
    // RFC 2202, HMAC-SHA1 with the key "Jefe"
    println("{}", crypto.hex(crypto.hmac(crypto.Hash.Sha1, "Jefe".bytes(), "what do ya want for nothing?".bytes())))
    println("{}", crypto.hex(crypto.hmac(crypto.Hash.Sha1, key, hiThere)))

    // In parts, and again after finish().
    crypto.Hasher hasher = crypto.Hasher(crypto.Hash.Sha256)
    hasher.add("abcdbcdecdefdefgefghfghighij".bytes())
    hasher.add("hijkijkljklmklmnlmnomnopnopq".bytes())
    println("{}", crypto.hex(hasher.finish()))
    println("{}", crypto.hex(hasher.finish()))
    ret 0
}
