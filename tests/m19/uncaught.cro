// An exception that no join() takes stops the program (D217, D269), also for a
// group without wait() (D273).
// expect-exit: 1
// expect-stderr: uncaught exception in a task: lost in a group
import std.thread

i32 main() {
    thread.Group g
    g.start([]() { throw Error("lost in a group") })
    ret 0
}
