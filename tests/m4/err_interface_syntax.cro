// expect-error: an interface contains only methods
// expect-error: the methods of an interface have no body
// expect-error: an interface cannot extend another interface
interface Shape {
    f64 size
    f64 area() const
}

interface Named {
    i32 id() const {
        ret 0
    }
}

interface Colored : Shape {
    i32 color() const
}

i32 main() {
    ret 0
}
