// expect-error: Self can be used only in the methods of an interface
interface Shape {
    f64 area() const
    void grow()
}

interface Comparable {
    i32 compare(Self other) const
}

struct Point {
    i32 x
}

struct Empty : Shape {
    void grow() {
    }
}

struct Loose : Shape {
    f64 area() {
        ret 1.0
    }

    void grow() {
    }
}

struct Odd : Point {
}

void sort(Comparable c) {
}

void keep(move Shape s) {
}

Shape make() {
    ret make()
}

void show(Shape shape) {
    shape.grow()
}

Self strange() {
    ret strange()
}

i32 main() {
    Shape s
    Point p
    show(p)
    ret 0
}
