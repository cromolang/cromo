// The types of the declarations (D423), checked by the second part of sema in
// Cromo too: the fields, the cases, the methods and the interfaces of the structs.
// expect-error: field 'x' is already defined in Point
// expect-error: unknown type 'Missing'
// expect-error: a field cannot be void
// expect-error: 'i32' has no type arguments
// expect-error: 'Point' is not generic: it has no type arguments
// expect-error: an array has at least one element
// expect-error: an array cannot have elements of type Area
// expect-error: value 300 is out of range for u8 (0 .. 255)
// expect-error: value -129 is out of range for i8 (-128 .. 127)
// expect-error: this decimal literal cannot be used as i32
// expect-error: a bool cannot be used as i64: choose the number, as b ? 1 : 0
// expect-error: a value of type u8 cannot be used as bool: compare it, as x != 0
// expect-error: cannot negate an unsigned value (u8)
// expect-error: unknown attribute 'xml': for now there is only json
// expect-error: the field 'b' already has the attribute json
// expect-error: json takes the name of the field in JSON
// expect-error: another field of Tagged has the name 'a' in JSON
// expect-error: case 'Red' is already defined in Color
// expect-error: give a value to every case of Color, or to none
// expect-error: the value 1 is already the one of Red
// expect-error: the value of a case is an integer literal
// expect-error: the value of a case must fit in an i32
// expect-error: only the cases of an enum without data can have a value
// expect-error: the case 'Circle' already has data named 'radius'
// expect-error: the data of a case cannot be void
// expect-error: a case has only the attribute json("name"), its name in JSON
// expect-error: another case of Shape has the name 'circle' in JSON
// expect-error: struct 'Node' contains itself through field 'next': use a list instead
// expect-error: enum 'Tree' contains itself through the data 'left': use a list instead
// expect-error: struct 'Second' contains itself through field 'firsts': use a list instead
// expect-error: a struct has only one constructor
// expect-error: a struct has only one destructor
// expect-error: a destructor has no parameters
// expect-error: 'x' is already a field of Members
// expect-error: method 'twice' is already defined in Members
// expect-error: Small is copied implicitly: its copy() is generated by the compiler
// expect-error: copy() must be written 'Owner copy() const'
// expect-error: 'Point' is not an interface: a struct can only implement interfaces
// expect-error: Circle already implements Area
// expect-error: Circle does not implement 'perimeter' of Area: add 'f64 perimeter(ref i32 count, move const string unit) const'
// expect-error: 'area' does not match the interface Area: it must be 'f64 area() const'
// expect-error: Square does not implement 'same' of Equal: add 'bool same(Square other) const'
// expect-error: method 'area' is already defined in Twice
// expect-error: Self can be used only in the methods of an interface
// expect-error: a field cannot be of Equal, which uses Self: it can only be a constraint, <T : Equal>
// expect-error: Equal uses Self, so it can only be a constraint: <T : Equal>
// expect-error: a return value cannot be of Equal, which uses Self
// expect-error: a parameter cannot be void
// expect-error: main must return i32 or void
// expect-error: main has no parameters, or one with the arguments of the program: list<string> args
struct Point {
    i32 x
    i32 x
    Missing m
    void nothing
    i32<i64> wrong
    Point<i32> generic
    i32[0] empty
    Area[3] none
    u8 small = 300
    i8 negative = -129
    i32 whole = 1.5
    i64 flag = true
    bool truth = 'a'
    i32 letter = -'a'
    f32 half = 1
    f64 minus = -2.5
    i16 edge = -32768
}

struct Tagged {
    [[xml("a")]] i32 a
    [[json("a")]] [[json("c")]] i32 b
    [[json(wrong)]] i32 c
    [[json(skip)]] i32 d
    [[json("a")]] i32 e
}

enum Color {
    Red = 1
    Red = 2
    Green
    Blue = 1
    White = 1 + 1
    Black = 5000000000
    Grey = -7
}

enum Shape {
    Circle(f64 radius, f64 radius) = 3
    Point(void nothing)
    [[xml("s")]] Square(f64 side)
    [[json("circle")]] Round
    [[json("circle")]] Other
}

struct Node {
    i32 value
    Node next
}

enum Tree {
    Leaf(i32 value)
    Branch(Tree left, Tree right)
}

struct First {
    Second second
}

struct Second {
    First[2] firsts
}

struct Members {
    i32 x

    Members() {
    }

    Members(i32 start) {
    }

    ~Members() {
    }

    ~Members(i32 wrong) {
    }

    void x() {
    }

    i32 twice() {
        ret 2
    }

    i32 twice() {
        ret 4
    }
}

struct Small {
    i32 value

    Small copy() const {
        ret Small()
    }
}

struct Owner {
    string name

    ~Owner() {
    }

    void copy() {
    }
}

interface Area {
    f64 area() const
    f64 perimeter(ref i32 count, move const string unit) const
}

interface Equal {
    bool same(Self other) const
}

interface Twice {
    f64 area() const
    f64 area() const
}

struct Circle : Area, Point, Area {
    f64 radius

    f64 area() {
        ret radius
    }
}

struct Square : Equal {
    f64 side
    Self me
    Equal other
}

void take(Equal value, void nothing) {
}

Equal make() {
    ret make()
}

f64 main(i32 count) {
    ret 0
}
