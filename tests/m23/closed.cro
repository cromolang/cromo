// The end of a channel (D327): send() to a closed channel throws, receive()
// throws once it is closed and empty, a sender waiting on a full channel throws
// when it is closed, and break and continue work in a for over a channel.
// expect-output: cannot send: the channel is closed
// expect-output: got 7
// expect-output: cannot receive: the channel is closed
// expect-output: blocked: cannot send: the channel is closed
// expect-output: odd 1 3 5
// expect-output: next 1 false
import std.thread
import std.time

i32 main() {
    thread.Channel<i64> shut = thread.Channel<i64>(1)
    shut.send(7)
    shut.close()
    shut.close()  // a second close() does nothing
    try {
        shut.send(8)
    } catch (Exception e) {
        println("{}", e.message())
    }
    println("got {}", shut.receive())
    try {
        println("never {}", shut.receive())
    } catch (Exception e) {
        println("{}", e.message())
    }

    thread.Channel<i64> full = thread.Channel<i64>(1)
    full.send(1)
    thread.Task closer = thread.Task([full]() {
        time.msleep(20)
        full.close()
    })
    closer.start()
    try {
        full.send(2)
    } catch (Exception e) {
        println("blocked: {}", e.message())
    }
    closer.join()

    thread.Channel<i64> counts = thread.Channel<i64>(10)
    for (i64 i = 1; i <= 9; i++) {
        counts.send(i)
    }
    string odd = "odd"
    for (i64 n in counts) {
        if (n % 2 == 0) {
            continue
        }
        if (n > 5) {
            break
        }
        odd += format(" {}", n)
    }
    println("{}", odd)

    // next() is receive() without the exception.
    thread.Channel<i64> one = thread.Channel<i64>(1)
    one.send(1)
    one.close()
    i64 value = 0
    bool first = one.next(ref value)
    bool second = one.next(ref value)
    println("next {} {}", value, second && first)
    ret 0
}
