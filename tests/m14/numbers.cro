// Numbers from texts (D199).
// expect-output: 42 -7 255 -128 18446744073709551615
// expect-output: 2.5 -0.001 1e+300 inf nan
// expect-output: 0.1 0.30000000000000004 5e-324 1.7976931348623157e+308
// expect-output: f32 0.1 3.4028235e+38
// expect-output: '300' does not fit in u8
// expect-output: 'abc' is not a valid i32
// expect-output: '-1' does not fit in u32
// expect-output: '1e400' does not fit in f64
// expect-output: '1.5.2' is not a valid f64
// expect-output: ' 1' is not a valid i64
// expect-output: '9223372036854775808' does not fit in i64
void attempt(string text) {
    try {
        i64 value = i64(text)
        println("value {}", value)
    } catch (Exception e) {
        println("{}", e.message())
    }
}

i32 main() {
    println("{} {} {} {} {}", i32("42"), i64("-7"), u8("255"), i8("-128"), u64("18446744073709551615"))
    println("{} {} {} {} {}", f64("2.5"), f64("-1e-3"), f64("1E300"), f64("inf"), f64("NaN"))
    println("{} {} {} {}", f64("0.1"), f64("0.30000000000000004"), f64("4.9e-324"), f64("1.7976931348623157e308"))
    println("f32 {} {}", f32("0.1"), f32("3.4028235e38"))
    try {
        u8 big = u8("300")
        println("{}", big)
    } catch (Exception e) {
        println("{}", e.message())
    }
    try {
        i32 bad = i32("abc")
        println("{}", bad)
    } catch (Exception e) {
        println("{}", e.message())
    }
    try {
        u32 negative = u32("-1")
        println("{}", negative)
    } catch (Exception e) {
        println("{}", e.message())
    }
    try {
        f64 huge = f64("1e400")
        println("{}", huge)
    } catch (Exception e) {
        println("{}", e.message())
    }
    try {
        f64 twice = f64("1.5.2")
        println("{}", twice)
    } catch (Exception e) {
        println("{}", e.message())
    }
    attempt(" 1")
    attempt("9223372036854775808")
    ret 0
}
