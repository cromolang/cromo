// Errors on arrays (D196).
// expect-error: the index 4 is outside the array, which has 4 elements (D30)
// expect-error: an array has at least one element (D196)
// expect-error: an array has only len() and copy(), not 'add' (D196)
// expect-error: string[2] cannot be copied: its elements are not simple values, move it instead (D196)
// expect-error: values of type string[2] cannot be copied (D424): write 'move names'
// expect-error: '==' does not work on values of type i32[4]
// expect-error: the elements of this array are i32: write for (i32 x in ...) (D101)
i32 main() {
    i32[4] a
    a[4] = 1
    i32[0] empty
    a.add(1)
    string[2] names
    string[2] copied = names.copy()
    string[2] other = names
    bool same = a == a
    for (i64 x in a) {
    }
    ret 0
}
