// Other programs on Linux (D307): run() with the output, the errors and the exit
// code, start() with the input, kill(), large outputs on both pipes, a program
// that does not exist, and a link removed without what it points to. The programs
// started by two threads at once are in process_threads.cro.
// target: linux
// expect-output: [hello] [oops] 3
// expect-output: a,b,c
// expect-output: code 0
// expect-output: killed 137
// expect-output: cannot start 'no-such-program-xyz': no such program
// expect-output: big 300000 300000
// expect-output: cannot write to the program: it does not read its input any more
// expect-output: link true, target kept true
import std.fs
import std.process

i32 main() {
    process.Output r = process.run("sh", ["-c", "echo hello; echo oops 1>&2; exit 3"])
    println("[{}] [{}] {}", r.out.trim(), r.err.trim(), r.code)
    process.Process p = process.start("sort", [])
    p.write("b\na\nc\n")
    p.closeInput()
    println("{}", p.readAll().trim().replace("\n", ","))
    println("code {}", p.wait())
    process.Process sleeper = process.start("sleep", ["30"])
    sleeper.kill()
    println("killed {}", sleeper.wait())
    try {
        process.run("no-such-program-xyz", [])
    } catch (Exception e) {
        println("{}", e.message())
    }
    process.Output big = process.run("sh", ["-c", "head -c 300000 /dev/zero; head -c 300000 /dev/zero 1>&2"])
    println("big {} {}", big.out.len(), big.err.len())
    process.Process done = process.start("true", [])
    done.wait()
    try {
        for (i64 i = 0; i < 2000; i++) {
            done.write("lots of text that nobody reads\n")
        }
    } catch (Exception e) {
        println("{}", e.message())
    }

    string base = "m21-process-test"
    fs.removeAll(base)
    fs.createFolders(fs.joinPath(base, "target"))
    fs.writeText(fs.joinPath(fs.joinPath(base, "target"), "kept.txt"), "x")
    process.run("ln", ["-s", "target", fs.joinPath(base, "link")])
    bool link = fs.isLink(fs.joinPath(base, "link"))
    fs.removeAll(fs.joinPath(base, "link"))
    println("link {}, target kept {}", link, fs.exists(fs.joinPath(fs.joinPath(base, "target"), "kept.txt")))
    fs.removeAll(base)
    ret 0
}
