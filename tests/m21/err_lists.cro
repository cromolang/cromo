// expect-error: the type of an empty list cannot be deduced: write it, as list<i64> values = [] (D308)
// expect-error: an element of a list is given to it, not passed with 'ref' (D308)
i32 main() {
    string s = "y"
    string t = "z"
    i64 n = [1, 2].len()
    list<string> b = [s, "z"]
    list<string> c = ["z", t]
    i64 m = [].len()
    list<i64> d = [ref n]
    ret 0
}
