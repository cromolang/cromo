// The functions of the bits (D502), on integers of every size, signed or not.
// expect-output: ones 3 8 64 0 32
// expect-output: trailing 3 48 0 64 8 7
// expect-output: leading 31 0 63 64 16 0
// expect-output: rotated 0x0000000000000002 0x8000000000000000 0x1 0x80 0x8000000000000000
// expect-output: rotated 0x00ff 0x0ff0 0x8001 true
// expect-output: lowest bits: 3 9 12
i32 main() {
    u64 row = 0x00FF000000000000
    println("ones {} {} {} {} {}", countOnes(i64(0b1011)), countOnes(row), countOnes(i64(-1)), countOnes(u8(0)),
        countOnes(u32(0xFFFFFFFF)))
    println("trailing {} {} {} {} {} {}", trailingZeros(i32(8)), trailingZeros(row), trailingZeros(u8(1)), trailingZeros(i64(0)),
        trailingZeros(u8(0)), trailingZeros(i8(-128)))
    println("leading {} {} {} {} {} {}", leadingZeros(u32(1)), leadingZeros(i64(-1)), leadingZeros(i64(1)), leadingZeros(u64(0)),
        leadingZeros(u16(0)), leadingZeros(i8(-1)))
    u64 one = 1
    println("rotated {:#018x} {:#018x} {:#x} {:#x} {:#018x}", rotateLeft(one, 1), rotateRight(one, 1), rotateLeft(one, 64),
        rotateLeft(u8(1), 7), rotateRight(one, i32(-63)))
    u16 half = 0x00FF
    u64 typed = rotateLeft(1, 63)  // the literal takes the type of the variable
    println("rotated {:#06x} {:#06x} {:#06x} {}", rotateLeft(half, 16), rotateLeft(half, 4), rotateRight(u16(3), 1),
        rotateLeft(row, i8(8)) == 0xFF00000000000000 && typed == 0x8000000000000000)

    // The bits at 1 of a set, from the lowest: the board of bits of a game, an index.
    u64 set = (u64(1) << 3) | (u64(1) << 9) | (u64(1) << 12)
    list<i32> found
    for (set != 0) {
        found.add(trailingZeros(set))
        set = set & (set - 1)
    }
    println("lowest bits: {} {} {}", found[0], found[1], found[2])
    ret 0
}
