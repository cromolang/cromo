// lsp-completion-doc: 11:12 log The log of a program
import modules.shapes
import std.fs

// The names where one starts (D585): the variables declared before the cursor, the
// names of the module, what is built in and the keywords; and on a line of import
// (D584) the modules that can be imported there.
const i64 limit = 10

enum Kind {
    Small
    Large
}

// A square.
struct Shape {
    f64 side

    f64 area() const {
        ret side * side
    }

    void scale(f64 by) {
        side = side * by
    }
}

// Twice 'value'.
i64 helper(i64 value) {
    ret value * 2
}

i32 main() {
    i64 total = 0
    string label = "a"
    for (i64 count = 0; count < limit; count++) {
        println("{}", count)
    }
    i64 later = total
    fs.exists(label)
    ret i32(helper(later))
}
