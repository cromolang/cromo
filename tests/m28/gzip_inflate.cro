// gzip.inflate and gzip.crc32 (P20): deflate without gzip around it, as a zip holds
// it, with the fixed codes, the dynamic ones and the stored blocks, made by the zlib
// of Python; the limit of the result, the damaged data, and the CRC-32.
// expect-output: fixed: hello, deflate
// expect-output: dynamic: 1800 bytes, crc 1687536614
// expect-output: stored: 1800 bytes, the same: true
// expect-output: crc of 123456789: 3421780262
// expect-output: cannot decompress: the data are larger than 100 bytes
// expect-output: cannot decompress: the data of deflate are damaged or cut
import std.crypto
import std.gzip

i32 main() {
    println("fixed: {}", string(gzip.inflate(crypto.fromHex(deflateFixed()), 1000)))
    list<u8> dynamic = gzip.inflate(crypto.fromHex(deflateDynamic()), 1000000)
    println("dynamic: {} bytes, crc {}", dynamic.len(), gzip.crc32(dynamic))
    list<u8> stored = gzip.inflate(crypto.fromHex(deflateStored()), 1000000)
    bool same = stored.len() == dynamic.len()
    for (i64 i = 0; i < stored.len() && same; i++) {
        same = stored[i] == dynamic[i]
    }
    println("stored: {} bytes, the same: {}", stored.len(), same)
    println("crc of 123456789: {}", gzip.crc32("123456789".bytes()))
    try {
        gzip.inflate(crypto.fromHex(deflateDynamic()), 100)
    } catch (Error e) {
        println("{}", e.message())
    }
    try {
        gzip.inflate(crypto.fromHex(deflateDynamic().slice(0, 20)), 1000000)
    } catch (Error e) {
        println("{}", e.message())
    }
    ret 0
}

string deflateFixed() {
    ret "cb48cdc9c9d75148494dcb492c490500"
}

string deflateDynamic() {
    ret "0bc94855282ccd4cce56482aca2fcf5348cbaf50c82acd2d2856c82f4b2d5228014ae72456552aa4e4a7eb29848c2a1e553caa7854f1a8e251c5c34b3100"
}

string deflateStored() {
    ret ""
}
