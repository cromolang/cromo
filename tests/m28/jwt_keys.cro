// std.jwt with RSA, ECDSA and Ed25519 (D399-D402, P14, P16), against the keys
// and the tokens made by the cryptography package of Python: the tokens are
// verified with the keys in PEM and with the JWK Set; RS256 and EdDSA, which are
// deterministic, come out the same from jwt.sign, and ECDSA verifies itself. The
// keys that do not fit their algorithm are refused.
// expect-output: RS256 verified anna, same: true
// expect-output: RS384 verified anna, same: true
// expect-output: RS512 verified anna, same: true
// expect-output: EdDSA verified anna, same: true
// expect-output: ES256 verified anna, signed and verified anna
// expect-output: ES384 verified anna, signed and verified anna
// expect-output: 4 keys: rsa-1 ec-256 ec-384 ed-1
// expect-output: accepted: anna
// expect-output: accepted: anna
// expect-output: accepted: anna
// expect-output: accepted: anna
// expect-output: WrongAlgorithm: the token is signed with HS256, and its key is for RS256
// expect-output: BadSignature: the signature of the token is not valid
// expect-output: ES256 takes a key of the curve P-256, and this is not one
// expect-output: RS256 takes a key of RSA, and this is not one
// expect-output: cannot sign with a public key of RS256: jwt.privateKey reads one that signs
// expect-output: cannot read the public key: it is not a key of RSA or of a curve in PEM
// expect-output: cannot read the private key: it is not a key of Ed25519
import std.jwt

struct Session {
    string sub
    string role
    i64 exp
}

struct Subject {
    string sub
}

string reasonOf(jwt.Reason reason) {
    switch (reason) {
        case Malformed {
            ret "Malformed"
        }
        case WrongAlgorithm {
            ret "WrongAlgorithm"
        }
        case UnknownKey {
            ret "UnknownKey"
        }
        case BadSignature {
            ret "BadSignature"
        }
        case Expired {
            ret "Expired"
        }
        case NotYetValid {
            ret "NotYetValid"
        }
        case WrongIssuer {
            ret "WrongIssuer"
        }
        case WrongAudience {
            ret "WrongAudience"
        }
    }
}

// What the verifier says of the token.
void show(jwt.Verifier verifier, string token) {
    try {
        Subject s = verifier.verify<Subject>(token)
        println("accepted: {}", s.sub)
    } catch (jwt.Invalid e) {
        println("{}: {}", reasonOf(e.reason), e.message())
    }
}

