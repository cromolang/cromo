    list<string> parts = ecTokens[0].split(".")
    show(verifier, parts[0] + "." + parts[1] + "." + rsaTokens[0].split(".")[2])

    try {
        jwt.Key wrong = jwt.publicKey(jwt.Algorithm.Es256, ecPublic[1])
    } catch (Error e) {
        println("{}", e.message())
    }
    try {
        jwt.Key wrong = jwt.publicKey(jwt.Algorithm.Rs256, ecPublic[0])
    } catch (Error e) {
        println("{}", e.message())
    }
    try {
        jwt.Key verifying = jwt.publicKey(jwt.Algorithm.Rs256, rsaPublic)
        println("{}", jwt.sign(session, verifying))
    } catch (Error e) {
        println("{}", e.message())
    }
    try {
        jwt.Key wrong = jwt.publicKey(jwt.Algorithm.Rs256, "-----BEGIN PUBLIC KEY-----\nAAAA\n-----END PUBLIC KEY-----\n")
    } catch (Error e) {
        println("{}", e.message())
    }
    try {
        jwt.Key wrong = jwt.privateKey(jwt.Algorithm.EdDsa, rsaPrivate)
    } catch (Error e) {
        println("{}", e.message())
