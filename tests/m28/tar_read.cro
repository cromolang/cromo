// std.tar (D404, P21): archives made by the tarfile of Python, compressed with gzip
// as a .tar.gz: in the format of GNU with "./", a folder, a file with the
// permissions 0755, a hard link, a symbolic link and a pipe, which is left out;
// the long names of GNU, of pax and of the prefix of ustar; a size in base 256;
// and the archives that are refused.
// program-env: OUT={dir}/../out/tar_test
// expect-output: bin: folder
// expect-output: bin/run.sh: 19 bytes, executable
// expect-output: hello.txt: 12 bytes, hello, tar!
// expect-output: hard: 12 bytes, hello, tar!
// expect-output: soft: link to hello.txt
// expect-output: extracted: hello.txt true, bin/run.sh true, hard true, soft false
// expect-output: gnu: 126 characters, long
// expect-output: pax: 126 characters, long
// expect-output: ustar: 185 characters, prefix
// expect-output: base 256: b256.txt, base 256
// expect-output: cannot extract the tar: the name '../evil.txt' would leave the folder
// expect-output: cannot read the tar: the archive is damaged or cut
// expect-output: cannot read the tar: the data are not a tar
// expect-output: empty: 0 entries
import std.crypto
import std.fs
import std.gzip
import std.os
import std.tar

list<u8> unpack(string text) {
    ret gzip.decompress(crypto.fromHex(text))
}

void show(tar.Entry entry) {
    if (entry.folder) {
        println("{}: folder", entry.name)
    } else if (entry.link.len() > 0) {
        println("{}: link to {}", entry.name, entry.link)
    } else if (entry.executable) {
        println("{}: {} bytes, executable", entry.name, entry.data.len())
    } else {
        println("{}: {} bytes, {}", entry.name, entry.data.len(), string(entry.data.copy()).trim())
    }
}

// The only entry of an archive.
void only(string label, list<u8> archive) {
    list<tar.Entry> entries = tar.read(archive)
    println("{}: {} characters, {}", label, entries[0].name.len(), string(entries[0].data.copy()))
}

void tryRead(list<u8> archive) {
    try {
        tar.read(archive)
        println("read")
    } catch (Error e) {
        println("{}", e.message())
    }
}

i32 main() {
    string out = os.env("OUT")
    fs.removeAll(out)
    for (tar.Entry entry in tar.read(unpack(tarMain()))) {
        show(entry)
    }
    tar.extract(unpack(tarMain()), out)
    println("extracted: hello.txt {}, bin/run.sh {}, hard {}, soft {}", fs.readText(fs.joinPath(out, "hello.txt")) == "hello, tar!\n",
        fs.isFile(fs.joinPath(out, "bin/run.sh")), fs.readText(fs.joinPath(out, "hard")) == "hello, tar!\n",
        fs.exists(fs.joinPath(out, "soft")))
    only("gnu", unpack(tarGnu()))
    only("pax", unpack(tarPax()))
    only("ustar", unpack(tarPrefix()))
    list<tar.Entry> big = tar.read(unpack(tarBase256()))
    println("base 256: {}, {}", big[0].name, string(big[0].data.copy()))
    try {
        tar.extract(unpack(tarEvil()), fs.joinPath(out, "inner"))
    } catch (Error e) {
        println("{}", e.message())
    }
    tryRead(unpack(tarDamaged()))
    tryRead("this is not a tar".bytes())
    list<u8> nothing
    println("empty: {} entries", tar.read(nothing).len())
    fs.removeAll(out)
    ret 0
}

string tarMain() {
    ret ""
}

