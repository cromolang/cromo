// [[cold]] takes no arguments, and a function has it once (D398).
// expect-error: [[cold]] takes no arguments (D398)
// expect-error: the function 'twice' already has [[cold]] (D398)
import unsafe

[[cold("rarely")]]
void named() {
}

[[cold]]
[[cold]]
void twice() {
}

i32 main() {
    named()
    twice()
    ret 0
}
