// expect-output: 0.3333333333333333 5e-324 1.7976931348623157e+308 123456789012345680
// expect-output: 0.1 3.4028235e+38 1e-45 0.33333334
// expect-output: 0.12 0.38 1.23e+05 1e+02 inf -inf
// expect-output: [  3.14] [3.14  ] [003.14] [+3.14]
// expect-output: 1e-05 0.0001 123457 1.23457e+06 100000
f64 tiny() {
    f64 x = 5e-324
    ret x
}

i32 main() {
    // shortest form that reads back identical (D63)
    f64 third = f64(1) / 3.0
    f64 most = 1.7976931348623157e308
    f64 large = 123456789012345678.0
    println("{} {} {} {}", third, tiny(), most, large)

    f32 tenth = 0.1
    f32 maxFloat = 3.4028235e38
    f32 smallest = 1e-45
    f32 thirdFloat = f32(1) / 3.0
    println("{} {} {} {}", tenth, maxFloat, smallest, thirdFloat)

    // with a precision: exact value, ties rounded half to even
    f64 eighth = 0.125
    f64 threeEighths = 0.375
    f64 zero = 0.0
    f64 inf = f64(1) / zero
    println("{:.2f} {:.2f} {:.2e} {:.0e} {} {}", eighth, threeEighths, 123456.0 * f64(1), 99.5 * f64(1), inf, -inf)

    f64 pi = 3.14159
    println("[{:6.2f}] [{:<6.2f}] [{:06.2f}] [{:+.2f}]", pi, pi, pi, pi)

    println("{:g} {:g} {:g} {:g} {:g}", 0.00001 * f64(1), 0.0001 * f64(1), 123456.7 * f64(1), 1234567.0 * f64(1), 100000.0 * f64(1))
    ret 0
}
