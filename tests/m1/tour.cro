// expect-output: 10! = 3628800
// expect-output: fib(30) = 832040
// expect-output: 0.1 100 1e+20 1.5 -0 0.30000000000000004
// expect-output: 3.14 2.718282e+00 0.00012
// expect-output: [   42] [42   ] [ 42  ] [00042] [+42]
// expect-output: 0xff 0b101 FF 17
// expect-output: true false
// expect-output: A 65
// expect-output: odd: 1 3 5 7 9
// expect-exit: 0

i64 factorial(i64 n) {
    if (n <= 1) {
        ret 1
    }
    ret n * factorial(n - 1)
}

i64 fibonacci(i64 n) {
    i64 a = 0
    i64 b = 1
    for (i64 i = 0; i < n; i++) {
        i64 t = a + b
        a = b
        b = t
    }
    ret a
}

i32 main() {
    println("10! = {}", factorial(10))
    println("fib(30) = {}", fibonacci(30))

    f64 tenth = 0.1
    f64 sum = 0.1 + 0.2
    println("{} {} {} {} {} {}", tenth, f64(100), 1e20 * f64(1), f32(1.5), -0.0 * f64(1), sum)
    println("{:.2f} {:e} {:g}", 3.14159 * f64(1), 2.718281828 * f64(1), 0.00012 * f64(1))

    i32 n = 42
    println("[{:>5}] [{:<5}] [{:^5}] [{:05}] [{:+}]", n, n, n, n, n)
    println("{:#x} {:#b} {:X} {:o}", i32(255), i32(5), u8(255), i64(15))

    bool yes = n > 0 && n < 100
    println("{} {}", yes, !yes)

    char letter = 'A'
    println("{:c} {}", letter, letter)

    print("odd:")
    for (i32 i = 0; i < 10; i++) {
        if (i % 2 == 0) {
            continue
        }
        print(" {}", i)
    }
    println("")
    ret 0
}
