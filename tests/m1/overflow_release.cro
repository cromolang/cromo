// cromo-flags: --release
// expect-output: -128 0 -2147483648 2147483647
i32 main() {
    // in release integers wrap around (D30, D57)
    i8 x = 127
    x++
    u8 y = 255
    y += 1
    i32 m = -2147483648
    i32 d = -1
    i32 q = m / d             // MIN / -1 gives MIN in release (D60)
    f64 huge = 1e20
    i32 s = i32(huge)         // out of range: the nearest value in release (D61)
    println("{} {} {} {}", x, y, q, s)
    ret 0
}
