// Hover and definition (D171, D177).
struct Point {
    f64 x
    f64 y

    f64 norm2() const {
        ret x * x + y * y
    }
}

enum Color {
    Red
    Green
}

void show(Point p, ref list<i64> values) {
    for (i64 v in values) {
        println("{} {}", p.x, v)
    }
}

i32 main() {
    Point p
    p.x = 3.0
    list<i64> values
    values.add(1)
    show(p, ref values)
    Color c = Color.Green
    ret i32(p.norm2())
}
