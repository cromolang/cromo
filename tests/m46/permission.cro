// The permission of the network (D463): in the manifest of the APK of an app that
// uses std.net, and not in that of one that does not.
// target: windows
// program-env: CROMO={cromo}
// program-env: DIR={dir}/modules
// program-env: OUT={dir}/../out
// expect-output: online: built 0, INTERNET true, package org.cromo.online true
// expect-output: offline: built 0, INTERNET false, package org.cromo.offline true
import std.fs
import std.os
import std.process
import std.zip

// The text in UTF-16, as the strings of the binary XML of Android.
list<u8> utf16(string text) {
    list<u8> out
    for (u8 b in text.bytes()) {
        out.add(b)
        out.add(0)
    }
    ret out
}

bool has(list<u8> data, list<u8> part) {
    for (i64 i = 0; i + part.len() <= data.len(); i++) {
        bool same = true
        for (i64 j = 0; j < part.len() && same; j++) {
            same = data[i + j] == part[j]
        }
        if (same) {
            ret true
        }
    }
    ret false
}

void check(string name) {
    string apk = fs.joinPath(os.env("OUT"), name + ".apk")
    fs.removeAll(apk)
    process.Output built = process.run(os.env("CROMO"), ["build", "--target", "android", fs.joinPath(os.env("DIR"), name + ".cro"), "-o", apk])
    if (built.code != 0) {
        println("{}: built {}\n{}{}", name, built.code, built.out, built.err)
        ret
    }
    list<u8> manifest = zip.read(fs.readBytes(apk))[0].data
    println("{}: built {}, INTERNET {}, package org.cromo.{} {}", name, built.code,
            has(manifest, utf16("android.permission.INTERNET")), name, has(manifest, utf16("org.cromo." + name)))
    fs.removeAll(apk)
}

i32 main() {
    check("online")
    check("offline")
    ret 0
}
