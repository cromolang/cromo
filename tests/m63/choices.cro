// The radio groups (D506), the buttons with two states (D507) and the progress bars
// (D508), with events of SDL made by the test: a click chooses a choice and presses a
// button, the arrows change the choice; the values set and read.
// target: windows linux-x86_64
// program-env: SDL_VIDEO_DRIVER=offscreen
// expect-output: choices ["Small", "Medium", "Large"], chosen 0 Small
// expect-output: toggle true, checked false, value 0.25, busy false
// expect-output: chosen 2
// expect-output: chosen 1
// expect-output: pressed true
// expect-output: clicked
// expect-output: radio Medium, button true, value 1.0, busy true
import std.gui
import std.time
import unsafe

extern "SDL3" {
    bool SDL_PushEvent(addr event)
}

// An event for the window, whatever its number among the first ones.
void push(u32 kind, i64 code, u16 keys, f32 x, f32 y, addr text) {
    addr event = alloc(128)
    for (i64 window = 1; window < 8; window++) {
        for (i64 i = 0; i < 128; i++) {
            put<u8>(offset(event, i), 0)
        }
        put<u32>(event, kind)
        put<u32>(offset(event, 16), u32(window))
        if (kind == 0x300) {  // a key: its code and Ctrl or Shift
            put<u32>(offset(event, 28), u32(code))
            put<u16>(offset(event, 32), keys)
            put<u8>(offset(event, 36), 1)
        } else if (kind == 0x303) {  // a text
            put<addr>(offset(event, 24), text)
        } else {  // a button of the mouse
            put<u8>(offset(event, 24), 1)
            put<u8>(offset(event, 25), kind == 0x401 ? 1 : 0)
            put<u8>(offset(event, 26), 1)
            put<f32>(offset(event, 28), x)
            put<f32>(offset(event, 32), y)
        }
        SDL_PushEvent(event)
    }
    free(event)
}

void click(f32 x, f32 y) {
    addr none
    push(0x401, 0, 0, x, y, none)
    push(0x402, 0, 0, x, y, none)
    time.msleep(150)
}

void write(string value) {
    addr text = alloc(value.len() + 1)  // kept: SDL reads it when the window does
    for (i64 i = 0; i < value.len(); i++) {
        put<u8>(offset(text, i), value[i])
    }
    put<u8>(offset(text, value.len()), 0)
    push(0x303, 0, 0, 0, 0, text)
    time.msleep(150)
}

void key(i64 code, u16 keys) {
    addr none
    push(0x300, code, keys, 0, 0, none)
    time.msleep(150)
}

// An arrow, as a key of SDL.
void arrow(i64 code) {
    addr none
    push(0x300, code, 0, 0, 0, none)
    time.msleep(150)
}

i32 main() {
    gui.Window w = gui.Window("choices", 400, 335)
    gui.RadioGroup size = w.add(gui.RadioGroup(["Small", "Medium", "Large"], 16, 16, 200, 84))
    gui.Button bold = w.add(gui.Button("Bold", 16, 120, 80, 28))
    bold.setToggle(true)
    gui.ProgressBar progress = w.add(gui.ProgressBar(16, 170, 300, 8))
    progress.setValue(0.25)
    println("choices {:?}, chosen {} {}", size.items(), size.selected(), size.text())
    println("toggle {}, checked {}, value {}, busy {}", bold.toggle(), bold.checked(), progress.value(), progress.busy())
    size.onChange([](i64 index) { println("chosen {}", index) })
    bold.onChange([](bool pressed) { println("pressed {}", pressed) })
    bold.onClick([]() { println("clicked") })
    gui.TextView view = w.add(gui.TextView(0, 250, 400, 40))  // it scrolls once the window is drawn
    gui.RichText t
    for (i64 i = 0; i < 20; i++) {
        t.link(i, format("line {}\n", i), gui.TextStyle(gui.Ink.Normal))
    }
    view.setText(move t)
    view.setMarked(19)
    w.start()
    for (i32 i = 0; i < 500 && view.scrollY() == 0; i++) {  // at most 5 seconds
        time.msleep(10)
    }
    time.msleep(300)

    click(30, 35 + 16 + 28 * 2 + 14)  // the third choice
    arrow(0x40000052)                 // Up: the second
    click(50, 35 + 134)               // the button
    progress.setValue(3)
    progress.setBusy(true)
    println("radio {}, button {}, value {:.1f}, busy {}", size.text(), bold.checked(), progress.value(), progress.busy())
    w.close()
    ret 0
}
