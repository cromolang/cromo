// The text area (D498, D499) and undo, with events of SDL made by the test: a click
// gives it the keyboard, the text written and Enter go in it, Ctrl+Z undoes a step at a
// time and Ctrl+Y redoes; in a text box Backspace deletes and Ctrl+Z undoes.
// target: windows linux-x86_64
// program-env: SDL_VIDEO_DRIVER=offscreen
// expect-output: placeholder 'A note', text ''
// expect-output: written "abc\ndef"
// expect-output: undone "abc\n"
// expect-output: undone "abc"
// expect-output: redone "abc\n"
// expect-output: box "Hello wor"
// expect-output: box undone "Hello world"
// expect-output: set "new", nothing to undo: "new"
import std.gui
import std.time
import unsafe

extern "SDL3" {
    bool SDL_PushEvent(addr event)
}

// An event for the window, whatever its number among the first ones.
void push(u32 kind, i64 code, u16 keys, f32 x, f32 y, addr text) {
    addr event = alloc(128)
    for (i64 window = 1; window < 8; window++) {
        for (i64 i = 0; i < 128; i++) {
            put<u8>(offset(event, i), 0)
        }
        put<u32>(event, kind)
        put<u32>(offset(event, 16), u32(window))
        if (kind == 0x300) {  // a key: its code and Ctrl or Shift
            put<u32>(offset(event, 28), u32(code))
            put<u16>(offset(event, 32), keys)
            put<u8>(offset(event, 36), 1)
        } else if (kind == 0x303) {  // a text
            put<addr>(offset(event, 24), text)
        } else {  // a button of the mouse
            put<u8>(offset(event, 24), 1)
            put<u8>(offset(event, 25), kind == 0x401 ? 1 : 0)
            put<u8>(offset(event, 26), 1)
            put<f32>(offset(event, 28), x)
            put<f32>(offset(event, 32), y)
        }
        SDL_PushEvent(event)
    }
    free(event)
}

void click(f32 x, f32 y) {
    addr none
    push(0x401, 0, 0, x, y, none)
    push(0x402, 0, 0, x, y, none)
    time.msleep(150)
}

void write(string value) {
    addr text = alloc(value.len() + 1)  // kept: SDL reads it when the window does
    for (i64 i = 0; i < value.len(); i++) {
        put<u8>(offset(text, i), value[i])
    }
    put<u8>(offset(text, value.len()), 0)
    push(0x303, 0, 0, 0, 0, text)
    time.msleep(150)
}

void key(i64 code, u16 keys) {
    addr none
    push(0x300, code, keys, 0, 0, none)
    time.msleep(150)
}

i32 main() {
    gui.Window w = gui.Window("area", 400, 335)
    gui.TextArea note = w.add(gui.TextArea("", 0, 0, 400, 150))
    note.setPlaceholder("A note")
    gui.TextBox name = w.add(gui.TextBox("Hello world", 0, 200, 400, 28))
    println("placeholder '{}', text '{}'", note.placeholder(), note.text())
    gui.TextView view = w.add(gui.TextView(0, 250, 400, 40))  // it scrolls once the window is drawn
    gui.RichText t
    for (i64 i = 0; i < 20; i++) {
        t.link(i, format("line {}\n", i), gui.TextStyle(gui.Ink.Normal))
    }
    view.setText(move t)
    view.setMarked(19)
    w.start()
    for (i32 i = 0; i < 500 && view.scrollY() == 0; i++) {  // at most 5 seconds
        time.msleep(10)
    }
    time.msleep(300)

    click(100, 35 + 50)  // the title bar is 35 pixels high
    write("abc")
    key(13, 0)  // Enter
    write("def")
    println("written {:?}", note.text())
    key(122, 0x40)  // Ctrl+Z
    println("undone {:?}", note.text())
    key(122, 0x40)
    println("undone {:?}", note.text())
    key(121, 0x40)  // Ctrl+Y
    println("redone {:?}", note.text())

    click(390, 35 + 214)
    key(8, 0)  // Backspace, twice: one step
    key(8, 0)
    println("box {:?}", name.text())
    key(122, 0x40)
    println("box undone {:?}", name.text())
    name.setText("new")
    key(122, 0x40)
    println("set {:?}, nothing to undo: {:?}", name.text(), name.text())
    w.close()
    ret 0
}
