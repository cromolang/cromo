// expect-error: a destructor cannot let an exception out: catch it inside (D113)
// expect-error: a 'finally' block cannot let an exception out: catch it inside (D113)
// expect-error: 'ret' cannot leave a 'finally' block (D120)
// expect-error: 'break' cannot leave a 'finally' block (D120)
// expect-error: 'throw' alone rethrows the exception of a 'catch': it can be used only inside one (D114)
// expect-error: only a struct that implements Exception can be thrown, found integer literal (D36)
// expect-error: a 'catch' takes a struct that implements Exception, or Exception itself, found Point (D118)
// expect-error: this 'catch' is never reached: a previous one already catches every exception (D118)
// expect-error: 'e' is the exception of a 'catch', which is read-only (D114)
// expect-error: message() cannot let an exception out: catch it inside (D122)
// expect-error: copy() cannot let an exception out: catch it inside (D122)
struct Point {
    i32 x
}

struct IoError : Exception {
    string path

    string message() const {
        throw Error("no message")
    }
}

void mayFail() {
    throw Error("failed")
}

struct Bad {
    i32 id

    ~Bad() {
        mayFail()
    }

    Bad copy() const {
        mayFail()
        ret Bad()
    }
}

i32 compute() {
    try {
        ret 1
    } finally {
        mayFail()
        ret 2
    }
}

i32 main() {
    for (i32 i = 0; i < 2; i++) {
        try {
        } finally {
            break
        }
    }
    throw
    throw 5
    try {
        mayFail()
    } catch (Point p) {
    }
    try {
        mayFail()
    } catch (Exception e) {
    } catch (IoError e) {
    }
    try {
        mayFail()
    } catch (Error e) {
        e = Error("other")
    }
    IoError err
    throw err
    ret 0
}
