// expect-output: open 1
// expect-output: open 101
// expect-output: open 2
// expect-output: close -1
// expect-output: open 3
// expect-output: close -1
// expect-output: open 102
// expect-output: open 103
// expect-output: 102 103 7
// expect-output: 1.5 2.5
// expect-output: close 103
// expect-output: close 102
// expect-output: close 3
// expect-output: close 2
// expect-output: close 101
// expect-output: close 1
// copy() written by hand (D83) and generated by the compiler (D35).
struct File {
    i32 fd = -1

    File(i32 n) {
        fd = n
        println("open {}", fd)
    }

    ~File() {
        println("close {}", fd)
    }

    File copy() const {
        ret File(fd + 100)
    }
}

// No destructor of its own: the generated copy() copies each File with its copy().
struct Pair {
    File first
    File second
    i32 tag
}

struct Point {
    f64 x
    f64 y
}

i32 main() {
    File f = File(1)
    File g = f.copy()

    Pair p
    p.first = File(2)
    p.second = File(3)
    p.tag = 7
    Pair q = p.copy()
    println("{} {} {}", q.first.fd, q.second.fd, q.tag)

    Point a
    a.x = 1.5
    Point b = a.copy()
    b.x = 2.5
    println("{} {}", a.x, b.x)
    ret 0
}
