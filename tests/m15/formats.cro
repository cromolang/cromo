// format and the heap in several threads at once (D200, D214), also with the
// floating-point numbers, whose digits each format computes by itself (D221).
// expect-output: wrong 0
import std.thread

// The text of format("{:.3f} {}", id * 1.25, id / 8.0).
string floats(i64 id) {
    if (id == 1) {
        ret "1.250 0.125"
    } else if (id == 2) {
        ret "2.500 0.25"
    } else if (id == 3) {
        ret "3.750 0.375"
    }
    ret "5.000 0.5"
}

i64 check(i64 id) {
    i64 wrong = 0
    for (i64 i = 0; i < 20000; i++) {
        if (format("{:.3f} {}", f64(id) * 1.25, f64(id) / 8.0) != floats(id)) {
            wrong++
        }
        string text = format("thread {} line {} {}", id, i, "end")
        string expected = "thread "
        expected += format("{}", id)
        expected += " line "
        expected += format("{}", i)
        expected += " end"
        if (text != expected) {
            wrong++
        }
    }
    ret wrong
}

i32 main() {
    i64 a = 0
    i64 b = 0
    i64 c = 0
    thread.Thread one = thread.Thread([ref a]() { a = check(1) })
    thread.Thread two = thread.Thread([ref b]() { b = check(2) })
    thread.Thread three = thread.Thread([ref c]() { c = check(3) })
    one.start()
    two.start()
    three.start()
    i64 d = check(4)
    one.join()
    two.join()
    three.join()
    println("wrong {}", a + b + c + d)
    ret 0
}
