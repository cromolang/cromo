// A panic in a thread stops the whole program (D62, D217).
// expect-exit: 101
// expect-stderr: panic: index out of bounds: the index is 5 but the length is 0 at
import std.thread

i32 main() {
    thread.Thread t = thread.Thread([]() {
        list<i64> empty
        i64 index = 5
        println("{}", empty[index])
    })
    t.start()
    t.join()
    println("not here")
    ret 0
}
