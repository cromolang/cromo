// The documentation comments in the hover, in the completion and in the help on
// the signature (D473-D477).

import modules.geometry
import std.fs

// The area of a circle of radius 'r', in square units.
//
// '''
// f64 a = area(2.0)
// '''
f64 area(f64 r) {
    ret 3.14159 * r * r
}

// Adds 'a' and 'b'; it's a list<i64> of nothing.
i64 add(i64 a, i64 b) {
    ret a + b
}

// A point of the plane.
struct Point {
    i64 x  // the distance from the left
           // in pixels
    // The distance from the top.
    i64 y

    // Makes the point.
    Point(i64 left, i64 top) {
        x = left
        y = top
    }

    // The sum of the two coordinates, and 'extra'.
    i64 sum(i64 extra) const {
        ret x + y + extra
    }
}

enum Shape {
    Circle(f64 radius)  // round
    Square(f64 side)
}

void main() {
    Point p = Point(1, 2)
    f64 a = area(2.0)
    i64 s = add(1, p.sum(3))
    string text = fs.readText("x.txt")
    println("{} {} {}", a, s, text)
    Shape shape = Shape.Circle(1.0)
    geometry.Box b = geometry.Box(2)
    i64 w = geometry.width(b)
}
