// A submenu (D496), the wheel on a canvas with the keys held, and a button in the title
// bar (D509), with events of SDL made by the test.
// target: windows linux-x86_64
// program-env: SDL_VIDEO_DRIVER=offscreen
// expect-output: 3 entries
// expect-output: tooltips: 'Saves'
// expect-output: chosen Large
// expect-output: wheel 1.0 at 20, 30
// expect-output: title button
import std.gui
import std.time
import unsafe

extern "SDL3" {
    bool SDL_PushEvent(addr event)
}

// An event for the window, whatever its number among the first ones.
void push(u32 kind, i64 code, u16 keys, f32 x, f32 y, addr text) {
    addr event = alloc(128)
    for (i64 window = 1; window < 8; window++) {
        for (i64 i = 0; i < 128; i++) {
            put<u8>(offset(event, i), 0)
        }
        put<u32>(event, kind)
        put<u32>(offset(event, 16), u32(window))
        if (kind == 0x300) {  // a key: its code and Ctrl or Shift
            put<u32>(offset(event, 28), u32(code))
            put<u16>(offset(event, 32), keys)
            put<u8>(offset(event, 36), 1)
        } else if (kind == 0x303) {  // a text
            put<addr>(offset(event, 24), text)
        } else {  // a button of the mouse
            put<u8>(offset(event, 24), 1)
            put<u8>(offset(event, 25), kind == 0x401 ? 1 : 0)
            put<u8>(offset(event, 26), 1)
            put<f32>(offset(event, 28), x)
            put<f32>(offset(event, 32), y)
        }
        SDL_PushEvent(event)
    }
    free(event)
}

void click(f32 x, f32 y) {
    addr none
    push(0x401, 0, 0, x, y, none)
    push(0x402, 0, 0, x, y, none)
    time.msleep(150)
}

void write(string value) {
    addr text = alloc(value.len() + 1)  // kept: SDL reads it when the window does
    for (i64 i = 0; i < value.len(); i++) {
        put<u8>(offset(text, i), value[i])
    }
    put<u8>(offset(text, value.len()), 0)
    push(0x303, 0, 0, 0, 0, text)
    time.msleep(150)
}

void key(i64 code, u16 keys) {
    addr none
    push(0x300, code, keys, 0, 0, none)
    time.msleep(150)
}

// The wheel of the mouse at x, y of the window, one step away.
void wheel(f32 x, f32 y) {
    addr event = alloc(128)
    for (i64 window = 1; window < 8; window++) {
        for (i64 i = 0; i < 128; i++) {
            put<u8>(offset(event, i), 0)
        }
        put<u32>(event, 0x403)
        put<u32>(offset(event, 16), u32(window))
        put<f32>(offset(event, 28), 1.0)
        put<f32>(offset(event, 36), x)
        put<f32>(offset(event, 40), y)
        SDL_PushEvent(event)
    }
    free(event)
    time.msleep(150)
}

i32 main() {
    gui.Window w = gui.Window("menus", 400, 335)
    gui.Button actions = w.add(gui.Button("Actions", 16, 16, 100, 28))
    gui.Canvas canvas = w.add(gui.Canvas(200, 16, 180, 100))
    canvas.onWheel([](gui.Mouse m, f32 steps) { println("wheel {:.1f} at {}, {}", steps, i64(m.x), i64(m.y)) })
    gui.Panel bar = w.titleBar()
    gui.Button inBar = bar.add(gui.Button("Go", 8, 4, 60, 27))
    inBar.onClick([]() { println("title button") })
    gui.Menu sizes
    sizes.addItem("Small", []() { println("chosen Small") })
    sizes.addItem("Large", []() { println("chosen Large") })
    gui.Menu menu
    menu.addItem("Copy", []() { println("chosen Copy") })
    menu.addSeparator()
    menu.addSubmenu("Size", move sizes)
    println("{} entries", menu.len())
    gui.RichText notes
    notes.tooltip(3, "Saves")
    println("tooltips: '{}'", "Saves")
    gui.TextView view = w.add(gui.TextView(0, 250, 400, 40))  // it scrolls once the window is drawn
    gui.RichText t
    for (i64 i = 0; i < 20; i++) {
        t.link(i, format("line {}\n", i), gui.TextStyle(gui.Ink.Normal))
    }
    view.setText(move t)
    view.setMarked(19)
    w.start()
    for (i32 i = 0; i < 500 && view.scrollY() == 0; i++) {  // at most 5 seconds
        time.msleep(10)
    }
    time.msleep(300)
    w.showMenuUnder(move menu, actions)
    time.msleep(150)
    // the menu under the button: Copy, the line, Size; the pointer on Size opens its submenu
    f32 sizeY = 35 + 48 + 4 + 30 + 9 + 15
    click(60, sizeY)
    time.msleep(100)
    click(16 + 190 + 20, sizeY + 30)  // the second entry of the submenu, on the right
    wheel(220, 35 + 46)
    click(30, 18)                     // the button in the title bar
    w.close()
    ret 0
}
