// A submenu has no submenus (D496).
// target: windows linux-x86_64
// expect-exit: 101
// expect-stderr: a submenu has no submenus
import std.gui

i32 main() {
    gui.Menu inner
    inner.addItem("A", []() {})
    gui.Menu middle
    middle.addSubmenu("Inner", move inner)
    gui.Menu outer
    outer.addSubmenu("Middle", move middle)
    ret 0
}
