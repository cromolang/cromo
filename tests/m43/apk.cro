// cromo build --target android (D453, D455, P44): the APK of an app, with the
// manifest, the table of the resources with the icon, the classes of SDL, libSDL3.so
// and libmain.so of both architectures, stored and aligned to 16 KB, and the block
// of the signature of scheme v2 before the central directory.
// target: windows
// program-env: CROMO={cromo}
// program-env: APP={dir}/modules/mail.cro
// program-env: OUT={dir}/../out/mail.apk
// expect-output: built: 0
// expect-output: AndroidManifest.xml
// expect-output: resources.arsc
// expect-output: res/drawable/icon.png
// expect-output: classes.dex
// expect-output: lib/arm64-v8a/libSDL3.so aligned
// expect-output: lib/arm64-v8a/libmain.so aligned
// expect-output: lib/x86_64/libSDL3.so aligned
// expect-output: lib/x86_64/libmain.so aligned
// expect-output: the package and the name in the manifest: true true
// expect-output: the signature before the central directory: true
import std.fs
import std.os
import std.process
import std.zip

// The text in UTF-16, as the strings of the binary XML of Android.
list<u8> utf16(string text) {
    list<u8> out
    for (u8 b in text.bytes()) {
        out.add(b)
        out.add(0)
    }
    ret out
}

i64 find(list<u8> data, list<u8> part) {
    for (i64 i = 0; i + part.len() <= data.len(); i++) {
        bool same = true
        for (i64 j = 0; j < part.len() && same; j++) {
            same = data[i + j] == part[j]
        }
        if (same) {
            ret i
        }
    }
    ret -1
}

i64 at32(list<u8> data, i64 at) {
    ret i64(data[at]) | i64(data[at + 1]) << 8 | i64(data[at + 2]) << 16 | i64(data[at + 3]) << 24
}

i32 main() {
    string out = os.env("OUT")
    fs.removeAll(out)
    process.Output built = process.run(os.env("CROMO"), ["build", "--target", "android", os.env("APP"), "-o", out])
    println("built: {}", built.code)
    if (built.code != 0) {
        println("{}{}", built.out, built.err)
        ret 1
    }
    list<u8> apk = fs.readBytes(out)
    list<zip.Entry> entries = zip.read(apk)
    // Each local header: 30 bytes, the name and the extra field, then the data.
    i64 local = 0
    for (zip.Entry entry in entries) {
        i64 start = local + 30 + (at32(apk, local + 26) & 0xFFFF) + (at32(apk, local + 28) & 0xFFFF)
        if (entry.name.endsWith(".so")) {
            println("{} {}", entry.name, start % 16384 == 0 ? "aligned" : "not aligned")
        } else {
            println("{}", entry.name)
        }
        local = start + entry.data.len()
    }
    list<u8> manifest = entries[0].data
    println("the package and the name in the manifest: {} {}", find(manifest, utf16("org.example.mail")) >= 0,
            find(manifest, utf16("Mail")) >= 0)
    i64 directory = at32(apk, apk.len() - 22 + 16)
    i64 magic = find(apk, "APK Sig Block 42".bytes())
    println("the signature before the central directory: {}", magic >= 0 && magic + 16 == directory)
    fs.removeAll(out)
    ret 0
}
